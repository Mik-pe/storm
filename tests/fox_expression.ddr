import core
import ecs
import ..src.art_asset
import ..src.play_view
import play
import ..src.fox_animation as fox
import ..src.fox_expression as expression

fn step(s: &mut play.Session, x: f32, ticks: i32) {
    for _ in 0..ticks { play.step(&mut s, play.Input { x: x, z: 0.0, jump: false }) }
}

@test fn a_tap_eases_out_of_a_gesture_and_a_long_run_starts_a_fresh_one() {
    level := play.demo()
    mut s := play.start(&level)
    step(&mut s, 0.0, 85)
    settled := play.render_rest(&s, true)
    step(&mut s, 0.12, 1)
    leaving := play.render_rest(&s, true)
    assert(leaving.weight < settled.weight && leaving.weight > 0.9)
    step(&mut s, 0.0, 1)
    assert(play.render_rest(&s, true).age > settled.age)
    step(&mut s, 0.3, 28)
    assert(play.render_rest(&s, true).weight == 0.0)
    step(&mut s, 0.0, 1)
    s.accumulator = 0.5
    halfway := play.render_rest(&s, false)
    assert(halfway.weight > 0.0 && halfway.weight < play.render_rest(&s, true).weight)
    assert(play.render_rest(&s, true).age == 0.0)
}

struct PoseActing { pose: fox.Pose, acting: expression.Acting }

fn acting_at(s: &play.Session, c: &fox.Clips, g: &expression.Gestures) -> PoseActing {
    m := play.render_motion(s, true)
    mut p := fox.pose(c, &m)
    a := expression.apply(&mut p, g, s, &m, play.position(s, s.body_entities[s.player]), 1.0, true, core.vec3(0.0, 0.17, 0.0))
    PoseActing { pose: p, acting: a }
}

fn expression_at(s: &play.Session, c: &fox.Clips, g: &expression.Gestures) -> fox.Pose {
    acting_at(s, c, g).pose
}

@test fn a_flower_guides_the_muzzle_and_a_pickup_softens_the_eyes_even_in_motion() {
    mut level := play.demo()
    origin := level.entities[1].position
    level.entities[2].position = core.add(origin, core.vec3(0.68, 0.05, 0.84))
    mut toward := play.start(&level)
    level.entities[2].position = core.add(origin, core.vec3(0.0, 0.05, -1.05))
    mut behind := play.start(&level)
    step(&mut toward, 0.0, 72)
    step(&mut behind, 0.0, 72)
    assert(toward.flowers == 0 && behind.flowers == 0)
    c := fox.clips().unwrap()
    g := expression.gestures().unwrap()
    sniff := expression_at(&toward, &c, &g)
    stretch := expression_at(&behind, &c, &g)
    assert(sniff.head.x > stretch.head.x + 0.40 && sniff.head.y > stretch.head.y + 0.10)
    assert(sniff.eye_open < 0.5)
    for _ in 0..22 { play.step(&mut toward, play.Input { x: 0.64, z: 0.77, jump: false }) }
    assert(toward.flowers == 1 && play.render_rest(&toward, true).weight == 0.0)
    glad := expression_at(&toward, &c, &g)
    plain := fox.pose(&c, &play.render_motion(&toward, true))
    assert(glad.eye_open < plain.eye_open * 0.25 && glad.head.x < plain.head.x - 0.16)
}

@test fn nose_tracks_the_pollen_height_on_both_sniffs_after_the_legs_are_solved() {
    mut level := play.demo()
    level.entities[2].position = core.add(level.entities[1].position, core.vec3(-2.15, 0.05, 0.55))
    mut s := play.start(&level)
    mut v := play_view.build(&s).unwrap()
    nose := expression.nose_tip(&art_asset.load("fox").unwrap()).unwrap()
    pollen := expression.bloom_center(&art_asset.load("flower").unwrap()).unwrap()
    mut head: Option<ecs.Entity> = .None
    mut flower: Option<ecs.Entity> = .None
    for e in v.graph.nodes() {
        name := v.graph.name(e)
        if name == "Head_Cocoa" { head = .Some(e) }
        if name == "Body_Daisyheart" && flower.is_none() { flower = .Some(e) }
    }
    directions := [core.vec2(0.0, -1.0), core.vec2(-1.0, 0.0), core.vec2(0.0, 1.0), core.vec2(0.64, 0.77)]
    counts := [16, 39, 12, 3]
    for i in 0..4 {
        for _ in 0..counts[i] { play.step(&mut s, play.Input { x: directions[i].x, z: directions[i].y, jump: false }) }
    }
    mut lowest: f32 = 10.0
    mut highest: f32 = -10.0
    for i in 0..116 {
        step(&mut s, 0.0, 1)
        if i < 61 { continue }
        play_view.sync(&mut v, &s, true)
        tip := core.transform_point(&v.graph.world(head.unwrap()).matrix, nose)
        heart := core.transform_point(&v.graph.world(flower.unwrap()).matrix, pollen)
        gap := tip.y - heart.y
        if gap < lowest { lowest = gap }
        if gap > highest { highest = gap }
    }
    assert(s.flowers == 0 && lowest > 0.025 && highest < 0.23 && highest - lowest > 0.025)
}

fn find_node(v: &play_view.View, name: string) -> Option<ecs.Entity> {
    for e in v.graph.nodes() { if v.graph.name(e) == name { return .Some(e) } }
    .None
}

@test fn manual_and_auto_sit_snooze_close_eyelids_and_keep_standing_idle_clean() {
    level := play.demo()
    mut s := play.start(&level)
    mut v := play_view.build(&s).unwrap()
    c := fox.clips().unwrap()
    g := expression.gestures().unwrap()
    step(&mut s, 0.0, 134)
    early := acting_at(&s, &c, &g)
    assert(early.acting.sit == 0.0 && early.acting.snooze == 0.0)
    play.toggle_sit(&mut s)
    step(&mut s, 0.0, 32)
    sitting := acting_at(&s, &c, &g)
    assert(sitting.acting.sit > 0.95 && sitting.acting.snooze == 0.0)
    step(&mut s, 0.0, 360)
    snoozing := acting_at(&s, &c, &g)
    assert(snoozing.acting.snooze == 1.0 && snoozing.pose.eye_open == 0.0)
    assert((snoozing.acting.blush - 0.45).abs() < 0.01)
    play_view.sync(&mut v, &s, true)
    lid_l := find_node(&v, "LidL_Smile").unwrap()
    lid_r := find_node(&v, "LidR_Smile").unwrap()
    eye_l := find_node(&v, "EyeL_Dew").unwrap()
    assert(v.graph.world(lid_l).visible && v.graph.world(lid_r).visible && !v.graph.world(eye_l).visible)
    // Auto-sit begins only after 9.0s idle and auto-snooze after 14.0s idle.
    mut auto_s := play.start(&level)
    step(&mut auto_s, 0.0, 620)
    auto_sat := acting_at(&auto_s, &c, &g)
    assert(auto_sat.acting.sit > 0.95 && auto_sat.acting.snooze == 0.0)
    step(&mut auto_s, 0.0, 340)
    auto_slept := acting_at(&auto_s, &c, &g)
    assert(auto_slept.acting.snooze == 1.0 && auto_slept.pose.eye_open == 0.0)
}

@test fn petting_produces_rosy_blush_smiling_eyes_and_heart_motes() {
    level := play.demo()
    mut s := play.start(&level)
    mut v := play_view.build(&s).unwrap()
    c := fox.clips().unwrap()
    g := expression.gestures().unwrap()
    step(&mut s, 0.0, 5)
    play_view.sync(&mut v, &s, true)
    blush_node := find_node(&v, "Head_Blush").unwrap()
    assert(v.graph.material_value(blush_node, .Emissive) == 0.0)
    play.pet(&mut s)
    step(&mut s, 0.0, 26)
    res := acting_at(&s, &c, &g)
    assert(res.acting.blush > 0.8 && res.pose.eye_open < 0.02)
    play_view.sync(&mut v, &s, true)
    assert(v.graph.material_value(blush_node, .Emissive) > 0.34)
    lid_l := find_node(&v, "LidL_Smile").unwrap()
    assert(v.graph.world(lid_l).visible)
    player_y := play.position(&s, v.player_node).y
    for i in [0, 2, 4] {
        mote := v.cast.motes[i]
        assert(v.graph.world(mote).visible && v.graph.world(mote).matrix.m[13] > player_y + 0.35)
    }
}

@test fn emote_and_progressive_bouquet_track_collected_flowers() {
    level := play.demo()
    mut s := play.start(&level)
    mut v := play_view.build(&s).unwrap()
    c := fox.clips().unwrap()
    g := expression.gestures().unwrap()
    play_view.sync(&mut v, &s, true)
    bouquet := find_node(&v, "Bouquet").unwrap()
    stem0 := find_node(&v, "BouquetStem_0").unwrap()
    stem1 := find_node(&v, "BouquetStem_1").unwrap()
    stem2 := find_node(&v, "BouquetStem_2").unwrap()
    assert(!v.graph.world(bouquet).visible && !v.graph.world(stem0).visible && !v.graph.world(stem1).visible)
    play.emote(&mut s)
    step(&mut s, 0.0, 20)
    bow := acting_at(&s, &c, &g)
    assert(bow.acting.blush >= 0.78 && bow.pose.chest.rotation.x > 0.25)
    play_view.sync(&mut v, &s, true)
    assert(v.graph.world(v.cast.motes[0]).visible)
    step(&mut s, 0.0, 24)
    spring := acting_at(&s, &c, &g)
    assert(spring.pose.eye_open < 0.35 && spring.acting.happy > 0.6)
    // Collecting flowers reveals the bouquet and adds one stem per collected flower.
    for _ in 0..35 { play.step(&mut s, play.Input { x: -1.0, z: 0.0, jump: false }) }
    assert(s.flowers == 1)
    play_view.sync(&mut v, &s, true)
    assert(v.graph.world(bouquet).visible && v.graph.world(stem0).visible && !v.graph.world(stem1).visible && !v.graph.world(stem2).visible)
    s.collected[3] = true
    s.flowers = 2
    play_view.sync(&mut v, &s, true)
    assert(v.graph.world(bouquet).visible && v.graph.world(stem0).visible && v.graph.world(stem1).visible && !v.graph.world(stem2).visible)
    s.won = true
    play.emote(&mut s)
    step(&mut s, 0.0, 20)
    proud := acting_at(&s, &c, &g)
    assert(proud.pose.chest.rotation.x < 0.0)
}

@test fn butterfly_curiosity_turns_vallmos_gaze_toward_nearby_super_butterfly() {
    mut level := play.demo()
    level.bounds = .None
    // Move Vallmo to a clear patch away from flowers so scent does not compete.
    level.entities[1].position = core.vec3(0.0, 0.4, 8.0)
    mut butterfly_idx := -1
    for i in 0..level.entities.len {
        if level.entities[i].role == .SuperButterfly { butterfly_idx = i; break }
    }
    assert(butterfly_idx >= 0)
    // Heading starts at 0.35 rad: local left is (cos 0.35, 0, -sin 0.35) = (0.939, 0, -0.343).
    mut far_level := level.clone()
    far_level.entities[butterfly_idx].position = core.vec3(0.0, 1.5, 20.0)
    mut s_far := play.start(&far_level)
    step(&mut s_far, 0.0, 30)
    mut left_level := level.clone()
    left_level.entities[butterfly_idx].position = core.vec3(2.2, 1.8, 8.2)
    mut s_left := play.start(&left_level)
    step(&mut s_left, 0.0, 30)
    mut right_level := level.clone()
    right_level.entities[butterfly_idx].position = core.vec3(-1.4, 1.8, 9.6)
    mut s_right := play.start(&right_level)
    step(&mut s_right, 0.0, 30)
    c := fox.clips().unwrap()
    g := expression.gestures().unwrap()
    base := expression_at(&s_far, &c, &g)
    left_pose := expression_at(&s_left, &c, &g)
    right_pose := expression_at(&s_right, &c, &g)
    assert(left_pose.head.y > base.head.y + 0.15 && right_pose.head.y < base.head.y - 0.15)
    assert(left_pose.head.x < base.head.x - 0.05 && left_pose.ears[0].x > base.ears[0].x + 0.05)
    // Once collected, the butterfly no longer draws curious gaze.
    s_left.collected[butterfly_idx] = true
    after := expression_at(&s_left, &c, &g)
    assert((after.head.y - base.head.y).abs() < 0.001)
}

@test fn living_flowers_sway_gently_and_companion_insects_visit_when_cozy() {
    level := play.demo()
    mut s := play.start(&level)
    mut v := play_view.build(&s).unwrap()
    step(&mut s, 0.0, 20)
    play_view.sync(&mut v, &s, true)
    assert(v.cast.flowers.len == s.total_flowers && v.cast.flowers.len >= 5)
    assert(v.cast.insects.len >= 4 && v.cast.petals.len == 48)
    for fl in v.cast.flowers {
        local := v.graph.local(fl.root)
        assert(local.rotation_x.abs() <= 0.045 && local.rotation_z.abs() <= 0.045)
    }
    player_pos := play.position(&s, v.player_node)
    mut bee_idx := -1
    for i in 0..v.cast.insects.len {
        if v.cast.insects[i].bee { bee_idx = i; break }
    }
    assert(bee_idx >= 0)
    home_dist := core.length(core.sub(v.graph.local(v.cast.insects[0].root).position, player_pos))
    bee_home := core.length(core.sub(v.graph.local(v.cast.insects[bee_idx].root).position, player_pos))
    play.pet(&mut s)
    step(&mut s, 0.0, 20)
    play_view.sync(&mut v, &s, true)
    pet_dist := core.length(core.sub(v.graph.local(v.cast.insects[0].root).position, player_pos))
    bee_pet := core.length(core.sub(v.graph.local(v.cast.insects[bee_idx].root).position, player_pos))
    assert(pet_dist < home_dist - 0.25 && pet_dist < 1.25)
    assert(bee_pet < bee_home - 0.25 && bee_pet < 1.05)

    // Expanded 27x23m Blomsterskogen populates companion butterflies and bees across all outer zones.
    mut big := play.demo()
    big.bounds = .Some(play.Bounds { min_x: -13.5, min_z: -11.5, max_x: 13.5, max_z: 11.5 })
    big_s := play.start(&big)
    mut big_v := play_view.build(&big_s).unwrap()
    play_view.sync(&mut big_v, &big_s, true)
    assert(big_v.cast.insects.len >= 18)
    mut outer_count := 0
    for flyer in big_v.cast.insects {
        p := big_v.graph.local(flyer.root).position
        if p.x.abs() > 6.0 || p.z.abs() > 6.0 { outer_count += 1 }
    }
    assert(outer_count >= 10)
}

@test fn three_distinct_emotes_cycle_play_bow_twirl_hop_and_greeting_wink() {
    assert(expression.emote_variant(0) == 0)
    assert(expression.emote_variant(90) == 1)
    assert(expression.emote_variant(180) == 2)
    assert(expression.emote_variant(270) == 0)

    level := play.demo()
    c := fox.clips().unwrap()
    g := expression.gestures().unwrap()

    // Variant 0 (tick 0): Playful play-bow + haunch pounce wiggle.
    mut s0 := play.start(&level)
    play.emote(&mut s0)
    step(&mut s0, 0.0, 20)
    bow := acting_at(&s0, &c, &g)
    assert(bow.acting.emote_kind == 0 && bow.pose.chest.rotation.x > 0.25)
    assert(bow.acting.spin_yaw == 0.0 && bow.acting.wink_right == 0.0)

    // Variant 1 (tick 90): Joyful 360-degree twirl spin-hop off the meadow.
    mut s1 := play.start(&level)
    step(&mut s1, 0.0, 90)
    play.emote(&mut s1)
    step(&mut s1, 0.0, 34)
    twirl := acting_at(&s1, &c, &g)
    assert(twirl.acting.emote_kind == 1)
    assert(twirl.acting.hop_y > 0.18 && twirl.acting.spin_yaw > 2.5 && twirl.acting.spin_yaw < 4.2)

    // Variant 2 (tick 180): Happy greeting bounce with sweet head tilt, perked ears, and right-eye wink only.
    mut s2 := play.start(&level)
    mut v2 := play_view.build(&s2).unwrap()
    step(&mut s2, 0.0, 180)
    play.emote(&mut s2)
    step(&mut s2, 0.0, 38)
    greet := acting_at(&s2, &c, &g)
    assert(greet.acting.emote_kind == 2)
    assert(greet.acting.hop_y > 0.05 && greet.acting.wink_right > 0.9 && greet.pose.eye_open > 0.8)
    assert(greet.pose.head.z > 0.20)
    play_view.sync(&mut v2, &s2, true)
    lid_l := find_node(&v2, "LidL_Smile").unwrap()
    lid_r := find_node(&v2, "LidR_Smile").unwrap()
    eye_l := find_node(&v2, "EyeL_Dew").unwrap()
    eye_r := find_node(&v2, "EyeR_Iris").unwrap()
    assert(!v2.graph.world(lid_l).visible && v2.graph.world(eye_l).visible)
    assert(v2.graph.world(lid_r).visible && !v2.graph.world(eye_r).visible)
}

@test fn petting_nuzzles_blushes_and_does_alternating_front_paw_tippy_taps() {
    level := play.demo()
    mut s := play.start(&level)
    mut v := play_view.build(&s).unwrap()
    rigged := art_asset.load_rigged("fox").unwrap()
    sole_fl := rigged.rig.get("FootFL").unwrap().sole.unwrap()
    sole_fr := rigged.rig.get("FootFR").unwrap().sole.unwrap()
    boot_fl := find_node(&v, "FootFL_Boots").unwrap()
    boot_fr := find_node(&v, "FootFR_Boots").unwrap()
    step(&mut s, 0.0, 5)
    play_view.sync(&mut v, &s, true)
    base_fl_y := core.transform_point(&v.graph.world(boot_fl).matrix, sole_fl).y
    base_fr_y := core.transform_point(&v.graph.world(boot_fr).matrix, sole_fr).y

    play.pet(&mut s)
    mut max_fl_lift: f32 = 0.0
    mut max_fr_lift: f32 = 0.0
    mut saw_alternate := false
    for _ in 0..45 {
        step(&mut s, 0.0, 1)
        play_view.sync(&mut v, &s, true)
        fl_y := core.transform_point(&v.graph.world(boot_fl).matrix, sole_fl).y
        fr_y := core.transform_point(&v.graph.world(boot_fr).matrix, sole_fr).y
        assert(fl_y >= base_fl_y - 0.01 && fr_y >= base_fr_y - 0.01)
        if fl_y - base_fl_y > max_fl_lift { max_fl_lift = fl_y - base_fl_y }
        if fr_y - base_fr_y > max_fr_lift { max_fr_lift = fr_y - base_fr_y }
        if (fl_y - fr_y).abs() > 0.04 { saw_alternate = true }
    }
    assert(max_fl_lift > 0.05 && max_fr_lift > 0.05 && saw_alternate)
}

@test fn sit_progresses_through_loaf_sleepy_bob_and_deep_snooze() {
    level := play.demo()
    mut s := play.start(&level)
    c := fox.clips().unwrap()
    g := expression.gestures().unwrap()
    step(&mut s, 0.0, 5)
    play.toggle_sit(&mut s)
    // Early sit (0.6s): seated cleanly, not yet loafed or snoozing.
    step(&mut s, 0.0, 36)
    early_sit := acting_at(&s, &c, &g)
    assert(early_sit.acting.sit > 0.95 && early_sit.acting.loaf == 0.0 && early_sit.acting.snooze == 0.0)
    // Mid sit (3.2s): curled into a cozy fox loaf with drowsy sleepy head nod.
    step(&mut s, 0.0, 156)
    loaf_drowsy := acting_at(&s, &c, &g)
    assert(loaf_drowsy.acting.loaf > 0.9 && loaf_drowsy.acting.snooze == 0.0)
    assert(loaf_drowsy.pose.head.x > early_sit.pose.head.x + 0.05)
    assert(loaf_drowsy.pose.eye_open < early_sit.pose.eye_open)
    // Deep snooze (6.5s): eyes peacefully closed, dreamy slow breathing.
    step(&mut s, 0.0, 198)
    deep := acting_at(&s, &c, &g)
    assert(deep.acting.snooze == 1.0 && deep.pose.eye_open == 0.0)
}

@test fn growing_bouquet_supports_ten_flowers_and_wiggles_on_pickup() {
    mut level := play.demo()
    mut extra := 0
    while level.entities.len < 60 && extra < 5 {
        fl := level.entities[2].clone()
        mut copy := fl
        copy.name = "ExtraBlomma " + extra.str()
        copy.position = core.vec3(3.0 + f32(extra) * 1.1, 0.45, -2.5)
        level.entities.push(move copy)
        extra += 1
    }
    mut s := play.start(&level)
    assert(s.total_flowers >= 10)
    mut v := play_view.build(&s).unwrap()
    assert(v.cast.foxes[0].stems.len == s.total_flowers)
    // Every single stem up to the 10th exists and toggles independently.
    stem0 := find_node(&v, "BouquetStem_0").unwrap()
    stem9 := find_node(&v, "BouquetStem_9").unwrap()
    bouquet := find_node(&v, "Bouquet").unwrap()
    play_view.sync(&mut v, &s, true)
    assert(!v.graph.world(bouquet).visible && !v.graph.world(stem9).visible)

    // Collect all flowers and trigger a fresh pickup wiggle.
    mut last_idx := -1
    for i in 0..s.scene.entities.len {
        if s.scene.entities[i].role == .Flower {
            s.collected[i] = true
            last_idx = i
        }
    }
    s.flowers = s.total_flowers
    s.last_flower = last_idx
    s.picked_tick = s.tick
    step(&mut s, 0.0, 8)
    play_view.sync(&mut v, &s, true)
    assert(v.graph.world(bouquet).visible && v.graph.world(stem0).visible && v.graph.world(stem9).visible)
    assert(v.graph.local(bouquet).scale.x > 1.05)
}
