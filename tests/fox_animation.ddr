import core
import ecs
import gfx
import play
import scene
import ..src.art_asset
import ..src.fox_animation as fox
import ..src.play_view as view
import ..src.woodland_ground as ground

fn still() -> play.PlayerMotion {
    play.PlayerMotion {
        seconds: 0.0, heading: 0.0, walk_phase: 0.0, run_weight: 0.0, grounded: true,
        vertical_velocity: 0.0, takeoff_age: -1.0, landing_age: -1.0, boost_age: -1.0, landing_strength: 0.0,
        bank: 0.0, drive: 0.0
    }
}

fn named(g: &scene.Graph, name: string) -> Option<ecs.Entity> {
    for e in g.nodes() { if g.name(e) == name { return .Some(e) } }
    .None
}

@test fn fox_idle_moves_its_weight_and_listens_with_one_ear_at_a_time() {
    clips := fox.clips().unwrap()
    mut m := still()
    rest := fox.pose(&clips, &m)
    m.seconds = 0.94
    alert := fox.pose(&clips, &m)
    assert(alert.body.scale.y > rest.body.scale.y + 0.015)
    assert(alert.body.position.x > rest.body.position.x + 0.025)
    assert(alert.tail[2].y != rest.tail[2].y && alert.head.y != rest.head.y)
    assert((alert.ears[0].x - alert.ears[1].x).abs() > 0.12)
    m.seconds = 2.23
    assert(fox.pose(&clips, &m).eye_open < 0.05)
    m.seconds = 2.4
    assert(fox.pose(&clips, &m).eye_open > 0.99)
}

@test fn trot_transfers_weight_between_opposite_shoulders_and_unrolls_the_front_wrist() {
    clips := fox.clips().unwrap()
    mut m := still()
    m.run_weight = 1.0
    m.walk_phase = 0.16 * 6.2831853
    left_hind := fox.pose(&clips, &m)
    m.walk_phase = 0.66 * 6.2831853
    right_hind := fox.pose(&clips, &m)
    assert(left_hind.paws[2].position.y == 0.0 && left_hind.paws[1].position.y == 0.0)
    assert(right_hind.paws[3].position.y == 0.0 && right_hind.paws[0].position.y == 0.0)
    assert(right_hind.paws[1].rotation.x > 1.0 && right_hind.paws[2].rotation.x < 0.65)
    assert(left_hind.body.position.x > 0.02 && right_hind.body.position.x < -0.02)
    assert(left_hind.chest.rotation.y > 0.08 && right_hind.chest.rotation.y < -0.08)
    assert(left_hind.shoulders[0].z < 0.0 && left_hind.shoulders[1].z > 0.0)
    m.walk_phase = 0.10 * 6.2831853
    contact := fox.pose(&clips, &m)
    m.walk_phase = 0.36 * 6.2831853
    passing := fox.pose(&clips, &m)
    assert(passing.body.position.y > contact.body.position.y + 0.08)
    m.bank = 1.0
    m.drive = 0.80
    turn := fox.pose(&clips, &m)
    assert(turn.body.rotation.z < passing.body.rotation.z - 0.10)
    assert(turn.chest.rotation.x < passing.chest.rotation.x - 0.04 && turn.head.y > passing.head.y + 0.1)
}

@test fn fox_jump_gathers_at_the_apex_and_yields_then_rebounds_on_landing() {
    clips := fox.clips().unwrap()
    mut m := still()
    m.grounded = false
    m.takeoff_age = 0.075
    m.vertical_velocity = 5.0
    normal := fox.pose(&clips, &m)
    m.boost_age = m.takeoff_age
    boosted := fox.pose(&clips, &m)
    assert(boosted.body.scale.y > normal.body.scale.y + 0.09 && boosted.ears[0].x < normal.ears[0].x - 0.10)
    m.boost_age = -1.0
    m.takeoff_age = 0.5
    m.vertical_velocity = 0.0
    apex := fox.pose(&clips, &m)
    m.takeoff_age = 0.95
    m.vertical_velocity = -4.5
    fall := fox.pose(&clips, &m)
    assert(normal.body.rotation.x < 0.0 && fall.body.rotation.x > 0.0 && apex.body.scale.z < fall.body.scale.z - 0.12)
    m.grounded = true
    m.vertical_velocity = 0.0
    m.landing_strength = 1.0
    m.landing_age = 0.0
    contact := fox.pose(&clips, &m)
    assert((fall.body.rotation.x - contact.body.rotation.x).abs() < 0.001)
    m.landing_age = 0.055
    impact := fox.pose(&clips, &m)
    m.landing_age = 0.16
    recoil := fox.pose(&clips, &m)
    m.landing_age = 0.40
    settled := fox.pose(&clips, &m)
    assert(impact.body.scale.y < 0.85 && impact.body.scale.x > 1.05)
    assert(recoil.body.scale.y > 1.05 && settled.body.scale.y == 1.0)
}

@test fn standing_fox_keeps_its_soles_still_as_the_shoulders_breathe_and_both_eyes_blink() {
    level := play.demo()
    mut s := play.start(&level)
    mut world := view.build(&s).unwrap()
    view.sync(&mut world, &s, true)
    left := named(&world.graph, "EyeL_Dew").unwrap()
    right := named(&world.graph, "EyeR_Iris").unwrap()
    ear := named(&world.graph, "EarL_EarRose").unwrap()
    paw := named(&world.graph, "FootFL_Boots").unwrap()
    shin := named(&world.graph, "ShinFL_Foxglove").unwrap()
    rigged := art_asset.load_rigged("fox").unwrap()
    sole := rigged.rig.get("FootFL").unwrap().sole.unwrap()
    start := world.graph.world(ear).matrix.clone()
    boot := world.graph.world(paw).matrix.clone()
    knee := world.graph.world(shin).matrix.clone()
    at := core.transform_point(&boot, sole)
    for _ in 0..55 { play.step(&mut s, play.Input { x: 0.0, z: 0.0, jump: false }) }
    view.sync(&mut world, &s, true)
    breath := core.transform_point(&world.graph.world(paw).matrix, sole)
    assert(core.length(core.sub(breath, at)) < 0.003 && at.y > 0.01 && at.y < 0.03)
    assert((world.graph.world(shin).matrix.m[6] - knee.m[6]).abs() > 0.008)
    for _ in 55..134 { play.step(&mut s, play.Input { x: 0.0, z: 0.0, jump: false }) }
    view.sync(&mut world, &s, true)
    assert(!world.graph.world(left).visible && !world.graph.world(right).visible && world.graph.world(ear).visible)
    s = play.start(&level)
    view.sync(&mut world, &s, true)
    assert(world.graph.world(left).visible && world.graph.world(right).visible)
    for i in 0..16 {
        assert(world.graph.world(ear).matrix.m[i] == start.m[i])
        assert(world.graph.world(paw).matrix.m[i] == boot.m[i])
    }
}

@test fn all_four_imported_feet_bear_weight_and_keep_world_contact_over_full_running_strides() {
    mut level := play.demo()
    level.bounds = .None
    mut s := play.start(&level)
    mut world := view.build(&s).unwrap()
    rigged := art_asset.load_rigged("fox").unwrap()
    mut soles: []core.Vec3 = []
    mut boots: []ecs.Entity = []
    for part in ["FootFL", "FootFR", "FootBL", "FootBR"] {
        soles.push(rigged.rig.get(part).unwrap().sole.unwrap())
        boots.push(named(&world.graph, part + "_Boots").unwrap())
    }
    mut previous: [core.Vec3; 4] = [core.vec3(0.0, 0.0, 0.0); 4]
    mut planted: [i32; 4] = [0; 4]
    mut lifted: [i32; 4] = [0; 4]
    mut diagonals: [i32; 2] = [0; 2]
    for tick in 0..50 {
        play.step(&mut s, play.Input { x: 1.0, z: 0.0, jump: false })
        view.sync(&mut world, &s, true)
        mut lowest: f32 = 1.0
        for i in 0..4 {
            sample := core.transform_point(&world.graph.world(boots[i]).matrix, soles[i])
            if sample.y < lowest { lowest = sample.y }
            if tick > 10 {
                assert(sample.y > -0.012)
                if sample.y < 0.032 && previous[i].y < 0.032 && core.length(core.sub(sample, previous[i])) < 0.012 { planted[i] += 1 }
                if sample.y > 0.12 { lifted[i] += 1 }
            }
            previous[i] = sample
        }
        if tick > 10 {
            assert(lowest < 0.039)
            heights := [previous[0].y, previous[1].y, previous[2].y, previous[3].y]
            if heights[1] < 0.036 && heights[2] < 0.036 && heights[0] > 0.11 && heights[3] > 0.09 { diagonals[0] += 1 }
            if heights[0] < 0.036 && heights[3] < 0.036 && heights[1] > 0.11 && heights[2] > 0.09 { diagonals[1] += 1 }
        }
    }
    for i in 0..4 { assert(planted[i] >= 8 && lifted[i] >= 6) }
    assert(diagonals[0] >= 5 && diagonals[1] >= 5)
}

@test fn planted_foot_stays_on_one_world_point_through_a_banked_turn_and_subticks() {
    level := play.demo()
    mut s := play.start(&level)
    mut world := view.build(&s).unwrap()
    foot := named(&world.graph, "FootBL_Boots").unwrap()
    rigged := art_asset.load_rigged("fox").unwrap()
    sole := rigged.rig.get("FootBL").unwrap().sole.unwrap()
    mut contact := core.vec3(0.0, 0.0, 0.0)
    mut holding := false
    mut samples := 0
    for tick in 0..26 {
        diagonal := tick >= 17
        play.step(&mut s, play.Input { x: 1.0, z: if diagonal { 1.0 } else { 0.0 }, jump: false })
        for fraction in [0.0, 0.5] {
            s.accumulator = fraction
            m := play.render_motion(&s, false)
            phase := m.walk_phase / 6.2831853
            if tick < 14 || phase < 0.0 || phase > 0.37 { holding = false; continue }
            view.sync(&mut world, &s, false)
            now := core.transform_point(&world.graph.world(foot).matrix, sole)
            if holding {
                assert((now.x - contact.x).abs() + (now.z - contact.z).abs() < 0.018)
                if m.bank.abs() > 0.05 { samples += 1 }
            } else { contact = now; holding = true }
        }
    }
    assert(samples >= 3)
}

@test fn planted_hind_paw_leaves_its_actual_footprint_on_the_first_jump_tick() {
    level := play.demo()
    mut s := play.start(&level)
    mut world := view.build(&s).unwrap()
    foot := named(&world.graph, "FootBL_Boots").unwrap()
    art := art_asset.load_rigged("fox").unwrap()
    sole := art.rig.get("FootBL").unwrap().sole.unwrap()
    for _ in 0..20 { play.step(&mut s, play.Input { x: 1.0, z: 0.0, jump: false }) }
    view.sync(&mut world, &s, true)
    planted := core.transform_point(&world.graph.world(foot).matrix, sole)
    assert(planted.y < 0.035)
    play.step(&mut s, play.Input { x: 1.0, z: 0.0, jump: true })
    view.sync(&mut world, &s, true)
    pushing := core.transform_point(&world.graph.world(foot).matrix, sole)
    assert(!play.render_motion(&s, true).grounded)
    assert((pushing.x - planted.x).abs() + (pushing.z - planted.z).abs() < 0.035)
    assert((pushing.y - planted.y).abs() < 0.075)
}

@test fn landing_keeps_the_leading_front_heel_above_the_rendered_meadow() {
    level := play.demo()
    mut s := play.start(&level)
    mut world := view.build(&s).unwrap()
    foot := named(&world.graph, "FootFL_Boots").unwrap()
    vertices := world.graph.vertices(foot)
    play.step(&mut s, play.Input { x: 1.0, z: 0.0, jump: true })
    for _ in 0..95 {
        if play.render_motion(&s, true).grounded { break }
        play.step(&mut s, play.Input { x: 0.0, z: 0.0, jump: false })
    }
    assert(play.render_motion(&s, true).landing_age == 0.0)
    for _ in 0..7 {
        view.sync(&mut world, &s, true)
        matrix := &world.graph.world(foot).matrix
        support_y := play.position(&s, world.player_node).y - 0.4
        mut lowest: f32 = 2.0
        for j in 0..(vertices.len / gfx.VERTEX_FLOATS) {
            b := j * gfx.VERTEX_FLOATS
            pt := core.transform_point(matrix, core.vec3(vertices[b], vertices[b + 1], vertices[b + 2]))
            surface := support_y + ground.height(&world.cast.ground, &world.course, &s, pt.x, pt.z, support_y, true)
            if pt.y - surface < lowest { lowest = pt.y - surface }
        }
        assert(lowest >= -0.006 && lowest < 0.045)
        play.step(&mut s, play.Input { x: 0.0, z: 0.0, jump: false })
    }
}

struct TailMesh { node: ecs.Entity, vertices: []f32 }

@test fn furthest_tail_vertices_clear_the_meadow_in_a_full_speed_trot_and_reversal() {
    level := play.demo()
    mut s := play.start(&level)
    mut world := view.build(&s).unwrap()
    mut meshes: []TailMesh = []
    for e in world.graph.names().entities() {
        name := world.graph.name(e)
        if name.len >= 4 && name[0..4] == "Tail" {
            meshes.push(TailMesh { node: e, vertices: world.graph.vertices(e) })
        }
    }
    assert(meshes.len >= 3)
    periods := [22, 40, 1, 17, 30, 80, 70]
    pace: [f32; 7] = [0.0, -1.0, 0.2, 0.0, 0.0, 1.0, -1.0]
    for part in 0..periods.len {
        for _ in 0..periods[part] {
            play.step(&mut s, play.Input { x: pace[part], z: if part == 0 { 1.0 } else { 0.0 }, jump: false })
            if part < 5 { continue }
            view.sync(&mut world, &s, true)
            support := play.position(&s, world.player_node).y - 0.4
            for i in 0..meshes.len {
                skin := &meshes[i]
                matrix := &world.graph.world(skin.node).matrix
                mut lowest := core.vec3(0.0, 10.0, 0.0)
                for j in 0..(skin.vertices.len / gfx.VERTEX_FLOATS) {
                    b := j * gfx.VERTEX_FLOATS
                    q := core.transform_point(matrix, core.vec3(skin.vertices[b], skin.vertices[b + 1], skin.vertices[b + 2]))
                    if q.y < lowest.y { lowest = q }
                }
                surface := support + ground.height(&world.cast.ground, &world.course, &s, lowest.x, lowest.z, support, true)
                assert(lowest.y > surface + 0.025)
            }
        }
    }
}

@test fn braking_gathers_the_paws_and_the_next_step_starts_from_that_stance() {
    level := play.demo()
    mut s := play.start(&level)
    mut world := view.build(&s).unwrap()
    model := art_asset.load_rigged("fox").unwrap()
    mut soles: []core.Vec3 = []
    mut boots: []ecs.Entity = []
    for part in ["FootFL", "FootFR", "FootBL", "FootBR"] {
        soles.push(model.rig.get(part).unwrap().sole.unwrap())
        boots.push(named(&world.graph, part + "_Boots").unwrap())
    }
    for _ in 0..31 { play.step(&mut s, play.Input { x: 1.0, z: 0.0, jump: false }) }
    for _ in 0..38 { play.step(&mut s, play.Input { x: 0.0, z: 0.0, jump: false }) }
    view.sync(&mut world, &s, true)
    center := play.position(&s, world.player_node)
    mut last: [core.Vec3; 4] = [core.vec3(0.0, 0.0, 0.0); 4]
    for i in 0..4 {
        last[i] = core.transform_point(&world.graph.world(boots[i]).matrix, soles[i])
        assert((last[i].x - center.x - soles[i].z).abs() < 0.018)
        assert((last[i].z - center.z + soles[i].x).abs() < 0.018)
    }
    for tick in 0..5 {
        play.step(&mut s, play.Input { x: if tick < 2 { 1.0 } else { 0.0 }, z: 0.0, jump: false })
        view.sync(&mut world, &s, true)
        for i in 0..4 {
            now := core.transform_point(&world.graph.world(boots[i]).matrix, soles[i])
            if now.y < 0.045 && last[i].y < 0.045 { assert(core.length(core.sub(now, last[i])) < 0.08) }
            last[i] = now
        }
    }
}

@test fn front_paw_peels_its_heel_off_a_world_fixed_toe() {
    level := play.demo()
    mut s := play.start(&level)
    mut world := view.build(&s).unwrap()
    art := art_asset.load_rigged("fox").unwrap()
    shoe := art.rig.get("FootFR").unwrap()
    toe := shoe.toe.unwrap()
    sole := shoe.sole.unwrap()
    boot := named(&world.graph, "FootFR_Boots").unwrap()
    mut held := false
    mut at := core.vec3(0.0, 0.0, 0.0)
    mut samples := 0
    mut lifted := false
    for tick in 0..42 {
        play.step(&mut s, play.Input { x: 1.0, z: 0.0, jump: false })
        for fraction in [0.0, 0.5] {
            s.accumulator = fraction
            m := play.render_motion(&s, false)
            phase := m.walk_phase / 6.2831853 - 0.027
            if tick < 12 || phase < 0.32 || phase > 0.47 { held = false; continue }
            view.sync(&mut world, &s, false)
            matrix := &world.graph.world(boot).matrix
            contact := core.transform_point(matrix, toe)
            heel := core.transform_point(matrix, core.sub(core.scale(sole, 2.0), toe))
            if held {
                assert((contact.x - at.x).abs() + (contact.z - at.z).abs() < 0.012)
                samples += 1
            } else { held = true; at = contact }
            if heel.y - contact.y > 0.055 { lifted = true }
        }
    }
    assert(samples >= 4 && lifted)
}

@test fn cozy_stroll_warms_up_mid_speed_without_touching_stand_or_full_trot() {
    clips := fox.clips().unwrap()
    mut m := still()
    m.seconds = 0.72
    m.walk_phase = 1.15
    m.run_weight = 0.0
    stand := fox.pose(&clips, &m)
    m.run_weight = 0.06
    early := fox.pose(&clips, &m)
    m.run_weight = 0.12
    low := fox.pose(&clips, &m)
    m.run_weight = 0.46
    stroll := fox.pose(&clips, &m)
    m.run_weight = 0.80
    high := fox.pose(&clips, &m)
    m.run_weight = 0.90
    late := fox.pose(&clips, &m)
    m.run_weight = 1.0
    trot := fox.pose(&clips, &m)
    // Pose stays strictly linear (zero stroll layer) on [0.0, 0.12] and [0.80, 1.0].
    assert((early.tail[2].y - 0.5 * (stand.tail[2].y + low.tail[2].y)).abs() < 0.0001)
    assert((late.tail[2].y - 0.5 * (high.tail[2].y + trot.tail[2].y)).abs() < 0.0001)
    assert((early.head.z - 0.5 * (stand.head.z + low.head.z)).abs() < 0.0001)
    assert((late.head.z - 0.5 * (high.head.z + trot.head.z)).abs() < 0.0001)
    // At peak stroll (0.46), tail wag/pitch, head tilt, and ear bounce layer cleanly above linear blend.
    assert((stroll.tail[2].x - 0.5 * (low.tail[2].x + high.tail[2].x)).abs() > 0.08)
    assert((stroll.tail[2].y - 0.5 * (low.tail[2].y + high.tail[2].y)).abs() > 0.08)
    assert((stroll.head.z - 0.5 * (low.head.z + high.head.z)).abs() > 0.04)
    m.walk_phase = 2.65
    m.run_weight = 0.12
    low_b := fox.pose(&clips, &m)
    m.run_weight = 0.46
    stroll_b := fox.pose(&clips, &m)
    m.run_weight = 0.80
    high_b := fox.pose(&clips, &m)
    assert((stroll_b.ears[0].x - 0.5 * (low_b.ears[0].x + high_b.ears[0].x)).abs() > 0.03)
}

@test fn cozy_sit_lowers_pelvis_folds_hind_knees_and_clears_meadow_and_cloud_surfaces() {
    level := play.demo()
    mut s := play.start(&level)
    mut world := view.build(&s).unwrap()
    for _ in 0..3 { play.step(&mut s, play.Input { x: 0.0, z: 0.0, jump: false }) }
    view.sync(&mut world, &s, true)
    body := named(&world.graph, "Body_Foxglove").unwrap()
    pelvis := core.vec3(0.0, 0.55, -0.36)
    stand_body_y := core.transform_point(&world.graph.world(body).matrix, pelvis).y
    rigged := art_asset.load_rigged("fox").unwrap()
    mut soles: []core.Vec3 = []
    mut boots: []ecs.Entity = []
    mut boot_verts: [][]f32 = []
    for part in ["FootFL", "FootFR", "FootBL", "FootBR"] {
        soles.push(rigged.rig.get(part).unwrap().sole.unwrap())
        b := named(&world.graph, part + "_Boots").unwrap()
        boots.push(b)
        boot_verts.push(world.graph.vertices(b))
    }
    mut stand_soles: [core.Vec3; 4] = [core.vec3(0.0, 0.0, 0.0); 4]
    for i in 0..4 {
        stand_soles[i] = core.transform_point(&world.graph.world(boots[i]).matrix, soles[i])
    }
    mut tail_meshes: []TailMesh = []
    for e in world.graph.names().entities() {
        name := world.graph.name(e)
        if name.len >= 4 && name[0..4] == "Tail" {
            tail_meshes.push(TailMesh { node: e, vertices: world.graph.vertices(e) })
        }
    }
    body_verts := world.graph.vertices(body)
    // Sit on the meadow and verify pelvis drop, hind tuck, front stability, and zero clipping.
    play.toggle_sit(&mut s)
    for _ in 0..35 { play.step(&mut s, play.Input { x: 0.0, z: 0.0, jump: false }) }
    assert(s.cozy_sitting && play.render_cozy(&s, true).sit_weight > 0.98)
    view.sync(&mut world, &s, true)
    sit_body_y := core.transform_point(&world.graph.world(body).matrix, pelvis).y
    assert(sit_body_y < stand_body_y - 0.10)
    heading := play.render_motion(&s, true).heading
    fwd_x := heading.sin()
    fwd_z := heading.cos()
    for i in 0..4 {
        now := core.transform_point(&world.graph.world(boots[i]).matrix, soles[i])
        delta := core.sub(now, stand_soles[i])
        along := delta.x * fwd_x + delta.z * fwd_z
        if i < 2 { assert(core.length(core.vec3(delta.x, 0.0, delta.z)) < 0.03) }
        else { assert(along > 0.10) }
    }
    for pass in 0..2 {
        if pass == 1 {
            // Continue into cozy snooze and check surface clearance again.
            for _ in 0..380 { play.step(&mut s, play.Input { x: 0.0, z: 0.0, jump: false }) }
            view.sync(&mut world, &s, true)
        }
        support := play.position(&s, world.player_node).y - 0.4
        for i in 0..4 {
            matrix := &world.graph.world(boots[i]).matrix
            verts := &boot_verts[i]
            for j in 0..(verts.len / gfx.VERTEX_FLOATS) {
                b := j * gfx.VERTEX_FLOATS
                pt := core.transform_point(matrix, core.vec3(verts[b], verts[b + 1], verts[b + 2]))
                surface := support + ground.height(&world.cast.ground, &world.course, &s, pt.x, pt.z, support, true)
                assert(pt.y >= surface - 0.006)
            }
        }
        for i in 0..tail_meshes.len {
            skin := &tail_meshes[i]
            matrix := &world.graph.world(skin.node).matrix
            for j in 0..(skin.vertices.len / gfx.VERTEX_FLOATS) {
                b := j * gfx.VERTEX_FLOATS
                pt := core.transform_point(matrix, core.vec3(skin.vertices[b], skin.vertices[b + 1], skin.vertices[b + 2]))
                surface := support + ground.height(&world.cast.ground, &world.course, &s, pt.x, pt.z, support, true)
                assert(pt.y > surface + 0.015)
            }
        }
        body_mat := &world.graph.world(body).matrix
        for j in 0..(body_verts.len / gfx.VERTEX_FLOATS) {
            b := j * gfx.VERTEX_FLOATS
            pt := core.transform_point(body_mat, core.vec3(body_verts[b], body_verts[b + 1], body_verts[b + 2]))
            surface := support + ground.height(&world.cast.ground, &world.course, &s, pt.x, pt.z, support, true)
            assert(pt.y > surface + 0.010)
        }
    }
    // Sit on a high cloud platform and verify all 4 boots and tail clear the cloud surface.
    mut cloud_s := play.start(&level)
    cloud_s.bodies[cloud_s.player].position = core.vec3(-1.85, 0.88 + 0.4, 0.48)
    cloud_s.bodies[cloud_s.player].velocity = core.vec3(0.0, 0.0, 0.0)
    for _ in 0..5 { play.step(&mut cloud_s, play.Input { x: 0.0, z: 0.0, jump: false }) }
    assert(cloud_s.bodies[cloud_s.player].grounded)
    play.toggle_sit(&mut cloud_s)
    for _ in 0..35 { play.step(&mut cloud_s, play.Input { x: 0.0, z: 0.0, jump: false }) }
    assert(cloud_s.cozy_sitting && cloud_s.bodies[cloud_s.player].grounded)
    view.sync(&mut world, &cloud_s, true)
    cloud_support := play.position(&cloud_s, world.player_node).y - 0.4
    for i in 0..4 {
        matrix := &world.graph.world(boots[i]).matrix
        verts := &boot_verts[i]
        for j in 0..(verts.len / gfx.VERTEX_FLOATS) {
            b := j * gfx.VERTEX_FLOATS
            pt := core.transform_point(matrix, core.vec3(verts[b], verts[b + 1], verts[b + 2]))
            surface := cloud_support + ground.height(&world.cast.ground, &world.course, &cloud_s, pt.x, pt.z, cloud_support, true)
            assert(pt.y >= surface - 0.006)
        }
    }
    for i in 0..tail_meshes.len {
        skin := &tail_meshes[i]
        matrix := &world.graph.world(skin.node).matrix
        for j in 0..(skin.vertices.len / gfx.VERTEX_FLOATS) {
            b := j * gfx.VERTEX_FLOATS
            pt := core.transform_point(matrix, core.vec3(skin.vertices[b], skin.vertices[b + 1], skin.vertices[b + 2]))
            surface := cloud_support + ground.height(&world.cast.ground, &world.course, &cloud_s, pt.x, pt.z, cloud_support, true)
            assert(pt.y > surface + 0.015)
        }
    }
}
