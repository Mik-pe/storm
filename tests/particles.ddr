import core
import ecs
import gfx
import play
import scene
import ..src.canopy
import ..src.particles
import ..src.play_view

fn visible_count(g: &scene.Graph, ids: &[]ecs.Entity) -> i32 {
    mut n := 0
    for id in ids { if g.local(id).visible { n += 1 } }
    n
}

@test fn cloud_and_butterfly_particles_replay_at_exact_ticks_without_changing_meshes() {
    mut level := play.empty("Particles")
    assert(play.upsert(&mut level, "{\"name\":\"Fox\",\"shape\":\"sphere\",\"role\":\"player\",\"mass\":1,\"position\":[1,2,0]}").is_ok())
    assert(play.upsert(&mut level, "{\"name\":\"Cloud\",\"shape\":\"box\",\"role\":\"cloud\"}").is_ok())
    assert(play.upsert(&mut level, "{\"name\":\"Boost\",\"shape\":\"box\",\"role\":\"boost_cloud\"}").is_ok())
    assert(play.upsert(&mut level, "{\"name\":\"Wings\",\"shape\":\"sphere\",\"role\":\"super_butterfly\",\"position\":[1,3,0]}").is_ok())
    assert(play.upsert(&mut level, "{\"name\":\"Boost2\",\"shape\":\"box\",\"role\":\"boost_cloud\",\"position\":[4,2,-2]}").is_ok())
    mut s := play.start(&level)
    mut g := scene.Graph::new()
    fx := particles.build(&mut g)
    n := g.len()
    revision := g.geometry_revision()
    mut owners := 0
    for mesh in g.mesh_snapshot() { if mesh.vertices.len > 0 { owners += 1 } }
    assert(owners == 3 && n == fx.puffs.len + fx.trail.len + fx.burst.len + fx.aura.len + fx.boost_sparkles.len)
    particles.animate(&mut g, &fx, &s, true)
    assert(visible_count(&g, &fx.aura) == fx.aura.len && visible_count(&g, &fx.puffs) == 0 && visible_count(&g, &fx.burst) == 0)
    // Extra BoostCloud beyond the first receives 3 orbiting shimmer sparkles.
    assert(visible_count(&g, &fx.boost_sparkles) == 3)

    s.cloud_tick = 40
    s.tick = 40
    s.accumulator = 0.5
    s.last_cloud = 1
    particles.animate(&mut g, &fx, &s, false)
    assert(visible_count(&g, &fx.puffs) == 0)
    particles.animate(&mut g, &fx, &s, true)
    assert(visible_count(&g, &fx.puffs) == fx.puffs.len)
    s.tick = 49
    s.last_cloud = 1
    s.cloud_origin = core.vec3(0.6, 1.3, 0.08)
    particles.animate(&mut g, &fx, &s, true)
    assert(visible_count(&g, &fx.puffs) == fx.puffs.len && visible_count(&g, &fx.trail) == 0)
    for puff in fx.puffs { assert(g.local(puff).position.y - g.local(puff).scale.y > s.cloud_origin.y) }
    s.last_cloud = 2
    s.last_butterfly = 3
    s.collected[3] = true
    s.butterfly_tick = 40
    particles.animate(&mut g, &fx, &s, true)
    assert(visible_count(&g, &fx.trail) == fx.trail.len && visible_count(&g, &fx.burst) == fx.burst.len && visible_count(&g, &fx.aura) == 0)
    before := g.local(fx.burst[1]).position
    s.tick = 92
    particles.animate(&mut g, &fx, &s, true)
    assert(visible_count(&g, &fx.puffs) == 0 && visible_count(&g, &fx.trail) == 0 && visible_count(&g, &fx.burst) > 0)
    s.tick = 120
    particles.animate(&mut g, &fx, &s, true)
    assert(visible_count(&g, &fx.burst) == 0)
    s.tick = 49
    particles.animate(&mut g, &fx, &s, true)
    after := g.local(fx.burst[1]).position
    assert(after.x == before.x && after.y == before.y && after.z == before.z)
    s = play.start(&level)
    particles.animate(&mut g, &fx, &s, true)
    assert(visible_count(&g, &fx.aura) == fx.aura.len && visible_count(&g, &fx.puffs) + visible_count(&g, &fx.trail) + visible_count(&g, &fx.burst) == 0)
    assert(g.len() == n && g.geometry_revision() == revision)
}

fn default_cue() -> particles.CozyCue {
    particles.CozyCue {
        fox: core.vec3(0.0, 0.4, 1.0), support_y: 0.0, grounded: true,
        landing_age: -1.0, landing_strength: 0.0, pet_age: -1.0, emote_age: -1.0,
        snoozing: false, won: false, guide_active: false,
        guide_pos: core.vec3(0.0, 0.0, 0.0), guide_age: 0.0, boost_pos: .None,
    }
}

@test fn cozy_effects_replay_deterministically_and_share_upward_ring_geometry() {
    mut g := scene.Graph::new()
    empty := particles.empty_cozy()
    particles.animate_cozy(&mut g, &empty, 0.5, &default_cue())
    assert(g.len() == 0)

    fx := particles.build_cozy(&mut g)
    n := g.len()
    revision := g.geometry_revision()
    mut owners := 0
    for mesh in g.mesh_snapshot() { if mesh.vertices.len > 0 { owners += 1 } }
    expected_nodes := fx.fireflies.len + fx.sun_motes.len + fx.dandelions.len + 3 +
    fx.landing_puffs.len + fx.hearts.len + fx.snooze.len + fx.snooze_bubbles.len + fx.boost_shimmer.len
    assert(owners == 6 && n == expected_nodes)
    assert(fx.fireflies.len == 12 && fx.sun_motes.len == 20 && fx.dandelions.len == 24)
    assert(fx.landing_puffs.len == 7 && fx.hearts.len == 10 && fx.snooze.len == 4 && fx.snooze_bubbles.len == 4)

    // Verify ring_mesh lies in XZ with upward normals and CCW +Y winding.
    ring_verts := g.vertices(fx.landing_halo)
    assert(ring_verts.len == 16 * 6 * gfx.VERTEX_FLOATS)
    mut tri := 0
    while tri + 3 * gfx.VERTEX_FLOATS <= ring_verts.len {
        a := core.vec3(ring_verts[tri], ring_verts[tri + 1], ring_verts[tri + 2])
        b := core.vec3(ring_verts[tri + gfx.VERTEX_FLOATS], ring_verts[tri + gfx.VERTEX_FLOATS + 1], ring_verts[tri + gfx.VERTEX_FLOATS + 2])
        c := core.vec3(ring_verts[tri + 2 * gfx.VERTEX_FLOATS], ring_verts[tri + 2 * gfx.VERTEX_FLOATS + 1], ring_verts[tri + 2 * gfx.VERTEX_FLOATS + 2])
        assert(a.y == 0.0 && b.y == 0.0 && c.y == 0.0)
        assert(ring_verts[tri + 4] == 1.0 && core.cross(core.sub(b, a), core.sub(c, a)).y > 0.0)
        tri += 3 * gfx.VERTEX_FLOATS
    }

    // All cozy particles keep alpha < 0.999 so they blend softly without casting shadows.
    for id in g.nodes() { assert(g.material_at(id).base.a < 0.999) }

    mut cue := default_cue()
    cue.grounded = false
    cue.fox = core.vec3(-1.85, 2.2, 0.48)
    cue.support_y = 0.88
    cue.guide_active = true
    cue.guide_pos = core.vec3(1.2, 0.0, -0.8)
    cue.guide_age = 0.35
    cue.pet_age = 0.40
    cue.snoozing = true
    cue.boost_pos = .Some(core.vec3(-0.2, 1.56, -1.68))

    particles.animate_cozy(&mut g, &fx, 1.25, &cue)
    firefly_before := g.local(fx.fireflies[3]).position
    mote_before := g.local(fx.sun_motes[7]).position
    dandelion_before := g.local(fx.dandelions[5]).position
    halo_before := g.local(fx.landing_halo).scale
    guide_yaw_before := g.local(fx.guide_ring).rotation_y
    heart_before := g.local(fx.hearts[2]).position
    snooze_before := g.local(fx.snooze[1]).position
    bubble_before := g.local(fx.snooze_bubbles[2]).position
    shimmer_before := g.local(fx.boost_shimmer[0]).position

    mut later := default_cue()
    later.won = true
    particles.animate_cozy(&mut g, &fx, 4.75, &later)
    assert(visible_count(&g, &fx.fireflies) == 12 && visible_count(&g, &fx.sun_motes) == 20 && visible_count(&g, &fx.dandelions) == 24)
    assert(!g.local(fx.landing_halo).visible && !g.local(fx.guide_ring).visible && !g.local(fx.guide_heart).visible)
    assert(visible_count(&g, &fx.hearts) == 0 && visible_count(&g, &fx.snooze) == 0 && visible_count(&g, &fx.snooze_bubbles) == 0 && visible_count(&g, &fx.boost_shimmer) == 0)

    // Replay at the earlier time and cue: transforms must match bit-for-bit with zero leaks.
    particles.animate_cozy(&mut g, &fx, 1.25, &cue)
    firefly_after := g.local(fx.fireflies[3]).position
    mote_after := g.local(fx.sun_motes[7]).position
    dandelion_after := g.local(fx.dandelions[5]).position
    halo_after := g.local(fx.landing_halo).scale
    heart_after := g.local(fx.hearts[2]).position
    snooze_after := g.local(fx.snooze[1]).position
    bubble_after := g.local(fx.snooze_bubbles[2]).position
    shimmer_after := g.local(fx.boost_shimmer[0]).position
    assert(firefly_after.x == firefly_before.x && firefly_after.y == firefly_before.y && firefly_after.z == firefly_before.z)
    assert(mote_after.x == mote_before.x && mote_after.y == mote_before.y && mote_after.z == mote_before.z)
    assert(dandelion_after.x == dandelion_before.x && dandelion_after.y == dandelion_before.y && dandelion_after.z == dandelion_before.z)
    assert(halo_after.x == halo_before.x && halo_after.z == halo_before.z)
    assert(g.local(fx.guide_ring).rotation_y == guide_yaw_before)
    assert(heart_after.x == heart_before.x && heart_after.y == heart_before.y && heart_after.z == heart_before.z)
    assert(snooze_after.x == snooze_before.x && snooze_after.y == snooze_before.y && snooze_after.z == snooze_before.z)
    assert(bubble_after.x == bubble_before.x && bubble_after.y == bubble_before.y && bubble_after.z == bubble_before.z)
    assert(shimmer_after.x == shimmer_before.x && shimmer_after.y == shimmer_before.y && shimmer_after.z == shimmer_before.z)
    assert(g.len() == n && g.geometry_revision() == revision)
}

@test fn cozy_cues_toggle_landing_halo_guide_hearts_puffs_and_snooze_cleanly() {
    mut g := scene.Graph::new()
    fx := particles.build_cozy(&mut g)
    revision := g.geometry_revision()

    // Grounded idle: fireflies, zone sun-motes, and dandelions drift across the expanded meadow while cues stay hidden.
    mut cue := default_cue()
    particles.animate_cozy(&mut g, &fx, 0.5, &cue)
    assert(visible_count(&g, &fx.fireflies) == 12)
    assert(visible_count(&g, &fx.sun_motes) == 20)
    assert(visible_count(&g, &fx.dandelions) == 24)
    mut wide_dandelions := 0
    for d in fx.dandelions {
        p := g.local(d).position
        if p.x.abs() > 6.5 || p.z.abs() > 6.0 { wide_dandelions += 1 }
    }
    assert(wide_dandelions >= 8)
    assert(!g.local(fx.landing_halo).visible)
    assert(!g.local(fx.guide_ring).visible && !g.local(fx.guide_heart).visible)
    assert(visible_count(&g, &fx.landing_puffs) == 0)
    assert(visible_count(&g, &fx.hearts) == 0)
    assert(visible_count(&g, &fx.snooze) == 0 && visible_count(&g, &fx.snooze_bubbles) == 0)
    assert(visible_count(&g, &fx.boost_shimmer) == 0)

    // Airborne landing halo: positioned above support_y and scales with clearance height.
    cue.grounded = false
    cue.fox = core.vec3(-1.85, 1.38, 0.48)
    cue.support_y = 0.88
    particles.animate_cozy(&mut g, &fx, 0.0, &cue)
    low_halo := g.local(fx.landing_halo).clone()
    assert(low_halo.visible && low_halo.position.x == -1.85 && low_halo.position.z == 0.48)
    assert((low_halo.position.y - 0.905).abs() < 0.0001)
    cue.fox.y = 3.28
    particles.animate_cozy(&mut g, &fx, 0.0, &cue)
    high_halo := g.local(fx.landing_halo).clone()
    assert(high_halo.visible && high_halo.scale.x > low_halo.scale.x && high_halo.scale.y == 1.0)

    // Click-to-walk destination petal ripple rotates and lifts the heart above the ring.
    cue.grounded = true
    cue.guide_active = true
    cue.guide_pos = core.vec3(2.1, 0.88, -1.2)
    cue.guide_age = 0.30
    particles.animate_cozy(&mut g, &fx, 0.2, &cue)
    ring0 := g.local(fx.guide_ring).clone()
    heart0 := g.local(fx.guide_heart).clone()
    assert(ring0.visible && heart0.visible)
    assert(ring0.position.x == 2.1 && (ring0.position.y - 0.91).abs() < 0.0001 && ring0.position.z == -1.2)
    assert(heart0.position.y > ring0.position.y + 0.1)
    particles.animate_cozy(&mut g, &fx, 0.9, &cue)
    assert(g.local(fx.guide_ring).rotation_y != ring0.rotation_y)

    // Meadow marshmallow landing puffs billow around feet during strong grounded impacts.
    cue.fox = core.vec3(0.4, 0.4, 0.6)
    cue.support_y = 0.0
    cue.landing_age = 0.16
    cue.landing_strength = 0.65
    particles.animate_cozy(&mut g, &fx, 0.9, &cue)
    assert(visible_count(&g, &fx.landing_puffs) == 7)
    for puff in fx.landing_puffs { assert(g.local(puff).position.y >= 0.06) }
    cue.landing_age = 0.50
    particles.animate_cozy(&mut g, &fx, 0.9, &cue)
    assert(visible_count(&g, &fx.landing_puffs) == 0)

    // Petting and emote heart/star bursts rise above Vallmo's head.
    cue.pet_age = 0.35
    particles.animate_cozy(&mut g, &fx, 1.0, &cue)
    assert(visible_count(&g, &fx.hearts) == 10)
    for h in fx.hearts { assert(g.local(h).position.y > cue.fox.y + 0.5) }
    cue.pet_age = 1.85
    cue.emote_age = 0.30
    particles.animate_cozy(&mut g, &fx, 1.0, &cue)
    assert(visible_count(&g, &fx.hearts) == 10)
    cue.emote_age = 1.35
    particles.animate_cozy(&mut g, &fx, 1.0, &cue)
    assert(visible_count(&g, &fx.hearts) == 0)

    // Snooze sparkles and translucent dream bubbles float upward above Vallmo; boost shimmer orbits the pink cloud.
    cue.snoozing = true
    cue.boost_pos = .Some(core.vec3(-0.2, 1.56, -1.68))
    particles.animate_cozy(&mut g, &fx, 1.4, &cue)
    assert(visible_count(&g, &fx.snooze) == 4 && visible_count(&g, &fx.snooze_bubbles) == 4 && visible_count(&g, &fx.boost_shimmer) == 3)
    for sp in fx.snooze { assert(g.local(sp).position.y > cue.fox.y + 0.5) }
    for bub in fx.snooze_bubbles { assert(g.local(bub).position.y > cue.fox.y + 0.5) }
    for st in fx.boost_shimmer {
        d := core.sub(g.local(st).position, core.vec3(-0.2, 1.56, -1.68))
        assert(d.x * d.x + d.z * d.z > 0.5)
    }
    assert(g.geometry_revision() == revision)
}

@test fn canopy_surface_below_and_boost_cloud_pos_resolve_platforms() {
    // Self-contained overlapping cloud fixture stays valid across Blomsterskogen layout updates.
    mut stacked := play.empty("CanopyTest")
    assert(play.upsert(&mut stacked, "{\"name\":\"Ground\",\"shape\":\"box\",\"role\":\"prop\",\"position\":[0,-0.5,0],\"size\":[20,1,20]}").is_ok())
    assert(play.upsert(&mut stacked, "{\"name\":\"Fox\",\"shape\":\"sphere\",\"role\":\"player\",\"mass\":1,\"position\":[0,0.4,1],\"size\":[0.8,0.8,0.8]}").is_ok())
    assert(play.upsert(&mut stacked, "{\"name\":\"LowCloud\",\"shape\":\"box\",\"role\":\"cloud\",\"position\":[-1.85,0.74,0.48],\"size\":[1.48,0.28,1.32]}").is_ok())
    assert(play.upsert(&mut stacked, "{\"name\":\"HighCloud\",\"shape\":\"box\",\"role\":\"cloud\",\"position\":[-2.60,1.52,0.20],\"size\":[1.48,0.28,1.32]}").is_ok())
    assert(play.upsert(&mut stacked, "{\"name\":\"PinkBoost\",\"shape\":\"box\",\"role\":\"boost_cloud\",\"position\":[-0.20,1.56,-1.68],\"size\":[1.48,0.28,1.32]}").is_ok())
    mut s := play.start(&stacked)
    mut world := play_view.build(&s).unwrap()
    // Open meadow returns 0.0.
    assert(canopy.surface_below(&world.course, &s, 0.0, 2.0, 1.0) == 0.0)
    // Overlapping clouds at (-2.2, _, 0.3): LowCloud (0.88) and HighCloud (1.66).
    assert((canopy.surface_below(&world.course, &s, -2.2, 2.5, 0.3) - 1.66).abs() < 0.0001)
    assert((canopy.surface_below(&world.course, &s, -2.2, 1.2, 0.3) - 0.88).abs() < 0.0001)
    // Edge forgiveness (+0.05 in XZ, +0.08 in Y) catches the edge, outside falls back to 0.0.
    assert((canopy.surface_below(&world.course, &s, -1.07, 0.82, 0.48) - 0.88).abs() < 0.0001)
    assert(canopy.surface_below(&world.course, &s, -1.04, 0.82, 0.48) == 0.0)

    boost := canopy.boost_cloud_pos(&world.course, &s).unwrap()
    assert((boost.x + 0.20).abs() < 0.0001 && (boost.y - 1.56).abs() < 0.0001 && (boost.z + 1.68).abs() < 0.0001)

    // Verify demo scene's first BoostCloud matches canopy.boost_cloud_pos dynamically.
    demo := play.demo()
    mut expected_boost := core.vec3(0.0, 0.0, 0.0)
    mut has_boost := false
    for e in demo.entities {
        if e.role == .BoostCloud { expected_boost = e.position; has_boost = true; break }
    }
    assert(has_boost)
    ds := play.start(&demo)
    dw := play_view.build(&ds).unwrap()
    demo_boost := canopy.boost_cloud_pos(&dw.course, &ds).unwrap()
    assert(core.length(core.sub(demo_boost, expected_boost)) < 0.0001)

    mut plain := play.demo()
    plain.theme = .Plain
    plain.entities = [demo.entities[0].clone(), demo.entities[1].clone()]
    ps := play.start(&plain)
    pw := play_view.build(&ps).unwrap()
    assert(canopy.surface_below(&pw.course, &ps, 0.0, 2.0, 0.0) == 0.0)
    assert(canopy.boost_cloud_pos(&pw.course, &ps).is_none())
}
