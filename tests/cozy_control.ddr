import core
import gfx
import input
import play
import std.math as _
import ..src.cozy_control as cozy
import ..src.play_view as view

fn key_bit(key: gfx.Key) -> u32 { u32(1).shl(i32(key)) }

fn empty_input(mx: f32, my: f32) -> gfx.Input {
    gfx.Input { held: 0, pressed: 0, mouse: gfx.Mouse { x: mx, y: my, dx: 0.0, dy: 0.0, buttons: 0, pressed: 0, scroll: 0.0 } }
}

fn project_to_screen(cam: &input.Camera, aspect: f32, width: f32, height: f32, p: core.Vec3) -> (f32, f32) {
    vp := cam.view_projection(aspect)
    cx := vp.m[0] * p.x + vp.m[4] * p.y + vp.m[8] * p.z + vp.m[12]
    cy := vp.m[1] * p.x + vp.m[5] * p.y + vp.m[9] * p.z + vp.m[13]
    cw := vp.m[3] * p.x + vp.m[7] * p.y + vp.m[11] * p.z + vp.m[15]
    assert(cw > 0.0)
    ((cx / cw + 1.0) * 0.5 * width, (cy / cw + 1.0) * 0.5 * height)
}

@test fn pick_ray_round_trips_through_view_projection_for_orbited_and_zoomed_cameras() {
    level := play.demo()
    s := play.start(&level)
    world := view.build(&s).unwrap()
    area := view.framing(&world, &s, true)
    for size in [[1280.0, 800.0], [720.0, 500.0]] {
        w := f32(size[0])
        h := f32(size[1])
        aspect := w / h
        for orbit in [[0.0, 1.0], [0.75, 0.72], [-1.1, 1.32]] {
            cam := view.camera_cozy(&area, aspect, f32(orbit[0]), f32(orbit[1]))
            for pt in [[f32(0.0), f32(0.0)], [w * 0.5, h * 0.5], [w, h], [w * 0.27, h * 0.68], [w * 0.81, h * 0.19]] {
                mx := f32(pt[0])
                my := f32(pt[1])
                dir := cozy.pick_ray(&cam, aspect, w, h, mx, my)
                assert((core.length(dir) - 1.0).abs() < 0.0001)
                world_pt := core.add(cam.position, core.scale(dir, 9.5))
                (rx, ry) := project_to_screen(&cam, aspect, w, h, world_pt)
                assert((rx - mx).abs() < 0.02 && (ry - my).abs() < 0.02)
            }
        }
    }
}

@test fn hovering_and_left_click_on_vallmo_pets_and_clears_walk_target() {
    level := play.demo()
    mut s := play.start(&level)
    world := view.build(&s).unwrap()
    area := view.framing(&world, &s, true)
    w: f32 = 1280.0
    h: f32 = 800.0
    aspect := w / h
    cam := view.camera_cozy(&area, aspect, 0.0, 1.0)
    mut c := cozy.new()

    // First click on ground to arm a walk target.
    ground_pt := core.vec3(2.2, 0.0, 1.0)
    (gx, gy) := project_to_screen(&cam, aspect, w, h, ground_pt)
    mut walk_click := empty_input(gx, gy)
    walk_click.mouse.buttons = gfx.MOUSE_LEFT
    walk_click.mouse.pressed = gfx.MOUSE_LEFT
    _ := cozy.update(&mut c, &mut s, &cam, aspect, w, h, 0.016, &walk_click, 0.0, false)
    assert(c.has_target && !c.hovering_fox)

    // Hovering over Vallmo with ui_captured=true does not hover or pet.
    fox_pt := core.add(s.bodies[s.player].position, core.vec3(0.0, 0.18, 0.0))
    (fx, fy) := project_to_screen(&cam, aspect, w, h, fox_pt)
    mut blocked := empty_input(fx, fy)
    blocked.mouse.buttons = gfx.MOUSE_LEFT
    blocked.mouse.pressed = gfx.MOUSE_LEFT
    _ := cozy.update(&mut c, &mut s, &cam, aspect, w, h, 0.016, &blocked, 0.0, true)
    assert(!c.hovering_fox && s.pet_tick == -1 && c.has_target)

    // Left-clicking Vallmo with ui_captured=false pets her and clears the walk target.
    let_click := blocked
    cmd := cozy.update(&mut c, &mut s, &cam, aspect, w, h, 0.016, &let_click, 0.0, false)
    assert(c.hovering_fox && s.pet_tick == s.tick && !c.has_target && !c.dragging_walk)
    assert(cmd.x == 0.0 && cmd.z == 0.0 && c.toast_text.len > 0 && cozy.toast_alpha(&c) > 0.5)
}

@test fn click_to_walk_tapers_arrives_clamps_bounds_and_cancels_on_keyboard() {
    level := play.demo()
    mut s := play.start(&level)
    world := view.build(&s).unwrap()
    w: f32 = 1280.0
    h: f32 = 800.0
    aspect := w / h
    mut c := cozy.new()

    // Clicking far beyond bounds clamps the guide target to scene.bounds.
    area0 := view.framing(&world, &s, true)
    cam0 := view.camera_cozy(&area0, aspect, 0.0, 1.0)
    (ox, oy) := project_to_screen(&cam0, aspect, w, h, core.vec3(9.0, 0.0, 7.0))
    mut far_click := empty_input(ox, oy)
    far_click.mouse.buttons = gfx.MOUSE_LEFT
    far_click.mouse.pressed = gfx.MOUSE_LEFT
    _ := cozy.update(&mut c, &mut s, &cam0, aspect, w, h, 0.016, &far_click, 0.0, false)
    g := cozy.guide(&c)
    assert(g.active && g.target.x <= 5.0 && g.target.z <= 3.3 && g.target.x >= -5.0 && g.target.z >= -3.5)

    // Keyboard movement immediately cancels click target.
    mut key_w := empty_input(ox, oy)
    key_w.held = key_bit(.W)
    kcmd := cozy.update(&mut c, &mut s, &cam0, aspect, w, h, 0.016, &key_w, 0.0, false)
    assert(!cozy.guide(&c).active && kcmd.x == 0.0 && kcmd.z == -1.0)

    // Hold-to-follow updates target while dragged, then tapers within 1.1m and arrives at 0.18m.
    (tx1, ty1) := project_to_screen(&cam0, aspect, w, h, core.vec3(1.5, 0.0, 1.0))
    mut hold1 := empty_input(tx1, ty1)
    hold1.mouse.buttons = gfx.MOUSE_LEFT
    hold1.mouse.pressed = gfx.MOUSE_LEFT
    _ := cozy.update(&mut c, &mut s, &cam0, aspect, w, h, 0.016, &hold1, 0.0, false)
    (tx2, ty2) := project_to_screen(&cam0, aspect, w, h, core.vec3(2.4, 0.0, 1.0))
    mut hold2 := empty_input(tx2, ty2)
    hold2.mouse.buttons = gfx.MOUSE_LEFT
    _ := cozy.update(&mut c, &mut s, &cam0, aspect, w, h, 0.016, &hold2, 0.0, false)
    assert((c.target.x - 2.4).abs() < 0.08)

    mut saw_full := false
    mut saw_taper := false
    for _ in 0..90 {
        area := view.framing(&world, &s, true)
        cam := view.camera_cozy(&area, aspect, c.yaw, c.zoom)
        cmd := cozy.update(&mut c, &mut s, &cam, aspect, w, h, f32(play.TICK_SECONDS), &empty_input(0.0, 0.0), 0.0, false)
        speed := (cmd.x * cmd.x + cmd.z * cmd.z).sqrt()
        if speed > 0.95 { saw_full = true }
        if speed > 0.40 && speed < 0.95 { saw_taper = true }
        play.step(&mut s, cmd)
        if !c.has_target { break }
    }
    assert(saw_full && saw_taper && !c.has_target)
    final_dx := c.target.x - s.bodies[s.player].position.x
    final_dz := c.target.z - s.bodies[s.player].position.z
    assert((final_dx * final_dx + final_dz * final_dz).sqrt() <= 0.19)
}

@test fn shift_click_near_flower_stops_at_sniff_distance_and_shift_rotates_with_yaw() {
    level := play.demo()
    mut s := play.start(&level)
    world := view.build(&s).unwrap()
    w: f32 = 1280.0
    h: f32 = 800.0
    aspect := w / h
    area0 := view.framing(&world, &s, true)
    cam0 := view.camera_cozy(&area0, aspect, 0.0, 1.0)
    mut c := cozy.new()

    // Shift + click directly on Smörblomma (entity 2).
    flower := s.scene.entities[2].position
    (fx, fy) := project_to_screen(&cam0, aspect, w, h, flower)
    mut shift_click := empty_input(fx, fy)
    shift_click.held = key_bit(.Shift)
    shift_click.mouse.buttons = gfx.MOUSE_LEFT
    shift_click.mouse.pressed = gfx.MOUSE_LEFT
    _ := cozy.update(&mut c, &mut s, &cam0, aspect, w, h, 0.016, &shift_click, 0.0, false)
    assert(c.has_target)

    for _ in 0..90 {
        area := view.framing(&world, &s, true)
        cam := view.camera_cozy(&area, aspect, c.yaw, c.zoom)
        cmd := cozy.update(&mut c, &mut s, &cam, aspect, w, h, f32(play.TICK_SECONDS), &empty_input(0.0, 0.0), 0.0, false)
        play.step(&mut s, cmd)
        if !c.has_target && !c.has_face { break }
    }
    assert(!c.has_target && !c.has_face && !s.collected[2])
    p := s.bodies[s.player].position
    dist := ((p.x - flower.x) * (p.x - flower.x) + (p.z - flower.z) * (p.z - flower.z)).sqrt()
    assert(dist > 0.80 && dist < 1.10)
    to_flower_x := (flower.x - p.x) / dist
    to_flower_z := (flower.z - p.z) / dist
    assert(s.motion.heading.sin() * to_flower_x + s.motion.heading.cos() * to_flower_z > 0.95)

    // Keyboard ergonomics: Shift scales stroll to 0.46, yaw == 0.0 is identity, and yaw rotates XZ accurately.
    mut w_identity := empty_input(0.0, 0.0)
    w_identity.held = key_bit(.W).bit_or(key_bit(.D))
    id_cmd := cozy.update(&mut c, &mut s, &cam0, aspect, w, h, 0.016, &w_identity, 0.0, false)
    assert(id_cmd.x == 1.0 && id_cmd.z == -1.0)

    mut wd_shift := empty_input(0.0, 0.0)
    wd_shift.held = key_bit(.W).bit_or(key_bit(.D)).bit_or(key_bit(.Shift))
    stroll_cmd := cozy.update(&mut c, &mut s, &cam0, aspect, w, h, 0.016, &wd_shift, 0.0, false)
    stroll_mag := (stroll_cmd.x * stroll_cmd.x + stroll_cmd.z * stroll_cmd.z).sqrt()
    assert((stroll_mag - 0.46).abs() < 0.001)

    c.yaw = 1.5707963
    c.target_yaw = 1.5707963
    mut w_only := empty_input(0.0, 0.0)
    w_only.held = key_bit(.W)
    rot_cmd := cozy.update(&mut c, &mut s, &cam0, aspect, w, h, 0.016, &w_only, 0.0, false)
    assert((rot_cmd.x - 1.0).abs() < 0.001 && rot_cmd.z.abs() < 0.001)
}

@test fn elevated_support_plane_and_unshifted_flower_click_work_correctly() {
    level := play.demo()
    mut s := play.start(&level)
    world := view.build(&s).unwrap()
    w: f32 = 1280.0
    h: f32 = 800.0
    aspect := w / h
    area0 := view.framing(&world, &s, true)
    cam0 := view.camera_cozy(&area0, aspect, 0.0, 1.0)
    mut c := cozy.new()

    // Clicking on an elevated cloud plane (y = 1.7) sets guide target.y == 1.7.
    cloud_pt := core.vec3(-1.5, 1.7, 0.2)
    (cx, cy) := project_to_screen(&cam0, aspect, w, h, cloud_pt)
    mut cloud_click := empty_input(cx, cy)
    cloud_click.mouse.buttons = gfx.MOUSE_LEFT
    cloud_click.mouse.pressed = gfx.MOUSE_LEFT
    _ := cozy.update(&mut c, &mut s, &cam0, aspect, w, h, 0.016, &cloud_click, 1.7, false)
    assert(c.has_target && (c.target.y - 1.7).abs() < 0.0001 && (c.target.x - -1.5).abs() < 0.05)

    // Clicking a flower WITHOUT Shift walks through it and collects it.
    flower := s.scene.entities[2].position
    (fx, fy) := project_to_screen(&cam0, aspect, w, h, core.vec3(flower.x, 0.0, flower.z))
    mut normal_click := empty_input(fx, fy)
    normal_click.mouse.buttons = gfx.MOUSE_LEFT
    normal_click.mouse.pressed = gfx.MOUSE_LEFT
    _ := cozy.update(&mut c, &mut s, &cam0, aspect, w, h, 0.016, &normal_click, 0.0, false)
    for _ in 0..80 {
        area := view.framing(&world, &s, true)
        cam := view.camera_cozy(&area, aspect, c.yaw, c.zoom)
        cmd := cozy.update(&mut c, &mut s, &cam, aspect, w, h, f32(play.TICK_SECONDS), &empty_input(0.0, 0.0), 0.0, false)
        play.step(&mut s, cmd)
        if s.collected[2] { break }
    }
    assert(s.collected[2] && s.flowers == 1)
}

@test fn space_jump_buffer_fires_on_landing_within_window_and_expires_after() {
    level := play.demo()
    mut s := play.start(&level)
    world := view.build(&s).unwrap()
    area := view.framing(&world, &s, true)
    cam := view.camera(&area, 1.6)
    mut c := cozy.new()

    // Jump into the air so player is ungrounded.
    play.step(&mut s, play.Input { x: 0.0, z: 0.0, jump: true })
    assert(!s.bodies[s.player].grounded)

    // Press Space mid-air: arms 0.12s buffer, does not jump immediately.
    mut space_hit := empty_input(0.0, 0.0)
    space_hit.pressed = key_bit(.Space)
    space_hit.held = key_bit(.Space)
    mid := cozy.update(&mut c, &mut s, &cam, 1.6, 1280.0, 800.0, 0.016, &space_hit, 0.0, false)
    assert(!mid.jump && (c.jump_buffer - 0.12).abs() < 0.0001)

    // Advance 0.08s while still ungrounded -> buffer remains armed; then land -> fires jump!
    nothing := empty_input(0.0, 0.0)
    mid2 := cozy.update(&mut c, &mut s, &cam, 1.6, 1280.0, 800.0, 0.08, &nothing, 0.0, false)
    assert(!mid2.jump && c.jump_buffer > 0.03)
    s.bodies[s.player].grounded = true
    landed := cozy.update(&mut c, &mut s, &cam, 1.6, 1280.0, 800.0, 0.016, &nothing, 0.0, false)
    assert(landed.jump && c.jump_buffer == 0.0)

    // Arm buffer again while ungrounded, wait > 0.12s -> expires before landing.
    s.bodies[s.player].grounded = false
    _ := cozy.update(&mut c, &mut s, &cam, 1.6, 1280.0, 800.0, 0.016, &space_hit, 0.0, false)
    _ := cozy.update(&mut c, &mut s, &cam, 1.6, 1280.0, 800.0, 0.14, &nothing, 0.0, false)
    s.bodies[s.player].grounded = true
    expired := cozy.update(&mut c, &mut s, &cam, 1.6, 1280.0, 800.0, 0.016, &nothing, 0.0, false)
    assert(!expired.jump && c.jump_buffer == 0.0)
}

@test fn sit_emote_camera_orbit_zoom_reset_and_swedish_toasts_work_cohesively() {
    level := play.demo()
    mut s := play.start(&level)
    world := view.build(&s).unwrap()
    area := view.framing(&world, &s, true)
    cam := view.camera(&area, 1.6)
    mut c := cozy.new()
    assert(!cozy.cam_adjusted(&c))

    // C toggles sit and emits toast; F triggers emote and emits toast.
    mut c_hit := empty_input(0.0, 0.0)
    c_hit.pressed = key_bit(.C)
    _ := cozy.update(&mut c, &mut s, &cam, 1.6, 1280.0, 800.0, 0.016, &c_hit, 0.0, false)
    assert(s.cozy_sitting && c.toast_text.len > 0)

    mut f_hit := empty_input(0.0, 0.0)
    f_hit.pressed = key_bit(.F)
    _ := cozy.update(&mut c, &mut s, &cam, 1.6, 1280.0, 800.0, 0.016, &f_hit, 0.0, false)
    assert(s.emote_tick == s.tick && c.toast_text.len > 0)

    // Right-drag and scroll work when !ui_captured, ignored when ui_captured.
    mut rdrag := empty_input(400.0, 300.0)
    rdrag.mouse.buttons = gfx.MOUSE_RIGHT
    rdrag.mouse.dx = 120.0
    rdrag.mouse.scroll = 10.0
    _ := cozy.update(&mut c, &mut s, &cam, 1.6, 1280.0, 800.0, 0.05, &rdrag, 0.0, true)
    assert(!cozy.cam_adjusted(&c) && c.target_yaw == 0.0 && c.target_zoom == 1.0)

    _ := cozy.update(&mut c, &mut s, &cam, 1.6, 1280.0, 800.0, 0.05, &rdrag, 0.0, false)
    assert(cozy.cam_adjusted(&c) && c.target_yaw > 0.5 && c.yaw > 0.0 && c.yaw < c.target_yaw)
    assert(c.target_zoom == 0.62 && c.zoom < 1.0 && c.zoom >= 0.62)

    // Scroll out clamps at 1.38.
    mut zoom_out := empty_input(400.0, 300.0)
    zoom_out.mouse.scroll = -50.0
    _ := cozy.update(&mut c, &mut s, &cam, 1.6, 1280.0, 800.0, 0.05, &zoom_out, 0.0, false)
    assert(c.target_zoom == 1.38)

    // Middle click resets camera targets cleanly.
    mut mid_hit := empty_input(400.0, 300.0)
    mid_hit.mouse.pressed = gfx.MOUSE_MIDDLE
    _ := cozy.update(&mut c, &mut s, &cam, 1.6, 1280.0, 800.0, 0.05, &mid_hit, 0.0, false)
    assert(!cozy.cam_adjusted(&c) && c.target_yaw == 0.0 && c.target_zoom == 1.0)

    // Picking a flower emits a Swedish toast and reset clears active toast.
    for _ in 0..27 { play.step(&mut s, play.Input { x: -1.0, z: 0.0, jump: false }) }
    assert(s.flowers == 1)
    _ := cozy.update(&mut c, &mut s, &cam, 1.6, 1280.0, 800.0, 0.016, &empty_input(0.0, 0.0), 0.0, false)
    assert(c.toast_text.len > 0 && cozy.toast_alpha(&c) > 0.9)

    fresh := play.start(&level)
    cozy.reset(&mut c, &fresh)
    assert(c.toast_text.len == 0 && cozy.toast_alpha(&c) == 0.0 && !c.has_target && c.last_flowers == 0)
}
