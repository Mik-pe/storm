// Blomsterskogen's living parts, driven the way the app drives them: the
// demo level, `play.step`, and `play_view.sync`. Every number here is a
// bound the animation writes (its amplitude, its ceiling), not a sample.
import core
import ecs
import play
import ..src.play_view as view

fn world_origin(w: &view.View, e: ecs.Entity) -> core.Vec3 {
    core.transform_point(&w.graph.world(e).matrix, core.vec3(0.0, 0.0, 0.0))
}

fn settle(w: &mut view.View, s: &mut play.Session, ticks: i32) {
    for _ in 0..ticks {
        play.step(&mut s, play.Input { x: 0.0, z: 0.0, jump: false })
        view.sync(&mut w, s, true)
    }
}

@test fn the_demo_level_casts_its_foxes_insects_flowers_and_petals() {
    demo := play.demo()
    mut session := play.start(&demo)
    world := view.build(&session).unwrap()
    // Cast sizes are the level's: the one fox the demo names, twenty
    // insects, one node per flower the scene lists, 48 petals and 8 motes
    // (`build`'s constants), so a level that lost its fox or a halved
    // petal count both fail here.
    assert(world.cast.foxes.len == 1)
    assert(world.cast.insects.len == 20)
    assert(world.cast.flowers.len > 0 && world.cast.flowers.len == session.total_flowers)
    assert(world.cast.petals.len == 48)
    assert(world.cast.motes.len == 8)
    // Eleven butterflies then nine bees: `build` casts the butterflies'
    // homes first, so the kind of each insect is its index.
    mut bees := 0
    for i in 0..world.cast.insects.len {
        if world.cast.insects[i].bee { bees += 1 }
        assert(world.cast.insects[i].bee == (i >= 11))
    }
    assert(bees == 9)
    // Nothing is celebrated at the start: motes hidden, bouquets empty.
    for i in 0..world.cast.motes.len { assert(!world.graph.world(world.cast.motes[i]).visible) }
    for i in 0..world.cast.foxes.len {
        assert(!world.graph.world(world.cast.foxes[i].bouquet).visible)
    }
}

@test fn idle_insects_circle_their_home_within_the_amplitude_the_animation_writes() {
    demo := play.demo()
    mut session := play.start(&demo)
    mut world := view.build(&session).unwrap()
    // The player stands still and never sits or pets, so `friend` stays 0 and
    // every insect orbits its own home: x within sx, y within 0.17 + 0.05,
    // z within sz. A follower by default would leave this envelope.
    mut far: f32 = 0.0
    mut highest: f32 = -1.0e9
    mut lowest: f32 = 1.0e9
    for _ in 0..600 {
        play.step(&mut session, play.Input { x: 0.0, z: 0.0, jump: false })
        view.sync(&mut world, &session, true)
        for i in 0..world.cast.insects.len {
            f := &world.cast.insects[i]
            p := world_origin(&world, f.root)
            d := core.length(core.sub(core.vec3(p.x, 0.0, p.z), core.vec3(f.home.x, 0.0, f.home.z)))
            reach: f32 = if f.bee { 0.566 } else { 0.769 }
            assert(d <= reach)
            if d > far { far = d }
            if p.y - f.home.y > highest { highest = p.y - f.home.y }
            if p.y - f.home.y < lowest { lowest = p.y - f.home.y }
        }
    }
    // ... and the orbit is really flown: a loop that never left home would pass the envelope trivially.
    assert(far > 0.4)
    assert(highest <= 0.22 + 0.001 && lowest >= -0.22 - 0.001)
    assert(highest - lowest > 0.2)
}

@test fn a_picked_flower_shows_motes_around_it_and_a_stem_in_the_bouquet() {
    demo := play.demo()
    mut session := play.start(&demo)
    mut world := view.build(&session).unwrap()
    // Walk to the nearest flower the way the app does: steer towards it until it is picked.
    pp := play.position(&session, world.player_node)
    mut target := demo.entities[world.cast.flowers[0].entity_index].position
    mut best: f32 = 1.0e9
    for i in 0..world.cast.flowers.len {
        fl := &world.cast.flowers[i]
        p := demo.entities[fl.entity_index].position
        d := core.length(core.sub(p, pp))
        if d < best { best = d; target = p }
    }
    mut steps := 0
    while session.flowers == 0 && steps < 1200 {
        cur := play.position(&session, world.player_node)
        dx := target.x - cur.x
        dz := target.z - cur.z
        len := core.length(core.vec3(dx, 0.0, dz))
        play.step(&mut session, play.Input { x: if len > 0.01 { dx / len } else { 0.0 }, z: if len > 0.01 { dz / len } else { 0.0 }, jump: false })
        steps += 1
    }
    assert(session.flowers == 1)
    assert(session.last_flower >= 0)
    view.sync(&mut world, &session, true)
    // Mode 1: motes in a ring around the picked flower. At the first tick
    // (u = 0) the ring is 0.12 out in x and 0.22 + 0.14 * sin(angle) in z,
    // so no mote is further than 0.37 from the flower, and all rise from
    // 0.35 above it.
    flower := demo.entities[session.last_flower].position
    for i in 0..world.cast.motes.len {
        assert(world.graph.world(world.cast.motes[i]).visible)
        p := world_origin(&world, world.cast.motes[i])
        assert(core.length(core.sub(core.vec3(p.x, 0.0, p.z), core.vec3(flower.x, 0.0, flower.z))) <= 0.37)
        assert(p.y >= flower.y + 0.35 - 0.001)
    }
    // The bouquet shows, and only the stem of the flower picked last.
    assert(world.graph.world(world.cast.foxes[0].bouquet).visible)
    mut shown := 0
    for i in 0..world.cast.foxes[0].stems.len {
        if world.graph.world(world.cast.foxes[0].stems[i].node).visible {
            shown += 1
            assert(world.cast.foxes[0].stems[i].flower_index == session.last_flower)
        }
    }
    assert(shown == 1)
    // Fifty-four ticks after the pick the celebration is over and the motes
    // hide again; the bouquet stays until the flowers are delivered.
    settle(&mut world, &mut session, 56)
    for i in 0..world.cast.motes.len { assert(!world.graph.world(world.cast.motes[i]).visible) }
    assert(world.graph.world(world.cast.foxes[0].bouquet).visible)
}

@test fn a_pet_or_an_emote_orbits_the_insects_around_the_players_head() {
    demo := play.demo()
    mut session := play.start(&demo)
    mut world := view.build(&session).unwrap()
    // Park every insect at home right beside the player so `prox` is 1
    // (anything within 2.8 of the player), then let the pet age past its
    // 0.25 s fade-in so `pet_f` — and with it `friend` — is 1.
    pp := play.position(&session, world.player_node)
    for i in 0..world.cast.insects.len {
        f := &mut world.cast.insects[i]
        f.home = core.add(pp, core.vec3(0.1 * f32(i + 1), 0.0, 0.0))
    }
    play.pet(&mut session)
    for _ in 0..30 {
        play.step(&mut session, play.Input { x: 0.0, z: 0.0, jump: false })
        view.sync(&mut world, &session, true)
    }
    cozy := play.render_cozy(&session, true)
    assert(cozy.pet_age >= 0.25 && cozy.pet_age < 1.4)
    // With blend = friend * prox = 1, every insect sits on the orbit ring
    // around the player: orbit_r out, orbit_y (0.40 or 0.58) plus a 0.10
    // wave above the player's feet.
    for i in 0..world.cast.insects.len {
        f := &world.cast.insects[i]
        p := world_origin(&world, f.root)
        horizontal := core.length(core.vec3(p.x - pp.x, 0.0, p.z - pp.z))
        orbit_r: f32 = if f.bee { 0.68 } else { 0.78 }
        assert((horizontal - orbit_r).abs() < 0.01)
        orbit_y: f32 = if f.bee { 0.40 } else { 0.58 }
        assert((p.y - pp.y - orbit_y).abs() <= 0.10 + 0.001)
    }
    // The motes celebrate the pet: mode 2, rising from the head.
    for i in 0..world.cast.motes.len { assert(world.graph.world(world.cast.motes[i]).visible) }
    // And they hide again when the pet is over.
    settle(&mut world, &mut session, 100)
    for i in 0..world.cast.motes.len { assert(!world.graph.world(world.cast.motes[i]).visible) }
    play.emote(&mut session)
    view.sync(&mut world, &session, true)
    for i in 0..world.cast.motes.len { assert(world.graph.world(world.cast.motes[i]).visible) }
}

@test fn petals_fall_within_the_level_and_never_below_the_ground() {
    demo := play.demo()
    mut session := play.start(&demo)
    mut world := view.build(&session).unwrap()
    // The petals fall over the level's bounds grown by 1.5 on each side, and
    // drift 1.15 along their fall in x (always positive: u runs 0..1), sway
    // ±0.34 in x and ±0.22 in z; from the ceiling (6.2 for a level wider
    // than 16) down to the ground. A petal outside this never lands in the
    // level the player walks in.
    b := demo.bounds.unwrap()
    for _ in 0..900 {
        play.step(&mut session, play.Input { x: 0.0, z: 0.0, jump: false })
        view.sync(&mut world, &session, true)
        for i in 0..world.cast.petals.len {
            p := world.graph.local(world.cast.petals[i]).position
            assert(p.y >= 0.0 - 0.001 && p.y <= 6.2 + 0.001)
            assert(p.x >= b.min_x - 1.5 - 0.34 - 0.001 && p.x <= b.max_x + 1.5 + 1.15 + 0.34 + 0.001)
            assert(p.z >= b.min_z - 1.5 - 0.22 - 0.001 && p.z <= b.max_z + 1.5 + 0.22 + 0.001)
        }
    }
}

@test fn a_flower_near_the_player_leans_towards_them_and_one_far_away_only_sways() {
    demo := play.demo()
    mut session := play.start(&demo)
    mut world := view.build(&session).unwrap()
    // Far away the sway is the idle amplitude and nothing more.
    mut max_pitch: f32 = 0.0
    mut max_roll: f32 = 0.0
    for _ in 0..600 {
        play.step(&mut session, play.Input { x: 0.0, z: 0.0, jump: false })
        view.sync(&mut world, &session, true)
        lp := world.graph.local(world.cast.flowers[0].root)
        if lp.rotation_x.abs() > max_pitch { max_pitch = lp.rotation_x.abs() }
        if lp.rotation_z.abs() > max_roll { max_roll = lp.rotation_z.abs() }
    }
    assert(max_pitch <= 0.024 + 0.0005 && max_roll <= 0.020 + 0.0005)
    assert(max_pitch > 0.02 && max_roll > 0.016)
    // Stand 0.8 east of the first flower: outside its 0.64 sensor (so it is
    // not picked), inside the 0.65..2.2 where it leans. The lean is towards
    // the player — roll for a player on the x axis — and adds to the sway;
    // the bob lifts the flower a little as it pulses.
    flower := world.cast.flowers[0].entity_index
    fp := demo.entities[flower].position
    mut steps := 0
    while steps < 1200 && !session.collected[flower] {
        cur := play.position(&session, world.player_node)
        dx := fp.x + 0.8 - cur.x
        dz := fp.z - cur.z
        len := core.length(core.vec3(dx, 0.0, dz))
        if len < 0.05 { break }
        play.step(&mut session, play.Input { x: dx / len, z: dz / len, jump: false })
        steps += 1
    }
    assert(!session.collected[flower])
    mut near_roll: f32 = 0.0
    mut top: f32 = -1.0e9
    mut bottom: f32 = 1.0e9
    for _ in 0..240 {
        play.step(&mut session, play.Input { x: 0.0, z: 0.0, jump: false })
        view.sync(&mut world, &session, true)
        lp := world.graph.local(world.cast.flowers[0].root)
        if lp.rotation_z.abs() > near_roll { near_roll = lp.rotation_z.abs() }
        if lp.position.y > top { top = lp.position.y }
        if lp.position.y < bottom { bottom = lp.position.y }
    }
    assert(near_roll > 0.020 + 0.012)
    assert(top - bottom > 0.002)
}
