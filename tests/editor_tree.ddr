// The editor's scene-tree buttons, without a window: what "+ Add cube",
// "Delete" and "+ Collectibles" do to the graph and to the selection. The
// root suite drives `editor.draw` with a Pointer the way a frame does; the
// coordinates are the ones `hierarchy` lays out at 1280 x 800.
import core
import scene
import studio.game as game
import text
import ui
import ui.widgets as widgets
import studio.editor as editor

const WIDTH: f32 = 1280.0
const HEIGHT: f32 = 800.0
// hierarchy(): by = height - FOOT - 72; the two lower buttons at by + 34.
fn row_y() -> f32 { HEIGHT - editor.FOOT - 72.0 + 34.0 }

// One frame at `point`, pressed; then the same point released so the
// press is an edge, exactly as a click reaches the widgets.
fn click(s: &mut editor.State, graph: &mut scene.Graph, atlas: &text.Atlas, canvas: &mut ui.Canvas, x: f32, y: f32) {
    p := widgets.Pointer::at(x, y, true, true)
    editor.draw(&mut s, &mut canvas, atlas, &mut graph, &p, 0.0, WIDTH, HEIGHT, 0.0, 6, "GPU", 0, 8)
    up := widgets.Pointer::at(x, y, false, false)
    editor.draw(&mut s, &mut canvas, atlas, &mut graph, &up, 0.0, WIDTH, HEIGHT, 0.0, 6, "GPU", 0, 8)
}

fn has_cube_named(graph: &scene.Graph, prefix: string) -> bool {
    mut found := false
    for node in graph.nodes() {
        if graph.name(node).len > prefix.len && graph.name(node)[0..prefix.len] == prefix {
            match graph.shape(node) {
                .Some(shape) => { found = shape == scene.Shape.Cube && graph.has_material(node) },
                _ => { found = false },
            }
        }
    }
    found
}

@test fn add_cube_creates_a_selected_cube_and_delete_removes_it() {
    mut graph := scene.Graph::new()
    first := graph.create_root(core.vec3(0.0, 0.0, 0.0))
    _ := graph.set_name(first, "Turntable")
    mut s := editor.new(first, true, true, false)
    atlas := text.Atlas::new(16, 16)
    mut canvas := ui.Canvas::new()
    before := graph.len()
    // "+ Add cube" sits at (12, by + 34) and is 102 wide.
    click(&mut s, &mut graph, &atlas, &mut canvas, 60.0, row_y() + 13.0)
    assert(graph.len() == before + 1)
    assert(has_cube_named(&graph, "Cube ") && s.selected.index != first.index)
    assert(graph.is_alive(s.selected) && graph.name(s.selected)[0..5] == "Cube ")
    added := s.selected
    // The new cube is selected, so Delete is offered and removes it; the
    // selection falls back to the first row, the turntable.
    click(&mut s, &mut graph, &atlas, &mut canvas, 160.0, row_y() + 13.0)
    assert(graph.len() == before && !graph.is_alive(added))
    assert(s.selected.index == first.index)
    // Delete is not drawn when the first row is the selection: the click
    // there reaches nothing, and the turntable stays.
    click(&mut s, &mut graph, &atlas, &mut canvas, 160.0, row_y() + 13.0)
    assert(graph.len() == before && graph.is_alive(first))
}

@test fn collectibles_fold_the_orbs_out_of_the_tree_and_count_them() {
    mut graph := scene.Graph::new()
    first := graph.create_root(core.vec3(0.0, 0.0, 0.0))
    _ := graph.set_name(first, "Turntable")
    game.spawn_orbs(&mut graph)
    mut s := editor.new(first, true, true, false)
    atlas := text.Atlas::new(16, 16)
    mut canvas := ui.Canvas::new()
    // Folded by default: the rows are the named nodes only, and the count
    // is the ring's.
    click(&mut s, &mut graph, &atlas, &mut canvas, -100.0, -100.0)
    assert(!s.expand_orbs && s.orbs == game.ORB_COUNT)
    mut named := 0
    for row in s.rows { if !game.is_orb(graph.name(row.entity)) { named += 1 } }
    assert(named == s.rows.len && s.rows.len == 1)
    // "+ Collectibles" sits at (12, by) and is LEFT - 24 wide.
    click(&mut s, &mut graph, &atlas, &mut canvas, 60.0, HEIGHT - editor.FOOT - 72.0 + 13.0)
    assert(s.expand_orbs && s.orbs == game.ORB_COUNT)
    mut orbs := 0
    for row in s.rows { if game.is_orb(graph.name(row.entity)) { orbs += 1 } }
    assert(orbs == game.ORB_COUNT && s.rows.len == 1 + game.ORB_COUNT)
    // Expanding asks the list to scroll to the end so the orbs are what is
    // seen; the clamp then keeps every row on screen when they all fit
    // (20 visible at this height, 9 rows), so the list stays at the top.
    visible := i32((HEIGHT - editor.FOOT - 78.0 - 108.0) / widgets.ROW_HEIGHT)
    assert(visible > s.rows.len && s.first_node == 0)
    // Folding again hides them and returns to the top.
    click(&mut s, &mut graph, &atlas, &mut canvas, 60.0, HEIGHT - editor.FOOT - 72.0 + 13.0)
    assert(!s.expand_orbs && s.rows.len == 1 && s.first_node == 0)
}

// In a window too short for all nine rows, expanding scrolls so the orbs
// are what is seen: the list ends on its last row, and the first rows
// (the turntable) are the ones that leave the screen.
@test fn collectibles_in_a_short_window_scroll_to_the_orbs() {
    mut graph := scene.Graph::new()
    first := graph.create_root(core.vec3(0.0, 0.0, 0.0))
    _ := graph.set_name(first, "Turntable")
    game.spawn_orbs(&mut graph)
    mut s := editor.new(first, true, true, false)
    atlas := text.Atlas::new(16, 16)
    mut canvas := ui.Canvas::new()
    short: f32 = 400.0
    visible := i32((short - editor.FOOT - 78.0 - 108.0) / widgets.ROW_HEIGHT)
    assert(visible == 6 && visible < 1 + game.ORB_COUNT)
    p := widgets.Pointer::at(60.0, short - editor.FOOT - 72.0 + 13.0, true, true)
    editor.draw(&mut s, &mut canvas, &atlas, &mut graph, &p, 0.0, WIDTH, short, 0.0, 6, "GPU", 0, 8)
    up := widgets.Pointer::at(p.x, p.y, false, false)
    editor.draw(&mut s, &mut canvas, &atlas, &mut graph, &up, 0.0, WIDTH, short, 0.0, 6, "GPU", 0, 8)
    assert(s.expand_orbs && s.rows.len == 1 + game.ORB_COUNT)
    // The last visible row is the last row: the list ends on the final orb.
    assert(s.first_node + visible == s.rows.len)
    assert(game.is_orb(graph.name(s.rows[s.first_node].entity)))
}
