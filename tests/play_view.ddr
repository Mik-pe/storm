import core
import gfx
import play
import ..src.cozy_control as cozy
import ..src.play_view as view

@test fn play_shapes_match_body_extents_and_poses_use_the_requested_tick() {
    mut scene_data := play.demo()
    scene_data.theme = .Plain
    mut session := play.start(&scene_data)
    mut world := view.build(&session).unwrap()
    for i in 0..scene_data.entities.len {
        def := &scene_data.entities[i]
        if def.role == .Cloud || def.role == .BoostCloud || def.role == .SuperButterfly { continue }
        if def.role == .Collider { assert(world.graph.shape(world.nodes[i]).is_none()); continue }
        scale := world.graph.local(world.nodes[i]).scale
        span: f32 = if def.shape == .Box { 1.2 } else { 2.0 }
        assert((scale.x * span - def.size.x).abs() < 0.0001)
    }
    play.step(&mut session, play.Input { x: 1.0, z: 0.0, jump: false })
    view.sync(&mut world, &session, true)
    runner := world.graph.local(world.nodes[world.player_node]).position
    assert(runner.x == play.position(&session, world.player_node).x)
    assert(runner.x > scene_data.entities[world.player_node].position.x)
    area := view.framing(&world, &session, true)
    cam := view.camera(&area, 1.6)
    assert(core.dot(cam.forward(), core.sub(area.center, cam.position)) > 1.0)
}

@test fn a_full_level_of_spheres_fits_the_mesh_stream_in_two_passes() {
    mut level := play.empty("Sphere field")
    model := play.demo()
    for _ in 0..play.MAX_ENTITIES { level.entities.push(model.entities[1].clone()) }
    vertices := view.sphere_geometry(&level)
    assert(vertices.len > 0 && vertices.len % (3 * gfx.VERTEX_FLOATS) == 0)
    // One sphere's stream, once per entity, for both frames: no reallocation
    // after the first frame of the largest level. Measured: 5 898 240 bytes.
    assert(u64(vertices.len * 4 * 2 * level.entities.len) <= gfx.INITIAL_VERTEX_BYTES)
}

@test fn picking_and_restarting_restore_the_same_flower_meshes() {
    level := play.demo()
    mut session := play.start(&level)
    mut world := view.build(&session).unwrap()
    view.sync(&mut world, &session, true)
    first := world.nodes[2]
    assert(world.graph.world(first).visible)
    start := world.graph.geometry_revision()
    for _ in 0..27 { play.step(&mut session, play.Input { x: -1.0, z: 0.0, jump: false }) }
    view.sync(&mut world, &session, true)
    assert(session.flowers == 1 && !world.graph.world(first).visible && world.graph.world(world.nodes[3]).visible)
    session = play.start(&level)
    view.sync(&mut world, &session, true)
    assert(session.flowers == 0 && world.graph.world(first).visible && world.graph.geometry_revision() == start)
}

@test fn canopy_instances_share_geometry_and_keep_authored_wing_colors() {
    level := play.demo()
    s := play.start(&level)
    mut world := view.build(&s).unwrap()
    view.sync(&mut world, &s, true)
    mut owner := -1
    mut colors: []f32 = []
    for item in world.graph.drawables(core.vec3(0.0, 2.0, 4.0)) {
        if world.graph.name(item.entity) != "WingL_Vesper_Aurora" { continue }
        if owner < 0 { owner = item.mesh_index }
        assert(owner >= 0 && owner == item.mesh_index)
        colors.push(item.material.base.r)
    }
    assert(colors.len == s.total_butterflies && colors.len >= 3)
    mut distinct := 0
    for i in 0..colors.len {
        mut unique := true
        for j in 0..i {
            if (colors[i] - colors[j]).abs() <= 0.05 { unique = false; break }
        }
        if unique { distinct += 1 }
    }
    assert(distinct >= 3)
}

@test fn cloud_mesh_tops_meet_collision_planes_and_camera_follows_the_climb() {
    level := play.demo()
    mut s := play.start(&level)
    mut world := view.build(&s).unwrap()
    view.sync(&mut world, &s, true)
    mut expected_pads := 0
    for item in level.entities {
        if item.role == .Cloud || item.role == .BoostCloud { expected_pads += 1 }
    }
    assert(world.course.pads.len == expected_pads && expected_pads >= 6)
    for p in world.course.pads {
        item := &level.entities[p.index]
        pose := world.graph.local(p.node)
        top := play.position(&s, p.index).y + pose.position.y + pose.scale.y * 0.5
        assert((top - (item.position.y + item.size.y * 0.5)).abs() < 0.00001)
    }
    ground := view.framing(&world, &s, true)
    s.bodies[s.player].position.y += 3.76
    crown := view.framing(&world, &s, true)
    assert(ground.climb == 0.0 && crown.climb == 1.0 && crown.center.y > ground.center.y + 3.0)
}

@test fn framing_follows_vallmo_without_lag_across_grand_level_and_tall_canopy() {
    level := play.demo()
    mut s := play.start(&level)
    world := view.build(&s).unwrap()
    far_spots := [
        core.vec3(-13.5, 0.4, -11.5),
        core.vec3(13.5, 0.4, 11.5),
        core.vec3(-9.2, 0.4, -2.8),
        core.vec3(8.6, 0.4, 4.6),
    ]
    for spot in far_spots {
        s.bodies[s.player].position = spot
        area := view.framing(&world, &s, true)
        assert((area.center.x - spot.x).abs() < 0.0001)
        assert((area.center.z - (spot.z - 0.65)).abs() < 0.0001)
        assert(area.climb == 0.0)
    }
    // Tall Stjärngläntan secret perch at top 6.55m (Vallmo center at y = 6.95m).
    s.bodies[s.player].position = core.vec3(-0.6, 6.95, -9.4)
    high := view.framing(&world, &s, true)
    assert(high.climb == 1.0)
    assert((high.center.x - -0.6).abs() < 0.0001)
    assert(high.center.y > 7.2 && high.center.y < 7.7)
}

@test fn camera_cozy_orbits_and_zooms_around_framing_center_while_preserving_default() {
    level := play.demo()
    s := play.start(&level)
    world := view.build(&s).unwrap()
    area := view.framing(&world, &s, true)
    aspect: f32 = 1.6
    base := view.camera(&area, aspect)
    identity := view.camera_cozy(&area, aspect, 0.0, 1.0)
    assert(identity.position.x == base.position.x && identity.position.y == base.position.y && identity.position.z == base.position.z)
    assert(identity.yaw == base.yaw && identity.pitch == base.pitch && identity.fov == base.fov)

    base_offset := core.sub(base.position, area.center)
    base_dist := core.length(base_offset)
    orbited := view.camera_cozy(&area, aspect, 0.85, 1.0)
    orbit_offset := core.sub(orbited.position, area.center)
    assert((core.length(orbit_offset) - base_dist).abs() < 0.001)
    assert((orbit_offset.y - base_offset.y).abs() < 0.001)
    assert((orbited.yaw - 0.85).abs() < 0.001)
    assert(core.dot(orbited.forward(), core.normalize(core.scale(orbit_offset, -1.0))) > 0.9999)

    closer := view.camera_cozy(&area, aspect, -0.4, 0.65)
    assert((core.length(core.sub(closer.position, area.center)) - base_dist * 0.65).abs() < 0.002)
    assert(core.dot(closer.forward(), core.normalize(core.sub(area.center, closer.position))) > 0.9999)

    farther := view.camera_cozy(&area, aspect, 0.0, 1.35)
    assert((core.length(core.sub(farther.position, area.center)) - base_dist * 1.35).abs() < 0.002)
}

@test fn camera_presets_and_shadow_radius_scale_smoothly_for_close_normal_explore() {
    level := play.demo()
    s := play.start(&level)
    world := view.build(&s).unwrap()
    area := view.framing(&world, &s, true)
    aspect: f32 = 1.6

    cam_close := view.camera_preset(&area, aspect, cozy.CameraMode.Close, 0.0, 1.0)
    cam_normal := view.camera_preset(&area, aspect, cozy.CameraMode.Normal, 0.0, 1.0)
    cam_explore := view.camera_preset(&area, aspect, cozy.CameraMode.Explore, 0.0, 1.0)
    cam_mid := view.camera_blend(&area, aspect, 1.5, 0.0, 1.0)

    d_close := core.length(core.sub(cam_close.position, area.center))
    d_normal := core.length(core.sub(cam_normal.position, area.center))
    d_explore := core.length(core.sub(cam_explore.position, area.center))
    assert(d_close < d_normal * 0.65 && d_explore > d_normal * 1.55)
    assert(cam_close.fov < cam_normal.fov && cam_normal.fov < cam_explore.fov)
    assert(cam_mid.position.y > cam_normal.position.y && cam_mid.position.y < cam_explore.position.y)

    // Orbit + zoom combine cleanly with both Close and Explore presets.
    orbit_explore := view.camera_preset(&area, aspect, cozy.CameraMode.Explore, 0.7, 1.25)
    assert((orbit_explore.yaw - 0.7).abs() < 0.002)
    assert(orbit_explore.position.y > cam_explore.position.y)

    r_close := view.shadow_radius(&area, 0.0, 1.0)
    r_normal := view.shadow_radius(&area, 1.0, 1.0)
    r_explore := view.shadow_radius(&area, 2.0, 1.0)
    assert(r_close < r_normal && r_normal < r_explore && r_explore >= 20.0 && r_explore <= 28.0)
}
