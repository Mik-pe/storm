import core
import scene
import text
import ui
import ui.widgets as widgets
import ..src.editor as editor
import ..src.play_ui as hud

fn default_cozy_info() -> hud.CozyHudInfo {
    hud.CozyHudInfo {
        sitting: false,
        snoozing: false,
        hovering_fox: false,
        toast: "",
        toast_alpha: 0.0,
        cam_adjusted: false,
        options_open: false,
        mood: .CherryDay,
        cam_mode: .Normal,
        compass_on: false,
        stroll_mode: false,
        compass_text: "",
        compass_angle: 0.0,
        compass_butterfly: false,
        compass_above: false,
        compass_below: false,
        total_flowers: 10,
        has_bonus: true,
    }
}

@test fn play_transport_wraps_and_only_steps_a_paused_game() {
    atlas := text.Atlas::new(16, 16)
    mut canvas := ui.Canvas::new()
    for width in [320, 720] {
        x := if width == 320 { 12 } else { width - 218 }
        y := if width == 320 { 62 } else { 24 }
        for paused in [false, true] {
            mut controls := widgets.State::new()
            for i in 0..5 {
                points := [[42, 24], [x + 36, y], [x + 104, y], [x + 170, y], [72, 190]]
                p := widgets.Pointer::at(f32(points[i][0]), f32(points[i][1]), true, true)
                canvas.clear()
                act := hud.draw(&mut controls, &mut canvas, &atlas, &p, f32(width), 420.0, "Jump", 35, paused, true, true, false)
                expected := [hud.Action.Studio, .TogglePause, if paused { hud.Action.Step } else { hud.Action.Idle }, .Restart, .Idle]
                assert(act == expected[i])
                held := widgets.Pointer::at(p.x, p.y, false, true)
                assert(hud.draw(&mut controls, &mut canvas, &atlas, &held, f32(width), 420.0, "Jump", 35, paused, true, true, false) == hud.Action.Idle)
                release := widgets.Pointer::at(p.x, p.y, false, false)
                _ := hud.draw(&mut controls, &mut canvas, &atlas, &release, f32(width), 420.0, "Jump", 35, paused, true, true, false)
            }
        }
    }
}

@test fn studio_play_launch_does_not_toggle_focus_or_select_a_node() {
    mut graph := scene.Graph::new()
    node := graph.create_root(core.vec3(0.0, 0.0, 0.0))
    mut studio := editor.new(node, true, true, false)
    atlas := text.Atlas::new(16, 16)
    mut canvas := ui.Canvas::new()
    for width in [320, 720, 1280] {
        p := if width == 320 { widgets.Pointer::at(36.0, 402.0, true, true) }
        else { widgets.Pointer::at(f32(width - 136), 24.0, true, true) }
        studio.play_requested = false
        editor.draw(&mut studio, &mut canvas, &atlas, &mut graph, &p, 0.0, f32(width), 420.0, 60.0, 6, "GPU", 0, 8)
        assert(studio.play_requested && !studio.focus && studio.selected.index == node.index)
        release := widgets.Pointer::at(p.x, p.y, false, false)
        editor.draw(&mut studio, &mut canvas, &atlas, &mut graph, &release, 0.0, f32(width), 420.0, 60.0, 6, "GPU", 0, 8)
    }
}

@test fn woodland_transport_tracks_pause_and_win_in_each_layout() {
    mut c := ui.Canvas::new()
    atlas := text.Atlas::new(16, 16)
    for width in [320, 1000] {
        for mode in 0..5 {
            paused := mode == 1
            won := mode == 2 || mode == 4
            bonus := mode >= 3
            pad: i32 = if width == 320 { 10 } else { 18 }
            x := width - pad - 142
            y := if width == 320 { 500 - pad - (if paused || won { 77 } else { 41 }) } else { pad }
            for i in 0..5 {
                xy := [[x + 32, y + 20], [x + 97, y + 20], [x + 32, y + 55], [x + 97, y + 55], [130, 190]]
                p := widgets.Pointer::at(f32(xy[i][0]), f32(xy[i][1]), true, true)
                mut s := widgets.State::new()
                c.clear()
                chosen := hud.woodland(&mut s, &mut c, &atlas, &p, f32(width), 500.0,
                    "Blomsterskogen", if won { 10 } else { 2 }, 10, if bonus { 5 } else { 1 }, 5, paused, won)
                left := if won { hud.Action.Restart } else if paused { hud.Action.Step } else { hud.Action.Idle }
                expected := [hud.Action.Studio, .TogglePause, left, if paused || won { hud.Action.Restart } else { hud.Action.Idle }, .Idle]
                assert(chosen == expected[i])
            }
        }
    }
}

@test fn both_woodland_counters_fit_beside_the_controls_in_a_short_window() {
    face := text.load_font(ui.RASTER_SIZE)
    mut atlas := text.Atlas::new(512, 512)
    assert(atlas.add_text(&face, "Buketten är klar!Klar0123456789/Spela igenStudioPausa"))
    mut c := ui.Canvas::new()
    mut controls := widgets.State::new()
    p := widgets.Pointer::at(-1.0, -1.0, false, false)
    _ := hud.woodland(&mut controls, &mut c, &atlas, &p, 240.0, 145.0, "Blomsterskogen", 5, 5, 1, 3, false, true)
    mut cream_card := false
    mut lower_line := false
    vertices := c.vertices()
    for i in 0..vertices.len / 8 {
        at := i * 8
        x := vertices[at]
        y := vertices[at + 1]
        assert(x >= 0.0 && x <= 240.0 && y >= 0.0 && y <= 145.0)
        if vertices[at + 2] < 0.0 && vertices[at + 4] == 1.0 && vertices[at + 5] == 0.95 {
            assert(x < 88.0)
            cream_card = true
        }
        if x < 88.0 && y > 60.0 && vertices[at + 2] >= 0.0 { lower_line = true }
    }
    assert(cream_card && lower_line)
}

fn cozy_atlas() -> text.Atlas {
    face := text.load_font(ui.RASTER_SIZE)
    mut atlas := text.Atlas::new(1024, 1024)
    glyphs := "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789 .,:;!?/-+()[]%&*#@=<>_|~ –·• åäö ÅÄÖ éÉ ²³"
    assert(atlas.add_text(&face, glyphs))
    atlas
}

@test fn woodland_dynamic_pips_and_hint_fit_cleanly_for_any_flower_count() {
    atlas := cozy_atlas()
    mut c := ui.Canvas::new()
    mut s := widgets.State::new()
    p := widgets.Pointer::at(-1.0, -1.0, false, false)

    widths: [f32; 4] = [380.0, 430.0, 600.0, 1280.0]
    heights: [f32; 2] = [320.0, 800.0]
    totals: [i32; 4] = [5, 10, 12, 20]
    for total in totals {
        for width in widths {
            for height in heights {
                c.clear()
                _ := hud.woodland(&mut s, &mut c, &atlas, &p, width, height,
                    "Blomsterskogen", total / 2, total, 2, 5, false, false)
                verts := c.vertices()
                assert(verts.len > 0)
                mut max_score_x: f32 = 0.0
                mut max_hint_x: f32 = 0.0
                for i in 0..verts.len / 8 {
                    at := i * 8
                    vx := verts[at]
                    vy := verts[at + 1]
                    assert(vx >= 0.0 && vx <= width && vy >= 0.0 && vy <= height)
                    if vy < 135.0 && vx < width - 170.0 && vx > max_score_x { max_score_x = vx }
                    if vy > height - 60.0 && vx < width - 380.0 && vx > max_hint_x { max_hint_x = vx }
                }
                if width >= 430.0 {
                    assert(max_score_x < width - 168.0)
                    // Bottom-left hint bar never encroaches on the 377px bottom-right cozy + Alternativ bar.
                    assert(max_hint_x <= width - 18.0 - 388.0)
                }
            }
        }
    }

    // Collecting flowers opens additional petal pips for both 5-flower and 10-flower scenes.
    for total in [5, 10] {
        mut c0 := ui.Canvas::new()
        _ := hud.woodland(&mut s, &mut c0, &atlas, &p, 1280.0, 800.0, "Blomsterskogen", 0, total, 0, 5, false, false)
        mut c4 := ui.Canvas::new()
        _ := hud.woodland(&mut s, &mut c4, &atlas, &p, 1280.0, 800.0, "Blomsterskogen", 4, total, 0, 5, false, false)
        assert(c4.vertex_count() > c0.vertex_count())
    }

    // Every point on the rendered 10-flower score card is captured by woodland_pointer_captured.
    mut c_full := ui.Canvas::new()
    _ := hud.woodland(&mut s, &mut c_full, &atlas, &p, 1280.0, 800.0, "Blomsterskogen", 10, 10, 5, 5, false, true)
    full_verts := c_full.vertices()
    mut card_right: f32 = 0.0
    mut card_bottom: f32 = 0.0
    for i in 0..full_verts.len / 8 {
        at := i * 8
        vx := full_verts[at]
        vy := full_verts[at + 1]
        if vy < 130.0 && vx < 400.0 {
            if vx > card_right { card_right = vx }
            if vy > card_bottom { card_bottom = vy }
        }
    }
    assert(hud.woodland_pointer_captured(1280.0, 800.0, false, true, false, false, card_right - 2.0, card_bottom - 4.0))
}

@test fn woodland_cozy_buttons_and_alternativ_toggle_work_without_overlap() {
    atlas := cozy_atlas()
    mut c := ui.Canvas::new()
    mut controls := widgets.State::new()

    // With cam_adjusted == false, bar at 1280x800 has width 286: [976..1262], y = [746..782].
    // Sit: [981..1071], Mys: [1076..1148], Alternativ: [1153..1257].
    base_info := default_cozy_info()
    sit_p := widgets.Pointer::at(1025.0, 764.0, true, true)
    c.clear()
    assert(hud.woodland_cozy(&mut controls, &mut c, &atlas, &sit_p, 1280.0, 800.0, &base_info) == .Sit)
    sit_held := widgets.Pointer::at(1025.0, 764.0, false, true)
    assert(hud.woodland_cozy(&mut controls, &mut c, &atlas, &sit_held, 1280.0, 800.0, &base_info) == .None)
    release := widgets.Pointer::at(1025.0, 764.0, false, false)
    assert(hud.woodland_cozy(&mut controls, &mut c, &atlas, &release, 1280.0, 800.0, &base_info) == .None)

    // Mys button works while sitting and snoozing.
    mut sit_info := default_cozy_info()
    sit_info.sitting = true
    sit_info.snoozing = true
    mys_p := widgets.Pointer::at(1110.0, 764.0, true, true)
    c.clear()
    assert(hud.woodland_cozy(&mut controls, &mut c, &atlas, &mys_p, 1280.0, 800.0, &sit_info) == .Emote)
    assert(hud.woodland_cozy(&mut controls, &mut c, &atlas, &release, 1280.0, 800.0, &sit_info) == .None)

    // Alternativ toggle button emits ToggleOptions.
    opt_p := widgets.Pointer::at(1205.0, 764.0, true, true)
    assert(hud.woodland_cozy(&mut controls, &mut c, &atlas, &opt_p, 1280.0, 800.0, &base_info) == .ToggleOptions)
    assert(hud.woodland_cozy(&mut controls, &mut c, &atlas, &release, 1280.0, 800.0, &base_info) == .None)

    // With cam_adjusted == true, bar has width 377: [885..1262].
    // Sit: [890..980], Mys: [985..1057], Kamera: [1062..1148], Alternativ: [1153..1257].
    mut cam_info := default_cozy_info()
    cam_info.sitting = true
    cam_info.snoozing = true
    cam_info.cam_adjusted = true
    cam_pos := widgets.Pointer::at(1105.0, 764.0, true, true)
    c.clear()
    assert(hud.woodland_cozy(&mut controls, &mut c, &atlas, &cam_pos, 1280.0, 800.0, &cam_info) == .ResetCam)

    // Verify button text glyphs sit cleanly to the right of every left-side icon.
    bar_verts := c.vertices()
    mut sit_text_min_x: f32 = 9999.0
    mut mys_text_min_x: f32 = 9999.0
    mut cam_text_min_x: f32 = 9999.0
    mut opt_text_min_x: f32 = 9999.0
    for i in 0..bar_verts.len / 8 {
        at := i * 8
        if bar_verts[at + 2] >= 0.0 {
            gx := bar_verts[at]
            if gx >= 890.0 && gx < 980.0 && gx < sit_text_min_x { sit_text_min_x = gx }
            if gx >= 985.0 && gx < 1057.0 && gx < mys_text_min_x { mys_text_min_x = gx }
            if gx >= 1062.0 && gx < 1148.0 && gx < cam_text_min_x { cam_text_min_x = gx }
            if gx >= 1153.0 && gx < 1257.0 && gx < opt_text_min_x { opt_text_min_x = gx }
        }
    }
    assert(sit_text_min_x > 890.0 + 17.5)
    assert(mys_text_min_x > 985.0 + 17.5)
    assert(cam_text_min_x > 1062.0 + 16.5)
    assert(opt_text_min_x > 1153.0 + 17.5)

    // Compact width (< 430) or short height (< 260) hides the cozy bar cleanly.
    c.clear()
    compact_p := widgets.Pointer::at(320.0 - 18.0 - 50.0, 500.0 - 18.0 - 18.0, true, true)
    assert(hud.woodland_cozy(&mut controls, &mut c, &atlas, &compact_p, 320.0, 500.0, &cam_info) == .None)
    assert(c.vertex_count() == 0)
    short_p := widgets.Pointer::at(1210.0, 240.0 - 18.0 - 18.0, true, true)
    assert(hud.woodland_cozy(&mut controls, &mut c, &atlas, &short_p, 1280.0, 240.0, &cam_info) == .None)
    assert(c.vertex_count() == 0)
}

@test fn alternativ_floating_card_emits_every_option_and_captures_pointer() {
    atlas := cozy_atlas()
    mut c := ui.Canvas::new()
    mut controls := widgets.State::new()

    // On 1280x800, Alternativ card is [936..1262], y = [518..736], inner x = 948, inner w = 302.
    mut open_info := default_cozy_info()
    open_info.options_open = true
    open_info.compass_on = true
    open_info.compass_text = "Närmast: Skogsviol · Nordväst (8 m)"
    open_info.compass_angle = -0.78

    release := widgets.Pointer::at(0.0, 0.0, false, false)
    clicks := [
        [1240.0, 536.0], // close x
        [990.0, 588.0], // Körsbärsdag
        [1095.0, 588.0], // Gyllene timmen
        [1205.0, 588.0], // Skymningsmys
        [995.0, 642.0], // Nära
        [1098.0, 642.0], // Normal
        [1200.0, 642.0], // Utforska
        [1210.0, 684.0], // Vägvisare toggle
        [1210.0, 716.0], // Strosa-läge toggle
    ]
    expected := [
        hud.CozyAction.ToggleOptions,
        .MoodCherry,
        .MoodGolden,
        .MoodTwilight,
        .CamClose,
        .CamNormal,
        .CamExplore,
        .ToggleCompass,
        .ToggleStroll,
    ]
    for i in 0..clicks.len {
        px := f32(clicks[i][0])
        py := f32(clicks[i][1])
        assert(hud.woodland_pointer_captured(1280.0, 800.0, false, false, false, true, px, py))
        assert(!hud.woodland_pointer_captured(1280.0, 800.0, false, false, false, false, px, py))
        p := widgets.Pointer::at(px, py, true, true)
        c.clear()
        act := hud.woodland_cozy(&mut controls, &mut c, &atlas, &p, 1280.0, 800.0, &open_info)
        assert(act == expected[i])
        // Verify all rendered geometry stays cleanly within the viewport.
        verts := c.vertices()
        for v in 0..verts.len / 8 {
            vx := verts[v * 8]
            vy := verts[v * 8 + 1]
            assert(vx >= 0.0 && vx <= 1280.0 && vy >= 0.0 && vy <= 800.0)
        }
        _ := hud.woodland_cozy(&mut controls, &mut c, &atlas, &release, 1280.0, 800.0, &open_info)
    }

    // Verify all Swedish labels inside the Alternativ mood & camera rows fit comfortably within their buttons.
    assert(ui.Canvas::text_width(&atlas, "Körsbärsdag", 0.54) + 6.0 <= 94.0)
    assert(ui.Canvas::text_width(&atlas, "Gyllene timmen", 0.54) + 6.0 <= 106.0)
    assert(ui.Canvas::text_width(&atlas, "Skymningsmys", 0.54) + 6.0 <= 94.0)
    assert(ui.Canvas::text_width(&atlas, "Utforska", 0.58) + 8.0 <= 98.0)
}

@test fn woodland_cozy_toast_compass_and_hover_pill_fit_within_bounds() {
    atlas := cozy_atlas()
    mut c := ui.Canvas::new()
    mut controls := widgets.State::new()
    p := widgets.Pointer::at(-1.0, -1.0, false, false)

    // Faded toast (alpha <= 0.02) draws nothing beyond cozy bar.
    mut faded := default_cozy_info()
    faded.toast = "Vallmo myser"
    faded.toast_alpha = 0.01
    c.clear()
    _ := hud.woodland_cozy(&mut controls, &mut c, &atlas, &p, 1280.0, 800.0, &faded)
    muted := c.vertex_count()

    // Active toast + compass pill (above butterfly) + hover pill on 1280x800.
    mut active := default_cozy_info()
    active.hovering_fox = true
    active.toast = "Vallmo hittade Skogsviol!"
    active.toast_alpha = 0.92
    active.compass_on = true
    active.compass_text = "Superfjäril Guldvinge ovanför dig"
    active.compass_butterfly = true
    active.compass_above = true
    c.clear()
    _ := hud.woodland_cozy(&mut controls, &mut c, &atlas, &p, 1280.0, 800.0, &active)
    assert(c.vertex_count() > muted)
    verts := c.vertices()
    mut saw_top_toast := false
    mut saw_compass := false
    mut saw_hover_pill := false
    for i in 0..verts.len / 8 {
        at := i * 8
        vx := verts[at]
        vy := verts[at + 1]
        assert(vx >= 0.0 && vx <= 1280.0 && vy >= 0.0 && vy <= 800.0)
        if vy >= 20.0 && vy <= 56.0 && vx > 400.0 && vx < 880.0 { saw_top_toast = true }
        if vy >= 115.0 && vy <= 160.0 && vx < 320.0 { saw_compass = true }
        if vy >= 700.0 && vy <= 745.0 && vx < 350.0 { saw_hover_pill = true }
    }
    assert(saw_top_toast && saw_compass && saw_hover_pill)

    // Narrow desktop (480x360) drops toast cleanly below both score card and compass pill.
    c.clear()
    _ := hud.woodland_cozy(&mut controls, &mut c, &atlas, &p, 480.0, 360.0, &active)
    nverts := c.vertices()
    mut saw_lower_toast := false
    for i in 0..nverts.len / 8 {
        at := i * 8
        vx := nverts[at]
        vy := nverts[at + 1]
        assert(vx >= 0.0 && vx <= 480.0 && vy >= 0.0 && vy <= 360.0)
        if vy >= 150.0 && vy <= 210.0 && vx > 80.0 && vx < 400.0 { saw_lower_toast = true }
    }
    assert(saw_lower_toast)

    // Compact 240x145 still keeps toast within bounds.
    c.clear()
    _ := hud.woodland_cozy(&mut controls, &mut c, &atlas, &p, 240.0, 145.0, &active)
    sverts := c.vertices()
    assert(sverts.len > 0)
    for i in 0..sverts.len / 8 {
        at := i * 8
        assert(sverts[at] >= 0.0 && sverts[at] <= 240.0)
        assert(sverts[at + 1] >= 0.0 && sverts[at + 1] <= 145.0)
    }
}

@test fn woodland_pointer_captured_matches_score_transport_cozy_bar_and_options() {
    // 1280x800 desktop layout
    assert(!hud.woodland_pointer_captured(1280.0, 800.0, false, false, false, false, 640.0, 400.0))
    // Score card top-left
    assert(hud.woodland_pointer_captured(1280.0, 800.0, false, false, false, false, 30.0, 40.0))
    assert(hud.woodland_pointer_captured(1280.0, 800.0, false, false, false, false, 200.0, 100.0))
    assert(!hud.woodland_pointer_captured(1280.0, 800.0, false, false, false, false, 30.0, 120.0))

    // Top-right transport card: height 41 when running, 77 when paused or won
    assert(hud.woodland_pointer_captured(1280.0, 800.0, false, false, false, false, 1180.0, 35.0))
    assert(!hud.woodland_pointer_captured(1280.0, 800.0, false, false, false, false, 1180.0, 75.0))
    assert(hud.woodland_pointer_captured(1280.0, 800.0, true, false, false, false, 1180.0, 75.0))
    assert(hud.woodland_pointer_captured(1280.0, 800.0, false, true, false, false, 1180.0, 75.0))

    // Bottom-right cozy pill bar: [976..1262] when !cam_adjusted, [885..1262] when cam_adjusted
    assert(hud.woodland_pointer_captured(1280.0, 800.0, false, false, false, false, 1020.0, 764.0))
    assert(!hud.woodland_pointer_captured(1280.0, 800.0, false, false, false, false, 920.0, 764.0))
    assert(hud.woodland_pointer_captured(1280.0, 800.0, false, false, true, false, 920.0, 764.0))

    // Alternativ floating card only captures when options_open is true
    assert(!hud.woodland_pointer_captured(1280.0, 800.0, false, false, false, false, 1100.0, 620.0))
    assert(hud.woodland_pointer_captured(1280.0, 800.0, false, false, false, true, 1100.0, 620.0))

    // Compact 320x500: transport is at bottom-right, cozy bar and options card are hidden
    assert(!hud.woodland_pointer_captured(320.0, 500.0, false, false, true, true, 260.0, 30.0))
    assert(hud.woodland_pointer_captured(320.0, 500.0, false, false, true, true, 240.0, 470.0))
    assert(hud.woodland_pointer_captured(320.0, 500.0, false, false, true, true, 30.0, 40.0))
}
