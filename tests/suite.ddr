@test fn compact_editor_routes_clicks_only_to_visible_tools() {
    mut graph := scenegraph.Graph::new()
    first := graph.create_root(core.vec3(0.0, 0.0, 0.0))
    _ := graph.set_name(first, "Turntable")
    child := graph.create_child(first, core.vec3(0.0, 0.0, 0.0))
    _ := graph.set_name(child, "Brass")
    _ := graph.set_material(child, scenegraph.material(0.8, 0.5, 0.3, 1.0, 0.8, 0.3))
    mut s := editor.new(first, true, true, false)
    atlas := text.Atlas::new(16, 16)
    mut canvas := ui.Canvas::new()
    points := [[45, 148], [140, 24], [45, 148], [209, 24], [645, 194], [670, 24], [591, 194]]
    mut metal: f32 = 0.0
    for i in 0..points.len {
        p := widgets.Pointer::at(f32(points[i][0]), f32(points[i][1]), true, true)
        canvas.clear()
        editor.draw(&mut s, &mut canvas, &atlas, &mut graph, &p, 0.0, 720.0, 520.0, 0.0, 6, "GPU", 0, 8)
        if i == 0 { assert(s.selected.index == first.index) }
        if i == 2 { assert(s.selected.index == child.index) }
        if i == 4 { metal = graph.material_value(child, .Metallic); assert(metal != 0.8) }
        if i == 6 { assert(s.focus && graph.material_value(child, .Metallic) == metal) }
        up := widgets.Pointer::at(p.x, p.y, false, false)
        editor.draw(&mut s, &mut canvas, &atlas, &mut graph, &up, 0.0, 720.0, 520.0, 0.0, 6, "GPU", 0, 8)
    }
}

import .play_view as _
import .scene_file as _

import ..src.app as app
import render

@test fn post_process_runs_after_scene_color_and_before_the_hud() {
    for shadows in [false, true] {
        for glass in [false, true] {
            for smooth in [false, true] {
                for strength in [0.0, 1.0] {
                    finish := gfx.PostProcess { antialias: smooth, strength: f32(strength) }
                    plan := app.frame_plan(shadows, glass, finish.enabled())
                    assert(finish.valid() && plan.ok)
                    mut i := 0
                    if shadows { assert(plan.steps[i].kind == render.PassKind.Shadow); i += 1 }
                    assert(plan.steps[i].kind == render.PassKind.Sky && plan.steps[i+1].kind == render.PassKind.Opaque)
                    i += 2
                    if glass { assert(plan.steps[i].kind == render.PassKind.Transparent); i += 1 }
                    if smooth || strength > 0.0 { assert(plan.steps[i].kind == render.PassKind.PostProcess); i += 1 }
                    assert(i+1 == plan.steps.len && plan.steps[i].kind == render.PassKind.Ui)
                }
            }
        }
    }
}

// `dunder test` collects tests from the modules the test root imports, and
// `test_root` names one file: a test module that is not imported here never
// runs, and nothing says so. This test makes that omission a failure instead
// of a silent gap, so adding a module to `tests/` cannot forget its import.
@test fn every_test_module_beside_the_suite_is_imported_by_it() {
    names := match fs.list_dir("tests") {
        .Ok(items) => items,
        .Err(e) => { _ := sys.eprint("could not list tests/: errno " + e.code().str()); assert(false); return },
    }
    suite := sys.read_text("tests/suite.ddr")
    if !suite.ok { _ := sys.eprint("could not read tests/suite.ddr: errno " + suite.error.str()); assert(false); return }
    mut missing: []string = []
    for name in &names {
        if !textlib.ends_with(name, ".ddr") || name == "suite.ddr" { continue }
        module := sys.read_text("tests/" + name)
        if !module.ok { _ := sys.eprint("could not read tests/" + name + ": errno " + module.error.str()); assert(false); return }
        if !textlib.contains(module.value, "@test") { continue }
        // `import .stem` opens a line and ends at whitespace: `.png` must not
        // pass for `.png_util`, and `..src.stem` is not a test-module import.
        needle := "import ." + name[0..name.len - 4]
        mut found := false
        mut cursor := textlib.lines(suite.value.as_str())
        while cursor.advance() {
            line := cursor.current().clone()
            if textlib.starts_with(line, needle) && (line.len == needle.len || line[needle.len] == u8(32) || line[needle.len] == u8(9)) { found = true }
        }
        if !found { missing.push("`import ." + name[0..name.len - 4] + " as _` (tests/" + name + " has tests)") }
    }
    for m in &missing { _ := sys.eprint("tests/suite.ddr never imports a test module: " + m) }
    assert(missing.len == 0)
}
