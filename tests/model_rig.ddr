import ..src.model
import gfx
import std.json as json

@test fn rig_reads_model_space_landmarks_and_resolves_unordered_parents() {
    doc := json.Doc::parse_text(r#"{"version":1,"joints":[
        {"name":"Foot","parent":"Body","pivot":[1,2,3],"sole":[1,0,3],"toe":[1,0,4]},
        {"name":"Body","parent":"","pivot":[0,0,0]}]}"#)
    rig := model.read_rig(&doc, doc.root).unwrap()
    foot := rig.get("Foot").unwrap()
    assert(foot.parent == "Body" && foot.pivot.y == 2.0 && foot.sole.unwrap().y == 0.0 && foot.toe.unwrap().z == 4.0)
    assert(rig.get("Body").unwrap().toe.is_none() && rig.get("Ear").is_err())
}

@test fn unusable_rig_hierarchies_and_landmarks_fail_at_load() {
    for source in [
        r#"{"version":2,"joints":[]}"#,
        r#"{"version":1,"joints":[{"name":"Root","parent":"Missing","pivot":[0,0,0]}]}"#,
        r#"{"version":1,"joints":[{"name":"A","parent":"B","pivot":[0,0,0]},{"name":"B","parent":"A","pivot":[0,0,0]}]}"#,
        r#"{"version":1,"joints":[{"name":"A","parent":"","pivot":[0,0,0]},{"name":"A","parent":"","pivot":[1,0,0]}]}"#,
        r#"{"version":1,"joints":[{"name":"Foot","parent":"","pivot":[0,0,0],"sole":[0,0]}]}"#,
    ] {
        doc := json.Doc::parse_text(source)
        assert(model.read_rig(&doc, doc.root).is_err())
    }
}

import ..src.art_asset

@test fn playable_vallmo_carries_painted_joint_weights_for_body_legs_and_brush() {
    fox := art_asset.load_rigged("fox").unwrap()
    for name in ["Body_Foxglove", "PawFL_Foxglove", "ShinFL_Foxglove", "FootFL_Boots",
        "PawFR_Foxglove", "ShinFR_Foxglove", "FootFR_Boots", "PawBL_Foxglove", "ShinBL_Foxglove", "FootBL_Boots",
        "PawBR_Foxglove", "ShinBR_Foxglove", "FootBR_Boots", "Tail_Foxglove", "TailMid_Foxglove", "TailTip_Brush"] {
        mut blended := false
        for i in 0..fox.rig.skins.len {
            s := &fox.rig.skins[i]
            if fox.art.parts[s.part].name != name { continue }
            assert(s.indices.len * gfx.VERTEX_FLOATS == fox.art.parts[s.part].vertices.len)
            for v in s.influences {
                mut count := 0
                for w in v.weights { if w > 0.01 { count += 1 } }
                if count >= 2 { blended = true; break }
            }
        }
        assert(blended)
    }
}
