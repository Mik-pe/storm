// Imported parts share mesh data, with per-instance materials and optional local joints.
import core
import ecs
import gltf
import scene
import std.json as json

pub struct Joint { prefix: string, hinge: ecs.Entity, mount: ecs.Entity }
pub struct Paint { material: string, color: core.Vec3, mix: f32 }

pub fn joint(g: &mut scene.Graph, root: ecs.Entity, prefix: string, pivot: core.Vec3) -> Joint {
    hinge := g.create_child(root, pivot)
    Joint { prefix: prefix.clone(), hinge: hinge, mount: g.create_child(hinge, core.scale(pivot, -1.0)) }
}

pub fn attach(g: &mut scene.Graph, root: ecs.Entity, art: &gltf.Asset, joints: &[]Joint,
    first: &mut []ecs.Entity, paint: &[]Paint) {
    reuse := first.len == art.parts.len
    for i in 0..art.parts.len {
        part := &art.parts[i]
        mut parent := root
        for j in joints {
            n := j.prefix.len
            if part.name.len >= n && part.name[0..n] == j.prefix { parent = j.mount; break }
        }
        mesh := g.create_child(parent, core.vec3(0.0, 0.0, 0.0))
        _ := g.set_name(mesh, part.name.clone())
        if reuse { _ := g.share_mesh(mesh, first[i]) }
        else {
            _ := g.set_mesh(mesh, part.vertices.clone())
            first.push(mesh)
        }
        c := part.color.clone()
        mut mat := scene.emissive_mapped(scene.material(c[0], c[1], c[2], c[3], part.metallic, part.roughness), part.emissive_factor.clone())
        for coat in paint {
            if part.material_name == coat.material {
                mat.base.r += (coat.color.x - mat.base.r) * coat.mix
                mat.base.g += (coat.color.y - mat.base.g) * coat.mix
                mat.base.b += (coat.color.z - mat.base.b) * coat.mix
                break
            }
        }
        _ := g.set_material(mesh, move mat)
    }
}

// Rig landmarks are in the same model space as the baked geometry.
pub struct BindJoint { name: string, parent: string, pivot: core.Vec3, sole: Option<core.Vec3>, toe: Option<core.Vec3> }
pub struct Rig { joints: []BindJoint, skins: []gltf.SkinBinding }

impl Rig {
    fn index(&self, name: string) -> i32 {
        for i in 0..self.joints.len { if self.joints[i].name == name { return i } }
        -1
    }
    pub fn get(&self, name: string) -> Result<BindJoint, string> {
        i := self.index(name)
        if i < 0 { return .Err("missing rig joint " + name) }
        .Ok(self.joints[i].clone())
    }
}

fn point(j: &json.Doc, node: i32, field: string) -> Result<Option<core.Vec3>, string> {
    item := j.field(node, field)
    if item < 0 { return .Ok(.None) }
    if j.kind(item) != .Array || j.count(item) != 3 { return .Err("invalid rig " + field) }
    mut xyz: [f32; 3] = [0.0; 3]
    for i in 0..3 {
        match j.as_f64(j.at(item, i)) {
            .Some(n) => { xyz[i] = f32(n) },
            .None => { return .Err("invalid rig " + field) },
        }
        if !xyz[i].is_finite() { return .Err("non-finite rig " + field) }
    }
    .Ok(.Some(core.vec3(xyz[0], xyz[1], xyz[2])))
}

pub fn read_rig(j: &json.Doc, node: i32) -> Result<Rig, string> {
    if j.get_i64(node, "version").unwrap_or(0) != 1 { return .Err("missing or unsupported Storm rig") }
    list := j.field(node, "joints")
    if j.kind(list) != .Array || j.count(list) == 0 { return .Err("rig needs joints") }
    mut rig := Rig { joints: [], skins: [] }
    for i in 0..j.count(list) {
        item := j.at(list, i)
        name := j.get_str(item, "name").unwrap_or_default()
        if name.len == 0 || rig.index(name) >= 0 { return .Err("missing or duplicate rig joint name: " + name) }
        parent := match j.get_str(item, "parent") {
            .Some(p) => p, .None => { return .Err("missing rig parent for " + name) },
        }
        pivot := match point(j, item, "pivot")? {
            .Some(v) => v, .None => { return .Err("missing rig pivot for " + name) },
        }
        rig.joints.push(BindJoint { name: name, parent: parent, pivot: pivot,
            sole: point(j, item, "sole")?, toe: point(j, item, "toe")? })
    }
    mut parents: []i32 = []
    for joint in rig.joints {
        i := rig.index(joint.parent)
        if i < 0 && joint.parent != "" { return .Err("unknown rig parent " + joint.parent) }
        parents.push(i)
    }
    for i in 0..parents.len {
        mut ancestor := parents[i]
        for _ in 0..parents.len {
            if ancestor < 0 { break }
            if ancestor == i { return .Err("cycle in rig at " + rig.joints[i].name) }
            ancestor = parents[ancestor]
        }
    }
    .Ok(move rig)
}
