// Cache the projection of walkable art once. Each contact reads the highest triangle beneath it.
import core
import gfx
import gltf

struct Triangle {
    origin: core.Vec3, ab: core.Vec3, ac: core.Vec3, inverse: f32,
    left: f32, right: f32, back: f32, front: f32,
}
pub struct Surface { faces: []Triangle, ceiling: f32 }

pub fn empty() -> Surface { Surface { faces: [], ceiling: -1.0e20 } }
fn min3(a: f32, b: f32, c: f32) -> f32 { if a < b && a < c { a } else if b < c { b } else { c } }
fn max3(a: f32, b: f32, c: f32) -> f32 { -min3(-a, -b, -c) }
fn point(v: &[]f32, i: i32) -> core.Vec3 { core.vec3(v[i], v[i+1], v[i+2]) }

pub fn build(art: &gltf.Asset, materials: &[]string) -> Surface {
    mut result := empty()
    for i in 0..art.parts.len {
        p := &art.parts[i]
        mut walkable := false
        for m in materials { if m == p.material_name { walkable = true; break } }
        if !walkable { continue }
        for face in 0..(p.vertices.len / (3 * gfx.VERTEX_FLOATS)) {
            index := 3 * face * gfx.VERTEX_FLOATS
            a := point(&p.vertices, index)
            b := point(&p.vertices, index + gfx.VERTEX_FLOATS)
            c := point(&p.vertices, index + 2 * gfx.VERTEX_FLOATS)
            ab := core.sub(b, a)
            ac := core.sub(c, a)
            area := ab.x * ac.z - ab.z * ac.x
            if area.abs() < 0.00000001 { continue }
            high := max3(a.y, b.y, c.y)
            if high > result.ceiling { result.ceiling = high }
            result.faces.push(Triangle { origin: a, ab: ab, ac: ac, inverse: 1.0 / area,
                left: min3(a.x, b.x, c.x), right: max3(a.x, b.x, c.x), back: min3(a.z, b.z, c.z), front: max3(a.z, b.z, c.z) })
        }
    }
    move result
}

pub fn top(surface: &Surface, x: f32, z: f32) -> Option<f32> {
    mut found := false
    mut highest: f32 = 0.0
    for i in 0..surface.faces.len {
        f := &surface.faces[i]
        if x < f.left || x > f.right || z < f.back || z > f.front { continue }
        dx := x - f.origin.x
        dz := z - f.origin.z
        u := (dx * f.ac.z - dz * f.ac.x) * f.inverse
        v := (f.ab.x * dz - f.ab.z * dx) * f.inverse
        if u < -0.000001 || v < -0.000001 || u + v > 1.000001 { continue }
        y := f.origin.y + u * f.ab.y + v * f.ac.y
        if !found || y > highest { found = true; highest = y }
    }
    if found { .Some(highest) } else { .None }
}
