// Command-line arguments, read from a list rather than from the process.
//
// Everything here is a pure function of `args` (the strings after the program
// name), so the parsing is testable without spawning a process: `main` copies
// `sys.arg(1..)` into a `[]string` once and hands that to every reader.
//
//   args := arguments.from_process()
//   limit := arguments.frame_limit(&args)
//   if arguments.flag(&args, "--no-glass") { … }
//   aim := arguments.aim(&args)
//   mut camera := input.Camera::new(aim.position)
//   camera.yaw = aim.yaw
//   camera.pitch = aim.pitch

import core
import std.math as math
import std.parse as parse
import sys

// Where the camera stands when --eye is not given.
fn default_eye() -> core.Vec3 { core.vec3(0.0, 4.0, 10.8) }
// How it is turned without --eye: straight ahead, tilted a little down.
// Together with default_eye this is the baseline capture every pixel
// comparison in docs/dogfood.md is measured against.
const DEFAULT_YAW: f32 = 0.0
const DEFAULT_PITCH: f32 = -0.22
// What --eye looks at when --at is not given: the middle of the scene.
fn default_target() -> core.Vec3 { core.vec3(0.0, 0.9, 0.0) }

// The strings after the program name, in order.
pub fn from_process() -> []string {
    mut out: []string = []
    for i in 1..sys.arg_count() { out.push(sys.arg(i)) }
    out
}

// The index of `name` in the list, or -1.
fn find(args: &[]string, name: string) -> i32 {
    for i in 0..args.len {
        if args[i] == name { return i }
    }
    -1
}

// A flag that stands alone: present or absent.
pub fn flag(args: &[]string, name: string) -> bool { find(args, &name) >= 0 }

// The first word on the command line that looks like a flag and is not one
// the program reads, or "" when every flag is known. `--help`/`-h` are the
// one pair that is accepted without a row of their own (the help line names
// both). Without this an unknown flag (`--bogus`) was skipped in silence and
// the program rendered its default picture (QA 2026-11-26): the table is the
// truth about what is read, so a word the table does not know is refused by
// name. Values never begin with "--" (see value), so every such word is a flag.
pub fn unknown(args: &[]string) -> string {
    known := flags()
    for i in 0..args.len {
        if args[i].len < 3 || args[i][0..2] != "--" { continue }
        if args[i] == "--help" || args[i] == "-h" { continue }
        mut found := false
        for f in &known { if f.name == args[i] { found = true; break } }
        if !found { return args[i].clone() }
    }
    ""
}

// The value after a flag, or "" when the flag is absent, the last word, or
// followed by another flag: a word that starts with "--" is never a value.
// A flag that needs one then reads as "not given" and names itself, instead
// of taking the next flag as its file (`--capture --frames 1` wrote a file
// called "--frames").
pub fn value(args: &[]string, name: string) -> string {
    i := find(args, &name)
    if i < 0 || i + 1 >= args.len { return "" }
    if args[i + 1].len >= 2 && args[i + 1][0..2] == "--" { return "" }
    args[i + 1].clone()
}

// A flag the program reads and the one line --help says about it. The table
// is the whole truth: a test holds every "--x" literal in src/ to a row here,
// so a flag added without a line is red, never forgotten.
pub struct Flag { name: string, args: string, text: string }

pub fn flags() -> []Flag {
    [
        Flag { name: "--help", args: "(-h)", text: "print this and exit" },
        Flag { name: "--studio", args: "", text: "open the material studio (default with --glb; otherwise Blomsterskogen is played)" },
        Flag { name: "--glb", args: "MODEL.glb", text: "load a model into the studio (autoscaled, standing on the ground)" },
        Flag { name: "--play", args: "", text: "play even with --glb" },
        Flag { name: "--scene", args: "FILE", text: "load a level from a scene file" },
        Flag { name: "--watch", args: "", text: "with --scene: reload when the file is saved" },
        Flag { name: "--mcp", args: "", text: "serve the agent's game tools on stdio instead of opening a window" },
        Flag { name: "--frames", args: "N", text: "render N frames and exit (0 or absent: no limit)" },
        Flag { name: "--capture", args: "FILE.ppm", text: "render one frame to a PPM without a window (1280 x 800)" },
        Flag { name: "--eye", args: "x y z", text: "start the camera at a point, turned towards the scene's middle" },
        Flag { name: "--at", args: "x y z", text: "with --eye: the point it looks at" },
        Flag { name: "--yaw", args: "a", text: "with --eye: turn the camera by this angle instead" },
        Flag { name: "--pitch", args: "b", text: "with --eye: tilt the camera by this angle instead" },
        Flag { name: "--texture", args: "FLOOR.ppm", text: "the studio's floor wears a Storm capture (needs the studio)" },
        Flag { name: "--font", args: "PATH", text: "the UI font (default: the platform's)" },
        Flag { name: "--no-glass", args: "", text: "start the studio without glass" },
        Flag { name: "--no-shadows", args: "", text: "start without shadows" },
        Flag { name: "--no-aa", args: "", text: "start without anti-aliasing" },
        Flag { name: "--no-post", args: "", text: "start without colour grading and glow" },
        Flag { name: "--effects", args: "", text: "start with colour grading and glow (--no-post wins)" },
        Flag { name: "--mood", args: "NAME", text: "Blomsterskogen sky mood: cherry, golden or twilight" },
        Flag { name: "--cam", args: "MODE", text: "Blomsterskogen camera preset: close, normal or explore" },
        Flag { name: "--compass", args: "", text: "start Blomsterskogen with the Vägvisare compass on" },
        Flag { name: "--options", args: "", text: "start Blomsterskogen with the Alternativ card open" },
        Flag { name: "--trace", args: "", text: "print each step of a frame" },
    ]
}

// The text --help prints: one line per flag, every flag in the program.
pub fn usage() -> string {
    mut out := "storm [--studio | --glb MODEL.glb | --play | --scene FILE [--watch] | --mcp] [options]\n"
    out = out + "Play Blomsterskogen, open the material studio, load a level, or serve the game tools on stdio.\n\n"
    out = out + "options:\n"
    // The descriptions start in one column: the widest name and arguments,
    // then two spaces.
    mut widest := 0
    for f in &flags() {
        mut left := f.name.len
        if f.args.len > 0 { left = left + 1 + f.args.len }
        if left > widest { widest = left }
    }
    for f in &flags() {
        mut left := f.name.clone()
        if f.args.len > 0 { left = left + " " + f.args }
        while left.len < widest + 2 { left = left + " " }
        out = out + "  " + left + f.text + "\n"
    }
    out
}

// --frames N: how many frames to render before exiting, 0 for no limit.
// A missing, trailing or non-positive value means "not given".
pub fn frame_limit(args: &[]string) -> i64 {
    given := value(args, "--frames")
    if given.len == 0 { return 0 }
    parsed := parse.integer(given)
    if parsed.ok && parsed.value > 0 { return parsed.value }
    0
}

// Three floats after `name`, or .None when the flag is absent, short or
// unparsable: "anything unparsable is the default" is one rule for the whole
// triple, not per component.
fn triple(args: &[]string, name: string) -> Option<core.Vec3> {
    i := find(args, &name)
    if i < 0 || i + 3 >= args.len { return .None }
    x := parse.Float32::parse(args[i + 1])
    y := parse.Float32::parse(args[i + 2])
    z := parse.Float32::parse(args[i + 3])
    if x.ok && y.ok && z.ok { return .Some(core.vec3(x.value, y.value, z.value)) }
    .None
}

// One float after `name`, or .None when the flag is absent or unparsable.
fn single(args: &[]string, name: string) -> Option<f32> {
    i := find(args, &name)
    if i < 0 || i + 1 >= args.len { return .None }
    parsed := parse.Float32::parse(args[i + 1])
    if parsed.ok { return .Some(parsed.value) }
    .None
}

// Where the camera starts and how it is turned.
pub struct Aim {
    position: core.Vec3,
    // Yaw around +Y, pitch around the camera's right axis, in the camera's
    // own convention: forward = (sin yaw cos pitch, sin pitch, -cos yaw cos
    // pitch). Radians.
    yaw: f32,
    pitch: f32,
}

// The turn that makes a camera at `from` look at `to`. Pitch is atan2 of the
// height over the horizontal distance - exact at the horizon and no inverse
// sine needed; yaw follows from forward's x and -z. Straight up or down
// (no horizontal distance) keeps the yaw at zero.
pub fn look_at(from: core.Vec3, to: core.Vec3) -> Aim {
    dx := to.x - from.x
    dy := to.y - from.y
    dz := to.z - from.z
    flat := (dx * dx + dz * dz).sqrt()
    mut yaw: f32 = 0.0
    if flat > 0.0 { yaw = f32(math.atan2(f64(dx), f64(-dz))) }
    Aim { position: from, yaw: yaw, pitch: f32(math.atan2(f64(dy), f64(flat))) }
}

// The baseline: the default position turned by the default yaw and pitch.
fn baseline() -> Aim {
    Aim { position: default_eye(), yaw: DEFAULT_YAW, pitch: DEFAULT_PITCH }
}

// --eye x y z [--at x y z] [--yaw a] [--pitch b]: where the camera starts and
// what it looks at.
//
// Without --eye the camera is the baseline. With --eye it *looks at* --at
// (the middle of the scene by default), so a position anywhere around the
// scene produces a picture of the scene: an --eye that only moved the camera
// showed the empty horizon behind it. --yaw and --pitch, when given, replace
// the computed turn, so one specific angle is still one flag away. Anything
// unparsable is the baseline.
pub fn aim(args: &[]string) -> Aim {
    given := triple(args, "--eye")
    match given {
        .None => baseline(),
        .Some(eye) => {
            mut target := default_target()
            at := triple(args, "--at")
            match at {
                .Some(t) => { target = t },
                .None => {},
            }
            mut a := look_at(eye, target)
            yaw := single(args, "--yaw")
            match yaw {
                .Some(v) => { a.yaw = v },
                .None => {},
            }
            pitch := single(args, "--pitch")
            match pitch {
                .Some(v) => { a.pitch = v },
                .None => {},
            }
            a
        },
    }
}
