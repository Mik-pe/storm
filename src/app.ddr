// Storm — a game engine in Dunder.
//
// The editor and the game. Everything here talks to the gfx.Backend
// contract and never to a backend: `run` is generic over whichever backend
// the composition root (main.ddr) picks for the platform.
//
//   dunder run                     interactive
//   dunder run -- --frames 60      render 60 frames and exit
//   dunder run -- --capture a.ppm  one headless frame to disk
//   dunder run -- --font f.ttf     draw the editor with that font
//   dunder run -- --texture f.ppm  the studio floor carries that P6 image
capability stdio

import .editor
import .args
import .gallery
import .game
import .play_view
import .play_ui
import .scene_file
import play
import core
import ecs
import gfx
import gltf
import image
import input
import render
import scene as scenegraph
import sys
import text
import ui
import ui.widgets as widgets

// Every character the editor draws has to be packed into the atlas.
const GLYPHS: string = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789 .,:;!?/-+()[]%&*#@=<>_|~ – åäö ÅÄÖ ²³"
const TITLE: string = "Storm"

// Report why the backend refused, close it, and stop with a failure.
fn stop<B: gfx.Backend>(move window: B, message: string) -> Result<(), string> {
    window.close()
    .Err(message.clone())
}

// Loads a .glb into the scene as a node with its own vertex stream, scaled to
// MODEL_SIZE units on its longest side and resting on y = 0, so any model
// lands in view whatever units it was authored in.
pub const MODEL_SIZE: f32 = 2.4
// Place a GLB in the graph, scaled to MODEL_SIZE and centred on `at`.
// `textures[i]` is the uploaded base colour image of part i, or
// `gfx.no_texture()` for a part that is only a colour.
pub fn load_model(graph: &mut scenegraph.Graph, path: string, at: core.Vec3, textures: &[]gfx.Textures) -> Result<(), string> {
    doc := gltf.load(path)
    model := gltf.asset(&doc)?
    place_model(&mut graph, &model, path, at, textures)
}

pub fn place_model(graph: &mut scenegraph.Graph, model: &gltf.Asset, path: string, at: core.Vec3, textures: &[]gfx.Textures) -> Result<(), string> {
    mut lo := core.vec3(0.0,0.0,0.0)
    mut hi := lo
    mut first := true
    for part in &model.parts {
        for v in 0..part.vertices.len / gfx.VERTEX_FLOATS {
            i := v * gfx.VERTEX_FLOATS
            p := core.vec3(part.vertices[i], part.vertices[i+1], part.vertices[i+2])
            if first || p.x < lo.x { lo.x = p.x }
            if first || p.y < lo.y { lo.y = p.y }
            if first || p.z < lo.z { lo.z = p.z }
            if first || p.x > hi.x { hi.x = p.x }
            if first || p.y > hi.y { hi.y = p.y }
            if first || p.z > hi.z { hi.z = p.z }
            first = false
        }
    }
    span := core.sub(hi, lo)
    mut extent := span.x
    if span.y > extent { extent = span.y }
    if span.z > extent { extent = span.z }
    scale := if extent > 0.0 { MODEL_SIZE / extent } else { f32(1.0) }
    base := graph.create_root(core.vec3(at.x - (lo.x + hi.x)*0.5*scale, at.y-lo.y*scale, at.z-(lo.z+hi.z)*0.5*scale))
    _ := graph.set_name(base, path.clone())
    graph.set_scale(base, core.vec3(scale,scale,scale))
    for i in 0..model.parts.len {
        part := &model.parts[i]
        node := graph.create_child(base, core.vec3(0.0,0.0,0.0))
        _ := graph.set_name(node, part.name.clone())
        c := part.color.clone()
        mut material := scenegraph.material(c[0],c[1],c[2],c[3],part.metallic,part.roughness)
        material = scenegraph.emissive_mapped(move material, part.emissive_factor.clone())
        if i < textures.len { material = scenegraph.mapped(move material, textures[i].clone()) }
        _ := graph.set_material(node, move material)
        _ := graph.set_mesh(node, part.vertices.clone())
    }
    .Ok
}

// One uploaded image of a model: which image it is, the sampler and the
// encoding it was taken with. A texture is those three, so two parts that
// use one image as base colour and as metallic-roughness map are two
// uploads, and two parts that use it the same way share one.
struct Upload { image: i32, sampler: gfx.Sampler, encoding: gfx.Encoding, texture: gfx.Texture }

// The same, with the asset's images decoded and uploaded through `window`:
// one Textures per part, in the order of the parts. A map a part does not
// have is no_texture(). A JPEG is refused by name: one unsupported format is
// a message, not a guess.
//
// Only this function is generic over the backend. Everything it reaches is
// compiled once per generic function that reaches it (Storm dogfood 89), so
// the deciding -- which image, which sampler, already uploaded or not, is it
// a PNG -- lives in plain functions, and the one call that needs the backend
// is written here.
pub fn upload_model_textures<B: gfx.Backend>(window: &mut B, asset: &gltf.Asset) -> Result<[]gfx.Textures, string> {
    mut uploads: []Upload = []
    mut textures: []gfx.Textures = []
    for part in &asset.parts {
        base := upload_or_refused(&uploads, asset, part.name, "base colour", part.texture, &part.sampler, .Srgb)?
        rough := upload_or_refused(&uploads, asset, part.name, "metallic-roughness map", part.metallic_roughness, &part.metallic_roughness_sampler, .Linear)?
        // The emissive map is a colour the surface gives off: sRGB, like the base.
        glow := upload_or_refused(&uploads, asset, part.name, "emissive map", part.emissive, &part.emissive_sampler, .Srgb)?
        mut base_handle := base.handle
        if base.decoded.pixels.len > 0 {
            base_handle = window.upload_texture(base.decoded.pixels, base.decoded.width, base.decoded.height, base.encoding, &base.sampler)?
            remember(&mut uploads, &base, base_handle)
        }
        mut rough_handle := rough.handle
        if rough.decoded.pixels.len > 0 {
            rough_handle = window.upload_texture(rough.decoded.pixels, rough.decoded.width, rough.decoded.height, rough.encoding, &rough.sampler)?
            remember(&mut uploads, &rough, rough_handle)
        }
        mut glow_handle := glow.handle
        if glow.decoded.pixels.len > 0 {
            glow_handle = window.upload_texture(glow.decoded.pixels, glow.decoded.width, glow.decoded.height, glow.encoding, &glow.sampler)?
            remember(&mut uploads, &glow, glow_handle)
        }
        textures.push(gfx.Textures { base: base_handle, metallic_roughness: rough_handle, normal: gfx.no_texture(),
            occlusion: gfx.no_texture(), emissive: glow_handle })
    }
    .Ok(textures)
}

// What a map asks for: the handle it already has, or the decoded pixels
// waiting for the backend. `map` names the slot the image is read in ("base
// colour", "metallic-roughness map"), so a refusal says what was looked for.
struct Pending { image: i32, sampler: gfx.Sampler, encoding: gfx.Encoding, decoded: image.Image, handle: gfx.Texture }

fn upload_or_refused(uploads: &[]Upload, asset: &gltf.Asset, part_name: string, map: string, image_index: i32,
    sampler: &gfx.Sampler, encoding: gfx.Encoding) -> Result<Pending, string> {
    if image_index < 0 { return .Ok(Pending { image: image_index, sampler: copy_sampler(sampler), encoding: encoding, decoded: image.empty(), handle: gfx.no_texture() }) }
    if image_index >= asset.images.len { return .Err("part " + part_name + ": " + map + " names image " + image_index.str() + " which does not exist") }
    for u in uploads {
        if u.image == image_index && u.encoding == encoding && same_sampler(&u.sampler, sampler) {
            return .Ok(Pending { image: image_index, sampler: copy_sampler(sampler), encoding: encoding, decoded: image.empty(), handle: u.texture })
        }
    }
    part_image := &asset.images[image_index]
    if part_image.mime != "image/png" { return .Err("part " + part_name + ": " + map + ": image " + image_index.str() + " is " + part_image.mime + ", Storm reads PNG") }
    decoded := image.decode_png(&part_image.data)?
    .Ok(Pending { image: image_index, sampler: copy_sampler(sampler), encoding: encoding, decoded: decoded, handle: gfx.no_texture() })
}

// After the backend took the pixels: the upload is known by its image,
// sampler and encoding from now on.
fn remember(uploads: &mut []Upload, pending: &Pending, handle: gfx.Texture) {
    uploads.push(Upload { image: pending.image, sampler: copy_sampler(&pending.sampler), encoding: pending.encoding, texture: handle })
}

fn copy_sampler(s: &gfx.Sampler) -> gfx.Sampler { gfx.Sampler { mag: s.mag, min: s.min, mips: s.mips, wrap: s.wrap } }

// Whether two samplers would sample the same way.
fn same_sampler(a: &gfx.Sampler, b: &gfx.Sampler) -> bool {
    a.mag == b.mag && a.min == b.min && a.mips == b.mips && a.wrap == b.wrap
}

// load_model for the running app: reads, decodes, uploads, places.
pub fn load_model_into<B: gfx.Backend>(window: &mut B, graph: &mut scenegraph.Graph, path: string, at: core.Vec3) -> Result<(), string> {
    doc := gltf.load(path)
    asset := gltf.asset(&doc)?
    textures := upload_model_textures(&mut window, &asset)?
    place_model(&mut graph, &asset, path, at, &textures)
}

// A P6 capture as the ground texture, uploaded once; the backend owns the
// pixels from here on. A ground is a colour, so it is sRGB.
fn load_ground<B: gfx.Backend>(window: &mut B, path: string) -> Result<gfx.Texture, string> {
    decoded := image.read_rgba(path)?
    sampler := gfx.sampler()
    window.upload_texture(decoded.pixels, decoded.width, decoded.height, .Srgb, &sampler)
}

pub fn record_mesh<B: gfx.Backend>(window: &mut B, vertices: &[]f32, item: &scenegraph.Drawable, view_projection: core.Mat4,
    camera_position: core.Vec3, sky: &gfx.Sky, shadows_on: bool, pass: render.PassKind) -> Result<(), string> {
    if pass == .Shadow { return window.shadow_mesh(vertices, &item.model.m) }
    mvp := core.multiply(view_projection, item.model)
    mut color: [f32; 4] = [item.material.base.r, item.material.base.g, item.material.base.b, item.material.base.a]
    mut shadow_flag: f32 = 0.0
    if shadows_on { shadow_flag = 1.0 }
    mut params: [f32; 4] = [item.material.metallic, item.material.roughness, item.material.emissive, shadow_flag]
    mut eye: [f32; 3] = [camera_position.x, camera_position.y, camera_position.z]
    surface := if game.is_transparent(&item.material) { gfx.Surface.Blended } else { gfx.Surface.Opaque }
    window.mesh(vertices, &mvp.m, &item.model.m, &color, &params, &eye, sky, &item.material.textures, &item.material.emissive_factor, surface)
}

pub fn record_list<B: gfx.Backend>(window: &mut B, meshes: &[]scenegraph.Mesh, items: &[]scenegraph.Drawable,
    cube: &[]f32, plane: &[]f32, sphere: &[]f32, view: core.Mat4, eye: core.Vec3, sky: &gfx.Sky, shadows: bool, pass: render.PassKind) -> Result<(), string> {
    for index in 0..items.len {
        item := &items[index]
        drawn := match item.shape {
            .Mesh => record_mesh(&mut window, &meshes[item.mesh_index].vertices, item, view, eye, sky, shadows, pass),
            .Sphere => record_mesh(&mut window, sphere, item, view, eye, sky, shadows, pass),
            .Cube => record_mesh(&mut window, cube, item, view, eye, sky, shadows, pass),
            .Plane => record_mesh(&mut window, plane, item, view, eye, sky, shadows, pass),
        }
        drawn?
    }
    .Ok
}

// Bytes of f32 vertices the frame's draws read: what `begin_with_vertices`
// is asked for. Each shape reads its own stream, so a shared mesh counts once
// per instance that draws it.
pub fn vertex_bytes(items: &[]scenegraph.Drawable, meshes: &[]scenegraph.Mesh, cube: i32, plane: i32, sphere: i32) -> u64 {
    mut total: u64 = 0
    for item in items {
        count := match item.shape { .Mesh => meshes[item.mesh_index].vertices.len, .Cube => cube, .Plane => plane, .Sphere => sphere }
        total += u64(count) * 4
    }
    total
}

// The scene as the frame's passes read it: a mesh copy taken when the geometry
// last changed, and this frame's draws split into what casts shadows (and is
// drawn opaque) and what is blended, sorted far to near.
pub struct FrameGeometry {
    revision: i64,
    meshes: []scenegraph.Mesh,
    solids: []scenegraph.Drawable,
    glass: []scenegraph.Drawable,
}

impl FrameGeometry {
    pub fn new() -> Self { Self { revision: -1, meshes: [], solids: [], glass: [] } }
    pub fn meshes(&self) -> &[]scenegraph.Mesh { &self.meshes }
    pub fn solids(&self) -> &[]scenegraph.Drawable { &self.solids }
    pub fn glass(&self) -> &[]scenegraph.Drawable { &self.glass }
    // Forget the mesh copy so the next gather takes a fresh one: a different
    // world can have counted its revision to the same number as this one.
    pub fn invalidate(&mut self) { self.revision = -1 }
}

pub fn gather(frame: &mut FrameGeometry, world: &scenegraph.Graph, eye: core.Vec3) {
    if frame.revision != world.geometry_revision() {
        frame.meshes = world.mesh_snapshot()
        frame.revision = world.geometry_revision()
    }
    frame.solids.clear()
    frame.glass.clear()
    for item in world.drawables(eye) {
        if game.casts_shadow(&item) { frame.solids.push(item) } else { frame.glass.push(item) }
    }
    game.sort_back_to_front(&mut frame.glass)
}

pub fn shadow_view(sun: core.Vec3, center: core.Vec3, radius: f32) -> core.Mat4 {
    eye := core.add(center, core.scale(sun, radius * 1.6))
    view := core.look_at(eye, center, core.vec3(0.0, 1.0, 0.0))
    projection := core.orthographic(-radius, radius, -radius, radius, 1.0, radius * 4.0)
    core.multiply(projection, view)
}

pub fn frame_plan(shadows: bool, glass: bool, filtered: bool) -> render.Compiled {
    mut schedule := render.Graph::new()
    scene_color := if filtered { "scene_color" } else { "display" }
    if shadows { _ := schedule.add_pass(.Shadow, "shadow", ["shadow_map"], []) }
    _ := schedule.add_pass(.Sky, "sky", [scene_color.clone(), "depth"], [])
    mut reads: []string = [scene_color.clone(), "depth"]
    if shadows { reads.push("shadow_map") }
    _ := schedule.add_pass(.Opaque, "opaque", [scene_color.clone(), "depth"], move reads)
    if glass { _ := schedule.add_pass(.Transparent, "transparent", [scene_color.clone()], [scene_color.clone(), "depth"]) }
    if filtered { _ := schedule.add_pass(.PostProcess, "post", ["display"], [scene_color.clone()]) }
    _ := schedule.add_pass(.Ui, "ui", ["display"], ["display"])
    schedule.compile()
}

enum Launch { Studio, Game, Preview }

pub fn run<B: gfx.Backend>(open: fn(string, i32, i32) -> Result<B, string>, argv: &[]string) -> Result<(), string> {
    path := args.value(argv, "--scene")
    if args.flag(argv, "--scene") && path.len == 0 { return .Err("--scene requires a scene file") }
    if args.flag(argv, "--capture") && args.value(argv, "--capture").len == 0 { return .Err("--capture requires an output file") }
    watch := args.flag(argv, "--watch")
    if watch && path.len == 0 { return .Err("--watch requires --scene FILE") }
    text := if path.len > 0 { play.read_source(path)? } else { "" }
    source := if path.len > 0 { play.decode(text)? } else { play.demo() }
    studio := args.flag(argv, "--studio") || args.flag(argv, "--glb")
    mode := if studio && path.len == 0 && !args.flag(argv, "--play") { Launch.Studio } else { Launch.Game }
    watcher := scene_file.new(if watch { path } else { "" }, if watch { text } else { "" })
    run_session(open, argv, play.start(&source), mode, args.value(argv, "--capture"), move watcher)
}

pub fn preview<B: gfx.Backend>(open: fn(string, i32, i32) -> Result<B, string>, session: &play.Session, path: string) -> Result<(), string> {
    argv: []string = []
    run_session(open, &argv, session.clone(), .Preview, path, scene_file.new("", ""))
}

fn run_session<B: gfx.Backend>(open: fn(string, i32, i32) -> Result<B, string>, argv: &[]string,
    move initial: play.Session, launch: Launch, shot: string, move file: scene_file.Watch) -> Result<(), string> {
    mut watcher := move file
    mut session := move initial
    mut playing := launch != .Studio
    exporting := launch == .Preview
    limit := args.frame_limit(argv)
    mut window := open(TITLE, if exporting { 720 } else { 1280 }, if exporting { 450 } else { 800 })?
    window.set_trace(args.flag(argv, "--trace"))
    device := window.device_name()
    if !exporting { print("device=" + device) }
    capturing := shot.len > 0
    if capturing {
        captured := window.capture_next()
        if captured.is_err() { return stop(move window, captured.unwrap_err()) }
    }

    // --- geometry ---
    mut cube_vertices: []f32 = []
    gfx.cube(&mut cube_vertices, 0.6)
    mut sphere_vertices := play_view.sphere_geometry(&session.scene)
    mut plane_vertices: []f32 = []
    gfx.plane(&mut plane_vertices, 40.0)

    mut graph := scenegraph.Graph::new()
    missing := ecs.Entity { index: -1, generation: 0 }
    mut study := gallery.Study { hub: missing, floor: missing, ring: missing, left: missing, right: missing }
    if !exporting && (!playing || !capturing) {
        study = gallery.build(&mut graph)
        game.spawn_orbs(&mut graph)
    }
    mut game_view := match play_view.build(&session) {
        .Ok(view) => view, .Err(err) => { return stop(move window, err) },
    }
    custom_eye := args.flag(argv, "--eye")
    forest_horizon: [f32; 4] = [0.99, 0.78, 0.82, 0.16]
    forest_zenith: [f32; 4] = [0.63, 0.65, 0.86, 1.0]
    backdrop: [f32; 4] = [0.24, 0.34, 0.38, 1.0]
    mut hud := widgets.State::new()
    mut action := play_ui.Action.Idle
    mut paused := false
    glb := args.value(argv, "--glb")
    if glb.len > 0 {
        match load_model_into(&mut window, &mut graph, glb, core.vec3(0.0,0.0,4.2)) {
            .Ok => {}, .Err(err) => { return stop(move window, glb + ": " + err) },
        }
    }
    graph.propagate()

    // --- --texture FILE.ppm: a Storm capture as the studio floor's texture ---
    texture_path := args.value(argv, "--texture")
    if texture_path.len > 0 {
        if playing { return stop(move window, "--texture needs the studio: " + texture_path) }
        ground := match load_ground(&mut window, texture_path) {
            .Ok(handle) => handle,
            .Err(message) => { return stop(move window, texture_path + ": " + message) },
        }
        floor_material := graph.material_at(study.floor).clone()
        _ := graph.set_material(study.floor, scenegraph.textured(move floor_material, ground))
    }

    // --- camera ---
    start := args.aim(argv)
    mut camera := input.Camera::new(start.position)
    camera.yaw = start.yaw
    camera.pitch = start.pitch
    camera.fov = 0.85

    // --- lighting: one sun, shared by the sky dome and every surface ---
    sun := core.normalize(core.vec3(-0.72, 0.88, 0.58))
    mut sun_push: [f32; 4] = [sun.x, sun.y, sun.z, 3.1]
    mut sun_color_push: [f32; 4] = [1.0, 0.91, 0.76, 1.0]
    mut zenith_push: [f32; 4] = [0.13, 0.20, 0.26, 1.0]
    mut horizon_push: [f32; 4] = [0.70, 0.61, 0.52, 1.0]
    // Sun view-projection: the light sits back along the sun direction and looks
    // at the middle of the scene through a box wide enough for the whole demo.
    light_target := core.vec3(0.0, 0.9, 0.0)
    light_eye := core.add(light_target, core.scale(sun, 16.0))
    light_vp := shadow_view(sun, light_target, 10.0)
    mut light_dir_c: [f32; 4] = [sun.x, sun.y, sun.z, core.dot(light_eye, sun)]
    sky := gfx.sky_params(sun_push, sun_color_push, zenith_push, horizon_push, light_vp.m, light_dir_c)
    // The environment maps are built once from the same sky the dome draws,
    // so reflections and irradiance agree with what is visible.
    environment := window.build_environment(&sky)
    if environment.is_err() { return stop(move window, environment.unwrap_err()) }

    disable_post := args.flag(argv, "--no-post")
    enable_post := args.flag(argv, "--effects") && !disable_post
    mut game_grade: Option<bool> = if disable_post { .Some(false) } else if enable_post { .Some(true) } else { .None }
    mut studio := editor.new(study.ring, !args.flag(argv, "--no-glass"), !args.flag(argv, "--no-shadows"), enable_post)
    studio.antialias = !args.flag(argv, "--no-aa")
    mut glass_visible := true
    mut score: i32 = 0
    mut total: i32 = game.orbs_left(&graph)

    // --- editor text: --font <path>, else the platform's UI font ---
    // The glyphs are rasterized at the display's density (2 on Retina), so
    // they are sharp there and the same size everywhere: the canvas asks the
    // atlas how large they are.
    density := window.poll().scale
    font := text.find_font(args.value(argv, "--font"))
    if font.len == 0 {
        return stop(move window, "no UI font found; pass --font <path>")
    }
    face := text.load_face(font, ui.RASTER_SIZE * density)
    if !face.ok {
        return stop(move window, "font missing: " + face.error)
    }
    mut atlas := text.Atlas::new(1024, 1024)
    if !atlas.add_text(&face, GLYPHS) || !atlas.add_text(&face, session.scene.name) {
        return stop(move window, "no glyphs packed")
    }
    pixels := atlas.copy_pixels()
    atlas_size := atlas.size()
    uploaded := window.ui_atlas(pixels, atlas_size, atlas_size)
    if uploaded.is_err() { return stop(move window, uploaded.unwrap_err()) }
    mut canvas := ui.Canvas::new()
    mut fps: f32 = 0.0

    mut plan := render.Compiled { ok: true, error: "", steps: [] }
    mut planned_shadows := false
    mut planned_glass := false
    mut planned_filter := false
    mut geometry := FrameGeometry::new()
    mut mesh_world_is_game := false
    mut frames: i64 = 0
    mut previous := 0.0
    mut running := true
    while running {
        frame := window.poll()
        if frame.closed || frame.input.down(gfx.Key.Escape) { running = false; continue }
        mut dt := if previous == 0.0 { 0.016 } else { frame.time - previous }
        previous = frame.time
        if frames > 0 && dt > 0.0 {
            instant := f32(1.0 / dt)
            fps = if fps == 0.0 { instant } else { fps * 0.9 + instant * 0.1 }
        }

        if frame.width <= 0 || frame.height <= 0 { continue }
        if watcher.path.len > 0 && !capturing {
            match scene_file.poll(&mut watcher, frame.time) {
                .Ok(change) => {
                    match change {
                        .Some(level) => {
                            if level.name != session.scene.name {
                                // Repack on a new title to bound the atlas across many edits.
                                mut fresh_atlas := text.Atlas::new(atlas_size, atlas_size)
                                if !fresh_atlas.add_text(&face, GLYPHS) || !fresh_atlas.add_text(&face, level.name) {
                                    return stop(move window, "could not pack the updated scene title")
                                }
                                updated := window.ui_atlas(fresh_atlas.copy_pixels(), atlas_size, atlas_size)
                                if updated.is_err() { return stop(move window, updated.unwrap_err()) }
                                atlas = move fresh_atlas
                            }
                            session = play.start(&level)
                            game_view = match play_view.build(&session) {
                                .Ok(view) => view, .Err(err) => { return stop(move window, err) },
                            }
                            sphere_vertices = play_view.sphere_geometry(&level)
                            geometry.invalidate()
                        },
                        .None => {},
                    }
                },
                .Err(message) => {
                    _ := sys.eprint("storm: scene reload: " + message)
                },
            }
        }
        if studio.play_requested {
            studio.play_requested = false
            session = play.start(&session.scene)
            playing = true
            paused = false
        }
        if action == .Studio { playing = false }
        aspect := f32(frame.width) / f32(frame.height)
        mut view_camera := camera
        mut frame_sky := sky.clone()
        if playing {
            frame_sky.horizon = backdrop.clone()
            if session.scene.theme == .Blossom {
                frame_sky.horizon = forest_horizon.clone()
                frame_sky.zenith = forest_zenith.clone()
                frame_sky.sun[3] = 2.15
                frame_sky.diffuse_fill = 0.40
            }
        }
        if playing {
            if frame.input.hit(.E) { game_grade = .Some(!game_grade.unwrap_or(session.scene.theme == .Blossom)) }
            if action == .Restart || frame.input.hit(.R) {
                session = play.start(&session.scene)
                paused = false
            }
            if action == .TogglePause || frame.input.hit(.Q) { paused = !paused }
            controls := play_view.controls(&frame.input)
            if !capturing {
                if paused && action == .Step { play.step(&mut session, controls) }
                else if !paused { _ := play.advance(&mut session, dt, controls) }
            }
            play_view.sync(&mut game_view, &session, paused || capturing)
            area := play_view.framing(&game_view, &session, paused || capturing)
            if !custom_eye { view_camera = play_view.camera(&area, aspect) }
            radius := 4.0 + core.length(area.extent)
            frame_sky.light_vp = shadow_view(sun, area.center, radius).m
            frame_sky.light_dir_c[3] = core.dot(area.center, sun) + radius * 1.6
        } else {
            if dt > 0.1 { dt = 0.1 }
            // Mouse look only while the right button is held.
            over_view := editor.in_viewport(&studio, frame.input.mouse.x, frame.input.mouse.y, f32(frame.width), f32(frame.height))
            camera.update(&frame.input, f32(dt), over_view && frame.input.button_down(gfx.MOUSE_RIGHT))
            if frame.input.hit(gfx.Key.R) {
                baseline := args.aim(argv)
                camera = input.Camera::new(baseline.position)
                camera.yaw = baseline.yaw
                camera.pitch = baseline.pitch
                camera.fov = 0.85
                game.reset_orbs(&mut graph)
                score = 0
                total = game.orbs_left(&graph)
            }
            if frame.input.hit(gfx.Key.F) { studio.focus = !studio.focus }
            if frame.input.hit(gfx.Key.T) { studio.glass = !studio.glass }
            if frame.input.hit(gfx.Key.G) { studio.shadows = !studio.shadows }
            if frame.input.hit(gfx.Key.E) { studio.effects = !studio.effects }
            if glass_visible != studio.glass {
                for pane in [study.left, study.right] {
                    if studio.glass { _ := graph.set_shape(pane, .Cube) } else { _ := graph.remove_shape(pane) }
                }
                glass_visible = studio.glass
            }

            // Animate the orbit: the hub rotates, children follow through the tree.
            graph.set_rotation(study.hub, graph.local(study.hub).rotation_y + f32(dt) * 0.10)
            graph.propagate()

            // --- the game: walk into an orb to collect it ---
            score = score + game.collect_orbs(&mut graph, camera.position)
            view_camera = camera
        }
        action = .Idle
        view_projection := view_camera.view_projection(aspect)
        inv_view_projection := input.inverse_view_projection(&view_camera, aspect)

        // --- scene contents for this frame: everything the scene says is drawable ---
        if mesh_world_is_game != playing { geometry.invalidate(); mesh_world_is_game = playing }
        if playing { gather(&mut geometry, &game_view.graph, view_camera.position) }
        else { gather(&mut geometry, &graph, view_camera.position) }
        shadows := studio.shadows && geometry.solids.len > 0
        transparent := geometry.glass.len > 0
        grade := if playing { game_grade.unwrap_or(session.scene.theme == .Blossom) } else { studio.effects }
        finish := gfx.PostProcess { antialias: studio.antialias, strength: if grade { 1.0 } else { 0.0 } }
        filtered := finish.enabled()
        if plan.steps.len == 0 || shadows != planned_shadows || transparent != planned_glass || filtered != planned_filter {
            plan = frame_plan(shadows, transparent, filtered)
            if !plan.ok { return stop(move window, plan.error) }
            planned_shadows = shadows
            planned_glass = transparent
            planned_filter = filtered
        }

        solid_bytes := vertex_bytes(&geometry.solids, &geometry.meshes, cube_vertices.len, plane_vertices.len, sphere_vertices.len)
        glass_bytes := vertex_bytes(&geometry.glass, &geometry.meshes, cube_vertices.len, plane_vertices.len, sphere_vertices.len)
        begun := window.begin_with_vertices(solid_bytes + glass_bytes + (if shadows { solid_bytes } else { u64(0) }))
        if begun.is_err() {
            // A frame lost to a resize is skipped, not an error.
            if frame.resized { continue }
            return stop(move window, begun.unwrap_err())
        }

        // --- execute: the schedule is the only thing that decides what runs ---
        mut main_pass_open := false
        for step in 0..plan.steps.len {
            kind := plan.steps[step].kind
            if kind == render.PassKind.Shadow {
                // Lives in its own render pass, so the main pass must not be open.
                match window.shadow_begin(&frame_sky) {
                    .Ok => {},
                    .Err(message) => { return stop(move window, message) },
                }
                drawn := record_list(&mut window, &geometry.meshes, &geometry.solids, &cube_vertices, &plane_vertices, &sphere_vertices,
                    view_projection, view_camera.position, &frame_sky, studio.shadows, kind)
                if drawn.is_err() { return stop(move window, drawn.unwrap_err()) }
                match window.shadow_end() {
                    .Ok => {},
                    .Err(message) => { return stop(move window, message) },
                }
                continue
            }
            if !main_pass_open {
                match window.begin_scene(filtered) {
                    .Ok => { main_pass_open = true },
                    .Err(message) => { return stop(move window, message) },
                }
            }
            if kind == render.PassKind.Sky {
                match window.sky(&inv_view_projection.m, &frame_sky.sun, &frame_sky.zenith, &frame_sky.horizon) {
                    .Ok => {},
                    .Err(message) => { return stop(move window, message) },
                }
            } else if kind == render.PassKind.Opaque || kind == render.PassKind.Transparent {
                drawn := if kind == .Opaque {
                    record_list(&mut window, &geometry.meshes, &geometry.solids, &cube_vertices, &plane_vertices, &sphere_vertices, view_projection, view_camera.position, &frame_sky, studio.shadows, kind)
                } else {
                    record_list(&mut window, &geometry.meshes, &geometry.glass, &cube_vertices, &plane_vertices, &sphere_vertices, view_projection, view_camera.position, &frame_sky, false, kind)
                }
                if drawn.is_err() { return stop(move window, drawn.unwrap_err()) }
            } else if kind == render.PassKind.PostProcess {
                match window.post_process(&finish) {
                    .Ok => {},
                    .Err(message) => { return stop(move window, message) },
                }
            } else if kind == render.PassKind.Ui {
                canvas.clear()
                mouse := frame.input.mouse
                pointer := widgets.Pointer::at(mouse.x, mouse.y, frame.input.button_hit(gfx.MOUSE_LEFT), frame.input.button_down(gfx.MOUSE_LEFT))
                if playing {
                    if session.scene.theme == .Blossom {
                        action = play_ui.woodland(&mut hud, &mut canvas, &atlas, &pointer, f32(frame.width), f32(frame.height),
                            session.scene.name, session.flowers, session.total_flowers, session.butterflies, session.total_butterflies, paused, session.won)
                    } else {
                        action = play_ui.draw(&mut hud, &mut canvas, &atlas, &pointer, f32(frame.width), f32(frame.height),
                        session.scene.name, session.tick, paused, session.player >= 0, game_view.has_goal, session.won)
                    }
                    if scene_file.failed(&watcher) { play_ui.reload_error(&mut canvas, &atlas, f32(frame.width)) }
                } else {
                    editor.draw(&mut studio, &mut canvas, &atlas, &mut graph, &pointer, mouse.scroll,
                        f32(frame.width), f32(frame.height), fps, plan.steps.len, device, score, total)
                }
                quads := canvas.take()
                match window.ui_draw(quads, [f32(frame.width), f32(frame.height)]) {
                    .Ok => {},
                    .Err(message) => { return stop(move window, message) },
                }
            }
        }
        ended := window.end()
        if ended.is_err() {
            return stop(move window, ended.unwrap_err())
        }
        frames = ended.unwrap()
        if capturing {
            match window.save_capture(shot) {
                .Ok => { if !exporting { _ := sys.eprint("storm: wrote " + shot) } },
                .Err(message) => { return stop(move window, message) },
            }
            running = false
            continue
        }
        if limit > 0 && frames >= limit { running = false }
    }
    window.close()
    if !exporting { print("storm frames=" + frames.str()) }
    .Ok
}
