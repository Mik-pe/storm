import core
import gfx
import input
import play
import scene
import runtime
import runtime.args as args
import runtime.controls as controls
import runtime.watch as watch
import text
import ui
import .play_view

pub struct Game {
    session: play.Session, view: play_view.View, watcher: watch.Watch,
}

pub fn project(move session: play.Session, move watcher: watch.Watch) -> Result<Game, string> {
    view := play_view.build(&session)
    .Ok(Game { session: move session, view: move view, watcher: move watcher })
}

pub fn load(argv: &[]string) -> Result<Game, string> {
    path := args.value(argv, "--scene")
    if args.flag(argv, "--scene") && path.len == 0 { return .Err("--scene requires a scene file") }
    if args.flag(argv, "--capture") && args.value(argv, "--capture").len == 0 { return .Err("--capture requires an output file") }
    watching := args.flag(argv, "--watch")
    if watching && path.len == 0 { return .Err("--watch requires --scene FILE") }
    source := if path.len > 0 { play.read_source(path)? } else { "" }
    level := if path.len > 0 { play.decode(source)? } else { play.demo() }
    project(play.start(&level), watch.new(if watching { path } else { "" }, source))
}

impl runtime.Project for Game {
    fn graph(&self) -> &scene.Graph from self { &self.view.graph }
    fn sphere_geometry(&self) -> []f32 { play_view.sphere_geometry(&self.session.scene) }
    fn labels(&self) -> []string {
        mut labels: []string = [self.session.scene.name.clone()]
        for item in self.session.scene.entities { labels.push(item.name.clone()) }
        labels
    }
    fn reload(&mut self, now: f64) -> Result<bool, string> {
        if self.watcher.path.len == 0 { return .Ok(false) }
        match watch.poll(&mut self.watcher, now, play.read_source, play.decode)? {
            .Some(level) => {
                session := play.start(&level)
                view := play_view.build(&session)
                self.session = move session
                self.view = move view
                .Ok(true)
            },
            .None => .Ok(false),
        }
    }
    fn restart(&mut self) {
        self.session = play.start(&self.session.scene)
    }
    fn update(&mut self, frame: &gfx.Frame, dt: f64, tick: runtime.Tick, paused: bool, capturing: bool,
        camera: input.Camera, custom_eye: bool, sky: &mut gfx.Sky) -> input.Camera {
        aspect := f32(frame.width) / f32(frame.height)
        _ := dt
        input := play_view.controls(&frame.input)
        match tick {
            .Step => play.step(&mut self.session, input),
            .Advance(seconds) => { _ := play.advance(&mut self.session, seconds, input) },
            .None => {},
        }
        play_view.sync(&mut self.view, &self.session, paused || capturing)
        area := play_view.framing(&self.view, &self.session, paused || capturing)
        sun := core.vec3(sky.sun[0], sky.sun[1], sky.sun[2])
        radius := 4.0 + core.length(area.extent)
        sky.light_vp = runtime.shadow_view(sun, area.center, radius).m
        sky.light_dir_c = [sun.x, sun.y, sun.z, core.dot(area.center, sun) + radius * 1.6]
        if custom_eye { camera } else { play_view.camera(&area, aspect) }
    }
    fn draw_hud(&mut self, hud: &mut controls.Hud, canvas: &mut ui.Canvas, atlas: &text.Atlas, frame: &controls.Frame) -> controls.Action {
        action := controls.draw_view(&mut hud.interaction, &mut canvas, atlas, frame, &controls.Playbar {
            title: self.session.scene.name.clone(), tick: self.session.tick, has_player: self.session.player >= 0,
            has_goal: self.view.has_goal, won: self.session.won,
        })
        if watch.failed(&self.watcher) { controls.reload_error(&mut canvas, atlas, frame.width) }
        action
    }
}
