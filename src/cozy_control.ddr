// Cozy player ergonomics: ray-picked petting, click-to-walk on ground and clouds,
// flower sniffing, jump buffering, camera presets & orbit/zoom, Vägvisare compass,
// optional Strosa stroll mode, zone discovery, and Swedish whisper toasts.
import core
import gfx
import input
import play
import std.math as math

const STROLL_SPEED: f32 = 0.46
const JUMP_BUFFER_SECONDS: f32 = 0.12
const FOX_PET_RADIUS: f32 = 0.68
const FOX_PET_OFFSET_Y: f32 = 0.18
const ARRIVE_RADIUS: f32 = 0.18
const SNIFF_ARRIVE_RADIUS: f32 = 0.06
const TAPER_RADIUS: f32 = 1.1
const SNIFF_DISTANCE: f32 = 0.95
const FLOWER_RAY_RADIUS: f32 = 0.65
const FLOWER_XZ_RADIUS: f32 = 1.25
const ORBIT_SENSITIVITY: f32 = 0.0055
const ZOOM_STEP: f32 = 0.07
const MIN_ZOOM: f32 = 0.62
const MAX_ZOOM: f32 = 1.38
const CAM_DAMP_RATE: f32 = 12.0
const TOAST_SECONDS: f32 = 2.6
const TOAST_FADE: f32 = 0.45

pub enum CameraMode { Close, Normal, Explore }
pub enum SkyMood { CherryDay, GoldenHour, Twilight }

pub struct GuideVisual { active: bool, target: core.Vec3, age: f32 }

pub struct CompassHint {
    active: bool,
    is_butterfly: bool,
    above: bool,
    below: bool,
    text: string,
    angle: f32,
}

pub struct CozyControl {
    has_target: bool,
    target: core.Vec3,
    target_age: f32,
    dragging_walk: bool,
    has_face: bool,
    face_target: core.Vec3,
    jump_buffer: f32,
    yaw: f32,
    target_yaw: f32,
    zoom: f32,
    target_zoom: f32,
    camera_mode: CameraMode,
    cam_preset_t: f32,
    mood: SkyMood,
    compass_on: bool,
    stroll_mode: bool,
    options_open: bool,
    hovering_fox: bool,
    toast_text: string,
    toast_timer: f32,
    toast_duration: f32,
    last_flowers: i32,
    last_butterflies: i32,
    last_won: bool,
    last_pet_tick: i64,
    last_emote_tick: i64,
    pet_count: i32,
    emote_count: i32,
    last_sitting: bool,
    last_snoozing: bool,
    last_cloud: i32,
    visited_zones: u32,
}

fn clamp(value: f32, lo: f32, hi: f32) -> f32 {
    if value < lo { return lo }
    if value > hi { return hi }
    value
}

pub fn camera_preset_value(mode: CameraMode) -> f32 {
    match mode {
        .Close => 0.0,
        .Normal => 1.0,
        .Explore => 2.0,
    }
}

pub fn new() -> CozyControl {
    zero := core.vec3(0.0, 0.0, 0.0)
    CozyControl {
        has_target: false, target: zero, target_age: 0.0, dragging_walk: false,
        has_face: false, face_target: zero, jump_buffer: 0.0,
        yaw: 0.0, target_yaw: 0.0, zoom: 1.0, target_zoom: 1.0,
        camera_mode: .Normal, cam_preset_t: 1.0,
        mood: .CherryDay, compass_on: false, stroll_mode: false, options_open: false,
        hovering_fox: false,
        toast_text: "", toast_timer: 0.0, toast_duration: 0.0,
        last_flowers: 0, last_butterflies: 0, last_won: false,
        last_pet_tick: -1, last_emote_tick: -1, pet_count: 0, emote_count: 0,
        last_sitting: false, last_snoozing: false, last_cloud: -1,
        visited_zones: 0,
    }
}

pub fn reset(c: &mut CozyControl, session: &play.Session) {
    c.has_target = false
    c.target = core.vec3(0.0, 0.0, 0.0)
    c.target_age = 0.0
    c.dragging_walk = false
    c.has_face = false
    c.face_target = core.vec3(0.0, 0.0, 0.0)
    c.jump_buffer = 0.0
    c.hovering_fox = false
    c.options_open = false
    c.toast_text = ""
    c.toast_timer = 0.0
    c.toast_duration = 0.0
    c.last_flowers = session.flowers
    c.last_butterflies = session.butterflies
    c.last_won = session.won
    c.last_pet_tick = session.pet_tick
    c.last_emote_tick = session.emote_tick
    c.pet_count = 0
    c.emote_count = 0
    c.last_sitting = session.cozy_sitting
    c.last_snoozing = false
    c.last_cloud = session.last_cloud
    c.visited_zones = 0
    if session.player >= 0 {
        start_zone := zone_at(session, session.bodies[session.player].position)
        if start_zone >= 0 { c.visited_zones = u32(1).shl(start_zone) }
    }
}

pub fn reset_camera(c: &mut CozyControl) {
    c.target_yaw = 0.0
    c.target_zoom = 1.0
    c.camera_mode = .Normal
}

pub fn cam_adjusted(c: &CozyControl) -> bool {
    c.target_yaw.abs() > 0.01 || (c.target_zoom - 1.0).abs() > 0.01 || c.camera_mode != .Normal
}

pub fn set_camera_mode(c: &mut CozyControl, mode: CameraMode) {
    c.camera_mode = mode
    c.target_zoom = 1.0
    label := match mode {
        .Close => "Kamera: Nära – se Vallmo på nära håll",
        .Normal => "Kamera: Normal",
        .Explore => "Kamera: Utforska – bred utsikt över skogen",
    }
    show_toast(&mut c, label, TOAST_SECONDS - 0.3)
}

pub fn cycle_camera_mode(c: &mut CozyControl) {
    next := match c.camera_mode {
        .Close => CameraMode.Normal,
        .Normal => CameraMode.Explore,
        .Explore => CameraMode.Close,
    }
    set_camera_mode(&mut c, next)
}

pub fn set_mood(c: &mut CozyControl, mood: SkyMood) {
    c.mood = mood
    label := match mood {
        .CherryDay => "Stämning: Körsbärsdag",
        .GoldenHour => "Stämning: Gyllene timmen",
        .Twilight => "Stämning: Skymningsmys",
    }
    show_toast(&mut c, label, TOAST_SECONDS - 0.2)
}

pub fn cycle_mood(c: &mut CozyControl) {
    next := match c.mood {
        .CherryDay => SkyMood.GoldenHour,
        .GoldenHour => SkyMood.Twilight,
        .Twilight => SkyMood.CherryDay,
    }
    set_mood(&mut c, next)
}

pub fn toggle_compass(c: &mut CozyControl) {
    c.compass_on = !c.compass_on
    msg := if c.compass_on { "Vägvisare på – pekar mot närmaste mål" } else { "Vägvisare av" }
    show_toast(&mut c, msg, TOAST_SECONDS - 0.3)
}

pub fn toggle_stroll(c: &mut CozyControl) {
    c.stroll_mode = !c.stroll_mode
    msg := if c.stroll_mode { "Strosa-läge på – lugna små steg" } else { "Strosa-läge av – vanligt tempo" }
    show_toast(&mut c, msg, TOAST_SECONDS - 0.3)
}

pub fn toggle_options(c: &mut CozyControl) {
    c.options_open = !c.options_open
}

pub fn guide(c: &CozyControl) -> GuideVisual {
    GuideVisual { active: c.has_target, target: c.target, age: c.target_age }
}

pub fn show_toast(c: &mut CozyControl, text: string, duration: f32) {
    if text.len == 0 || duration <= 0.0 { return }
    c.toast_text = text.clone()
    c.toast_duration = duration
    c.toast_timer = duration
}

pub fn toast_alpha(c: &CozyControl) -> f32 {
    if c.toast_text.len == 0 || c.toast_timer <= 0.0 || c.toast_duration <= 0.0 { return 0.0 }
    clamp(c.toast_timer / TOAST_FADE, 0.0, 1.0)
}

struct ZoneDef { name: string, x: f32, z: f32, min_y: f32, max_y: f32, radius: f32 }

fn woodland_zones() -> [ZoneDef; 10] {
    [
        ZoneDef { name: "Körsbärsgläntan", x: 0.0, z: 2.0, min_y: -1.0, max_y: 2.0, radius: 3.1 },
        ZoneDef { name: "Picknickgläntan", x: -8.4, z: 5.2, min_y: -1.0, max_y: 2.0, radius: 3.7 },
        ZoneDef { name: "Svampdungen", x: -9.2, z: -2.8, min_y: -1.0, max_y: 2.2, radius: 3.7 },
        ZoneDef { name: "Bäckbron", x: 0.0, z: -4.8, min_y: -1.0, max_y: 1.8, radius: 2.1 },
        ZoneDef { name: "Lyktängen", x: 0.0, z: -9.1, min_y: -1.0, max_y: 2.2, radius: 3.3 },
        ZoneDef { name: "Bärgläntan", x: 8.8, z: -1.8, min_y: -1.0, max_y: 2.2, radius: 3.1 },
        ZoneDef { name: "Solkullen", x: 8.6, z: 4.6, min_y: -1.0, max_y: 2.2, radius: 3.1 },
        ZoneDef { name: "Södra Klöverängen", x: 0.0, z: 8.0, min_y: -1.0, max_y: 2.0, radius: 2.8 },
        ZoneDef { name: "Kronbalkongen", x: 0.0, z: -5.8, min_y: 4.2, max_y: 6.1, radius: 3.2 },
        ZoneDef { name: "Stjärngläntan", x: -0.6, z: -9.4, min_y: 6.0, max_y: 10.0, radius: 3.2 },
    ]
}

fn is_expanded_woodland(session: &play.Session) -> bool {
    if session.scene.theme != .Blossom { return false }
    match session.scene.bounds {
        .Some(b) => (b.max_x - b.min_x) >= 16.0 && (b.max_z - b.min_z) >= 14.0,
        .None => false,
    }
}

pub fn zone_at(session: &play.Session, pos: core.Vec3) -> i32 {
    if !is_expanded_woodland(session) { return -1 }
    zones := woodland_zones()
    for i in 0..zones.len {
        z := &zones[i]
        if pos.y < z.min_y || pos.y > z.max_y { continue }
        dx := pos.x - z.x
        dz := pos.z - z.z
        if dx * dx + dz * dz <= z.radius * z.radius { return i }
    }
    -1
}

pub fn zone_name(index: i32) -> string {
    zones := woodland_zones()
    if index < 0 || index >= zones.len { return "" }
    zones[index].name.clone()
}

fn zone_toast(index: i32) -> string {
    if index == 8 { return "Välkommen till Kronbalkongen!" }
    if index == 9 { return "Hittade hemliga Stjärngläntan!" }
    name := zone_name(index)
    if name.len == 0 { return "" }
    "Upptäckte " + name + "!"
}

fn compass_direction_sv(dx: f32, dz: f32) -> string {
    // World -Z is North, +X is East.
    ang := f32(math.atan2(f64(dx), f64(-dz)))
    pi: f32 = 3.14159265
    sector := ang / (pi / 4.0)
    if sector >= -0.5 && sector < 0.5 { return "Norr" }
    if sector >= 0.5 && sector < 1.5 { return "Nordost" }
    if sector >= 1.5 && sector < 2.5 { return "Öster" }
    if sector >= 2.5 && sector < 3.5 { return "Sydost" }
    if sector >= -1.5 && sector < -0.5 { return "Nordväst" }
    if sector >= -2.5 && sector < -1.5 { return "Väster" }
    if sector >= -3.5 && sector < -2.5 { return "Sydväst" }
    "Söder"
}

pub fn compass_hint(session: &play.Session, yaw: f32) -> CompassHint {
    empty := CompassHint { active: false, is_butterfly: false, above: false, below: false, text: "", angle: 0.0 }
    if session.player < 0 { return empty }
    player := session.bodies[session.player].position

    mut best_flower := -1
    mut best_flower_d2: f32 = 1.0e20
    mut best_fly := -1
    mut best_fly_d2: f32 = 1.0e20
    for i in 0..session.scene.entities.len {
        if session.collected[i] { continue }
        item := &session.scene.entities[i]
        v := core.sub(item.position, player)
        d2 := core.dot(v, v)
        if item.role == .Flower {
            if best_flower < 0 || d2 < best_flower_d2 {
                best_flower = i
                best_flower_d2 = d2
            }
        } else if item.role == .SuperButterfly {
            if best_fly < 0 || d2 < best_fly_d2 {
                best_fly = i
                best_fly_d2 = d2
            }
        }
    }

    if best_flower < 0 && best_fly < 0 {
        return CompassHint {
            active: true, is_butterfly: false, above: false, below: false,
            text: "Allt i Blomsterskogen hittat!", angle: 0.0,
        }
    }

    // Prefer nearby sky butterflies when Vallmo is already up in the clouds,
    // otherwise guide to flowers first and then to the sky butterflies.
    choose_fly := best_flower < 0 || (best_fly >= 0 && player.y > 1.3 && best_fly_d2 < best_flower_d2)
    idx := if choose_fly { best_fly } else { best_flower }
    target := &session.scene.entities[idx]
    dx := target.position.x - player.x
    dy := target.position.y - player.y
    dz := target.position.z - player.z
    horiz := (dx * dx + dz * dz).sqrt()
    world_angle := f32(math.atan2(f64(dx), f64(-dz)))
    rel_angle := world_angle - yaw
    above := dy > 1.35
    below := dy < -1.35
    dir := compass_direction_sv(dx, dz)
    meters := i32(horiz + 0.5)

    text := if above && horiz < 2.4 {
        if choose_fly { "Superfjäril " + target.name + " ovanför dig" }
        else { "Närmast: " + target.name + " · ovanför dig" }
    } else if below && horiz < 2.4 {
        "Närmast: " + target.name + " · nedanför dig"
    } else if above {
        prefix := if choose_fly { "Superfjäril: " } else { "Närmast: " }
        prefix + target.name + " · " + dir + " (högre)"
    } else if horiz < 1.8 {
        "Närmast: " + target.name + " · alldeles nära!"
    } else {
        prefix := if choose_fly { "Superfjäril: " } else { "Närmast: " }
        prefix + target.name + " · " + dir + " (" + meters.str() + " m)"
    }

    CompassHint {
        active: true,
        is_butterfly: choose_fly,
        above: above,
        below: below,
        text: text,
        angle: rel_angle,
    }
}

// Reconstruct a world-space ray matching core.perspective() where screen y=0 is top.
pub fn pick_ray(cam: &input.Camera, aspect: f32, width: f32, height: f32, mx: f32, my: f32) -> core.Vec3 {
    forward := cam.forward()
    if width <= 0.0 || height <= 0.0 { return forward }
    safe_aspect := if aspect > 0.0 { aspect } else { width / height }
    nx := 2.0 * mx / width - 1.0
    ny := 1.0 - 2.0 * my / height
    tan_half := (cam.fov * 0.5).tan()
    right := cam.right()
    up := core.cross(right, forward)
    core.normalize(core.add(forward, core.add(core.scale(right, nx * safe_aspect * tan_half), core.scale(up, ny * tan_half))))
}

pub fn ray_sphere(origin: core.Vec3, dir: core.Vec3, center: core.Vec3, radius: f32) -> bool {
    if radius <= 0.0 { return false }
    oc := core.sub(origin, center)
    b := core.dot(oc, dir)
    c := core.dot(oc, oc) - radius * radius
    disc := b * b - c
    disc >= 0.0 && (-b + disc.sqrt()) >= 0.0
}

pub fn ray_plane_y(origin: core.Vec3, dir: core.Vec3, plane_y: f32) -> Option<core.Vec3> {
    if dir.y.abs() <= 0.001 { return .None }
    t := (plane_y - origin.y) / dir.y
    if t <= 0.0 || t > 160.0 { return .None }
    .Some(core.add(origin, core.scale(dir, t)))
}

// Ray-pick elevated cloud top surfaces first, then fall back to the active support plane.
pub fn pick_walk_surface(session: &play.Session, origin: core.Vec3, dir: core.Vec3, player_support_y: f32) -> Option<core.Vec3> {
    mut best_t: f32 = 1.0e20
    mut best_hit := core.vec3(0.0, 0.0, 0.0)
    mut found_cloud := false
    if dir.y.abs() > 0.001 {
        for i in 0..session.scene.entities.len {
            item := &session.scene.entities[i]
            if item.role != .Cloud && item.role != .BoostCloud { continue }
            top_y := item.position.y + item.size.y * 0.5
            t := (top_y - origin.y) / dir.y
            if t <= 0.0 || t > 160.0 || t >= best_t { continue }
            hit := core.add(origin, core.scale(dir, t))
            hx := item.size.x * 0.5 + 0.10
            hz := item.size.z * 0.5 + 0.10
            if (hit.x - item.position.x).abs() <= hx && (hit.z - item.position.z).abs() <= hz {
                best_t = t
                best_hit = core.vec3(hit.x, top_y, hit.z)
                found_cloud = true
            }
        }
    }
    if found_cloud { return .Some(best_hit) }
    ray_plane_y(origin, dir, player_support_y)
}

fn clamp_to_bounds(point: core.Vec3, bounds: &Option<play.Bounds>) -> core.Vec3 {
    match bounds {
        .Some(b) => core.vec3(clamp(point.x, b.min_x, b.max_x), point.y, clamp(point.z, b.min_z, b.max_z)),
        .None => point,
    }
}

fn nearest_uncollected_flower(session: &play.Session, origin: core.Vec3, dir: core.Vec3,
    hit: core.Vec3, support_y: f32) -> Option<core.Vec3> {
    mut best_index := -1
    mut best_score: f32 = 1.0e20
    for i in 0..session.scene.entities.len {
        item := &session.scene.entities[i]
        if item.role != .Flower || session.collected[i] { continue }
        if (item.position.y - support_y).abs() > 1.4 { continue }
        dx := hit.x - item.position.x
        dz := hit.z - item.position.z
        xz_sq := dx * dx + dz * dz
        on_bloom := ray_sphere(origin, dir, item.position, FLOWER_RAY_RADIUS)
        if !on_bloom && xz_sq > FLOWER_XZ_RADIUS * FLOWER_XZ_RADIUS { continue }
        score := if on_bloom { xz_sq * 0.25 } else { xz_sq }
        if best_index < 0 || score < best_score {
            best_index = i
            best_score = score
        }
    }
    if best_index < 0 { return .None }
    .Some(session.scene.entities[best_index].position)
}

fn sniff_point(player_pos: core.Vec3, flower_pos: core.Vec3, support_y: f32, bounds: &Option<play.Bounds>) -> core.Vec3 {
    dx := player_pos.x - flower_pos.x
    dz := player_pos.z - flower_pos.z
    dist := (dx * dx + dz * dz).sqrt()
    nx := if dist > 0.001 { dx / dist } else { f32(0.0) }
    nz := if dist > 0.001 { dz / dist } else { f32(1.0) }
    clamp_to_bounds(core.vec3(flower_pos.x + nx * SNIFF_DISTANCE, support_y, flower_pos.z + nz * SNIFF_DISTANCE), bounds)
}

fn flower_toast(session: &play.Session) -> string {
    count := session.flowers
    total := session.total_flowers
    name := if session.last_flower >= 0 && session.last_flower < session.scene.entities.len {
        session.scene.entities[session.last_flower].name.clone()
    } else { "" }
    if count == 1 {
        return if name.len > 0 { "Första blomman: " + name + "!" } else { "Första blomman i buketten!" }
    }
    if total > 2 && count == total - 1 {
        return if name.len > 0 { name + "! Bara en blomma kvar!" } else { "Snart är hela buketten klar!" }
    }
    if total >= 6 && count == total / 2 {
        return if name.len > 0 { "Halvvägs! " + name + " doftar ljuvligt!" } else { "Halvvägs till en full bukett!" }
    }
    if name.len > 0 {
        if count % 3 == 0 { return name + " doftar sommar!" }
        if count % 3 == 1 { return "Fin " + name + " plockad!" }
        return name + " i buketten!"
    }
    "En ny blomma plockad!"
}

fn butterfly_toast(session: &play.Session) -> string {
    butterflies := session.butterflies
    total := session.total_butterflies
    won := session.won
    name := if session.last_butterfly >= 0 && session.last_butterfly < session.scene.entities.len {
        session.scene.entities[session.last_butterfly].name.clone()
    } else { "" }
    if won && butterflies >= total { return "Hela Blomsterskogen firar med dig!" }
    if butterflies >= total { return "Alla superfjärilar hittade!" }
    if name.len > 0 {
        if butterflies == 1 { return "Superfjärilen " + name + " svävar med!" }
        return "Hittade " + name + " bland molnen!"
    }
    if butterflies == 1 { return "En gyllene superfjäril!" }
    "Ännu en fjäril svävar med!"
}

fn pet_toast(count: i32) -> string {
    if count % 3 == 0 { return "Vallmo myser av klappen!" }
    if count % 3 == 1 { return "Mjuk liten räv spinner nöjt!" }
    "Vallmo vickar glatt på öronen!"
}

fn emote_toast(count: i32) -> string {
    if count % 3 == 0 { return "Vallmo gör ett lekfullt rävskutt!" }
    if count % 3 == 1 { return "Vallmo snurrar glatt med fluffig svans!" }
    "Vallmo viftar glatt och hälsar!"
}

pub fn sync_toasts(c: &mut CozyControl, session: &play.Session) {
    if session.flowers < c.last_flowers || session.butterflies < c.last_butterflies || (!session.won && c.last_won) {
        reset(&mut c, session)
        return
    }
    cozy := play.render_cozy(session, true)
    motion := play.render_motion(session, true)
    rest := play.render_rest(session, true)
    snoozing := (cozy.sitting && cozy.sit_age >= 4.5) || (motion.grounded && motion.run_weight < 0.1 && rest.age >= 14.0)

    mut new_zone := -1
    if session.player >= 0 {
        z := zone_at(session, session.bodies[session.player].position)
        if z >= 0 {
            bit := u32(1).shl(z)
            if c.visited_zones.bit_and(bit) == 0 {
                c.visited_zones = c.visited_zones.bit_or(bit)
                new_zone = z
            }
        }
    }

    if session.won && !c.last_won {
        msg := if session.total_butterflies > 0 && session.butterflies < session.total_butterflies {
            "Buketten är klar! Fjärilar väntar i kronorna."
        } else { "Hela buketten blommar! Så mysigt!" }
        show_toast(&mut c, msg, TOAST_SECONDS + 0.6)
    } else if session.butterflies > c.last_butterflies {
        show_toast(&mut c, butterfly_toast(session), TOAST_SECONDS)
    } else if session.flowers > c.last_flowers {
        show_toast(&mut c, flower_toast(session), TOAST_SECONDS)
    } else if session.pet_tick != c.last_pet_tick && session.pet_tick >= 0 {
        show_toast(&mut c, pet_toast(c.pet_count), TOAST_SECONDS)
        c.pet_count += 1
    } else if session.emote_tick != c.last_emote_tick && session.emote_tick >= 0 {
        show_toast(&mut c, emote_toast(c.emote_count), TOAST_SECONDS)
        c.emote_count += 1
    } else if snoozing && !c.last_snoozing {
        show_toast(&mut c, "Vallmo slumrar sött i skogen...", TOAST_SECONDS)
    } else if session.cozy_sitting && !c.last_sitting {
        show_toast(&mut c, "Vallmo kurar ihop sig i gräset", TOAST_SECONDS)
    } else if new_zone >= 0 {
        show_toast(&mut c, zone_toast(new_zone), TOAST_SECONDS)
    } else if session.last_cloud != c.last_cloud && session.last_cloud >= 0 && session.last_cloud < session.scene.entities.len {
        if session.scene.entities[session.last_cloud].role == .BoostCloud {
            show_toast(&mut c, "Studs upp bland molntopparna!", TOAST_SECONDS)
        }
    }
    c.last_flowers = session.flowers
    c.last_butterflies = session.butterflies
    c.last_won = session.won
    c.last_pet_tick = session.pet_tick
    c.last_emote_tick = session.emote_tick
    c.last_sitting = session.cozy_sitting
    c.last_snoozing = snoozing
    c.last_cloud = session.last_cloud
}

fn clear_walk(c: &mut CozyControl) {
    c.has_target = false
    c.dragging_walk = false
    c.has_face = false
}

fn damp_camera(c: &mut CozyControl, dt: f32, frame_input: &gfx.Input, ui_captured: bool) {
    if !ui_captured {
        if frame_input.button_down(gfx.Button.Right) {
            c.target_yaw += frame_input.mouse.dx * ORBIT_SENSITIVITY
        }
        if frame_input.mouse.scroll != 0.0 {
            c.target_zoom = clamp(c.target_zoom - frame_input.mouse.scroll * ZOOM_STEP, MIN_ZOOM, MAX_ZOOM)
        }
        if frame_input.button_hit(gfx.Button.Middle) {
            reset_camera(&mut c)
        }
    }
    target_preset := camera_preset_value(c.camera_mode)
    if dt > 0.0 {
        alpha := f32(1.0 - math.exp(f64(-CAM_DAMP_RATE * dt)))
        c.yaw += (c.target_yaw - c.yaw) * alpha
        c.zoom += (c.target_zoom - c.zoom) * alpha
        c.cam_preset_t += (target_preset - c.cam_preset_t) * alpha
    }
}

fn keyboard_move(frame_input: &gfx.Input, yaw: f32, stroll_toggle: bool) -> Option<(f32, f32)> {
    mut kx: f32 = 0.0
    mut kz: f32 = 0.0
    if frame_input.down(.A) || frame_input.down(.Left) { kx -= 1.0 }
    if frame_input.down(.D) || frame_input.down(.Right) { kx += 1.0 }
    if frame_input.down(.W) || frame_input.down(.Up) { kz -= 1.0 }
    if frame_input.down(.S) || frame_input.down(.Down) { kz += 1.0 }
    if kx == 0.0 && kz == 0.0 { return .None }
    stroll := stroll_toggle || frame_input.down(.Shift)
    if yaw == 0.0 && !stroll { return .Some((kx, kz)) }
    len := (kx * kx + kz * kz).sqrt()
    if len > 1.0 { kx /= len; kz /= len }
    mut wx := kx
    mut wz := kz
    if yaw != 0.0 {
        cs := yaw.cos()
        sn := yaw.sin()
        wx = kx * cs - kz * sn
        wz = kx * sn + kz * cs
    }
    if stroll {
        wx *= STROLL_SPEED
        wz *= STROLL_SPEED
    }
    .Some((wx, wz))
}

fn follow_target(c: &mut CozyControl, session: &play.Session, player_pos: core.Vec3, stroll: bool) -> (f32, f32) {
    if c.has_target {
        dx := c.target.x - player_pos.x
        dz := c.target.z - player_pos.z
        dist := (dx * dx + dz * dz).sqrt()
        arrive := if c.has_face { SNIFF_ARRIVE_RADIUS } else { ARRIVE_RADIUS }
        if dist <= arrive {
            c.has_target = false
        } else {
            u := clamp((dist - arrive) / (TAPER_RADIUS - arrive), 0.0, 1.0)
            taper := STROLL_SPEED + (1.0 - STROLL_SPEED) * u
            mut speed := if stroll { STROLL_SPEED } else { taper }
            if c.has_face && dist < ARRIVE_RADIUS { speed = 0.30 }
            return ((dx / dist) * speed, (dz / dist) * speed)
        }
    }
    if c.has_face {
        fx := c.face_target.x - player_pos.x
        fz := c.face_target.z - player_pos.z
        flen := (fx * fx + fz * fz).sqrt()
        if flen > 0.001 {
            nx := fx / flen
            nz := fz / flen
            hx := session.motion.heading.sin()
            hz := session.motion.heading.cos()
            if hx * nx + hz * nz < 0.992 { return (nx * 0.005, nz * 0.005) }
        }
        c.has_face = false
    }
    (0.0, 0.0)
}

pub fn update(c: &mut CozyControl, session: &mut play.Session, cam: &input.Camera,
    aspect: f32, width: f32, height: f32, dt: f32, frame_input: &gfx.Input,
    player_support_y: f32, ui_captured: bool) -> play.Input {
    safe_dt := if dt.is_finite() && dt > 0.0 { dt } else { f32(0.0) }
    if c.toast_timer > 0.0 {
        c.toast_timer -= safe_dt
        if c.toast_timer <= 0.0 {
            c.toast_timer = 0.0
            c.toast_text = ""
        }
    }
    if c.jump_buffer > 0.0 {
        c.jump_buffer -= safe_dt
        if c.jump_buffer < 0.0 { c.jump_buffer = 0.0 }
    }
    if c.has_target { c.target_age += safe_dt }

    // Cancel any active walk target if sitting was activated externally (e.g. HUD button).
    if session.cozy_sitting && !c.last_sitting { clear_walk(&mut c) }

    damp_camera(&mut c, safe_dt, frame_input, ui_captured)

    has_player := session.player >= 0
    player_pos := if has_player { session.bodies[session.player].position } else { core.vec3(0.0, 0.0, 0.0) }
    grounded := has_player && session.bodies[session.player].grounded

    ray := pick_ray(cam, aspect, width, height, frame_input.mouse.x, frame_input.mouse.y)
    fox_center := core.add(player_pos, core.vec3(0.0, FOX_PET_OFFSET_Y, 0.0))
    c.hovering_fox = !ui_captured && has_player && ray_sphere(cam.position, ray, fox_center, FOX_PET_RADIUS)

    left_hit := frame_input.button_hit(gfx.Button.Left)
    left_down := frame_input.button_down(gfx.Button.Left)
    if !left_down { c.dragging_walk = false }

    mut petted := false
    if left_hit && !ui_captured && c.hovering_fox {
        play.pet(&mut session)
        clear_walk(&mut c)
        petted = true
    }

    if has_player && !ui_captured && !petted && (left_hit || (left_down && c.dragging_walk)) {
        match pick_walk_surface(session, cam.position, ray, player_support_y) {
            .Some(hit) => {
                mut dest := clamp_to_bounds(hit, &session.scene.bounds)
                dest.y = hit.y
                mut face := core.vec3(0.0, 0.0, 0.0)
                mut set_face := false
                if frame_input.down(.Shift) {
                    match nearest_uncollected_flower(session, cam.position, ray, hit, hit.y) {
                        .Some(flower_pos) => {
                            dest = sniff_point(player_pos, flower_pos, hit.y, &session.scene.bounds)
                            face = flower_pos
                            set_face = true
                        },
                        .None => {},
                    }
                }
                if left_hit || !c.has_target { c.target_age = 0.0 }
                c.has_target = true
                c.target = dest
                c.has_face = set_face
                c.face_target = face
                if left_hit { c.dragging_walk = true }
            },
            .None => {},
        }
    }

    if frame_input.hit(.C) {
        play.toggle_sit(&mut session)
        if session.cozy_sitting { clear_walk(&mut c) }
    }
    if frame_input.hit(.F) { play.emote(&mut session) }
    if frame_input.hit(.T) { cycle_mood(&mut c) }
    if frame_input.hit(.G) { toggle_compass(&mut c) }
    if frame_input.hit(.Space) { c.jump_buffer = JUMP_BUFFER_SECONDS }

    mut jump := false
    if c.jump_buffer > 0.0 && grounded {
        jump = true
        c.jump_buffer = 0.0
    }

    sync_toasts(&mut c, session)

    stroll_now := c.stroll_mode || frame_input.down(.Shift)
    match keyboard_move(frame_input, c.yaw, c.stroll_mode) {
        .Some(move_xz) => {
            clear_walk(&mut c)
            (wx, wz) := move_xz
            return play.Input { x: wx, z: wz, jump: jump }
        },
        .None => {},
    }

    if has_player && (c.has_target || c.has_face) {
        (wx, wz) := follow_target(&mut c, session, player_pos, stroll_now)
        return play.Input { x: wx, z: wz, jump: jump }
    }

    play.Input { x: 0.0, z: 0.0, jump: jump }
}
