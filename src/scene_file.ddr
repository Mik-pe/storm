// Watch the path, not an open file descriptor: agent saves can replace it atomically.
capability filesystem

import play

enum Failure { Clear, Content(string), Read(string) }

pub struct Watch { path: string, accepted: string, failure: Failure, next_check: f64 }

pub fn new(path: string, initial_text: string) -> Watch {
    Watch { path: path.clone(), accepted: initial_text.clone(), failure: .Clear, next_check: 0.0 }
}

pub fn failed(w: &Watch) -> bool {
    match w.failure { .Clear => false, _ => true }
}

pub fn poll(w: &mut Watch, now: f64) -> Result<Option<play.Scene>, string> {
    if !now.is_finite() || now < w.next_check { return .Ok(.None) }
    w.next_check = now + 0.5
    source := match play.read_source(w.path) {
        .Ok(text) => text,
        .Err(err) => {
            repeated := match w.failure { .Read(old) => old == err, _ => false }
            if repeated { return .Ok(.None) }
            w.failure = Failure.Read(err.clone())
            return .Err(err)
        },
    }
    if source == w.accepted {
        w.failure = .Clear
        return .Ok(.None)
    }
    repeated := match w.failure { .Content(old) => old == source, _ => false }
    if repeated { return .Ok(.None) }
    match play.decode(source) {
        .Ok(scene) => {
            w.accepted = source
            w.failure = .Clear
            .Ok(.Some(scene))
        },
        .Err(err) => {
            w.failure = Failure.Content(source)
            .Err("cannot reload scene '" + w.path + "': " + err)
        },
    }
}
