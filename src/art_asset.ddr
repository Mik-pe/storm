// The playable art travels in the executable on every platform.
import gltf
import gltf.nodes as nodes
import std.json as json
import .model

fn document(name: string) -> Result<gltf.Document, string> {
    data: []u8 = match name {
        "cloud" => @embed_bytes("assets/blomsterskogen/cloud.glb"),
        "boost_cloud" => @embed_bytes("assets/blomsterskogen/boost_cloud.glb"),
        "super_butterfly" => @embed_bytes("assets/blomsterskogen/super_butterfly.glb"),
        "fox" => @embed_bytes("assets/blomsterskogen/vallmo.glb"),
        "flower" => @embed_bytes("assets/blomsterskogen/flower.glb"),
        "glade" => @embed_bytes("assets/blomsterskogen/glade.glb"),
        "bee" => @embed_bytes("assets/blomsterskogen/bee.glb"),
        "butterfly" => @embed_bytes("assets/blomsterskogen/butterfly.glb"),
        _ => { return .Err("unknown art asset: " + name) },
    }
    doc := gltf.load_bytes(&data)
    if !doc.ok { return .Err(doc.error) }
    .Ok(move doc)
}

pub fn load(name: string) -> Result<gltf.Asset, string> {
    doc := document(name)?
    gltf.asset(&doc)
}

pub struct Rigged { art: gltf.Asset, rig: model.Rig }

pub fn load_rigged(name: string) -> Result<Rigged, string> {
    doc := document(name)?
    j := json.Doc::parse_text(doc.json_text.clone())
    selected := nodes.active_scene(&j)?
    extras := j.field(selected, "extras")
    mut rig := model.read_rig(&j, j.field(extras, "storm_rig"))?
    rig.skins = gltf.skin_bindings(&doc, &j)?
    .Ok(Rigged { art: gltf.asset_from_json(&doc, &j)?, rig: move rig })
}
