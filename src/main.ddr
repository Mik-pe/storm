// Storm — a game engine in Dunder.
//
// Demo scene: a sunlit sky, a ground plane, three metallic cubes orbiting a
// parent node and two glass panes. Every frame the render graph is rebuilt from
// what the scene actually contains, draws are sorted back to front and the
// transparent pass only exists when something transparent is visible.
//
//   dunder run                     interactive
//   dunder run -- --frames 60      render 60 frames and exit
//   dunder run -- --capture a.ppm  one headless frame to disk
capability stdio

import core
import input
import render
import scene as scenegraph
import std.parse as parse
import sys
import text
import ui
import vulkan

const FONT_PATH: string = "/usr/share/fonts/TTF/JetBrainsMonoNerdFont-Regular.ttf"
// Every character the editor draws has to be packed into the atlas.
const GLYPHS: string = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789 .,:;!?/-+()[]%&*#@=<>_|~ åäö ÅÄÖ ²³"

struct Material {
    base: core.Color,
    metallic: f32,
    roughness: f32,
    emissive: f32,
}

// One drawable: transform, material and which geometry to use. Opaque items
// rely on the depth buffer; only transparent items are sorted back to front.
struct Item {
    model: core.Mat4,
    material: Material,
    transparent: bool,
    plane: bool,
    depth: f32,
}

fn frame_limit() -> i64 {
    mut i := 1
    while i + 1 < sys.arg_count() {
        if sys.arg(i) == "--frames" {
            parsed := parse.integer(sys.arg(i + 1))
            if parsed.ok && parsed.value > 0 { return parsed.value }
        }
        i = i + 1
    }
    0
}

// --capture <path> renders one headless frame to a PPM.
fn capture_path() -> string {
    mut i := 1
    while i + 1 < sys.arg_count() {
        if sys.arg(i) == "--capture" { return sys.arg(i + 1) }
        i = i + 1
    }
    ""
}

fn trace_enabled() -> bool {
    mut i := 1
    while i < sys.arg_count() {
        if sys.arg(i) == "--trace" { return true }
        i = i + 1
    }
    false
}

fn flag(name: string) -> bool {
    mut i := 1
    while i < sys.arg_count() {
        if sys.arg(i) == name { return true }
        i = i + 1
    }
    false
}

// Squared distance from the eye to the model origin. Monotonic in distance, so
// it is enough to sort glass by and avoids a square root per pane.
fn depth_of(model: &core.Mat4, eye: core.Vec3) -> f32 {
    dx := model.m[12] - eye.x
    dy := model.m[13] - eye.y
    dz := model.m[14] - eye.z
    dx * dx + dy * dy + dz * dz
}

// Glass is blended, so it must be painted farthest first. Insertion sort is
// allocation-free and the pane list is tiny.
fn sort_back_to_front(items: &mut []Item) {
    mut i := 1
    while i < items.len {
        mut j := i
        while j > 0 && items[j - 1].depth < items[j].depth {
            held := items[j - 1].clone()
            items[j - 1] = items[j].clone()
            items[j] = held
            j = j - 1
        }
        i = i + 1
    }
}

fn draw_item(window: vulkan.Window, vertices: &[]f32, item: &Item, view_projection: core.Mat4,
    camera_position: core.Vec3, sky: &vulkan.Sky, shadows_on: bool) {
    mvp := core.multiply(view_projection, item.model)
    mut color: [f32; 4] = [item.material.base.r, item.material.base.g, item.material.base.b, item.material.base.a]
    mut shadow_flag: f32 = 0.0
    if shadows_on { shadow_flag = 1.0 }
    mut params: [f32; 4] = [item.material.metallic, item.material.roughness, item.material.emissive, shadow_flag]
    mut eye: [f32; 3] = [camera_position.x, camera_position.y, camera_position.z]
    if item.transparent {
        drawn := vulkan.mesh_blended(window, vertices, &mvp.m, &item.model.m, &color, &params, &eye, sky)
        if !drawn.ok { _ := sys.eprint("storm: " + drawn.error) }
    } else {
        drawn := vulkan.mesh(window, vertices, &mvp.m, &item.model.m, &color, &params, &eye, sky)
        if !drawn.ok { _ := sys.eprint("storm: " + drawn.error) }
    }
}

fn main() -> i32 {
    limit := frame_limit()
    opened := vulkan.open("Storm — Vulkan / Dunder (WASD + right mouse, Esc to quit)", 1280, 800)
    if !opened.ok {
        _ := sys.eprint("storm: " + opened.error)
        return 1
    }
    if trace_enabled() { vulkan.set_trace(opened.window, true) }
    print("device=" + vulkan.device_name(opened.window))

    shot := capture_path()
    mut capturing := false
    if shot.len > 0 {
        if !vulkan.capture_next(opened.window) {
            _ := sys.eprint("storm: could not set up the capture target")
            vulkan.close(opened.window)
            return 1
        }
        capturing = true
    }

    // --- geometry ---
    mut cube_vertices: []f32 = []
    vulkan.cube(&mut cube_vertices, 0.6)
    mut plane_vertices: []f32 = []
    vulkan.plane(&mut plane_vertices, 40.0)

    // --- scene tree: a hub with three orbiting cubes ---
    mut graph := scenegraph.Graph::new()
    hub := graph.create_root(core.vec3(0.0, 0.65, 0.0))

    gold := graph.create_child(hub, core.vec3(2.4, 0.0, 0.0))
    copper := graph.create_child(hub, core.vec3(-1.2, 0.0, 2.1))
    steel := graph.create_child(hub, core.vec3(-1.2, 0.0, -2.1))
    graph.set_rotation(gold, 0.0)
    graph.set_rotation(copper, 2.0944)
    graph.set_rotation(steel, 4.1888)
    graph.propagate()

    gold_material := Material { base: core.rgba(1.00, 0.76, 0.30, 1.0), metallic: 1.0, roughness: 0.10, emissive: 0.0 }
    copper_material := Material { base: core.rgba(0.99, 0.46, 0.28, 1.0), metallic: 1.0, roughness: 0.20, emissive: 0.0 }
    steel_material := Material { base: core.rgba(0.80, 0.85, 0.92, 1.0), metallic: 1.0, roughness: 0.28, emissive: 0.0 }
    floor_material := Material { base: core.rgba(0.20, 0.21, 0.24, 1.0), metallic: 0.05, roughness: 0.85, emissive: 0.0 }
    glass_material := Material { base: core.rgba(0.35, 0.80, 0.88, 0.26), metallic: 0.0, roughness: 0.05, emissive: 0.0 }

    // Two glass panes standing in front of the orbit, drawn last and blended.
    pane_left := core.multiply(core.translation(-2.7, 1.5, 2.6), core.scaling(core.vec3(1.5, 1.9, 0.05)))
    pane_right := core.multiply(core.translation(1.6, 1.3, 4.2), core.scaling(core.vec3(2.0, 1.3, 0.05)))

    // --- camera ---
    mut camera := input.Camera::new(core.vec3(0.0, 2.2, 9.5))
    camera.yaw = 0.0
    camera.pitch = -0.16
    camera.fov = 0.85

    // --- lighting: one sun, shared by the sky dome and every surface ---
    sun := core.normalize(core.vec3(0.45, 0.62, 0.38))
    mut sun_push: [f32; 4] = [sun.x, sun.y, sun.z, 3.1]
    mut sun_color_push: [f32; 4] = [1.0, 0.94, 0.84, 1.0]
    mut zenith_push: [f32; 4] = [0.09, 0.26, 0.56, 1.0]
    mut horizon_push: [f32; 4] = [0.63, 0.73, 0.86, 1.0]
    // Sun view-projection: the light sits back along the sun direction and looks
    // at the middle of the scene through a box wide enough for the whole demo.
    light_target := core.vec3(0.0, 0.9, 0.0)
    light_eye := core.add(light_target, core.scale(sun, 16.0))
    light_view := core.look_at(light_eye, light_target, core.vec3(0.0, 1.0, 0.0))
    light_projection := core.orthographic(-10.0, 10.0, -10.0, 10.0, 1.0, 40.0)
    light_vp := core.multiply(light_projection, light_view)
    mut light_dir_c: [f32; 4] = [sun.x, sun.y, sun.z, core.dot(light_eye, sun)]
    sky := vulkan.sky_params(sun_push, sun_color_push, zenith_push, horizon_push, light_vp.m, light_dir_c)

    mut show_glass := !flag("--no-glass")
    mut show_shadows := !flag("--no-shadows")
    mut effects := flag("--effects")

    // --- editor text ---
    face := text.load_face(FONT_PATH, ui.RASTER_SIZE)
    if !face.ok {
        _ := sys.eprint("storm: font missing: " + face.error)
        vulkan.close(opened.window)
        return 1
    }
    mut atlas := text.Atlas::new(1024, 1024)
    if !atlas.add_text(&face, GLYPHS) {
        _ := sys.eprint("storm: no glyphs packed")
        vulkan.close(opened.window)
        return 1
    }
    pixels := atlas.copy_pixels()
    atlas_size := atlas.size()
    if !vulkan.ui_atlas(opened.window, pixels, atlas_size, atlas_size) {
        _ := sys.eprint("storm: atlas upload failed")
        vulkan.close(opened.window)
        return 1
    }
    mut canvas := ui.Canvas::new()
    mut fps: f32 = 0.0

    mut frames: i64 = 0
    mut previous := 0.0
    mut running := true
    while running {
        frame := vulkan.poll(opened.window)
        if frame.closed || frame.key == 27 { running = false; continue }
        mut dt := if previous == 0.0 { 0.016 } else { frame.time - previous }
        if dt > 0.1 { dt = 0.1 }
        previous = frame.time
        if dt > 0.0 {
            instant := f32(1.0 / dt)
            fps = if fps == 0.0 { instant } else { fps * 0.9 + instant * 0.1 }
        }

        captured := (vulkan.mouse(opened.window).buttons.bit_and(input.MOUSE_RIGHT)) != 0
        camera.update(opened.window, f32(dt), captured)
        if vulkan.key_pressed(opened.window, input.KEY_R) {
            camera = input.Camera::new(core.vec3(0.0, 2.2, 9.5))
            camera.pitch = -0.16
            camera.fov = 0.85
        }
        if vulkan.key_pressed(opened.window, input.KEY_T) { show_glass = !show_glass }
        if vulkan.key_pressed(opened.window, input.KEY_G) { show_shadows = !show_shadows }
        if vulkan.key_pressed(opened.window, input.KEY_E) { effects = !effects }

        // Animate the orbit: the hub rotates, children follow through the tree.
        graph.set_rotation(hub, graph.local(hub).rotation_y + f32(dt) * 0.35)
        graph.propagate()

        aspect := f32(frame.width) / f32(frame.height)
        view_projection := camera.view_projection(aspect)
        inv_view_projection := input.inverse_view_projection(&camera, aspect)

        // --- scene contents for this frame ---
        mut items: []Item = []
        // Opaque geometry in declaration order: the depth buffer resolves
        // overlaps, so the floor no longer has to be painted first.
        items.push(Item { model: core.identity(), material: floor_material, transparent: false, plane: true, depth: 0.0 })
        gold_model := graph.world(gold).matrix.clone()
        copper_model := graph.world(copper).matrix.clone()
        steel_model := graph.world(steel).matrix.clone()
        items.push(Item { model: gold_model.clone(), material: gold_material, transparent: false, plane: false, depth: 0.0 })
        items.push(Item { model: copper_model.clone(), material: copper_material, transparent: false, plane: false, depth: 0.0 })
        items.push(Item { model: steel_model.clone(), material: steel_material, transparent: false, plane: false, depth: 0.0 })
        if show_glass {
            items.push(Item { model: pane_left.clone(), material: glass_material, transparent: true, plane: false, depth: depth_of(&pane_left, camera.position) })
            items.push(Item { model: pane_right.clone(), material: glass_material, transparent: true, plane: false, depth: depth_of(&pane_right, camera.position) })
        }
        sort_back_to_front(&mut items)

        // --- the render graph is rebuilt from what this frame contains ---
        mut has_opaque := false
        for item in items { if !item.transparent { has_opaque = true } }
        mut use_shadows := show_shadows && has_opaque
        mut schedule := render.Graph::new()
        if use_shadows { _ := schedule.add_pass("shadow", ["shadow_map"], []) }
        _ := schedule.add_pass("sky", ["color", "depth"], [])
        if use_shadows {
            _ := schedule.add_pass("opaque", ["color", "depth"], ["color", "depth", "shadow_map"])
        } else {
            _ := schedule.add_pass("opaque", ["color", "depth"], ["color", "depth"])
        }
        mut has_transparent := false
        for item in items { if item.transparent { has_transparent = true } }
        if has_transparent { _ := schedule.add_pass("transparent", ["color"], ["color", "depth"]) }
        order := schedule.build()
        if !order.ok {
            _ := sys.eprint("storm: " + order.error)
            running = false
            continue
        }

        begun := vulkan.begin(opened.window)
        if !begun.ok {
            if frame.resized { continue }
            _ := sys.eprint("storm: " + begun.error)
            running = false
            continue
        }

        // The shadow pass has to be recorded before the main render pass opens.
        if use_shadows {
            _ := vulkan.shadow_begin(opened.window, &sky.light_vp, &sky.light_dir_c)
            for index in 0..items.len {
                if !items[index].transparent {
                    if items[index].plane {
                        _ := vulkan.shadow_mesh(opened.window, &plane_vertices, &items[index].model.m)
                    } else {
                        _ := vulkan.shadow_mesh(opened.window, &cube_vertices, &items[index].model.m)
                    }
                }
            }
            _ := vulkan.shadow_end(opened.window)
        }

        opened_pass := vulkan.begin_pass(opened.window)
        if !opened_pass.ok {
            _ := sys.eprint("storm: " + opened_pass.error)
            running = false
            continue
        }

        for pass_index in 0..order.names.len {
            name := order.names[pass_index].clone()
            if name == "shadow" {
                // recorded before the main pass opened
            } else if name == "sky" {
                _ := vulkan.sky(opened.window, &inv_view_projection.m, &sun_push, &zenith_push, &horizon_push)
            } else if name == "opaque" {
                for index in 0..items.len {
                    if !items[index].transparent {
                        if items[index].plane {
                            draw_item(opened.window, &plane_vertices, items[index], view_projection, camera.position, &sky, use_shadows)
                        } else {
                            draw_item(opened.window, &cube_vertices, items[index], view_projection, camera.position, &sky, use_shadows)
                        }
                    }
                }
            } else if name == "transparent" {
                for index in 0..items.len {
                    if items[index].transparent {
                        draw_item(opened.window, &cube_vertices, items[index], view_projection, camera.position, &sky, false)
                    }
                }
            }
        }

        // --- post-process and editor overlay ---
        _ := vulkan.overlay(opened.window, f32(frame.time), if effects { 1.0 } else { 0.0 })
        canvas.clear()
        draw_editor(&mut canvas, &atlas, f32(frame.width), f32(frame.height),
            fps, frames, order.names.len, items.len, show_glass, show_shadows, effects)
        quads := canvas.take()
        _ := vulkan.ui_draw(opened.window, quads, [f32(frame.width), f32(frame.height)])

        finished := vulkan.end(opened.window)
        if !finished.ok {
            _ := sys.eprint("storm: " + finished.error)
            running = false
            continue
        }
        frames = finished.frames
        if capturing {
            if vulkan.save_capture(opened.window, shot) {
                _ := sys.eprint("storm: wrote " + shot)
            } else {
                _ := sys.eprint("storm: capture failed")
            }
            running = false
            continue
        }
        if limit > 0 && frames >= limit { running = false }
    }
    vulkan.close(opened.window)
    print("storm frames=" + frames.str())
    0
}

// --- editor overlay -------------------------------------------------------

// Two decimals without pulling in float formatting.
fn decimal2(value: f32) -> string {
    mut scaled := i32(value * 100.0 + 0.5)
    if scaled < 0 { scaled = 0 }
    whole := scaled / 100
    frac := scaled - whole * 100
    if frac < 10 { whole.str() + ".0" + frac.str() } else { whole.str() + "." + frac.str() }
}

fn draw_editor(canvas: &mut ui.Canvas, atlas: &text.Atlas, width: f32, height: f32,
    fps: f32, frames: i64, passes: i32, objects: i32, glass: bool, shadows: bool, effects: bool) {
    accent := ui.rgb(0.36, 0.86, 0.96)
    title := ui.rgb(0.96, 0.98, 1.0)
    dim := ui.rgb(0.52, 0.60, 0.72)
    body := ui.rgb(0.82, 0.87, 0.93)
    panel_fill := ui.rgba(0.06, 0.09, 0.13, 0.72)
    panel_border := ui.rgba(0.36, 0.86, 0.96, 0.32)

    // Top bar.
    canvas.rect(0.0, 0.0, width, 64.0, &ui.rgba(0.02, 0.03, 0.05, 0.9))
    canvas.rect(0.0, 64.0, width, 2.0, &ui.rgba(0.36, 0.86, 0.96, 0.5))
    canvas.text(atlas, "STORM", 26.0, 14.0, 1.0, &title)
    canvas.text(atlas, "scene editor", 156.0, 24.0, 0.6, &dim)
    fps_text := i32(fps + 0.5).str() + " fps"
    canvas.text(atlas, fps_text, width - 30.0 - ui.Canvas::text_width(atlas, fps_text, 0.68), 20.0, 0.68, &accent)

    // Scene graph.
    px: f32 = 26.0
    py: f32 = 92.0
    pw: f32 = 400.0
    canvas.panel(px, py, pw, 306.0, &panel_fill, &panel_border)
    canvas.text(atlas, "SCENE GRAPH", px + 18.0, py + 12.0, 0.6, &accent)
    canvas.rect(px + 18.0, py + 50.0, pw - 36.0, 1.0, &ui.rgba(1.0, 1.0, 1.0, 0.12))
    canvas.text(atlas, "World", px + 20.0, py + 64.0, 0.6, &body)
    canvas.text(atlas, "Camera", px + 44.0, py + 104.0, 0.6, &dim)
    canvas.text(atlas, "Sun", px + 44.0, py + 144.0, 0.6, &dim)
    canvas.text(atlas, "Hub", px + 44.0, py + 184.0, 0.6, &dim)
    canvas.text(atlas, "Gold cube", px + 74.0, py + 224.0, 0.6, &body)
    canvas.text(atlas, "Copper cube", px + 74.0, py + 254.0, 0.6, &dim)
    canvas.text(atlas, "Steel cube", px + 74.0, py + 284.0, 0.6, &dim)

    // Frame statistics.
    rx := width - 446.0
    canvas.panel(rx, py, 420.0, 186.0, &panel_fill, &panel_border)
    canvas.text(atlas, "FRAME", rx + 18.0, py + 12.0, 0.6, &accent)
    canvas.rect(rx + 18.0, py + 50.0, 384.0, 1.0, &ui.rgba(1.0, 1.0, 1.0, 0.12))
    canvas.text(atlas, "fps", rx + 20.0, py + 64.0, 0.58, &dim)
    canvas.text(atlas, i32(fps + 0.5).str(), rx + 150.0, py + 64.0, 0.58, &body)
    canvas.text(atlas, "frame", rx + 20.0, py + 100.0, 0.58, &dim)
    canvas.text(atlas, frames.str(), rx + 150.0, py + 100.0, 0.58, &body)
    canvas.text(atlas, "passes", rx + 20.0, py + 136.0, 0.58, &dim)
    canvas.text(atlas, passes.str(), rx + 150.0, py + 136.0, 0.58, &body)
    canvas.text(atlas, "objects", rx + 220.0, py + 64.0, 0.58, &dim)
    canvas.text(atlas, objects.str(), rx + 350.0, py + 64.0, 0.58, &body)
    canvas.text(atlas, "shadow 1024", rx + 220.0, py + 100.0, 0.58, &dim)

    // Material inspector.
    canvas.panel(rx, py + 206.0, 420.0, 216.0, &panel_fill, &panel_border)
    canvas.text(atlas, "MATERIAL / GOLD", rx + 18.0, py + 218.0, 0.6, &accent)
    canvas.rect(rx + 18.0, py + 256.0, 384.0, 1.0, &ui.rgba(1.0, 1.0, 1.0, 0.12))
    canvas.text(atlas, "metallic", rx + 20.0, py + 270.0, 0.58, &dim)
    canvas.text(atlas, "1.00", rx + 220.0, py + 270.0, 0.58, &body)
    canvas.text(atlas, "roughness", rx + 20.0, py + 306.0, 0.58, &dim)
    canvas.text(atlas, "0.10", rx + 220.0, py + 306.0, 0.58, &body)
    canvas.text(atlas, "albedo", rx + 20.0, py + 342.0, 0.58, &dim)
    canvas.text(atlas, "1.00 0.76 0.30", rx + 220.0, py + 342.0, 0.58, &body)

    // Bottom bar with the controls and the live pass toggles.
    by := height - 92.0
    canvas.panel(26.0, by, width - 52.0, 66.0, &panel_fill, &panel_border)
    canvas.text(atlas, "WASD move   Space/Ctrl up-down   Shift sprint   R reset", 46.0, by + 18.0, 0.58, &dim)
    mut chip_x := width - 470.0
    for chip in 0..3 {
        label := if chip == 0 { "glass" } else if chip == 1 { "shadows" } else { "effects" }
        on := if chip == 0 { glass } else if chip == 1 { shadows } else { effects }
        chip_width := ui.Canvas::text_width(atlas, label, 0.58) + 26.0
        fill := if on { ui.rgba(0.10, 0.35, 0.30, 0.85) } else { ui.rgba(0.14, 0.16, 0.20, 0.85) }
        ink := if on { ui.rgb(0.55, 0.95, 0.75) } else { ui.rgb(0.45, 0.50, 0.58) }
        canvas.rect(chip_x, by + 16.0, chip_width, 34.0, &fill)
        canvas.text(atlas, label, chip_x + 13.0, by + 22.0, 0.58, &ink)
        chip_x = chip_x + chip_width + 10.0
    }
}
