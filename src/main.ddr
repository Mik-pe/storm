// The composition root selects a graphics backend for both the window and agent previews.
capability stdio

import .app
import runtime
import studio
import studio.agent as agent
import runtime.args as args
import runtime.watch as watch
import mcp
import play
import metal
import vulkan
import sys

fn preview(session: &play.Session, path: string) -> Result<(), string> {
    argv: []string = []
    project := app.project(session.clone(), watch.new("", ""))?
    if target_is("macos") { return runtime.run<metal.Renderer, app.Game>(metal.open_preview, "Storm", &argv, move project, .Preview, path) }
    else { return runtime.run<vulkan.Window, app.Game>(vulkan.open_preview, "Storm", &argv, move project, .Preview, path) }
}

fn main() -> i32 {
    argv := args.from_process()
    flags := studio.flags()
    if args.flag(&argv, "--help") || args.flag(&argv, "-h") {
        print(args.usage("storm", "Open Storm Studio, load a model, or playtest an authored scene.", &flags))
        return 0
    }
    // A flag the program does not read is a typo, never a default: refuse
    // it by name instead of rendering a picture of something else.
    bad := args.unknown(&argv, &flags)
    if bad.len > 0 {
        _ := sys.eprint("storm: unknown option " + bad)
        print(args.usage("storm", "Open Storm Studio, load a model, or playtest an authored scene.", &flags))
        return 2
    }
    endpoint := args.value(&argv, "--editor-session")
    if args.flag(&argv, "--editor-session") && endpoint.len == 0 {
        _ := sys.eprint("storm: --editor-session requires a file")
        return 2
    }
    if args.flag(&argv, "--editor-mcp") {
        if endpoint.len == 0 { _ := sys.eprint("storm: editor clients require --editor-session FILE"); return 2 }
        return agent.listen(endpoint)
    }
    if args.flag(&argv, "--editor-command") {
        command := args.value(&argv, "--editor-command")
        match agent.cli(endpoint, command) {
            .Ok(data) => { print(data); return 0 },
            .Err(message) => { _ := sys.eprint("storm: " + message); return 1 },
        }
    }
    if args.flag(&argv, "--mcp") { return mcp.serve(preview) }
    headless := args.flag(&argv, "--editor-headless")
    if headless && endpoint.len == 0 { _ := sys.eprint("storm: --editor-headless requires --editor-session FILE"); return 2 }
    capture := args.flag(&argv, "--capture")
    project := match app.load(&argv) {
        .Ok(p) => p, .Err(message) => { _ := sys.eprint(message); return 1 },
    }
    launch := studio.launch_mode(&argv, .Workspace)
    shot := args.value(&argv, "--capture")
    result := if target_is("macos") {
        open := if capture || headless { metal.open_preview } else { metal.open }
        studio.run<metal.Renderer, app.Game>(open, "Storm", &argv, move project, launch, shot)
    } else {
        open := if capture || headless { vulkan.open_preview } else { vulkan.open }
        studio.run<vulkan.Window, app.Game>(open, "Storm", &argv, move project, launch, shot)
    }
    match result {
        .Ok => 0,
        .Err(message) => { _ := sys.eprint("storm: " + message); 1 },
    }
}
