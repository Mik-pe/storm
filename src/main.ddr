// Storm's composition root: the only file in the application that names a
// backend. It picks one for the platform and hands the application a way to
// open it; from there everything goes through the gfx.Backend contract.
import .app
import metal
import vulkan

fn main() -> i32 {
    if target_is("macos") { return app.run<metal.Renderer>(metal.open) }
    return app.run<vulkan.Window>(vulkan.open)
}
