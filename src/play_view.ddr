// Map simulation poses to ordinary scene nodes. Rendering never writes to the physics world.
import core
import ecs
import gfx
import input
import play
import scene
import .args
import .canopy
import .cozy_control
import .particles
import .woodland
import std.math as _

pub struct View {
    graph: scene.Graph,
    nodes: []ecs.Entity,
    cast: woodland.Cast,
    course: canopy.Course,
    cozy_fx: particles.CozyEffects,
    has_goal: bool,
    player_node: i32,
    center: core.Vec3,
    extent: core.Vec3,
}

// Lower the sphere tessellation on dense levels to keep both passes in the initial allocation.
pub fn sphere_geometry(scene: &play.Scene) -> []f32 {
    mut count := 0
    for item in scene.entities { if item.shape == .Sphere { count += 1 } }
    if count <= 32 { return gfx.sphere(24, 12) }
    return gfx.sphere(16, 6)
}

pub fn build(session: &play.Session) -> Result<View, string> {
    mut graph := scene.Graph::new()
    mut nodes: []ecs.Entity = []
    mut goal := false
    mut player_node := -1
    mut lo := core.vec3(0.0, 0.0, 0.0)
    mut hi := lo
    for i in 0..session.scene.entities.len {
        item := &session.scene.entities[i]
        pos := play.position(session, i)
        half := core.scale(item.size, 0.5)
        bottom := core.sub(item.position, half)
        top := core.add(item.position, half)
        if item.role == .Player { player_node = i }
        if i == 0 || bottom.x < lo.x { lo.x = bottom.x }
        if i == 0 || bottom.y < lo.y { lo.y = bottom.y }
        if i == 0 || bottom.z < lo.z { lo.z = bottom.z }
        if i == 0 || top.x > hi.x { hi.x = top.x }
        if i == 0 || top.y > hi.y { hi.y = top.y }
        if i == 0 || top.z > hi.z { hi.z = top.z }
        node := graph.create_root(pos)
        nodes.push(node)
        _ := graph.set_name(node, item.name.clone())
        if item.role == .Collider || canopy.modeled(item.role) || (session.scene.theme == .Blossom && (item.role == .Player || item.role == .Flower)) { continue }
        sphere := item.shape == .Sphere
        _ := graph.set_shape(node, if sphere { scene.Shape.Sphere } else { scene.Shape.Cube })
        // Built-in boxes span 1.2 world units, spheres span two.
        _ := graph.set_scale(node, if sphere { half } else { core.scale(item.size, 1.0 / 1.2) })
        c := item.color
        is_goal := item.role == .Goal
        if is_goal { goal = true }
        _ := graph.set_material(node, scene.emissive_material(c.x, c.y, c.z, 1.0,
            if sphere { 0.38 } else { 0.10 }, if sphere { 0.27 } else { 0.62 }, if is_goal { 0.22 } else { 0.0 }))
    }
    cast := if session.scene.theme == .Blossom { woodland.build(&mut graph, session, &nodes)? } else { woodland.empty() }
    course := canopy.build(&mut graph, session, &nodes)?
    cozy_fx := if session.scene.theme == .Blossom { particles.build_cozy(&mut graph) } else { particles.empty_cozy() }
    graph.propagate()
    .Ok(View {
        course: move course, cast: move cast, cozy_fx: move cozy_fx, graph: move graph, nodes: move nodes, has_goal: goal, player_node: player_node,
        center: core.scale(core.add(lo, hi), 0.5), extent: core.scale(core.sub(hi, lo), 0.5)
    })
}

pub fn sync(view: &mut View, session: &play.Session, exact: bool) {
    idle := cozy_control.GuideVisual { active: false, target: core.vec3(0.0, 0.0, 0.0), age: 0.0 }
    sync_guide(&mut view, session, exact, &idle)
}

pub fn is_snoozing(cozy: &play.CozyState, motion: &play.PlayerMotion, rest: &play.Rest) -> bool {
    (cozy.sitting && cozy.sit_age >= 4.5) || (motion.grounded && motion.run_weight < 0.1 && rest.age >= 14.0)
}

pub fn sync_guide(view: &mut View, session: &play.Session, exact: bool, guide: &cozy_control.GuideVisual) {
    for i in 0..view.nodes.len {
        if session.scene.entities[i].role == .Flower {
            view.graph.set_visible(view.nodes[i], !session.collected[i])
        }
        if session.scene.entities[i].mass == 0.0 { continue }
        pos := if exact { play.position(session, i) } else { play.render_position(session, i) }
        view.graph.set_position(view.nodes[i], pos)
    }
    woodland.animate(&mut view.graph, &view.cast, session, view.player_node, exact, &view.course)
    canopy.animate(&mut view.graph, &view.course, session, exact)
    if session.scene.theme == .Blossom && view.player_node >= 0 {
        fox_pos := if exact { play.position(session, view.player_node) } else { play.render_position(session, view.player_node) }
        radius := session.scene.entities[view.player_node].size.y * 0.5
        support_y := canopy.surface_below(&view.course, session, fox_pos.x, fox_pos.y - radius + 0.08, fox_pos.z)
        motion := play.render_motion(session, exact)
        rest := play.render_rest(session, exact)
        cozy := play.render_cozy(session, exact)
        snoozing := is_snoozing(&cozy, &motion, &rest)
        cue := particles.CozyCue {
            fox: fox_pos,
            support_y: support_y,
            grounded: motion.grounded,
            landing_age: motion.landing_age,
            landing_strength: motion.landing_strength,
            pet_age: cozy.pet_age,
            emote_age: cozy.emote_age,
            snoozing: snoozing,
            won: session.won,
            guide_active: guide.active,
            guide_pos: guide.target,
            guide_age: guide.age,
            boost_pos: canopy.boost_cloud_pos(&view.course, session),
        }
        particles.animate_cozy(&mut view.graph, &view.cozy_fx, motion.seconds, &cue)
    }
    view.graph.propagate()
}

pub fn controls(keys: &gfx.Input) -> play.Input {
    mut x: f32 = 0.0
    mut z: f32 = 0.0
    if keys.down(.A) || keys.down(.Left) { x -= 1.0 }
    if keys.down(.D) || keys.down(.Right) { x += 1.0 }
    if keys.down(.W) || keys.down(.Up) { z -= 1.0 }
    if keys.down(.S) || keys.down(.Down) { z += 1.0 }
    play.Input { x: x, z: z, jump: keys.hit(.Space) }
}

pub struct Framing { center: core.Vec3, extent: core.Vec3, forest: bool, climb: f32 }

fn follow(center: f32, player: f32, room: f32) -> f32 {
    if player < center - room { return player + room }
    if player > center + room { return player - room }
    center
}

pub fn framing(view: &View, session: &play.Session, exact: bool) -> Framing {
    mut area := Framing { center: view.center, extent: view.extent, forest: session.scene.theme == .Blossom, climb: 0.0 }
    if view.player_node < 0 { return area }
    if area.extent.x > 10.0 { area.extent.x = 10.0 }
    if area.extent.y > 6.0 { area.extent.y = 6.0 }
    if area.extent.z > 8.0 { area.extent.z = 8.0 }
    player := if exact { play.position(session, view.player_node) } else { play.render_position(session, view.player_node) }
    if area.forest {
        height := player.y - session.scene.entities[view.player_node].position.y
        lift := if height <= 0.0 { f32(0.0) } else if height >= 2.5 { f32(1.0) } else { height / 2.5 }
        area.climb = lift * lift * (3.0 - 2.0 * lift)
        area.center = core.vec3(player.x * 0.75, 0.90 + height * (0.35 + 0.60 * area.climb),
            (player.z - 1.0) * 0.76)
        area.extent = core.vec3(5.0, 2.0, 4.0)
        return area
    }
    area.center = core.vec3(follow(view.center.x, player.x, 1.0 + area.extent.x * 0.65),
        follow(view.center.y, player.y, 1.4 + area.extent.y * 0.36),
        follow(view.center.z, player.z, 1.0 + area.extent.z * 0.55))
    area
}

pub fn camera(view: &Framing, aspect: f32) -> input.Camera {
    camera_cozy(view, aspect, 0.0, 1.0)
}

// Orbit and zoom around the current framing target without changing its look-at focus.
pub fn camera_cozy(view: &Framing, aspect: f32, yaw_offset: f32, zoom: f32) -> input.Camera {
    // Fit the authored bounds in the usable viewport, including the play controls.
    half_height := view.extent.y * 0.85 + view.extent.z * 0.53
    mut reach := half_height
    horizontal := view.extent.x / aspect
    if horizontal > reach { reach = horizontal }
    if reach < 1.3 { reach = 1.3 }
    distance := reach * 2.96 + view.extent.z * 0.85 + view.extent.y * 0.53
    mut offset := core.vec3(0.0, distance * 0.53, distance * 0.85)
    if view.forest {
        fit: f32 = if aspect < 1.15 { 1.15 / aspect } else { 1.0 }
        offset = core.scale(core.vec3(0.0, 2.20 + 0.90 * view.climb, 7.60 + 0.65 * view.climb), fit)
    }
    safe_zoom := if zoom < 0.25 { f32(0.25) } else { zoom }
    if yaw_offset != 0.0 {
        c := yaw_offset.cos()
        s := yaw_offset.sin()
        offset = core.vec3(offset.x * c - offset.z * s, offset.y, offset.x * s + offset.z * c)
    }
    if safe_zoom != 1.0 { offset = core.scale(offset, safe_zoom) }
    eye := core.add(view.center, offset)
    aim := args.look_at(eye, view.center)
    mut cam := input.Camera::new(eye)
    cam.yaw = aim.yaw
    cam.pitch = aim.pitch
    cam.fov = if view.forest { 0.76 } else { 0.85 }
    if distance * safe_zoom > 100.0 { cam.far_clip = distance * safe_zoom * 4.0 }
    cam
}
