// Whole-body acting is layered on the gait before the feet are solved.
import .fox_animation as fox
import core
import gfx
import gltf
import scene
import play
import scene.animation as anim
import std.math as math

pub struct Focus { height: f32, weight: f32 }
pub struct Acting { focus: Focus, blush: f32, sit: f32, snooze: f32, happy: f32 }

// Read the authored landmarks once, in the same coordinates as the visible meshes.
pub fn nose_tip(art: &gltf.Asset) -> Result<core.Vec3, string> {
    for i in 0..art.parts.len {
        part := &art.parts[i]
        if part.name != "Head_Cocoa" || part.vertices.len < gfx.VERTEX_FLOATS { continue }
        mut nose := core.vec3(part.vertices[0], part.vertices[1], part.vertices[2])
        for k in 0..(part.vertices.len / gfx.VERTEX_FLOATS) {
            j := k * gfx.VERTEX_FLOATS
            if part.vertices[j + 2] > nose.z { nose = core.vec3(part.vertices[j], part.vertices[j + 1], part.vertices[j + 2]) }
        }
        return .Ok(nose)
    }
    .Err("fox model has no muzzle")
}

pub fn bloom_center(art: &gltf.Asset) -> Result<core.Vec3, string> {
    for i in 0..art.parts.len {
        part := &art.parts[i]
        if part.name != "Body_Daisyheart" || part.vertices.len < gfx.VERTEX_FLOATS { continue }
        mut lo := core.vec3(part.vertices[0], part.vertices[1], part.vertices[2])
        mut hi := lo
        for k in 0..(part.vertices.len / gfx.VERTEX_FLOATS) {
            j := k * gfx.VERTEX_FLOATS
            x := part.vertices[j]; y := part.vertices[j + 1]; z := part.vertices[j + 2]
            if x < lo.x { lo.x = x }; if x > hi.x { hi.x = x }
            if y < lo.y { lo.y = y }; if y > hi.y { hi.y = y }
            if z < lo.z { lo.z = z }; if z > hi.z { hi.z = z }
        }
        return .Ok(core.scale(core.add(lo, hi), 0.5))
    }
    .Err("flower model has no pollen center")
}

pub struct Gestures { sniff: anim.Clip, stretch: anim.Clip, pleased: anim.Clip, pet: anim.Clip, emote: anim.Clip }

fn key(t: f32, x: f32, y: f32, z: f32) -> anim.Key { anim.key(t, x, y, z, .Spline) }

pub fn gestures() -> Result<Gestures, string> {
    // Muzzle dip, chest bow, eyelid closure. The head finds the scent before the shoulders move.
    sniff := anim.clip(7.4, [key(0.0, 0.0, 0.0, 0.0), key(0.27, -0.08, 0.0, 0.0),
        key(0.80, 0.36, 0.12, 0.18), key(1.18, 0.62, 0.30, 0.64),
        key(1.40, 0.50, 0.33, 0.94), key(1.63, 0.61, 0.30, 0.82),
        key(1.86, 0.52, 0.28, 0.98), key(2.03, 0.56, 0.25, 0.88),
        key(2.48, -0.14, 0.04, 0.67), key(2.90, -0.05, -0.015, 0.04),
        key(3.33, 0.0, 0.0, 0.0), key(7.4, 0.0, 0.0, 0.0)], [], [])?
    // Forequarters fold into the stretch, pause, then ease out through a lifted chin.
    stretch := anim.clip(8.6, [key(0.0, 0.0, 0.0, 0.0), key(0.60, 0.0, 0.0, 0.0),
        key(1.19, 0.09, 0.22, 0.30), key(1.77, 0.19, 0.40, 0.92),
        key(2.12, 0.17, 0.42, 0.96), key(2.56, -0.20, 0.17, 0.76),
        key(3.03, -0.11, -0.025, 0.07), key(3.64, 0.0, 0.0, 0.0),
        key(8.6, 0.0, 0.0, 0.0)], [], [])?
    // A picked flower lifts the chin first. The ears and brush catch up as the eyes soften.
    pleased := anim.clip(1.18, [key(0.0, 0.0, 0.0, 0.0), key(0.14, 0.05, 0.02, 0.50),
        key(0.34, -0.28, -0.095, 0.96), key(0.53, -0.23, -0.075, 0.96),
        key(0.78, -0.06, -0.02, 0.48), key(1.18, 0.0, 0.0, 0.0)], [], [])?
    // Loving upward muzzle nuzzle, warm head tilt, and contented smiling eyes.
    pet := anim.clip(1.65, [key(0.0, 0.0, 0.0, 0.0), key(0.16, -0.18, -0.05, 0.72),
        key(0.36, -0.30, -0.08, 1.0), key(0.68, -0.20, -0.06, 1.0),
        key(0.95, -0.31, -0.08, 1.0), key(1.22, -0.18, -0.05, 0.94),
        key(1.48, -0.05, -0.01, 0.32), key(1.65, 0.0, 0.0, 0.0)],
        [key(0.0, 0.0, 0.0, 0.0), key(0.16, 0.82, 0.08, 0.16),
            key(0.45, 1.0, 0.12, 0.24), key(0.95, 1.0, -0.06, 0.20),
            key(1.30, 0.78, 0.04, 0.12), key(1.65, 0.0, 0.0, 0.0)], [])?
    // Playful fox play-bow dipping the chest then springing up with bright head tilt and happy eyes.
    emote := anim.clip(1.25, [key(0.0, 0.0, 0.0, 0.0), key(0.14, -0.16, 0.36, 0.22),
        key(0.32, -0.26, 0.62, 0.48), key(0.46, -0.22, 0.52, 0.62),
        key(0.72, -0.32, -0.16, 0.85), key(0.94, -0.18, -0.04, 0.55),
        key(1.25, 0.0, 0.0, 0.0)],
        [key(0.0, 0.0, 0.0, 0.0), key(0.16, 0.85, 0.10, -0.18),
            key(0.38, 1.0, 0.14, -0.22), key(0.72, 1.0, -0.14, 0.26),
            key(1.02, 0.65, 0.06, 0.10), key(1.25, 0.0, 0.0, 0.0)], [])?
    .Ok(Gestures { sniff: move sniff, stretch: move stretch, pleased: move pleased, pet: move pet, emote: move emote })
}

fn smooth(start: f32, end: f32, n: f32) -> f32 {
    if n <= start { return 0.0 }
    if n >= end { return 1.0 }
    t := (n - start) / (end - start)
    t * t * (3.0 - 2.0 * t)
}

fn clamp_f(v: f32, lo: f32, hi: f32) -> f32 {
    if v < lo { return lo }
    if v > hi { return hi }
    v
}

fn max2(a: f32, b: f32) -> f32 { if a > b { a } else { b } }

struct Scent { weight: f32, side: f32, height: f32 }
struct Curiosity { weight: f32, yaw: f32, lift: f32, roll: f32 }

// Flowers contribute continuously at the edge of Vallmo's reach and field of view.
fn scent(s: &play.Session, center: core.Vec3, heading: f32, scale: f32, picked_age: f32, bloom_offset: core.Vec3) -> Scent {
    sn := heading.sin()
    cs := heading.cos()
    mut interest: f32 = 0.0
    mut side: f32 = 0.0
    mut height: f32 = 0.0
    for sensor in s.sensors {
        i := sensor.entity_index
        f := &s.scene.entities[i]
        if f.role != .Flower { continue }
        mut available: f32 = 1.0
        if s.collected[i] {
            if i != s.last_flower { continue }
            available = 1.0 - smooth(0.0, 0.45, picked_age)
            if available <= 0.0 { continue }
        }
        pollen := core.add(f.position, core.scale(bloom_offset, f.size.x / 0.64))
        d := core.scale(core.sub(pollen, center), 1.0 / scale)
        distance := (d.x * d.x + d.z * d.z).sqrt()
        if distance < 0.001 || distance >= 1.8 || d.y.abs() > 0.95 { continue }
        forward := (d.x * sn + d.z * cs) / distance
        w := available * (1.0 - smooth(1.12, 1.80, distance)) * (1.0 - smooth(0.50, 0.95, d.y.abs())) *
        smooth(-0.05, 0.56, forward)
        height += w * pollen.y
        interest += w
        side += w * (d.x * cs - d.z * sn) / distance
    }
    if interest <= 0.0 { return Scent { weight: 0.0, side: 0.0, height: 0.0 } }
    Scent { weight: smooth(0.0, 1.0, interest), side: side / interest, height: height / interest }
}

// Find the nearest uncollected super butterfly within curious gaze range (~4.2m).
fn curious_butterfly(s: &play.Session, center: core.Vec3, heading: f32) -> Curiosity {
    mut best_dist: f32 = 4.2
    mut best_d := core.vec3(0.0, 0.0, 0.0)
    mut found := false
    for sensor in s.sensors {
        i := sensor.entity_index
        b := &s.scene.entities[i]
        if b.role != .SuperButterfly || s.collected[i] { continue }
        d := core.sub(b.position, center)
        dist := core.length(d)
        if dist > 0.001 && dist < best_dist {
            best_dist = dist
            best_d = d
            found = true
        }
    }
    if !found { return Curiosity { weight: 0.0, yaw: 0.0, lift: 0.0, roll: 0.0 } }
    sn := heading.sin()
    cs := heading.cos()
    fwd := best_d.x * sn + best_d.z * cs
    left := best_d.x * cs - best_d.z * sn
    horiz := (best_d.x * best_d.x + best_d.z * best_d.z).sqrt()
    yaw := clamp_f(f32(math.atan2(f64(left), f64(fwd))), -1.05, 1.05)
    up := clamp_f(f32(math.atan2(f64(best_d.y - 0.15), f64(if horiz > 0.25 { horiz } else { f32(0.25) }))), 0.12, 0.55)
    w := 1.0 - smooth(2.8, 4.2, best_dist)
    Curiosity { weight: w, yaw: yaw, lift: up, roll: if left >= 0.0 { f32(0.11) } else { f32(-0.11) } }
}

pub fn apply(p: &mut fox.Pose, clips: &Gestures, s: &play.Session, m: &play.PlayerMotion,
    center: core.Vec3, scale: f32, exact: bool, bloom_offset: core.Vec3) -> Acting {
    base := anim.identity()
    rest := play.render_rest(s, exact)
    cozy := play.render_cozy(s, exact)
    picked := cozy.flower_age
    idle := smooth(0.0, 1.0, rest.weight) * (1.0 - p.air)
    flower := if idle > 0.0 { scent(s, center, m.heading, scale, picked, bloom_offset) }
    else { Scent { weight: 0.0, side: 0.0, height: 0.0 } }
    manual_sit := cozy.sit_weight
    auto_sit := if idle > 0.0 && flower.weight < 0.2 && rest.age >= 0.0 { smooth(9.0, 10.2, rest.age) } else { f32(0.0) }
    sit := max2(manual_sit, auto_sit) * (1.0 - p.air) * (1.0 - smooth(0.15, 0.45, m.run_weight))
    snooze_curve := if cozy.sitting && cozy.sit_age >= 0.0 { smooth(4.5, 6.2, cozy.sit_age) }
    else { smooth(14.0, 15.8, rest.age) }
    snooze := snooze_curve * sit
    mut channels := core.vec3(0.0, 0.0, 0.0)
    mut look: f32 = 0.0
    mut focus := Focus { height: 0.0, weight: 0.0 }
    if idle > 0.0 {
        bow := anim.sample(&clips.stretch, rest.age, .Loop, base).position
        sniff := anim.sample(&clips.sniff, rest.age, .Loop, base).position
        channels = core.scale(core.add(core.scale(bow, 1.0 - flower.weight), core.scale(sniff, flower.weight)), idle)
        // The sniffs skim the pollen at two slightly different heights.
        focus.height = flower.height + (0.075 + 0.85 * (0.60 - sniff.x)) * scale
        focus.weight = flower.weight * idle * smooth(0.08, 0.42, sniff.x)
        look = flower.weight * flower.side * idle * smooth(0.0, 0.46, rest.age)
    }
    if sit > 0.0 {
        calm := (1.0 - 0.85 * sit) * (1.0 - snooze)
        channels = core.scale(channels, calm)
        focus.weight *= (1.0 - 0.65 * sit) * (1.0 - snooze)
        look *= 1.0 - 0.65 * snooze
    }
    mut joy: f32 = 0.0
    if s.last_flower >= 0 && picked >= 0.0 && picked < 1.18 {
        reward := anim.sample(&clips.pleased, picked, .Clamp, base).position
        channels = core.add(core.scale(channels, 1.0 - reward.z), reward)
        joy = reward.z
        focus.weight *= 1.0 - joy
    }
    mut butterfly_joy: f32 = 0.0
    if s.last_butterfly >= 0 && cozy.butterfly_age >= 0.0 && cozy.butterfly_age < 1.18 {
        reward := anim.sample(&clips.pleased, cozy.butterfly_age, .Clamp, base).position
        channels = core.add(core.scale(channels, 1.0 - reward.z), reward)
        butterfly_joy = reward.z
        focus.weight *= 1.0 - butterfly_joy
    }
    mut pet_w: f32 = 0.0
    mut pet_yaw: f32 = 0.0
    mut pet_roll: f32 = 0.0
    if cozy.pet_age >= 0.0 && cozy.pet_age < 1.65 {
        sample := anim.sample(&clips.pet, cozy.pet_age, .Clamp, base)
        pet_w = sample.rotation.x
        pet_yaw = sample.rotation.y
        pet_roll = sample.rotation.z
        channels = core.add(core.scale(channels, 1.0 - pet_w), sample.position)
        focus.weight *= 1.0 - pet_w
    }
    mut emote_w: f32 = 0.0
    mut emote_yaw: f32 = 0.0
    mut emote_roll: f32 = 0.0
    if cozy.emote_age >= 0.0 && cozy.emote_age < 1.25 {
        sample := anim.sample(&clips.emote, cozy.emote_age, .Clamp, base)
        emote_w = sample.rotation.x
        emote_yaw = sample.rotation.y
        emote_roll = sample.rotation.z
        mut pos := sample.position
        pos.y *= 1.0 - 0.72 * sit
        if s.won { pos.y = pos.y * 0.25 - 0.16 * emote_w }
        channels = core.add(core.scale(channels, 1.0 - emote_w), pos)
        focus.weight *= 1.0 - emote_w
    }
    mut curious_w: f32 = 0.0
    mut curious := Curiosity { weight: 0.0, yaw: 0.0, lift: 0.0, roll: 0.0 }
    if idle > 0.1 && flower.weight < 0.25 {
        curious = curious_butterfly(s, center, m.heading)
        curious_w = curious.weight * smooth(0.1, 0.35, idle) * (1.0 - smooth(0.10, 0.25, flower.weight)) *
        (1.0 - snooze) * (1.0 - max2(pet_w, emote_w))
    }
    head := channels.x
    bow := channels.y
    shut := channels.z
    p.body.rotation.x += 0.22 * bow
    p.body.position.z += 0.095 * bow
    p.chest.rotation.x += 0.68 * bow
    p.chest.position.y -= 0.20 * bow
    p.chest.position.z += 0.13 * bow
    if s.won && emote_w > 0.0 {
        // Bouncy chest pride when celebrating all collected flowers.
        bounce := (10.5 * cozy.emote_age).sin().abs() * emote_w
        p.body.position.y += 0.042 * bounce
        p.chest.rotation.x -= 0.18 * emote_w
    }
    if snooze > 0.0 {
        p.head.y *= 1.0 - 0.65 * snooze
        p.head.z *= 1.0 - 0.65 * snooze
    }
    p.head.x += head - 0.72 * curious_w * curious.lift
    p.head.y += 0.61 * look + pet_yaw + emote_yaw + 0.72 * curious_w * curious.yaw
    p.head.z += 0.12 * look + 0.10 * max2(joy, butterfly_joy) + pet_roll + emote_roll + curious_w * curious.roll
    p.eye_open *= 1.0 - shut
    if sit > 0.0 {
        p.body.position.y -= 0.062 * sit
        p.body.position.z -= 0.055 * sit
        p.body.rotation.x -= 0.24 * sit
        p.chest.rotation.x -= 0.07 * sit
        p.chest.position.y += 0.010 * sit
        p.head.x += 0.26 * sit
        p.head.z += 0.055 * sit * (1.0 - snooze)
        p.eye_open *= 1.0 - 0.26 * sit
    }
    if snooze > 0.0 {
        p.eye_open *= 1.0 - snooze
        tuck := snooze * (1.0 - 0.85 * max2(pet_w, emote_w))
        dream := (m.seconds * 1.3).sin() * snooze
        p.head.x += 0.32 * tuck + 0.022 * dream
        p.head.y -= 0.14 * tuck
        p.head.z += 0.10 * tuck
        p.chest.position.y += 0.012 * dream
        p.chest.rotation.x += 0.032 * dream
        p.body.scale = core.add(p.body.scale, core.vec3(0.018 * dream, 0.026 * dream, 0.015 * dream))
    }
    sleep_ears := snooze * (1.0 - 0.85 * max2(pet_w, emote_w))
    for i in 0..2 {
        mirror: f32 = if i == 0 { 1.0 } else { -1.0 }
        wiggle := if emote_w > 0.0 { 0.22 * (14.0 * cozy.emote_age + f32(i) * 1.4).sin() * emote_w } else { f32(0.0) }
        wiggle_z := if emote_w > 0.0 { 0.20 * (11.0 * cozy.emote_age).cos() * emote_w } else { f32(0.0) }
        p.ears[i].x -= 0.36 * bow + 0.23 * max2(joy, butterfly_joy) + 0.40 * pet_w + 0.12 * sit + 0.34 * sleep_ears
        p.ears[i].x += wiggle + 0.24 * curious_w + (if s.won { 0.14 * emote_w } else { f32(0.0) })
        p.ears[i].y += 0.22 * look + 0.20 * curious_w * curious.yaw
        p.ears[i].z += mirror * (0.24 * bow + 0.15 * max2(joy, butterfly_joy) - 0.28 * pet_w - 0.10 * sit - 0.24 * sleep_ears + wiggle_z + 0.08 * curious_w)
    }
    wrap_yaw: [f32; 3] = [0.48, 0.56, 0.54]
    wrap_pitch: [f32; 3] = [0.14, 0.14, 0.10]
    for i in 0..3 {
        f := f32(i)
        if sit > 0.0 {
            p.tail[i].y *= 1.0 - 0.72 * sit
            p.tail[i].z *= 1.0 - 0.72 * sit
            p.tail[i].x += wrap_pitch[i] * sit
            p.tail[i].y += wrap_yaw[i] * sit
        }
        p.tail[i].x += (0.35 - 0.08 * f) * bow + (0.22 - 0.03 * f) * pet_w + 0.26 * emote_w
        p.tail[i].y += max2(joy, butterfly_joy) * (9.0 * picked - f * 0.60).sin() * (0.19 + 0.05 * f)
        if pet_w > 0.0 {
            p.tail[i].y += pet_w * (13.5 * cozy.pet_age - f * 0.55).sin() * (0.26 + 0.07 * f)
        }
        if emote_w > 0.0 {
            p.tail[i].y += emote_w * (11.0 * cozy.emote_age - f * 0.50).sin() * (0.22 + 0.06 * f)
        }
    }
    if sit > 0.0 {
        p.tail[2].y += sit * (1.0 - 0.65 * snooze) * 0.11 * (2.1 * m.seconds).sin()
    }
    pet_blush := if cozy.pet_age >= 0.0 && cozy.pet_age < 2.2 {
        (0.88 + 0.12 * smooth(0.0, 0.10, cozy.pet_age)) * (1.0 - smooth(1.30, 2.20, cozy.pet_age))
    } else { f32(0.0) }
    butterfly_blush := if s.last_butterfly >= 0 && cozy.butterfly_age >= 0.0 && cozy.butterfly_age < 2.2 {
        0.95 * (0.85 + 0.15 * smooth(0.0, 0.12, cozy.butterfly_age)) * (1.0 - smooth(1.20, 2.20, cozy.butterfly_age))
    } else { f32(0.0) }
    flower_blush := if s.last_flower >= 0 && cozy.flower_age >= 0.0 && cozy.flower_age < 1.85 {
        0.85 * (0.85 + 0.15 * smooth(0.0, 0.12, cozy.flower_age)) * (1.0 - smooth(0.95, 1.85, cozy.flower_age))
    } else { f32(0.0) }
    emote_blush := if cozy.emote_age >= 0.0 && cozy.emote_age < 1.65 {
        0.80 * (0.85 + 0.15 * smooth(0.0, 0.10, cozy.emote_age)) * (1.0 - smooth(0.95, 1.65, cozy.emote_age))
    } else { f32(0.0) }
    snooze_blush := 0.45 * snooze
    blush := clamp_f(max2(max2(pet_blush, butterfly_blush), max2(flower_blush, max2(emote_blush, snooze_blush))), 0.0, 1.0)
    happy := clamp_f(max2(max2(joy, butterfly_joy), max2(max2(pet_w, emote_w), max2(0.35 * sit, 0.50 * snooze))), 0.0, 1.0)
    Acting { focus: focus, blush: blush, sit: sit, snooze: snooze, happy: happy }
}

// Solve the muzzle height after the shoulders and the planted legs have set the actual neck position.
pub fn aim(head: core.Vec3, pivot: core.Vec3, nose: core.Vec3, parent: &core.Mat4, height: f32, weight: f32) -> f32 {
    if weight <= 0.0 { return head.x }
    mut lo: f32 = -0.78
    mut hi: f32 = 1.05
    tip := core.sub(nose, pivot)
    mut local := scene.LocalTransform {
        position: pivot, scale: core.vec3(1.0, 1.0, 1.0),
        rotation_x: 0.0, rotation_y: head.y, rotation_z: head.z, visible: true
    }
    for _ in 0..10 {
        mid := 0.5 * (lo + hi)
        local.rotation_x = mid
        sample := core.transform_point(parent, core.transform_point(&scene.matrix_for(&local), tip))
        if sample.y > height { lo = mid } else { hi = mid }
    }
    head.x + (0.5 * (lo + hi) - head.x) * weight
}
