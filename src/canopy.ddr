// Cloud art rests on the collision plane. The animation deforms the underside,
// cushions impacts with a soft marshmallow ripple, and adds a dreamy floating bob.
import .art_asset
import .model
import .particles
import .walk_surface
import core
import ecs
import gltf
import play
import scene
import scene.animation as anim
import std.math as _

const REBOUND_SECONDS: f32 = 0.62

struct Pad { index: i32, node: ecs.Entity }
struct Prize { index: i32, root: ecs.Entity, left: ecs.Entity, right: ecs.Entity }
pub struct Course { pads: []Pad, prizes: []Prize, impact: anim.Clip, cloud_top: walk_surface.Surface, boost_top: walk_surface.Surface, effects: particles.Effects }

pub fn platform(role: play.Role) -> bool { role == .Cloud || role == .BoostCloud }
pub fn modeled(role: play.Role) -> bool { platform(role) || role == .SuperButterfly }
fn zero() -> core.Vec3 { core.vec3(0.0, 0.0, 0.0) }

fn smooth(start: f32, end: f32, n: f32) -> f32 {
    if n <= start { return 0.0 }
    if n >= end { return 1.0 }
    t := (n - start) / (end - start)
    t * t * (3.0 - 2.0 * t)
}

fn mount(g: &mut scene.Graph, parent: ecs.Entity, art: &mut gltf.Asset, name: string,
    joints: &[]model.Joint, first: &mut []ecs.Entity, paint: &[]model.Paint) -> Result<(), string> {
    if art.parts.len == 0 {
        loaded := art_asset.load(name)?
        art.parts = loaded.parts
    }
    model.attach(&mut g, parent, &art, joints, &mut first, paint)
    .Ok
}

pub fn build(g: &mut scene.Graph, session: &play.Session, nodes: &[]ecs.Entity) -> Result<Course, string> {
    // Soft pillowy cushion squash, plump rebound, and two damped marshmallow settle ripples.
    impact := anim.clip(REBOUND_SECONDS, [], [], [
        anim.key(0.0, 1.0, 1.0, 1.0, .EaseOut),
        anim.key(0.055, 1.15, 0.58, 1.15, .Smooth),
        anim.key(0.175, 0.94, 1.14, 0.94, .Smooth),
        anim.key(0.31, 1.055, 0.91, 1.055, .Smooth),
        anim.key(0.45, 0.985, 1.038, 0.985, .Smooth),
        anim.key(0.55, 1.008, 0.988, 1.008, .Smooth),
        anim.key(REBOUND_SECONDS, 1.0, 1.0, 1.0, .Smooth)])?
    mut course := Course {
        pads: [], prizes: [], impact: move impact,
        cloud_top: walk_surface.empty(), boost_top: walk_surface.empty(), effects: particles.empty()
    }
    mut cloud := gltf.empty_asset()
    mut boost := gltf.empty_asset()
    mut butterfly := gltf.empty_asset()
    mut cloud_meshes: []ecs.Entity = []
    mut boost_meshes: []ecs.Entity = []
    mut wings: []ecs.Entity = []
    for i in 0..nodes.len {
        e := &session.scene.entities[i]
        if platform(e.role) {
            pad := g.create_child(nodes[i], zero())
            if e.role == .BoostCloud {
                tint: []model.Paint = [model.Paint { material: "Cloud / Strawberry", color: e.color, mix: 0.44 }]
                mount(&mut g, pad, &mut boost, "boost_cloud", &[], &mut boost_meshes, &tint)?
            } else {
                tint: []model.Paint = [model.Paint { material: "Cloud / Meringue", color: e.color, mix: 0.44 }]
                mount(&mut g, pad, &mut cloud, "cloud", &[], &mut cloud_meshes, &tint)?
            }
            course.pads.push(Pad { index: i, node: pad })
        } else if e.role == .SuperButterfly {
            root := g.create_child(nodes[i], zero())
            left := model.joint(&mut g, root, "WingL_", zero())
            right := model.joint(&mut g, root, "WingR_", zero())
            joints: []model.Joint = [left.clone(), right.clone()]
            tint: []model.Paint = [model.Paint { material: "Vesper / Aurora", color: e.color, mix: 0.82 },
                model.Paint { material: "Vesper / Seafoam", color: e.color, mix: 0.61 }]
            mount(&mut g, root, &mut butterfly, "super_butterfly", &joints, &mut wings, &tint)?
            size := e.size.x / 0.60
            g.set_scale(root, core.vec3(size, size, size))
            course.prizes.push(Prize { index: i, root: root, left: left.hinge, right: right.hinge })
        }
    }
    course.cloud_top = walk_surface.build(&cloud, &["Cloud / Pearl"])
    course.boost_top = walk_surface.build(&boost, &["Cloud / Strawberry", "Charm / Gleam", "Charm / Honey"])
    if course.pads.len > 0 || course.prizes.len > 0 { course.effects = particles.build(&mut g) }
    .Ok(move course)
}

struct PadPose { scale: core.Vec3, y: f32 }

fn pad_pose(course: &Course, s: &play.Session, index: i32, sub: f32) -> PadPose {
    e := &s.scene.entities[index]
    boost := e.role == .BoostCloud
    t := (f32(s.tick % 216000) + sub) / f32(play.TICK_RATE)
    since_landing := (f32(s.tick - s.cloud_tick) + sub) / f32(play.TICK_RATE)
    mut squash := core.vec3(1.0, 1.0, 1.0)
    if index == s.last_cloud && since_landing >= 0.0 && since_landing < REBOUND_SECONDS {
        rest := anim.identity()
        impact := anim.sample(&course.impact, since_landing, .Clamp, rest)
        weight: f32 = if boost { 1.0 } else { 0.70 }
        squash = anim.mix(rest, impact, 0.0, 0.0, weight).scale
        // Subtle out-of-phase pillowy wobble ripple across X and Z as the cloud rebounds.
        u := since_landing / REBOUND_SECONDS
        decay := (1.0 - u) * (1.0 - u)
        ripple := (since_landing * 22.0).sin() * decay * weight * 0.046
        squash.x += ripple
        squash.z -= ripple
    }
    // Ease dreamy ambient float and BoostCloud pulse in after tick 0 so spawn poses align with collision tops.
    float_w := smooth(0.0, 0.35, t)
    phase := f32(index) * 1.47
    bob_freq: f32 = if boost { 1.65 } else { 1.18 }
    bob_amp: f32 = if boost { 0.034 } else { 0.024 }
    mut bob := float_w * bob_amp * (t * bob_freq + phase).sin()
    breathe := float_w * 0.012 * (t * 0.95 + phase * 1.3).cos()
    squash.x += breathe
    squash.z -= breathe * 0.65
    if boost {
        pulse := float_w * (0.5 + 0.5 * (t * 3.1 + phase).sin())
        squash.x += 0.038 * pulse
        squash.z += 0.038 * pulse
        squash.y += 0.045 * pulse
        bob += float_w * 0.010 * (t * 3.1 + phase).sin()
    }
    h := e.size.y * 1.9
    PadPose {
        scale: core.vec3(e.size.x * squash.x, h * squash.y, e.size.z * squash.z),
        y: (e.size.y - h) * 0.5 + h * 0.22 * (1.0 - squash.y) + bob
    }
}

pub struct PadSurface { center: core.Vec3, scale: core.Vec3, boost: bool }

pub fn support_surface(course: &Course, s: &play.Session, support: core.Vec3, releasing: bool, exact: bool) -> Option<PadSurface> {
    mut index := play.render_platform(s, exact)
    if releasing && index < 0 {
        for pad in course.pads {
            e := &s.scene.entities[pad.index]
            p := play.position(s, pad.index)
            if (p.y + e.size.y * 0.5 - support.y).abs() <= 0.002 &&
            (support.x - p.x).abs() <= e.size.x * 0.5 + 0.001 && (support.z - p.z).abs() <= e.size.z * 0.5 + 0.001 {
                if index < 0 || pad.index == s.last_cloud { index = pad.index }
                if index == s.last_cloud { break }
            }
        }
    }
    if index < 0 { return .None }
    e := &s.scene.entities[index]
    if !platform(e.role) { return .None }
    center := if exact { play.position(s, index) } else { play.render_position(s, index) }
    pose := pad_pose(course, s, index, play.render_tick_offset(s, exact))
    .Some(PadSurface { center: core.vec3(center.x, center.y + pose.y, center.z), scale: pose.scale, boost: e.role == .BoostCloud })
}

// Return the highest cloud platform top beneath (x, y, z), or 0.0 for the meadow.
pub fn surface_below(course: &Course, s: &play.Session, x: f32, y: f32, z: f32) -> f32 {
    mut best: f32 = 0.0
    mut found := false
    for pad in course.pads {
        if pad.index < 0 || pad.index >= s.scene.entities.len { continue }
        e := &s.scene.entities[pad.index]
        p := play.position(s, pad.index)
        top := p.y + e.size.y * 0.5
        if top <= y + 0.08 &&
        (x - p.x).abs() <= e.size.x * 0.5 + 0.05 &&
        (z - p.z).abs() <= e.size.z * 0.5 + 0.05 {
            if !found || top > best {
                best = top
                found = true
            }
        }
    }
    if !found { return 0.0 }
    best
}

// Return the center of the first BoostCloud entity if present.
pub fn boost_cloud_pos(course: &Course, s: &play.Session) -> Option<core.Vec3> {
    for pad in course.pads {
        if pad.index < 0 || pad.index >= s.scene.entities.len { continue }
        if s.scene.entities[pad.index].role == .BoostCloud {
            return .Some(play.position(s, pad.index))
        }
    }
    .None
}

pub fn animate(g: &mut scene.Graph, course: &Course, s: &play.Session, exact: bool) {
    if course.pads.len == 0 && course.prizes.len == 0 { return }
    sub := play.render_tick_offset(s, exact)
    t := (f32(s.tick % 216000) + sub) / 60.0
    for pad in course.pads {
        pose := pad_pose(course, s, pad.index, sub)
        g.set_scale(pad.node, pose.scale)
        g.set_position(pad.node, core.vec3(0.0, pose.y, 0.0))
    }
    for prize in course.prizes {
        g.set_visible(prize.root, !s.collected[prize.index])
        if s.collected[prize.index] { continue }
        phase := t + f32(prize.index) * 1.83
        g.set_position(prize.root, core.vec3(0.082 * phase.sin(), 0.125 * (phase * 2.5).sin(), 0.068 * (phase * 1.25).cos()))
        g.set_angles(prize.root, 0.07 * phase.sin(), 0.25 * (phase * 1.37).cos(), 0.12 * (phase * 1.67).sin())
        flap := 0.28 + 0.56 * (phase * 8.6).sin() + 0.05 * (phase * 17.2).cos()
        g.set_rotation(prize.left, flap)
        g.set_rotation(prize.right, -flap)
    }
    particles.animate(&mut g, &course.effects, s, exact)
}
