                Selected { dunder: "DstAlpha", constant: "VK_BLEND_FACTOR_DST_ALPHA", comment: "" },
                Selected { dunder: "OneMinusDstAlpha", constant: "VK_BLEND_FACTOR_ONE_MINUS_DST_ALPHA", comment: "" },
            ]
