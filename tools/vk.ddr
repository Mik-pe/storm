        // VkBlendOp
        SelectedEnum {
            dunder: "BlendOp", block: "VkBlendOp", comment: "", variants: [
                Selected { dunder: "Add", constant: "VK_BLEND_OP_ADD", comment: "" },
                Selected { dunder: "Subtract", constant: "VK_BLEND_OP_SUBTRACT", comment: "" },
                Selected { dunder: "ReverseSubtract", constant: "VK_BLEND_OP_REVERSE_SUBTRACT", comment: "" },
                Selected { dunder: "Min", constant: "VK_BLEND_OP_MIN", comment: "" },
                Selected { dunder: "Max", constant: "VK_BLEND_OP_MAX", comment: "keep the surface closest to the sun" },
            ]
        },
        // VkFilter
        SelectedEnum {
            dunder: "Filter", block: "VkFilter", comment: "", variants: [
                Selected { dunder: "Nearest", constant: "VK_FILTER_NEAREST", comment: "" },
                Selected { dunder: "Linear", constant: "VK_FILTER_LINEAR", comment: "" },
            ]
        },
        // VkSamplerMipmapMode
        SelectedEnum {
            dunder: "SamplerMipmapMode", block: "VkSamplerMipmapMode", comment: "", variants: [
                Selected { dunder: "Nearest", constant: "VK_SAMPLER_MIPMAP_MODE_NEAREST", comment: "" },
