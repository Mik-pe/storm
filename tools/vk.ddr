                Selected { dunder: "ClampToEdge", constant: "VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE", comment: "" },
                Selected { dunder: "ClampToBorder", constant: "VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_BORDER", comment: "" },
            ]
        },
        // VkPrimitiveTopology
        SelectedEnum {
            dunder: "PrimitiveTopology", block: "VkPrimitiveTopology", comment: "", variants: [
                Selected { dunder: "PointList", constant: "VK_PRIMITIVE_TOPOLOGY_POINT_LIST", comment: "" },
                Selected { dunder: "LineList", constant: "VK_PRIMITIVE_TOPOLOGY_LINE_LIST", comment: "" },
                Selected { dunder: "LineStrip", constant: "VK_PRIMITIVE_TOPOLOGY_LINE_STRIP", comment: "" },
                Selected { dunder: "TriangleList", constant: "VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST", comment: "" },
                Selected { dunder: "TriangleStrip", constant: "VK_PRIMITIVE_TOPOLOGY_TRIANGLE_STRIP", comment: "" },
