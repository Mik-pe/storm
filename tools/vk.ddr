        },
        // VkImageUsageFlagBits
        SelectedEnum {
            dunder: "ImageUsage", block: "VkImageUsageFlagBits", comment: "", variants: [
                Selected { dunder: "TransferSrc", constant: "VK_IMAGE_USAGE_TRANSFER_SRC_BIT", comment: "" },
                Selected { dunder: "TransferDst", constant: "VK_IMAGE_USAGE_TRANSFER_DST_BIT", comment: "" },
                Selected { dunder: "Sampled", constant: "VK_IMAGE_USAGE_SAMPLED_BIT", comment: "" },
                Selected { dunder: "ColorAttachment", constant: "VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT", comment: "" },
                Selected { dunder: "DepthStencilAttachment", constant: "VK_IMAGE_USAGE_DEPTH_STENCIL_ATTACHMENT_BIT", comment: "" },
                Selected { dunder: "ColorAttachmentTransferSrc", constant: "", comment: "Combined sets Storm builds images with (flags, so written as sums)." },
                Selected { dunder: "ColorAttachmentSampled", constant: "", comment: "COLOR_ATTACHMENT | SAMPLED: env/irradiance cubes" },
                Selected { dunder: "TransferDstSampled", constant: "", comment: "TRANSFER_DST | SAMPLED: uploaded BRDF LUT" },
                Selected { dunder: "TransferSrcTransferDstSampled", constant: "", comment: "uploaded material textures (mip chain by blit)" },
            ]
        },
        // VkBufferUsageFlagBits
        SelectedEnum {
            dunder: "BufferUsage", block: "VkBufferUsageFlagBits", comment: "", variants: [
                Selected { dunder: "TransferSrc", constant: "VK_BUFFER_USAGE_TRANSFER_SRC_BIT", comment: "" },
                Selected { dunder: "TransferDst", constant: "VK_BUFFER_USAGE_TRANSFER_DST_BIT", comment: "" },
                Selected { dunder: "UniformBuffer", constant: "VK_BUFFER_USAGE_UNIFORM_BUFFER_BIT", comment: "" },
                Selected { dunder: "VertexBuffer", constant: "VK_BUFFER_USAGE_VERTEX_BUFFER_BIT", comment: "" },
            ]
        },
        // VkImageCreateFlagBits
        SelectedEnum {
            dunder: "ImageCreate", block: "VkImageCreateFlagBits", comment: "", variants: [
                Selected { dunder: "MutableFormat", constant: "VK_IMAGE_CREATE_MUTABLE_FORMAT_BIT", comment: "" },
                Selected { dunder: "CubeCompatible", constant: "VK_IMAGE_CREATE_CUBE_COMPATIBLE_BIT", comment: "" },
            ]
        },
        // VkFenceCreateFlagBits
        SelectedEnum {
            dunder: "Fence", block: "VkFenceCreateFlagBits", comment: "", variants: [
                Selected { dunder: "Signaled", constant: "VK_FENCE_CREATE_SIGNALED_BIT", comment: "" },
            ]
        },
        // VkColorComponentFlagBits
        SelectedEnum {
            dunder: "ColorComponent", block: "VkColorComponentFlagBits", comment: "", variants: [
                Selected { dunder: "RGBA", constant: "", comment: "R | G | B | A" },
            ]
        },
        // VkSampleCountFlagBits
        SelectedEnum {
            dunder: "Samples", block: "VkSampleCountFlagBits", comment: "", variants: [
                Selected { dunder: "Type1", constant: "VK_SAMPLE_COUNT_1_BIT", comment: "" },
            ]
        },
        // VkFormat
        SelectedEnum {
            dunder: "Format", block: "VkFormat", comment: "", variants: [
                Selected { dunder: "Undefined", constant: "VK_FORMAT_UNDEFINED", comment: "" },
                Selected { dunder: "R8G8B8A8_UNORM", constant: "VK_FORMAT_R8G8B8A8_UNORM", comment: "" },
                Selected { dunder: "R8G8B8A8_SRGB", constant: "VK_FORMAT_R8G8B8A8_SRGB", comment: "" },
                Selected { dunder: "R16G16_SFLOAT", constant: "VK_FORMAT_R16G16_SFLOAT", comment: "" },
                Selected { dunder: "R16G16B16A16_SFLOAT", constant: "VK_FORMAT_R16G16B16A16_SFLOAT", comment: "" },
                Selected { dunder: "R32_SFLOAT", constant: "VK_FORMAT_R32_SFLOAT", comment: "" },
                Selected { dunder: "R32G32_SFLOAT", constant: "VK_FORMAT_R32G32_SFLOAT", comment: "" },
                Selected { dunder: "R32G32B32_SFLOAT", constant: "VK_FORMAT_R32G32B32_SFLOAT", comment: "" },
                Selected { dunder: "R32G32B32A32_SFLOAT", constant: "VK_FORMAT_R32G32B32A32_SFLOAT", comment: "" },
                Selected { dunder: "B8G8R8A8_UNORM", constant: "VK_FORMAT_B8G8R8A8_UNORM", comment: "" },
                Selected { dunder: "B8G8R8A8_SRGB", constant: "VK_FORMAT_B8G8R8A8_SRGB", comment: "" },
                Selected { dunder: "D32_SFLOAT", constant: "VK_FORMAT_D32_SFLOAT", comment: "" },
            ]
        },
        // VkResult
        SelectedEnum {
            dunder: "VkResult", block: "VkResult", comment: "VkResult as a Dunder enum, the codes Storm can act on. Negative values are errors; SUBOPTIMAL_KHR is a success the swapchain should still be rebuilt for. Do not cast an unknown code into the enum (it panics silently, exit 108): match the integer.", variants: [
                Selected { dunder: "Success", constant: "VK_SUCCESS", comment: "" },
                Selected { dunder: "NotReady", constant: "VK_NOT_READY", comment: "" },
                Selected { dunder: "Timeout", constant: "VK_TIMEOUT", comment: "" },
                Selected { dunder: "Incomplete", constant: "VK_INCOMPLETE", comment: "" },
                Selected { dunder: "ErrorOutOfHostMemory", constant: "VK_ERROR_OUT_OF_HOST_MEMORY", comment: "" },
                Selected { dunder: "ErrorOutOfDeviceMemory", constant: "VK_ERROR_OUT_OF_DEVICE_MEMORY", comment: "" },
                Selected { dunder: "ErrorInitializationFailed", constant: "VK_ERROR_INITIALIZATION_FAILED", comment: "" },
                Selected { dunder: "ErrorDeviceLost", constant: "VK_ERROR_DEVICE_LOST", comment: "" },
                Selected { dunder: "ErrorMemoryMapFailed", constant: "VK_ERROR_MEMORY_MAP_FAILED", comment: "" },
                Selected { dunder: "ErrorLayerNotPresent", constant: "VK_ERROR_LAYER_NOT_PRESENT", comment: "" },
                Selected { dunder: "ErrorExtensionNotPresent", constant: "VK_ERROR_EXTENSION_NOT_PRESENT", comment: "" },
                Selected { dunder: "ErrorFeatureNotPresent", constant: "VK_ERROR_FEATURE_NOT_PRESENT", comment: "" },
                Selected { dunder: "ErrorIncompatibleDriver", constant: "VK_ERROR_INCOMPATIBLE_DRIVER", comment: "" },
                Selected { dunder: "ErrorFormatNotSupported", constant: "VK_ERROR_FORMAT_NOT_SUPPORTED", comment: "" },
                Selected { dunder: "ErrorUnknown", constant: "VK_ERROR_UNKNOWN", comment: "" },
                Selected { dunder: "SuboptimalKHR", constant: "VK_SUBOPTIMAL_KHR", comment: "" },
                Selected { dunder: "ErrorOutOfDateKHR", constant: "VK_ERROR_OUT_OF_DATE_KHR", comment: "" },
                Selected { dunder: "ErrorSurfaceLostKHR", constant: "VK_ERROR_SURFACE_LOST_KHR", comment: "" },
                Selected { dunder: "ErrorNativeWindowInUseKHR", constant: "VK_ERROR_NATIVE_WINDOW_IN_USE_KHR", comment: "" },
                Selected { dunder: "ErrorValidationFailedEXT", constant: "VK_ERROR_VALIDATION_FAILED", comment: "" },
            ]
        },
        // VkAccessFlagBits
        SelectedEnum {
            dunder: "Access", block: "VkAccessFlagBits", comment: "", variants: [
                Selected { dunder: "None", constant: "VK_ACCESS_NONE", comment: "" },
                Selected { dunder: "IndirectCommandRead", constant: "VK_ACCESS_INDIRECT_COMMAND_READ_BIT", comment: "" },
                Selected { dunder: "IndexRead", constant: "VK_ACCESS_INDEX_READ_BIT", comment: "" },
                Selected { dunder: "VertexAttributeRead", constant: "VK_ACCESS_VERTEX_ATTRIBUTE_READ_BIT", comment: "" },
                Selected { dunder: "UniformRead", constant: "VK_ACCESS_UNIFORM_READ_BIT", comment: "" },
                Selected { dunder: "InputAttachmentRead", constant: "VK_ACCESS_INPUT_ATTACHMENT_READ_BIT", comment: "" },
                Selected { dunder: "ShaderRead", constant: "VK_ACCESS_SHADER_READ_BIT", comment: "" },
                Selected { dunder: "ShaderWrite", constant: "VK_ACCESS_SHADER_WRITE_BIT", comment: "" },
                Selected { dunder: "ColorAttachmentRead", constant: "VK_ACCESS_COLOR_ATTACHMENT_READ_BIT", comment: "" },
                Selected { dunder: "ColorAttachmentWrite", constant: "VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT", comment: "" },
                Selected { dunder: "DepthStencilAttachmentRead", constant: "VK_ACCESS_DEPTH_STENCIL_ATTACHMENT_READ_BIT", comment: "" },
                Selected { dunder: "DepthStencilAttachmentWrite", constant: "VK_ACCESS_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT", comment: "" },
                Selected { dunder: "TransferRead", constant: "VK_ACCESS_TRANSFER_READ_BIT", comment: "" },
                Selected { dunder: "TransferWrite", constant: "VK_ACCESS_TRANSFER_WRITE_BIT", comment: "" },
                Selected { dunder: "HostRead", constant: "VK_ACCESS_HOST_READ_BIT", comment: "" },
                Selected { dunder: "HostWrite", constant: "VK_ACCESS_HOST_WRITE_BIT", comment: "" },
                Selected { dunder: "MemoryRead", constant: "VK_ACCESS_MEMORY_READ_BIT", comment: "" },
                Selected { dunder: "MemoryWrite", constant: "VK_ACCESS_MEMORY_WRITE_BIT", comment: "" },
                Selected { dunder: "ColorDepthWrite", constant: "", comment: "Combined masks Storm's barriers use. COLOR_ATTACHMENT_WRITE | DEPTH_STENCIL_ATTACHMENT_WRITE" },
            ]
        },
    ]
}

// The bits a combined variant sums, with the registry's spelling of each.
fn flag_sets() -> []FlagSet {
    [
        FlagSet { dunder: "ColorAndDepthStages", bits: ["VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT", "VK_PIPELINE_STAGE_EARLY_FRAGMENT_TESTS_BIT", "VK_PIPELINE_STAGE_LATE_FRAGMENT_TESTS_BIT"] },
        FlagSet { dunder: "VertexFragment", bits: ["VK_SHADER_STAGE_FRAGMENT_BIT", "VK_SHADER_STAGE_VERTEX_BIT"] },
        FlagSet { dunder: "ColorAttachmentTransferSrc", bits: ["VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT", "VK_IMAGE_USAGE_TRANSFER_SRC_BIT"] },
        FlagSet { dunder: "ColorAttachmentSampled", bits: ["VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT", "VK_IMAGE_USAGE_SAMPLED_BIT"] },
        FlagSet { dunder: "TransferDstSampled", bits: ["VK_IMAGE_USAGE_SAMPLED_BIT", "VK_IMAGE_USAGE_TRANSFER_DST_BIT"] },
        FlagSet { dunder: "TransferSrcTransferDstSampled", bits: ["VK_IMAGE_USAGE_SAMPLED_BIT", "VK_IMAGE_USAGE_TRANSFER_DST_BIT", "VK_IMAGE_USAGE_TRANSFER_SRC_BIT"] },
        FlagSet { dunder: "RGBA", bits: ["VK_COLOR_COMPONENT_A_BIT", "VK_COLOR_COMPONENT_B_BIT", "VK_COLOR_COMPONENT_G_BIT", "VK_COLOR_COMPONENT_R_BIT"] },
        FlagSet { dunder: "ColorDepthWrite", bits: ["VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT", "VK_ACCESS_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT"] },
        FlagSet { dunder: "HostVisibleCoherent", bits: ["VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT", "VK_MEMORY_PROPERTY_HOST_COHERENT_BIT"] },
    ]
}

// Where each generated file goes, by the name the last argument accepts.
const API_TARGET: string = "packages/storm-vk/src/api.ddr"
const LAYOUT_TARGET: string = "packages/storm-vk/src/layout.ddr"
const ENUMS_TARGET: string = "packages/storm-vk/src/enums.ddr"

struct Param { type_name: string, pointer: bool, name: string }
struct Command { name: string, params: []Param, returns: string }
struct Extension { name: string, depends: string, number: i64 }
// `array` is the text between a member's brackets, "" when it is not an array.
struct Member { type_name: string, pointer: bool, name: string, array: string }
// `structure_type` is the VkStructureType name the registry gives the record's
// sType member, "" when the record has none.
struct Record { name: string, members: []Member, union: bool, structure_type: string }
// One registry enum constant: the block it extends and its number.
struct Constant { block: string, value: i64 }
// One line of a Dunder enum: a variant and the registry names it stands for.
struct Variant { name: string, constants: []string }

// Everything the registry says, indexed by name.
struct Registry {
    commands: map.Map<string, Command>,
    provider: map.Map<string, string>,
    extensions: []Extension,
    typedefs: map.Map<string, string>,
    handles: map.Map<string, bool>,
    enums: map.Map<string, bool>,
    // An enum block holding a negative value is signed in C by its values,
    // so i32 in Dunder; every other enum is u32. VkResult is the one Storm
    // binds (its errors are the `dir="-"` form, negative), and it is what
    // keeps every `-> i32` prototype: with "every enum is u32" the generator
    // rewrote 40 of them to `-> u32` in one run.
    signed: map.Map<string, bool>,
    records: map.Map<string, Record>,
    constants: map.Map<string, Constant>,
    blocks: map.Map<string, []string>,
    aliases: map.Map<string, string>,
}

// ---- bytes -------------------------------------------------------------------

// Offset of `needle` in `data` within `[from, until)`, -1 when absent. Every
// lookup inside an element passes that element's end: a `<param>` of prose has
// no `<type>`, and an unbounded search for one runs to the end of the file.
fn find_bytes(data: &[]u8, from: i32, until: i32, needle: string) -> i32 {
    mut target: []u8 = bytes.from_text(needle)
    mut i := from
    while i + target.len <= until {
        if bytes.equal_ranges(data, i, i + target.len, &target, 0, target.len) { return i }
        i += 1
    }
    -1
}

// The text from `start` to `end` in `data`. Both offsets sit on tag
// boundaries, which are ASCII, so the view is always valid UTF-8.
fn text_at(data: &[]u8, start: i32, end: i32) -> string {
    bytes.decode_range(data, start, end).unwrap_or_default()
}

// Text between the first `<tag>` after `from` and its `</tag>`; "" when absent.
fn inner(data: &[]u8, from: i32, end: i32, tag: string) -> string {
    open := find_bytes(data, from, end, "<" + tag + ">")
    if open < 0 { return "" }
    start := open + tag.len + 2
    close := find_bytes(data, start, end, "</" + tag + ">")
    if close < 0 { return "" }
    text_at(data, start, close)
}

// Value of `key="…"` among a tag's attributes, which run from `tag_start` to
// `tag_end`.
fn attribute(data: &[]u8, tag_start: i32, tag_end: i32, key: string) -> string {
    start := find_bytes(data, tag_start, tag_end, key + "=\"")
    if start < 0 { return "" }
    value := start + key.len + 2
    stop := find_bytes(data, value, tag_end, "\"")
    if stop < 0 { return "" }
    text_at(data, value, stop)
}

// One tag as the scanner sees it: `name` is `type` for `<type …>` and
// `/type` for `</type>`; `body_start` is the offset after `>`. A self-closing
// `<command name="…"/>` has `closing` false and `empty` true.
struct Tag { name: string, start: i32, attr_start: i32, attr_end: i32, body_start: i32, closing: bool, empty: bool }

// The next tag at or after `from`, or a Tag with `start` -1.
fn next_tag(data: &[]u8, from: i32) -> Tag {
    start := find_bytes(data, from, data.len, "<")
    if start < 0 { return Tag { name: "", start: -1, attr_start: 0, attr_end: 0, body_start: 0, closing: false, empty: false } }
    mut end := start + 1
    while end < data.len && data[end] != 62 { end += 1 }
    empty := end > start && data[end - 1] == 47
    closing := start + 1 < data.len && data[start + 1] == 47
    name_start := start + if closing { 2 } else { 1 }
    mut name_end := name_start
    while name_end < end && data[name_end] != 32 && data[name_end] != 47 && data[name_end] != 62 { name_end += 1 }
    Tag {
        name: text_at(data, name_start, name_end),
        start: start,
        attr_start: name_end,
        attr_end: if empty { end - 1 } else { end },
        body_start: end + 1,
        closing: closing,
        empty: empty,
    }
}

// The first opening tag called `name` at or after `from`; `start` is -1 when absent.
fn find_open(data: &[]u8, from: i32, name: string) -> Tag {
    mut at := from
    while at < data.len {
        t := next_tag(data, at)
        if t.start < 0 { break }
        at = t.body_start
        if !t.closing && !t.empty && t.name == name { return t }
    }
    Tag { name: "", start: -1, attr_start: 0, attr_end: 0, body_start: 0, closing: false, empty: false }
}

// Offset just past the `</name>` that closes the element whose opening tag is
// `open`, counting nested elements of the same name. `name` is "command" for
// `<command>`, so the body of a command may contain anything but a command.
fn close_of(data: &[]u8, open: &Tag) -> i32 {
    // A self-closing tag and a closing tag both end where their `>` does;
    // scanning from a closing tag would run to the end of the file, because
    // the matching opener lies before it.
    if open.empty || open.closing { return open.body_start }
    mut depth := 1
    mut at := open.body_start
    while at < data.len {
        t := next_tag(data, at)
        if t.start < 0 { return -1 }
        at = t.body_start
        if t.name != open.name || t.empty { continue }
        if t.closing { depth -= 1 } else { depth += 1 }
        if depth == 0 { return at }
    }
    -1
}

// The direct children of the element `open` (whose body ends at `close`) whose
// tag is `name`, as byte ranges of their bodies. Depth matters: a <command>
// holds <param> elements and also an <implicitexternsyncparams> whose <param>
// elements are prose about synchronization, not parameters.
fn children(data: &[]u8, open: &Tag, close: i32, name: string) -> []Tag {
    mut out: []Tag = []
    mut at := open.body_start
    while at < close {
        t := next_tag(data, at)
        if t.start < 0 || t.body_start > close { break }
        // Every element's subtree is stepped over as a whole, named or not, so a
        // descendant is never mistaken for a sibling.
        child_close := close_of(data, &t)
        at = if child_close > t.body_start { child_close } else { t.body_start }
        if t.closing || t.name != name { continue }
        out.push(t.clone())
    }
    out
}

// Whether a `<param api="…">` or `<member api="…">` variant applies to
// Vulkan. The registry lists one per API profile when they differ, as a
// comma-separated list (`api="vulkan,vulkanbase"` versus `api="vulkansc"`);
// one without `api` applies to every profile. Profiles are compared as whole
// names: "vulkansc" is another API that merely shares a prefix.
fn applies_to_vulkan(data: &[]u8, t: &Tag) -> bool {
    apis := attribute(data, t.attr_start, t.attr_end, "api")
    if apis == "" { return true }
    for profile in text.split(apis, ",") {
        if text.trim(profile) == "vulkan" { return true }
    }
    false
}

// ---- scanning ----------------------------------------------------------------

// `<type category="basetype">typedef <type>uint64_t</type> <name>VkDeviceSize</name>;</type>`,
// `<type category="handle"><type>VK_DEFINE_HANDLE</type>(<name>VkInstance</name>)</type>`, and
// `<type category="struct" name="VkExtent3D"><member><type>uint32_t</type> <name>width</name></member> …</type>`.
fn scan_types(data: &[]u8, r: &mut Registry) {
    // <types> … </types> holds every <type category="…"> element.
    types_open := find_open(data, 0, "types")
    if types_open.start < 0 { return }
    types_close := close_of(data, &types_open)
    if types_close < 0 { return }
    for t in children(data, &types_open, types_close, "type") {
        close := close_of(data, &t)
        if close < 0 { continue }
        category := attribute(data, t.attr_start, t.attr_end, "category")
        if category == "basetype" {
            name := inner(data, t.body_start, close, "name")
            base := inner(data, t.body_start, close, "type")
            if name != "" && base != "" { r.typedefs.put(name.clone(), base.clone()) }
        } else if category == "handle" {
            name := inner(data, t.body_start, close, "name")
            if name != "" { r.handles.put(name.clone(), true) }
        } else if category == "enum" {
            // <type category="enum" name="VkStructureType"/>: the name is an
            // attribute and the element is empty, so the registry says which
            // type names are enums, and no reader has to infer it from silence.
            name := attribute(data, t.attr_start, t.attr_end, "name")
            if name != "" { r.enums.put(name.clone(), true) }
        } else if category == "bitmask" {
            // <type category="bitmask">typedef <type>VkFlags</type> <name>VkImageUsageFlags</name>;</type>
            // is a typedef the registry marks as a flag set, and
            // <type category="bitmask" name="VkGeometryFlagsNV" alias="VkGeometryFlagsKHR"/>
            // is another name for one. Both are followed to the width, so a
            // VkFlags64 set stays 64 bits because the registry says so.
            name := inner(data, t.body_start, close, "name")
            base := inner(data, t.body_start, close, "type")
            alias := attribute(data, t.attr_start, t.attr_end, "alias")
            if name != "" && base != "" { r.typedefs.put(name.clone(), base.clone()) }
            if name != "" && alias != "" { r.typedefs.put(name.clone(), alias.clone()) }
        } else if category == "struct" || category == "union" {
            // A record's name is an attribute, not a child element.
            name := attribute(data, t.attr_start, t.attr_end, "name")
            if name == "" { continue }
            scan_record(data, &t, close, name, category == "union", &mut r)
        }
    }
}

// The members of one record, in registry order. The member named sType carries
// the record's structure type in `values="VK_STRUCTURE_TYPE_…"`.
fn scan_record(data: &[]u8, open: &Tag, close: i32, name: string, union: bool, r: &mut Registry) {
    mut members: []Member = []
    mut structure_type := ""
    for m in children(data, open, close, "member") {
        m_close := close_of(data, &m)
        if m_close < 0 { continue }
        if !applies_to_vulkan(data, &m) { continue }
        member := parse_member(data, m.body_start, m_close)
        // A <member> without a <type> is not a member.
        if member.type_name == "" { continue }
        if member.name == "sType" {
            structure_type = attribute(data, m.attr_start, m.attr_end, "values")
        }
        members.push(member.clone())
    }
    r.records.put(name.clone(), Record { name: name.clone(), members: members, union: union, structure_type: structure_type })
}

// The number of a `value="…"` attribute: decimal, `0x…` (neither parse.integer
// nor parse.hex reads a radix prefix, so the prefix is cut), or the one C expression the registry writes, `(~0U)` (all
// bits set, VK_SUBPASS_EXTERNAL). `ok` is false for the float enums of Vulkan
// 1.3 (`0.25f`), which are no C enum and nothing Storm converts.
fn enum_value(value_text: string) -> parse.Integer {
    if value_text == "(~0U)" || value_text == "(~0ULL)" {
        return parse.Integer { ok: true, value: 4294967295, error: 0 }
    }
    if text.starts_with(value_text.clone(), "0x") { return parse.hex(value_text[2..value_text.len].clone()) }
    parse.integer(value_text)
}

// Every `<enums>` block's `<enum name="…" value="N" />`; an `alias="…"` entry
// repeats a name and is recorded as an alias instead. Bitmask blocks carry
// `bitpos=` instead, and the value is 1 << bitpos. The numbers are i64 so that
// VK_STRUCTURE_TYPE_SWAPCHAIN_CREATE_INFO_KHR (1000001001) fits. Each constant
// remembers its block, which is how a Dunder enum's variants are found.
fn scan_enums(data: &[]u8, r: &mut Registry) {
    mut at := 0
    while at < data.len {
        block := find_open(data, at, "enums")
        if block.start < 0 { break }
        block_close := close_of(data, &block)
        if block_close < 0 { break }
        at = block_close
        block_name := attribute(data, block.attr_start, block.attr_end, "name")
        if block_name == "" { continue }
        r.blocks.put(block_name.clone(), [])
        for e in children(data, &block, block_close, "enum") {
            name := attribute(data, e.attr_start, e.attr_end, "name")
            if name == "" { continue }
            alias := attribute(data, e.attr_start, e.attr_end, "alias")
            if alias != "" {
                r.aliases.put(name.clone(), alias.clone())
                continue
            }
            if !applies_to_vulkan(data, &e) { continue }
            value := enum_value(attribute(data, e.attr_start, e.attr_end, "value"))
            bitpos := parse.integer(attribute(data, e.attr_start, e.attr_end, "bitpos"))
            if !value.ok && !bitpos.ok { continue }
            put_constant(&mut r, name, block_name.clone(), if value.ok { value.value } else { i64(1).shl(i32(bitpos.value)) })
        }
    }
}

// `<param optional="true">const <type>VkAllocationCallbacks</type>* <name>pAllocator</name></param>`:
// the type is whatever the tag holds, the stars after it are the pointer.
fn parse_param(data: &[]u8, start: i32, end: i32) -> Param {
    type_name := inner(data, start, end, "type")
    name := inner(data, start, end, "name")
    type_close := find_bytes(data, start, end, "</type>")
    name_open := find_bytes(data, start, end, "<name>")
    mut pointer := false
    if type_close >= 0 && name_open > type_close {
        for i in type_close + 7..name_open { if data[i] == 42 { pointer = true } }
    }
    Param { type_name: type_name, pointer: pointer, name: name }
}

// `<member><type>VkOffset3D</type> <name>srcOffsets</name>[2]<comment>…</comment></member>`:
// a parameter, plus the text between the brackets after `</name>` when there
// is one (a number, or an enum name the registry defines). Only brackets that
// follow `</name>` through whitespace count: a member's comment may hold a
// `[` of its own (`BUFFER[_DYNAMIC]`). The registry writes a named length two
// ways, `[VK_MAX_MEMORY_HEAPS]` and `[<enum>VK_MAX_MEMORY_HEAPS</enum>]`; the
// second is the first wrapped in its element tag, so the wrapper is removed
// and the length is the name. Anything else between the brackets stays as it
// is, and the caller reports it rather than guessing a length.
fn parse_member(data: &[]u8, start: i32, end: i32) -> Member {
    p := parse_param(data, start, end)
    mut array := ""
    name_close := find_bytes(data, start, end, "</name>")
    if name_close >= 0 {
        mut at := name_close + 7
        while at < end && (data[at] == 32 || data[at] == 9 || data[at] == 10 || data[at] == 13) { at += 1 }
        if at < end && data[at] == 91 {
            stop := find_bytes(data, at, end, "]")
            if stop > at + 1 {
                array = text_at(data, at + 1, stop)
                enum_open := find_bytes(data, at + 1, stop, "<enum>")
                enum_close := find_bytes(data, at + 1, stop, "</enum>")
                if enum_open == at + 1 && enum_close > enum_open + 6 && enum_close + 7 == stop {
                    array = text_at(data, enum_open + 6, enum_close)
                }
            }
        }
    }
    Member { type_name: p.type_name, pointer: p.pointer, name: p.name, array: array }
}

// `<command …><proto><type>VkResult</type> <name>vkCreateImage</name></proto>
//  <param>const <type>VkImageCreateInfo</type>* <name>pCreateInfo</name></param> …</command>`
// Every <command> sits under <commands>, in a <command> or an extension's
// <require>; nested commands never occur, so the walk is flat.
fn scan_commands(data: &[]u8, r: &mut Registry) {
    commands_open := find_open(data, 0, "commands")
    if commands_open.start < 0 { return }
    commands_close := close_of(data, &commands_open)
    if commands_close < 0 { return }
    for cmd in children(data, &commands_open, commands_close, "command") {
        cmd_close := close_of(data, &cmd)
        if cmd_close < 0 { continue }
        for proto in children(data, &cmd, cmd_close, "proto") {
            proto_close := close_of(data, &proto)
            if proto_close < 0 { continue }
            mut returns := inner(data, proto.body_start, proto_close, "type")
            if returns == "" { returns = "void" }
            name := inner(data, proto.body_start, proto_close, "name")
            if name == "" || !text.starts_with(name, "vk") { continue }
            mut params: []Param = []
            for param in children(data, &cmd, cmd_close, "param") {
                if !applies_to_vulkan(data, &param) { continue }
                param_close := close_of(data, &param)
                if param_close < 0 { continue }
                parsed := parse_param(data, param.body_start, param_close)
                // A <param> without a <type> is not a parameter (the registry
                // uses <param> for prose inside <implicitexternsyncparams>).
                if parsed.type_name == "" { continue }
                params.push(parsed.clone())
            }
            r.commands.put(name[2..name.len].clone(), Command { name: name.clone(), params: params, returns: returns.clone() })
        }
    }
}

// `<extension name="VK_KHR_swapchain" number="2" … depends="VK_KHR_surface" …>` blocks
// list what they provide as `<command name="vkCreateSwapchainKHR"/>`, inside
// <require> elements that may themselves depend on another extension. They
// also extend registry enums: `<enum name="VK_STRUCTURE_TYPE_PRESENT_INFO_KHR"
// extends="VkStructureType" offset="1"/>` has no value, it is computed —
// 1000000000 + (number − 1) × 1000 + offset, with the extension's own
// `extnumber` attribute in place of `number` when it has one, and negated
// for `dir="-"` (VkResult's extension errors). An extension enum with a
// `value=` instead of an `offset=` (VK_PIPELINE_STAGE_NONE, from
// VK_KHR_synchronization2) has its number written out, and an `alias=`
// names the constant it repeats. An `api="…"` variant applies to Vulkan by
// the same rule as a parameter.
//
// One `<enum>` inside an extension or a feature: an `alias` names the constant
// it repeats; a `value` is written out (VK_PIPELINE_STAGE_NONE = 0); otherwise
// the number is 1000000000 + (extnumber − 1) × 1000 + offset, the number being
// the extension's — this element's, or the one the enclosing `<require
// extension="…">` names — negated by `dir="-"`. A `<require extension="…">`
// in a feature's promotion list is how VK_SUBOPTIMAL_KHR is declared.
fn extension_enum(r: &mut Registry, data: &[]u8, t: &Tag, base: i64) {
    ename := attribute(data, t.attr_start, t.attr_end, "name")
    if ename == "" { return }
    alias := attribute(data, t.attr_start, t.attr_end, "alias")
    if alias != "" {
        r.aliases.put(ename.clone(), alias.clone())
        return
    }
    if !applies_to_vulkan(data, t) { return }
    block := attribute(data, t.attr_start, t.attr_end, "extends")
    if block == "" { return }
    written := enum_value(attribute(data, t.attr_start, t.attr_end, "value"))
    offset := parse.integer(attribute(data, t.attr_start, t.attr_end, "offset"))
    if written.ok {
        put_constant(&mut r, ename, block, written.value)
        return
    }
    if !offset.ok { return }
    mut number := base
    extnumber := parse.integer(attribute(data, t.attr_start, t.attr_end, "extnumber"))
    if extnumber.ok { number = extnumber.value }
    if number <= 0 { return }
    mut value := 1000000000 + (number - 1) * 1000 + offset.value
    if attribute(data, t.attr_start, t.attr_end, "dir") == "-" { value = 0 - value }
    put_constant(&mut r, ename, block, value)
}

// The extension's number, as the base of its enums' offsets; -1 when it has none.
fn extension_number(data: &[]u8, t: &Tag) -> i64 {
    number := parse.integer(attribute(data, t.attr_start, t.attr_end, "number"))
    if number.ok { return number.value }
    -1
}

// `<extension>` elements, and the `<feature>` elements that promote an
// extension's enums: both hold `<enum extends="…" offset="…"/>` whose number
// is the extension's. Only an extension carries a `number`; a feature's
// `<require extension="VK_KHR_swapchain">` names the one to use.
fn scan_extensions(data: &[]u8, r: &mut Registry) {
    root_open := find_open(data, 0, "extensions")
    if root_open.start < 0 { return }
    root_close := close_of(data, &root_open)
    if root_close < 0 { return }
    for ext in children(data, &root_open, root_close, "extension") {
        ext_close := close_of(data, &ext)
        if ext_close < 0 { continue }
        name := attribute(data, ext.attr_start, ext.attr_end, "name")
        if name == "" { continue }
        number := extension_number(data, &ext)
        r.extensions.push(Extension { name: name.clone(), depends: attribute(data, ext.attr_start, ext.attr_end, "depends"), number: number })
        // Walk the whole extension body for <command …/> and <enum …/> at any depth.
        mut cat := ext.body_start
        while cat < ext_close {
            t := next_tag(data, cat)
            if t.start < 0 || t.body_start > ext_close { break }
            cat = t.body_start
            if t.closing { continue }
            if t.name == "command" {
                cname := attribute(data, t.attr_start, t.attr_end, "name")
                if text.starts_with(cname, "vk") { r.provider.put(cname[2..cname.len].clone(), name.clone()) }
            } else if t.name == "enum" {
                extension_enum(&mut r, data, &t, number)
            }
        }
    }
    // Features: a <require extension="…"> inside one holds that extension's enums.
    mut at := 0
    while at < data.len {
        feature := find_open(data, at, "feature")
        if feature.start < 0 { break }
        feature_close := close_of(data, &feature)
        if feature_close < 0 { break }
        at = feature_close
        mut cat := feature.body_start
        while cat < feature_close {
            t := next_tag(data, cat)
            if t.start < 0 || t.body_start > feature_close { break }
            cat = t.body_start
            if t.closing || t.name != "require" { continue }
            // A feature's <require> promotes an extension's enums: the number
            // comes from the extension it names, or is written out (NONE = 0).
            named := attribute(data, t.attr_start, t.attr_end, "extension")
            base := if named == "" { i64(-1) } else { extension_number_named(r, named.clone()) }
            req_close := close_of(data, &t)
            if req_close < 0 { continue }
            mut rat := t.body_start
            while rat < req_close {
                e := next_tag(data, rat)
                if e.start < 0 || e.body_start > req_close { break }
                rat = e.body_start
                if e.closing || e.name != "enum" { continue }
                extension_enum(&mut r, data, &e, base)
            }
        }
    }
}

// The number of the extension `named`, from the registry's extension list; -1 when unknown.
fn extension_number_named(r: &Registry, named: string) -> i64 {
    for e in &r.extensions {
        if e.name == named { return e.number }
    }
    -1
}

// One enum constant and the block it belongs to, in both tables: by name for a
// lookup, and in its block's list for the order the registry declares.
fn put_constant(r: &mut Registry, name: string, block: string, value: i64) {
    r.constants.put(name.clone(), Constant { block: block.clone(), value: value })
    if value < 0 { r.signed.put(block.clone(), true) }
    if !r.blocks.contains(block.clone()) { r.blocks.put(block.clone(), []) }
    mut names := r.blocks.get(block.clone()).unwrap()
    names.push(name.clone())
    r.blocks.put(block.clone(), names.clone())
}

fn registry(data: &[]u8) -> Registry {
    mut r := Registry {
        commands: map.Map<string, Command>::new(),
        provider: map.Map<string, string>::new(),
        extensions: [],
        typedefs: map.Map<string, string>::new(),
        handles: map.Map<string, bool>::new(),
        enums: map.Map<string, bool>::new(),
        signed: map.Map<string, bool>::new(),
        records: map.Map<string, Record>::new(),
        constants: map.Map<string, Constant>::new(),
        blocks: map.Map<string, []string>::new(),
        aliases: map.Map<string, string>::new(),
    }
    scan_types(data, &mut r)
    scan_enums(data, &mut r)
    scan_commands(data, &mut r)
    scan_extensions(data, &mut r)
    r
}

// ---- questions about the registry -------------------------------------------

// The number of an enum constant, through an alias to the constant it
// repeats (VK_ERROR_VALIDATION_FAILED_EXT → VK_ERROR_VALIDATION_FAILED);
// none when the registry defines neither. A sentinel integer will not do:
// -1 is VK_ERROR_OUT_OF_HOST_MEMORY.
fn constant_value(r: &Registry, name: string) -> Option<i64> {
    mut n := name.clone()
    mut hops := 0
    while hops < 8 {
        match r.constants.get(n.clone()) {
            .Some(c) => return .Some(c.value),
            .None => {},
        }
        match r.aliases.get(n.clone()) {
            .Some(target) => { n = target; hops += 1 },
            .None => break,
        }
    }
    .None
}

// Whether a command exists only where a surface can: its extension, or an
// extension it depends on, is VK_KHR_surface.
fn needs_surface(r: &Registry, command: string) -> bool {
    provider := r.provider.get(command)
    mut ext := match provider { .Some(e) => e, .None => return false }
    mut hops := 0
    while ext != "" && hops < 8 {
        if ext == SURFACE_EXTENSION { return true }
        mut next := ""
        for e in &r.extensions {
            if e.name == ext { next = e.depends.clone() }
        }
        ext = next
        hops += 1
    }
    false
}

// The C type a vk.xml name resolves to: typedefs are followed (`VkDeviceSize`
// → `uint64_t`); handles and enums have no typedef and stay as themselves.
fn resolves_to(r: &Registry, type_name: string) -> string {
    mut t := type_name.clone()
    mut hops := 0
    while hops < 8 {
        match r.typedefs.get(t.clone()) {
            .Some(base) => { t = base; hops += 1 },
            .None => break,
        }
    }
    t
}

// The Dunder type of one parameter. Anything addressed (a handle, a struct, a
// `void*`) is `ptr`; the integers are the widths the headers typedef them to.
// Enums and flags are `uint32_t` in C, which is what the registry's silence
// means here: a name that is neither a handle nor a typedef is an enum.
fn dunder_type(r: &Registry, p: &Param) -> string {
    if p.pointer { return "ptr" }
    if r.handles.contains(p.type_name) { return "ptr" }
    if enum_is(r, p.type_name) != "" { return enum_is(r, p.type_name) }
    scalar(resolves_to(r, p.type_name)).0
}

// `void` has no value; `VkResult` and every enum come back as the `int32_t`
// the headers make of them.
fn return_type(r: &Registry, c: &Command) -> string {
    if c.returns == "void" { return "" }
    if r.handles.contains(c.returns) { return "ptr" }
    if enum_is(r, c.returns) != "" { return enum_is(r, c.returns) }
    scalar(resolves_to(r, c.returns)).0
}

// ---- writing api.ddr ---------------------------------------------------------

// api.ddr's `load`: every command resolved by name, a missing symbol fails
// the load. Windowed commands are resolved only when a surface is asked for.
fn write_api(r: &Registry, names: &[]string) -> string {
    mut out: []u8 = []
    bytes.append_utf8(&mut out, "// Generated by tools/vk.ddr from Khronos' vk.xml. Do not edit.\n")
    bytes.append_utf8(&mut out, "// Vulkan entry points Storm calls, resolved by name from the loader before\n")
    bytes.append_utf8(&mut out, "// any driver call. Prototypes are the registry's; the command list is Storm's.\n")
    bytes.append_utf8(&mut out, "capability unsafe\n\nimport std.dl as dl\n\n@c_layout\npub struct Api {\n")
    for n in names {
        c := r.commands.get(n.clone()).unwrap()
        bytes.append_utf8(&mut out, "    " + n + ": extern fn(")
        for i in 0..c.params.len {
            if i > 0 { bytes.append_utf8(&mut out, ", ") }
            bytes.append_utf8(&mut out, dunder_type(r, &c.params[i]))
        }
        ret := return_type(r, &c)
        if ret != "" { bytes.append_utf8(&mut out, ") -> " + ret) } else { bytes.append_utf8(&mut out, ")") }
        bytes.append_utf8(&mut out, ",\n")
    }
    bytes.append_utf8(&mut out, "}\n\n")
    bytes.append_utf8(&mut out, "// Resolve every entry point up front; a missing symbol fails the whole load.\n")
    bytes.append_utf8(&mut out, "pub unsafe fn load(api: &mut Api, library: ptr, windowed: bool) -> bool {\n")
    bytes.append_utf8(&mut out, "    mut symbol := ptr(0)\n")
    // The surface-dependent commands first, inside the `windowed` guard: the
    // loader exports them, but they cannot be called without a surface and a
    // capture run never has one. Then everything else, unconditionally.
    bytes.append_utf8(&mut out, "    if windowed {\n")
    for n in names {
        if !needs_surface(r, n.clone()) { continue }
        c := r.commands.get(n.clone()).unwrap()
        bytes.append_utf8(&mut out, "        symbol = dl.symbol(library, cstr(\"" + c.name + "\"))\n")
        bytes.append_utf8(&mut out, "        if symbol == ptr(0) { return false }\n")
        bytes.append_utf8(&mut out, "        api." + n + " = ffi_fn(symbol)\n")
    }
    bytes.append_utf8(&mut out, "    }\n")
    for n in names {
        if needs_surface(r, n.clone()) { continue }
        c := r.commands.get(n.clone()).unwrap()
        bytes.append_utf8(&mut out, "    symbol = dl.symbol(library, cstr(\"" + c.name + "\"))\n")
        bytes.append_utf8(&mut out, "    if symbol == ptr(0) { return false }\n")
        bytes.append_utf8(&mut out, "    api." + n + " = ffi_fn(symbol)\n")
    }
    bytes.append_utf8(&mut out, "\n    true\n}\n")
    bytes.decode(&out).unwrap_or_default()
}

// ---- writing layout.ddr ------------------------------------------------------

// The Dunder type of a member. A record nested by value keeps its registry
// name without the `Vk`; a pointer is a pointer, a handle included. An enum
// is the 32-bit C enum the registry declares it (`category="enum"`); every
// other type is a C width, and a width has one Dunder type and one size in
// `scalar`, the same table `c_size` reads its bytes from — so the type a
// field is written with and the size it is laid out by cannot disagree. ""
// for a width the registry has and the table lacks: `main` refuses it by
// name before anything is written. The alternative was a silent `u32`, and
// the size was still counted right, so nothing saw it: `pipelineCacheUUID`
// is `uint8_t[16]` and was written as 64 bytes of `u32`.
// The C width of an enum the registry declares: "i32" when its block holds a
// negative value, "u32" for any other, "" when the name is not an enum at all.
fn enum_is(r: &Registry, type_name: string) -> string {
    if !r.enums.contains(type_name.clone()) { return "" }
    if r.signed.contains(type_name.clone()) { return "i32" }
    "u32"
}

fn member_type(r: &Registry, m: &Member) -> string {
    if m.pointer { return "ptr" }
    if r.records.contains(m.type_name) { return m.type_name[2..m.type_name.len] }
    if r.handles.contains(m.type_name) { return "ptr" }
    if enum_is(r, m.type_name) != "" { return enum_is(r, m.type_name) }
    scalar(resolves_to(r, m.type_name)).0
}

// A C scalar as the registry's typedef resolves to it: its Dunder type and
// its (size, alignment) in bytes, or ("", (0, 0)) for a width the registry
// has and this table lacks. A flag set (`VkImageUsageFlags`) is a typedef of `VkFlags`, itself a
// typedef of `uint32_t`, so it arrives here as that width.
fn scalar(c_type: string) -> (string, (i64, i64)) {
    match c_type {
        "int8_t" => ("i8", (1, 1)),
        "uint8_t" => ("u8", (1, 1)),
        "char" => ("u8", (1, 1)),
        "int16_t" => ("i16", (2, 2)),
        "uint16_t" => ("u16", (2, 2)),
        "int32_t" => ("i32", (4, 4)),
        "int" => ("i32", (4, 4)),
        "uint32_t" => ("u32", (4, 4)),
        "float" => ("f32", (4, 4)),
        "int64_t" => ("i64", (8, 8)),
        "uint64_t" => ("u64", (8, 8)),
        "size_t" => ("usize", (8, 8)),
        "double" => ("f64", (8, 8)),
        _ => ("", (0, 0)),
    }
}

// The number of elements of a member's array as text: the text in its
// brackets, or the value of the enum name it names
// (VK_MAX_PHYSICAL_DEVICE_NAME_SIZE). "" when the member is not an array, and
// "" too when the length does not resolve, which the caller reports rather
// than guesses.
fn array_length(r: &Registry, m: &Member) -> string {
    if m.array == "" { return "" }
    if parse.integer(m.array.clone()).ok { return m.array.clone() }
    match constant_value(r, m.array) {
        .Some(n) => n.str(),
        .None => "",
    }
}

// The members a record is written with: its own, or — for a union — its
// largest member, the one that fixes the union's size (VkClearValue's colour).
// Dunder has no unions; a record the size of its largest member is what
// Storm passes by address.
fn written_members(r: &Registry, rec: &Record) -> []Member {
    if !rec.union { return rec.members.clone() }
    mut best: []Member = []
    mut best_size: i64 = -1
    for m in &rec.members {
        s := c_size(r, m.type_name)
        if s.0 > best_size { best_size = s.0; best = [m.clone()] }
    }
    best
}

// The C size and alignment of a type name, with C alignment rules; (0, 0) when
// the type is not something the registry widths say, which the caller reports.
fn c_size(r: &Registry, type_name: string) -> (i64, i64) {
    if r.enums.contains(type_name) { return (4, 4) }
    if r.records.contains(type_name) {
        rec := r.records.get(type_name).unwrap()
        mut size: i64 = 0
        mut align: i64 = 1
        for m in &rec.members {
            s := member_size(r, m)
            if s.0 == 0 { return (0, 0) }
            if rec.union {
                if s.0 > size { size = s.0 }
            } else {
                size = (size + s.1 - 1) / s.1 * s.1 + s.0
            }
            if s.1 > align { align = s.1 }
        }
        return ((size + align - 1) / align * align, align)
    }
    scalar(resolves_to(r, type_name)).1
}

// The C size and alignment of one member: its type's, times its array length.
fn member_size(r: &Registry, m: &Member) -> (i64, i64) {
    if m.pointer || r.handles.contains(m.type_name) { return (8, 8) }
    base := c_size(r, m.type_name)
    if base.0 == 0 { return (0, 0) }
    length := array_length(r, m)
    if length == "" { return base }
    n := parse.integer(length)
    if !n.ok || n.value <= 0 { return (0, 0) }
    (base.0 * n.value, base.1)
}

// One record as Dunder: the `@c_layout` struct, then `impl X { pub unsafe fn
// new() -> X }` that zeroes it and, when the registry names the record's
// structure type, writes it. `new()` is the way a record with a tag is made,
// so the tag is never a number at a call site and can never be left out.
fn write_record(r: &Registry, name: string) -> string {
    rec := r.records.get("Vk" + name).unwrap()
    mut out: []u8 = []
    bytes.append_utf8(&mut out, "@c_layout\npub struct " + name + " {\n")
    for m in written_members(r, &rec) {
        t := member_type(r, &m)
        length := array_length(r, &m)
        if m.array != "" {
            bytes.append_utf8(&mut out, "    " + m.name + ": [" + t + "; " + length + "],\n")
        } else {
            bytes.append_utf8(&mut out, "    " + m.name + ": " + t + ",\n")
        }
    }
    bytes.append_utf8(&mut out, "}\n\n")
    bytes.append_utf8(&mut out, "impl " + name + " {\n")
    bytes.append_utf8(&mut out, "    pub unsafe fn new() -> " + name + " {\n")
    bytes.append_utf8(&mut out, "        mut value: " + name + " = zeroed()\n")
    if rec.structure_type != "" {
        match constant_value(r, rec.structure_type) {
            .Some(number) => bytes.append_utf8(&mut out, "        value.sType = " + number.str() + "\n"),
            .None => {},
        }
    }
    bytes.append_utf8(&mut out, "        value\n    }\n}\n\n")
    bytes.decode(&out).unwrap_or_default()
}

// layout.ddr: the registry's records, then the pairs of two of them that
// Storm passes as one address.
fn write_layout(r: &Registry, names: &[]string, pairs: &[]Pair) -> string {
    mut out: []u8 = []
    bytes.append_utf8(&mut out, "// Generated by tools/vk.ddr from Khronos' vk.xml. Do not edit.\n")
    bytes.append_utf8(&mut out, "// Vulkan structures Storm passes by address: field names, order and widths\n")
    bytes.append_utf8(&mut out, "// are the registry's. `new()` zeroes a record and writes its structure type,\n")
    bytes.append_utf8(&mut out, "// so that number exists in one place per record and nowhere at a call site.\n")
    bytes.append_utf8(&mut out, "capability unsafe\n\n")
    for n in names {
        bytes.append_utf8(&mut out, write_record(r, n.clone()))
    }
    bytes.append_utf8(&mut out, "// Pairs of two registry records for pDependencies / pAttachments / pReferences /\n// pStages, so every caller hands Vulkan one named declaration. A [T; 2] of a C\n// record is contiguous too (size 56, stride 28 for SubpassDependency); these are\n// names, not a layout fix.\n\n")
    for p in pairs {
        bytes.append_utf8(&mut out, "@c_layout\npub struct " + p.dunder + " { " + p.first + ": " + p.record + ", " + p.second + ": " + p.record + " }\n\n")
    }
    bytes.decode(&out).unwrap_or_default()
}

// ---- writing enums.ddr -------------------------------------------------------

// enums.ddr: the header, each selected enum with its converter, then VkResult
// with `result_name` written from the registry, then the named constants and
// the predicates over them. It imports nothing: a number is the whole content.
//
// The selection table gives both names of every variant, so nothing is derived
// here: a number is the registry's constant looked up in its block, or — for a
// flag set — the sum of named bits each of which must be in that block.

// The converter's name: the enum's in snake_case (BlendFactor → blend_factor).
fn converter_name(dunder: string) -> string {
    mut out: []u8 = []
    for i in 0..dunder.len {
        b := dunder[i]
        if b >= 65 && b <= 90 {
            if i > 0 { out.push(95) }
            out.push(b + 32)
        } else {
            out.push(b)
        }
    }
    bytes.decode(&out).unwrap_or_default()
}

// Whether `block` lists `name`, and the registry's number for it (through an
// alias to the constant it repeats); none when the registry defines neither.
fn block_number(r: &Registry, block: string, name: string) -> Option<i64> {
    if !r.blocks.contains(block.clone()) { return .None }
    for c in &r.blocks.get(block.clone()).unwrap() {
        if c == name { return constant_value(r, name.clone()) }
    }
    .None
}

// The bits a flag-set variant sums; none when `variant` is not one.
fn flag_bits(sets: &[]FlagSet, variant: string) -> []string {
    for s in sets {
        if s.dunder == variant { return s.bits.clone() }
    }
    []
}

// The number of a selected variant of `block`: its constant's number, or —
// for a flag set Storm names — the sum of its bits' numbers, each a constant
// of the same block. None when the registry does not number every name, with
// the name that failed on stderr: a wrong table row is an error, never a
// number that looks right.
fn variant_number(r: &Registry, sets: &[]FlagSet, block: string, v: &Selected) -> Option<i64> {
    bits := flag_bits(sets, v.dunder.clone())
    if bits.len == 0 {
        n := block_number(r, block, v.constant.clone())
        if n == .None {
            _ := sys.eprint("vk: " + v.dunder + " is not numbered as " + v.constant + " in " + block)
        }
        return n
    }
    mut sum: i64 = 0
    for b in &bits {
        n := block_number(r, block.clone(), b.clone())
        if n == .None {
            _ := sys.eprint("vk: flag set " + v.dunder + " names " + b + ", which " + block + " does not number")
            return .None
        }
        sum += n.unwrap()
    }
    .Some(sum)
}

// One `match` line of result_name; "" when the registry does not number `c`.
fn result_line(r: &Registry, c: string) -> string {
    match constant_value(r, c.clone()) {
        .Some(n) => "        " + n.str() + " => \"" + c + "\",\n",
        .None => "",
    }
}

// `pub fn result_name(code: i32) -> string`: every VkResult constant the
// registry numbers, in its order, with the Khronos spelling.
fn write_result_name(r: &Registry) -> string {
    mut out := ""
    out += "// The Khronos spelling of a VkResult, for error messages; every code the\n"
    out += "// registry numbers, in its order.\n"
    out += "pub fn result_name(code: i32) -> string {\n"
    out += "    match code {\n"
    if r.blocks.contains("VkResult".clone()) {
        for c in &r.blocks.get("VkResult".clone()).unwrap() {
            out += result_line(r, c.clone())
        }
    }
    out += "        _ => \"VK_ERROR_?\",\n"
    out += "    }\n"
    out += "}\n\n"
    out
}

// A comment as source lines: nothing when empty, one `//` line per sentence
// group the table wrote (it is one string; wrapped at a blank is the author's).
fn comment_lines(comment: string, indent: string) -> string {
    if comment == "" { return "" }
    indent + "// " + comment + "\n"
}

// enums.ddr above the marker: the header, the selected enums each followed by
// its converter, then the named constants, then VkResult and result_name.
fn write_enums(r: &Registry, enums: &[]SelectedEnum, sets: &[]FlagSet, named: &[]NamedConstant) -> string {
    mut out: []u8 = []
    bytes.append_utf8(&mut out, "// Generated by tools/vk.ddr from Khronos' vk.xml. Do not edit.\n")
    bytes.append_utf8(&mut out, "//\n// Vk enums as Dunder enums, with the only converters to C integers in the\n")
    bytes.append_utf8(&mut out, "// package. A @c_layout record keeps its u32 field; the caller writes\n")
    bytes.append_utf8(&mut out, "// `attachment.srcColorBlendFactor = enums.blend_factor(.SrcAlpha)` and there is\n")
    bytes.append_utf8(&mut out, "// no way to spell ONE_MINUS_DST_COLOR by mistake. Every number is the\n")
    bytes.append_utf8(&mut out, "// registry's, looked up by the constant named in the tool's selection table.\n")
    bytes.append_utf8(&mut out, "//\n// Flag-like enums (ShaderStage, ImageUsage, BufferUsage) carry the combined\n")
    bytes.append_utf8(&mut out, "// variants Storm needs as named values, each the sum of named registry bits.\n\n")
    bytes.append_utf8(&mut out, "capability unsafe\n\n")
    for e in enums {
        bytes.append_utf8(&mut out, comment_lines(e.comment.clone(), ""))
        bytes.append_utf8(&mut out, "pub enum " + e.dunder + " {\n")
        for v in &e.variants {
            // main has validated every variant before writing: a None here is unreachable
            number := variant_number(r, sets, e.block.clone(), v).unwrap()
            bytes.append_utf8(&mut out, "    " + v.dunder + " = " + number.str() + ",")
            if v.comment != "" { bytes.append_utf8(&mut out, " // " + v.comment) }
            bytes.append_utf8(&mut out, "\n")
        }
        bytes.append_utf8(&mut out, "}\n\n")
        // VkResult has no converter: its codes are negative and are matched as
        // i32; it gets the Khronos spelling of every code instead.
        if e.dunder == "VkResult" {
            bytes.append_utf8(&mut out, write_result_name(r))
        } else {
            bytes.append_utf8(&mut out, "pub fn " + converter_name(e.dunder.clone()) + "(v: " + e.dunder + ") -> u32 { u32(i32(v)) }\n\n")
        }
    }
    for c in named {
        bytes.append_utf8(&mut out, comment_lines(c.comment.clone(), ""))
        // validated in main before writing
        bytes.append_utf8(&mut out, "pub const " + c.dunder + ": u32 = " + constant_value(r, c.constant.clone()).unwrap().str() + "\n\n")
    }
    bytes.decode(&out).unwrap_or_default()
}

// Every record nested by value in `rec`, through a union's members too, as
// names with the `Vk` prefix.
fn nested_records(r: &Registry, rec: &Record) -> []string {
    mut out: []string = []
    for m in &rec.members {
        if m.pointer || !r.records.contains(m.type_name) { continue }
        out.push(m.type_name.clone())
        nested := r.records.get(m.type_name).unwrap()
        for n in nested_records(r, &nested) { out.push(n) }
    }
    out
}

// ---- main --------------------------------------------------------------------

// `--check` over one file: compare, or write. Returns the process exit code.
fn check_or_write(target: string, generated: string, check: bool) -> i32 {
    if check {
        current := sys.read_text(target)
        if !current.ok || current.value != generated {
            _ := sys.eprint("vk: " + target + " differs from what the registry generates; run tools/vk.ddr")
            return 1
        }
        print("vk: " + target + " matches the registry")
        return 0
    }
    _ := sys.write_text(target, generated)
    print("vk: wrote " + target)
    0
}

// Whether `name` (without `Vk`) is among the first `before` entries of `names`.
fn declared_before(names: &[]string, name: string, before: i32) -> bool {
    for i in 0..before {
        if names[i] == name { return true }
    }
    false
}

fn main() -> i32 {
    // usage: vk.ddr <vk.xml> [--check] [api|layout|enums]
    // `--check` compares each target with what the registry generates instead
    // of writing it; the last argument narrows that to one file.
    path := if sys.arg_count() > 1 { sys.arg(1) } else { "" }
    mut check := false
    mut only := ""
    if sys.arg_count() > 2 && sys.arg(2) == "--check" { check = true }
    if sys.arg_count() > 2 && sys.arg(2) != "--check" { only = sys.arg(2) }
    if sys.arg_count() > 3 { only = sys.arg(3) }
    if path == "" {
        _ := sys.eprint("usage: dunder run tools/vk.ddr -- <vk.xml> [--check] [api|layout|enums]")
        return 2
    }
    data := sys.read_u8(path)
    if !data.ok {
        _ := sys.eprint("vk: could not read " + path)
        return 2
    }
    r := registry(&data.value)
    for n in &COMMANDS {
        if !r.commands.contains(n.clone()) {
            _ := sys.eprint("vk: vk" + n + " is not in the registry")
            return 2
        }
        cmd := r.commands.get(n.clone()).unwrap()
        for i in 0..cmd.params.len {
            if dunder_type(&r, &cmd.params[i]) == "" {
                _ := sys.eprint("vk: vk" + n + "." + cmd.params[i].name + " has a type this tool does not translate: " + cmd.params[i].type_name)
                return 2
            }
        }
        if cmd.returns != "void" && return_type(&r, &cmd) == "" {
            _ := sys.eprint("vk: vk" + n + " returns a type this tool does not translate: " + cmd.returns)
            return 2
        }
    }
    // Every record Storm names is in the registry; every record nested in one
    // of them is declared before its user; every array length and structure
    // type resolves to a number the registry defines. A failure here is a tool
    // error, reported, never a guess.
    for i in 0..STRUCTS.len {
        name := STRUCTS[i]
        if !r.records.contains("Vk" + name) {
            _ := sys.eprint("vk: Vk" + name + " is not in the registry")
            return 2
        }
        rec := r.records.get("Vk" + name).unwrap()
        for nested in nested_records(r, &rec) {
            if !declared_before(&STRUCTS, nested[2..nested.len], i) {
                _ := sys.eprint("vk: " + nested + " is nested in Vk" + name + " but not declared before it in STRUCTS")
                return 2
            }
        }
        for m in &rec.members {
            if m.array != "" && array_length(r, m) == "" {
                _ := sys.eprint("vk: Vk" + name + "." + m.name + " has an array length the registry does not number: " + m.array)
                return 2
            }
            if member_type(&r, m) == "" {
                _ := sys.eprint("vk: Vk" + name + "." + m.name + " has a type this tool does not translate: " + m.type_name)
                return 2
            }
            if m.pointer || !r.records.contains(m.type_name) { continue }
            for um in &r.records.get(m.type_name).unwrap().members {
                if um.array != "" && array_length(r, um) == "" {
                    _ := sys.eprint("vk: " + m.type_name + "." + um.name + " has an array length the registry does not number: " + um.array)
                    return 2
                }
                if member_type(&r, um) == "" {
                    _ := sys.eprint("vk: " + m.type_name + "." + um.name + " has a type this tool does not translate: " + um.type_name)
                    return 2
                }
            }
        }
        if rec.structure_type != "" && constant_value(&r, rec.structure_type.clone()) == .None {
            _ := sys.eprint("vk: Vk" + name + " names " + rec.structure_type + ", which the registry does not define")
            return 2
        }
    }
    if only == "" || only == "api" {
        code := check_or_write(API_TARGET, write_api(&r, &COMMANDS), check)
        if code != 0 { return code }
    }
    // Every pair embeds a record by value, so that record is one STRUCTS
    // declares; the pairs are written after all of them.
    pairs := pairs()
    for p in &pairs {
        if !declared_before(&STRUCTS, p.record.clone(), STRUCTS.len) {
            _ := sys.eprint("vk: pair " + p.dunder + " names " + p.record + ", which is not in STRUCTS")
            return 2
        }
    }
    if only == "" || only == "layout" {
        code := check_or_write(LAYOUT_TARGET, write_layout(&r, &STRUCTS, &pairs), check)
        if code != 0 { return code }
    }
    // Every enum, and every variant Storm selects, is in the registry: a name
    // that is not is a tool error with the name, never a number.
    enums := selected_enums()
    sets := flag_sets()
    for e in &enums {
        if !r.blocks.contains(e.block.clone()) {
            _ := sys.eprint("vk: " + e.dunder + " names block " + e.block + ", which the registry does not have")
            return 2
        }
        for v in &e.variants {
            // A variant either names a registry constant or is a flag set in
            // `flag_sets`; an empty constant that is neither is a table row
            // nothing numbers.
            if v.constant == "" && flag_bits(&sets, v.dunder.clone()).len == 0 {
                _ := sys.eprint("vk: " + e.dunder + "." + v.dunder + " names no constant and is no flag set")
                return 2
            }
            if variant_number(&r, &sets, e.block.clone(), v) == .None {
                // variant_number has named the missing constant on stderr
                return 2
            }
        }
    }
    // A flag set must be a variant of exactly one selected enum: one that is
    // in no selection is a table row nothing writes.
    for s in &sets {
        mut found := false
        for e in &enums {
            for v in &e.variants {
                if v.dunder == s.dunder { found = true }
            }
        }
        if !found {
            _ := sys.eprint("vk: flag set " + s.dunder + " is in no enum's selection")
            return 2
        }
    }
    if only == "" || only == "enums" {
        named := named_constants()
        for c in &named {
            if constant_value(&r, c.constant.clone()) == .None {
                _ := sys.eprint("vk: named constant " + c.dunder + " is " + c.constant + ", which the registry does not number")
                return 2
            }
        }
        code := check_or_write(ENUMS_TARGET, write_enums(&r, &enums, &sets, &named), check)
        if code != 0 { return code }
    }
    0
}
