// Generate packages/storm-vulkan/src/api.ddr and layout.ddr from Khronos' vk.xml.
//
//   dunder run tools/vk.ddr -- <vk.xml>                 rewrite api.ddr and layout.ddr
//   dunder run tools/vk.ddr -- <vk.xml> --check         exit 1 when either differs
//   dunder run tools/vk.ddr -- <vk.xml> [--check] api   one file only: api or layout
//
// The entry points Storm loads by name were written by hand: one `extern fn`
// and one `dl.symbol` per command, each spelled from the headers. This reads
// the registry instead, so a parameter type, a return type or a symbol name
// cannot be misremembered — there is no second copy to keep true. Storm still
// names the commands it calls (COMMANDS below); the names say nothing about
// their types. Which of them need a surface is the registry's answer too: the
// commands of an extension that depends on VK_KHR_surface are the windowed
// ones, followed through `depends=` as vk.xml states them.
//
// The records Storm passes by address (STRUCTS below) come from the registry
// the same way: field names, order and widths are the registry's, and every
// record whose sType member names a VkStructureType gets a `new()` that
// zeroes it and writes that number — the one place a structure type number
// exists in Storm. A union becomes its largest member (Dunder has no unions),
// which for VkClearValue is the four floats Storm clears with. Storm's own
// records, the ones that are not Vulkan's, stay hand-written below a marker
// that the generator copies through unchanged.
//
// vk.xml is not vendored. Fetch the Khronos registry when regenerating:
//   curl -o /tmp/vk.xml https://raw.githubusercontent.com/KhronosGroup/Vulkan-Docs/main/xml/vk.xml
//
// The registry is scanned as bytes: its tags are ASCII and its comments carry
// UTF-8 that a byte offset may land inside, so text is decoded only for the
// values between two tags, which always split on ASCII.
capability filesystem, stdio

import std.bytes as bytes
import std.map as map
import std.parse as parse
import std.text as text
import sys

// Entry points Storm calls, in the order api.ddr declares them: the C names
// without the `vk` prefix, which is the field name in `Api`.
const COMMANDS: []string = [
    "CreateInstance", "DestroyInstance", "DestroySurfaceKHR", "EnumeratePhysicalDevices",
    "GetPhysicalDeviceProperties", "GetPhysicalDeviceFormatProperties", "GetPhysicalDeviceMemoryProperties",
    "GetPhysicalDeviceQueueFamilyProperties", "GetPhysicalDeviceSurfaceSupportKHR",
    "GetPhysicalDeviceSurfaceCapabilitiesKHR", "GetPhysicalDeviceSurfaceFormatsKHR",
    "GetPhysicalDeviceSurfacePresentModesKHR", "CreateDevice", "GetDeviceQueue", "CreateCommandPool",
    "AllocateCommandBuffers", "CreateBuffer", "GetBufferMemoryRequirements", "AllocateMemory", "BindBufferMemory",
    "MapMemory", "UnmapMemory", "GetImageMemoryRequirements", "CreateShaderModule", "CreatePipelineLayout",
    "CreateGraphicsPipelines", "CreateRenderPass", "CreateFramebuffer", "CreateImage", "BindImageMemory", "CreateImageView",
    "CreateSwapchainKHR", "GetSwapchainImagesKHR", "AcquireNextImageKHR", "QueuePresentKHR", "CreateSemaphore",
    "CreateFence", "ResetFences", "WaitForFences", "DestroyFence", "DestroySemaphore", "DestroyImage", "DestroyImageView",
    "DestroyFramebuffer", "DestroyPipeline", "DestroyPipelineLayout", "DestroyShaderModule", "DestroyRenderPass",
    "DestroySwapchainKHR", "DestroyCommandPool", "DestroyBuffer", "FreeMemory", "FreeCommandBuffers", "DeviceWaitIdle",
    "QueueWaitIdle", "DestroyDevice", "BeginCommandBuffer", "EndCommandBuffer", "ResetCommandBuffer", "CmdBeginRenderPass",
    "CmdSetViewport", "CmdSetScissor", "CmdEndRenderPass", "CmdBindPipeline", "CmdBindVertexBuffers", "CmdDraw",
    "CmdPushConstants", "CmdPipelineBarrier", "CmdCopyImageToBuffer", "CmdCopyBufferToImage", "CmdBlitImage", "QueueSubmit",
    "CreateSampler", "DestroySampler", "CreateDescriptorSetLayout", "DestroyDescriptorSetLayout",
    "CreateDescriptorPool", "DestroyDescriptorPool", "AllocateDescriptorSets", "UpdateDescriptorSets",
    "CmdBindDescriptorSets",
]

// The extension whose commands only exist with a surface.
const SURFACE_EXTENSION: string = "VK_KHR_surface"

// Records Storm passes by address, without the `Vk` prefix, in the order
// layout.ddr declares them. A record nested by value in another is declared
// before its user, as C requires.
const STRUCTS: []string = [
    "ApplicationInfo", "InstanceCreateInfo", "DeviceQueueCreateInfo", "DeviceCreateInfo",
    "CommandPoolCreateInfo", "CommandBufferAllocateInfo", "MemoryRequirements", "MemoryAllocateInfo",
    "BufferCreateInfo", "ComponentMapping", "ImageSubresourceRange",
    "ImageSubresourceLayers", "ImageViewCreateInfo", "AttachmentDescription", "AttachmentReference",
    "SubpassDescription", "SubpassDependency", "RenderPassCreateInfo", "FramebufferCreateInfo",
    "ShaderModuleCreateInfo", "PipelineLayoutCreateInfo", "PushConstantRange", "SpecializationMapEntry",
    "SpecializationInfo", "PipelineShaderStageCreateInfo", "VertexInputBindingDescription",
    "VertexInputAttributeDescription", "PipelineVertexInputStateCreateInfo", "PipelineInputAssemblyStateCreateInfo",
    "Viewport", "Offset2D", "Extent2D", "Rect2D", "PipelineViewportStateCreateInfo", "PipelineDynamicStateCreateInfo",
    "PipelineRasterizationStateCreateInfo", "PipelineMultisampleStateCreateInfo",
    "PipelineColorBlendAttachmentState", "PipelineColorBlendStateCreateInfo", "GraphicsPipelineCreateInfo",
    "CommandBufferBeginInfo", "ClearColorValue", "ClearDepthStencilValue", "ClearValue",
    "RenderPassBeginInfo", "SubmitInfo", "PresentInfoKHR", "SwapchainCreateInfoKHR", "SurfaceCapabilitiesKHR",
    "SurfaceFormatKHR", "SemaphoreCreateInfo", "FenceCreateInfo", "Extent3D", "Offset3D", "ImageCreateInfo",
    "StencilOpState", "PipelineDepthStencilStateCreateInfo", "BufferImageCopy", "ImageBlit",
    "FormatProperties", "MemoryBarrier", "ImageMemoryBarrier", "SamplerCreateInfo",
    "DescriptorSetLayoutBinding", "DescriptorSetLayoutCreateInfo", "DescriptorPoolSize",
    "DescriptorPoolCreateInfo", "DescriptorSetAllocateInfo", "DescriptorImageInfo", "WriteDescriptorSet",
    "DescriptorBufferInfo",
]

// layout.ddr's own marker: everything from this line on is Storm's, not the
// registry's, and is copied through unchanged.
const OWN_RECORDS_MARKER: string = "// --- Storm's own records ---"

// Where each generated file goes, by the name the last argument accepts.
const API_TARGET: string = "packages/storm-vulkan/src/api.ddr"
const LAYOUT_TARGET: string = "packages/storm-vulkan/src/layout.ddr"

struct Param { type_name: string, pointer: bool, name: string }
struct Command { name: string, params: []Param, returns: string }
struct Extension { name: string, depends: string }
// `array` is the text between a member's brackets, "" when it is not an array.
struct Member { type_name: string, pointer: bool, name: string, array: string }
// `structure_type` is the VkStructureType name the registry gives the record's
// sType member, "" when the record has none.
struct Record { name: string, members: []Member, union: bool, structure_type: string }

// Everything the registry says, indexed by name.
struct Registry {
    commands: map.Map<string, Command>,
    provider: map.Map<string, string>,
    extensions: []Extension,
    typedefs: map.Map<string, string>,
    handles: map.Map<string, bool>,
    records: map.Map<string, Record>,
    enums: map.Map<string, i64>,
}

// ---- bytes -------------------------------------------------------------------

// Offset of `needle` in `data` within `[from, until)`, -1 when absent. Every
// lookup inside an element passes that element's end: a `<param>` of prose has
// no `<type>`, and an unbounded search for one runs to the end of the file.
fn find_bytes(data: &[]u8, from: i32, until: i32, needle: string) -> i32 {
    mut target: []u8 = bytes.from_text(needle)
    mut i := from
    while i + target.len <= until {
        if bytes.equal_ranges(data, i, i + target.len, &target, 0, target.len) { return i }
        i += 1
    }
    -1
}

// The text from `start` to `end` in `data`. Both offsets sit on tag
// boundaries, which are ASCII, so the view is always valid UTF-8.
fn text_at(data: &[]u8, start: i32, end: i32) -> string {
    bytes.decode_range(data, start, end).unwrap_or_default()
}

// Text between the first `<tag>` after `from` and its `</tag>`; "" when absent.
fn inner(data: &[]u8, from: i32, end: i32, tag: string) -> string {
    open := find_bytes(data, from, end, "<" + tag + ">")
    if open < 0 { return "" }
    start := open + tag.len + 2
    close := find_bytes(data, start, end, "</" + tag + ">")
    if close < 0 { return "" }
    text_at(data, start, close)
}

// Value of `key="…"` among a tag's attributes, which run from `tag_start` to
// `tag_end`.
fn attribute(data: &[]u8, tag_start: i32, tag_end: i32, key: string) -> string {
    start := find_bytes(data, tag_start, tag_end, key + "=\"")
    if start < 0 { return "" }
    value := start + key.len + 2
    stop := find_bytes(data, value, tag_end, "\"")
    if stop < 0 { return "" }
    text_at(data, value, stop)
}

// One tag as the scanner sees it: `name` is `type` for `<type …>` and
// `/type` for `</type>`; `body_start` is the offset after `>`. A self-closing
// `<command name="…"/>` has `closing` false and `empty` true.
struct Tag { name: string, start: i32, attr_start: i32, attr_end: i32, body_start: i32, closing: bool, empty: bool }

// The next tag at or after `from`, or a Tag with `start` -1.
fn next_tag(data: &[]u8, from: i32) -> Tag {
    start := find_bytes(data, from, data.len, "<")
    if start < 0 { return Tag { name: "", start: -1, attr_start: 0, attr_end: 0, body_start: 0, closing: false, empty: false } }
    mut end := start + 1
    while end < data.len && data[end] != 62 { end += 1 }
    empty := end > start && data[end - 1] == 47
    closing := start + 1 < data.len && data[start + 1] == 47
    name_start := start + if closing { 2 } else { 1 }
    mut name_end := name_start
    while name_end < end && data[name_end] != 32 && data[name_end] != 47 && data[name_end] != 62 { name_end += 1 }
    Tag {
        name: text_at(data, name_start, name_end),
        start: start,
        attr_start: name_end,
        attr_end: if empty { end - 1 } else { end },
        body_start: end + 1,
        closing: closing,
        empty: empty,
    }
}

// The first opening tag called `name` at or after `from`; `start` is -1 when absent.
fn find_open(data: &[]u8, from: i32, name: string) -> Tag {
    mut at := from
    while at < data.len {
        t := next_tag(data, at)
        if t.start < 0 { break }
        at = t.body_start
        if !t.closing && !t.empty && t.name == name { return t }
    }
    Tag { name: "", start: -1, attr_start: 0, attr_end: 0, body_start: 0, closing: false, empty: false }
}

// Offset just past the `</name>` that closes the element whose opening tag is
// `open`, counting nested elements of the same name. `name` is "command" for
// `<command>`, so the body of a command may contain anything but a command.
fn close_of(data: &[]u8, open: &Tag) -> i32 {
    // A self-closing tag and a closing tag both end where their `>` does;
    // scanning from a closing tag would run to the end of the file, because
    // the matching opener lies before it.
    if open.empty || open.closing { return open.body_start }
    mut depth := 1
    mut at := open.body_start
    while at < data.len {
        t := next_tag(data, at)
        if t.start < 0 { return -1 }
        at = t.body_start
        if t.name != open.name || t.empty { continue }
        if t.closing { depth -= 1 } else { depth += 1 }
        if depth == 0 { return at }
    }
    -1
}

// The direct children of the element `open` (whose body ends at `close`) whose
// tag is `name`, as byte ranges of their bodies. Depth matters: a <command>
// holds <param> elements and also an <implicitexternsyncparams> whose <param>
// elements are prose about synchronization, not parameters.
fn children(data: &[]u8, open: &Tag, close: i32, name: string) -> []Tag {
    mut out: []Tag = []
    mut at := open.body_start
    while at < close {
        t := next_tag(data, at)
        if t.start < 0 || t.body_start > close { break }
        // Every element's subtree is stepped over as a whole, named or not, so a
        // descendant is never mistaken for a sibling.
        child_close := close_of(data, &t)
        at = if child_close > t.body_start { child_close } else { t.body_start }
        if t.closing || t.name != name { continue }
        out.push(t.clone())
    }
    out
}

// Whether a `<param api="…">` or `<member api="…">` variant applies to
// Vulkan. The registry lists one per API profile when they differ, as a
// comma-separated list (`api="vulkan,vulkanbase"` versus `api="vulkansc"`);
// one without `api` applies to every profile. Profiles are compared as whole
// names: "vulkansc" is another API that merely shares a prefix.
fn applies_to_vulkan(data: &[]u8, t: &Tag) -> bool {
    apis := attribute(data, t.attr_start, t.attr_end, "api")
    if apis == "" { return true }
    for profile in text.split(apis, ",") {
        if text.trim(profile) == "vulkan" { return true }
    }
    false
}

// ---- scanning ----------------------------------------------------------------

// `<type category="basetype">typedef <type>uint64_t</type> <name>VkDeviceSize</name>;</type>`,
// `<type category="handle"><type>VK_DEFINE_HANDLE</type>(<name>VkInstance</name>)</type>`, and
// `<type category="struct" name="VkExtent3D"><member><type>uint32_t</type> <name>width</name></member> …</type>`.
fn scan_types(data: &[]u8, r: &mut Registry) {
    // <types> … </types> holds every <type category="…"> element.
    types_open := find_open(data, 0, "types")
    if types_open.start < 0 { return }
    types_close := close_of(data, &types_open)
    if types_close < 0 { return }
    for t in children(data, &types_open, types_close, "type") {
        close := close_of(data, &t)
        if close < 0 { continue }
        category := attribute(data, t.attr_start, t.attr_end, "category")
        if category == "basetype" {
            name := inner(data, t.body_start, close, "name")
            base := inner(data, t.body_start, close, "type")
            if name != "" && base != "" { r.typedefs.put(name.clone(), base.clone()) }
        } else if category == "handle" {
            name := inner(data, t.body_start, close, "name")
            if name != "" { r.handles.put(name.clone(), true) }
        } else if category == "struct" || category == "union" {
            // A record's name is an attribute, not a child element.
            name := attribute(data, t.attr_start, t.attr_end, "name")
            if name == "" { continue }
            scan_record(data, &t, close, name, category == "union", &mut r)
        }
    }
}

// The members of one record, in registry order. The member named sType carries
// the record's structure type in `values="VK_STRUCTURE_TYPE_…"`.
fn scan_record(data: &[]u8, open: &Tag, close: i32, name: string, union: bool, r: &mut Registry) {
    mut members: []Member = []
    mut structure_type := ""
    for m in children(data, open, close, "member") {
        m_close := close_of(data, &m)
        if m_close < 0 { continue }
        if !applies_to_vulkan(data, &m) { continue }
        member := parse_member(data, m.body_start, m_close)
        // A <member> without a <type> is not a member.
        if member.type_name == "" { continue }
        if member.name == "sType" {
            structure_type = attribute(data, m.attr_start, m.attr_end, "values")
        }
        members.push(member.clone())
    }
    r.records.put(name.clone(), Record { name: name.clone(), members: members, union: union, structure_type: structure_type })
}

// Every `<enums>` block's `<enum name="…" value="N"/>`; an `alias="…"` entry
// repeats a name and is skipped. Bitmask blocks carry `bitpos=` instead, and
// the value is 1 << bitpos. The numbers are i64 so that
// VK_STRUCTURE_TYPE_SWAPCHAIN_CREATE_INFO_KHR (1000001001) fits.
fn scan_enums(data: &[]u8, r: &mut Registry) {
    mut at := 0
    while at < data.len {
        block := find_open(data, at, "enums")
        if block.start < 0 { break }
        block_close := close_of(data, &block)
        if block_close < 0 { break }
        at = block_close
        for e in children(data, &block, block_close, "enum") {
            if attribute(data, e.attr_start, e.attr_end, "alias") != "" { continue }
            name := attribute(data, e.attr_start, e.attr_end, "name")
            if name == "" { continue }
            value := parse.integer(attribute(data, e.attr_start, e.attr_end, "value"))
            bitpos := parse.integer(attribute(data, e.attr_start, e.attr_end, "bitpos"))
            if value.ok { r.enums.put(name.clone(), value.value) }
            else if bitpos.ok { r.enums.put(name.clone(), i64(1).shl(i32(bitpos.value))) }
        }
    }
}

// `<param optional="true">const <type>VkAllocationCallbacks</type>* <name>pAllocator</name></param>`:
// the type is whatever the tag holds, the stars after it are the pointer.
fn parse_param(data: &[]u8, start: i32, end: i32) -> Param {
    type_name := inner(data, start, end, "type")
    name := inner(data, start, end, "name")
    type_close := find_bytes(data, start, end, "</type>")
    name_open := find_bytes(data, start, end, "<name>")
    mut pointer := false
    if type_close >= 0 && name_open > type_close {
        for i in type_close + 7..name_open { if data[i] == 42 { pointer = true } }
    }
    Param { type_name: type_name, pointer: pointer, name: name }
}

// `<member><type>VkOffset3D</type> <name>srcOffsets</name>[2]<comment>…</comment></member>`:
// a parameter, plus the text between the brackets after `</name>` when there
// is one (a number, or an enum name the registry defines). Only brackets that
// follow `</name>` through whitespace count: a member's comment may hold a
// `[` of its own (`BUFFER[_DYNAMIC]`).
fn parse_member(data: &[]u8, start: i32, end: i32) -> Member {
    p := parse_param(data, start, end)
    mut array := ""
    name_close := find_bytes(data, start, end, "</name>")
    if name_close >= 0 {
        mut at := name_close + 7
        while at < end && (data[at] == 32 || data[at] == 9 || data[at] == 10 || data[at] == 13) { at += 1 }
        if at < end && data[at] == 91 {
            stop := find_bytes(data, at, end, "]")
            if stop > at + 1 { array = text_at(data, at + 1, stop) }
        }
    }
    Member { type_name: p.type_name, pointer: p.pointer, name: p.name, array: array }
}

// `<command …><proto><type>VkResult</type> <name>vkCreateImage</name></proto>
//  <param>const <type>VkImageCreateInfo</type>* <name>pCreateInfo</name></param> …</command>`
// Every <command> sits under <commands>, in a <command> or an extension's
// <require>; nested commands never occur, so the walk is flat.
fn scan_commands(data: &[]u8, r: &mut Registry) {
    commands_open := find_open(data, 0, "commands")
    if commands_open.start < 0 { return }
    commands_close := close_of(data, &commands_open)
    if commands_close < 0 { return }
    for cmd in children(data, &commands_open, commands_close, "command") {
        cmd_close := close_of(data, &cmd)
        if cmd_close < 0 { continue }
        for proto in children(data, &cmd, cmd_close, "proto") {
            proto_close := close_of(data, &proto)
            if proto_close < 0 { continue }
            mut returns := inner(data, proto.body_start, proto_close, "type")
            if returns == "" { returns = "void" }
            name := inner(data, proto.body_start, proto_close, "name")
            if name == "" || !text.starts_with(name, "vk") { continue }
            mut params: []Param = []
            for param in children(data, &cmd, cmd_close, "param") {
                if !applies_to_vulkan(data, &param) { continue }
                param_close := close_of(data, &param)
                if param_close < 0 { continue }
                parsed := parse_param(data, param.body_start, param_close)
                // A <param> without a <type> is not a parameter (the registry
                // uses <param> for prose inside <implicitexternsyncparams>).
                if parsed.type_name == "" { continue }
                params.push(parsed.clone())
            }
            r.commands.put(name[2..name.len].clone(), Command { name: name.clone(), params: params, returns: returns.clone() })
        }
    }
}

// `<extension name="VK_KHR_swapchain" number="2" … depends="VK_KHR_surface" …>` blocks
// list what they provide as `<command name="vkCreateSwapchainKHR"/>`, inside
// <require> elements that may themselves depend on another extension. They
// also extend registry enums: `<enum name="VK_STRUCTURE_TYPE_PRESENT_INFO_KHR"
// extends="VkStructureType" offset="1"/>` has no value, it is computed —
// 1000000000 + (number − 1) × 1000 + offset, with the extension's own
// `extnumber` attribute in place of `number` when it has one, and negated
// for `dir="-"` (VkResult's extension errors). An `api="…"` variant applies
// to Vulkan by the same rule as a parameter.
fn scan_extensions(data: &[]u8, r: &mut Registry) {
    root_open := find_open(data, 0, "extensions")
    if root_open.start < 0 { return }
    root_close := close_of(data, &root_open)
    if root_close < 0 { return }
    for ext in children(data, &root_open, root_close, "extension") {
        ext_close := close_of(data, &ext)
        if ext_close < 0 { continue }
        name := attribute(data, ext.attr_start, ext.attr_end, "name")
        if name == "" { continue }
        r.extensions.push(Extension { name: name.clone(), depends: attribute(data, ext.attr_start, ext.attr_end, "depends") })
        number := parse.integer(attribute(data, ext.attr_start, ext.attr_end, "number"))
        // Walk the whole extension body for <command …/> and <enum …/> at any depth.
        mut cat := ext.body_start
        while cat < ext_close {
            t := next_tag(data, cat)
            if t.start < 0 || t.body_start > ext_close { break }
            cat = t.body_start
            if t.closing { continue }
            if t.name == "command" {
                cname := attribute(data, t.attr_start, t.attr_end, "name")
                if text.starts_with(cname, "vk") { r.provider.put(cname[2..cname.len].clone(), name.clone()) }
            } else if t.name == "enum" {
                if !applies_to_vulkan(data, &t) { continue }
                if attribute(data, t.attr_start, t.attr_end, "alias") != "" { continue }
                ename := attribute(data, t.attr_start, t.attr_end, "name")
                offset := parse.integer(attribute(data, t.attr_start, t.attr_end, "offset"))
                if ename == "" || !offset.ok { continue }
                extnumber := parse.integer(attribute(data, t.attr_start, t.attr_end, "extnumber"))
                mut base := if number.ok { number.value } else { -1 }
                if extnumber.ok { base = extnumber.value }
                if base <= 0 { continue }
                mut value := 1000000000 + (base - 1) * 1000 + offset.value
                if attribute(data, t.attr_start, t.attr_end, "dir") == "-" { value = 0 - value }
                r.enums.put(ename.clone(), value)
            }
        }
    }
}

fn registry(data: &[]u8) -> Registry {
    mut r := Registry {
        commands: map.Map<string, Command>::new(),
        provider: map.Map<string, string>::new(),
        extensions: [],
        typedefs: map.Map<string, string>::new(),
        handles: map.Map<string, bool>::new(),
        records: map.Map<string, Record>::new(),
        enums: map.Map<string, i64>::new(),
    }
    scan_types(data, &mut r)
    scan_enums(data, &mut r)
    scan_commands(data, &mut r)
    scan_extensions(data, &mut r)
    r
}

// ---- questions about the registry -------------------------------------------

// Whether a command exists only where a surface can: its extension, or an
// extension it depends on, is VK_KHR_surface.
fn needs_surface(r: &Registry, command: string) -> bool {
    provider := r.provider.get(command)
    mut ext := match provider { .Some(e) => e, .None => return false }
    mut hops := 0
    while ext != "" && hops < 8 {
        if ext == SURFACE_EXTENSION { return true }
        mut next := ""
        for e in &r.extensions {
            if e.name == ext { next = e.depends.clone() }
        }
        ext = next
        hops += 1
    }
    false
}

// The C type a vk.xml name resolves to: typedefs are followed (`VkDeviceSize`
// → `uint64_t`); handles and enums have no typedef and stay as themselves.
fn resolves_to(r: &Registry, type_name: string) -> string {
    mut t := type_name.clone()
    mut hops := 0
    while hops < 8 {
        match r.typedefs.get(t.clone()) {
            .Some(base) => { t = base; hops += 1 },
            .None => break,
        }
    }
    t
}

// The Dunder type of one parameter. Anything addressed (a handle, a struct, a
// `void*`) is `ptr`; the integers are the widths the headers typedef them to.
// Enums and flags are `uint32_t` in C, which is what the registry's silence
// means here: a name that is neither a handle nor a typedef is an enum.
fn dunder_type(r: &Registry, p: &Param) -> string {
    if p.pointer { return "ptr" }
    if r.handles.contains(p.type_name) { return "ptr" }
    match resolves_to(r, p.type_name) {
        "uint32_t" => "u32",
        "int32_t" => "i32",
        "int" => "i32",
        "uint64_t" => "u64",
        "size_t" => "u64",
        "float" => "f32",
        "char" => "ptr",
        _ => "u32",
    }
}

// `void` has no value; `VkResult` and every enum come back as the `int32_t`
// the headers make of them.
fn return_type(r: &Registry, c: &Command) -> string {
    if c.returns == "void" { return "" }
    match resolves_to(r, c.returns) {
        "uint32_t" => "u32",
        _ => "i32",
    }
}

// ---- writing api.ddr ---------------------------------------------------------

// api.ddr's `load`: every command resolved by name, a missing symbol fails
// the load. Windowed commands are resolved only when a surface is asked for.
fn write_api(r: &Registry, names: &[]string) -> string {
    mut out: []u8 = []
    bytes.append_utf8(&mut out, "// Generated by tools/vk.ddr from Khronos' vk.xml. Do not edit.\n")
    bytes.append_utf8(&mut out, "// Vulkan entry points Storm calls, resolved by name from the loader before\n")
    bytes.append_utf8(&mut out, "// any driver call. Prototypes are the registry's; the command list is Storm's.\n")
    bytes.append_utf8(&mut out, "capability unsafe\n\nimport std.dl as dl\n\n@c_layout\npub struct Api {\n")
    for n in names {
        c := r.commands.get(n.clone()).unwrap()
        bytes.append_utf8(&mut out, "    " + n + ": extern fn(")
        for i in 0..c.params.len {
            if i > 0 { bytes.append_utf8(&mut out, ", ") }
            bytes.append_utf8(&mut out, dunder_type(r, &c.params[i]))
        }
        ret := return_type(r, &c)
        if ret != "" { bytes.append_utf8(&mut out, ") -> " + ret) } else { bytes.append_utf8(&mut out, ")") }
        bytes.append_utf8(&mut out, ",\n")
    }
    bytes.append_utf8(&mut out, "}\n\n")
    bytes.append_utf8(&mut out, "// Resolve every entry point up front; a missing symbol fails the whole load.\n")
    bytes.append_utf8(&mut out, "pub unsafe fn load(api: &mut Api, library: ptr, windowed: bool) -> bool {\n")
    bytes.append_utf8(&mut out, "    mut symbol := ptr(0)\n")
    // The surface-dependent commands first, inside the `windowed` guard: the
    // loader exports them, but they cannot be called without a surface and a
    // capture run never has one. Then everything else, unconditionally.
    bytes.append_utf8(&mut out, "    if windowed {\n")
    for n in names {
        if !needs_surface(r, n.clone()) { continue }
        c := r.commands.get(n.clone()).unwrap()
        bytes.append_utf8(&mut out, "        symbol = dl.symbol(library, cstr(\"" + c.name + "\"))\n")
        bytes.append_utf8(&mut out, "        if symbol == ptr(0) { return false }\n")
        bytes.append_utf8(&mut out, "        api." + n + " = ffi_fn(symbol)\n")
    }
    bytes.append_utf8(&mut out, "    }\n")
    for n in names {
        if needs_surface(r, n.clone()) { continue }
        c := r.commands.get(n.clone()).unwrap()
        bytes.append_utf8(&mut out, "    symbol = dl.symbol(library, cstr(\"" + c.name + "\"))\n")
        bytes.append_utf8(&mut out, "    if symbol == ptr(0) { return false }\n")
        bytes.append_utf8(&mut out, "    api." + n + " = ffi_fn(symbol)\n")
    }
    bytes.append_utf8(&mut out, "\n    true\n}\n")
    bytes.decode(&out).unwrap_or_default()
}

// ---- writing layout.ddr ------------------------------------------------------

// The Dunder type of a member. A record nested by value keeps its registry
// name without the `Vk`; a handle is a pointer; `size_t` is `usize`, a size
// in Dunder as in C; `char` by value is a byte.
fn member_type(r: &Registry, m: &Member) -> string {
    if m.pointer { return "ptr" }
    if r.records.contains(m.type_name) { return m.type_name[2..m.type_name.len] }
    if r.handles.contains(m.type_name) { return "ptr" }
    match resolves_to(r, m.type_name) {
        "uint32_t" => "u32",
        "int32_t" => "i32",
        "int" => "i32",
        "uint64_t" => "u64",
        "size_t" => "usize",
        "float" => "f32",
        "char" => "u8",
        _ => "u32",
    }
}

// The number of elements of a member's array as text: the text in its
// brackets, or the value of the enum name it names
// (VK_MAX_PHYSICAL_DEVICE_NAME_SIZE). "" when the member is not an array, and
// "" too when the length does not resolve, which the caller reports rather
// than guesses.
fn array_length(r: &Registry, m: &Member) -> string {
    if m.array == "" { return "" }
    if parse.integer(m.array.clone()).ok { return m.array.clone() }
    match r.enums.get(m.array.clone()) {
        .Some(n) => n.str(),
        .None => "",
    }
}

// The members a record is written with: its own, or — for a union — its
// largest member, the one that fixes the union's size (VkClearValue's colour).
// Dunder has no unions; a record the size of its largest member is what
// Storm passes by address.
fn written_members(r: &Registry, rec: &Record) -> []Member {
    if !rec.union { return rec.members.clone() }
    mut best: []Member = []
    mut best_size: i64 = -1
    for m in &rec.members {
        s := c_size(r, m.type_name)
        if s.0 > best_size { best_size = s.0; best = [m.clone()] }
    }
    best
}

// The C size and alignment of a type name, with C alignment rules; (0, 0) when
// the type is not something the registry widths say, which the caller reports.
fn c_size(r: &Registry, type_name: string) -> (i64, i64) {
    if r.records.contains(type_name) {
        rec := r.records.get(type_name).unwrap()
        mut size: i64 = 0
        mut align: i64 = 1
        for m in &rec.members {
            s := member_size(r, m)
            if s.0 == 0 { return (0, 0) }
            if rec.union {
                if s.0 > size { size = s.0 }
            } else {
                size = (size + s.1 - 1) / s.1 * s.1 + s.0
            }
            if s.1 > align { align = s.1 }
        }
        return ((size + align - 1) / align * align, align)
    }
    match resolves_to(r, type_name) {
        "uint8_t" => (1, 1), "int8_t" => (1, 1), "char" => (1, 1),
        "uint16_t" => (2, 2), "int16_t" => (2, 2),
        "uint32_t" => (4, 4), "int32_t" => (4, 4), "int" => (4, 4), "float" => (4, 4),
        "uint64_t" => (8, 8), "int64_t" => (8, 8), "size_t" => (8, 8),
        _ => (0, 0),
    }
}

// The C size and alignment of one member: its type's, times its array length.
fn member_size(r: &Registry, m: &Member) -> (i64, i64) {
    if m.pointer || r.handles.contains(m.type_name) { return (8, 8) }
    base := c_size(r, m.type_name)
    if base.0 == 0 { return (0, 0) }
    length := array_length(r, m)
    if length == "" { return base }
    n := parse.integer(length)
    if !n.ok || n.value <= 0 { return (0, 0) }
    (base.0 * n.value, base.1)
}

// One record as Dunder: the `@c_layout` struct, then `impl X { pub unsafe fn
// new() -> X }` that zeroes it and, when the registry names the record's
// structure type, writes it. `new()` is the way a record with a tag is made,
// so the tag is never a number at a call site and can never be left out.
fn write_record(r: &Registry, name: string) -> string {
    rec := r.records.get("Vk" + name).unwrap()
    mut out: []u8 = []
    bytes.append_utf8(&mut out, "@c_layout\npub struct " + name + " {\n")
    for m in written_members(r, &rec) {
        t := member_type(r, &m)
        length := array_length(r, &m)
        if m.array != "" {
            bytes.append_utf8(&mut out, "    " + m.name + ": [" + t + "; " + length + "],\n")
        } else {
            bytes.append_utf8(&mut out, "    " + m.name + ": " + t + ",\n")
        }
    }
    bytes.append_utf8(&mut out, "}\n\n")
    bytes.append_utf8(&mut out, "impl " + name + " {\n")
    bytes.append_utf8(&mut out, "    pub unsafe fn new() -> " + name + " {\n")
    bytes.append_utf8(&mut out, "        mut value: " + name + " = zeroed()\n")
    if rec.structure_type != "" {
        match r.enums.get(rec.structure_type.clone()) {
            .Some(number) => bytes.append_utf8(&mut out, "        value.sType = " + number.str() + "\n"),
            .None => {},
        }
    }
    bytes.append_utf8(&mut out, "        value\n    }\n}\n\n")
    bytes.decode(&out).unwrap_or_default()
}

// layout.ddr: the generated records, then Storm's own records copied through
// from the current file below the marker.
fn write_layout(r: &Registry, names: &[]string, own: string) -> string {
    mut out: []u8 = []
    bytes.append_utf8(&mut out, "// Generated by tools/vk.ddr from Khronos' vk.xml. Do not edit above the marker.\n")
    bytes.append_utf8(&mut out, "// Vulkan structures Storm passes by address: field names, order and widths\n")
    bytes.append_utf8(&mut out, "// are the registry's. `new()` zeroes a record and writes its structure type,\n")
    bytes.append_utf8(&mut out, "// so that number exists in one place per record and nowhere at a call site.\n")
    bytes.append_utf8(&mut out, "capability unsafe\n\nimport gfx\n\n")
    for n in names {
        bytes.append_utf8(&mut out, write_record(r, n.clone()))
    }
    bytes.append_utf8(&mut out, own)
    bytes.decode(&out).unwrap_or_default()
}

// Everything from the marker to the end of `current`, marker line included.
fn own_records(current: string) -> string {
    match text.find(current, OWN_RECORDS_MARKER) {
        .Some(i) => current[i..current.len].clone(),
        .None => "",
    }
}

// Every record nested by value in `rec`, through a union's members too, as
// names with the `Vk` prefix.
fn nested_records(r: &Registry, rec: &Record) -> []string {
    mut out: []string = []
    for m in &rec.members {
        if m.pointer || !r.records.contains(m.type_name) { continue }
        out.push(m.type_name.clone())
        nested := r.records.get(m.type_name).unwrap()
        for n in nested_records(r, &nested) { out.push(n) }
    }
    out
}

// ---- main --------------------------------------------------------------------

// `--check` over one file: compare, or write. Returns the process exit code.
fn check_or_write(target: string, generated: string, check: bool) -> i32 {
    if check {
        current := sys.read_text(target)
        if !current.ok || current.value != generated {
            _ := sys.eprint("vk: " + target + " differs from what the registry generates; run tools/vk.ddr")
            return 1
        }
        print("vk: " + target + " matches the registry")
        return 0
    }
    _ := sys.write_text(target, generated)
    print("vk: wrote " + target)
    0
}

// Whether `name` (without `Vk`) is among the first `before` entries of `names`.
fn declared_before(names: &[]string, name: string, before: i32) -> bool {
    for i in 0..before {
        if names[i] == name { return true }
    }
    false
}

fn main() -> i32 {
    // usage: vk.ddr <vk.xml> [--check] [api|layout]
    // `--check` compares each target with what the registry generates instead
    // of writing it; the last argument narrows that to one file.
    path := if sys.arg_count() > 1 { sys.arg(1) } else { "" }
    mut check := false
    mut only := ""
    if sys.arg_count() > 2 && sys.arg(2) == "--check" { check = true }
    if sys.arg_count() > 2 && sys.arg(2) != "--check" { only = sys.arg(2) }
    if sys.arg_count() > 3 { only = sys.arg(3) }
    if path == "" {
        _ := sys.eprint("usage: dunder run tools/vk.ddr -- <vk.xml> [--check] [api|layout]")
        return 2
    }
    data := sys.read_u8(path)
    if !data.ok {
        _ := sys.eprint("vk: could not read " + path)
        return 2
    }
    r := registry(&data.value)
    for n in &COMMANDS {
        if !r.commands.contains(n.clone()) {
            _ := sys.eprint("vk: vk" + n + " is not in the registry")
            return 2
        }
    }
    // Every record Storm names is in the registry; every record nested in one
    // of them is declared before its user; every array length and structure
    // type resolves to a number the registry defines. A failure here is a tool
    // error, reported, never a guess.
    for i in 0..STRUCTS.len {
        name := STRUCTS[i]
        if !r.records.contains("Vk" + name) {
            _ := sys.eprint("vk: Vk" + name + " is not in the registry")
            return 2
        }
        rec := r.records.get("Vk" + name).unwrap()
        for nested in nested_records(r, &rec) {
            if !declared_before(&STRUCTS, nested[2..nested.len], i) {
                _ := sys.eprint("vk: " + nested + " is nested in Vk" + name + " but not declared before it in STRUCTS")
                return 2
            }
        }
        for m in &rec.members {
            if m.array != "" && array_length(r, m) == "" {
                _ := sys.eprint("vk: Vk" + name + "." + m.name + " has an array length the registry does not number: " + m.array)
                return 2
            }
            if m.pointer || !r.records.contains(m.type_name) { continue }
            for um in &r.records.get(m.type_name).unwrap().members {
                if um.array != "" && array_length(r, um) == "" {
                    _ := sys.eprint("vk: " + m.type_name + "." + um.name + " has an array length the registry does not number: " + um.array)
                    return 2
                }
            }
        }
        if rec.structure_type != "" && !r.enums.contains(rec.structure_type.clone()) {
            _ := sys.eprint("vk: Vk" + name + " names " + rec.structure_type + ", which the registry does not define")
            return 2
        }
    }
    if only == "" || only == "api" {
        code := check_or_write(API_TARGET, write_api(&r, &COMMANDS), check)
        if code != 0 { return code }
    }
    if only == "" || only == "layout" {
        current := sys.read_text(LAYOUT_TARGET)
        if !current.ok {
            _ := sys.eprint("vk: could not read " + LAYOUT_TARGET + " for Storm's own records")
            return 2
        }
        own := own_records(current.value)
        if own == "" {
            _ := sys.eprint("vk: " + LAYOUT_TARGET + " has no marker line '" + OWN_RECORDS_MARKER + "'")
            return 2
        }
        code := check_or_write(LAYOUT_TARGET, write_layout(&r, &STRUCTS, own), check)
        if code != 0 { return code }
    }
    0
}
