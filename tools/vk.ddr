                Selected { dunder: "Fragment", constant: "VK_SHADER_STAGE_FRAGMENT_BIT", comment: "VERTEX | FRAGMENT" },
                Selected { dunder: "VertexFragment", constant: "", comment: "VERTEX | FRAGMENT" },
