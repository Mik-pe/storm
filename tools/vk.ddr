// Generate packages/storm-vk/src/api.ddr, layout.ddr and enums.ddr from
// Khronos' vk.xml.
//
//   dunder run tools/vk.ddr -- <vk.xml>                 rewrite all three
//   dunder run tools/vk.ddr -- <vk.xml> --check         exit 1 when any differs
//   dunder run tools/vk.ddr -- <vk.xml> [--check] api   one file only: api, layout or enums
//
// The entry points Storm loads by name were written by hand: one `extern fn`
// and one `dl.symbol` per command, each spelled from the headers. This reads
// the registry instead, so a parameter type, a return type or a symbol name
// cannot be misremembered — there is no second copy to keep true. Storm still
// names the commands it calls (COMMANDS below); the names say nothing about
// their types. Which of them need a surface is the registry's answer too: the
// commands of an extension that depends on VK_KHR_surface are the windowed
// ones, followed through `depends=` as vk.xml states them.
//
// The records Storm passes by address (STRUCTS below) come from the registry
// the same way: field names, order and widths are the registry's, and every
// record whose sType member names a VkStructureType gets a `new()` that
// zeroes it and writes that number — the one place a structure type number
// exists in Storm. A union becomes its largest member (Dunder has no unions),
// which for VkClearValue is the four floats Storm clears with. Storm's own
// records, the ones that are not Vulkan's, stay hand-written below a marker
// that the generator copies through unchanged.
//
// The enums are the third file and the same division (ENUMS below): the
// registry owns every number, Storm owns the selection of enums and variants.
// A variant is found in its block by the name the tool derives from the
// constant (VK_BLEND_FACTOR_SRC_ALPHA → SrcAlpha), so the tool writes a
// variant only when the registry has a line for it and refuses the name
// otherwise; a combined flag set is the sum of named bits, never a number
// an integer someone added.
//
// vk.xml is not vendored. Fetch the Khronos registry when regenerating:
//   curl -o /tmp/vk.xml https://raw.githubusercontent.com/KhronosGroup/Vulkan-Docs/main/xml/vk.xml
//
// The registry is scanned as bytes: its tags are ASCII and its comments carry
// UTF-8 that a byte offset may land inside, so text is decoded only for the
// values between two tags, which always split on ASCII.
capability filesystem, stdio

import std.bytes as bytes
import std.map as map
import std.parse as parse
import std.text as text
import sys

// Entry points Storm calls, in the order api.ddr declares them: the C names
// without the `vk` prefix, which is the field name in `Api`.
const COMMANDS: []string = [
    "CreateInstance", "DestroyInstance", "DestroySurfaceKHR", "EnumeratePhysicalDevices",
    "GetPhysicalDeviceProperties", "GetPhysicalDeviceFormatProperties", "GetPhysicalDeviceMemoryProperties",
    "GetPhysicalDeviceQueueFamilyProperties", "GetPhysicalDeviceSurfaceSupportKHR",
    "GetPhysicalDeviceSurfaceCapabilitiesKHR", "GetPhysicalDeviceSurfaceFormatsKHR",
    "GetPhysicalDeviceSurfacePresentModesKHR", "CreateDevice", "GetDeviceQueue", "CreateCommandPool",
    "AllocateCommandBuffers", "CreateBuffer", "GetBufferMemoryRequirements", "AllocateMemory", "BindBufferMemory",
    "MapMemory", "UnmapMemory", "GetImageMemoryRequirements", "CreateShaderModule", "CreatePipelineLayout",
    "CreateGraphicsPipelines", "CreateRenderPass", "CreateFramebuffer", "CreateImage", "BindImageMemory", "CreateImageView",
    "CreateSwapchainKHR", "GetSwapchainImagesKHR", "AcquireNextImageKHR", "QueuePresentKHR", "CreateSemaphore",
    "CreateFence", "ResetFences", "WaitForFences", "DestroyFence", "DestroySemaphore", "DestroyImage", "DestroyImageView",
    "DestroyFramebuffer", "DestroyPipeline", "DestroyPipelineLayout", "DestroyShaderModule", "DestroyRenderPass",
    "DestroySwapchainKHR", "DestroyCommandPool", "DestroyBuffer", "FreeMemory", "FreeCommandBuffers", "DeviceWaitIdle",
    "QueueWaitIdle", "DestroyDevice", "BeginCommandBuffer", "EndCommandBuffer", "ResetCommandBuffer", "CmdBeginRenderPass",
    "CmdSetViewport", "CmdSetScissor", "CmdEndRenderPass", "CmdBindPipeline", "CmdBindVertexBuffers", "CmdDraw",
    "CmdPushConstants", "CmdPipelineBarrier", "CmdCopyImageToBuffer", "CmdCopyBufferToImage", "CmdBlitImage", "QueueSubmit",
    "CreateSampler", "DestroySampler", "CreateDescriptorSetLayout", "DestroyDescriptorSetLayout",
    "CreateDescriptorPool", "DestroyDescriptorPool", "ResetDescriptorPool", "AllocateDescriptorSets", "UpdateDescriptorSets",
    "CmdBindDescriptorSets",
]

// The extension whose commands only exist with a surface.
const SURFACE_EXTENSION: string = "VK_KHR_surface"

// Records Storm passes by address, without the `Vk` prefix, in the order
// layout.ddr declares them. A record nested by value in another is declared
// before its user, as C requires.
const STRUCTS: []string = [
    "ApplicationInfo", "InstanceCreateInfo", "DeviceQueueCreateInfo", "DeviceCreateInfo",
    "CommandPoolCreateInfo", "CommandBufferAllocateInfo", "MemoryRequirements", "MemoryAllocateInfo",
    "BufferCreateInfo", "ComponentMapping", "ImageSubresourceRange",
    "ImageSubresourceLayers", "ImageViewCreateInfo", "AttachmentDescription", "AttachmentReference",
    "SubpassDescription", "SubpassDependency", "RenderPassCreateInfo", "FramebufferCreateInfo",
    "ShaderModuleCreateInfo", "PipelineLayoutCreateInfo", "PushConstantRange", "SpecializationMapEntry",
    "SpecializationInfo", "PipelineShaderStageCreateInfo", "VertexInputBindingDescription",
    "VertexInputAttributeDescription", "PipelineVertexInputStateCreateInfo", "PipelineInputAssemblyStateCreateInfo",
    "Viewport", "Offset2D", "Extent2D", "Rect2D", "PipelineViewportStateCreateInfo", "PipelineDynamicStateCreateInfo",
    "PipelineRasterizationStateCreateInfo", "PipelineMultisampleStateCreateInfo",
    "PipelineColorBlendAttachmentState", "PipelineColorBlendStateCreateInfo", "GraphicsPipelineCreateInfo",
    "CommandBufferBeginInfo", "ClearColorValue", "ClearDepthStencilValue", "ClearValue",
    "RenderPassBeginInfo", "SubmitInfo", "PresentInfoKHR", "SwapchainCreateInfoKHR", "SurfaceCapabilitiesKHR",
    "SurfaceFormatKHR", "SemaphoreCreateInfo", "FenceCreateInfo", "Extent3D", "Offset3D", "ImageCreateInfo",
    // The device's memory types and heaps, read once at device selection
    // (device.allocate walks the types a requirement allows). Each heap is a
    // u64 and a u32 padded to 16 bytes, so the record is 520 bytes, not a
    // word buffer.
    "MemoryHeap", "MemoryType", "PhysicalDeviceMemoryProperties",
    // The device's limits, read at device selection (push-constant size,
    // image dimensions). The registry's record is 824 bytes (gcc, and the
    // same pinned in storm-vk's suite); a hand-written prefix plus a
    // guessed rest was 1356.
    "PhysicalDeviceSparseProperties", "PhysicalDeviceLimits", "PhysicalDeviceProperties",
    "StencilOpState", "PipelineDepthStencilStateCreateInfo", "BufferImageCopy", "ImageBlit",
    "FormatProperties", "MemoryBarrier", "ImageMemoryBarrier", "SamplerCreateInfo",
    "DescriptorSetLayoutBinding", "DescriptorSetLayoutCreateInfo", "DescriptorPoolSize",
    "DescriptorPoolCreateInfo", "DescriptorSetAllocateInfo", "DescriptorImageInfo", "WriteDescriptorSet",
    "DescriptorBufferInfo",
]

// The Vk enums Storm converts to a C integer. The registry owns the numbers;
// Storm owns the selection, and this table is the selection: the Dunder enum,
// the registry block its constants come from, and every variant Storm names
// with the registry constant it is (and Storm's reason, where there is one).
// Nothing here is derived from a name: Storm's `Type1` is VK_SAMPLE_COUNT_1_BIT.
// A flag set Storm names (ImageUsage.ColorAttachmentSampled) is the sum of the
// registry bits in `flag_sets`, never a number.
//
// A `const` cannot hold a table of structs (E3007), so each table is a
// function returning its literal; main builds them once.
struct Selected { dunder: string, constant: string, comment: string }
struct SelectedEnum { dunder: string, block: string, comment: string, variants: []Selected }
struct FlagSet { dunder: string, bits: []string }
struct NamedConstant { dunder: string, constant: string, comment: string }
struct Pair { dunder: string, first: string, second: string, record: string }

// A registry constant Storm names as a `pub const`: no enum of its own, one
// number the registry owns.
fn named_constants() -> []NamedConstant {
    [
        NamedConstant { dunder: "SUBPASS_EXTERNAL", constant: "VK_SUBPASS_EXTERNAL", comment: "the implicit subpass before/after the render pass" },
        NamedConstant { dunder: "QUEUE_FAMILY_IGNORED", constant: "VK_QUEUE_FAMILY_IGNORED", comment: "a barrier that does not transfer ownership between queue families" },
        NamedConstant { dunder: "IMAGE_LAYOUT_PRESENT_SRC_KHR", constant: "VK_IMAGE_LAYOUT_PRESENT_SRC_KHR", comment: "" },
    ]
}

// Records of two registry records, for pDependencies / pAttachments /
// pStages, so every caller hands Vulkan one named declaration instead of
// building its own array. A `[T; 2]` of a C record is contiguous too (measured:
// size 56, stride 28 for SubpassDependency; the old comment here claimed
// otherwise and the test contradicted it) — the pairs are names, not a
// layout fix. Both names are Storm's; the field types name a record in
// STRUCTS. `c_record_pairs_and_arrays_are_contiguous` pins both.
fn pairs() -> []Pair {
    [
        Pair { dunder: "Dependencies", first: "before", second: "after", record: "SubpassDependency" },
        Pair { dunder: "Attachments", first: "color", second: "depth", record: "AttachmentDescription" },
        Pair { dunder: "References", first: "color", second: "depth", record: "AttachmentReference" },
        Pair { dunder: "ShaderStages", first: "vertex", second: "fragment", record: "PipelineShaderStageCreateInfo" },
    ]
}

fn selected_enums() -> []SelectedEnum {
    [
        // VkBlendFactor
        SelectedEnum {
            dunder: "BlendFactor", block: "VkBlendFactor", comment: "", variants: [
                Selected { dunder: "Zero", constant: "VK_BLEND_FACTOR_ZERO", comment: "" },
                Selected { dunder: "One", constant: "VK_BLEND_FACTOR_ONE", comment: "" },
                Selected { dunder: "SrcColor", constant: "VK_BLEND_FACTOR_SRC_COLOR", comment: "" },
                Selected { dunder: "OneMinusSrcColor", constant: "VK_BLEND_FACTOR_ONE_MINUS_SRC_COLOR", comment: "" },
                Selected { dunder: "DstColor", constant: "VK_BLEND_FACTOR_DST_COLOR", comment: "" },
                Selected { dunder: "OneMinusDstColor", constant: "VK_BLEND_FACTOR_ONE_MINUS_DST_COLOR", comment: "" },
                Selected { dunder: "SrcAlpha", constant: "VK_BLEND_FACTOR_SRC_ALPHA", comment: "" },
