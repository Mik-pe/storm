// Storm shader builder. Run from the repo root:
//
//   dunder run tools/shaders.ddr
//
// For Vulkan it compiles GLSL to SPIR-V with glslangValidator and emits a
// Dunder module with the words as a fixed u32 array. For Metal it wraps the
// Metal source in a Dunder module as one raw string: the system's own
// compiler compiles it when a window opens, so neither build needs a shader
// compiler for that. (The source cannot simply be @embed_file'd: a
// dependency package cannot embed its own files, dogfood finding 63.)
//
// Re-run whenever a file under packages/*/shaders/ changes. The generated
// modules are checked in.
capability process, filesystem, stdio

import std.bytes as bytes
import std.process as process
import sys

struct Shader { stage: string, source: string, name: string }

fn shaders() -> []Shader {
    [Shader { stage: "vert", source: "packages/storm-vulkan/shaders/mesh.vert", name: "mesh_vertex" },
        Shader { stage: "frag", source: "packages/storm-vulkan/shaders/mesh.frag", name: "mesh_fragment" },
        Shader { stage: "vert", source: "packages/storm-vulkan/shaders/sky.vert", name: "sky_vertex" },
        Shader { stage: "frag", source: "packages/storm-vulkan/shaders/sky.frag", name: "sky_fragment" },
        Shader { stage: "vert", source: "packages/storm-vulkan/shaders/shadow.vert", name: "shadow_vertex" },
        Shader { stage: "frag", source: "packages/storm-vulkan/shaders/shadow.frag", name: "shadow_fragment" },
        Shader { stage: "vert", source: "packages/storm-vulkan/shaders/overlay.vert", name: "overlay_vertex" },
        Shader { stage: "frag", source: "packages/storm-vulkan/shaders/overlay.frag", name: "overlay_fragment" },
        Shader { stage: "vert", source: "packages/storm-vulkan/shaders/ui.vert", name: "ui_vertex" },
        Shader { stage: "frag", source: "packages/storm-vulkan/shaders/ui.frag", name: "ui_fragment" },
        Shader { stage: "vert", source: "packages/storm-vulkan/shaders/env.vert", name: "env_vertex" },
        Shader { stage: "frag", source: "packages/storm-vulkan/shaders/env.frag", name: "env_fragment" },
        Shader { stage: "frag", source: "packages/storm-vulkan/shaders/prefilter.frag", name: "prefilter_fragment" },
        Shader { stage: "frag", source: "packages/storm-vulkan/shaders/irradiance.frag", name: "irradiance_fragment" }]
}

// SPIR-V words from a little-endian .spv file.
fn read_words(path: string) -> []u32 {
    data := sys.read_u8(path)
    assert(data.ok)
    mut words: []u32 = []
    words.reserve(data.value.len / 4)
    for i in 0..data.value.len / 4 {
        words.push(u32(bytes.u32_le(&data.value, i * 4)))
    }
    words
}

fn write_module(out: string, entries: &[]Shader) {
    mut lines: []u8 = []
    bytes.append_utf8(&mut lines, "// Generated by tools/shaders.ddr from packages/storm-vulkan/shaders/*. Do not edit.\n")
    bytes.append_utf8(&mut lines, "// Each function returns SPIR-V 1.0 words for glslangValidator -V.\n\n")
    for s in entries {
        spv := "/tmp/storm-" + s.name + ".spv"
        mut args: []string = ["-V", s.source.clone(), "-o", spv.clone()]
        out_run := process.run("glslangValidator", args)
        if !out_run.ok || out_run.code != 0 {
            _ := sys.eprint("glslangValidator failed for " + s.source + "\n" + out_run.stderr_text())
            assert(false)
        }
        words := read_words(spv)
        bytes.append_utf8(&mut lines, "pub fn " + s.name + "() -> [u32; " + words.len.str() + "] {\n    [\n")
        // Four words a line: one word a line made ~13k lines that every build
        // has to parse again; at four a line the parse costs a fraction.
        for i in 0..words.len {
            if i % 4 == 0 { bytes.append_utf8(&mut lines, "        ") }
            bytes.append_utf8(&mut lines, u32(words[i]).str())
            if (i + 1) % 4 == 0 || i + 1 == words.len {
                bytes.append_utf8(&mut lines, ",\n")
            } else {
                bytes.append_utf8(&mut lines, ", ")
            }
        }
        bytes.append_utf8(&mut lines, "    ]\n}\n\n")
        _ := sys.remove_file(spv)
    }
    _ := sys.write_bytes(out, &lines)
    print("wrote " + out)
}

// The Metal source as one raw string in a Dunder module. The text is taken
// literally, so it must not contain the string's own closing quotes.
fn write_metal_module(source: string, out: string) {
    text := sys.read_text(source)
    if !text.ok {
        _ := sys.eprint("could not read " + source + ": " + sys.error_message(text.error))
        assert(false)
    }
    mut body := text.value
    // A trailing newline is the file's, not the shader's.
    if body.len > 0 && body[body.len - 1] == 10 { body = body[0..body.len - 1] }
    if contains_quotes(body) {
        _ := sys.eprint(source + " contains \"\"\" , which would end the raw string")
        assert(false)
    }
    mut lines: []u8 = []
    bytes.append_utf8(&mut lines, "// Generated by tools/shaders.ddr from " + source + ". Do not edit.\n")
    bytes.append_utf8(&mut lines, "//\n")
    bytes.append_utf8(&mut lines, "// Storm's Metal shaders, as source: the backend compiles them with the\n")
    bytes.append_utf8(&mut lines, "// system's own compiler when a window opens.\n")
    bytes.append_utf8(&mut lines, "pub const SOURCE: string = r#\"\"\"\n")
    bytes.append_utf8(&mut lines, body)
    bytes.append_utf8(&mut lines, "\n\"\"\"#\n")
    _ := sys.write_bytes(out, &lines)
    print("wrote " + out)
}

fn contains_quotes(text: string) -> bool {
    mut i := 0
    while i + 3 <= text.len {
        if text[i] == 34 && text[i + 1] == 34 && text[i + 2] == 34 { return true }
        i = i + 1
    }
    false
}

fn main() -> i32 {
    list := shaders()
    write_module("packages/storm-vulkan/src/shader.ddr", &list)
    write_metal_module("packages/storm-metal/shaders/storm.metal", "packages/storm-metal/src/shader.ddr")
    0
}
