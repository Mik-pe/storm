// Storm scene: hierarchy, names, shapes and materials on top of the ECS.
//
// A node is an entity with a LocalTransform, optionally a Parent, and whatever
// else it is made of: a Shape (which primitive to draw), a Material, a Name
// for the editor. `propagate` walks roots in depth-first order and writes
// WorldTransform. `drawables` collects every entity that has a shape and a
// world transform into the list the renderer consumes, so the frame is built
// from what the scene contains rather than from a hand-written list.
//
//   mut world := scene.Graph::new()
//   ground := world.create_root(core.vec3(0.0, 0.0, 0.0))
//   _ := world.set_shape(ground, .Plane)
//   _ := world.set_material(ground, scene.material(0.2, 0.21, 0.24, 1.0, 0.05, 0.85))
//   _ := world.set_name(ground, "Ground")
//   world.propagate()
//   list := world.drawables(core.vec3(0.0, 2.2, 9.5))
import core
import ecs
import std.math as _

pub struct LocalTransform {
    position: core.Vec3,
    rotation_x: f32,
    rotation_y: f32,
    rotation_z: f32,
    visible: bool,
    scale: core.Vec3,
}

pub struct Parent { entity: ecs.Entity }

pub struct WorldTransform { matrix: core.Mat4, visible: bool }

pub struct Name { value: string }

pub enum Shape { Cube = 0, Plane = 1, Mesh = 2, Sphere = 3 }

// A geometry owner stores interleaved position, normal and UV data. Instances
// carry the shape only. Graph.vertices resolves an instance and Drawable.mesh_index
// points directly to its geometry in a frame snapshot.
pub struct Mesh {
    shape: Shape,
    vertices: []f32,
}

pub enum MaterialField { BaseR = 0, BaseG = 1, BaseB = 2, BaseA = 3, Metallic = 4, Roughness = 5, Emissive = 6 }

pub enum TransformField { X = 0, Y = 1, Z = 2, Rotation = 3, ScaleX = 4, ScaleY = 5, ScaleZ = 6 }

// A PBR surface as the mesh shader takes it. Transparent surfaces are drawn
// in the blended pass, back to front; everything else relies on depth.
pub struct Material {
    base: core.Color,
    metallic: f32,
    roughness: f32,
    emissive: f32,
}

pub fn material(r: f32, g: f32, b: f32, a: f32, metallic: f32, roughness: f32) -> Material {
    Material { base: core.rgba(r, g, b, a), metallic: metallic, roughness: roughness, emissive: 0.0 }
}

// The same surface with an emissive term: what the shader adds on its own,
// for orbs, lamps and anything that should glow rather than reflect.
pub fn emissive_material(r: f32, g: f32, b: f32, a: f32, metallic: f32, roughness: f32, emissive: f32) -> Material {
    Material { base: core.rgba(r, g, b, a), metallic: metallic, roughness: roughness, emissive: emissive }
}

pub struct Drawable {
    entity: ecs.Entity,
    model: core.Mat4,
    material: Material,
    shape: Shape,
    mesh_index: i32,
    // Squared distance from the eye to the model origin, for sorting glass.
    depth: f32,
}

pub struct TreeRow { entity: ecs.Entity, depth: i32 }

pub struct Graph {
    allocator: ecs.EntityAllocator,
    locals: ecs.Pool<LocalTransform>,
    parents: ecs.Pool<Parent>,
    worlds: ecs.Pool<WorldTransform>,
    names: ecs.Pool<Name>,
    meshes: ecs.Pool<Mesh>,
    instances: ecs.Pool<ecs.Entity>,
    mesh_revision: i64,
    tree_revision: i64,
    world_order_revision: i64,
    world_order: []TreeRow,
    materials: ecs.Pool<Material>,
}

fn matrix_for(local: &LocalTransform) -> core.Mat4 {
    c := local.rotation_y.cos()
    s := local.rotation_y.sin()
    if local.rotation_x != 0.0 || local.rotation_z != 0.0 {
        // Yaw, then pitch about local X and roll about local Z.
        cx := local.rotation_x.cos()
        sx := local.rotation_x.sin()
        cz := local.rotation_z.cos()
        sz := local.rotation_z.sin()
        return core.Mat4 { m: [
            (c * cz + s * sx * sz) * local.scale.x, cx * sz * local.scale.x, (-s * cz + c * sx * sz) * local.scale.x, 0.0,
            (-c * sz + s * sx * cz) * local.scale.y, cx * cz * local.scale.y, (s * sz + c * sx * cz) * local.scale.y, 0.0,
            s * cx * local.scale.z, -sx * local.scale.z, c * cx * local.scale.z, 0.0,
            local.position.x, local.position.y, local.position.z, 1.0] }
    }
    core.Mat4 {
        m: [c * local.scale.x, 0.0, -s * local.scale.x, 0.0,
            0.0, local.scale.y, 0.0, 0.0,
            s * local.scale.z, 0.0, c * local.scale.z, 0.0,
            local.position.x, local.position.y, local.position.z, 1.0]
    }
}

impl Graph {
    pub fn new() -> Self {
        Self {
            allocator: ecs.EntityAllocator::new(),
            locals: ecs.Pool<LocalTransform>::new(),
            parents: ecs.Pool<Parent>::new(),
            worlds: ecs.Pool<WorldTransform>::new(),
            names: ecs.Pool<Name>::new(),
            meshes: ecs.Pool<Mesh>::new(),
            instances: ecs.Pool<ecs.Entity>::new(),
            mesh_revision: 0,
            tree_revision: 0,
            world_order_revision: -1, world_order: [],
            materials: ecs.Pool<Material>::new(),
        }
    }

    pub fn len(&self) -> i32 { self.allocator.len() }

    pub fn create_root(&mut self, position: core.Vec3) -> ecs.Entity {
        self.tree_revision = self.tree_revision + 1
        entity := self.allocator.create()
        _ := self.locals.insert(entity, LocalTransform { position: position, rotation_x: 0.0, rotation_y: 0.0, rotation_z: 0.0, visible: true, scale: core.vec3(1.0, 1.0, 1.0) })
        entity
    }

    pub fn create_child(&mut self, parent: ecs.Entity, position: core.Vec3) -> ecs.Entity {
        entity := self.create_root(position)
        if self.allocator.is_alive(parent) && parent.index != entity.index {
            _ := self.parents.insert(entity, Parent { entity: parent })
        }
        entity
    }

    pub fn set_position(&mut self, entity: ecs.Entity, position: core.Vec3) {
        if self.locals.contains(entity) { self.locals.get_mut(entity).position = position }
    }

    pub fn set_rotation(&mut self, entity: ecs.Entity, radians: f32) {
        if self.locals.contains(entity) { self.locals.get_mut(entity).rotation_y = radians }
    }

    pub fn set_angles(&mut self, entity: ecs.Entity, pitch: f32, yaw: f32, roll: f32) {
        if self.locals.contains(entity) {
            local := self.locals.get_mut(entity)
            local.rotation_x = pitch
            local.rotation_y = yaw
            local.rotation_z = roll
        }
    }

    pub fn set_visible(&mut self, entity: ecs.Entity, visible: bool) {
        if self.locals.contains(entity) { self.locals.get_mut(entity).visible = visible }
    }

    pub fn set_scale(&mut self, entity: ecs.Entity, scale: core.Vec3) {
        if self.locals.contains(entity) { self.locals.get_mut(entity).scale = scale }
    }

    pub fn set_name(&mut self, entity: ecs.Entity, move name: string) -> bool {
        if !self.allocator.is_alive(entity) { return false }
        self.tree_revision = self.tree_revision + 1
        if self.names.contains(entity) {
            self.names.get_mut(entity).value = name
            return true
        }
        self.names.insert(entity, Name { value: name }) >= 0
    }

    pub fn name(&self, entity: ecs.Entity) -> string {
        if !self.names.contains(entity) { return "" }
        self.names.get(entity).value.clone()
    }

    // Instances point straight to the owner, even when copied from another instance.
    fn mesh_owner(&self, entity: ecs.Entity) -> ecs.Entity {
        if self.instances.contains(entity) { return self.instances.get(entity).clone() }
        entity
    }

    // Hand geometry to a surviving instance before changing or destroying its owner.
    fn detach_mesh(&mut self, entity: ecs.Entity) {
        if self.instances.remove(entity).is_some() || self.instances.len() == 0 { return }
        mut next := entity
        for i in 0..self.instances.len() {
            if self.instances.at(i).index == entity.index {
                next = self.instances.entities()[i]
                break
            }
        }
        if next.index == entity.index { return }
        vertices := replace(&mut self.meshes.get_mut(entity).vertices, [])
        self.meshes.get_mut(next).vertices = vertices
        _ := self.instances.remove(next)
        for i in 0..self.instances.len() {
            if self.instances.at(i).index == entity.index {
                self.instances.at_mut(i).index = next.index
                self.instances.at_mut(i).generation = next.generation
            }
        }
    }

    // Share immutable geometry. Materials and transforms remain per entity.
    pub fn share_mesh(&mut self, dest: ecs.Entity, source: ecs.Entity) -> bool {
        if !self.is_alive(dest) || !self.meshes.contains(source) || self.meshes.get(source).shape != .Mesh { return false }
        owner := self.mesh_owner(source)
        if self.mesh_owner(dest).index == owner.index { return true }
        self.detach_mesh(dest)
        _ := self.meshes.insert(dest, Mesh { shape: .Mesh, vertices: [] })
        _ := self.instances.insert(dest, owner)
        self.mesh_revision = self.mesh_revision + 1
        true
    }

    pub fn set_shape(&mut self, entity: ecs.Entity, shape: Shape) -> bool {
        if !self.allocator.is_alive(entity) { return false }
        if self.meshes.contains(entity) && self.meshes.get(entity).shape == shape { return true }
        self.detach_mesh(entity)
        self.mesh_revision = self.mesh_revision + 1
        if self.meshes.contains(entity) {
            self.meshes.get_mut(entity).shape = shape
            return true
        }
        self.meshes.insert(entity, Mesh { shape: shape, vertices: [] }) >= 0
    }

    // Attach loaded geometry; the node becomes Shape.Mesh.
    pub fn set_mesh(&mut self, entity: ecs.Entity, move vertices: []f32) -> bool {
        if !self.allocator.is_alive(entity) { return false }
        self.detach_mesh(entity)
        self.mesh_revision = self.mesh_revision + 1
        _ := self.meshes.insert(entity, Mesh { shape: .Mesh, vertices: vertices })
        true
    }

    pub fn geometry_revision(&self) -> i64 { self.mesh_revision }
    pub fn mesh_snapshot(&self) -> []Mesh { self.meshes.values().clone() }

    pub fn vertices(&self, entity: ecs.Entity) -> []f32 {
        if !self.meshes.contains(entity) { return [] }
        self.meshes.get(self.mesh_owner(entity)).vertices.clone()
    }

    pub fn shape(&self, entity: ecs.Entity) -> Option<Shape> {
        if !self.meshes.contains(entity) { return .None }
        .Some(self.meshes.get(entity).shape)
    }

    // A node without a shape is not drawn; this is how the scene hides things.
    pub fn remove_shape(&mut self, entity: ecs.Entity) -> bool {
        if !self.meshes.contains(entity) { return false }
        self.detach_mesh(entity)
        match self.meshes.remove(entity) {
            .None => false,
            .Some(_) => { self.mesh_revision = self.mesh_revision + 1; true },
        }
    }

    pub fn set_material(&mut self, entity: ecs.Entity, move value: Material) -> bool {
        if !self.allocator.is_alive(entity) { return false }
        if self.materials.contains(entity) {
            self.materials.get_mut(entity).base = value.base.clone()
            self.materials.get_mut(entity).metallic = value.metallic
            self.materials.get_mut(entity).roughness = value.roughness
            self.materials.get_mut(entity).emissive = value.emissive
            return true
        }
        self.materials.insert(entity, value) >= 0
    }

    pub fn material_at(&self, entity: ecs.Entity) -> &Material from self { self.materials.get(entity) }
    pub fn has_material(&self, entity: ecs.Entity) -> bool { self.materials.contains(entity) }

    // The editor edits one number at a time through these: an Option cannot
    // carry a &mut in Dunder (E3099), and a field id is what a slider has anyway.
    pub fn material_value(&self, entity: ecs.Entity, field: MaterialField) -> f32 {
        if !self.materials.contains(entity) { return 0.0 }
        m := self.material_at(entity)
        match field {
            .BaseR => m.base.r,
            .BaseG => m.base.g,
            .BaseB => m.base.b,
            .BaseA => m.base.a,
            .Metallic => m.metallic,
            .Roughness => m.roughness,
            .Emissive => m.emissive,
        }
    }

    pub fn set_material_value(&mut self, entity: ecs.Entity, field: MaterialField, value: f32) -> bool {
        if !self.materials.contains(entity) { return false }
        m := self.materials.get_mut(entity)
        if field == MaterialField.BaseR { m.base.r = value }
        if field == MaterialField.BaseG { m.base.g = value }
        if field == MaterialField.BaseB { m.base.b = value }
        if field == MaterialField.BaseA { m.base.a = value }
        if field == MaterialField.Metallic { m.metallic = value }
        if field == MaterialField.Roughness { m.roughness = value }
        if field == MaterialField.Emissive { m.emissive = value }
        true
    }

    pub fn transform_value(&self, entity: ecs.Entity, field: TransformField) -> f32 {
        if !self.locals.contains(entity) { return 0.0 }
        t := self.locals.get(entity)
        match field {
            .X => t.position.x,
            .Y => t.position.y,
            .Z => t.position.z,
            .Rotation => t.rotation_y,
            .ScaleX => t.scale.x,
            .ScaleY => t.scale.y,
            .ScaleZ => t.scale.z,
        }
    }

    pub fn set_transform_value(&mut self, entity: ecs.Entity, field: TransformField, value: f32) -> bool {
        if !self.locals.contains(entity) { return false }
        t := self.locals.get_mut(entity)
        if field == TransformField.X { t.position.x = value }
        if field == TransformField.Y { t.position.y = value }
        if field == TransformField.Z { t.position.z = value }
        if field == TransformField.Rotation { t.rotation_y = value }
        if field == TransformField.ScaleX { t.scale.x = value }
        if field == TransformField.ScaleY { t.scale.y = value }
        if field == TransformField.ScaleZ { t.scale.z = value }
        true
    }

    pub fn local(&self, entity: ecs.Entity) -> &LocalTransform from self { self.locals.get(entity) }
    pub fn world(&self, entity: ecs.Entity) -> &WorldTransform from self { self.worlds.get(entity) }
    pub fn parent_of(&self, entity: ecs.Entity) -> Option<ecs.Entity> {
        if !self.parents.contains(entity) { return .None }
        .Some(self.parents.get(entity).entity)
    }

    pub fn hierarchy_revision(&self) -> i64 { self.tree_revision }

    // Dense indices build the adjacency list in one pass. The explicit stack
    // keeps deep trees iterable and puts each subtree next to its parent.
    pub fn hierarchy(&self) -> []TreeRow {
        mut children: []i32 = []
        mut siblings: []i32 = []
        mut pending: []i32 = []
        mut depths: []i32 = []
        count := self.locals.len()
        for _ in 0..count { children.push(-1); siblings.push(-1); depths.push(0) }
        for i in 0..count {
            entity := self.locals.entities()[i]
            if self.parents.contains(entity) {
                parent := self.locals.dense_index(self.parents.get(entity).entity)
                siblings[i] = children[parent]
                children[parent] = i
            }
            root := count - 1 - i
            if !self.parents.contains(self.locals.entities()[root]) { pending.push(root) }
        }
        mut rows: []TreeRow = []
        while pending.len > 0 {
            i := pending.pop()
            rows.push(TreeRow { entity: self.locals.entities()[i], depth: depths[i] })
            mut child := children[i]
            while child >= 0 {
                depths[child] = depths[i] + 1
                pending.push(child)
                child = siblings[child]
            }
        }
        rows
    }

    // Entities in creation order that have a local transform: the scene tree.
    pub fn nodes(&self) -> []ecs.Entity {
        self.locals.entities().clone()
    }

    // The pools, for queries from outside: a system joins what it needs
    // (`ecs.join2(graph.names(), graph.locals())`) instead of filtering
    // `nodes()` by hand. Borrowed for the call; clone rows out, as ever.
    pub fn locals(&self) -> &ecs.Pool < LocalTransform > from self { &self.locals }
    pub fn names(&self) -> &ecs.Pool < Name > from self { &self.names }
    pub fn meshes(&self) -> &ecs.Pool < Mesh > from self { &self.meshes }
    pub fn materials(&self) -> &ecs.Pool < Material > from self { &self.materials }
    pub fn worlds(&self) -> &ecs.Pool < WorldTransform > from self { &self.worlds }

    pub fn is_alive(&self, entity: ecs.Entity) -> bool { self.allocator.is_alive(entity) }

    pub fn destroy(&mut self, entity: ecs.Entity) -> bool {
        if !self.allocator.is_alive(entity) { return false }
        self.tree_revision = self.tree_revision + 1
        // Detach children so they become roots rather than dangling links.
        mut detached: []ecs.Entity = []
        for i in 0..self.parents.len() {
            if self.parents.values()[i].entity.index == entity.index {
                detached.push(self.parents.entities()[i])
            }
        }
        for child in detached { _ := self.parents.remove(child) }
        _ := self.names.remove(entity)
        _ := self.remove_shape(entity)
        _ := self.materials.remove(entity)
        _ := self.worlds.remove(entity)
        _ := self.locals.remove(entity)
        self.allocator.destroy(entity)
    }

    // The cached hierarchy puts every parent before its children. Recompute
    // matrices in that order, including nodes below any depth.
    pub fn propagate(&mut self) {
        if self.world_order_revision != self.tree_revision {
            self.world_order = self.hierarchy()
            self.world_order_revision = self.tree_revision
        }
        for i in 0..self.world_order.len {
            entity := self.world_order[i].entity
            local := self.locals.get(entity)
            mut matrix := matrix_for(local)
            mut visible := local.visible
            if self.parents.contains(entity) {
                parent := self.parents.get(entity).entity
                basis := self.worlds.get(parent)
                matrix = core.multiply(basis.matrix, matrix)
                visible = visible && basis.visible
            }
            if self.worlds.contains(entity) { self.worlds.get_mut(entity).matrix = matrix; self.worlds.get_mut(entity).visible = visible }
            else { _ := self.worlds.insert(entity, WorldTransform { matrix: matrix, visible: visible }) }
        }
    }

    // Everything drawable, in creation order, with its distance to the eye.
    // Call after propagate(). Entities with a shape but no material get a
    // neutral grey so the scene never silently drops a node.
    pub fn drawables(&self, eye: core.Vec3) -> []Drawable {
        mut out: []Drawable = []
        // A shape and a world matrix make a drawable; a material is optional.
        for row in ecs.join2(&self.meshes, &self.worlds) {
            if !self.worlds.at(row.b).visible { continue }
            model := self.worlds.at(row.b).matrix.clone()
            dx := model.m[12] - eye.x
            dy := model.m[13] - eye.y
            dz := model.m[14] - eye.z
            mi := self.materials.dense_index(row.entity)
            mat := if mi >= 0 { self.materials.at(mi).clone() } else { material(0.5, 0.5, 0.5, 1.0, 0.0, 0.8) }
            out.push(Drawable {
                entity: row.entity,
                model: model,
                material: mat,
                shape: self.meshes.at(row.a).shape,
                mesh_index: if self.instances.contains(row.entity) { self.meshes.dense_index(self.instances.get(row.entity).clone()) } else { row.a },
                depth: dx * dx + dy * dy + dz * dz,
            })
        }
        out
    }
}
