// A view describes controls in paint order. Keys keep focus and a drag tied
// to the same model item when the description changes between frames.
import .interaction
import .layout
import .ui
import .widgets
import text
import std.text.grapheme as segmentation

pub struct Key { group: i64, item: i64 }
pub fn key(group: i64, item: i64) -> Key { Key { group: group, item: item } }
fn same(a: &Key, b: &Key) -> bool { a.group == b.group && a.item == b.item }

pub struct Style {
    root: ui.Color, chrome: ui.Color, panel: ui.Color, fill: ui.Color,
    raised: ui.Color, border: ui.Color, accent: ui.Color, selection: ui.Color,
    ink: ui.Color, quiet: ui.Color, accent_ink: ui.Color,
}

pub fn dark() -> Style {
    Style { root: ui.rgb(0.064, 0.072, 0.088), chrome: ui.rgb(0.073, 0.082, 0.1),
        panel: ui.rgb(0.099, 0.114, 0.139), fill: ui.rgb(0.137, 0.158, 0.191),
        raised: ui.rgb(0.191, 0.216, 0.255), border: ui.rgb(0.238, 0.268, 0.309),
        accent: ui.rgb(0.447, 0.898, 0.753), selection: ui.rgb(0.132, 0.259, 0.239),
        ink: ui.rgb(0.944, 0.959, 0.965), quiet: ui.rgb(0.700, 0.753, 0.791),
        accent_ink: ui.rgb(0.032, 0.110, 0.094) }
}

pub enum Tone { Quiet, Normal, Heading }
pub enum Align { Start, End, Center }
pub enum ButtonStyle { Outline, Primary, Selected, Row, Disabled }

pub struct Slider { value: f32, lo: f32, hi: f32 }

enum Kind {
    Fill(ui.Color),
    Rounded(f32, ui.Color),
    Label(Tone, Align),
    Button(ButtonStyle),
    Toggle(bool),
    Slider(Slider),
    Field(string),
}

struct Node<A> {
    rect: layout.Rect, title: string, kind: Kind,
    identity: Option<Key>, action: Option<A>, clip: Option<layout.Rect>,
}

struct FocusRange { first: i32, end: i32 }

pub struct View<A> { nodes: []Node<A>, modal: Option<FocusRange> }

impl View<A> {
    pub fn new() -> Self { Self { nodes: [], modal: .None } }

    // A child uses the same point coordinates as the parent. Nested clips
    // intersect once here and are used by both rendering and input.
    pub fn clipped(&mut self, bounds: layout.Rect, move child: Self) {
        self.attach(bounds, move child, false, 0.0)
    }

    pub fn scroll(&mut self, bounds: layout.Rect, offset: &layout.Scroll, move child: Self) {
        self.attach(bounds, move child, false, -offset.offset)
    }

    // A modal keeps keyboard focus and pointer presses inside its child.
    pub fn modal(&mut self, bounds: layout.Rect, move child: Self) {
        self.attach(bounds, move child, true, 0.0)
    }

    fn attach(&mut self, bounds: layout.Rect, move child: Self, modal: bool, dy: f32) {
        first := self.nodes.len
        match child.modal {
            .Some(scope) => { self.modal = .Some(FocusRange { first: first + scope.first, end: first + scope.end }) },
            .None => {
                if modal { self.modal = .Some(FocusRange { first: first, end: first + child.nodes.len }) }
            },
        }
        self.nodes.reserve(first + child.nodes.len)
        for record in move child.nodes {
            mut node := move record
            node.rect.y += dy
            node.clip = .Some(match node.clip {
                .Some(inside) => bounds.intersect(&layout.rect(inside.x, inside.y + dy, inside.w, inside.h)),
                .None => bounds.clone(),
            })
            self.nodes.push(move node)
        }
    }

    pub fn fill(&mut self, rect: layout.Rect, color: ui.Color) {
        self.nodes.push(Node<A> { rect: rect, title: "", kind: .Fill(color), identity: .None, action: .None, clip: .None })
    }

    pub fn rounded(&mut self, rect: layout.Rect, radius: f32, color: ui.Color) {
        self.nodes.push(Node<A> { rect: rect, title: "", kind: .Rounded(radius, color), identity: .None, action: .None, clip: .None })
    }

    pub fn label(&mut self, rect: layout.Rect, title: string, tone: Tone, align: Align) {
        self.nodes.push(Node<A> { rect: rect, title: title.clone(), kind: .Label(tone, align), identity: .None, action: .None, clip: .None })
    }

    pub fn button(&mut self, rect: layout.Rect, id: Key, title: string, style: ButtonStyle, move action: A) {
        if style == .Disabled { self.disabled_button(rect, title); return }
        self.nodes.push(Node<A> { rect: rect, title: title.clone(), kind: .Button(style), identity: .Some(id), action: .Some(move action), clip: .None })
    }

    pub fn disabled_button(&mut self, rect: layout.Rect, title: string) {
        self.nodes.push(Node<A> { rect: rect, title: title.clone(), kind: .Button(.Disabled), identity: .None, action: .None, clip: .None })
    }

    pub fn toggle(&mut self, rect: layout.Rect, id: Key, title: string, checked: bool, move action: A) {
        self.nodes.push(Node<A> { rect: rect, title: title.clone(), kind: .Toggle(checked), identity: .Some(id), action: .Some(move action), clip: .None })
    }

    pub fn slider(&mut self, rect: layout.Rect, id: Key, title: string, model: Slider, move action: A) {
        self.nodes.push(Node<A> { rect: rect, title: title.clone(), kind: .Slider(model), identity: .Some(id), action: .Some(move action), clip: .None })
    }

    pub fn field(&mut self, rect: layout.Rect, id: Key, value: string, placeholder: string, move action: A) {
        self.nodes.push(Node<A> { rect: rect, title: placeholder.clone(), kind: .Field(value.clone()), identity: .Some(id), action: .Some(move action), clip: .None })
    }
}

pub enum Event<A> { Press(A), Slide(A, f32), Text(A, string) }
pub enum Navigation { None, Next, Previous, Activate, Decrease, Increase, Dismiss }

pub struct State { pointer: interaction.Capture<Key>, focus: Option<Key> }
impl State {
    pub fn new() -> Self { Self { pointer: interaction.Capture<Key>::new(), focus: .None } }

    pub fn focused(&self, wanted: Key) -> bool {
        match self.focus { .Some(id) => same(&id, &wanted), .None => false }
    }
}

fn combined_clip(outer: &Option<layout.Rect>, inner: &Option<layout.Rect>) -> Option<layout.Rect> {
    match outer {
        .None => inner.clone(),
        .Some(parent) => match inner {
            .Some(child) => Option<layout.Rect>.Some(parent.intersect(child)),
            .None => outer.clone(),
        },
    }
}

fn input_bounds<A>(node: &Node<A>, inherited: &Option<layout.Rect>) -> layout.Rect {
    match combined_clip(inherited, &node.clip) { .Some(clip) => node.rect.intersect(&clip), .None => node.rect.clone() }
}

fn focus_range<A>(view: &View<A>) -> FocusRange {
    match view.modal { .Some(scope) => scope.clone(), .None => FocusRange { first: 0, end: view.nodes.len } }
}

fn lookup<A>(view: &View<A>, scope: &FocusRange, inherited: &Option<layout.Rect>, key: &Option<Key>) -> i32 {
    match key {
        .None => -1,
        .Some(wanted) => {
            for i in scope.first..scope.end {
                if input_bounds(&view.nodes[i], inherited).empty() { continue }
                match view.nodes[i].identity {
                    .Some(id) => { if same(&id, wanted) { return i } },
                    .None => {},
                }
            }
            -1
        },
    }
}

fn focused<A>(view: &View<A>, scope: &FocusRange, inherited: &Option<layout.Rect>, current: i32, step: i32) -> i32 {
    count := scope.end - scope.first
    if count == 0 { return -1 }
    mut index := if current >= 0 { current - scope.first } else if step < 0 { 0 } else { -1 }
    for _ in 0..count {
        index = (index + step + count) % count
        at := scope.first + index
        if view.nodes[at].identity.is_some() && !input_bounds(&view.nodes[at], inherited).empty() { return at }
    }
    -1
}

fn bar(rect: &layout.Rect) -> layout.Rect {
    label := rect.w * 0.42
    layout.rect(rect.x + label, rect.y + (rect.h - 4.0) * 0.5, rect.w - label - 44.0, 4.0)
}

fn text_at(canvas: &mut ui.Canvas, atlas: &text.Atlas, bounds: &layout.Rect, title: string,
    size: f32, align: Align, color: &ui.Color) {
    scale := size / ui.RASTER_SIZE
    fitted := ui.fit(atlas, title, bounds.w, scale)
    width := ui.Canvas::text_width(atlas, fitted, scale)
    pad := if width >= bounds.w { f32(0.0) } else if align == .End { bounds.w - width }
        else if align == .Center { (bounds.w - width) * 0.5 } else { f32(0.0) }
    canvas.text_in(atlas, fitted, bounds.x + pad, bounds.y + (bounds.h - size) * 0.5 - 1.0, scale, color, bounds)
}

fn paint<A>(node: &Node<A>, canvas: &mut ui.Canvas, atlas: &text.Atlas, style: &Style, over: bool, down: bool, focus: bool) {
    r := &node.rect
    if r.w <= 0.0 || r.h <= 0.0 { return }
    match node.kind {
        .Fill(color) => canvas.rect(r.x, r.y, r.w, r.h, color),
        .Rounded(radius, color) => canvas.smooth_rounded_rect(r.x, r.y, r.w, r.h, radius, color),
        .Label(tone, align) => {
            size: f32 = if tone == .Heading { 18.0 } else if tone == .Quiet { 13.0 } else { 15.0 }
            ink := if tone == .Quiet { style.quiet.clone() } else { style.ink.clone() }
            text_at(&mut canvas, atlas, r, node.title, size, align, &ink)
        },
        .Button(kind) => {
            if kind != .Row || over || down || focus {
                fill := if kind == .Primary { style.accent.clone() }
                    else if kind == .Selected { style.selection.clone() }
                    else if down || over { style.raised.clone() } else { style.fill.clone() }
                if kind == .Outline {
                    canvas.smooth_rounded_rect(r.x, r.y, r.w, r.h, 7.0, &style.border)
                    canvas.smooth_rounded_rect(r.x + 1.0, r.y + 1.0, r.w - 2.0, r.h - 2.0, 6.0, &fill)
                } else {
                    canvas.smooth_rounded_rect(r.x, r.y, r.w, r.h, 7.0, &fill)
                }
            }
            if kind == .Selected || focus { canvas.rect(r.x + 2.0, r.y + 4.0, 2.0, r.h - 8.0, &style.accent) }
            ink := if kind == .Primary { style.accent_ink.clone() }
                else if kind == .Disabled { style.quiet.clone() } else { style.ink.clone() }
            row := kind == .Selected || kind == .Row
            inset: f32 = if row { 5.0 } else { 9.0 }
            text_at(&mut canvas, atlas, &r.inset(inset, 0.0), node.title, 14.0, if row { .Start } else { .Center }, &ink)
        },
        .Slider(model) => {
            track := bar(r)
            fraction := interaction.fraction(model.value, model.lo, model.hi)
            knob := track.x + fraction * track.w
            if over || focus { canvas.smooth_rounded_rect(r.x, r.y, r.w, r.h, 4.0, &style.fill) }
            text_at(&mut canvas, atlas, &layout.rect(r.x + 3.0, r.y, track.x - r.x - 7.0, r.h), node.title, 12.0, .Start, &style.quiet)
            if track.w > 0.0 {
                canvas.smooth_rounded_rect(track.x, track.y, track.w, track.h, 2.0, &style.border)
                canvas.smooth_rounded_rect(track.x, track.y, knob - track.x, track.h, 2.0, &style.accent)
                canvas.smooth_rounded_rect(knob - 4.0, track.y - 2.0, 8.0, 8.0, 4.0, &style.ink)
            }
            numeric := layout.rect(r.x + r.w - 42.0, r.y + 3.0, 42.0, r.h - 6.0)
            canvas.smooth_rounded_rect(numeric.x, numeric.y, numeric.w, numeric.h, 5.0, &style.fill)
            text_at(&mut canvas, atlas, &numeric.inset(4.0, 0.0), widgets.decimal2(model.value), 12.0, .End, &style.ink)
        },
        .Field(value) => {
            border := if focus { style.accent.clone() } else { style.border.clone() }
            canvas.smooth_rounded_rect(r.x, r.y, r.w, r.h, 7.0, &border)
            canvas.smooth_rounded_rect(r.x + 1.0, r.y + 1.0, r.w - 2.0, r.h - 2.0, 6.0, &style.root)
            content := r.inset(11.0, 0.0)
            if value.len == 0 { text_at(&mut canvas, atlas, &content, node.title, 14.0, .Start, &style.quiet) }
            else { text_at(&mut canvas, atlas, &content, value, 14.0, .Start, &style.ink) }
        },
        .Toggle(checked) => {
            if over || focus { canvas.smooth_rounded_rect(r.x, r.y, r.w, r.h, 4.0, &style.fill) }
            x := r.x + r.w - 32.0
            y := r.y + (r.h - 15.0) * 0.5
            text_at(&mut canvas, atlas, &layout.rect(r.x + 3.0, r.y, r.w - 37.0, r.h), node.title, 13.0, .Start, &style.ink)
            canvas.smooth_rounded_rect(x, y, 29.0, 15.0, 7.5, &if checked { style.accent } else { style.border })
            canvas.smooth_rounded_rect(x + (if checked { 16.0 } else { 3.0 }), y + 2.0, 11.0, 11.0, 5.5, &style.ink)
        },
    }
}

// Return at most one model event. The last interactive node at a point wins.
// A drag keeps its key when the view is rebuilt, and cancels if that key disappears.
pub struct Entry { text: string, erase: bool }

fn changed_text(value: string, entry: &Entry) -> string {
    mut out := value.clone()
    if entry.erase {
        mut last := 0
        mut end := 0
        while end < out.len {
            last = end
            end = segmentation.next_boundary(out.as_str(), end)
        }
        out = out[0..last]
    }
    for byte in entry.text.bytes() {
        if byte < 32 || byte == 127 { return out }
    }
    if out.len + entry.text.len <= 240 { return out + entry.text }
    out
}

pub fn frame<A: Clone>(view: &View<A>, state: &mut State, canvas: &mut ui.Canvas, atlas: &text.Atlas,
    pointer: &widgets.Pointer, style: &Style, navigation: Navigation, entry: &Entry) -> Option<Event<A>> {
    inherited := canvas.set_clip(.None)
    scope := focus_range(view)
    mut captured := lookup(view, &scope, &inherited, &state.pointer.key)
    mut focus := lookup(view, &scope, &inherited, &state.focus)
    if !pointer.down || captured < 0 { state.pointer.release(); captured = -1 }
    mut hot := -1
    for i in scope.first..scope.end {
        node := &view.nodes[i]
        if node.identity.is_some() && input_bounds(node, &inherited).contains(pointer.x, pointer.y) { hot = i }
    }
    if navigation == .Next { focus = focused(view, &scope, &inherited, focus, 1) }
    if navigation == .Previous { focus = focused(view, &scope, &inherited, focus, -1) }
    if navigation == .Dismiss {
        focus = -1
        captured = -1
        state.pointer.release()
    } else {
        target := if hot < 0 { Option<Key>.None } else { view.nodes[hot].identity.clone() }
        if state.pointer.press(target, pointer.pressed) { captured = hot; focus = hot }
    }
    state.focus = if focus < 0 { .None } else { view.nodes[focus].identity.clone() }

    for i in 0..view.nodes.len {
        node := &view.nodes[i]
        _ := canvas.set_clip(combined_clip(&inherited, &node.clip))
        if !input_bounds(node, &inherited).empty() {
            paint(node, &mut canvas, atlas, style, hot == i, captured == i, focus == i)
        }
    }
    _ := canvas.set_clip(inherited)
    if focus >= 0 && (entry.erase || entry.text.len > 0) {
        focused := &view.nodes[focus]
        match focused.kind {
            .Field(value) => {
                next := changed_text(value, entry)
                if next != value { return .Some(Event<A>.Text(focused.action.clone().unwrap(), next)) }
            },
            _ => {},
        }
    }
    keyboard := navigation == .Activate || navigation == .Decrease || navigation == .Increase
    target := if keyboard { focus } else { captured }
    if target < 0 { return .None }
    node := &view.nodes[target]
    action := node.action.clone().unwrap()
    match node.kind {
        .Slider(model) => {
            track := bar(&node.rect)
            span := model.hi - model.lo
            if span <= 0.0 || navigation == .Activate { return .None }
            mut value := model.value
            if keyboard {
                fraction := interaction.fraction(model.value, model.lo, model.hi)
                step: f32 = if navigation == .Increase { 0.025 } else { -0.025 }
                value = model.lo + span * interaction.unit(fraction + step)
            } else if pointer.down || pointer.pressed {
                value = interaction.slide(pointer.x, track.x, track.w, model.lo, model.hi).unwrap_or(model.value)
            }
            if value != model.value { return .Some(Event<A>.Slide(move action, value)) }
        },
        .Field(_) => {},
        _ => {
            if pointer.pressed || navigation == .Activate { return .Some(Event<A>.Press(move action)) }
        },
    }
    .None
}
