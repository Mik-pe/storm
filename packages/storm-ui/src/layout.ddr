// Layout uses points, the same space as pointer and canvas geometry.
pub struct Rect { x: f32, y: f32, w: f32, h: f32 }

fn positive(value: f32) -> f32 { if value > 0.0 { value } else { 0.0 } }

pub fn rect(x: f32, y: f32, w: f32, h: f32) -> Rect {
    Rect { x: x, y: y, w: positive(w), h: positive(h) }
}

impl Rect {
    pub fn empty(&self) -> bool { self.w <= 0.0 || self.h <= 0.0 }

    pub fn contains(&self, x: f32, y: f32) -> bool {
        x >= self.x && y >= self.y && x < self.x + self.w && y < self.y + self.h
    }

    pub fn inset(&self, horizontal: f32, vertical: f32) -> Rect {
        rect(self.x + horizontal, self.y + vertical, self.w - horizontal * 2.0, self.h - vertical * 2.0)
    }

    pub fn visible_in(&self, clip: &Rect) -> bool {
        self.w > 0.0 && self.h > 0.0 && self.x >= clip.x && self.y >= clip.y && self.x + self.w <= clip.x + clip.w && self.y + self.h <= clip.y + clip.h
    }

    pub fn intersect(&self, other: &Rect) -> Rect {
        x := if self.x > other.x { self.x } else { other.x }
        y := if self.y > other.y { self.y } else { other.y }
        right := if self.x + self.w < other.x + other.w { self.x + self.w } else { other.x + other.w }
        bottom := if self.y + self.h < other.y + other.h { self.y + self.h } else { other.y + other.h }
        rect(x, y, right - x, bottom - y)
    }
}

// Raster edges use a closed bound, hit testing uses a half-open bound.
pub fn covers(bounds: &Rect, x: f32, y: f32) -> bool {
    !bounds.empty() && x >= bounds.x && y >= bounds.y && x <= bounds.x + bounds.w && y <= bounds.y + bounds.h
}

pub struct Scroll { offset: f32 }

impl Scroll {
    pub fn new() -> Self { Self { offset: 0.0 } }
    pub fn reset(&mut self) { self.offset = 0.0 }

    pub fn limit(&mut self, viewport: &Rect, height: f32) {
        max := positive(height - viewport.h)
        self.offset = if self.offset > max { max } else { positive(self.offset) }
    }

    pub fn wheel(&mut self, viewport: &Rect, x: f32, y: f32, delta: f32, step: f32) {
        if delta != 0.0 && viewport.contains(x, y) {
            self.offset += if delta > 0.0 { -step } else { step }
        }
    }

    pub fn reveal(&mut self, viewport: &Rect, top: f32, bottom: f32) {
        if top < self.offset { self.offset = top }
        else if bottom > self.offset + viewport.h { self.offset = bottom - viewport.h }
    }

    pub fn visible_items(&self, viewport: &Rect, count: i32, height: f32) -> Items {
        if height <= 0.0 || viewport.empty() { return Items { first: 0, end: 0 } }
        first := i32(self.offset / height)
        bottom := self.offset + viewport.h
        mut end := i32(bottom / height)
        if f32(end) * height < bottom { end += 1 }
        Items { first: first, end: if end < count { end } else { count } }
    }
}

pub struct Items { first: i32, end: i32 }

pub enum Axis { Row, Column }

pub struct Stack { bounds: Rect, axis: Axis, gap: f32, cursor: f32 }

impl Stack {
    pub fn new(bounds: Rect, axis: Axis, gap: f32) -> Self {
        Self { bounds: bounds, axis: axis, gap: positive(gap), cursor: 0.0 }
    }

    // Lay out every child at its requested extent. A scrollable panel may
    // build children beyond its viewport and use the same rectangles to clip
    // visibility and pointer routing.
    pub fn next(&mut self, extent: f32) -> Rect {
        size := positive(extent)
        at := self.cursor
        self.cursor += size + self.gap
        if self.axis == .Row { return rect(self.bounds.x + at, self.bounds.y, size, self.bounds.h) }
        rect(self.bounds.x, self.bounds.y + at, self.bounds.w, size)
    }

    pub fn extent(&self) -> f32 { positive(self.cursor - self.gap) }
}
