// Source-compatible immediate controls for games that predate keyed views.
import text
import .ui as ui
import .interaction
import .layout

pub const SLIDER_HEIGHT: f32 = 22.0
pub const ROW_HEIGHT: f32 = 28.0

// What the widgets need to know about the pointer this frame.
pub struct Pointer {
    x: f32,
    y: f32,
    down: bool,
    pressed: bool,
}

impl Pointer {
    pub fn at(x: f32, y: f32, pressed: bool, down: bool) -> Pointer {
        Pointer { x: x, y: y, down: down, pressed: pressed }
    }
}

pub struct Theme {
    fill: ui.Color,
    fill_hot: ui.Color,
    fill_active: ui.Color,
    border: ui.Color,
    ink: ui.Color,
    ink_dim: ui.Color,
    track: ui.Color,
    knob: ui.Color,
}

pub fn theme() -> Theme {
    Theme {
        fill: ui.rgb(0.17, 0.18, 0.19),
        fill_hot: ui.rgb(0.22, 0.23, 0.24),
        fill_active: ui.rgb(0.28, 0.235, 0.17),
        border: ui.rgb(0.24, 0.25, 0.26),
        ink: ui.rgb(0.94, 0.94, 0.93),
        ink_dim: ui.rgb(0.70, 0.71, 0.72),
        track: ui.rgb(0.24, 0.25, 0.26),
        knob: ui.rgb(0.94, 0.73, 0.40),
    }
}

pub struct State { pointer: interaction.Capture<i32> }

pub fn hit(p: &Pointer, x: f32, y: f32, w: f32, h: f32) -> bool {
    layout.rect(x, y, w, h).contains(p.x, p.y)
}

impl State {
    pub fn new() -> Self { Self { pointer: interaction.Capture<i32>::new() } }
    pub fn active(&self) -> i32 { self.pointer.key.unwrap_or(0) }
    pub fn begin(&mut self) {}

    pub fn end(&mut self, p: &Pointer) {
        if !p.down { self.pointer.release() }
    }

    // Returns true on the frame the widget is pressed (press began on it).
    pub fn button(&mut self, canvas: &mut ui.Canvas, atlas: &text.Atlas, id: i32, p: &Pointer,
        x: f32, y: f32, w: f32, h: f32, label: string, theme: &Theme) -> bool {
        hover := self.active() == 0 && hit(p, x, y, w, h)
        clicked := self.pointer.press(.Some(id), hover && p.pressed)
        held := self.active() == id
        fill := if held { theme.fill_active } else if hover { theme.fill_hot } else { theme.fill }
        canvas.rounded_rect(x, y, w, h, 5.0, &fill)
        tw := ui.Canvas::text_width(atlas, label, 0.61)
        canvas.text(atlas, label, x + (w - tw) * 0.5, y + (h - 14.0) * 0.5 - 1.0, 0.61, &theme.ink)
        clicked
    }

    // A labelled horizontal slider. Returns true when the value changed this
    // frame. The label sits left of the track; the value right of it.
    pub fn slider(&mut self, canvas: &mut ui.Canvas, atlas: &text.Atlas, id: i32, p: &Pointer,
        x: f32, y: f32, w: f32, label: string, value: &mut f32, min: f32, max: f32, theme: &Theme) -> bool {
        label_width: f32 = if w <= 210.0 { 72.0 } else { 92.0 }
        value_width: f32 = if w <= 210.0 { 36.0 } else { 52.0 }
        track_x := x + label_width
        track_w := w - label_width - value_width
        track_y := y + 7.0
        mut changed := false
        hover := self.active() == 0 && hit(p, x, y, w, SLIDER_HEIGHT)
        _ := self.pointer.press(.Some(id), hover && p.pressed)
        if self.active() == id && (p.down || p.pressed) {
            dragged := interaction.slide(p.x, track_x, track_w, min, max).unwrap_or(value)
            changed = dragged != value
            value = dragged
        }
        canvas.text(atlas, label, x, y + 1.0, 0.61, &theme.ink_dim)
        canvas.rounded_rect(track_x, track_y + 2.0, track_w, 3.0, 1.5, &theme.track)
        t := interaction.fraction(value, min, max)
        knob_x := track_x + t * track_w
        canvas.rounded_rect(track_x, track_y + 2.0, knob_x - track_x, 3.0, 1.5, &theme.knob)
        canvas.rounded_rect(knob_x - 4.0, track_y - 0.5, 8.0, 8.0, 4.0, &theme.ink)
        canvas.text(atlas, decimal2(value), x + w - ui.Canvas::text_width(atlas, decimal2(value), 0.58), y + 1.0, 0.58, &theme.ink)
        changed
    }

    // A row in a list: highlighted when it is the current selection, true on
    // the frame it is pressed.
    pub fn row(&mut self, canvas: &mut ui.Canvas, atlas: &text.Atlas, id: i32, p: &Pointer,
        x: f32, y: f32, w: f32, label: string, indent: i32, selected: bool, theme: &Theme) -> bool {
        hover := self.active() == 0 && hit(p, x, y, w, ROW_HEIGHT)
        clicked := self.pointer.press(.Some(id), hover && p.pressed)
        if selected || hover {
            canvas.rounded_rect(x, y, w, ROW_HEIGHT, 5.0, &if selected { theme.fill_active } else { theme.fill_hot })
        }
        // The label ends in an ellipsis at the row's edge: a name longer than
        // the row is cut, never drawn over the viewport beside the panel.
        text_x := x + 28.0 + f32(indent) * 14.0
        canvas.text(atlas, ui.fit(atlas, label, x + w - text_x - 4.0, 0.64), text_x, y + 5.0, 0.64, &if selected { theme.ink } else { theme.ink_dim })
        clicked
    }
}

// Two decimals without float formatting; negative values keep their sign.
pub fn decimal2(v: f32) -> string {
    negative := v < 0.0
    magnitude := if negative { f32(0.0) - v } else { v }
    scaled := i32(magnitude * 100.0 + 0.5)
    whole := scaled / 100
    frac := scaled - whole * 100
    digits := if frac < 10 { whole.str() + ".0" + frac.str() } else { whole.str() + "." + frac.str() }
    if negative { "-" + digits } else { digits }
}
