// Immediate-mode UI geometry for Storm.
//
// The canvas emits vertices in screen pixels: position, atlas uv and colour.
// Solid rectangles mark themselves with uv.x = -1 so the fragment shader can
// skip the texture lookup.

import gfx
import text
import std.text.grapheme as segmentation
import .layout

// Text is drawn at this many points when its scale is 1. The editor draws at
// scales between 0.8 and 1.2, so strokes are neither undersampled nor
// blurred. The atlas may be rasterized at any size: a Retina display packs
// it at twice RASTER_SIZE and the text is then twice as sharp, at the same
// size on screen, because the canvas asks the atlas (raster_size) instead of
// assuming.
pub const RASTER_SIZE: f32 = 22.0

// How many screen points one raster pixel of an atlas covers, when text is
// drawn at `scale`. Nothing to draw, nothing to scale.
fn points_per_pixel(atlas: &text.Atlas, scale: f32) -> f32 {
    raster := atlas.raster_size()
    if raster <= 0.0 { return 0.0 }
    scale * RASTER_SIZE / raster
}

pub struct Color {
    r: f32,
    g: f32,
    b: f32,
    a: f32,
}

pub fn rgba(r: f32, g: f32, b: f32, a: f32) -> Color {
    Color { r: r, g: g, b: b, a: a }
}

pub fn rgb(r: f32, g: f32, b: f32) -> Color {
    Color { r: r, g: g, b: b, a: 1.0 }
}

pub fn white(alpha: f32) -> Color { Color { r: 1.0, g: 1.0, b: 1.0, a: alpha } }

pub struct Canvas {
    vertices: []f32,
}

impl Canvas {
    pub fn new() -> Self {
        Self { vertices: [] }
    }

    pub fn clear(&mut self) {
        self.vertices.clear()
    }

    pub fn vertices(&self) -> &[]f32 { &self.vertices }

    // Move the geometry out so it can cross the module boundary as a value.
    pub fn take(&mut self) -> []f32 {
        replace(&mut self.vertices, [])
    }
    pub fn vertex_count(&self) -> i32 { self.vertices.len / gfx.UI_FLOATS }
    pub fn is_empty(&self) -> bool { self.vertices.len == 0 }

    // The contract's writer: a UI vertex is eight floats in the order
    // `gfx.push_ui_vertex` lays them out, and this canvas never counts them
    // itself.
    fn push_vertex(&mut self, x: f32, y: f32, u: f32, v: f32, color: &Color) {
        gfx.push_ui_vertex(&mut self.vertices, &gfx.UiVertex {
            x: x, y: y, u: u, v: v, r: color.r, g: color.g, b: color.b, a: color.a,
        })
    }

    fn quad(&mut self, x: f32, y: f32, w: f32, h: f32, u0: f32, v0: f32, u1: f32, v1: f32, color: &Color) {
        self.push_vertex(x, y, u0, v0, color)
        self.push_vertex(x + w, y, u1, v0, color)
        self.push_vertex(x + w, y + h, u1, v1, color)
        self.push_vertex(x, y, u0, v0, color)
        self.push_vertex(x + w, y + h, u1, v1, color)
        self.push_vertex(x, y + h, u0, v1, color)
    }

    // A textured quad: the whole atlas when the uv box is (0,0)-(1,1).
    pub fn image(&mut self, x: f32, y: f32, w: f32, h: f32, u0: f32, v0: f32, u1: f32, v1: f32, color: &Color) {
        self.quad(x, y, w, h, u0, v0, u1, v1, color)
    }

    pub fn rect(&mut self, x: f32, y: f32, w: f32, h: f32, color: &Color) {
        self.quad(x, y, w, h, -1.0, -1.0, -1.0, -1.0, color)
    }

    pub fn triangle(&mut self, ax: f32, ay: f32, bx: f32, by: f32, cx: f32, cy: f32, color: &Color) {
        self.push_vertex(ax, ay, -1.0, -1.0, color)
        self.push_vertex(bx, by, -1.0, -1.0, color)
        self.push_vertex(cx, cy, -1.0, -1.0, color)
    }

    pub fn rounded_rect(&mut self, x: f32, y: f32, w: f32, h: f32, radius: f32, color: &Color) {
        if w <= 0.0 || h <= 0.0 { return }
        mut r := radius
        if r > w * 0.5 { r = w * 0.5 }
        if r > h * 0.5 { r = h * 0.5 }
        if r <= 0.0 { self.rect(x, y, w, h, color); return }
        self.rect(x + r, y, w - 2.0 * r, h, color)
        self.rect(x, y + r, r, h - 2.0 * r, color)
        self.rect(x + w - r, y + r, r, h - 2.0 * r, color)
        arc: [f32; 5] = [0.0, 0.382683, 0.707107, 0.923880, 1.0]
        for corner in 0..4 {
            left := corner == 0 || corner == 3
            top := corner < 2
            cx := if left { x + r } else { x + w - r }
            cy := if top { y + r } else { y + h - r }
            dx := if left { -r } else { r }
            dy := if top { -r } else { r }
            for j in 0..4 {
                self.triangle(cx, cy, cx + dx * arc[j], cy + dy * arc[4-j],
                    cx + dx * arc[j+1], cy + dy * arc[3-j], color)
            }
        }
    }

    // A filled panel with a one-pixel lighter border.
    pub fn panel(&mut self, x: f32, y: f32, w: f32, h: f32, fill: &Color, border: &Color) {
        self.rect(x, y, w, h, border)
        self.rect(x + 1.0, y + 1.0, w - 2.0, h - 2.0, fill)
    }

    // Draw a string with its top-left corner at (x, y), in points. `scale`
    // 1.0 draws it RASTER_SIZE points tall on screen, whatever pixel size
    // the atlas was rasterized at.
    pub fn text(&mut self, atlas: &text.Atlas, value: string, x: f32, y: f32, scale: f32, color: &Color) {
        per_pixel := points_per_pixel(atlas, scale)
        if per_pixel <= 0.0 { return }
        // The atlas lays out in its own raster pixels.
        quads := atlas.layout(value, atlas.raster_size(), 0.0, 0.0)
        for quad in quads {
            qx := x + quad.x * per_pixel
            qy := y + quad.y * per_pixel
            self.quad(qx, qy, quad.width * per_pixel, quad.height * per_pixel,
                quad.u0, quad.v0, quad.u1, quad.v1, color)
        }
    }

    // Clip text to its layout box while preserving texel coordinates along
    // the trimmed edges of each glyph.
    pub fn text_in(&mut self, atlas: &text.Atlas, value: string, x: f32, y: f32, scale: f32, color: &Color, clip: &layout.Rect) {
        per_pixel := points_per_pixel(atlas, scale)
        if per_pixel <= 0.0 { return }
        for glyph in atlas.layout(value, atlas.raster_size(), 0.0, 0.0) {
            x0 := x + glyph.x * per_pixel
            y0 := y + glyph.y * per_pixel
            w := glyph.width * per_pixel
            h := glyph.height * per_pixel
            left := if x0 < clip.x { clip.x } else { x0 }
            top := if y0 < clip.y { clip.y } else { y0 }
            right := if x0 + w > clip.x + clip.w { clip.x + clip.w } else { x0 + w }
            bottom := if y0 + h > clip.y + clip.h { clip.y + clip.h } else { y0 + h }
            if left >= right || top >= bottom { continue }
            du := (glyph.u1 - glyph.u0) / w
            dv := (glyph.v1 - glyph.v0) / h
            self.quad(left, top, right - left, bottom - top, glyph.u0 + (left - x0) * du, glyph.v0 + (top - y0) * dv,
                glyph.u0 + (right - x0) * du, glyph.v0 + (bottom - y0) * dv, color)
        }
    }

    // Width of a laid-out string in points, at the same `scale` as `text`.
    pub fn text_width(atlas: &text.Atlas, value: string, scale: f32) -> f32 {
        atlas.measure(value) * points_per_pixel(atlas, scale)
    }
}

// The mark a fitted string ends in when it had to be cut (U+2026).
const ELLIPSIS: string = "…"

// `value` if it is at most `max_width` points wide at `scale`; otherwise the
// longest leading run of whole graphemes that, with an ellipsis in place of
// the rest, still is. Never wider than asked, never cut inside a grapheme,
// and "" when even the ellipsis does not fit — so a caller that knows the
// width of its panel can hand any name to `text` and nothing spills into
// the viewport. Widths add over graphemes exactly as `Atlas::measure` sums
// glyph advances, so the cut is found in one pass.
pub fn fit(atlas: &text.Atlas, value: string, max_width: f32, scale: f32) -> string {
    if Canvas::text_width(atlas, value, scale) <= max_width { return value.clone() }
    tail := Canvas::text_width(atlas, ELLIPSIS, scale)
    mut used: f32 = 0.0
    mut end := 0
    while end < value.len {
        next := segmentation.next_boundary(value.as_str(), end)
        w := Canvas::text_width(atlas, value[end..next].clone(), scale)
        if used + w + tail > max_width { break }
        used = used + w
        end = next
    }
    // Nothing fits, not even the ellipsis alone: the empty string is the
    // only string that honours the width.
    if tail > max_width { return "" }
    value[0..end].clone() + ELLIPSIS
}
