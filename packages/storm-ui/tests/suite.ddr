import ..src.ui as ui
import ..src.widgets as widgets
import text
import std.text as stdtext
import std.text.grapheme as segmentation
import gfx

@test fn solid_rect_emits_two_triangles() {
    mut canvas := ui.Canvas::new()
    canvas.rect(10.0, 20.0, 100.0, 40.0, &ui.rgb(1.0, 0.0, 0.0))
    assert(canvas.vertex_count() == 6)
    vertices := canvas.vertices()
    assert(vertices[0] == 10.0)
    assert(vertices[1] == 20.0)
    assert(vertices[2] == -1.0)
    assert(vertices[4] == 1.0)
}

@test fn panel_draws_border_and_fill() {
    mut canvas := ui.Canvas::new()
    canvas.panel(0.0, 0.0, 200.0, 100.0, &ui.rgb(0.1, 0.1, 0.1), &ui.rgb(0.2, 0.2, 0.2))
    assert(canvas.vertex_count() == 12)
    vertices := canvas.vertices()
    // The fill starts one pixel in, after the border's two triangles.
    assert(vertices[48] == 1.0)
}

@test fn clear_resets_the_canvas() {
    mut canvas := ui.Canvas::new()
    canvas.rect(0.0, 0.0, 10.0, 10.0, &ui.white(1.0))
    assert(!canvas.is_empty())
    canvas.clear()
    assert(canvas.is_empty())
}

// --- widgets: buttons, sliders and rows from a Pointer, no window ---

// The platform's own monospace font: a path typed here would load on one
// machine and leave these tests with no glyphs, passing, anywhere else.
fn widget_atlas() -> text.Atlas {
    face := text.load_font(22.0)
    assert(face.ok)
    mut atlas := text.Atlas::new(256, 256)
    assert(atlas.add_text(&face, "+ cube metallic roughness xyz.0123456789-…"))
    assert(atlas.glyph_count() > 20)
    atlas
}

// A Retina display packs the atlas at twice the size. The same text must
// then land at the same place and the same size on screen, drawn from
// twice as many pixels: the canvas asks the atlas how big its glyphs are
// instead of assuming one raster size.
@test fn an_atlas_rasterized_at_twice_the_size_draws_the_same_text() {
    small := text.load_font(ui.RASTER_SIZE)
    large := text.load_font(ui.RASTER_SIZE * 2.0)
    assert(small.ok && large.ok)
    mut a := text.Atlas::new(512, 512)
    mut b := text.Atlas::new(512, 512)
    assert(a.add_text(&small, "Storm 0.42") && b.add_text(&large, "Storm 0.42"))
    assert(a.raster_size() == ui.RASTER_SIZE && b.raster_size() == ui.RASTER_SIZE * 2.0)
    // Advances and bearings scale exactly with the raster size, so the string
    // is as wide on screen from either atlas.
    narrow := ui.Canvas::text_width(&a, "Storm 0.42", 1.0)
    wide := ui.Canvas::text_width(&b, "Storm 0.42", 1.0)
    assert(narrow > 60.0)
    assert((narrow - wide).abs() < 0.01)
    mut canvas_a := ui.Canvas::new()
    mut canvas_b := ui.Canvas::new()
    ink := ui.white(1.0)
    canvas_a.text(&a, "Storm 0.42", 10.0, 20.0, 1.0, &ink)
    canvas_b.text(&b, "Storm 0.42", 10.0, 20.0, 1.0, &ink)
    assert(canvas_a.vertex_count() > 0 && canvas_a.vertex_count() == canvas_b.vertex_count())
    va := canvas_a.vertices()
    vb := canvas_b.vertices()
    // Each quad is six vertices of gfx.UI_FLOATS floats (x, y, u, v, r, g, b, a); the
    // first and last vertex sit on its left edge, the other four on its right.
    for v in 0..va.len / gfx.UI_FLOATS {
        corner := v % 6
        x_a := va[v * gfx.UI_FLOATS]
        y_a := va[v * gfx.UI_FLOATS + 1]
        x_b := vb[v * gfx.UI_FLOATS]
        y_b := vb[v * gfx.UI_FLOATS + 1]
        if corner == 0 || corner == 5 {
            // Where a glyph begins is pen + bearing: exact in both atlases.
            assert((x_a - x_b).abs() < 0.01)
        } else {
            // Its bitmap's extent is rounded to whole pixels at whichever size
            // it was rasterized, with an anti-aliased margin that does not
            // scale (measured: an r is a 12 px bitmap at 22 and 20 px at 44),
            // so the far edge may differ by a point or two of margin.
            assert((x_a - x_b).abs() < 2.5)
        }
        // Top and bottom likewise sit on whole raster pixels.
        assert((y_a - y_b).abs() < 1.5)
        for field in 4..8 { assert(va[v * gfx.UI_FLOATS + field] == vb[v * gfx.UI_FLOATS + field]) }
    }
    // An atlas with nothing in it has no raster size and draws nothing.
    mut empty := text.Atlas::new(16, 16)
    assert(empty.raster_size() == 0.0)
    assert(ui.Canvas::text_width(&empty, "Storm", 1.0) == 0.0)
}

fn pointer(x: f32, y: f32, down: bool, pressed: bool) -> widgets.Pointer {
    widgets.Pointer { x: x, y: y, down: down, pressed: pressed }
}

@test fn hit_is_half_open() {
    p := pointer(10.0, 20.0, false, false)
    assert(widgets.hit(&p, 10.0, 20.0, 50.0, 50.0))
    p_edge := pointer(60.0, 70.0, false, false)
    assert(!widgets.hit(&p_edge, 10.0, 20.0, 50.0, 50.0))
}

@test fn button_fires_once_on_press_not_on_hold() {
    atlas := widget_atlas()
    mut state := widgets.State::new()
    mut canvas := ui.Canvas::new()
    theme := widgets.theme()
    state.begin()
    assert(!state.button(&mut canvas, &atlas, 1, &pointer(50.0, 100.0, true, false), 10.0, 90.0, 120.0, 30.0, "+ cube", &theme))
    state.begin()
    assert(state.button(&mut canvas, &atlas, 1, &pointer(50.0, 100.0, true, true), 10.0, 90.0, 120.0, 30.0, "+ cube", &theme))
    assert(state.active() == 1)
    state.begin()
    assert(!state.button(&mut canvas, &atlas, 1, &pointer(50.0, 100.0, true, false), 10.0, 90.0, 120.0, 30.0, "+ cube", &theme))
    state.end(&pointer(50.0, 100.0, false, false))
    assert(state.active() == 0)
    // A press elsewhere does not fire the button.
    state.begin()
    assert(!state.button(&mut canvas, &atlas, 1, &pointer(500.0, 100.0, true, true), 10.0, 90.0, 120.0, 30.0, "+ cube", &theme))
}

@test fn slider_tracks_the_drag_and_clamps() {
    atlas := widget_atlas()
    mut state := widgets.State::new()
    mut canvas := ui.Canvas::new()
    theme := widgets.theme()
    mut value: f32 = 0.5
    // Track starts at x + 92 and is 240 - 92 - 52 = 96 wide.
    state.begin()
    state.end(&pointer(0.0, 0.0, false, false))
    state.begin()
    // Pressing on the track jumps the knob there: (140 - 132) / 96 = 0.083.
    assert(state.slider(&mut canvas, &atlas, 7, &pointer(140.0, 150.0, true, true), 40.0, 140.0, 240.0, "metallic", &mut value, 0.0, 1.0, &theme))
    assert(value > 0.07 && value < 0.10)
    assert(state.active() == 7)
    // Dragging past the left end clamps to the minimum, past the right to the max.
    state.begin()
    assert(state.slider(&mut canvas, &atlas, 7, &pointer(0.0, 150.0, true, false), 40.0, 140.0, 240.0, "metallic", &mut value, 0.0, 1.0, &theme))
    assert(value == 0.0)
    state.begin()
    assert(state.slider(&mut canvas, &atlas, 7, &pointer(900.0, 150.0, true, false), 40.0, 140.0, 240.0, "metallic", &mut value, 0.0, 1.0, &theme))
    assert(value == 1.0)
    state.begin()
    _ := state.slider(&mut canvas, &atlas, 7, &pointer(180.0, 150.0, true, false), 40.0, 140.0, 240.0, "metallic", &mut value, 0.0, 1.0, &theme)
    assert(value > 0.45 && value < 0.55)
    state.end(&pointer(180.0, 150.0, false, false))
    assert(state.active() == 0)
}

@test fn row_selects_and_decimal2_keeps_signs() {
    atlas := widget_atlas()
    mut state := widgets.State::new()
    mut canvas := ui.Canvas::new()
    theme := widgets.theme()
    state.begin()
    assert(state.row(&mut canvas, &atlas, 3, &pointer(30.0, 210.0, true, true), 10.0, 200.0, 300.0, "Gold cube", 2, false, &theme))
    assert(widgets.decimal2(0.5) == "0.50")
    assert(widgets.decimal2(1.0) == "1.00")
    assert(widgets.decimal2(-2.345) == "-2.35")
    assert(widgets.decimal2(12.0) == "12.00")
}

// --- rounded_rect: three strips and four quarter-circles ---

// Every vertex a rounded rect emits lies on or inside its box: that is
// what makes the shape a rounded version of the rect and not a blob that
// spills over the layout. Returns the farthest a vertex lies outside.
fn rounded_spill(canvas: &ui.Canvas, x: f32, y: f32, w: f32, h: f32) -> f32 {
    vertices := canvas.vertices()
    mut worst: f32 = 0.0
    for i in 0..canvas.vertex_count() {
        px := vertices[i * gfx.UI_FLOATS]
        py := vertices[i * gfx.UI_FLOATS + 1]
        if x - px > worst { worst = x - px }
        if px - (x + w) > worst { worst = px - (x + w) }
        if y - py > worst { worst = y - py }
        if py - (y + h) > worst { worst = py - (y + h) }
    }
    worst
}

fn has_vertex(canvas: &ui.Canvas, x: f32, y: f32) -> bool {
    vertices := canvas.vertices()
    mut found := false
    for i in 0..canvas.vertex_count() {
        if vertices[i * gfx.UI_FLOATS] == x && vertices[i * gfx.UI_FLOATS + 1] == y { found = true }
    }
    found
}

@test fn rounded_rect_is_three_strips_and_four_quarter_circles() {
    mut canvas := ui.Canvas::new()
    canvas.rounded_rect(0.0, 0.0, 100.0, 40.0, 8.0, &ui.white(1.0))
    // 3 rects x 6 vertices + 4 corners x 4 triangles x 3 vertices.
    assert(canvas.vertex_count() == 66)
    // Nothing outside the box ...
    assert(rounded_spill(&canvas, 0.0, 0.0, 100.0, 40.0) < 0.001)
    // ... and the sharp corners are exactly what is missing: the left
    // edge starts at y + r, the top edge at x + r.
    assert(!has_vertex(&canvas, 0.0, 0.0))
    assert(has_vertex(&canvas, 0.0, 8.0))
    assert(has_vertex(&canvas, 8.0, 0.0))
    assert(has_vertex(&canvas, 92.0, 40.0))
    assert(has_vertex(&canvas, 100.0, 32.0))
    // Each corner fan: every vertex of a triangle but the centre is r from
    // that corner's centre, so the arc is a circle and not an ellipse.
    vertices := canvas.vertices()
    for i in 18..66 {
        cx: f32 = if vertices[i * gfx.UI_FLOATS] < 50.0 { 8.0 } else { 92.0 }
        cy: f32 = if vertices[i * gfx.UI_FLOATS + 1] < 20.0 { 8.0 } else { 32.0 }
        dx := vertices[i * gfx.UI_FLOATS] - cx
        dy := vertices[i * gfx.UI_FLOATS + 1] - cy
        d := (dx * dx + dy * dy).sqrt()
        assert(d < 0.001 || (d - 8.0).abs() < 0.001)
    }
    // The arc's first outer point is the top of the circle, its last the
    // left: the quarter is covered end to end.
    // The first corner's first triangle is (centre, top of circle, next on
    // the arc); its last triangle ends on the left of the circle.
    assert(vertices[18 * gfx.UI_FLOATS] == 8.0 && vertices[18 * gfx.UI_FLOATS + 1] == 8.0)
    assert(vertices[19 * gfx.UI_FLOATS] == 8.0 && vertices[19 * gfx.UI_FLOATS + 1] == 0.0)
    assert(vertices[29 * gfx.UI_FLOATS] == 0.0 && vertices[29 * gfx.UI_FLOATS + 1] == 8.0)
}

@test fn rounded_rect_clamps_its_radius_and_falls_back_to_a_rect() {
    mut canvas := ui.Canvas::new()
    // A radius larger than half the short side is half the short side.
    canvas.rounded_rect(0.0, 0.0, 20.0, 10.0, 50.0, &ui.white(1.0))
    assert(canvas.vertex_count() == 66)
    assert(has_vertex(&canvas, 0.0, 5.0) && has_vertex(&canvas, 5.0, 0.0))
    // Radius zero is a plain rect; an empty box is nothing at all.
    canvas.clear()
    canvas.rounded_rect(0.0, 0.0, 20.0, 10.0, 0.0, &ui.white(1.0))
    assert(canvas.vertex_count() == 6)
    canvas.clear()
    canvas.rounded_rect(0.0, 0.0, 0.0, 10.0, 4.0, &ui.white(1.0))
    canvas.rounded_rect(0.0, 0.0, 20.0, -1.0, 4.0, &ui.white(1.0))
    assert(canvas.is_empty())
}

// A slider whose range is empty (min == max) has nothing to interpolate:
// the knob sits at the start of the track rather than at a NaN, which a
// division by the zero span would produce and that the shader would draw
// nowhere at all.
@test fn slider_with_an_empty_range_keeps_the_knob_on_the_track() {
    atlas := widget_atlas()
    mut state := widgets.State::new()
    mut canvas := ui.Canvas::new()
    theme := widgets.theme()
    mut value: f32 = 3.0
    state.begin()
    state.end(&pointer(0.0, 0.0, false, false))
    state.begin()
    _ := state.slider(&mut canvas, &atlas, 3, &pointer(0.0, 0.0, false, false), 40.0, 140.0, 240.0, "x", &mut value, 3.0, 3.0, &theme)
    vertices := canvas.vertices()
    // Track and knob are the untextured vertices (u == -1); the text is the
    // atlas's business. With t = 0 the knob sits at the start of the track.
    mut shapes := 0
    mut left: f32 = 10000.0
    mut right: f32 = -1.0
    for i in 0..canvas.vertex_count() {
        assert(vertices[i * gfx.UI_FLOATS] == vertices[i * gfx.UI_FLOATS])
        if vertices[i * gfx.UI_FLOATS + 2] == -1.0 {
            shapes += 1
            if vertices[i * gfx.UI_FLOATS] < left { left = vertices[i * gfx.UI_FLOATS] }
            if vertices[i * gfx.UI_FLOATS] > right { right = vertices[i * gfx.UI_FLOATS] }
        }
    }
    // Track (3 strips + 4 corners = 66) + knob (66); the fill is zero wide.
    assert(shapes == 132)
    // Track starts at x + 92; the knob is centred on that start, 4 either side.
    // Track starts at x + 92 = 132 and is 96 wide (ends 228); the knob is
    // centred on that start, 4 either side (128).
    assert(left == 128.0 && right == 228.0)
    // Dragging in an empty range leaves the value alone and reports no change.
    state.begin()
    changed := state.slider(&mut canvas, &atlas, 3, &pointer(200.0, 150.0, true, true), 40.0, 140.0, 240.0, "x", &mut value, 3.0, 3.0, &theme)
    assert(!changed)
    assert(value == 3.0)
}

// --- fit: a string that must fit a width ends in an ellipsis, never spills ---

@test fn fit_keeps_a_string_that_fits_and_shortens_one_that_does_not() {
    face := text.load_font(ui.RASTER_SIZE)
    assert(face.ok)
    mut atlas := text.Atlas::new(512, 512)
    assert(atlas.add_text(&face, "/home/mikpe/Work/Katla/resources/models/Lantern.glb…"))
    assert(atlas.find(0x2026) >= 0)
    whole := "/home/mikpe/Work/Katla/resources/models/Lantern.glb"
    full := ui.Canvas::text_width(&atlas, whole, 1.0)
    assert(full > 300.0)
    // Fits: the very same string, not a copy with an ellipsis glued on.
    assert(ui.fit(&atlas, whole, full + 1.0, 1.0) == whole)
    assert(ui.fit(&atlas, whole, full, 1.0) == whole)
    // Does not fit: shorter, ends in the ellipsis, and no wider than asked.
    fitted := ui.fit(&atlas, whole, 180.0, 1.0)
    assert(fitted.len < whole.len)
    assert(stdtext.ends_with(fitted, "…"))
    assert(ui.Canvas::text_width(&atlas, fitted, 1.0) <= 180.0)
    // The longest that fits: the grapheme after the cut, whichever it is,
    // would not have — and the cut is a prefix of the original, byte for byte.
    bare := fitted[0..fitted.len - 3].clone()
    cut := bare.len
    assert(whole[0..cut] == bare)
    next_end := segmentation.next_boundary(whole.as_str(), cut)
    wider := bare + whole[cut..next_end].clone() + "…"
    assert(ui.Canvas::text_width(&atlas, wider, 1.0) > 180.0)
    // A width that cannot hold even the ellipsis holds nothing — still never wider.
    assert(ui.Canvas::text_width(&atlas, ui.fit(&atlas, whole, 1.0, 1.0), 1.0) <= 1.0)
}

@test fn fit_cuts_on_grapheme_boundaries() {
    face := text.load_font(ui.RASTER_SIZE)
    assert(face.ok)
    mut atlas := text.Atlas::new(512, 512)
    // "e" followed by a combining acute is one grapheme over two runes.
    assert(atlas.add_text(&face, "e\u0301…"))
    assert(atlas.find(0x301) >= 0)
    e := ui.Canvas::text_width(&atlas, "e", 1.0)
    mark := ui.Canvas::text_width(&atlas, "\u0301", 1.0)
    tail := ui.Canvas::text_width(&atlas, "…", 1.0)
    // Room for "e" and the ellipsis but not for the whole "é" cluster.
    fitted := ui.fit(&atlas, "e\u0301e\u0301e\u0301", e + tail + mark * 0.5, 1.0)
    // Either the whole first cluster fitted or none of it; never a bare "e"
    // whose accent was dropped, and never a bare combining mark.
    assert(fitted == "e\u0301…" || fitted == "…")
    // With room for the cluster and nothing more, the cluster comes whole.
    room := e + mark + tail + 0.5
    assert(ui.fit(&atlas, "e\u0301e\u0301e\u0301", room, 1.0) == "e\u0301…")
}

