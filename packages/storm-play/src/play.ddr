// Authored scenes and fixed-tick game sessions are shared by the editor and agent tools.
capability filesystem

import .codec
import core
import physics
import std.fs as fs
import std.json as json
import std.math as math
import sys

pub const MAX_ENTITIES: i32 = 128
pub const TICK_RATE: i32 = 60
pub const TICK_SECONDS: f64 = 1.0 / 60.0
const MAX_CATCHUP: i32 = 8

pub enum Shape { Box, Sphere }
pub enum Role { Prop, Player, Goal, Flower, Collider }
pub enum Theme { Plain, Blossom }
pub struct Bounds { min_x: f32, min_z: f32, max_x: f32, max_z: f32 }
struct Sensor { entity_index: i32, body: physics.Body }

pub struct Entity {
    name: string, shape: Shape, role: Role, position: core.Vec3, size: core.Vec3,
    velocity: core.Vec3, mass: f32, restitution: f32, friction: f32, color: core.Vec3,
}

pub struct Scene { name: string, gravity: core.Vec3, theme: Theme, bounds: Option<Bounds>, entities: []Entity }
pub struct Input { x: f32, z: f32, jump: bool }
pub struct Session {
    scene: Scene, tick: i64, won: bool, contacts: i32, player: i32,
    bodies: []physics.Body, body_indices: []i32, sensors: []Sensor,
    collected: []bool, flowers: i32, total_flowers: i32, last_flower: i32, picked_tick: i64,
    heading: f32, walk_phase: f32, walking: bool,
    previous: []core.Vec3, accumulator: f64, jump_pending: bool,
}

pub fn validate_name(name: string) -> Result<(), string> { codec.validate_name(name) }

pub fn empty(name: string) -> Scene {
    Scene { name: name.clone(), gravity: core.vec3(0.0, -9.81, 0.0), theme: .Plain, bounds: .None, entities: [] }
}

fn entity(name: string, shape: Shape, role: Role, p: core.Vec3, size: core.Vec3, mass: f32, color: core.Vec3) -> Entity {
    Entity { name: name.clone(), shape: shape, role: role, position: p, size: size, mass: mass,
        velocity: core.vec3(0.0, 0.0, 0.0), restitution: 0.0, friction: 0.6, color: color }
}

pub fn demo() -> Scene {
    mut scene := empty("Blomsterskogen")
    scene.theme = .Blossom
    scene.bounds = .Some(Bounds { min_x: -5.0, min_z: -3.5, max_x: 5.0, max_z: 3.3 })
    scene.entities.push(entity("Ängen", .Box, .Prop, core.vec3(0.0, -0.5, 0.0), core.vec3(30.0, 1.0, 26.0),
        0.0, core.vec3(0.39, 0.65, 0.30)))
    scene.entities.push(entity("Vallmo", .Sphere, .Player, core.vec3(0.0, 0.4, 1.0), core.vec3(0.8, 0.8, 0.8),
        1.0, core.vec3(0.95, 0.31, 0.075)))
    names := ["Smörblomma", "Blåklocka", "Prästkrage", "Skogsviol", "Gullviva"]
    positions := [core.vec3(-2.0, 0.45, 1.1), core.vec3(2.0, 0.45, 0.1),
        core.vec3(-2.8, 0.45, -1.75), core.vec3(-1.05, 0.45, -2.45), core.vec3(3.4, 0.45, -2.0)]
    colors := [core.vec3(0.98, 0.69, 0.15), core.vec3(0.36, 0.41, 0.91), core.vec3(0.98, 0.93, 0.82),
        core.vec3(0.69, 0.37, 0.83), core.vec3(0.99, 0.57, 0.20)]
    for i in 0..names.len {
        scene.entities.push(entity(names[i], .Sphere, .Flower, positions[i], core.vec3(0.64, 0.64, 0.64), 0.0, colors[i]))
    }
    trunks := [core.vec3(-4.14, 1.3, -1.61), core.vec3(4.35, 1.3, -2.05),
        core.vec3(-5.46, 1.3, 1.86), core.vec3(5.74, 1.3, 1.18)]
    for i in 0..trunks.len {
        scene.entities.push(entity("Stam " + (i + 1).str(), .Box, .Collider, trunks[i], core.vec3(0.56, 2.6, 0.56),
            0.0, core.vec3(0.0, 0.0, 0.0)))
    }
    scene
}

fn role_name(role: Role) -> string {
    match role { .Player => "player", .Goal => "goal", .Flower => "flower", .Collider => "collider", .Prop => "prop" }
}

fn read_role(value: string) -> Result<Role, string> {
    match value {
        "prop" => .Ok(.Prop), "player" => .Ok(.Player), "goal" => .Ok(.Goal), "flower" => .Ok(.Flower),
        "collider" => .Ok(.Collider), _ => .Err("role must be prop, player, goal, flower or collider"),
    }
}

fn read_entity(doc: &json.Doc, node: i32) -> Result<Entity, string> {
    codec.fields(doc, node, ["name", "shape", "role", "position", "size", "velocity", "mass", "restitution", "friction", "color"])?
    name := codec.name(doc, node)?
    shape_name := doc.get_str(node, "shape").unwrap_or_default()
    shape := if shape_name == "sphere" { Shape.Sphere } else { Shape.Box }
    if shape_name != "box" && shape_name != "sphere" { return .Err("shape must be box or sphere") }
    role_name := if doc.field(node, "role") < 0 { "prop" } else { doc.get_str(node, "role").unwrap_or_default() }
    role := read_role(role_name)?
    zero := core.vec3(0.0, 0.0, 0.0)
    pos := codec.vector(doc, node, "position", zero)?
    size := codec.vector(doc, node, "size", core.vec3(1.0, 1.0, 1.0))?
    velocity := codec.vector(doc, node, "velocity", zero)?
    color := codec.vector(doc, node, "color", core.vec3(0.55, 0.62, 0.70))?
    mass := codec.scalar(doc, node, "mass", 0.0)?
    friction := codec.scalar(doc, node, "friction", 0.6)?
    restitution := codec.scalar(doc, node, "restitution", 0.0)?
    if size.x < 0.001 || size.y < 0.001 || size.z < 0.001 { return .Err("size components must be at least 0.001") }
    if shape == .Sphere && (size.x != size.y || size.x != size.z) { return .Err("sphere diameters must match") }
    if mass < 0.0 || (mass > 0.0 && mass < 0.001) { return .Err("mass must be zero or at least 0.001") }
    if mass == 0.0 && (velocity.x != 0.0 || velocity.y != 0.0 || velocity.z != 0.0) { return .Err("a static entity cannot have initial velocity") }
    if role == .Collider && mass != 0.0 { return .Err("a collider must have zero mass") }
    if role == .Player && mass == 0.0 { return .Err("a player requires positive mass") }
    if (role == .Goal || role == .Flower) && mass != 0.0 { return .Err("a sensor must have zero mass") }
    if color.x < 0.0 || color.y < 0.0 || color.z < 0.0 || color.x > 1.0 || color.y > 1.0 || color.z > 1.0 { return .Err("color components must be in [0,1]") }
    if friction < 0.0 || friction > 1.0 || restitution < 0.0 || restitution > 1.0 { return .Err("friction and restitution must be in [0,1]") }
    .Ok(Entity { name: name, shape: shape, role: role, position: pos, size: size,
        velocity: velocity, mass: mass, friction: friction, restitution: restitution, color: color })
}

fn place(scene: &mut Scene, move value: Entity, replace: bool) -> Result<(), string> {
    mut index := -1
    for i in 0..scene.entities.len {
        if scene.entities[i].name == value.name { index = i }
        else if value.role == .Player && scene.entities[i].role == .Player { return .Err("a scene can have only one player") }
    }
    if index >= 0 {
        if !replace { return .Err("duplicate entity name '" + value.name + "'") }
        scene.entities[index] = value
    } else {
        if scene.entities.len >= MAX_ENTITIES { return .Err("a scene supports at most " + MAX_ENTITIES.str() + " entities") }
        scene.entities.push(move value)
    }
    .Ok
}

pub fn upsert(scene: &mut Scene, source: string) -> Result<(), string> {
    doc := json.Doc::parse_text(source)
    if !doc.ok { return .Err(doc.error.clone()) }
    value := read_entity(&doc, doc.root)?
    place(&mut scene, move value, true)
}

pub fn remove(scene: &mut Scene, name: string) -> Result<(), string> {
    for i in 0..scene.entities.len {
        if scene.entities[i].name == name {
            for j in i + 1..scene.entities.len { scene.entities.swap(j - 1, j) }
            _ := scene.entities.pop()
            return .Ok
        }
    }
    .Err("unknown entity '" + name + "'")
}

fn read_bounds(doc: &json.Doc, root: i32) -> Result<Option<Bounds>, string> {
    node := doc.field(root, "bounds")
    if node < 0 { return .Ok(.None) }
    if doc.kind(node) != .Array || doc.count(node) != 4 { return .Err("bounds must be [minX,minZ,maxX,maxZ]") }
    bounds := Bounds {
        min_x: codec.number(doc, doc.at(node, 0), "bounds")?, min_z: codec.number(doc, doc.at(node, 1), "bounds")?,
        max_x: codec.number(doc, doc.at(node, 2), "bounds")?, max_z: codec.number(doc, doc.at(node, 3), "bounds")?,
    }
    if bounds.min_x >= bounds.max_x || bounds.min_z >= bounds.max_z { return .Err("bounds must enclose a positive area") }
    .Ok(.Some(bounds))
}

pub fn decode(source: string) -> Result<Scene, string> {
    doc := json.Doc::parse_text(source)
    if !doc.ok { return .Err(doc.error.clone()) }
    root := doc.root
    codec.fields(&doc, root, ["version", "name", "gravity", "theme", "bounds", "entities"])?
    if doc.get_i64(root, "version").unwrap_or(0) != 1 { return .Err("expected scene version 1") }
    name := codec.name(&doc, root)?
    mut scene := empty(name)
    scene.gravity = codec.vector(&doc, root, "gravity", scene.gravity)?
    if doc.field(root, "theme") >= 0 {
        scene.theme = match doc.get_str(root, "theme").unwrap_or_default() {
            "blossom" => Theme.Blossom, "plain" => Theme.Plain, _ => { return .Err("theme must be plain or blossom") },
        }
    }
    scene.bounds = read_bounds(&doc, root)?
    items := doc.field(root, "entities")
    if doc.kind(items) != .Array { return .Err("entities must be an array") }
    if doc.count(items) > MAX_ENTITIES { return .Err("a scene supports at most " + MAX_ENTITIES.str() + " entities") }
    for i in 0..doc.count(items) {
        value := match read_entity(&doc, doc.at(items, i)) {
            .Ok(v) => v,
            .Err(err) => { return .Err("entities[" + i.str() + "]: " + err) },
        }
        place(&mut scene, move value, false)?
    }
    .Ok(scene)
}

pub fn read_source(path: string) -> Result<string, string> {
    source := sys.read_text_limit(path, 1048576)
    if !source.ok { return .Err("cannot read scene '" + path + "': " + sys.error_message(source.error)) }
    .Ok(source.value)
}

pub fn load(path: string) -> Result<Scene, string> { decode(read_source(path)?) }

fn write_entity(w: &mut json.Writer, item: &Entity) {
    w.object()
    w.key("name"); w.string(item.name)
    w.key("shape"); w.string(if item.shape == .Sphere { "sphere" } else { "box" })
    w.key("role"); w.string(role_name(item.role))
    codec.vector_field(&mut w, "position", item.position)
    codec.vector_field(&mut w, "size", item.size)
    codec.vector_field(&mut w, "velocity", item.velocity)
    w.key("mass"); w.decimal(f64(item.mass))
    w.key("friction"); w.decimal(f64(item.friction))
    w.key("restitution"); w.decimal(f64(item.restitution))
    codec.vector_field(&mut w, "color", item.color)
    w.end()
}

pub fn encode(scene: &Scene) -> string {
    mut w := json.Writer::new()
    w.object()
    w.key("version"); w.integer(1)
    w.key("name"); w.string(scene.name)
    w.key("theme"); w.string(if scene.theme == .Blossom { "blossom" } else { "plain" })
    match scene.bounds {
        .Some(b) => {
            w.key("bounds"); w.array()
            w.decimal(f64(b.min_x)); w.decimal(f64(b.min_z))
            w.decimal(f64(b.max_x)); w.decimal(f64(b.max_z)); w.end()
        },
        .None => {},
    }
    codec.vector_field(&mut w, "gravity", scene.gravity)
    w.key("entities"); w.array()
    for item in scene.entities { write_entity(&mut w, &item) }
    w.end()
    w.end()
    w.finish().unwrap_or_default()
}

pub fn save(scene: &Scene, path: string) -> Result<(), string> {
    source := encode(scene)
    match decode(source) { .Ok(_) => {}, .Err(err) => { return .Err(err) } }
    match fs.write_private_text_atomic(path, source + "\n") {
        .Ok => .Ok,
        .Err(err) => .Err("cannot save scene '" + path + "': " + err.message()),
    }
}

fn make_body(e: &Entity) -> physics.Body {
    mut body := if e.shape == .Sphere { physics.sphere(e.position, e.size.x * 0.5, e.mass) }
        else { physics.box_body(e.position, core.scale(e.size, 0.5), e.mass) }
    body.velocity = e.velocity
    body.friction = e.friction
    body.restitution = e.restitution
    body
}

pub fn start(scene: &Scene) -> Session {
    mut session := Session {
        scene: scene.clone(), tick: 0, won: false, contacts: 0, player: -1, previous: [],
        bodies: [], body_indices: [], sensors: [], accumulator: 0.0, jump_pending: false,
        collected: [], flowers: 0, total_flowers: 0, last_flower: -1, picked_tick: -1,
        heading: 0.35, walk_phase: 0.0, walking: false,
    }
    for i in 0..scene.entities.len {
        item := &scene.entities[i]
        body := make_body(item)
        session.previous.push(item.position)
        session.collected.push(false)
        if item.role == .Flower { session.total_flowers += 1 }
        if item.role == .Goal || item.role == .Flower {
            session.body_indices.push(-1)
            session.sensors.push(Sensor { entity_index: i, body: body })
        } else {
            if item.role == .Player { session.player = session.bodies.len }
            session.body_indices.push(session.bodies.len)
            session.bodies.push(body)
        }
    }
    session
}

pub fn position(s: &Session, index: i32) -> core.Vec3 {
    body := s.body_indices[index]
    if body < 0 { return s.scene.entities[index].position }
    s.bodies[body].position
}

pub fn render_position(s: &Session, index: i32) -> core.Vec3 {
    before := s.previous[index]
    core.add(before, core.scale(core.sub(position(s, index), before), f32(s.accumulator)))
}

fn axis(value: f32) -> f32 {
    if !value.is_finite() { return 0.0 }
    if value < -1.0 { return -1.0 }
    if value > 1.0 { return 1.0 }
    value
}

fn stay_in_bounds(body: &mut physics.Body, bounds: &Bounds) {
    if body.position.x < bounds.min_x { body.position.x = bounds.min_x; body.velocity.x = 0.0 }
    if body.position.x > bounds.max_x { body.position.x = bounds.max_x; body.velocity.x = 0.0 }
    if body.position.z < bounds.min_z { body.position.z = bounds.min_z; body.velocity.z = 0.0 }
    if body.position.z > bounds.max_z { body.position.z = bounds.max_z; body.velocity.z = 0.0 }
}

fn update_player(s: &mut Session, before: core.Vec3) {
    match s.scene.bounds { .Some(b) => { stay_in_bounds(&mut s.bodies[s.player], &b) }, .None => {} }
    player := &s.bodies[s.player]
    dx := player.position.x - before.x
    dz := player.position.z - before.z
    distance := (dx * dx + dz * dz).sqrt()
    s.walking = distance > 0.00001 && player.grounded
    if distance > 0.00001 { s.heading = f32(math.atan2(f64(dx), f64(dz))) }
    if s.walking {
        s.walk_phase += distance * 5.0
        if s.walk_phase >= 6.2831853 { s.walk_phase -= (s.walk_phase / 6.2831853).floor() * 6.2831853 }
    }
    if s.won { return }
    mut at_goal := false
    for i in 0..s.sensors.len {
        sensor := &s.sensors[i]
        index := sensor.entity_index
        if s.collected[index] || !physics.overlap(player, &sensor.body) { continue }
        if s.scene.entities[index].role == .Goal { at_goal = true }
        else {
            s.collected[index] = true
            s.flowers += 1
            s.last_flower = index
            s.picked_tick = s.tick
        }
    }
    has_goal := s.sensors.len > s.total_flowers
    s.won = s.flowers == s.total_flowers && (at_goal || (!has_goal && s.flowers > 0))
}

pub fn step(s: &mut Session, input: Input) {
    for i in 0..s.body_indices.len { s.previous[i] = position(&s, i) }
    mut before := core.vec3(0.0, 0.0, 0.0)
    if s.player >= 0 {
        before = s.bodies[s.player].position
        x := axis(input.x)
        z := axis(input.z)
        length := (x * x + z * z).sqrt()
        speed := if length > 1.0 { f32(4.5) / length } else { f32(4.5) }
        s.bodies[s.player].velocity.x = x * speed
        s.bodies[s.player].velocity.z = z * speed
        if (input.jump || s.jump_pending) && s.bodies[s.player].grounded {
            s.bodies[s.player].velocity.y = 5.6
        }
    }
    s.jump_pending = false
    s.contacts = physics.step(&mut s.bodies, s.scene.gravity, f32(TICK_SECONDS))
    s.tick += 1
    if s.player >= 0 { update_player(&mut s, before) }
}

// The accumulator is in ticks. Preserve sub-tick time and a jump edge until a tick consumes it.
pub fn advance(s: &mut Session, elapsed: f64, input: Input) -> i32 {
    if !elapsed.is_finite() || elapsed < 0.0 { return 0 }
    if input.jump { s.jump_pending = true }
    ticks := elapsed * f64(TICK_RATE)
    s.accumulator += if ticks > f64(MAX_CATCHUP) { f64(MAX_CATCHUP) } else { ticks }
    steps := i32(s.accumulator + 0.000000001)
    s.accumulator -= f64(steps)
    if s.accumulator < 0.0 { s.accumulator = 0.0 }
    for _ in 0..steps {
        step(&mut s, Input { x: input.x, z: input.z, jump: false })
    }
    steps
}

pub fn state_json(s: &Session) -> string {
    mut w := json.Writer::new()
    w.object()
    w.key("tick"); w.integer(s.tick)
    w.key("won"); w.boolean(s.won)
    w.key("contacts"); w.integer(i64(s.contacts))
    w.key("flowers"); w.integer(i64(s.flowers))
    w.key("total_flowers"); w.integer(i64(s.total_flowers))
    w.key("last_flower"); w.integer(i64(s.last_flower))
    w.key("picked_tick"); w.integer(s.picked_tick)
    w.key("heading"); w.decimal(f64(s.heading))
    w.key("walk_phase"); w.decimal(f64(s.walk_phase))
    w.key("walking"); w.boolean(s.walking)
    w.key("entities"); w.array()
    for i in 0..s.body_indices.len {
        body := s.body_indices[i]
        w.object()
        w.key("name"); w.string(s.scene.entities[i].name)
        w.key("collected"); w.boolean(s.collected[i])
        codec.vector_field(&mut w, "position", position(s, i))
        velocity := if body < 0 { core.vec3(0.0, 0.0, 0.0) } else { s.bodies[body].velocity }
        codec.vector_field(&mut w, "velocity", velocity)
        w.key("grounded"); w.boolean(body >= 0 && s.bodies[body].grounded)
        w.end()
    }
    w.end()
    w.end()
    w.finish().unwrap_or_default()
}
