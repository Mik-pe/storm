import core
import std.math as _

pub const LENGTH: f32 = 1.52
const CAPACITY: i32 = 64
const SPACING: f64 = f64(LENGTH) / 60.0

pub struct Point { position: core.Vec3, heading: f32, weight: f32, along: f64 }
pub struct Stop { position: core.Vec3, heading: f32, duration: f32, distance: f32, station: f64 }
pub opaque struct Trail {
    points: [Point; CAPACITY], next: i32, count: i32, previous: Point, tip: Point,
    previous_stop: Stop, stop: Stop, stops: []Stop,
}

pub fn near_angle(from: f32, to: f32) -> f32 {
    d := to - from
    tau: f32 = 6.2831853
    d - ((d + tau * 0.5) / tau).floor() * tau
}

fn between(a: Point, b: Point, t: f64) -> Point {
    Point { position: core.add(a.position, core.scale(core.sub(b.position, a.position), f32(t))),
        heading: a.heading + near_angle(a.heading, b.heading) * f32(t), weight: a.weight + (b.weight - a.weight) * f32(t),
        along: a.along + (b.along - a.along) * t }
}

pub fn start(position: core.Vec3, heading: f32, weight: f32) -> Trail {
    p := Point { position: position, heading: heading, weight: weight, along: 0.0 }
    rest := Stop { position: position, heading: heading, duration: 0.0, distance: 0.0, station: 0.0 }
    Trail { points: [p; CAPACITY], next: 1, count: 1, previous: p, tip: p, previous_stop: rest, stop: rest, stops: [] }
}

fn reset(trail: &mut Trail, p: Point) {
    trail.points[0] = p
    trail.stops.clear()
    trail.stop = Stop { position: p.position, heading: p.heading, duration: 0.0, distance: 0.0, station: p.along }
    trail.previous_stop = trail.stop
    trail.next = 1
    trail.count = 1
    trail.previous = p
    trail.tip = p
}

fn archive_stop(trail: &mut Trail) {
    mut oldest := 0
    while oldest < trail.stops.len && trail.tip.along - trail.stops[oldest].station > f64(LENGTH) { oldest += 1 }
    if oldest > 0 {
        live := trail.stops.len - oldest
        for i in 0..live { trail.stops[i] = trail.stops[i + oldest] }
        for _ in 0..oldest { _ := trail.stops.pop() }
    }
    stop := trail.stop
    if stop.duration == 0.0 || stop.distance >= LENGTH { return }
    // Keep the most settled footprint and the latest interruption in each distance cell.
    // Sub-millimetre taps cannot grow the history beyond two marks per cell.
    cell := (stop.station / SPACING).floor()
    last := trail.stops.len - 1
    if last < 0 || (trail.stops[last].station / SPACING).floor() != cell { trail.stops.push(stop); return }
    first := if last > 0 && (trail.stops[last-1].station / SPACING).floor() == cell { last - 1 } else { last }
    if stop.duration >= trail.stops[first].duration {
        trail.stops[first] = stop
        if first != last { _ := trail.stops.pop() }
    } else if first == last { trail.stops.push(stop) }
    else { trail.stops[last] = stop }
}

// Sample by distance so arbitrarily slow steps and long pauses keep the same
// planted foot. Only continuous travel on one support path contributes length.
pub fn record(trail: &mut Trail, before: core.Vec3, after: core.Vec3, heading: f32, weight: f32,
    was_grounded: bool, grounded: bool, dt: f32) {
    trail.previous_stop = trail.stop
    if was_grounded && core.length(core.sub(before, trail.tip.position)) > 0.001 {
        reset(&mut trail, Point { position: before, heading: heading, weight: 0.0, along: 0.0 })
    }
    trail.previous = trail.tip
    if !grounded { return }
    delta := core.sub(after, before)
    end := Point { position: after, heading: heading, weight: weight, along: 0.0 }
    if !was_grounded || core.length(delta) > 0.5 {
        reset(&mut trail, end)
        return
    }
    distance := f64((delta.x * delta.x + delta.z * delta.z).sqrt())
    if distance <= 0.00001 {
        if trail.stop.distance > 0.0 {
            archive_stop(&mut trail)
            trail.stop = Stop { position: after, heading: heading, duration: 0.0, distance: 0.0, station: trail.tip.along }
        } else { trail.stop.duration += dt }
    } else if trail.stop.distance <= LENGTH { trail.stop.distance += f32(distance) }
    if distance == 0.0 { return }
    trail.tip = end
    trail.tip.along = trail.previous.along + distance
    mut at := trail.points[(trail.next + CAPACITY - 1) % CAPACITY].along + SPACING
    while at <= trail.tip.along {
        mut p := between(trail.previous, trail.tip, (at - trail.previous.along) / distance)
        p.along = at
        trail.points[trail.next] = p
        trail.next = (trail.next + 1) % CAPACITY
        if trail.count < CAPACITY { trail.count += 1 }
        at += SPACING
    }
}

pub fn sample(trail: &Trail, fraction: f64, back: f32) -> Point {
    tip := between(trail.previous, trail.tip, fraction)
    mut newer := tip
    if !back.is_finite() || back <= 0.0 { newer.along = 0.0; return newer }
    target := tip.along - f64(back)
    for i in 0..trail.count {
        p := trail.points[(trail.next + CAPACITY - 1 - i) % CAPACITY]
        if p.along >= tip.along { continue }
        if p.along <= target {
            mut hit := between(p, newer, (target - p.along) / (newer.along - p.along))
            hit.along = f64(back)
            return hit
        }
        newer = p
    }
    newer.along = tip.along - newer.along
    newer
}

// Read halts newest first. A foot that stayed planted across a short tap keeps
// the position established by the previous halt until it takes its next step.
pub fn resting(trail: &Trail, exact: bool, fraction: f32, index: i32) -> Option<Stop> {
    if index < 0 { return .None }
    mut current := if exact { trail.stop } else { trail.previous_stop }
    if !exact && trail.stop.station == current.station && trail.stop.distance >= current.distance {
        current.duration += (trail.stop.duration - current.duration) * fraction
        current.distance += (trail.stop.distance - current.distance) * fraction
    }
    if index == 0 { return .Some(current) }
    mut slot := trail.stops.len - index
    if slot < 0 { return .None }
    if trail.stops[trail.stops.len - 1].station == current.station { slot -= 1 }
    if slot < 0 { return .None }
    mut saved := trail.stops[slot]
    saved.distance = f32(current.station - saved.station) + current.distance
    .Some(saved)
}
