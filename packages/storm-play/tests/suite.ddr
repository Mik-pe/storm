capability filesystem

import ..src.play as play
import core
import std.json as json
import sys

fn command(x: f32, jump: bool) -> play.Input { play.Input { x: x, z: 0.0, jump: jump } }

@test fn validated_scene_edits_replace_by_name_and_preserve_order() {
    mut scene := play.empty("Workshop")
    assert(play.upsert(&mut scene, "{\"name\":\"A\",\"shape\":\"box\"}").is_ok())
    assert(play.upsert(&mut scene, "{\"name\":\"B\",\"shape\":\"box\"}").is_ok())
    assert(play.upsert(&mut scene, "{\"name\":\"C\",\"shape\":\"sphere\"}").is_ok())
    assert(play.upsert(&mut scene, "{\"name\":\"B\",\"shape\":\"sphere\",\"role\":\"player\",\"mass\":1}").is_ok())
    before := play.encode(&scene)
    for input in [
        "{\"name\":\"B\",\"shape\":\"sphere\",\"size\":[1,2,3]}",
        "{\"name\":\"D\",\"shape\":\"box\",\"role\":\"player\",\"mass\":1}",
        "{\"name\":\"D\",\"shape\":\"box\",\"role\":null}",
        "{\"name\":\"D\",\"shape\":\"box\",\"mas\":4}",
        "{\"name\":\"D\",\"shape\":\"box\",\"mass\":0,\"mass\":1}",
        "{\"name\":\"D\",\"shape\":\"box\",\"mass\":1e309}",
        "{\"name\":\"D\",\"shape\":\"box\",\"velocity\":[1,0,0]}",
    ] { assert(play.upsert(&mut scene, input).is_err()) }
    assert(play.encode(&scene) == before)
    assert(play.remove(&mut scene, "D").is_err())
    assert(play.remove(&mut scene, "B").is_ok())
    assert(scene.entities.len == 2 && scene.entities[0].name == "A" && scene.entities[1].name == "C")
    assert(play.validate_name("  ").is_err() && play.validate_name("Hål 🟡").is_ok())
}

@test fn scene_version_unique_entities_and_types_are_checked() {
    assert(play.decode("{\"version\":2,\"name\":\"A\",\"entities\":[]}").is_err())
    assert(play.decode("{\"version\":1,\"name\":\"A\",\"entities\":{}}").is_err())
    assert(play.decode("{\"version\":1,\"name\":\"A\",\"gravity\":[0,null,0],\"entities\":[]}").is_err())
    assert(play.decode("{\"version\":1,\"name\":\"A\",\"entities\":[{\"name\":\"one\",\"shape\":\"box\"},{\"name\":\"one\",\"shape\":\"sphere\"}]}").is_err())
    empty := play.decode("{\"version\":1,\"name\":\"A\",\"entities\":[]}").unwrap()
    assert(empty.entities.len == 0 && empty.gravity.y < -9.8 && empty.theme == .Plain && empty.bounds.is_none())
    for prefix in ["\"theme\":\"typo\"", "\"bounds\":[-3,-2,0]", "\"bounds\":[2,-2,1,2]", "\"bounds\":[0,0,0,0]"] {
        assert(play.decode("{\"version\":1,\"name\":\"A\"," + prefix + ",\"entities\":[]}").is_err())
    }
}

fn walk(s: &mut play.Session, x: f32, z: f32, ticks: i32) {
    for _ in 0..ticks { play.step(&mut s, play.Input { x: x, z: z, jump: false }) }
}

@test fn blossom_demo_collects_all_ten_flowers_once_with_replayable_inputs() {
    original := play.demo()
    source := play.encode(&original)
    mut s := play.start(&play.decode(source).unwrap())
    assert(s.scene.theme == .Blossom && s.scene.name == "Blomsterskogen")
    assert(s.scene.entities.len == 59 && s.scene.entities.len <= play.MAX_ENTITIES)
    assert(s.flowers == 0 && s.total_flowers == 10 && s.total_butterflies == 5)
    assert(s.last_flower == -1 && s.picked_tick == -1)
    assert(s.scene.entities[0].name == "Ängen" && s.scene.entities[1].name == "Vallmo" && s.heading == 0.35)

    // 1. Smörblomma [2] (-2.15, 2.35) in Körsbärsgläntan West
    walk(&mut s, -1.0, 0.16, 29)
    assert(s.flowers == 1 && s.last_flower == 2 && s.collected[2] && !s.won)
    picked1 := s.picked_tick
    walk(&mut s, 0.0, 0.0, 3)
    assert(s.picked_tick == picked1 && s.flowers == 1)

    // 2. Prästkrage [4] (-6.15, 5.10) beside Picknickgläntan's quilt edge (SW)
    walk(&mut s, -1.0, 0.55, 58)
    walk(&mut s, 0.0, 1.0, 10)
    assert(s.flowers == 2 && s.last_flower == 4 && s.collected[4] && !s.won)

    // 3. Klöverblomma [9] (-0.40, 7.90) in Södra Klöverängen (S)
    walk(&mut s, 1.0, 0.46, 86)
    assert(s.flowers == 3 && s.last_flower == 9 && s.collected[9] && !s.won)

    // 4. Gullviva [8] (8.40, 5.10) on Solkullen (SE)
    walk(&mut s, 1.0, -0.32, 123)
    assert(s.flowers == 4 && s.last_flower == 8 && s.collected[8] && !s.won)

    // 5. Linnea [7] (9.20, -1.60) in Bärgläntan (NE)
    walk(&mut s, 0.12, -1.0, 90)
    assert(s.flowers == 5 && s.last_flower == 7 && s.collected[7] && !s.won)

    // 6. Blåklocka [3] (2.60, 0.70) in Körsbärsgläntan East
    walk(&mut s, -1.0, 0.35, 93)
    assert(s.flowers == 6 && s.last_flower == 3 && s.collected[3] && !s.won)

    // 7. Smultronblomma [11] (5.50, 1.99, 2.80) perched on Honungsmolnet (East low cloud)
    fly(&mut s, 0.71, 0.71, true, 15, false)
    fly(&mut s, 0.0, 0.0, false, 48, false)
    assert(s.last_cloud == 43 && s.bodies[s.player].grounded)
    fly(&mut s, 1.0, 0.62, true, 33, false)
    fly(&mut s, 0.0, 0.0, false, 34, false)
    assert(s.last_cloud == 44 && s.bodies[s.player].grounded)
    assert(s.flowers == 7 && s.last_flower == 11 && s.collected[11] && !s.won)

    // Drop back toward central crossroads and trot straight north across Bäckbron to Lyktängen.
    walk(&mut s, -1.0, -0.45, 78)
    assert(s.bodies[s.player].grounded)
    // 8. Förgätmigej [6] (0.40, -9.10) across Bäckbron in Lyktängen (N)
    walk(&mut s, 0.05, -1.0, 128)
    assert(s.flowers == 8 && s.last_flower == 6 && s.collected[6] && !s.won)

    // 9. Skogsviol [5] (-9.10, -2.50) in Svampdungen (W)
    walk(&mut s, -1.0, 0.69, 154)
    assert(s.flowers == 9 && s.last_flower == 5 && s.collected[5] && !s.won)

    // Return to central west cloud launch and climb gentle western staircase to Svampmolnet.
    walk(&mut s, 1.0, 0.48, 108)
    // 10. Skogsstjärna [10] (-6.70, 2.91, -1.60) perched on Svampmolnet (West staircase)
    fly(&mut s, -1.0, 0.0, true, 24, false)
    fly(&mut s, 0.0, 0.0, false, 40, false)
    assert(s.last_cloud == 38 && s.bodies[s.player].grounded)
    fly(&mut s, -1.0, -0.62, true, 31, false)
    fly(&mut s, 0.0, 0.0, false, 34, false)
    assert(s.last_cloud == 39 && s.bodies[s.player].grounded)
    fly(&mut s, -0.94, -1.0, true, 31, false)
    fly(&mut s, 0.0, 0.0, false, 34, false)
    assert(s.last_cloud == 40 && s.bodies[s.player].grounded)
    assert(s.flowers == 10 && s.last_flower == 10 && s.collected[10] && s.won)
    final_pick := s.picked_tick
    walk(&mut s, 0.0, 0.0, 3)
    assert(s.picked_tick == final_pick && s.flowers == 10 && !s.walking && s.butterflies == 0)

    assert(play.encode(&s.scene) == source)
    reset := play.start(&s.scene)
    assert(reset.tick == 0 && !reset.won && reset.flowers == 0 && reset.picked_tick == -1)
    for picked in reset.collected { assert(!picked) }
    state := json.Doc::parse_text(play.state_json(&s))
    assert(state.ok && state.get_i64(state.root, "flowers").unwrap() == 10 && state.get_bool(state.root, "won").unwrap())
    assert(state.get_i64(state.root, "last_flower").unwrap() == 10)
    assert(state.get_i64(state.root, "picked_tick").unwrap() == s.picked_tick)
    entities := state.field(state.root, "entities")
    assert(state.count(entities) == original.entities.len)
    for i in 0..original.entities.len {
        assert(state.get_bool(state.at(entities, i), "collected").unwrap() == (original.entities[i].role == .Flower))
    }
}

@test fn authored_bounds_limit_player_motion_and_the_gait_uses_real_displacement() {
    original := play.demo()
    mut s := play.start(&original)
    walk(&mut s, 1.0, 0.0, 12)
    assert(s.walking && s.heading > 1.56 && s.heading < 1.58 && s.walk_phase > 0.0)
    walk(&mut s, 1.0, 1.0, 360)
    at_edge := play.position(&s, 1)
    assert(at_edge.x == 13.5 && at_edge.z == 11.5 && !s.walking)
    phase := s.walk_phase
    walk(&mut s, 1.0, 1.0, 8)
    assert(s.walk_phase == phase && s.bodies[s.player].velocity.x == 0.0)
    walk(&mut s, -1.0, -1.0, 620)
    bottom := play.position(&s, 1)
    assert(bottom.x == -13.5 && bottom.z == -11.5)
}

@test fn the_forest_trunk_and_bridge_railings_block_while_bridge_deck_is_walkable() {
    mut original := play.demo()
    assert(original.entities[12].role == .Collider && original.entities[12].name == "Stam 1")
    assert(original.entities[30].role == .Collider && original.entities[30].name == "Broräcke Väst")
    assert(original.entities[31].role == .Collider && original.entities[31].name == "Broräcke Öst")
    assert(play.upsert(&mut original, "{\"name\":\"Stam 1\",\"role\":\"collider\",\"shape\":\"box\",\"mass\":1}").is_err())
    mut s := play.start(&play.decode(play.encode(&original)).unwrap())
    // Clear Vägvisaren (-2.10, -1.90), then approach Stam 1 (-3.80, -1.50) squarely from the east.
    walk(&mut s, -1.0, 0.0, 38)
    walk(&mut s, 0.0, -1.0, 47)
    walk(&mut s, -1.0, 0.0, 40)
    p := play.position(&s, 1)
    trunk := &s.scene.entities[12]
    east_face := trunk.position.x + trunk.size.x * 0.5
    assert((p.x - east_face - 0.4).abs() < 0.005)
    assert((p.z - trunk.position.z).abs() < 0.06 && s.contacts >= 2)
    walk(&mut s, -1.0, 0.0, 20)
    assert((play.position(&s, 1).x - p.x).abs() < 0.001)
    walk(&mut s, 1.0, 0.0, 10)
    assert(play.position(&s, 1).x > p.x + 0.5)

    // Crossing straight north over Bäckbron (z = -4.8) passes smoothly between the railings.
    mut bridge := play.start(&original)
    walk(&mut bridge, 0.0, -1.0, 148)
    across := play.position(&bridge, 1)
    assert(across.x.abs() < 0.001 && across.z < -8.5 && bridge.collected[6])
    // Pushing east at bridge mid-span stops cleanly at Broräcke Öst.
    mut rail := play.start(&original)
    walk(&mut rail, 0.0, -1.0, 91)
    walk(&mut rail, 1.0, 0.0, 40)
    rp := play.position(&rail, 1)
    east_rail := &rail.scene.entities[31]
    west_face := east_rail.position.x - east_rail.size.x * 0.5
    assert((rp.x - (west_face - 0.4)).abs() < 0.005)
}

@test fn plain_goal_scenes_keep_their_win_condition_and_support_optional_flowers() {
    mut scene := play.empty("Goal")
    assert(play.upsert(&mut scene, "{\"name\":\"floor\",\"shape\":\"box\",\"position\":[0,-0.5,0],\"size\":[25,1,5]}").is_ok())
    assert(play.upsert(&mut scene, "{\"name\":\"player\",\"shape\":\"sphere\",\"role\":\"player\",\"mass\":1,\"position\":[0,0.5,0]}").is_ok())
    assert(play.upsert(&mut scene, "{\"name\":\"goal\",\"shape\":\"box\",\"role\":\"goal\",\"position\":[0,0.5,0]}").is_ok())
    mut old := play.start(&scene)
    walk(&mut old, 1.0, 0.0, 90)
    assert(old.won && old.total_flowers == 0 && play.position(&old, 1).x > 5.0)
    assert(play.upsert(&mut scene, "{\"name\":\"bloom\",\"shape\":\"sphere\",\"role\":\"flower\",\"mass\":1}").is_err())
    assert(play.upsert(&mut scene, "{\"name\":\"bloom\",\"shape\":\"sphere\",\"role\":\"flower\",\"position\":[2.5,0.5,0]}").is_ok())
    mut mixed := play.start(&scene)
    walk(&mut mixed, 1.0, 0.0, 35)
    assert(mixed.flowers == 1 && mixed.collected[3] && !mixed.won)
    walk(&mut mixed, -1.0, 0.0, 32)
    assert(mixed.won && mixed.flowers == 1)
}

@test fn frame_rate_does_not_change_the_simulation_and_fractional_time_is_preserved() {
    original := play.demo()
    mut sixty := play.start(&original)
    mut fast := play.start(&original)
    for _ in 0..60 { play.step(&mut sixty, command(1.0, false)) }
    for _ in 0..144 { _ := play.advance(&mut fast, 1.0 / 144.0, command(1.0, false)) }
    assert(play.state_json(&sixty) == play.state_json(&fast))
    p0 := play.position(&fast, 1)
    assert(play.advance(&mut fast, 1.0 / 120.0, command(0.0, false)) == 0)
    assert(play.position(&fast, 1).x == p0.x)
    assert(play.advance(&mut fast, 1.0 / 120.0, command(0.0, false)) == 1)
    assert(play.advance(&mut fast, 120.0, command(0.0, false)) == 8)
    assert(play.advance(&mut fast, -1.0, command(0.0, false)) == 0)
    assert(fast.tick == 69)
}

@test fn jump_is_buffered_once_across_frames_without_a_tick_and_positions_interpolate() {
    original := play.demo()
    mut s := play.start(&original)
    for _ in 0..5 { play.step(&mut s, command(0.0, false)) }
    start := play.position(&s, 1)
    assert(s.bodies[s.player].grounded)
    assert(play.advance(&mut s, 1.0 / 120.0, command(1.0, true)) == 0)
    assert(play.advance(&mut s, 1.0 / 120.0, command(1.0, false)) == 1)
    end := play.position(&s, 1)
    assert(end.y > start.y + 0.05 && end.x > start.x)
    assert(play.advance(&mut s, 1.0 / 120.0, command(1.0, false)) == 0)
    middle := play.render_position(&s, 1)
    assert(middle.x > start.x && middle.x < end.x && middle.y > start.y && middle.y < end.y)
    for _ in 0..100 { _ := play.advance(&mut s, 1.0 / 60.0, command(0.0, false)) }
    assert(s.bodies[s.player].grounded && s.bodies[s.player].velocity.y == 0.0)
}

@test fn save_roundtrips_authored_values_and_failed_edits_leave_the_file_intact() {
    mut scene := play.demo()
    scene.name = "Åskans \"arena\""
    path := "/tmp/storm-scene-" + sys.pid().str() + ".json"
    assert(play.save(&scene, path).is_ok())
    loaded := play.load(path).unwrap()
    before := play.encode(&scene)
    assert(play.encode(&loaded) == before)
    scene.name = ""
    assert(play.save(&scene, path).is_err())
    assert(play.encode(&play.load(path).unwrap()) == before)
    assert(sys.remove_file(path).ok)
}

@test fn motion_samples_real_takeoff_impact_and_reset_on_the_position_clock() {
    scene := play.demo()
    mut s := play.start(&scene)
    spawn := play.render_motion(&s, true)
    assert(spawn .seconds == 0.0 && spawn .grounded && spawn .takeoff_age < 0.0 && spawn .landing_age < 0.0)
    assert(play.render_tick_offset(&s, false) == 0.0)
    play.step(&mut s, command(0.0, true))
    leap := play.render_motion(&s, true)
    assert(leap.takeoff_age == 0.0 && !leap.grounded && leap.vertical_velocity > 5.0 && leap.boost_age < 0.0)
    assert(play.advance(&mut s, play.TICK_SECONDS * 0.5, command(0.0, false)) == 0)
    approach := play.render_motion(&s, false)
    assert(play.render_tick_offset(&s, false) == -0.5 && play.render_tick_offset(&s, true) == 0.0)
    assert(approach.takeoff_age < 0.0 && approach.grounded && approach.vertical_velocity == 0.0)
    assert((approach.seconds - f32(play.TICK_SECONDS * 0.5)).abs() < 0.000001)
    play.step(&mut s, command(0.0, true))
    flight := play.render_motion(&s, false)
    assert(!flight.grounded && flight.takeoff_age == approach.seconds && flight.vertical_velocity < leap.vertical_velocity)
    mut impacts := 0
    for _ in 0..100 {
        play.step(&mut s, command(0.0, false))
        impact := play.render_motion(&s, true)
        if impact.landing_age == 0.0 {
            impacts += 1
            assert(impact.grounded && impact.landing_strength > 0.60 && impact.landing_strength < 0.75)
            incoming := play.render_motion(&s, false)
            assert(!incoming.grounded && incoming.landing_age < 0.0 && incoming.vertical_velocity < -5.0)
        }
    }
    assert(impacts == 1 && play.render_motion(&s, true).boost_age < 0.0)
    reset := play.render_motion(&play.start(&scene), false)
    assert(reset.takeoff_age < 0.0 && reset.landing_age < 0.0 && reset.landing_strength == 0.0 && reset.seconds == 0.0)
}

@test fn visual_turns_walk_cycles_and_run_weight_interpolate_from_real_displacement() {
    scene := play.demo()
    mut s := play.start(&scene)
    walk(&mut s, 0.01, -1.0, 1)
    start := play.render_motion(&s, true)
    assert(start.heading > 0.35 && start.heading < 0.7 && start.run_weight > 0.0 && start.run_weight < 0.2)
    for _ in 0..60 {
        if s.walk_phase + start.walk_phase >= 6.2831853 { break }
        walk(&mut s, 0.01, -1.0, 1)
    }
    before := play.render_motion(&s, true)
    assert(before.heading > 3.10 && before.run_weight > 0.95 && before.walk_phase > 5.5)
    assert(play.advance(&mut s, play.TICK_SECONDS * 1.5, play.Input { x: -0.01, z: -1.0, jump: false }) == 1)
    middle := play.render_motion(&s, false)
    after := play.render_motion(&s, true)
    assert(middle.heading.abs() > 3.12 && after.heading < -3.10)
    assert(after.walk_phase < start.walk_phase && middle.walk_phase > before.walk_phase)
    assert((middle.walk_phase - (before.walk_phase + after.walk_phase + 6.2831853) * 0.5).abs() < 0.0001)
    play.step(&mut s, command(0.0, false))
    stop := play.render_motion(&s, true)
    assert(stop.run_weight > 0.7 && stop.run_weight < after.run_weight && stop.walk_phase == after.walk_phase)
    walk(&mut s, 0.0, 0.0, 8)
    assert(play.render_motion(&s, true).run_weight == 0.0)
}

fn fly(s: &mut play.Session, x: f32, z: f32, jump: bool, ticks: i32, realtime: bool) {
    mut i := 0
    while i < ticks {
        input := play.Input { x: x, z: z, jump: i == 0 && jump }
        if !realtime { play.step(&mut s, input) }
        else if i % 3 == 1 && i + 1 < ticks {
            assert(play.advance(&mut s, play.TICK_SECONDS * 2.0, input) == 2)
            i += 1
        } else {
            assert(play.advance(&mut s, play.TICK_SECONDS * 0.4, input) == 0)
            assert(play.advance(&mut s, play.TICK_SECONDS * 0.6, play.Input { x: x, z: z, jump: false }) == 1)
        }
        i += 1
    }
}

fn climb_west_to_crown(s: &mut play.Session, realtime: bool) {
    fly(&mut s, 0.0, 0.0, false, 2, realtime)
    directions := [[-1.0, -0.22], [-1.0, -0.62], [-0.94, -1.0], [0.89, -1.0], [1.0, -0.54], [1.0, -0.41]]
    runs := [43, 31, 31, 32, 36, 39]
    waits := [24, 34, 34, 34, 30, 28]
    pads := [38, 39, 40, 41, 42, 51]
    for i in 0..runs.len {
        fly(&mut s, f32(directions[i][0]), f32(directions[i][1]), true, runs[i], realtime)
        fly(&mut s, 0.0, 0.0, false, waits[i], realtime)
        assert(s.last_cloud == pads[i] && s.bodies[s.player].grounded)
        if i == 2 { assert(s.flowers == 1 && s.collected[10]) }
        if i == 3 { assert(s.butterflies == 1 && s.collected[54]) }
        if i == 4 { assert(s.butterflies == 2 && s.collected[55]) }
        if i == 5 { assert(s.butterflies == 3 && s.collected[57]) }
    }
}

fn hop_to_stjarnstudsen(s: &mut play.Session, realtime: bool) {
    fly(&mut s, 0.80, -1.0, true, 34, realtime)
    fly(&mut s, 0.0, 0.0, false, 38, realtime)
    assert(s.last_cloud == 52 && s.cloud_tick == s.tick)
}

fn climb_east_to_hallonstudsen(s: &mut play.Session, realtime: bool) {
    fly(&mut s, 0.0, 0.0, false, 2, realtime)
    // Ground -> Solmolnet [43] -> Honungsmolnet [44] (Smultronblomma [11]) -> Hallonstudsen [45].
    fly(&mut s, 1.0, -0.15, true, 46, realtime)
    fly(&mut s, 0.0, 0.0, false, 20, realtime)
    assert(s.last_cloud == 43 && s.bodies[s.player].grounded)
    fly(&mut s, 1.0, 0.62, true, 33, realtime)
    fly(&mut s, 0.0, 0.0, false, 34, realtime)
    assert(s.last_cloud == 44 && s.bodies[s.player].grounded)
    assert(s.flowers == 1 && s.collected[11])
    fly(&mut s, 0.08, -1.0, true, 32, realtime)
    fly(&mut s, 0.0, 0.0, false, 40, realtime)
    assert(s.last_cloud == 45 && s.cloud_tick == s.tick)
}

fn meadow() -> play.Scene {
    demo := play.demo()
    mut scene := play.empty("Äng")
    scene.entities.push(demo.entities[0].clone())
    scene.entities.push(demo.entities[1].clone())
    scene
}

@test fn body_weight_tracks_signed_turns_braking_and_restart_at_both_frame_rates() {
    scene := meadow()
    for realtime in [false, true] {
        mut s := play.start(&scene)
        fly(&mut s, 0.0, 1.0, false, 4, realtime)
        assert(play.render_motion(&s, true).drive > 0.50)
        fly(&mut s, 0.0, 1.0, false, 40, realtime)
        steady := play.render_motion(&s, true)
        assert(steady.drive.abs() < 0.01 && steady.bank.abs() < 0.01)
        fly(&mut s, -1.0, 0.0, false, 4, realtime)
        assert(play.render_motion(&s, true).bank < -0.6)
        fly(&mut s, -1.0, 0.0, false, 24, realtime)
        fly(&mut s, 0.0, 1.0, false, 4, realtime)
        assert(play.render_motion(&s, true).bank > 0.6)
        fly(&mut s, 0.0, 1.0, false, 32, realtime)
        fly(&mut s, 0.0, 0.0, false, 3, realtime)
        braking := play.render_motion(&s, true)
        assert(braking.drive < -0.45 && braking.run_weight > 0.5)
        assert(play.advance(&mut s, play.TICK_SECONDS * 1.5, command(0.0, false)) == 1)
        middle := play.render_motion(&s, false)
        after := play.render_motion(&s, true)
        assert((middle.drive - 0.5 * (braking.drive + after.drive)).abs() < 0.00001)
        assert((middle.bank - 0.5 * (braking.bank + after.bank)).abs() < 0.00001)
        walk(&mut s, 0.0, 0.0, 42)
        assert(play.render_motion(&s, true).drive.abs() < 0.01)
        walk(&mut s, 0.0, 1.0, 3)
        assert(play.render_motion(&s, true).drive > 0.45)
    }
}

@test fn contact_history_covers_an_analog_stride_through_a_long_pause_and_sharp_turn() {
    scene := meadow()
    mut s := play.start(&scene)
    first := play.stride_anchor(&s, true, 0.5)
    assert(first.distance == 0.0 && first.run_weight == 0.0)
    walk(&mut s, 0.05, 0.0, 500)
    anchor := play.stride_anchor(&s, true, play.STRIDE_LENGTH)
    end := play.position(&s, 1)
    assert(anchor.distance == play.STRIDE_LENGTH && (end.x - anchor.position.x - anchor.distance).abs() < 0.00002)
    assert((anchor.run_weight - 0.05).abs() < 0.001 && (anchor.heading - 1.5708).abs() < 0.001)
    walk(&mut s, 0.0, 0.0, 900)
    held := play.stride_anchor(&s, true, play.STRIDE_LENGTH)
    assert(held.position.x == anchor.position.x && held.heading == anchor.heading && held.run_weight == anchor.run_weight)
    assert(play.stride_anchor(&s, true, 0.0).run_weight > 0.049 && play.render_motion(&s, true).run_weight == 0.0)
    walk(&mut s, 0.0, 1.0, 6)
    assert(play.advance(&mut s, play.TICK_SECONDS * 1.5, play.Input { x: 0.0, z: 1.0, jump: false }) == 1)
    corner := play.stride_anchor(&s, false, 0.7)
    now := play.render_position(&s, 1)
    assert((corner.position.x - (end.x - (0.7 - (now.z - end.z)))).abs() < 0.0001)
    assert((corner.position.z - end.z).abs() < 0.0001 && (corner.heading - 1.5708).abs() < 0.001)
}

@test fn contact_history_breaks_at_teleports_ledges_landings_and_restart() {
    mut scene := meadow()
    mut upper := scene.entities[0].clone()
    upper.role = .Cloud
    upper.name = "Hylla"
    upper.size.x = 2.1
    scene.entities[0].position.y -= 2.0
    scene.entities.push(move upper)
    mut s := play.start(&scene)
    walk(&mut s, 1.0, 0.0, 8)
    assert(play.stride_anchor(&s, true, 1.0).distance > 0.5)
    s.bodies[s.player].position.x = -0.75
    walk(&mut s, 0.0, 0.0, 1)
    warped := play.stride_anchor(&s, true, 1.0)
    assert(warped.distance == 0.0 && warped.position.x == -0.75)
    mut fell := false
    mut landed := false
    for _ in 0..100 {
        walk(&mut s, 1.0, 0.0, 1)
        anchor := play.stride_anchor(&s, true, play.STRIDE_LENGTH)
        if !s.bodies[s.player].grounded {
            assert(anchor.distance == 0.0 && anchor.position.y == play.position(&s, 1).y)
            fell = true
        } else if fell && !landed {
            assert(anchor.distance == 0.0 && anchor.position.y < -1.5)
            landed = true
        }
    }
    assert(fell && landed)
    reset := play.stride_anchor(&play.start(&scene), true, play.STRIDE_LENGTH)
    assert(reset.distance == 0.0 && reset.position.x == 0.0)
}

@test fn airborne_takeoff_keeps_the_grounded_paw_position_heading_and_weight() {
    scene := meadow()
    mut s := play.start(&scene)
    walk(&mut s, 1.0, 0.0, 8)
    walk(&mut s, 0.0, 1.0, 3)
    ground := play.stride_anchor(&s, true, 0.33)
    assert(ground.distance == 0.33)
    for i in 0..5 {
        play.step(&mut s, play.Input { x: 0.0, z: 1.0, jump: i == 0 })
        assert(!s.bodies[s.player].grounded)
        held := play.last_support_anchor(&s, 0.33)
        assert(held.distance == ground.distance && held.heading == ground.heading && held.run_weight == ground.run_weight)
        assert(held.position.x == ground.position.x && held.position.y == ground.position.y && held.position.z == ground.position.z)
        assert(held.position.y < play.position(&s, 1).y)
    }
}

@test fn western_gentle_staircase_collects_all_five_butterflies_across_frame_rates() {
    scene := play.demo()
    mut expected := ""
    for realtime in [false, true] {
        mut s := play.start(&play.decode(play.encode(&scene)).unwrap())
        assert(s.total_butterflies == 5 && s.last_cloud == -1 && s.cloud_tick == -1)
        climb_west_to_crown(&mut s, realtime)
        assert(s.last_cloud == 51 && s.butterflies == 3 && !s.won)

        // Hop onto Stjärnstudsen [52] (BoostCloud) and launch to secret Stjärngläntan [53].
        hop_to_stjarnstudsen(&mut s, realtime)
        boost_tick := s.tick
        assert(s.cloud_tick == boost_tick && (s.cloud_origin.y - 4.45).abs() < 0.001 && s.last_cloud == 52)
        assert(!s.bodies[s.player].grounded && s.bodies[s.player].velocity.y == 8.2)
        spring := play.render_motion(&s, true)
        assert(spring.boost_age == 0.0 && spring.takeoff_age == 0.0 && spring.landing_age == 0.0)
        assert(!spring.grounded && spring.vertical_velocity == 8.2 && spring.landing_strength > 0.5)
        spring_anchor := play.last_support_anchor(&s, 0.33)
        assert(spring_anchor.distance == 0.0 && spring_anchor.position.x == play.position(&s, 1).x)
        assert((spring_anchor.position.y - s.cloud_origin.y - 0.4).abs() < 0.001)

        fly(&mut s, -1.0, -0.73, false, 36, realtime)
        assert(s.cloud_tick == boost_tick && play.position(&s, 1).y > 7.5)
        fly(&mut s, 0.0, 0.0, false, 58, realtime)
        assert(s.last_cloud == 53 && s.bodies[s.player].grounded)
        perch := play.render_motion(&s, true)
        assert(perch.grounded && (perch.boost_age - f32(s.tick - boost_tick) / 60.0).abs() < 0.0001)
        assert(perch.landing_age < perch.boost_age)
        assert(s.butterflies == 4 && s.last_butterfly == 58 && s.collected[58] && !s.won)

        // Cross over to the eastern canopy from the summit: Stjärngläntan [53] -> Kronbalkongen [51] -> Smultronstudsen [48] -> Bärterassen [46] -> Östra utsikten [47] (Solvinge [56]).
        fly(&mut s, 0.17, 1.0, true, 49, realtime)
        fly(&mut s, 0.0, 0.0, false, 44, realtime)
        assert(s.last_cloud == 51 && s.bodies[s.player].grounded)
        fly(&mut s, 1.0, 0.52, true, 49, realtime)
        fly(&mut s, 0.0, 0.0, false, 37, realtime)
        assert(s.last_cloud == 48 && s.cloud_tick == s.tick && !s.bodies[s.player].grounded && s.bodies[s.player].velocity.y == 8.2)
        fly(&mut s, 1.0, 0.68, false, 40, realtime)
        fly(&mut s, 0.0, 0.0, false, 64, realtime)
        assert(s.last_cloud == 46 && s.bodies[s.player].grounded)
        fly(&mut s, 1.0, -0.48, true, 34, realtime)
        fly(&mut s, 0.0, 0.0, false, 34, realtime)
        assert(s.last_cloud == 47 && s.bodies[s.player].grounded)
        assert(s.butterflies == 5 && s.last_butterfly == 56 && s.collected[56] && !s.won)
        if realtime { assert(play.state_json(&s) == expected) } else { expected = play.state_json(&s) }

        reset := play.start(&s.scene)
        assert(reset.butterflies == 0 && reset.butterfly_tick == -1 && reset.last_butterfly == -1 && !reset.collected[58])
        assert(reset.last_cloud == -1 && reset.cloud_tick == -1 && reset.tick == 0)
        assert(play.render_motion(&reset, false).boost_age < 0.0)
    }
}

@test fn eastern_bouncy_expressway_collects_all_five_butterflies_across_frame_rates() {
    scene := play.demo()
    mut expected := ""
    for realtime in [false, true] {
        mut s := play.start(&play.decode(play.encode(&scene)).unwrap())
        climb_east_to_hallonstudsen(&mut s, realtime)
        assert(!s.bodies[s.player].grounded && s.bodies[s.player].velocity.y == 8.2)

        // Boost Hallonstudsen [45] -> Bärterassen [46].
        fly(&mut s, 0.04, -1.0, false, 37, realtime)
        fly(&mut s, 0.0, 0.0, false, 54, realtime)
        assert(s.last_cloud == 46 && s.bodies[s.player].grounded)

        // Hop Bärterassen [46] -> Östra utsikten [47] (Solvinge [56]) -> back to Bärterassen [46].
        fly(&mut s, 1.0, -0.48, true, 34, realtime)
        fly(&mut s, 0.0, 0.0, false, 34, realtime)
        assert(s.last_cloud == 47 && s.bodies[s.player].grounded)
        assert(s.butterflies == 1 && s.collected[56])
        fly(&mut s, -1.0, 0.48, true, 34, realtime)
        fly(&mut s, 0.0, 0.0, false, 48, realtime)
        assert(s.last_cloud == 46 && s.bodies[s.player].grounded)

        // Glide Bärterassen [46] -> Smultronstudsen [48] (BoostCloud) -> Kronbalkongen [51] (Kronvinge [57]).
        fly(&mut s, -1.0, -0.68, true, 40, realtime)
        fly(&mut s, 0.0, 0.0, false, 33, realtime)
        assert(s.last_cloud == 48 && s.cloud_tick == s.tick && !s.bodies[s.player].grounded && s.bodies[s.player].velocity.y == 8.2)
        fly(&mut s, -1.0, -0.52, false, 49, realtime)
        fly(&mut s, 0.0, 0.0, false, 42, realtime)
        assert(s.last_cloud == 51 && s.bodies[s.player].grounded)
        assert(s.butterflies == 2 && s.collected[57])

        // Crown -> Stjärnstudsen [52] (BoostCloud) -> Stjärngläntan [53] (Stjärnvinge [58]).
        hop_to_stjarnstudsen(&mut s, realtime)
        fly(&mut s, -1.0, -0.73, false, 36, realtime)
        fly(&mut s, 0.0, 0.0, false, 58, realtime)
        assert(s.last_cloud == 53 && s.bodies[s.player].grounded)
        assert(s.butterflies == 3 && s.collected[58])

        // Glide down Stjärngläntan [53] -> Kronbalkongen [51] -> Sidenmolnet [42] (Sidenvinge [55]) -> Västra vilan [41] (Guldvinge [54]).
        fly(&mut s, 0.17, 1.0, true, 49, realtime)
        fly(&mut s, 0.0, 0.0, false, 44, realtime)
        assert(s.last_cloud == 51 && s.bodies[s.player].grounded)
        fly(&mut s, -1.0, 0.41, true, 39, realtime)
        fly(&mut s, 0.0, 0.0, false, 44, realtime)
        assert(s.last_cloud == 42 && s.bodies[s.player].grounded)
        assert(s.butterflies == 4 && s.collected[55])
        fly(&mut s, -1.0, 0.54, true, 36, realtime)
        fly(&mut s, 0.0, 0.0, false, 46, realtime)
        assert(s.last_cloud == 41 && s.bodies[s.player].grounded)
        assert(s.butterflies == 5 && s.collected[54] && !s.won)
        if realtime { assert(play.state_json(&s) == expected) } else { expected = play.state_json(&s) }
    }
}

@test fn central_brook_shortcut_connects_molnbron_to_both_west_and_east_skyways() {
    scene := play.demo()
    for go_east in [false, true] {
        mut s := play.start(&scene)
        // Walk NE from spawn (0, 2.0) to (1.0, -0.9), jump onto Bäckmolnet [49] (BoostCloud).
        walk(&mut s, 0.34, -1.0, 41)
        fly(&mut s, 0.72, -1.0, true, 20, false)
        fly(&mut s, 0.0, 0.0, false, 31, false)
        assert(s.last_cloud == 49 && s.cloud_tick == s.tick && !s.bodies[s.player].grounded && s.bodies[s.player].velocity.y == 8.2)
        // Boost onto Molnbron [50] floating directly above Bäckbron.
        fly(&mut s, -0.84, -1.0, false, 38, false)
        fly(&mut s, 0.0, 0.0, false, 56, false)
        assert(s.last_cloud == 50 && s.bodies[s.player].grounded)
        if !go_east {
            // West cross-branch: Molnbron [50] -> Sidenmolnet [42] (ordinary jump!).
            fly(&mut s, -1.0, -0.15, true, 36, false)
            fly(&mut s, 0.0, 0.0, false, 30, false)
            assert(s.last_cloud == 42 && s.bodies[s.player].grounded && s.collected[55])
        } else {
            // East cross-branch: Molnbron [50] -> Smultronstudsen [48] (BoostCloud) -> Kronbalkongen [51].
            fly(&mut s, 1.0, 0.06, true, 44, false)
            fly(&mut s, 0.0, 0.0, false, 28, false)
            assert(s.last_cloud == 48 && s.cloud_tick == s.tick && !s.bodies[s.player].grounded && s.bodies[s.player].velocity.y == 8.2)
            fly(&mut s, -1.0, -0.52, false, 49, false)
            fly(&mut s, 0.0, 0.0, false, 42, false)
            assert(s.last_cloud == 51 && s.bodies[s.player].grounded && s.collected[57])
        }
    }
}

@test fn an_ordinary_jump_from_the_pink_pads_cannot_reach_their_high_targets() {
    // 1. Hallonstudsen [45] -> Bärterassen [46] requires a BoostCloud.
    mut east := play.demo()
    east.entities[45].role = .Cloud
    mut se := play.start(&east)
    climb_east_to_hallonstudsen(&mut se, false)
    assert(se.bodies[se.player].grounded && se.bodies[se.player].velocity.y == 0.0)
    fly(&mut se, 0.04, -1.0, true, 37, false)
    fly(&mut se, 0.0, 0.0, false, 60, false)
    assert(se.last_cloud != 46)

    // 2. Smultronstudsen [48] -> Kronbalkongen [51] requires a BoostCloud.
    mut crown := play.demo()
    crown.entities[48].role = .Cloud
    crown.entities[1].position = core.vec3(3.30, 2.75 + 0.4, -4.10)
    mut sc := play.start(&crown)
    assert(sc.bodies[sc.player].grounded)
    fly(&mut sc, -1.0, -0.52, true, 49, false)
    fly(&mut sc, 0.0, 0.0, false, 45, false)
    assert(!sc.collected[57] && sc.last_cloud != 51)

    // 3. Bäckmolnet [49] -> Molnbron [50] requires a BoostCloud.
    mut brook := play.demo()
    brook.entities[49].role = .Cloud
    brook.entities[1].position = core.vec3(1.85, 1.15 + 0.4, -2.10)
    mut sb := play.start(&brook)
    assert(sb.bodies[sb.player].grounded)
    fly(&mut sb, -0.84, -1.0, true, 38, false)
    fly(&mut sb, 0.0, 0.0, false, 56, false)
    assert(sb.last_cloud != 50)

    // 4. Stjärnstudsen [52] -> Stjärngläntan [53] requires a BoostCloud.
    mut star := play.demo()
    star.entities[52].role = .Cloud
    mut ss := play.start(&star)
    climb_west_to_crown(&mut ss, false)
    hop_to_stjarnstudsen(&mut ss, false)
    assert(ss.bodies[ss.player].grounded && ss.bodies[ss.player].velocity.y == 0.0)
    fly(&mut ss, -1.0, -0.73, true, 36, false)
    fly(&mut ss, 0.0, 0.0, false, 65, false)
    assert(ss.butterflies == 3 && !ss.collected[58] && ss.last_cloud != 53)
}

@test fn blossom_demo_layout_invariants_hold_for_bounds_sensors_and_clouds() {
    scene := play.demo()
    b := scene.bounds.unwrap()
    assert(b.min_x == -13.5 && b.min_z == -11.5 && b.max_x == 13.5 && b.max_z == 11.5)
    assert(scene.entities.len == 59 && scene.entities.len <= play.MAX_ENTITIES)
    assert(scene.entities[0].name == "Ängen" && scene.entities[0].role == .Prop)
    assert(scene.entities[1].name == "Vallmo" && scene.entities[1].role == .Player)
    mut flowers := 0
    mut clouds := 0
    mut boosts := 0
    mut butterflies := 0
    mut colliders := 0
    for i in 0..scene.entities.len {
        e := &scene.entities[i]
        for j in i + 1..scene.entities.len {
            assert(e.name != scene.entities[j].name)
        }
        if e.role == .Flower {
            flowers += 1
            assert(i >= 2 && i < 12)
            assert(e.position.x > b.min_x + 0.5 && e.position.x < b.max_x - 0.5)
            assert(e.position.z > b.min_z + 0.5 && e.position.z < b.max_z - 0.5)
        } else if e.role == .Cloud {
            clouds += 1
            assert((e.size.y - 0.28).abs() < 0.0001)
            assert(e.position.x - e.size.x * 0.5 >= b.min_x && e.position.x + e.size.x * 0.5 <= b.max_x)
            assert(e.position.z - e.size.z * 0.5 >= b.min_z && e.position.z + e.size.z * 0.5 <= b.max_z)
        } else if e.role == .BoostCloud {
            boosts += 1
            assert((e.size.y - 0.28).abs() < 0.0001)
        } else if e.role == .SuperButterfly {
            butterflies += 1
            assert(e.position.x > b.min_x + 0.5 && e.position.x < b.max_x - 0.5)
            assert(e.position.z > b.min_z + 0.5 && e.position.z < b.max_z - 0.5)
        } else if e.role == .Collider {
            colliders += 1
        }
    }
    assert(flowers == 10 && clouds == 12 && boosts == 4 && butterflies == 5 && colliders == 26)
    // Verify no flower or player spawn overlaps any collider box, and no flower grows through the picnic quilt.
    for i in 0..scene.entities.len {
        e := &scene.entities[i]
        if e.role != .Flower && e.role != .Player { continue }
        if e.role == .Flower {
            in_quilt := e.position.x >= -10.14 - 0.32 && e.position.x <= -6.66 + 0.32 &&
            e.position.z >= 3.76 - 0.32 && e.position.z <= 6.64 + 0.32
            assert(!in_quilt)
        }
        r := e.size.x * 0.5
        for c in scene.entities {
            if c.role != .Collider { continue }
            dx := (e.position.x - c.position.x).abs() - c.size.x * 0.5
            dy := (e.position.y - c.position.y).abs() - c.size.y * 0.5
            dz := (e.position.z - c.position.z).abs() - c.size.z * 0.5
            px := if dx > 0.0 { dx } else { f32(0.0) }
            py := if dy > 0.0 { dy } else { f32(0.0) }
            pz := if dz > 0.0 { dz } else { f32(0.0) }
            assert(px * px + py * py + pz * pz > r * r)
        }
    }
}

@test fn butterflies_remain_collectible_after_bouquet_win_and_can_be_a_standalone_goal() {
    mut scene := play.empty("Garden")
    assert(play.upsert(&mut scene, "{\"name\":\"ground\",\"shape\":\"box\",\"size\":[10,1,10],\"position\":[0,-0.5,0]}").is_ok())
    assert(play.upsert(&mut scene, "{\"name\":\"player\",\"role\":\"player\",\"shape\":\"sphere\",\"mass\":1,\"position\":[0,0.5,0]}").is_ok())
    assert(play.upsert(&mut scene, "{\"name\":\"wing\",\"role\":\"super_butterfly\",\"shape\":\"sphere\",\"position\":[2.4,0.5,0]}").is_ok())
    assert(play.upsert(&mut scene, "{\"name\":\"flower\",\"role\":\"flower\",\"shape\":\"sphere\",\"position\":[0,0.5,0]}").is_ok())
    mut bouquet := play.start(&scene)
    walk(&mut bouquet, 0.0, 0.0, 1)
    assert(bouquet.won && bouquet.flowers == 1 && bouquet.butterflies == 0)
    walk(&mut bouquet, 1.0, 0.0, 30)
    assert(bouquet.won && bouquet.butterflies == 1 && bouquet.last_butterfly == 2)
    picked := bouquet.butterfly_tick
    walk(&mut bouquet, 0.0, 0.0, 4)
    assert(bouquet.butterflies == 1 && bouquet.butterfly_tick == picked)
    assert(play.remove(&mut scene, "flower").is_ok())
    mut solo := play.start(&scene)
    walk(&mut solo, 0.0, 0.0, 1)
    assert(!solo.won)
    walk(&mut solo, 1.0, 0.0, 30)
    assert(solo.won && solo.butterflies == solo.total_butterflies)
}

@test fn cloud_authoring_requires_a_static_box_and_butterflies_are_static_sensors() {
    mut scene := play.empty("Clouds")
    for role in ["cloud", "boost_cloud"] {
        assert(play.upsert(&mut scene, "{\"name\":\"pad\",\"shape\":\"sphere\",\"role\":\"" + role + "\"}").is_err())
        assert(play.upsert(&mut scene, "{\"name\":\"pad\",\"shape\":\"box\",\"role\":\"" + role + "\",\"mass\":1}").is_err())
        assert(play.upsert(&mut scene, "{\"name\":\"pad\",\"shape\":\"box\",\"role\":\"" + role + "\"}").is_ok())
    }
    assert(play.upsert(&mut scene, "{\"name\":\"w\",\"shape\":\"sphere\",\"role\":\"super_butterfly\",\"mass\":2}").is_err())
    assert(play.upsert(&mut scene, "{\"name\":\"w\",\"shape\":\"box\",\"role\":\"super_butterfly\"}").is_ok())
    encoded := play.encode(&scene)
    assert(play.encode(&play.decode(encoded).unwrap()) == encoded)
}

@test fn spawning_on_a_cloud_has_an_immediate_support_and_only_a_spring_launches_the_fox() {
    mut level := play.demo()
    for index in [38, 45, 48, 49, 52] {
        pad := level.entities[index].clone()
        level.entities[1].position = core.vec3(pad.position.x + 0.4, pad.position.y + pad.size.y * 0.5 + 0.4, pad.position.z)
        mut s := play.start(&level)
        assert(play.render_motion(&s, true).grounded && play.render_platform(&s, true) == index)
        height := play.position(&s, 1).y
        play.step(&mut s, play.Input { x: 0.0, z: 0.0, jump: false })
        if pad.role == .Cloud {
            assert(s.last_cloud == -1 && play.render_platform(&s, true) == index)
            assert((play.position(&s, 1).y - height).abs() < 0.00001)
            play.step(&mut s, play.Input { x: 0.0, z: 0.0, jump: true })
            assert(play.render_platform(&s, false) == index && play.render_platform(&s, true) == -1)
        } else {
            assert(s.last_cloud == index && play.render_motion(&s, true).boost_age == 0.0)
            assert(play.render_motion(&s, true).vertical_velocity > 8.0)
        }
    }
}

@test fn interrupted_microsteps_keep_bounded_footprint_history() {
    scene := meadow()
    mut s := play.start(&scene)
    walk(&mut s, 0.0, 0.0, 40)
    for i in 0..2500 {
        walk(&mut s, if i % 2 == 0 { 0.0002 } else { -0.0002 }, 0.0, 1)
        walk(&mut s, 0.0, 0.0, 3)
    }
    assert(play.stride_stop(&s, true, -1).is_none())
    assert(play.stride_stop(&s, true, 1).is_some())
    assert(play.stride_stop(&s, true, 8).is_none())
}

@test fn cozy_sit_pet_emote_interpolate_and_cancel_on_movement_or_jump() {
    scene := meadow()
    mut s := play.start(&scene)
    initial := play.render_cozy(&s, true)
    assert(!initial.sitting && initial.sit_weight == 0.0)
    assert(initial.sit_age < 0.0 && initial.pet_age < 0.0 && initial.emote_age < 0.0)
    assert(initial.flower_age < 0.0 && initial.butterfly_age < 0.0)

    // Toggle sit on grounded player and check sub-tick interpolation over 0.42s.
    play.toggle_sit(&mut s)
    assert(s.cozy_sitting && s.sit_tick == 0)
    assert(play.render_cozy(&s, true).sit_age == 0.0)
    play.step(&mut s, command(0.0, false))
    after_one := play.render_cozy(&s, true)
    expected_step := f32(play.TICK_SECONDS) / 0.42
    assert(after_one.sitting && (after_one.sit_weight - expected_step).abs() < 0.00001)
    assert((after_one.sit_age - f32(play.TICK_SECONDS)).abs() < 0.00001)

    assert(play.advance(&mut s, play.TICK_SECONDS * 0.5, command(0.0, false)) == 0)
    mid := play.render_cozy(&s, false)
    assert((mid.sit_weight - expected_step * 0.5).abs() < 0.00001)
    assert((mid.sit_age - f32(play.TICK_SECONDS * 0.5)).abs() < 0.00001)

    assert(play.advance(&mut s, play.TICK_SECONDS * 0.5, command(0.0, false)) == 1)
    assert(play.advance(&mut s, play.TICK_SECONDS * 0.5, command(0.0, false)) == 0)
    mid2 := play.render_cozy(&s, false)
    assert((mid2.sit_weight - expected_step * 1.5).abs() < 0.00001)
    assert((mid2.sit_age - f32(play.TICK_SECONDS * 1.5)).abs() < 0.00001)
    assert(play.advance(&mut s, play.TICK_SECONDS * 0.5, command(0.0, false)) == 1)

    // Finish sitting over 0.42s (about 26 ticks total).
    walk(&mut s, 0.0, 0.0, 30)
    seated := play.render_cozy(&s, true)
    assert(seated.sitting && seated.sit_weight == 1.0)

    // Movement cancels sit and ramps sit_weight back to 0.0 over 0.22s.
    play.step(&mut s, play.Input { x: 0.2, z: 0.0, jump: false })
    rising := play.render_cozy(&s, true)
    rise_step := f32(play.TICK_SECONDS) / 0.22
    assert(!rising.sitting && rising.sit_age < 0.0)
    assert((rising.sit_weight - (1.0 - rise_step)).abs() < 0.00001)
    walk(&mut s, 0.0, 0.0, 15)
    assert(play.render_cozy(&s, true).sit_weight == 0.0)

    // Toggle sit on, then toggle off manually, then sit again and cancel with buffered jump.
    play.toggle_sit(&mut s)
    assert(s.cozy_sitting)
    play.toggle_sit(&mut s)
    assert(!s.cozy_sitting && s.sit_tick == -1)

    play.toggle_sit(&mut s)
    walk(&mut s, 0.0, 0.0, 10)
    assert(s.cozy_sitting && s.sit_weight > 0.3)
    assert(play.advance(&mut s, play.TICK_SECONDS * 0.5, command(0.0, true)) == 0)
    assert(play.advance(&mut s, play.TICK_SECONDS * 0.5, command(0.0, false)) == 1)
    assert(!s.cozy_sitting && s.sit_tick == -1 && !s.bodies[s.player].grounded)
    // Cannot enter sit while airborne.
    play.toggle_sit(&mut s)
    assert(!s.cozy_sitting && s.sit_tick == -1)
    walk(&mut s, 0.0, 0.0, 80)
    assert(s.bodies[s.player].grounded)

    // Pet and emote ages advance on the render clock, and play.start resets all cozy state.
    play.pet(&mut s)
    play.step(&mut s, command(0.0, false))
    play.emote(&mut s)
    play.step(&mut s, command(0.0, false))
    assert(play.advance(&mut s, play.TICK_SECONDS * 0.5, command(0.0, false)) == 0)
    cozy := play.render_cozy(&s, false)
    assert((cozy.pet_age - f32(play.TICK_SECONDS * 1.5)).abs() < 0.00001)
    assert((cozy.emote_age - f32(play.TICK_SECONDS * 0.5)).abs() < 0.00001)

    reset := play.start(&scene)
    assert(!reset.cozy_sitting && reset.sit_tick == -1 && reset.sit_weight == 0.0 && reset.prev_sit_weight == 0.0)
    assert(reset.pet_tick == -1 && reset.emote_tick == -1)
    rc := play.render_cozy(&reset, false)
    assert(!rc.sitting && rc.sit_weight == 0.0 && rc.sit_age < 0.0 && rc.pet_age < 0.0 && rc.emote_age < 0.0)
}

@test fn cozy_flower_and_butterfly_ages_track_pickups() {
    original := play.demo()
    mut s := play.start(&original)
    walk(&mut s, -1.0, 0.0, 27)
    assert(s.flowers == 1 && s.picked_tick > 0)
    cozy := play.render_cozy(&s, true)
    assert((cozy.flower_age - f32(s.tick - s.picked_tick) * f32(play.TICK_SECONDS)).abs() < 0.00001)
    assert(cozy.butterfly_age < 0.0)

    mut garden := play.empty("Wing")
    assert(play.upsert(&mut garden, "{\"name\":\"ground\",\"shape\":\"box\",\"size\":[10,1,10],\"position\":[0,-0.5,0]}").is_ok())
    assert(play.upsert(&mut garden, "{\"name\":\"player\",\"role\":\"player\",\"shape\":\"sphere\",\"mass\":1,\"position\":[0,0.5,0]}").is_ok())
    assert(play.upsert(&mut garden, "{\"name\":\"wing\",\"role\":\"super_butterfly\",\"shape\":\"sphere\",\"position\":[1.2,0.5,0]}").is_ok())
    mut g := play.start(&garden)
    walk(&mut g, 1.0, 0.0, 15)
    assert(g.butterflies == 1 && g.butterfly_tick > 0)
    assert(play.advance(&mut g, play.TICK_SECONDS * 0.5, command(0.0, false)) == 0)
    wing_cozy := play.render_cozy(&g, false)
    expected_wing := (f32(g.tick - 1 - g.butterfly_tick) + 0.5) * f32(play.TICK_SECONDS)
    assert((wing_cozy.butterfly_age - expected_wing).abs() < 0.00001)
}
