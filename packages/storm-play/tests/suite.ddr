capability filesystem

import ..src.play as play
import core
import std.json as json
import sys

fn command(x: f32, jump: bool) -> play.Input { play.Input { x: x, z: 0.0, jump: jump } }

@test fn validated_scene_edits_replace_by_name_and_preserve_order() {
    mut scene := play.empty("Workshop")
    assert(play.upsert(&mut scene, "{\"name\":\"A\",\"shape\":\"box\"}").is_ok())
    assert(play.upsert(&mut scene, "{\"name\":\"B\",\"shape\":\"box\"}").is_ok())
    assert(play.upsert(&mut scene, "{\"name\":\"C\",\"shape\":\"sphere\"}").is_ok())
    assert(play.upsert(&mut scene, "{\"name\":\"B\",\"shape\":\"sphere\",\"role\":\"player\",\"mass\":1}").is_ok())
    before := play.encode(&scene)
    for input in [
        "{\"name\":\"B\",\"shape\":\"sphere\",\"size\":[1,2,3]}",
        "{\"name\":\"D\",\"shape\":\"box\",\"role\":\"player\",\"mass\":1}",
        "{\"name\":\"D\",\"shape\":\"box\",\"role\":null}",
        "{\"name\":\"D\",\"shape\":\"box\",\"mas\":4}",
        "{\"name\":\"D\",\"shape\":\"box\",\"mass\":0,\"mass\":1}",
        "{\"name\":\"D\",\"shape\":\"box\",\"mass\":1e309}",
        "{\"name\":\"D\",\"shape\":\"box\",\"velocity\":[1,0,0]}",
    ] { assert(play.upsert(&mut scene, input).is_err()) }
    assert(play.encode(&scene) == before)
    assert(play.remove(&mut scene, "D").is_err())
    assert(play.remove(&mut scene, "B").is_ok())
    assert(scene.entities.len == 2 && scene.entities[0].name == "A" && scene.entities[1].name == "C")
    assert(play.validate_name("  ").is_err() && play.validate_name("Hål 🟡").is_ok())
}

@test fn scene_version_unique_entities_and_types_are_checked() {
    assert(play.decode("{\"version\":2,\"name\":\"A\",\"entities\":[]}").is_err())
    assert(play.decode("{\"version\":1,\"name\":\"A\",\"entities\":{}}").is_err())
    assert(play.decode("{\"version\":1,\"name\":\"A\",\"gravity\":[0,null,0],\"entities\":[]}").is_err())
    assert(play.decode("{\"version\":1,\"name\":\"A\",\"entities\":[{\"name\":\"one\",\"shape\":\"box\"},{\"name\":\"one\",\"shape\":\"sphere\"}]}").is_err())
    empty := play.decode("{\"version\":1,\"name\":\"A\",\"entities\":[]}").unwrap()
    assert(empty.entities.len == 0 && empty.gravity.y < -9.8 && empty.theme == .Plain && empty.bounds.is_none())
    for prefix in ["\"theme\":\"typo\"", "\"bounds\":[-3,-2,0]", "\"bounds\":[2,-2,1,2]", "\"bounds\":[0,0,0,0]"] {
        assert(play.decode("{\"version\":1,\"name\":\"A\"," + prefix + ",\"entities\":[]}").is_err())
    }
}

fn walk(s: &mut play.Session, x: f32, z: f32, ticks: i32) {
    for _ in 0..ticks { play.step(&mut s, play.Input { x: x, z: z, jump: false }) }
}

@test fn blossom_demo_collects_all_five_flowers_once_with_replayable_inputs() {
    original := play.demo()
    source := play.encode(&original)
    mut s := play.start(&play.decode(source).unwrap())
    assert(s.scene.theme == .Blossom && s.scene.name == "Blomsterskogen")
    assert(s.flowers == 0 && s.total_flowers == 5 && s.last_flower == -1 && s.picked_tick == -1)
    assert(s.scene.entities[1].name == "Vallmo" && s.heading == 0.35)
    directions := [[-1.0, 0.0], [1.0, -0.25], [-1.0, -0.385], [1.0, -0.22], [1.0, 0.14]]
    times := [27, 54, 68, 40, 45]
    for i in 0..times.len {
        walk(&mut s, f32(directions[i][0]), f32(directions[i][1]), times[i])
        assert(s.flowers == i + 1 && s.last_flower == i + 2 && s.collected[i + 2])
        assert(s.picked_tick > 0 && s.picked_tick <= s.tick && s.won == (s.flowers == s.total_flowers))
        picked := s.picked_tick
        walk(&mut s, 0.0, 0.0, 3)
        assert(s.picked_tick == picked && s.flowers == i + 1)
    }
    assert(s.won && !s.walking && s.tick == 249 && s.butterflies == 0)
    assert(play.encode(&s.scene) == source)
    reset := play.start(&s.scene)
    assert(reset.tick == 0 && !reset.won && reset.flowers == 0 && reset.picked_tick == -1)
    for picked in reset.collected { assert(!picked) }
    state := json.Doc::parse_text(play.state_json(&s))
    assert(state.ok && state.get_i64(state.root, "flowers").unwrap() == 5 && state.get_bool(state.root, "won").unwrap())
    assert(state.get_i64(state.root, "last_flower").unwrap() == 6)
    assert(state.get_i64(state.root, "picked_tick").unwrap() == s.picked_tick)
    entities := state.field(state.root, "entities")
    assert(state.count(entities) == original.entities.len)
    for i in 0..original.entities.len {
        assert(state.get_bool(state.at(entities, i), "collected").unwrap() == (original.entities[i].role == .Flower))
    }
}

@test fn authored_bounds_limit_player_motion_and_the_gait_uses_real_displacement() {
    original := play.demo()
    mut s := play.start(&original)
    walk(&mut s, 1.0, 0.0, 12)
    assert(s.walking && s.heading > 1.56 && s.heading < 1.58 && s.walk_phase > 0.0)
    walk(&mut s, 1.0, 1.0, 240)
    at_edge := play.position(&s, 1)
    assert(at_edge.x == 5.0 && at_edge.z == 3.3 && !s.walking)
    phase := s.walk_phase
    walk(&mut s, 1.0, 1.0, 8)
    assert(s.walk_phase == phase && s.bodies[s.player].velocity.x == 0.0)
    walk(&mut s, -1.0, -1.0, 300)
    bottom := play.position(&s, 1)
    assert(bottom.x == -5.0 && bottom.z == -3.5)
}

@test fn the_forest_trunk_stops_the_runner_until_she_turns_back() {
    mut original := play.demo()
    assert(original.entities[7].role == .Collider && original.entities[7].name == "Stam 1")
    assert(play.upsert(&mut original, "{\"name\":\"Stam 1\",\"role\":\"collider\",\"shape\":\"box\",\"mass\":1}").is_err())
    mut s := play.start(&play.decode(play.encode(&original)).unwrap())
    walk(&mut s, 0.0, -1.0, 35)
    walk(&mut s, -1.0, 0.0, 100)
    p := play.position(&s, 1)
    trunk := &s.scene.entities[7]
    east_face := trunk.position.x + trunk.size.x * 0.5
    assert((p.x - east_face - 0.4).abs() < 0.005)
    assert((p.z - trunk.position.z).abs() < 0.06 && s.contacts >= 2)
    walk(&mut s, -1.0, 0.0, 20)
    assert((play.position(&s, 1).x - p.x).abs() < 0.001)
    walk(&mut s, 1.0, 0.0, 10)
    assert(play.position(&s, 1).x > p.x + 0.5)
}

@test fn plain_goal_scenes_keep_their_win_condition_and_support_optional_flowers() {
    mut scene := play.empty("Goal")
    assert(play.upsert(&mut scene, "{\"name\":\"floor\",\"shape\":\"box\",\"position\":[0,-0.5,0],\"size\":[25,1,5]}").is_ok())
    assert(play.upsert(&mut scene, "{\"name\":\"player\",\"shape\":\"sphere\",\"role\":\"player\",\"mass\":1,\"position\":[0,0.5,0]}").is_ok())
    assert(play.upsert(&mut scene, "{\"name\":\"goal\",\"shape\":\"box\",\"role\":\"goal\",\"position\":[0,0.5,0]}").is_ok())
    mut old := play.start(&scene)
    walk(&mut old, 1.0, 0.0, 90)
    assert(old.won && old.total_flowers == 0 && play.position(&old, 1).x > 5.0)
    assert(play.upsert(&mut scene, "{\"name\":\"bloom\",\"shape\":\"sphere\",\"role\":\"flower\",\"mass\":1}").is_err())
    assert(play.upsert(&mut scene, "{\"name\":\"bloom\",\"shape\":\"sphere\",\"role\":\"flower\",\"position\":[2.5,0.5,0]}").is_ok())
    mut mixed := play.start(&scene)
    walk(&mut mixed, 1.0, 0.0, 35)
    assert(mixed.flowers == 1 && mixed.collected[3] && !mixed.won)
    walk(&mut mixed, -1.0, 0.0, 32)
    assert(mixed.won && mixed.flowers == 1)
}

@test fn frame_rate_does_not_change_the_simulation_and_fractional_time_is_preserved() {
    original := play.demo()
    mut sixty := play.start(&original)
    mut fast := play.start(&original)
    for _ in 0..60 { play.step(&mut sixty, command(1.0, false)) }
    for _ in 0..144 { _ := play.advance(&mut fast, 1.0 / 144.0, command(1.0, false)) }
    assert(play.state_json(&sixty) == play.state_json(&fast))
    p0 := play.position(&fast, 1)
    assert(play.advance(&mut fast, 1.0 / 120.0, command(0.0, false)) == 0)
    assert(play.position(&fast, 1).x == p0.x)
    assert(play.advance(&mut fast, 1.0 / 120.0, command(0.0, false)) == 1)
    assert(play.advance(&mut fast, 120.0, command(0.0, false)) == 8)
    assert(play.advance(&mut fast, -1.0, command(0.0, false)) == 0)
    assert(fast.tick == 69)
}

@test fn jump_is_buffered_once_across_frames_without_a_tick_and_positions_interpolate() {
    original := play.demo()
    mut s := play.start(&original)
    for _ in 0..5 { play.step(&mut s, command(0.0, false)) }
    start := play.position(&s, 1)
    assert(s.bodies[s.player].grounded)
    assert(play.advance(&mut s, 1.0 / 120.0, command(1.0, true)) == 0)
    assert(play.advance(&mut s, 1.0 / 120.0, command(1.0, false)) == 1)
    end := play.position(&s, 1)
    assert(end.y > start.y + 0.05 && end.x > start.x)
    assert(play.advance(&mut s, 1.0 / 120.0, command(1.0, false)) == 0)
    middle := play.render_position(&s, 1)
    assert(middle.x > start.x && middle.x < end.x && middle.y > start.y && middle.y < end.y)
    for _ in 0..100 { _ := play.advance(&mut s, 1.0 / 60.0, command(0.0, false)) }
    assert(s.bodies[s.player].grounded && s.bodies[s.player].velocity.y == 0.0)
}

@test fn save_roundtrips_authored_values_and_failed_edits_leave_the_file_intact() {
    mut scene := play.demo()
    scene.name = "Åskans \"arena\""
    path := "/tmp/storm-scene-" + sys.pid().str() + ".json"
    assert(play.save(&scene, path).is_ok())
    loaded := play.load(path).unwrap()
    before := play.encode(&scene)
    assert(play.encode(&loaded) == before)
    scene.name = ""
    assert(play.save(&scene, path).is_err())
    assert(play.encode(&play.load(path).unwrap()) == before)
    assert(sys.remove_file(path).ok)
}

@test fn motion_samples_real_takeoff_impact_and_reset_on_the_position_clock() {
    scene := play.demo()
    mut s := play.start(&scene)
    spawn := play.render_motion(&s, true)
    assert(spawn.seconds == 0.0 && spawn.grounded && spawn.takeoff_age < 0.0 && spawn.landing_age < 0.0)
    assert(play.render_tick_offset(&s, false) == 0.0)
    play.step(&mut s, command(0.0, true))
    leap := play.render_motion(&s, true)
    assert(leap.takeoff_age == 0.0 && !leap.grounded && leap.vertical_velocity > 5.0 && leap.boost_age < 0.0)
    assert(play.advance(&mut s, play.TICK_SECONDS * 0.5, command(0.0, false)) == 0)
    approach := play.render_motion(&s, false)
    assert(play.render_tick_offset(&s, false) == -0.5 && play.render_tick_offset(&s, true) == 0.0)
    assert(approach.takeoff_age < 0.0 && approach.grounded && approach.vertical_velocity == 0.0)
    assert((approach.seconds - f32(play.TICK_SECONDS * 0.5)).abs() < 0.000001)
    play.step(&mut s, command(0.0, true))
    flight := play.render_motion(&s, false)
    assert(!flight.grounded && flight.takeoff_age == approach.seconds && flight.vertical_velocity < leap.vertical_velocity)
    mut impacts := 0
    for _ in 0..100 {
        play.step(&mut s, command(0.0, false))
        impact := play.render_motion(&s, true)
        if impact.landing_age == 0.0 {
            impacts += 1
            assert(impact.grounded && impact.landing_strength > 0.60 && impact.landing_strength < 0.75)
            incoming := play.render_motion(&s, false)
            assert(!incoming.grounded && incoming.landing_age < 0.0 && incoming.vertical_velocity < -5.0)
        }
    }
    assert(impacts == 1 && play.render_motion(&s, true).boost_age < 0.0)
    reset := play.render_motion(&play.start(&scene), false)
    assert(reset.takeoff_age < 0.0 && reset.landing_age < 0.0 && reset.landing_strength == 0.0 && reset.seconds == 0.0)
}

@test fn visual_turns_walk_cycles_and_run_weight_interpolate_from_real_displacement() {
    scene := play.demo()
    mut s := play.start(&scene)
    walk(&mut s, 0.01, -1.0, 1)
    start := play.render_motion(&s, true)
    assert(start.heading > 0.35 && start.heading < 0.7 && start.run_weight > 0.0 && start.run_weight < 0.2)
    walk(&mut s, 0.01, -1.0, 15)
    before := play.render_motion(&s, true)
    assert(before.heading > 3.10 && before.run_weight > 0.95 && before.walk_phase > 5.5)
    assert(play.advance(&mut s, play.TICK_SECONDS * 1.5, play.Input { x: -0.01, z: -1.0, jump: false }) == 1)
    middle := play.render_motion(&s, false)
    after := play.render_motion(&s, true)
    assert(middle.heading.abs() > 3.12 && after.heading < -3.10)
    assert(after.walk_phase < 0.3 && middle.walk_phase > before.walk_phase && middle.walk_phase < 6.30)
    play.step(&mut s, command(0.0, false))
    stop := play.render_motion(&s, true)
    assert(stop.run_weight > 0.7 && stop.run_weight < after.run_weight && stop.walk_phase == after.walk_phase)
    walk(&mut s, 0.0, 0.0, 8)
    assert(play.render_motion(&s, true).run_weight == 0.0)
}

fn fly(s: &mut play.Session, x: f32, z: f32, jump: bool, ticks: i32, realtime: bool) {
    mut i := 0
    while i < ticks {
        input := play.Input { x: x, z: z, jump: i == 0 && jump }
        if !realtime { play.step(&mut s, input) }
        else if i % 3 == 1 && i + 1 < ticks {
            assert(play.advance(&mut s, play.TICK_SECONDS * 2.0, input) == 2)
            i += 1
        } else {
            assert(play.advance(&mut s, play.TICK_SECONDS * 0.4, input) == 0)
            assert(play.advance(&mut s, play.TICK_SECONDS * 0.6, play.Input { x: x, z: z, jump: false }) == 1)
        }
        i += 1
    }
}

fn climb_to_pink(s: &mut play.Session, realtime: bool) {
    fly(&mut s, 0.0, 0.0, false, 2, realtime)
    directions := [[-1.0, 0.04], [-1.0, -0.63], [-0.60, -1.0], [1.0, -0.40], [1.0, 0.0]]
    runs := [17, 21, 20, 23, 21]
    waits := [51, 54, 55, 57, 47]
    for i in 0..runs.len {
        fly(&mut s, f32(directions[i][0]), f32(directions[i][1]), true, runs[i], realtime)
        fly(&mut s, 0.0, 0.0, false, waits[i], realtime)
        assert(s.last_cloud == 11 + i)
        if i < 4 { assert(s.bodies[s.player].grounded) }
        if i == 2 { assert(s.butterflies == 1 && s.collected[17]) }
        if i == 3 { assert(s.butterflies == 2 && s.collected[18]) }
    }
}

fn meadow() -> play.Scene {
    demo := play.demo()
    mut scene := play.empty("Äng")
    scene.entities.push(demo.entities[0].clone())
    scene.entities.push(demo.entities[1].clone())
    scene
}

@test fn body_weight_tracks_signed_turns_braking_and_restart_at_both_frame_rates() {
    scene := meadow()
    for realtime in [false, true] {
        mut s := play.start(&scene)
        fly(&mut s, 0.0, 1.0, false, 4, realtime)
        assert(play.render_motion(&s, true).drive > 0.50)
        fly(&mut s, 0.0, 1.0, false, 40, realtime)
        steady := play.render_motion(&s, true)
        assert(steady.drive.abs() < 0.01 && steady.bank.abs() < 0.01)
        fly(&mut s, -1.0, 0.0, false, 4, realtime)
        assert(play.render_motion(&s, true).bank < -0.6)
        fly(&mut s, -1.0, 0.0, false, 24, realtime)
        fly(&mut s, 0.0, 1.0, false, 4, realtime)
        assert(play.render_motion(&s, true).bank > 0.6)
        fly(&mut s, 0.0, 1.0, false, 32, realtime)
        fly(&mut s, 0.0, 0.0, false, 3, realtime)
        braking := play.render_motion(&s, true)
        assert(braking.drive < -0.45 && braking.run_weight > 0.5)
        assert(play.advance(&mut s, play.TICK_SECONDS * 1.5, command(0.0, false)) == 1)
        middle := play.render_motion(&s, false)
        after := play.render_motion(&s, true)
        assert((middle.drive - 0.5 * (braking.drive + after.drive)).abs() < 0.00001)
        assert((middle.bank - 0.5 * (braking.bank + after.bank)).abs() < 0.00001)
        walk(&mut s, 0.0, 0.0, 42)
        assert(play.render_motion(&s, true).drive.abs() < 0.01)
        walk(&mut s, 0.0, 1.0, 3)
        assert(play.render_motion(&s, true).drive > 0.45)
    }
}

@test fn contact_history_covers_an_analog_stride_through_a_long_pause_and_sharp_turn() {
    scene := meadow()
    mut s := play.start(&scene)
    first := play.stride_anchor(&s, true, 0.5)
    assert(first.distance == 0.0 && first.run_weight == 0.0)
    walk(&mut s, 0.05, 0.0, 500)
    anchor := play.stride_anchor(&s, true, play.STRIDE_LENGTH)
    end := play.position(&s, 1)
    assert(anchor.distance == play.STRIDE_LENGTH && (end.x - anchor.position.x - anchor.distance).abs() < 0.00002)
    assert((anchor.run_weight - 0.05).abs() < 0.001 && (anchor.heading - 1.5708).abs() < 0.001)
    walk(&mut s, 0.0, 0.0, 900)
    held := play.stride_anchor(&s, true, play.STRIDE_LENGTH)
    assert(held.position.x == anchor.position.x && held.heading == anchor.heading && held.run_weight == anchor.run_weight)
    assert(play.stride_anchor(&s, true, 0.0).run_weight > 0.049 && play.render_motion(&s, true).run_weight == 0.0)
    walk(&mut s, 0.0, 1.0, 6)
    assert(play.advance(&mut s, play.TICK_SECONDS * 1.5, play.Input { x: 0.0, z: 1.0, jump: false }) == 1)
    corner := play.stride_anchor(&s, false, 0.7)
    now := play.render_position(&s, 1)
    assert((corner.position.x - (end.x - (0.7 - (now.z - end.z)))).abs() < 0.0001)
    assert((corner.position.z - end.z).abs() < 0.0001 && (corner.heading - 1.5708).abs() < 0.001)
}

@test fn contact_history_breaks_at_teleports_ledges_landings_and_restart() {
    mut scene := meadow()
    mut upper := scene.entities[0].clone()
    upper.role = .Cloud
    upper.name = "Hylla"
    upper.size.x = 2.1
    scene.entities[0].position.y -= 2.0
    scene.entities.push(move upper)
    mut s := play.start(&scene)
    walk(&mut s, 1.0, 0.0, 8)
    assert(play.stride_anchor(&s, true, 1.0).distance > 0.5)
    s.bodies[s.player].position.x = -0.75
    walk(&mut s, 0.0, 0.0, 1)
    warped := play.stride_anchor(&s, true, 1.0)
    assert(warped.distance == 0.0 && warped.position.x == -0.75)
    mut fell := false
    mut landed := false
    for _ in 0..100 {
        walk(&mut s, 1.0, 0.0, 1)
        anchor := play.stride_anchor(&s, true, play.STRIDE_LENGTH)
        if !s.bodies[s.player].grounded {
            assert(anchor.distance == 0.0 && anchor.position.y == play.position(&s, 1).y)
            fell = true
        } else if fell && !landed {
            assert(anchor.distance == 0.0 && anchor.position.y < -1.5)
            landed = true
        }
    }
    assert(fell && landed)
    reset := play.stride_anchor(&play.start(&scene), true, play.STRIDE_LENGTH)
    assert(reset.distance == 0.0 && reset.position.x == 0.0)
}

@test fn airborne_takeoff_keeps_the_grounded_paw_position_heading_and_weight() {
    scene := meadow()
    mut s := play.start(&scene)
    walk(&mut s, 1.0, 0.0, 8)
    walk(&mut s, 0.0, 1.0, 3)
    ground := play.stride_anchor(&s, true, 0.33)
    assert(ground.distance == 0.33)
    for i in 0..5 {
        play.step(&mut s, play.Input { x: 0.0, z: 1.0, jump: i == 0 })
        assert(!s.bodies[s.player].grounded)
        held := play.last_support_anchor(&s, 0.33)
        assert(held.distance == ground.distance && held.heading == ground.heading && held.run_weight == ground.run_weight)
        assert(held.position.x == ground.position.x && held.position.y == ground.position.y && held.position.z == ground.position.z)
        assert(held.position.y < play.position(&s, 1).y)
    }
}

@test fn real_inputs_climb_the_clouds_bounce_to_the_crown_and_replay_across_frame_rates() {
    scene := play.demo()
    mut expected := ""
    for realtime in [false, true] {
        mut s := play.start(&play.decode(play.encode(&scene)).unwrap())
        assert(s.total_butterflies == 3 && s.last_cloud == -1 && s.cloud_tick == -1)
        climb_to_pink(&mut s, realtime)
        assert(s.tick == 368 && s.cloud_tick == s.tick && s.cloud_origin.y == 1.7 && s.last_cloud == 15)
        assert(!s.bodies[s.player].grounded && s.bodies[s.player].velocity.y == 8.2)
        spring := play.render_motion(&s, true)
        assert(spring.boost_age == 0.0 && spring.takeoff_age == 0.0 && spring.landing_age == 0.0)
        assert(!spring.grounded && spring.vertical_velocity == 8.2 && spring.landing_strength > 0.5)
        spring_anchor := play.last_support_anchor(&s, 0.33)
        assert(spring_anchor.distance == 0.0 && spring_anchor.position.x == play.position(&s, 1).x)
        assert((spring_anchor.position.y - s.cloud_origin.y - 0.4).abs() < 0.001)
        fly(&mut s, 1.0, 0.11, false, 24, realtime)
        assert(s.cloud_tick == 368 && play.position(&s, 1).y > 4.5)
        fly(&mut s, 0.0, 0.0, false, 90, realtime)
        assert(s.tick == 482 && s.last_cloud == 16 && s.bodies[s.player].grounded)
        perch := play.render_motion(&s, true)
        assert(perch.grounded && perch.boost_age == f32((482.0 - 368.0) / 60.0) && perch.landing_age < perch.boost_age)
        assert(s.butterflies == 3 && s.last_butterfly == 19 && s.collected[19] && !s.won)
        if realtime { assert(play.state_json(&s) == expected) } else { expected = play.state_json(&s) }
        reset := play.start(&s.scene)
        assert(reset.butterflies == 0 && reset.butterfly_tick == -1 && reset.last_butterfly == -1 && !reset.collected[19])
        assert(reset.last_cloud == -1 && reset.cloud_tick == -1 && reset.tick == 0)
        assert(play.render_motion(&reset, false).boost_age < 0.0)
    }
}

@test fn an_ordinary_jump_from_the_pink_pad_cannot_reach_the_crown() {
    mut scene := play.demo()
    scene.entities[15].role = .Cloud
    mut s := play.start(&scene)
    climb_to_pink(&mut s, false)
    assert(s.bodies[s.player].grounded && s.bodies[s.player].velocity.y == 0.0)
    fly(&mut s, 1.0, 0.11, true, 24, false)
    fly(&mut s, 0.0, 0.0, false, 90, false)
    assert(s.butterflies == 2 && !s.collected[19] && s.last_cloud != 16)
}

@test fn butterflies_remain_collectible_after_bouquet_win_and_can_be_a_standalone_goal() {
    mut scene := play.empty("Garden")
    assert(play.upsert(&mut scene, "{\"name\":\"ground\",\"shape\":\"box\",\"size\":[10,1,10],\"position\":[0,-0.5,0]}").is_ok())
    assert(play.upsert(&mut scene, "{\"name\":\"player\",\"role\":\"player\",\"shape\":\"sphere\",\"mass\":1,\"position\":[0,0.5,0]}").is_ok())
    assert(play.upsert(&mut scene, "{\"name\":\"wing\",\"role\":\"super_butterfly\",\"shape\":\"sphere\",\"position\":[2.4,0.5,0]}").is_ok())
    assert(play.upsert(&mut scene, "{\"name\":\"flower\",\"role\":\"flower\",\"shape\":\"sphere\",\"position\":[0,0.5,0]}").is_ok())
    mut bouquet := play.start(&scene)
    walk(&mut bouquet, 0.0, 0.0, 1)
    assert(bouquet.won && bouquet.flowers == 1 && bouquet.butterflies == 0)
    walk(&mut bouquet, 1.0, 0.0, 30)
    assert(bouquet.won && bouquet.butterflies == 1 && bouquet.last_butterfly == 2)
    picked := bouquet.butterfly_tick
    walk(&mut bouquet, 0.0, 0.0, 4)
    assert(bouquet.butterflies == 1 && bouquet.butterfly_tick == picked)
    assert(play.remove(&mut scene, "flower").is_ok())
    mut solo := play.start(&scene)
    walk(&mut solo, 0.0, 0.0, 1)
    assert(!solo.won)
    walk(&mut solo, 1.0, 0.0, 30)
    assert(solo.won && solo.butterflies == solo.total_butterflies)
}

@test fn cloud_authoring_requires_a_static_box_and_butterflies_are_static_sensors() {
    mut scene := play.empty("Clouds")
    for role in ["cloud", "boost_cloud"] {
        assert(play.upsert(&mut scene, "{\"name\":\"pad\",\"shape\":\"sphere\",\"role\":\"" + role + "\"}").is_err())
        assert(play.upsert(&mut scene, "{\"name\":\"pad\",\"shape\":\"box\",\"role\":\"" + role + "\",\"mass\":1}").is_err())
        assert(play.upsert(&mut scene, "{\"name\":\"pad\",\"shape\":\"box\",\"role\":\"" + role + "\"}").is_ok())
    }
    assert(play.upsert(&mut scene, "{\"name\":\"w\",\"shape\":\"sphere\",\"role\":\"super_butterfly\",\"mass\":2}").is_err())
    assert(play.upsert(&mut scene, "{\"name\":\"w\",\"shape\":\"box\",\"role\":\"super_butterfly\"}").is_ok())
    encoded := play.encode(&scene)
    assert(play.encode(&play.decode(encoded).unwrap()) == encoded)
}

@test fn spawning_on_a_cloud_has_an_immediate_support_and_only_a_spring_launches_the_fox() {
    mut level := play.demo()
    for index in [11, 15] {
        pad := level.entities[index].clone()
        level.entities[1].position = core.vec3(pad.position.x + 0.4, pad.position.y + pad.size.y * 0.5 + 0.4, pad.position.z)
        mut s := play.start(&level)
        assert(play.render_motion(&s, true).grounded && play.render_platform(&s, true) == index)
        height := play.position(&s, 1).y
        play.step(&mut s, play.Input { x: 0.0, z: 0.0, jump: false })
        if pad.role == .Cloud {
            assert(s.last_cloud == -1 && play.render_platform(&s, true) == index)
            assert((play.position(&s, 1).y - height).abs() < 0.00001)
            play.step(&mut s, play.Input { x: 0.0, z: 0.0, jump: true })
            assert(play.render_platform(&s, false) == index && play.render_platform(&s, true) == -1)
        } else {
            assert(s.last_cloud == index && play.render_motion(&s, true).boost_age == 0.0)
            assert(play.render_motion(&s, true).vertical_velocity > 8.0)
        }
    }
}
