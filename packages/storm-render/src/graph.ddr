// Storm frame graph: a typed pass list with resource dependencies.
//
// A pass is declared with a `PassKind`, the resources it writes and the ones it
// reads. `compile()` validates the graph (unknown kind name, duplicate pass) and
// returns the passes in an order where every producer runs before its
// consumers; disabled passes (and the reads of them) drop out.
//
//   mut graph := graph.Graph::new()
//   _ := graph.add_pass(.Shadow, "shadow", ["shadow_map"], [])
//   _ := graph.add_pass(.Opaque, "opaque", ["color", "depth"], ["shadow_map"])
//   compiled := graph.compile()
//   for i in 0..compiled.order.len { compiled.order[i].kind }   // Shadow, Opaque
//
// The graph owns ORDER and EXISTENCE; it does not know Vulkan. The frame
// executor maps each `PassKind` to GPU work. Keeping that split means the
// schedule is testable without a device, and a toggle can remove a pass (and
// everything that depended on it) instead of leaving a no-op in the frame.

pub enum PassKind {
    Shadow = 0,
    Sky = 1,
    Opaque = 2,
    Transparent = 3,
    Overlay = 4,
    Ui = 5,
}

pub struct Pass {
    kind: PassKind,
    name: string,
    writes: []string,
    reads: []string,
    enabled: bool,
}

// One entry of a compiled schedule: what to run, and under which name.
pub struct Step {
    kind: PassKind,
    name: string,
}

pub struct Compiled {
    ok: bool,
    error: string,
    steps: []Step,
}

fn find_pass(passes: &[]Pass, name: &string) -> i32 {
    for i in 0..passes.len {
        if passes[i].name == name { return i }
    }
    -1
}

pub struct Graph {
    passes: []Pass,
}

impl Graph {
    pub fn new() -> Self { Self { passes: [] } }

    pub fn len(&self) -> i32 { self.passes.len }

    pub fn add_pass(&mut self, kind: PassKind, move name: string, move writes: []string, move reads: []string) -> bool {
        if name == "" { return false }
        if find_pass(&self.passes, &name) >= 0 { return false }
        self.passes.push(Pass { kind: kind, name: name, writes: writes, reads: reads, enabled: true })
        true
    }

    pub fn disable(&mut self, name: string) -> bool {
        index := find_pass(&self.passes, &name)
        if index < 0 { return false }
        self.passes[index].enabled = false
        true
    }

    pub fn enable(&mut self, name: string) -> bool {
        index := find_pass(&self.passes, &name)
        if index < 0 { return false }
        self.passes[index].enabled = true
        true
    }

    pub fn is_enabled(&self, name: string) -> bool {
        index := find_pass(&self.passes, &name)
        if index < 0 { return false }
        self.passes[index].enabled
    }

    pub fn pass_at(&self, index: i32) -> &Pass from self { &self.passes[index] }

    // DFS post-order over "latest earlier writer" edges. A read resolves to the
    // most recent preceding ENABLED pass that writes the resource, so
    // declaration order is the tie-breaker and cycles cannot form. A read with
    // no earlier enabled writer means "external input" (a texture, the
    // swapchain) and adds no edge — so disabling a producer does not make its
    // consumers disappear; they simply read whatever is bound there.
    pub fn compile(&self) -> Compiled {
        mut steps: []Step = []
        mut state: []i32 = []
        for _ in 0..self.passes.len { state.push(0) }
        for i in 0..self.passes.len {
            if !self.passes[i].enabled { continue }
            visited := self.visit(i, &mut state, &mut steps)
            if !visited.ok { return Compiled { ok: false, error: visited.error, steps: [] } }
        }
        Compiled { ok: true, error: "", steps: steps }
    }

    fn visit(&self, index: i32, state: &mut []i32, steps: &mut []Step) -> Compiled {
        if state[index] == 2 { return Compiled { ok: true, error: "", steps: [] } }
        state[index] = 1
        for r in 0..self.passes[index].reads.len {
            resource := &self.passes[index].reads[r]
            mut producer := -1
            for candidate in 0..index {
                if !self.passes[candidate].enabled { continue }
                if writes_resource(&self.passes[candidate], resource) { producer = candidate }
            }
            if producer >= 0 {
                dependency := self.visit(producer, &mut state, &mut steps)
                if !dependency.ok { return dependency }
            }
        }
        if state[index] == 2 { return Compiled { ok: true, error: "", steps: [] } }
        state[index] = 2
        steps.push(Step { kind: self.passes[index].kind, name: self.passes[index].name.clone() })
        Compiled { ok: true, error: "", steps: [] }
    }
}

fn writes_resource(pass: &Pass, resource: &string) -> bool {
    for i in 0..pass.writes.len {
        if pass.writes[i] == resource { return true }
    }
    false
}

// True when the schedule satisfies every "latest earlier writer" edge: a
// pass's reads resolve to the most recent preceding enabled declaration that
// writes the resource, and that writer must appear earlier in the schedule.
pub fn respects_dependencies(compiled: &Compiled, passes: &[]Pass) -> bool {
    for o in 0..compiled.steps.len {
        index := find_pass(passes, &compiled.steps[o].name)
        if index < 0 { return false }
        for r in 0..passes[index].reads.len {
            resource := &passes[index].reads[r]
            mut producer := -1
            for candidate in 0..index {
                if !passes[candidate].enabled { continue }
                if writes_resource(&passes[candidate], resource) { producer = candidate }
            }
            if producer < 0 { continue }
            mut seen := false
            for k in 0..o {
                if compiled.steps[k].name == passes[producer].name { seen = true }
            }
            if !seen { return false }
        }
    }
    true
}
