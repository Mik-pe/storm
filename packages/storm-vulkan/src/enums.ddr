    Never = 0, Less = 1, Equal = 2, LessOrEqual = 3, Greater = 4, NotEqual = 5,
    GreaterOrEqual = 6, Always = 7,
}

pub fn compare_op(v: CompareOp) -> u32 { u32(i32(v)) }

