pub enum ShaderStage {
    Vertex = 1, Fragment = 16, VertexFragment = 17, // VERTEX | FRAGMENT
}

pub fn shader_stage(v: ShaderStage) -> u32 { u32(i32(v)) }

pub enum ImageUsage {
    TransferSrc = 1, TransferDst = 2, Sampled = 4, ColorAttachment = 16,
    DepthStencilAttachment = 32,
    // Combined sets Storm builds images with (flags, so written as sums).
    ColorAttachmentTransferSrc = 17,
    ColorAttachmentSampled = 20, // COLOR_ATTACHMENT | SAMPLED: env/irradiance cubes
    TransferDstSampled = 6, // TRANSFER_DST | SAMPLED: uploaded BRDF LUT
}

pub fn image_usage(v: ImageUsage) -> u32 { u32(i32(v)) }

pub enum BufferUsage {
    TransferSrc = 1, TransferDst = 2, UniformBuffer = 16, VertexBuffer = 128,
}

pub fn buffer_usage(v: BufferUsage) -> u32 { u32(i32(v)) }

pub enum ImageCreate {
    MutableFormat = 8, CubeCompatible = 16,
}

pub fn image_create(v: ImageCreate) -> u32 { u32(i32(v)) }

