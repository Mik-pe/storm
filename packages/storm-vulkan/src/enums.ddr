pub enum ImageLayout {
    Undefined = 0, General = 1, ColorAttachmentOptimal = 2, DepthStencilAttachmentOptimal = 3,
    DepthStencilReadOnlyOptimal = 4, ShaderReadOnlyOptimal = 5, TransferSrcOptimal = 6,
    TransferDstOptimal = 7,
}

pub fn image_layout(v: ImageLayout) -> u32 { u32(i32(v)) }

pub enum AttachmentLoadOp {
    Load = 0, Clear = 1, DontCare = 2,
}

pub fn attachment_load_op(v: AttachmentLoadOp) -> u32 { u32(i32(v)) }

pub enum AttachmentStoreOp {
    Store = 0, DontCare = 1,
}

pub fn attachment_store_op(v: AttachmentStoreOp) -> u32 { u32(i32(v)) }

pub enum PipelineBindPoint {
    Graphics = 0, Compute = 1,
}

pub fn pipeline_bind_point(v: PipelineBindPoint) -> u32 { u32(i32(v)) }

pub enum DescriptorType {
    Sampler = 0, CombinedImageSampler = 1, SampledImage = 2, StorageImage = 3,
    UniformTexelBuffer = 4, StorageTexelBuffer = 5, UniformBuffer = 6, StorageBuffer = 7,
}

pub fn descriptor_type(v: DescriptorType) -> u32 { u32(i32(v)) }

// One VkDescriptorSetLayoutBinding is 24 bytes = three u64 words on x86-64:
// [binding | descriptorType<<32], [descriptorCount | stageFlags<<32], [samplers].
// Pack through these so neither the type nor the stage is an integer at the call site.
pub fn binding_word(binding: u32, kind: DescriptorType) -> u64 {
    u64(binding) + (u64(descriptor_type(kind)).shl(32))
}

pub fn stages_word(count: u32, stages: ShaderStage) -> u64 {
    u64(count) + (u64(shader_stage(stages)).shl(32))
}

pub enum PipelineStage {
    None = 0, TopOfPipe = 1, VertexInput = 4, VertexShader = 8, FragmentShader = 128,
    EarlyFragmentTests = 256, LateFragmentTests = 512, ColorAttachmentOutput = 1024,
    ColorAndDepthStages = 1792, // COLOR_ATTACHMENT_OUTPUT | EARLY_FRAGMENT_TESTS | LATE_FRAGMENT_TESTS
    Transfer = 4096, BottomOfPipe = 8192, Host = 16384, AllGraphics = 32768, AllCommands = 65536,
}

pub fn pipeline_stage(v: PipelineStage) -> u32 { u32(i32(v)) }

pub enum VertexInputRate { Vertex = 0, Instance = 1 }

pub fn vertex_input_rate(v: VertexInputRate) -> u32 { u32(i32(v)) }

// VK_SUBPASS_EXTERNAL: the implicit subpass before/after the render pass.
pub const SUBPASS_EXTERNAL: u32 = 4294967295

