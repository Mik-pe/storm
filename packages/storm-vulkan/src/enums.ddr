// Vk enums as Dunder enums, with the only converters to C integers in the
// package. A @c_layout record keeps its u32 field; the caller writes
// `attachment.srcColorBlendFactor = enums.blend_factor(.SrcAlpha)` and there is
// no way to spell ONE_MINUS_DST_COLOR by mistake. Values are the Khronos ones
// (docs.vulkan.org/refpages), read, not recited.
//
// Flag-like enums (ShaderStage, ImageUsage, BufferUsage) carry the combined
// variants Storm needs as named values instead of bit operations.

capability unsafe

import .layout as layout

pub enum BlendFactor {
    Zero = 0, One = 1, SrcColor = 2, OneMinusSrcColor = 3, DstColor = 4, OneMinusDstColor = 5,
    SrcAlpha = 6, OneMinusSrcAlpha = 7, DstAlpha = 8, OneMinusDstAlpha = 9,
}

pub fn blend_factor(v: BlendFactor) -> u32 { u32(i32(v)) }

pub enum BlendOp {
    Add = 0, Subtract = 1, ReverseSubtract = 2, Min = 3,
    Max = 4, // keep the surface closest to the sun
}

pub fn blend_op(v: BlendOp) -> u32 { u32(i32(v)) }

pub enum Filter {
    Nearest = 0, Linear = 1,
}

pub fn filter(v: Filter) -> u32 { u32(i32(v)) }

pub enum SamplerMipmapMode {
    Nearest = 0, Linear = 1,
}

pub fn sampler_mipmap_mode(v: SamplerMipmapMode) -> u32 { u32(i32(v)) }

pub enum SamplerAddressMode {
    Repeat = 0, MirroredRepeat = 1, ClampToEdge = 2, ClampToBorder = 3,
}

pub fn sampler_address_mode(v: SamplerAddressMode) -> u32 { u32(i32(v)) }

