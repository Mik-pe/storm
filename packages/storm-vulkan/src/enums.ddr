    Type1D = 0, Type2D = 1, Type3D = 2, Cube = 3, Type1DArray = 4, Type2DArray = 5,
    CubeArray = 6,
}

pub fn image_view_type(v: ImageViewType) -> u32 { u32(i32(v)) }

