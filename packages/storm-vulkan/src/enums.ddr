    Signaled = 1,
}

pub fn fence(v: Fence) -> u32 { u32(i32(v)) }

pub enum ColorComponent {
    RGBA = 15, // R | G | B | A
}

pub fn color_component(v: ColorComponent) -> u32 { u32(i32(v)) }

pub enum Samples {
    Type1 = 1,
}

pub fn samples(v: Samples) -> u32 { u32(i32(v)) }

pub enum Format {
    Undefined = 0, R8G8B8A8_UNORM = 37, R8G8B8A8_SRGB = 43, R16G16_SFLOAT = 83, R16G16B16A16_SFLOAT = 97,
    R32_SFLOAT = 100, R32G32_SFLOAT = 103, B8G8R8A8_UNORM = 44, B8G8R8A8_SRGB = 50,
    D32_SFLOAT = 126,
}

pub fn format(v: Format) -> u32 { u32(i32(v)) }

// Extension enum values Storm compares against, as named constants (they are
// not ordinal enums with a Dunder type of their own).
pub const IMAGE_LAYOUT_PRESENT_SRC_KHR: u32 = 1000001002
pub const ERROR_OUT_OF_DATE_KHR: i32 = -1000001003
pub const SUCCESS: i32 = 0

pub enum Access {
    None = 0, IndirectCommandRead = 1, IndexRead = 2, VertexAttributeRead = 4, UniformRead = 8,
    InputAttachmentRead = 16, ShaderRead = 32, ShaderWrite = 64, ColorAttachmentRead = 128,
    ColorAttachmentWrite = 256, DepthStencilAttachmentRead = 512, DepthStencilAttachmentWrite = 1024,
    TransferRead = 2048, TransferWrite = 4096, HostRead = 8192, HostWrite = 16384,
    MemoryRead = 32768, MemoryWrite = 65536,
    // Combined masks Storm's barriers use.
    ColorDepthWrite = 1280, // COLOR_ATTACHMENT_WRITE | DEPTH_STENCIL_ATTACHMENT_WRITE
}

pub fn access(v: Access) -> u32 { u32(i32(v)) }

// Formats the headless reader can unpack into PPM (8-bit RGBA/BGRA, UNORM or
// SRGB). Anything else is refused before a byte is read.
pub fn format_has_bytes(value: u32) -> bool {
    value == format(.R8G8B8A8_UNORM) || value == format(.R8G8B8A8_SRGB) ||
    value == format(.B8G8R8A8_UNORM) || value == format(.B8G8R8A8_SRGB)
}

// True for the BGRA swapchain formats, where red and blue sit swapped.
pub fn format_is_bgra(value: u32) -> bool {
    value == format(.B8G8R8A8_UNORM) || value == format(.B8G8R8A8_SRGB)
}

// A blend state as a value. Pipelines pick one of the named blends below
// instead of assigning five integers; apply_blend is the only writer of the
// C record's blend fields.
pub struct Blend {
    color_op: BlendOp,
    src_color: BlendFactor,
    dst_color: BlendFactor,
    src_alpha: BlendFactor,
    dst_alpha: BlendFactor,
}

// Dunder `const` cannot hold a struct (E3007, even one of plain u32), so the
// named blends are functions returning the value.
pub fn alpha_over() -> Blend {
    Blend {
        color_op: .Add, src_color: .SrcAlpha, dst_color: .OneMinusSrcAlpha,
        src_alpha: .One, dst_alpha: .OneMinusSrcAlpha,
    }
}

// Shadow map: keep whichever fragment is closest to the light.
pub fn shadow_max() -> Blend {
    Blend {
        color_op: .Max, src_color: .One, dst_color: .One,
        src_alpha: .One, dst_alpha: .One,
    }
}

pub unsafe fn apply_blend(attachment: &mut layout.PipelineColorBlendAttachmentState, blend: &Blend) {
    attachment.blendEnable = 1
    attachment.srcColorBlendFactor = blend_factor(blend.src_color)
    attachment.dstColorBlendFactor = blend_factor(blend.dst_color)
    attachment.colorBlendOp = blend_op(blend.color_op)
    attachment.srcAlphaBlendFactor = blend_factor(blend.src_alpha)
    attachment.dstAlphaBlendFactor = blend_factor(blend.dst_alpha)
    attachment.alphaBlendOp = blend_op(blend.color_op)
    attachment.colorWriteMask = color_component(.RGBA)
}
