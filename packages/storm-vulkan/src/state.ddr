capability unsafe

import vk.api as vk
import .depth as depth
import .headless as headless
import .ibl as ibl
import .post as post
import vk.layout as vkl
import .sdl as sdl
import .shadow as shadow
import .texture as texture
import .ui as ui

@c_layout
pub struct Buffer {
    handle: ptr,
    memory: ptr,
    mapped: ptr,
    capacity: u64,
}

@c_layout
pub struct Limits {
    maxImageDimension1D: u32, maxImageDimension2D: u32, maxImageDimension3D: u32,
    maxImageDimensionCube: u32, maxImageArrayLayers: u32, maxTexelBufferElements: u32,
    maxUniformBufferRange: u32, maxStorageBufferRange: u32, maxPushConstantsSize: u32,
    rest: [u64; 128],
}

@c_layout
pub struct Properties {
    apiVersion: u32, driverVersion: u32, vendorID: u32, deviceID: u32, deviceType: u32,
    deviceName: [u8; 256],
    pipelineCacheUUID: [u8; 16],
    limits: Limits,
}

pub const FRAME_COUNT: i32 = 2
// mvp(64) model(64) base_color(16) params(16) camera(16) emissive_factor(16).
pub const MESH_PUSH_BYTES: u32 = 192

// Which setup step failed. It is the return value of every setup function,
// so a step cannot exist without a name: `name` matches exhaustively and the
// compiler rejects a new variant without one (E3006). `.Ready` means no step
// failed.
pub enum SetupStep {
    Ready, Window, Instance, PhysicalDevice, QueueFamily, Device, Format, Swapchain,
    Shadow, Pipeline, PostProcess, Ui, DepthBuffer, FrameSync, VertexBuffer,
    Environment, CaptureTarget, Texture,
}

impl SetupStep {
    pub fn name(&self) -> string {
        match self {
            .Ready => "ready",
            .Window => "SDL window",
            .Instance => "instance/surface",
            .PhysicalDevice => "physical device (mesh requires " + MESH_PUSH_BYTES.str() + " bytes of push constants)",
            .QueueFamily => "queue family",
            .Device => "logical device",
            .Format => "surface format",
            .Swapchain => "swapchain",
            .Shadow => "shadow pass",
            .Pipeline => "pipeline",
            .PostProcess => "post-process pipeline or scene texture",
            .Ui => "UI atlas and pipeline",
            .DepthBuffer => "depth buffer",
            .FrameSync => "frame sync",
            .VertexBuffer => "vertex buffer",
            .Environment => "environment maps",
            .CaptureTarget => "capture target",
            .Texture => "material textures",
        }
    }
}

// What the renderer is recording right now. The field is a `u32` because an
// enum may not live in a C layout (E5003), but nothing reads or writes it
// except `pass()` and `set_pass()`: `pass()` converts through the enum, so a
// number nobody wrote ends the program (status 108) instead of never matching.
pub enum Pass { Idle = 0, Waiting = 1, Shadow = 2, Direct = 3, Filtered = 4, Composite = 5 }

pub unsafe fn pass(r: &Renderer) -> Pass { Pass(i32(r.pass)) }

pub fn set_pass(r: &mut Renderer, which: Pass) { r.pass = u32(i32(which)) }

// Whether the frame being recorded is an offscreen capture, and whether its
// pixels have been read back. Same shape as `Pass`: an integer field that only
// `capture()` and `set_capture()` touch. `Off` is 0 because the registry
// calloc's the renderer, and `destroy` returns to it.
pub enum Capture { Off = 0, Recording = 1, Ready = 2 }

pub unsafe fn capture(r: &Renderer) -> Capture { Capture(i32(r.captureOn)) }

pub fn set_capture(r: &mut Renderer, which: Capture) { r.captureOn = i32(which) }

@c_layout
pub struct SampledTexture { sampler: ptr, layout: ptr, pool: ptr, set: ptr }

// All mutable renderer state lives behind one heap allocation. Public handles
// carry only a generation; this struct never escapes the module.
@c_layout
pub struct Renderer {
    api: vk.Api,
    loader: ptr,
    instance: ptr,
    surface: ptr,
    physical: ptr,
    device: ptr,
    queue: ptr,
    family: u32,
    properties: Properties,
    // The registry's VkPhysicalDeviceMemoryProperties, read once at device
    // selection: device.allocate walks memoryTypes[] for the first type a
    // requirement allows that has the wanted properties.
    memoryProperties: vkl.PhysicalDeviceMemoryProperties,
    pool: ptr,
    commands: [ptr; 2],
    fences: [ptr; 2],
    image_available: [ptr; 2],
    // Presentation owns its wait semaphore until the same image is acquired again.
    render_finished: [ptr; 8],
    current: i32,
    swapchain: ptr,
    format: u32,
    colorSpace: u32,
    width: u32,
    height: u32,
    imageCount: i32,
    images: [ptr; 8],
    views: [ptr; 8],
    renderPass: ptr,
    pipelineLayout: ptr,
    pipeline: ptr,
    vertexShader: ptr,
    fragmentShader: ptr,
    skyPipelineLayout: ptr,
    skyPipeline: ptr,
    transparentPipeline: ptr,
    skyVertexShader: ptr,
    skyFragmentShader: ptr,
    framebuffers: [ptr; 8],
    // Depth attachment, recreated together with the swapchain.
    depth: depth.Depth,
    // The sun's shadow map (shadow.ddr). The set and its layout are bound by
    // the main pass, the mesh pipelines and the environment maps, so they
    // stay here; the rest of the cluster is `shadow.Shadow`.
    shadow: shadow.Shadow,
    shadowSetLayout: ptr,
    shadowSet: ptr,
    // Image-based lighting: built once at startup from the sky.
    environment: ibl.Environment,

    // Offscreen scene target and the post-process stage (post.ddr). The set
    // and its layout are bound by other modules, so they stay here; the rest
    // of the cluster is `post.Stage`.
    sceneFramebuffer: ptr,
    scenePass: ptr,
    compositePass: ptr,
    post: post.Stage,
    captureFramebuffer: ptr,
    // Text and UI.
    atlas: ui.Atlas,
    vertex: Buffer,
    meshSetLayouts: [ptr; 2],
    // Material textures (texture.ddr): set 1 of the mesh pipeline.
    material: texture.Material,
    window: sdl.Window,
    frameIndex: i64,
    trace: u32,
    // Read through `pass()`, written through `set_pass()` only.
    pass: u32,
    resizePending: u32,
    pendingPass: vkl.RenderPassBeginInfo,
    pendingClear: [u64; 4],
    lastResult: i32,
    imageIndex: i32,
    // Capture is rendered on the GPU, then copied into a tightly packed mapped
    // buffer (headless.ddr). Whether a capture is being recorded is frame
    // state and stays here, behind `capture()`/`set_capture()`.
    capture: headless.Capture,
    // Read through `capture()`, written through `set_capture()` only.
    captureOn: i32,
    // Append cursor for the shared vertex buffer: every recorded draw keeps its
    // own slice, so later uploads cannot overwrite earlier geometry.
    vertexCursor: u64,
}
