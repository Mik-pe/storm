capability unsafe

import .api as vk
import .depth as depth
import .ibl as ibl
import .layout as vkl
import .sdl as sdl
import .texture as texture
import .ui as ui

@c_layout
pub struct Buffer {
    handle: ptr,
    memory: ptr,
    mapped: ptr,
    capacity: u64,
}

@c_layout
pub struct Limits {
    maxImageDimension1D: u32, maxImageDimension2D: u32, maxImageDimension3D: u32,
    maxImageDimensionCube: u32, maxImageArrayLayers: u32, maxTexelBufferElements: u32,
    maxUniformBufferRange: u32, maxStorageBufferRange: u32, maxPushConstantsSize: u32,
    rest: [u64; 128],
}

@c_layout
pub struct Properties {
    apiVersion: u32, driverVersion: u32, vendorID: u32, deviceID: u32, deviceType: u32,
    deviceName: [u8; 256],
    pipelineCacheUUID: [u8; 16],
    limits: Limits,
}

@c_layout
pub struct MemoryProperties {
    typeCount: u32,
    // 32 VkMemoryType entries: propertyFlags then heapIndex, 8 bytes each.
    types: [u32; 64],
    heapCount: u32,
    // 32 VkMemoryHeap entries: u64 size then u32 flags, padded to 16 bytes each.
    heaps: [u64; 64],
}

pub const FRAME_COUNT: i32 = 2
pub const MESH_PUSH_BYTES: u32 = 240

// Which setup step failed. It is the return value of every setup function,
// so a step cannot exist without a name: `name` matches exhaustively and the
// compiler rejects a new variant without one (E3006). `.Ready` means no step
// failed.
pub enum SetupStep {
    Ready, Window, Instance, PhysicalDevice, QueueFamily, Device, Format, Swapchain,
    Shadow, Pipeline, PostProcess, Ui, DepthBuffer, FrameSync, VertexBuffer,
    Environment, CaptureTarget, Texture,
}

impl SetupStep {
    pub fn name(&self) -> string {
        match self {
            .Ready => "ready",
            .Window => "SDL window",
            .Instance => "instance/surface",
            .PhysicalDevice => "physical device (mesh requires " + MESH_PUSH_BYTES.str() + " bytes of push constants)",
            .QueueFamily => "queue family",
            .Device => "logical device",
            .Format => "surface format",
            .Swapchain => "swapchain",
            .Shadow => "shadow pass",
            .Pipeline => "pipeline",
            .PostProcess => "post-process pipeline or scene texture",
            .Ui => "UI atlas and pipeline",
            .DepthBuffer => "depth buffer",
            .FrameSync => "frame sync",
            .VertexBuffer => "vertex buffer",
            .Environment => "environment maps",
            .CaptureTarget => "capture target",
            .Texture => "material textures",
        }
    }
}

pub const PASS_IDLE: u32 = 0
pub const PASS_WAITING: u32 = 1
pub const PASS_SHADOW: u32 = 2
pub const PASS_DIRECT: u32 = 3
pub const PASS_FILTERED: u32 = 4
pub const PASS_COMPOSITE: u32 = 5

@c_layout
pub struct SampledTexture { sampler: ptr, layout: ptr, pool: ptr, set: ptr }

// All mutable renderer state lives behind one heap allocation. Public handles
// carry only a generation; this struct never escapes the module.
@c_layout
pub struct Renderer {
    api: vk.Api,
    loader: ptr,
    instance: ptr,
    surface: ptr,
    physical: ptr,
    device: ptr,
    queue: ptr,
    family: u32,
    properties: Properties,
    memoryProperties: MemoryProperties,
    pool: ptr,
    commands: [ptr; 2],
    fences: [ptr; 2],
    image_available: [ptr; 2],
    // Presentation owns its wait semaphore until the same image is acquired again.
    render_finished: [ptr; 8],
    current: i32,
    swapchain: ptr,
    format: u32,
    colorSpace: u32,
    width: u32,
    height: u32,
    imageCount: i32,
    images: [ptr; 8],
    views: [ptr; 8],
    renderPass: ptr,
    pipelineLayout: ptr,
    pipeline: ptr,
    vertexShader: ptr,
    fragmentShader: ptr,
    skyPipelineLayout: ptr,
    skyPipeline: ptr,
    transparentPipeline: ptr,
    skyVertexShader: ptr,
    skyFragmentShader: ptr,
    framebuffers: [ptr; 8],
    // Depth attachment, recreated together with the swapchain.
    depth: depth.Depth,
    shadowInitialized: u32,
    shadowImage: ptr,
    shadowMemory: ptr,
    shadowView: ptr,
    shadowSampler: ptr,
    shadowPass: ptr,
    shadowFramebuffer: ptr,
    shadowPipeline: ptr,
    shadowPipelineLayout: ptr,
    shadowSetLayout: ptr,
    shadowPool: ptr,
    shadowSet: ptr,
    lightBuffer: ptr,
    lightMemory: ptr,
    lightMapped: ptr,
    shadowVertShader: ptr,
    shadowFragShader: ptr,
    // Image-based lighting: built once at startup from the sky.
    environment: ibl.Environment,

    // Offscreen scene target and the post-process stage.
    sceneImage: ptr,
    sceneMemory: ptr,
    sceneView: ptr,
    sceneSampleView: ptr,
    sceneFramebuffer: ptr,
    scenePass: ptr,
    compositePass: ptr,
    postPipeline: ptr,
    postPipelineLayout: ptr,
    postTexture: SampledTexture,
    postVertShader: ptr,
    postFragShader: ptr,
    captureFramebuffer: ptr,
    // Text and UI.
    atlas: ui.Atlas,
    vertex: Buffer,
    meshSetLayouts: [ptr; 2],
    // Material textures (texture.ddr): set 1 of the mesh pipeline.
    material: texture.Material,
    window: sdl.Window,
    frameIndex: i64,
    trace: u32,
    pass: u32,
    resizePending: u32,
    pendingPass: vkl.RenderPassBeginInfo,
    pendingClear: [u64; 4],
    lastResult: i32,
    imageIndex: i32,
    // Capture is rendered on the GPU, then copied into a tightly packed mapped buffer.
    captureImage: ptr,
    captureView: ptr,
    captureMemory: ptr,
    readback: Buffer,
    captureOn: i32,
    // Append cursor for the shared vertex buffer: every recorded draw keeps its
    // own slice, so later uploads cannot overwrite earlier geometry.
    vertexCursor: u64,
}
