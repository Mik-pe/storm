capability unsafe

import .api as vk
import .layout as vkl
import .sdl as sdl

@c_layout
pub struct Buffer {
    handle: ptr,
    memory: ptr,
    mapped: ptr,
    capacity: u64,
}

@c_layout
pub struct Limits {
    maxImageDimension1D: u32, maxImageDimension2D: u32, maxImageDimension3D: u32,
    maxImageDimensionCube: u32, maxImageArrayLayers: u32, maxTexelBufferElements: u32,
    maxUniformBufferRange: u32, maxStorageBufferRange: u32, maxPushConstantsSize: u32,
    rest: [u64; 128],
}

@c_layout
pub struct Properties {
    apiVersion: u32, driverVersion: u32, vendorID: u32, deviceID: u32, deviceType: u32,
    deviceName: [u8; 256],
    pipelineCacheUUID: [u8; 16],
    limits: Limits,
}

@c_layout
pub struct MemoryProperties {
    typeCount: u32,
    // 32 VkMemoryType entries: propertyFlags then heapIndex, 8 bytes each.
    types: [u32; 64],
    heapCount: u32,
    // 32 VkMemoryHeap entries: u64 size then u32 flags, padded to 16 bytes each.
    heaps: [u64; 64],
}

pub const FRAME_COUNT: i32 = 2
pub const MESH_PUSH_BYTES: u32 = 240

// Which setup step failed. It is the return value of every setup function,
// so a step cannot exist without a name: `name` matches exhaustively and the
// compiler rejects a new variant without one (E3006). `.Ready` means no step
// failed.
pub enum SetupStep {
    Ready, Window, Instance, PhysicalDevice, QueueFamily, Device, Format, Swapchain,
    Shadow, Pipeline, Overlay, Ui, DepthBuffer, FrameSync, VertexBuffer,
    Environment, CaptureTarget,
}

impl SetupStep {
    pub fn name(&self) -> string {
        match self {
            .Ready => "ready",
            .Window => "SDL window",
            .Instance => "instance/surface",
            .PhysicalDevice => "physical device (mesh requires " + MESH_PUSH_BYTES.str() + " bytes of push constants)",
            .QueueFamily => "queue family",
            .Device => "logical device",
            .Format => "surface format",
            .Swapchain => "swapchain",
            .Shadow => "shadow pass",
            .Pipeline => "pipeline",
            .Overlay => "overlay (post) pipeline",
            .Ui => "UI atlas and pipeline",
            .DepthBuffer => "depth buffer",
            .FrameSync => "frame sync",
            .VertexBuffer => "vertex buffer",
            .Environment => "environment maps",
            .CaptureTarget => "capture target",
        }
    }
}

// All mutable renderer state lives behind one heap allocation. Public handles
// carry only a generation; this struct never escapes the module.
@c_layout
pub struct Renderer {
    api: vk.Api,
    loader: ptr,
    instance: ptr,
    surface: ptr,
    physical: ptr,
    device: ptr,
    queue: ptr,
    family: u32,
    properties: Properties,
    memoryProperties: MemoryProperties,
    debugMessenger: ptr,
    pool: ptr,
    commands: [ptr; 2],
    fences: [ptr; 2],
    image_available: [ptr; 2],
    render_finished: [ptr; 2],
    current: i32,
    swapchain: ptr,
    format: u32,
    colorSpace: u32,
    width: u32,
    height: u32,
    imageCount: i32,
    images: [ptr; 8],
    views: [ptr; 8],
    renderPass: ptr,
    pipelineLayout: ptr,
    pipeline: ptr,
    vertexShader: ptr,
    fragmentShader: ptr,
    skyPipelineLayout: ptr,
    skyPipeline: ptr,
    transparentPipeline: ptr,
    skyVertexShader: ptr,
    skyFragmentShader: ptr,
    framebuffers: [ptr; 8],
    // Depth attachment, recreated together with the swapchain.
    depthImage: ptr,
    depthMemory: ptr,
    depthView: ptr,
    shadowImage: ptr,
    shadowMemory: ptr,
    shadowView: ptr,
    shadowSampler: ptr,
    shadowPass: ptr,
    shadowFramebuffer: ptr,
    shadowPipeline: ptr,
    shadowPipelineLayout: ptr,
    shadowSetLayout: ptr,
    shadowPool: ptr,
    shadowSet: ptr,
    lightBuffer: ptr,
    lightMemory: ptr,
    lightMapped: ptr,
    shadowVertShader: ptr,
    shadowFragShader: ptr,
    // Image-based lighting: prefiltered env cube (6 mips), irradiance cube,
    // BRDF LUT, their samplers and the one-time build's pipelines and sets.
    envImage: ptr,
    envMemory: ptr,
    envView: ptr,
    envSampler: ptr,
    envMipViews: [ptr; 6],
    envFaceViews: [ptr; 36],
    envFramebuffers: [ptr; 36],
    irradianceImage: ptr,
    irradianceMemory: ptr,
    irradianceView: ptr,
    irradianceSampler: ptr,
    irradianceFaceViews: [ptr; 6],
    irradianceFramebuffers: [ptr; 6],
    brdfImage: ptr,
    brdfMemory: ptr,
    brdfView: ptr,
    brdfSampler: ptr,
    iblPass: ptr,
    iblPipelineLayout: ptr,
    iblSetLayout: ptr,
    iblPool: ptr,
    iblSets: [ptr; 6],
    envPipeline: ptr,
    prefilterPipelines: [ptr; 6],
    irradiancePipeline: ptr,
    // Offscreen scene target and the post-process stage.
    sceneImage: ptr,
    sceneMemory: ptr,
    sceneMapped: ptr,
    sceneView: ptr,
    postPresentPass: ptr,
    postCapturePass: ptr,
    postPipeline: ptr,
    postCapturePipeline: ptr,
    postPipelineLayout: ptr,
    postSetLayout: ptr,
    postPool: ptr,
    postSet: ptr,
    postSampler: ptr,
    postVertShader: ptr,
    postFragShader: ptr,
    presentFramebuffers: [ptr; 8],
    captureFramebuffer: ptr,
    // Text and UI.
    uiPipeline: ptr,
    uiCapturePipeline: ptr,
    uiPipelineLayout: ptr,
    uiSetLayout: ptr,
    uiPool: ptr,
    uiSet: ptr,
    uiSampler: ptr,
    uiAtlasImage: ptr,
    uiAtlasMemory: ptr,
    uiAtlasMapped: ptr,
    uiAtlasView: ptr,
    uiVertex: Buffer,
    uiCursor: u64,
    uiVertShader: ptr,
    uiFragShader: ptr,
    vertex: Buffer,
    window: sdl.Window,
    frameIndex: i64,
    trace: u32,
    recording: u32,
    pendingPass: vkl.RenderPassBeginInfo,
    pendingClear: [u64; 4],
    lastResult: i32,
    imageIndex: i32,
    // Headless capture: offscreen render target plus a mapped linear copy.
    offscreenImage: ptr,
    offscreenView: ptr,
    offscreenPass: ptr,
    offscreenFramebuffer: ptr,
    linearImage: ptr,
    linearMemory: ptr,
    linearMapped: ptr,
    captureWidth: u32,
    captureHeight: u32,
    capturePitch: u64,
    captureOn: i32,
    // Append cursor for the shared vertex buffer: every recorded draw keeps its
    // own slice, so later uploads cannot overwrite earlier geometry.
    vertexCursor: u64,
}
