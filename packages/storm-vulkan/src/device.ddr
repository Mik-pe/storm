capability unsafe

import vk.api as vkapi
import vk.enums as enums
import vk.layout as vk
import .state as state
import .records as records

// Vulkan instance with the surface extensions SDL asks for.
// Every Vulkan call that can fail reports its code and the setup step it
// belongs to, here; the step is the return value, so a failure cannot travel
// without a name for where it happened.
pub unsafe fn fail(r: &mut state.Renderer, code: i32, step: state.SetupStep) -> state.SetupStep {
    r.lastResult = code
    step
}

unsafe fn create_instance(r: &mut state.Renderer) -> state.SetupStep {
    mut app: vk.ApplicationInfo = vk.ApplicationInfo::new()
    app.pApplicationName = cstr("storm")
    app.apiVersion = 4194304
    mut info: vk.InstanceCreateInfo = vk.InstanceCreateInfo::new()
    info.pApplicationInfo = addr(&app)
    // SDL knows which platform surface extensions the window needs.
    mut count: u32 = 0
    mut names: [ptr; 16] = [ptr(0); 16]
    if r.window.handle != ptr(0) {
        if r.window.GetInstanceExtensions(r.window.handle, addr(&mut count), ptr(0)) == 0 { return .Instance }
        if count == 0 || count > 16 { return .Instance }
        if r.window.GetInstanceExtensions(r.window.handle, addr(&mut count), addr(&mut names[0])) == 0 { return .Instance }
        info.enabledExtensionCount = count
        info.ppEnabledExtensionNames = addr(&names[0])
    }
    mut code := r.api.CreateInstance(addr(&info), ptr(0), addr(&mut r.instance))
    if code != 0 { return fail(&mut r, code, .Instance) }
    if r.window.handle != ptr(0) && r.window.CreateSurface(r.window.handle, r.instance, addr(&mut r.surface)) == 0 { return .Instance }
    .Ready
}

unsafe fn pick_physical(r: &mut state.Renderer) -> state.SetupStep {
    mut count: u32 = 0
    mut code := r.api.EnumeratePhysicalDevices(r.instance, addr(&mut count), ptr(0))
    if code != 0 { return fail(&mut r, code, .PhysicalDevice) }
    if count == 0 { return fail(&mut r, 0, .PhysicalDevice) }
    if count > 16 { count = 16 }
    mut devices: [ptr; 16] = [ptr(0); 16]
    code = r.api.EnumeratePhysicalDevices(r.instance, addr(&mut count), addr(&mut devices[0]))
    if code != 0 { return fail(&mut r, code, .PhysicalDevice) }
    // Prefer a discrete GPU, then integrated, then anything else.
    mut best := -1
    mut best_score := -1
    for i in 0..i32(count) {
        mut properties: vk.PhysicalDeviceProperties = zeroed()
        r.api.GetPhysicalDeviceProperties(devices[i], addr(&mut properties))
        if properties.limits.maxPushConstantsSize < state.MESH_PUSH_BYTES { continue }
        score := records.device_rank(properties.deviceType)
        if score > best_score { best_score = score; best = i }
    }
    if best < 0 { return .PhysicalDevice }
    r.physical = devices[best]
    mut properties: vk.PhysicalDeviceProperties = zeroed()
    r.api.GetPhysicalDeviceProperties(r.physical, addr(&mut properties))
    r.properties = properties
    r.api.GetPhysicalDeviceMemoryProperties(r.physical, addr(&mut r.memoryProperties))
    .Ready
}

// The 2D image Storm creates: one mip level, one layer, one sample, sharing
// mode exclusive, no initial layout. `tiling` and `usage` are enums written
// here, so no caller holds a registry number.
pub unsafe fn image_2d_info(format: u32, width: u32, height: u32, tiling: enums.ImageTiling, usage: enums.ImageUsage) -> vk.ImageCreateInfo {
    mut info: vk.ImageCreateInfo = vk.ImageCreateInfo::new()
    info.imageType = enums.image_type(.Type2D)
    info.format = format
    info.extent = vk.Extent3D { width: width, height: height, depth: 1 }
    info.mipLevels = 1
    info.arrayLayers = 1
    info.samples = enums.samples(.Type1)
    info.tiling = enums.image_tiling(tiling)
    info.usage = enums.image_usage(usage)
    info
}

unsafe fn pick_queue(r: &mut state.Renderer) -> state.SetupStep {
    mut count: u32 = 0
    r.api.GetPhysicalDeviceQueueFamilyProperties(r.physical, addr(&mut count), ptr(0))
    if count == 0 || count > 32 { return .QueueFamily }
    // VkQueueFamilyProperties is six u32 words on 64-bit: flags, count, timestamp, gran x/y/z.
    mut families: [u32; 192] = [0; 192]
    r.api.GetPhysicalDeviceQueueFamilyProperties(r.physical, addr(&mut count), addr(&mut families[0]))
    mut family := 0
    while family < i32(count) {
        graphics := i32(families[family * 6]).bit_and(1) != 0
        mut present: u32 = 1
        // The query itself can fail (e.g. ERROR_SURFACE_LOST_KHR); that is not
        // "this family cannot present", so report the code instead of skipping.
        if r.surface != ptr(0) {
            code := r.api.GetPhysicalDeviceSurfaceSupportKHR(r.physical, u32(family), r.surface, addr(&mut present))
            if code != 0 { return fail(&mut r, code, .QueueFamily) }
        }
        if graphics && present != 0 && families[family * 6 + 1] > 0 { break }
        family = family + 1
    }
    if family == i32(count) { return .QueueFamily }
    r.family = u32(family)
    .Ready
}

unsafe fn create_device(r: &mut state.Renderer) -> state.SetupStep {
    priority: f32 = 1.0
    mut q: vk.DeviceQueueCreateInfo = vk.DeviceQueueCreateInfo::new()
    q.queueFamilyIndex = r.family
    q.queueCount = 1
    q.pQueuePriorities = addr(&priority)
    mut swapchain := cstr("VK_KHR_swapchain")
    mut device: vk.DeviceCreateInfo = vk.DeviceCreateInfo::new()
    device.queueCreateInfoCount = 1
    device.pQueueCreateInfos = addr(&q)
    if r.surface != ptr(0) {
        device.enabledExtensionCount = 1
        device.ppEnabledExtensionNames = addr(&swapchain)
    }
    mut code := r.api.CreateDevice(r.physical, addr(&device), ptr(0), addr(&mut r.device))
    if code != 0 { return fail(&mut r, code, .Device) }
    r.api.GetDeviceQueue(r.device, r.family, 0, addr(&mut r.queue))
    mut pool: vk.CommandPoolCreateInfo = vk.CommandPoolCreateInfo::new()
    pool.flags = enums.command_pool_flag(.ResetCommandBuffer)
    pool.queueFamilyIndex = r.family
    code = r.api.CreateCommandPool(r.device, addr(&pool), ptr(0), addr(&mut r.pool))
    if code != 0 { return fail(&mut r, code, .Device) }
    .Ready
}

pub unsafe fn frame_viewport(view: &mut records.FrameViewport) {
    view.viewport = vk.PipelineViewportStateCreateInfo::new()
    view.viewport.viewportCount = 1
    view.viewport.scissorCount = 1
    view.states = [0, 1] // VK_DYNAMIC_STATE_VIEWPORT, VK_DYNAMIC_STATE_SCISSOR
    view.dynamic = vk.PipelineDynamicStateCreateInfo::new()
    view.dynamic.dynamicStateCount = 2
    view.dynamic.pDynamicStates = addr(&view.states[0])
}

pub unsafe fn set_frame_viewport(r: &state.Renderer) {
    mut viewport: vk.Viewport = zeroed()
    viewport.width = f32(r.width)
    viewport.height = f32(r.height)
    viewport.maxDepth = 1.0
    mut scissor: vk.Rect2D = zeroed()
    scissor.extent.width = r.width
    scissor.extent.height = r.height
    cmd := r.commands[r.current]
    r.api.CmdSetViewport(cmd, 0, 1, addr(&viewport))
    r.api.CmdSetScissor(cmd, 0, 1, addr(&scissor))
}

pub unsafe fn color_framebuffer(r: &state.Renderer, view: ptr, output: ptr) -> i32 {
    views := [view, r.depth.view]
    mut info: vk.FramebufferCreateInfo = vk.FramebufferCreateInfo::new()
    info.renderPass = r.renderPass
    info.attachmentCount = 2
    info.pAttachments = addr(&views[0])
    info.width = r.width
    info.height = r.height
    info.layers = 1
    r.api.CreateFramebuffer(r.device, addr(&info), ptr(0), output)
}

// A single linearly sampled 2D texture at fragment binding zero.
pub unsafe fn sampled_texture(api: &vkapi.Api, dev: ptr, texture: &mut state.SampledTexture) -> i32 {
    mut sampler: vk.SamplerCreateInfo = vk.SamplerCreateInfo::new()
    sampler.minFilter = enums.filter(.Linear)
    sampler.magFilter = enums.filter(.Linear)
    sampler.addressModeU = enums.sampler_address_mode(.ClampToEdge)
    sampler.addressModeV = enums.sampler_address_mode(.ClampToEdge)
    sampler.addressModeW = enums.sampler_address_mode(.ClampToEdge)
    mut code := api.CreateSampler(dev, addr(&sampler), ptr(0), addr(&mut texture.sampler))
    if code != 0 { return code }
    mut binding: vk.DescriptorSetLayoutBinding = zeroed()
    binding.descriptorType = enums.descriptor_type(.CombinedImageSampler)
    binding.descriptorCount = 1
    binding.stageFlags = enums.shader_stage(.Fragment)
    mut layout: vk.DescriptorSetLayoutCreateInfo = vk.DescriptorSetLayoutCreateInfo::new()
    layout.bindingCount = 1
    layout.pBindings = addr(&binding)
    code = api.CreateDescriptorSetLayout(dev, addr(&layout), ptr(0), addr(&mut texture.layout))
    if code != 0 { return code }
    size := vk.DescriptorPoolSize { type: binding.descriptorType, descriptorCount: 1 }
    mut pool: vk.DescriptorPoolCreateInfo = vk.DescriptorPoolCreateInfo::new()
    pool.maxSets = 1
    pool.poolSizeCount = 1
    pool.pPoolSizes = addr(&size)
    code = api.CreateDescriptorPool(dev, addr(&pool), ptr(0), addr(&mut texture.pool))
    if code != 0 { return code }
    mut allocation: vk.DescriptorSetAllocateInfo = vk.DescriptorSetAllocateInfo::new()
    allocation.descriptorPool = texture.pool
    allocation.descriptorSetCount = 1
    allocation.pSetLayouts = addr(&texture.layout)
    api.AllocateDescriptorSets(dev, addr(&allocation), addr(&mut texture.set))
}

pub unsafe fn sample_view(r: &state.Renderer, texture: &state.SampledTexture, view: ptr) {
    image := vk.DescriptorImageInfo { sampler: texture.sampler, imageView: view, imageLayout: enums.image_layout(.ShaderReadOnlyOptimal) }
    mut write: vk.WriteDescriptorSet = vk.WriteDescriptorSet::new()
    write.dstSet = texture.set
    write.descriptorCount = 1
    write.descriptorType = enums.descriptor_type(.CombinedImageSampler)
    write.pImageInfo = addr(&image)
    r.api.UpdateDescriptorSets(r.device, 1, addr(&write), 0, ptr(0))
}

pub unsafe fn destroy_texture(r: &state.Renderer, texture: &state.SampledTexture) {
    r.api.DestroyDescriptorPool(r.device, texture.pool, ptr(0))
    r.api.DestroyDescriptorSetLayout(r.device, texture.layout, ptr(0))
    r.api.DestroySampler(r.device, texture.sampler, ptr(0))
}

// Display shaders emit the same authored colors on byte and sRGB attachments.
pub unsafe fn display_encoding(format: u32, storage: &mut records.DisplayEncoding) -> ptr {
    if format != enums.format(.B8G8R8A8_SRGB) && format != enums.format(.R8G8B8A8_SRGB) { return ptr(0) }
    storage.srgb = 1
    storage.entry = vk.SpecializationMapEntry { constantID: 0, offset: 0, size: 4 }
    storage.info = vk.SpecializationInfo {
        mapEntryCount: 1, pMapEntries: addr(&storage.entry), dataSize: 4, pData: addr(&storage.srgb)
    }
    addr(&storage.info)
}

unsafe fn pick_format(r: &mut state.Renderer) -> state.SetupStep {
    mut count: u32 = 0
    mut code := r.api.GetPhysicalDeviceSurfaceFormatsKHR(r.physical, r.surface, addr(&mut count), ptr(0))
    if code != 0 { return fail(&mut r, code, .Format) }
    if count == 0 { return fail(&mut r, 0, .Format) }
    if count > 32 { count = 32 }
    // Each VkSurfaceFormatKHR is two u32 words (format, colorSpace). Read them as words.
    mut words: [u32; 64] = [0; 64]
    _ := r.api.GetPhysicalDeviceSurfaceFormatsKHR(r.physical, r.surface, addr(&mut count), addr(&mut words[0]))
    // Prefer B8G8R8A8_UNORM or B8G8R8A8_SRGB; else take the first.
    r.format = words[0]
    r.colorSpace = words[1]
    for i in 0..i32(count) {
        f := words[i * 2]
        if f == enums.format(.B8G8R8A8_UNORM) || f == enums.format(.B8G8R8A8_SRGB) { r.format = f; r.colorSpace = words[i * 2 + 1]; break }
        if f == enums.format(.R8G8B8A8_UNORM) && r.format != enums.format(.B8G8R8A8_UNORM) && r.format != enums.format(.B8G8R8A8_SRGB) { r.format = f; r.colorSpace = words[i * 2 + 1] }
    }
    .Ready
}

// Depth attachment matching the current swapchain extent. Recreated with it.

unsafe fn create_swapchain(r: &mut state.Renderer) -> state.SetupStep {
    mut caps: vk.SurfaceCapabilitiesKHR = zeroed()
    mut code := r.api.GetPhysicalDeviceSurfaceCapabilitiesKHR(r.physical, r.surface, addr(&mut caps))
    if code != 0 { return fail(&mut r, code, .Swapchain) }
    mut width := caps.currentExtent.width
    mut height := caps.currentExtent.height
    // 0xFFFFFFFF means "pick your own size"; use the window's.
    if width == 4294967295 || height == 4294967295 {
        mut w: i32 = 0
        mut h: i32 = 0
        r.window.GetDrawableSize(r.window.handle, addr(&mut w), addr(&mut h))
        width = u32(w)
        height = u32(h)
        if width < caps.minImageExtent.width { width = caps.minImageExtent.width }
        if height < caps.minImageExtent.height { height = caps.minImageExtent.height }
    }
    if width == 0 || height == 0 { return .Swapchain }
    r.width = width
    r.height = height
    mut images := caps.minImageCount + 1
    if caps.maxImageCount > 0 && images > caps.maxImageCount { images = caps.maxImageCount }
    if images > 8 { images = 8 }
    mut info: vk.SwapchainCreateInfoKHR = vk.SwapchainCreateInfoKHR::new()
    info.surface = r.surface
    info.minImageCount = images
    info.imageFormat = r.format
    info.imageColorSpace = r.colorSpace
    info.imageExtent.width = width
    info.imageExtent.height = height
    info.imageArrayLayers = 1
    info.imageUsage = 16
    info.imageSharingMode = 0
    info.preTransform = caps.currentTransform
    info.compositeAlpha = 1
    info.presentMode = 2
    info.clipped = 1
    code = r.api.CreateSwapchainKHR(r.device, addr(&info), ptr(0), addr(&mut r.swapchain))
    if code != 0 { return fail(&mut r, code, .Swapchain) }
    mut count: u32 = 8
    code = r.api.GetSwapchainImagesKHR(r.device, r.swapchain, addr(&mut count), addr(&mut r.images[0]))
    if code != 0 { return fail(&mut r, code, .Swapchain) }
    if count == 0 || count > 8 { return .Swapchain }
    r.imageCount = i32(count)
    for i in 0..i32(count) {
        mut view: vk.ImageViewCreateInfo = vk.ImageViewCreateInfo::new()
        view.image = r.images[i]
        view.viewType = enums.image_view_type(.Type2D)
        view.format = r.format
        view.subresourceRange.aspectMask = enums.image_aspect(.Color)
        view.subresourceRange.levelCount = 1
        view.subresourceRange.layerCount = 1
        mut semaphore: vk.SemaphoreCreateInfo = vk.SemaphoreCreateInfo::new()
        code = r.api.CreateSemaphore(r.device, addr(&semaphore), ptr(0), addr(&mut r.render_finished[i]))
        if code != 0 { return fail(&mut r, code, .FrameSync) }
        code = r.api.CreateImageView(r.device, addr(&view), ptr(0), addr(&mut r.views[i]))
        if code != 0 { return fail(&mut r, code, .Swapchain) }
    }
    .Ready
}

pub unsafe fn setup(r: &mut state.Renderer) -> state.SetupStep {
    r.lastResult = 0
    mut step := create_instance(&mut r)
    if step != .Ready { return step }
    step = pick_physical(&mut r)
    if step != .Ready { return step }
    step = pick_queue(&mut r)
    if step != .Ready { return step }
    step = create_device(&mut r)
    if step != .Ready { return step }
    if r.surface == ptr(0) {
        r.format = enums.format(.R8G8B8A8_UNORM)
        return .Ready
    }
    step = pick_format(&mut r)
    if step != .Ready { return step }
    create_swapchain(&mut r)
}

// Recreate only the swapchain and its image views after a resize.
pub unsafe fn setup_swapchain_only(r: &mut state.Renderer) -> state.SetupStep {
    create_swapchain(&mut r)
}

pub unsafe fn destroy_swapchain(r: &mut state.Renderer) {
    _ := r.api.DeviceWaitIdle(r.device)
    for i in 0..r.imageCount {
        r.api.DestroyImageView(r.device, r.views[i], ptr(0))
        r.api.DestroySemaphore(r.device, r.render_finished[i], ptr(0))
        r.views[i] = ptr(0)
        r.render_finished[i] = ptr(0)
    }
    if r.swapchain != ptr(0) { r.api.DestroySwapchainKHR(r.device, r.swapchain, ptr(0)) }
    r.swapchain = ptr(0)
    r.imageCount = 0
}

pub unsafe fn destroy(r: &mut state.Renderer) {
    if r.device != ptr(0) {
        _ := r.api.DeviceWaitIdle(r.device)
        destroy_swapchain(&mut r)
        destroy_vertex_buffer(&r, &r.vertex)
        r.vertex = zeroed()
        for i in 0..2 {
            r.api.DestroyFence(r.device, r.fences[i], ptr(0))
            r.api.DestroySemaphore(r.device, r.image_available[i], ptr(0))
        }
        if r.pool != ptr(0) { r.api.DestroyCommandPool(r.device, r.pool, ptr(0)) }
        r.api.DestroyDevice(r.device, ptr(0))
    }
    if r.surface != ptr(0) { r.api.DestroySurfaceKHR(r.instance, r.surface, ptr(0)) }
    if r.instance != ptr(0) { r.api.DestroyInstance(r.instance, ptr(0)) }
}

// The first memory type a requirement allows that has every property in
// `want`: the index vkAllocateMemory takes, or `.None` when no type does (and
// Vulkan is never asked). `.None` for `want` asks for no property and takes
// the first allowed type. Pure data over the registry's record, so a device's
// table can be a test fixture.
pub fn memory_type(properties: &vk.PhysicalDeviceMemoryProperties, requirements: &vk.MemoryRequirements, want: Option<enums.Memory>) -> Option<i32> {
    mut flags: u32 = 0
    match want {
        .Some(memory) => { flags = enums.memory(memory) },
        .None => {},
    }
    mut i := 0
    while i < i32(properties.memoryTypeCount) {
        bits := i32(requirements.memoryTypeBits)
        if bits.bit_and(i32(1).shl(i)) != 0 && properties.memoryTypes[i].propertyFlags.bit_and(flags) == flags {
            return .Some(i)
        }
        i = i + 1
    }
    .None
}

// Returns the VkResult of vkAllocateMemory, or VK_ERROR_UNKNOWN (-13) when no
// memory type satisfies the requirements: Vulkan was never asked, so there is
// no code from it, and -13 is Khronos' spelling of "unspecified".
pub unsafe fn allocate(r: &state.Renderer, requirements: &vk.MemoryRequirements, want: Option<enums.Memory>, output: ptr) -> i32 {
    match memory_type(&r.memoryProperties, requirements, want) {
        .Some(i) => {
            mut alloc: vk.MemoryAllocateInfo = vk.MemoryAllocateInfo::new()
            alloc.allocationSize = requirements.size
            alloc.memoryTypeIndex = u32(i)
            r.api.AllocateMemory(r.device, addr(&alloc), ptr(0), output)
        },
        .None => -13,
    }
}

// One SPIR-V module from words already in memory. `bytes` is the word count
// times four; the caller owns the step and turns a non-zero code into fail().
pub unsafe fn shader_module(r: &state.Renderer, words: ptr, bytes: usize, output: ptr) -> i32 {
    mut info: vk.ShaderModuleCreateInfo = vk.ShaderModuleCreateInfo::new()
    info.codeSize = bytes
    info.pCode = words
    r.api.CreateShaderModule(r.device, addr(&info), ptr(0), output)
}

pub unsafe fn destroy_vertex_buffer(r: &state.Renderer, buffer: &state.Buffer) {
    if buffer.mapped != ptr(0) { r.api.UnmapMemory(r.device, buffer.memory) }
    if buffer.handle != ptr(0) { r.api.DestroyBuffer(r.device, buffer.handle, ptr(0)) }
    if buffer.memory != ptr(0) { r.api.FreeMemory(r.device, buffer.memory, ptr(0)) }
}

pub unsafe fn create_vertex_buffer(r: &state.Renderer, bytes: u64) -> Result<state.Buffer, i32> {
    mut info: vk.BufferCreateInfo = vk.BufferCreateInfo::new()
    info.size = bytes
    info.usage = enums.buffer_usage(.VertexBuffer)
    info.sharingMode = enums.sharing_mode(.Exclusive)
    mut handle := ptr(0)
    mut code := r.api.CreateBuffer(r.device, addr(&info), ptr(0), addr(&mut handle))
    if code != 0 { return .Err(code) }
    mut requirements: vk.MemoryRequirements = zeroed()
    r.api.GetBufferMemoryRequirements(r.device, handle, addr(&mut requirements))
    mut memory := ptr(0)
    code = allocate(&r, &requirements, .Some(enums.Memory.HostVisibleCoherent), addr(&mut memory))
    if code != 0 {
        r.api.DestroyBuffer(r.device, handle, ptr(0))
        return .Err(code)
    }
    code = r.api.BindBufferMemory(r.device, handle, memory, 0)
    if code != 0 {
        r.api.DestroyBuffer(r.device, handle, ptr(0))
        r.api.FreeMemory(r.device, memory, ptr(0))
        return .Err(code)
    }
    mut mapped := ptr(0)
    code = r.api.MapMemory(r.device, memory, 0, bytes, 0, addr(&mut mapped))
    if code != 0 {
        r.api.DestroyBuffer(r.device, handle, ptr(0))
        r.api.FreeMemory(r.device, memory, ptr(0))
        return .Err(code)
    }
    .Ok(state.Buffer { handle: handle, memory: memory, mapped: mapped, capacity: bytes })
}

// Replace only after all commands using the previous mapping have retired.
pub unsafe fn replace_vertex_buffer(r: &mut state.Renderer, bytes: u64) -> state.SetupStep {
    match create_vertex_buffer(&r, bytes) {
        .Err(code) => fail(&mut r, code, .VertexBuffer),
        .Ok(buffer) => {
            destroy_vertex_buffer(&r, &r.vertex)
            r.vertex = buffer
            .Ready
        },
    }
}

pub unsafe fn setup_frames(r: &mut state.Renderer) -> state.SetupStep {
    mut allocate_info: vk.CommandBufferAllocateInfo = vk.CommandBufferAllocateInfo::new()
    allocate_info.commandPool = r.pool
    allocate_info.level = 0
    allocate_info.commandBufferCount = 2
    mut commands: [ptr; 2] = [ptr(0); 2]
    mut code := r.api.AllocateCommandBuffers(r.device, addr(&allocate_info), addr(&mut commands[0]))
    if code != 0 { return fail(&mut r, code, .FrameSync) }
    for i in 0..2 {
        r.commands[i] = commands[i]
        mut fence: vk.FenceCreateInfo = vk.FenceCreateInfo::new()
        fence.flags = enums.fence(.Signaled)
        mut created := ptr(0)
        code = r.api.CreateFence(r.device, addr(&fence), ptr(0), addr(&mut created))
        if code != 0 { return fail(&mut r, code, .FrameSync) }
        r.fences[i] = created
        if r.surface == ptr(0) { continue }
        mut semaphore: vk.SemaphoreCreateInfo = vk.SemaphoreCreateInfo::new()
        mut available := ptr(0)
        code = r.api.CreateSemaphore(r.device, addr(&semaphore), ptr(0), addr(&mut available))
        if code != 0 { return fail(&mut r, code, .FrameSync) }
        r.image_available[i] = available
    }
    .Ready
}
