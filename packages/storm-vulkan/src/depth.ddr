capability unsafe

import .device as device
import .enums as enums
import .layout as vk
import .state as state

// Depth buffer.
//
// One D32_SFLOAT image, OPTIMAL tiled, recreated with the swapchain. It is
// the second attachment of the main render pass and is cleared to 1.0 every
// frame together with the colour attachment.

// What this module owns: the image, its memory and its view. Zeroed with
// the renderer; `create` fills it, `destroy` empties it, and nobody else
// writes it. The one reader outside is the colour framebuffer (`device.ddr`).
@c_layout
pub struct Depth {
    image: ptr,
    memory: ptr,
    view: ptr,
}

pub fn float_bits(value: f32) -> u32 {
    u32(i64(value.to_bits()).bit_and(0xffffffff))
}

pub fn depth_clear(depth: f32) -> u64 {
    u64(float_bits(depth))
}

pub unsafe fn create(r: &mut state.Renderer, width: u32, height: u32) -> state.SetupStep {
    if width == 0 || height == 0 { return .DepthBuffer }
    info := device.image_2d_info(enums.format(.D32_SFLOAT), width, height, vk.IMAGE_TILING_OPTIMAL, enums.image_usage(.DepthStencilAttachment))
    mut image := ptr(0)
    mut code := r.api.CreateImage(r.device, addr(&info), ptr(0), addr(&mut image))
    if code != 0 {
        return device.fail(&mut r, code, .DepthBuffer)
    }
    mut req: [u64; 3] = [0; 3]
    r.api.GetImageMemoryRequirements(r.device, image, addr(&mut req[0]))
    mut requirements: vk.MemoryRequirements = zeroed()
    requirements.size = req[0]
    requirements.alignment = req[1]
    requirements.memoryTypeBits = u32(req[2])
    mut memory := ptr(0)
    if device.allocate(&r, &requirements, 0, addr(&mut memory)) != 0 {
        r.api.DestroyImage(r.device, image, ptr(0))
        return .DepthBuffer
    }
    code = r.api.BindImageMemory(r.device, image, memory, 0)
    if code != 0 {
        r.api.FreeMemory(r.device, memory, ptr(0))
        r.api.DestroyImage(r.device, image, ptr(0))
        return device.fail(&mut r, code, .DepthBuffer)
    }
    mut view_info: vk.ImageViewCreateInfo = vk.ImageViewCreateInfo::new()
    view_info.image = image
    view_info.viewType = enums.image_view_type(.Type2D)
    view_info.format = enums.format(.D32_SFLOAT)
    view_info.subresourceRange.aspectMask = enums.image_aspect(.Depth)
    view_info.subresourceRange.levelCount = 1
    view_info.subresourceRange.layerCount = 1
    mut view := ptr(0)
    code = r.api.CreateImageView(r.device, addr(&view_info), ptr(0), addr(&mut view))
    if code != 0 {
        r.api.FreeMemory(r.device, memory, ptr(0))
        r.api.DestroyImage(r.device, image, ptr(0))
        return device.fail(&mut r, code, .DepthBuffer)
    }
    r.depth.image = image
    r.depth.memory = memory
    r.depth.view = view
    .Ready
}

pub unsafe fn destroy(r: &mut state.Renderer) {
    if r.depth.view != ptr(0) { r.api.DestroyImageView(r.device, r.depth.view, ptr(0)) }
    if r.depth.image != ptr(0) { r.api.DestroyImage(r.device, r.depth.image, ptr(0)) }
    if r.depth.memory != ptr(0) { r.api.FreeMemory(r.device, r.depth.memory, ptr(0)) }
    r.depth.view = ptr(0)
    r.depth.image = ptr(0)
    r.depth.memory = ptr(0)
}
