capability unsafe, filesystem

import std.bytes as bytes
import std.sys as sys
import .device as device
import .enums as enums
import .layout as vk
import .state as state

pub fn readback_size(width: u32, height: u32) -> u64 { u64(width) * u64(height) * 4 }

pub unsafe fn destroy(r: &mut state.Renderer) {
    r.api.DestroyFramebuffer(r.device, r.captureFramebuffer, ptr(0))
    r.api.DestroyImageView(r.device, r.captureView, ptr(0))
    r.api.DestroyImage(r.device, r.captureImage, ptr(0))
    r.api.FreeMemory(r.device, r.captureMemory, ptr(0))
    if r.readback.mapped != ptr(0) { r.api.UnmapMemory(r.device, r.readback.memory) }
    r.api.DestroyBuffer(r.device, r.readback.handle, ptr(0))
    r.api.FreeMemory(r.device, r.readback.memory, ptr(0))
    r.captureFramebuffer = ptr(0)
    r.captureView = ptr(0)
    r.captureImage = ptr(0)
    r.captureMemory = ptr(0)
    r.readback = zeroed()
    r.captureOn = 0
}

// The color attachment uses optimal tiling, including on devices that cannot
// render into a linear image. Transfer into a tightly packed coherent buffer.
unsafe fn create(r: &mut state.Renderer) -> i32 {
    info := device.image_2d_info(r.format, r.width, r.height, enums.ImageTiling.Optimal, enums.ImageUsage.ColorAttachmentTransferSrc)
    mut code := r.api.CreateImage(r.device, addr(&info), ptr(0), addr(&mut r.captureImage))
    if code != 0 { return code }
    mut req: vk.MemoryRequirements = zeroed()
    r.api.GetImageMemoryRequirements(r.device, r.captureImage, addr(&mut req))
    mut memory := ptr(0)
    code = device.allocate(&r, &req, .None, addr(&mut memory))
    r.captureMemory = memory
    if code != 0 { return code }
    code = r.api.BindImageMemory(r.device, r.captureImage, r.captureMemory, 0)
    if code != 0 { return code }
    mut view: vk.ImageViewCreateInfo = vk.ImageViewCreateInfo::new()
    view.image = r.captureImage
    view.viewType = enums.image_view_type(.Type2D)
    view.format = r.format
    view.subresourceRange.aspectMask = enums.image_aspect(.Color)
    view.subresourceRange.levelCount = 1
    view.subresourceRange.layerCount = 1
    code = r.api.CreateImageView(r.device, addr(&view), ptr(0), addr(&mut r.captureView))
    if code != 0 { return code }
    mut framebuffer := ptr(0)
    code = device.color_framebuffer(&r, r.captureView, addr(&mut framebuffer))
    r.captureFramebuffer = framebuffer
    if code != 0 { return code }
    mut buffer: vk.BufferCreateInfo = vk.BufferCreateInfo::new()
    buffer.size = readback_size(r.width, r.height)
    buffer.usage = enums.buffer_usage(.TransferDst)
    buffer.sharingMode = enums.sharing_mode(.Exclusive)
    code = r.api.CreateBuffer(r.device, addr(&buffer), ptr(0), addr(&mut r.readback.handle))
    if code != 0 { return code }
    r.api.GetBufferMemoryRequirements(r.device, r.readback.handle, addr(&mut req))
    memory = ptr(0)
    code = device.allocate(&r, &req, .Some(enums.Memory.HostVisibleCoherent), addr(&mut memory))
    r.readback.memory = memory
    if code != 0 { return code }
    code = r.api.BindBufferMemory(r.device, r.readback.handle, r.readback.memory, 0)
    if code != 0 { return code }
    r.readback.capacity = buffer.size
    r.api.MapMemory(r.device, r.readback.memory, 0, buffer.size, 0, addr(&mut r.readback.mapped))
}

pub unsafe fn setup(r: &mut state.Renderer) -> state.SetupStep {
    if r.width == 0 || r.height == 0 || !enums.format_has_bytes(r.format) { return .CaptureTarget }
    result := create(&mut r)
    if result != 0 {
        destroy(&mut r)
        return device.fail(&mut r, result, .CaptureTarget)
    }
    .Ready
}

pub unsafe fn copy_to_host(r: &state.Renderer) {
    cmd := r.commands[r.current]
    mut transfer: vk.ImageMemoryBarrier = vk.ImageMemoryBarrier::new()
    transfer.srcAccessMask = enums.access(.ColorAttachmentWrite)
    transfer.dstAccessMask = enums.access(.TransferRead)
    transfer.oldLayout = enums.image_layout(.ColorAttachmentOptimal)
    transfer.newLayout = enums.image_layout(.TransferSrcOptimal)
    transfer.srcQueueFamilyIndex = enums.QUEUE_FAMILY_IGNORED
    transfer.dstQueueFamilyIndex = enums.QUEUE_FAMILY_IGNORED
    transfer.image = r.captureImage
    transfer.subresourceRange.aspectMask = enums.image_aspect(.Color)
    transfer.subresourceRange.levelCount = 1
    transfer.subresourceRange.layerCount = 1
    r.api.CmdPipelineBarrier(cmd, enums.pipeline_stage(.ColorAttachmentOutput), enums.pipeline_stage(.Transfer),
        0, 0, ptr(0), 0, ptr(0), 1, addr(&transfer))
    mut copy: vk.BufferImageCopy = zeroed()
    copy.imageSubresource.aspectMask = enums.image_aspect(.Color)
    copy.imageSubresource.layerCount = 1
    copy.imageExtent.width = r.width
    copy.imageExtent.height = r.height
    copy.imageExtent.depth = 1
    r.api.CmdCopyImageToBuffer(cmd, r.captureImage, enums.image_layout(.TransferSrcOptimal), r.readback.handle, 1, addr(&copy))
    mut host := vk.MemoryBarrier::new()
    host.srcAccessMask = enums.access(.TransferWrite)
    host.dstAccessMask = enums.access(.HostRead)
    r.api.CmdPipelineBarrier(cmd, enums.pipeline_stage(.Transfer), enums.pipeline_stage(.Host), 0, 1, addr(&host), 0, ptr(0), 0, ptr(0))
}

pub unsafe fn save(r: &state.Renderer, path: string) -> bool {
    if r.captureOn != 2 || r.readback.mapped == ptr(0) { return false }
    red := if enums.format_is_bgra(r.format) { usize(2) } else { usize(0) }
    blue := usize(2) - red
    mut out: []u8 = []
    out.reserve(i32(r.width * r.height * 3) + 32)
    bytes.append_utf8(&mut out, "P6\n" + r.width.str() + " " + r.height.str() + "\n255\n")
    for pixel in 0..i32(r.width * r.height) {
        at := usize(r.readback.mapped) + usize(pixel) * 4
        out.push(load_u8(ptr(at + red)))
        out.push(load_u8(ptr(at + 1)))
        out.push(load_u8(ptr(at + blue)))
    }
    sys.write_bytes(path, &out).is_ok()
}
