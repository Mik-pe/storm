capability unsafe, filesystem, stdio

import std.bytes as b
import std.sys as sys
import .device as device
import .enums as enums
import .layout as vk
import .state as state

// Headless frame capture.
//
// The scene renders into the shared offscreen image and the post pass writes
// the finished frame into this linear, host-visible colour image. The pixels
// are then read straight out of mapped memory.

unsafe fn make_image(r: &state.Renderer, format: u32, width: u32, height: u32, tiling: u32, usage: u32, flags: i32, image_out: ptr, memory_out: ptr, size_out: ptr) -> bool {
    info := device.image_2d_info(format, width, height, tiling, usage)
    mut image := ptr(0)
    mut code := r.api.CreateImage(r.device, addr(&info), ptr(0), addr(&mut image))
    if code != 0 { return false }
    mut req: [u64; 3] = [0; 3]
    r.api.GetImageMemoryRequirements(r.device, image, addr(&mut req[0]))
    if req[0] == 0 { return false }
    mut requirements: vk.MemoryRequirements = zeroed()
    requirements.size = req[0]
    requirements.alignment = req[1]
    requirements.memoryTypeBits = u32(req[2])
    mut memory := ptr(0)
    if !device.allocate(&r, &requirements, flags, addr(&mut memory)) { return false }
    code = r.api.BindImageMemory(r.device, image, memory, 0)
    if code != 0 { return false }
    mut size_slot := req[0]
    store_u64(size_out, size_slot)
    store_ptr(image_out, image)
    store_ptr(memory_out, memory)
    true
}

unsafe fn make_view(r: &state.Renderer, image: ptr, format: u32) -> ptr {
    mut view: vk.ImageViewCreateInfo = zeroed()
    view.sType = 15
    view.image = image
    view.viewType = enums.image_view_type(.Type2D)
    view.format = format
    view.subresourceRange.aspectMask = enums.image_aspect(.Color)
    view.subresourceRange.levelCount = 1
    view.subresourceRange.layerCount = 1
    mut handle := ptr(0)
    if r.api.CreateImageView(r.device, addr(&view), ptr(0), addr(&mut handle)) != 0 { return ptr(0) }
    handle
}

pub fn capture_layout_fits(width: u32, height: u32, layout: &vk.SubresourceLayout, allocation: u64) -> bool {
    row := u64(width) * 4
    if width == 0 || height == 0 || layout.rowPitch < row || layout.offset > allocation { return false }
    available := allocation - layout.offset
    if available < row { return false }
    u64(height - 1) <= (available - row) / layout.rowPitch
}

pub unsafe fn setup(r: &mut state.Renderer) -> bool {
    if r.width == 0 || r.height == 0 { return false }
    if !enums.format_has_bytes(r.format) { return false }
    mut target := ptr(0)
    mut target_memory := ptr(0)
    mut target_size: [u64; 1] = [0]
    // LINEAR so its memory can be mapped and read straight back.
    if !make_image(&r, r.format, r.width, r.height, vk.IMAGE_TILING_LINEAR, 17, 6, addr(&mut target), addr(&mut target_memory), addr(&mut target_size[0])) {
        _ := sys.eprint("capture: no target image")
        return false
    }
    view := make_view(&r, target, r.format)
    if view == ptr(0) { return false }

    mut views: [ptr; 2] = [view, r.depthView]
    mut fbi: vk.FramebufferCreateInfo = zeroed()
    fbi.sType = 37
    fbi.renderPass = r.renderPass
    fbi.attachmentCount = 2
    fbi.pAttachments = addr(&views[0])
    fbi.width = r.width
    fbi.height = r.height
    fbi.layers = 1
    mut framebuffer := ptr(0)
    mut code := r.api.CreateFramebuffer(r.device, addr(&fbi), ptr(0), addr(&mut framebuffer))
    if code != 0 { return device.fail(&mut r, code) }

    mut mapped := ptr(0)
    code = r.api.MapMemory(r.device, target_memory, 0, target_size[0], 0, addr(&mut mapped))
    if code != 0 { return device.fail(&mut r, code) }
    mut sub: [u32; 3] = [1, 0, 0]
    mut layout: vk.SubresourceLayout = zeroed()
    r.api.GetImageSubresourceLayout(r.device, target, addr(&mut sub[0]), addr(&mut layout))
    if !capture_layout_fits(r.width, r.height, &layout, target_size[0]) { return false }

    r.linearImage = target
    r.linearMemory = target_memory
    r.linearMapped = ptr(usize(mapped) + usize(layout.offset))
    r.captureFramebuffer = framebuffer
    r.captureWidth = r.width
    r.captureHeight = r.height
    r.capturePitch = layout.rowPitch
    _ := sys.eprint("capture: ready " + r.width.str() + "x" + r.height.str() + " pitch=" + layout.rowPitch.str())
    true
}

// Binary PPM (P6) at native resolution.
pub unsafe fn save(r: &state.Renderer, path: string) -> bool {
    if r.linearMapped == ptr(0) { return false }
    width := i32(r.captureWidth)
    height := i32(r.captureHeight)
    pitch := usize(r.capturePitch)
    red := if enums.format_is_bgra(r.format) { usize(2) } else { usize(0) }
    blue := usize(2) - red
    mut out: []u8 = []
    b.append_utf8(&mut out, "P6\n" + width.str() + " " + height.str() + "\n255\n")
    mut y := 0
    while y < height {
        row := usize(y) * pitch
        mut x := 0
        while x < width {
            offset := row + usize(x) * 4
            out.push(load_u8(ptr(usize(r.linearMapped) + offset + red)))
            out.push(load_u8(ptr(usize(r.linearMapped) + offset + 1)))
            out.push(load_u8(ptr(usize(r.linearMapped) + offset + blue)))
            x = x + 1
        }
        y = y + 1
    }
    _ := sys.eprint("capture: writing " + out.len.str() + " bytes")
    match sys.write_bytes(path, &out) {
        .Ok(_) => true,
        .Err(_) => false,
    }
}
