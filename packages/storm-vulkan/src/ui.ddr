capability unsafe, stdio

import std.sys as sys
import .device as device
import vk.enums as enums
import vk.layout as vk2
import .pipeline as pipelines
import .shader as shader
import .state as state
import .records as records

// Immediate-mode UI drawing.
//
// One dynamic vertex buffer holds solid rectangles and glyph quads. Rectangles
// use uv.x < 0 and are filled with the vertex colour; glyphs sample the
// coverage atlas uploaded from the text package.

// The coverage bytes are widened to f32 before upload, so the atlas is a
// single-channel float image (finding 30: linear-tiled R8 did not sample here).

// What this module owns: the atlas image and its sampled set, the quad
// pipeline, and the shared vertex buffer with its frame cursor. Zeroed with
// the renderer; `setup` fills it, `destroy` empties it, and nobody outside
// this module reads it. The same record and name as storm-metal's `ui.Atlas`.
@c_layout
pub struct Atlas {
    pipeline: ptr,
    pipelineLayout: ptr,
    texture: state.SampledTexture,
    atlasImage: ptr,
    atlasMemory: ptr,
    atlasView: ptr,
    vertex: state.Buffer,
    cursor: u64,
    vertShader: ptr,
    fragShader: ptr,
}

const FLOATS_PER_VERTEX: u32 = 8
const ATLAS_SIZE: u32 = 1024

// UI uses alpha-over blending. Colour and alpha are
// weighted by the source alpha, so a quad with zero coverage leaves the target
// untouched. The earlier 5/6 pair was ONE_MINUS_DST_COLOR / SRC_ALPHA, which
// inverts whatever is underneath and painted a box around every glyph (dogfood
// finding 40).
@extern("c", "memcpy")
unsafe fn copy_bytes(destination: ptr, source: ptr, bytes: usize) -> ptr

@c_layout
struct AtlasImage { image: ptr, memory: ptr, mapped: ptr }

unsafe fn create_atlas(r: &mut state.Renderer) -> state.SetupStep {
    mut words: [u32; 22] = [0; 22]
    words[0] = 14
    words[5] = 1
    words[6] = enums.format(.R32_SFLOAT)
    words[7] = ATLAS_SIZE
    words[8] = ATLAS_SIZE
    words[9] = 1
    words[10] = 1
    words[11] = 1
    words[12] = 1
    words[13] = 1 // OPTIMAL: linear-tiled images are not sampleable here
    words[14] = 6 // VK_IMAGE_USAGE_SAMPLED_BIT | TRANSFER_DST_BIT
    mut image := ptr(0)
    mut code := r.api.CreateImage(r.device, addr(&mut words[0]), ptr(0), addr(&mut image))
    if code != 0 { return device.fail(&mut r, code, .Ui) }
    mut requirements: vk2.MemoryRequirements = zeroed()
    r.api.GetImageMemoryRequirements(r.device, image, addr(&mut requirements))
    mut memory := ptr(0)
    code = device.allocate(&r, &requirements, .Some(enums.Memory.HostVisibleCoherent), addr(&mut memory))
    if code != 0 { return device.fail(&mut r, code, .Ui) }
    if memory == ptr(0) { return .Ui }
    code = r.api.BindImageMemory(r.device, image, memory, 0)
    if code != 0 { return device.fail(&mut r, code, .Ui) }
    mut view_info: vk2.ImageViewCreateInfo = vk2.ImageViewCreateInfo::new()
    view_info.image = image
    view_info.viewType = enums.image_view_type(.Type2D)
    view_info.format = enums.format(.R32_SFLOAT)
    view_info.subresourceRange.aspectMask = enums.image_aspect(.Color)
    view_info.subresourceRange.levelCount = 1
    view_info.subresourceRange.layerCount = 1
    mut view := ptr(0)
    code = r.api.CreateImageView(r.device, addr(&view_info), ptr(0), addr(&mut view))
    if code != 0 { return device.fail(&mut r, code, .Ui) }

    r.atlas.atlasImage = image
    r.atlas.atlasMemory = memory
    r.atlas.atlasView = view
    code = device.sampled_texture(&r.api, r.device, &mut r.atlas.texture)
    if code != 0 { return device.fail(&mut r, code, .Ui) }
    device.sample_view(&r, &r.atlas.texture, view)
    .Ready
}

unsafe fn create_pipeline(r: &mut state.Renderer) -> state.SetupStep {
    vert := shader.ui_vertex()
    frag := shader.ui_fragment()
    mut vert_module := ptr(0)
    mut code := device.shader_module(&r, addr(&vert[0]), usize(vert.len * 4), addr(&mut vert_module))
    if code != 0 { return device.fail(&mut r, code, .Ui) }
    mut frag_module := ptr(0)
    code = device.shader_module(&r, addr(&frag[0]), usize(frag.len * 4), addr(&mut frag_module))
    if code != 0 { return device.fail(&mut r, code, .Ui) }
    r.atlas.vertShader = vert_module
    r.atlas.fragShader = frag_module

    // UI quads blend alpha-over over the frame, in frame coordinates, and
    // never touch depth. One vertex is 8 floats: xy = position, zw = uv, rgba.
    mut push_range: vk2.PushConstantRange = zeroed()
    push_range.stageFlags = enums.shader_stage(.Vertex)
    push_range.size = 16
    mut layout_info: vk2.PipelineLayoutCreateInfo = vk2.PipelineLayoutCreateInfo::new()
    layout_info.setLayoutCount = 1
    layout_info.pSetLayouts = addr(&mut r.atlas.texture.layout)
    layout_info.pushConstantRangeCount = 1
    layout_info.pPushConstantRanges = addr(&mut push_range)
    code = r.api.CreatePipelineLayout(r.device, addr(&layout_info), ptr(0), addr(&mut r.atlas.pipelineLayout))
    if code != 0 { return device.fail(&mut r, code, .Ui) }

    plan := pipelines.Plan {
        vertex: r.atlas.vertShader, fragment: r.atlas.fragShader,
        layout: r.atlas.pipelineLayout, pass: r.renderPass,
        cull: .None, depth: pipelines.depth_off(), blend: .Some(records.alpha_over()),
        vertices: .Ui(FLOATS_PER_VERTEX * 4), viewport: .Frame, encoded: true,
    }
    mut pipeline := ptr(0)
    code = pipelines.build(&r, &plan, addr(&mut pipeline))
    if code != 0 { return device.fail(&mut r, code, .Ui) }
    r.atlas.pipeline = pipeline
    .Ready
}

unsafe fn create_buffer(r: &mut state.Renderer, bytes: u64) -> state.SetupStep {
    mut info: vk2.BufferCreateInfo = vk2.BufferCreateInfo::new()
    info.size = bytes
    info.usage = enums.buffer_usage(.VertexBuffer)
    info.sharingMode = enums.sharing_mode(.Exclusive)
    mut handle := ptr(0)
    mut code := r.api.CreateBuffer(r.device, addr(&info), ptr(0), addr(&mut handle))
    if code != 0 { return device.fail(&mut r, code, .Ui) }
    mut requirements: vk2.MemoryRequirements = zeroed()
    r.api.GetBufferMemoryRequirements(r.device, handle, addr(&mut requirements))
    mut memory := ptr(0)
    code = device.allocate(&r, &requirements, .Some(enums.Memory.HostVisibleCoherent), addr(&mut memory))
    if code != 0 { return device.fail(&mut r, code, .Ui) }
    if memory == ptr(0) { return .Ui }
    code = r.api.BindBufferMemory(r.device, handle, memory, 0)
    if code != 0 { return device.fail(&mut r, code, .Ui) }
    mut mapped := ptr(0)
    code = r.api.MapMemory(r.device, memory, 0, bytes, 0, addr(&mut mapped))
    if code != 0 { return device.fail(&mut r, code, .Ui) }
    r.atlas.vertex.handle = handle
    r.atlas.vertex.memory = memory
    r.atlas.vertex.mapped = mapped
    r.atlas.vertex.capacity = bytes
    .Ready
}

pub unsafe fn setup(r: &mut state.Renderer) -> state.SetupStep {
    if create_atlas(&mut r) != .Ready {
        _ := sys.eprint("ui: no atlas")
        return .Ui
    }
    if create_pipeline(&mut r) != .Ready { return .Ui }
    if create_buffer(&mut r, 1048576) != .Ready { return .Ui }
    .Ready
}

// Upload the coverage atlas once the glyphs have been packed. The pixels go
// through a host-visible staging buffer because the atlas itself has to be
// OPTIMAL tiled to be sampleable on this driver.
pub unsafe fn upload_atlas(r: &mut state.Renderer, pixels: []u8, width: i32, height: i32) -> state.SetupStep {
    if width <= 0 || height <= 0 || width > i32(ATLAS_SIZE) || height > i32(ATLAS_SIZE) { return .Ui }
    pixels_count := u64(width) * u64(height)
    if pixels_count == 0 { return .Ui }
    // The copy below widens exactly one coverage byte per atlas pixel; a slice
    // of another length would read past it or leave the tail of the image stale.
    if u64(pixels.len) != pixels_count { return .Ui }
    bytes := pixels_count * 4

    mut stage_info: vk2.BufferCreateInfo = vk2.BufferCreateInfo::new()
    stage_info.size = bytes
    stage_info.usage = enums.buffer_usage(.TransferSrc)
    stage_info.sharingMode = enums.sharing_mode(.Exclusive)
    mut staging := ptr(0)
    mut code := r.api.CreateBuffer(r.device, addr(&stage_info), ptr(0), addr(&mut staging))
    if code != 0 { return device.fail(&mut r, code, .Ui) }
    mut requirements: vk2.MemoryRequirements = zeroed()
    r.api.GetBufferMemoryRequirements(r.device, staging, addr(&mut requirements))
    mut staging_memory := ptr(0)
    code = device.allocate(&r, &requirements, .Some(enums.Memory.HostVisibleCoherent), addr(&mut staging_memory))
    if code != 0 { return device.fail(&mut r, code, .Ui) }
    code = r.api.BindBufferMemory(r.device, staging, staging_memory, 0)
    if code != 0 { return device.fail(&mut r, code, .Ui) }
    mut mapped := ptr(0)
    code = r.api.MapMemory(r.device, staging_memory, 0, bytes, 0, addr(&mut mapped))
    if code != 0 { return device.fail(&mut r, code, .Ui) }
    // Widen the coverage bytes to floats so the atlas matches the shadow map's
    // format, which this driver samples without trouble. The widening happens in
    // a local array and is memcpy'd in: store_f32 on a computed pointer does not
    // reach memory here (same Dunder quirk as the light buffer).
    mut widened: []f32 = []
    widened.reserve(pixels.len)
    for i in 0..pixels.len { widened.push(f32(pixels[i]) / 255.0) }
    _ := copy_bytes(mapped, ptr(usize(addr(&widened[0]))), usize(bytes))

    mut alloc: vk2.CommandBufferAllocateInfo = vk2.CommandBufferAllocateInfo::new()
    alloc.commandPool = r.pool
    alloc.level = 0
    alloc.commandBufferCount = 1
    mut cmd := ptr(0)
    code = r.api.AllocateCommandBuffers(r.device, addr(&alloc), addr(&mut cmd))
    if code != 0 { return device.fail(&mut r, code, .Ui) }
    mut begin: vk2.CommandBufferBeginInfo = vk2.CommandBufferBeginInfo::new()
    begin.flags = enums.command_buffer_usage(.OneTimeSubmit)
    code = r.api.BeginCommandBuffer(cmd, addr(&begin))
    if code != 0 { return device.fail(&mut r, code, .Ui) }

    mut to_transfer: vk2.ImageMemoryBarrier = vk2.ImageMemoryBarrier::new()
    to_transfer.dstAccessMask = enums.access(.TransferWrite)
    to_transfer.oldLayout = enums.image_layout(.Undefined)
    to_transfer.newLayout = enums.image_layout(.TransferDstOptimal)
    to_transfer.srcQueueFamilyIndex = enums.QUEUE_FAMILY_IGNORED
    to_transfer.dstQueueFamilyIndex = enums.QUEUE_FAMILY_IGNORED
    to_transfer.image = r.atlas.atlasImage
    to_transfer.subresourceRange.aspectMask = enums.image_aspect(.Color)
    to_transfer.subresourceRange.levelCount = 1
    to_transfer.subresourceRange.layerCount = 1
    r.api.CmdPipelineBarrier(cmd, enums.pipeline_stage(.FragmentShader), enums.pipeline_stage(.Transfer), 0, 0, ptr(0), 0, ptr(0), 1, addr(&mut to_transfer))

    mut copy: vk2.BufferImageCopy = zeroed()
    copy.imageSubresource.aspectMask = enums.image_aspect(.Color)
    copy.imageSubresource.mipLevel = 0
    copy.imageSubresource.baseArrayLayer = 0
    copy.imageSubresource.layerCount = 1
    copy.imageExtent.width = u32(width)
    copy.imageExtent.height = u32(height)
    copy.imageExtent.depth = 1
    r.api.CmdCopyBufferToImage(cmd, staging, r.atlas.atlasImage, enums.image_layout(.TransferDstOptimal), 1, addr(&mut copy))

    mut to_sample: vk2.ImageMemoryBarrier = vk2.ImageMemoryBarrier::new()
    to_sample.srcAccessMask = enums.access(.TransferWrite)
    to_sample.dstAccessMask = enums.access(.ShaderRead)
    to_sample.oldLayout = enums.image_layout(.TransferDstOptimal)
    to_sample.newLayout = enums.image_layout(.ShaderReadOnlyOptimal)
    to_sample.srcQueueFamilyIndex = enums.QUEUE_FAMILY_IGNORED
    to_sample.dstQueueFamilyIndex = enums.QUEUE_FAMILY_IGNORED
    to_sample.image = r.atlas.atlasImage
    to_sample.subresourceRange.aspectMask = enums.image_aspect(.Color)
    to_sample.subresourceRange.levelCount = 1
    to_sample.subresourceRange.layerCount = 1
    r.api.CmdPipelineBarrier(cmd, enums.pipeline_stage(.Transfer), enums.pipeline_stage(.FragmentShader), 0, 0, ptr(0), 0, ptr(0), 1, addr(&mut to_sample))

    code = r.api.EndCommandBuffer(cmd)
    if code != 0 { return device.fail(&mut r, code, .Ui) }
    mut submit: vk2.SubmitInfo = vk2.SubmitInfo::new()
    submit.commandBufferCount = 1
    submit.pCommandBuffers = addr(&mut cmd)
    code = r.api.QueueSubmit(r.queue, 1, addr(&submit), ptr(0))
    if code != 0 { return device.fail(&mut r, code, .Ui) }
    _ := r.api.QueueWaitIdle(r.queue)
    _ := r.api.FreeCommandBuffers(r.device, r.pool, 1, addr(&mut cmd))
    _ := r.api.UnmapMemory(r.device, staging_memory)
    r.api.DestroyBuffer(r.device, staging, ptr(0))
    r.api.FreeMemory(r.device, staging_memory, ptr(0))
    .Ready
}

// Push vertices and draw them. Rectangles set uv.x to -1.
pub unsafe fn draw(r: &mut state.Renderer, vertices: []f32, screen: [f32; 2]) -> bool {
    if (state.pass(&r) != .Direct && state.pass(&r) != .Composite) || vertices.len == 0 { return false }
    bytes := u64(vertices.len) * 4
    if r.atlas.cursor + bytes > r.atlas.vertex.capacity { return false }
    _ := copy_bytes(ptr(usize(r.atlas.vertex.mapped) + usize(r.atlas.cursor)), ptr(usize(addr(&vertices[0]))), usize(bytes))
    slot := r.current
    r.api.CmdBindPipeline(r.commands[slot], 0, r.atlas.pipeline)
    r.api.CmdBindDescriptorSets(r.commands[slot], 0, r.atlas.pipelineLayout, 0, 1, addr(&r.atlas.texture.set), 0, ptr(0))
    mut push := [screen[0], screen[1], 0.0, 0.0]
    r.api.CmdPushConstants(r.commands[slot], r.atlas.pipelineLayout, enums.shader_stage(.Vertex), 0, 16, addr(&mut push[0]))
    mut offset: u64 = r.atlas.cursor
    r.api.CmdBindVertexBuffers(r.commands[slot], 0, 1, addr(&r.atlas.vertex.handle), addr(&mut offset))
    count := i32(vertices.len) / i32(FLOATS_PER_VERTEX)
    r.api.CmdDraw(r.commands[slot], u32(count), 1, 0, 0)
    r.atlas.cursor = r.atlas.cursor + bytes
    true
}

// The frame's UI stream starts empty; draw() appends to it. Called by
// begin_frame, the one place that knows a frame has begun.
pub unsafe fn reset(r: &mut state.Renderer) {
    r.atlas.cursor = 0
}

pub unsafe fn destroy(r: &mut state.Renderer) {
    if r.device == ptr(0) { return }
    r.api.DestroyShaderModule(r.device, r.atlas.vertShader, ptr(0))
    r.api.DestroyShaderModule(r.device, r.atlas.fragShader, ptr(0))
    if r.atlas.vertex.mapped != ptr(0) { r.api.UnmapMemory(r.device, r.atlas.vertex.memory) }
    r.api.DestroyBuffer(r.device, r.atlas.vertex.handle, ptr(0))
    r.api.FreeMemory(r.device, r.atlas.vertex.memory, ptr(0))
    if r.atlas.pipeline != ptr(0) { r.api.DestroyPipeline(r.device, r.atlas.pipeline, ptr(0)) }
    if r.atlas.pipelineLayout != ptr(0) { r.api.DestroyPipelineLayout(r.device, r.atlas.pipelineLayout, ptr(0)) }
    device.destroy_texture(&r, &r.atlas.texture)
    if r.atlas.atlasView != ptr(0) { r.api.DestroyImageView(r.device, r.atlas.atlasView, ptr(0)) }
    if r.atlas.atlasImage != ptr(0) { r.api.DestroyImage(r.device, r.atlas.atlasImage, ptr(0)) }
    r.api.FreeMemory(r.device, r.atlas.atlasMemory, ptr(0))
}
