capability unsafe, stdio

import std.sys as sys
import .device as device
import .enums as enums
import .layout as vk2
import .shader as shader
import .state as state

// Immediate-mode UI drawing.
//
// One dynamic vertex buffer holds solid rectangles and glyph quads. Rectangles
// use uv.x < 0 and are filled with the vertex colour; glyphs sample the
// coverage atlas uploaded from the text package.

// The coverage bytes are widened to f32 before upload, so the atlas is a
// single-channel float image (finding 30: linear-tiled R8 did not sample here).

const FLOATS_PER_VERTEX: u32 = 8
const ATLAS_SIZE: u32 = 1024

// The alpha-over blend shared with the overlay pipeline: colour and alpha are
// weighted by the source alpha, so a quad with zero coverage leaves the target
// untouched. The earlier 5/6 pair was ONE_MINUS_DST_COLOR / SRC_ALPHA, which
// inverts whatever is underneath and painted a box around every glyph (dogfood
// finding 40).
@extern("c", "memcpy")
unsafe fn copy_bytes(destination: ptr, source: ptr, bytes: usize) -> ptr

@c_layout
struct AtlasImage { image: ptr, memory: ptr, mapped: ptr }

unsafe fn create_atlas(r: &mut state.Renderer) -> state.SetupStep {
    mut words: [u32; 22] = [0; 22]
    words[0] = 14
    words[5] = 1
    words[6] = enums.format(.R32_SFLOAT)
    words[7] = ATLAS_SIZE
    words[8] = ATLAS_SIZE
    words[9] = 1
    words[10] = 1
    words[11] = 1
    words[12] = 1
    words[13] = 1 // OPTIMAL: linear-tiled images are not sampleable here
    words[14] = 6 // VK_IMAGE_USAGE_SAMPLED_BIT | TRANSFER_DST_BIT
    mut image := ptr(0)
    mut code := r.api.CreateImage(r.device, addr(&mut words[0]), ptr(0), addr(&mut image))
    if code != 0 { return device.fail(&mut r, code, .Ui) }
    mut requirements: vk2.MemoryRequirements = zeroed()
    r.api.GetImageMemoryRequirements(r.device, image, addr(&mut requirements))
    mut memory := ptr(0)
    code = device.allocate(&r, &requirements, 6, addr(&mut memory))
    if code != 0 { return device.fail(&mut r, code, .Ui) }
    if memory == ptr(0) { return .Ui }
    code = r.api.BindImageMemory(r.device, image, memory, 0)
    if code != 0 { return device.fail(&mut r, code, .Ui) }
    mut view_info: vk2.ImageViewCreateInfo = zeroed()
    view_info.sType = 15
    view_info.image = image
    view_info.viewType = enums.image_view_type(.Type2D)
    view_info.format = enums.format(.R32_SFLOAT)
    view_info.subresourceRange.aspectMask = enums.image_aspect(.Color)
    view_info.subresourceRange.levelCount = 1
    view_info.subresourceRange.layerCount = 1
    mut view := ptr(0)
    code = r.api.CreateImageView(r.device, addr(&view_info), ptr(0), addr(&mut view))
    if code != 0 { return device.fail(&mut r, code, .Ui) }

    mut sampler_info: vk2.SamplerCreateInfo = zeroed()
    sampler_info.sType = 31
    // Glyph quads are drawn at roughly 0.8 of the rasterized size, so the
    // lookup lands between texels: LINEAR filtering keeps the strokes smooth.
    sampler_info.magFilter = enums.filter(.Linear)
    sampler_info.minFilter = enums.filter(.Linear)
    sampler_info.mipmapMode = enums.sampler_mipmap_mode(.Nearest) // single level
    sampler_info.addressModeU = enums.sampler_address_mode(.ClampToEdge)
    sampler_info.addressModeV = enums.sampler_address_mode(.ClampToEdge)
    sampler_info.addressModeW = enums.sampler_address_mode(.ClampToEdge)
    sampler_info.maxLod = 1.0
    mut sampler := ptr(0)
    code = r.api.CreateSampler(r.device, addr(&sampler_info), ptr(0), addr(&mut sampler))
    if code != 0 { return device.fail(&mut r, code, .Ui) }

    mut binding: [u64; 3] = [0; 3]
    binding[0] = enums.binding_word(0, .CombinedImageSampler)
    binding[1] = enums.stages_word(1, .Fragment)
    mut layout_info: vk2.DescriptorSetLayoutCreateInfo = zeroed()
    layout_info.sType = 32
    layout_info.bindingCount = 1
    layout_info.pBindings = ptr(usize(addr(&mut binding[0])))
    code = r.api.CreateDescriptorSetLayout(r.device, addr(&layout_info), ptr(0), addr(&mut r.uiSetLayout))
    if code != 0 { return device.fail(&mut r, code, .Ui) }

    mut pool_size: [u32; 2] = [1, 1]
    mut pool_info: vk2.DescriptorPoolCreateInfo = zeroed()
    pool_info.sType = 33
    pool_info.maxSets = 1
    pool_info.poolSizeCount = 1
    pool_info.pPoolSizes = ptr(usize(addr(&mut pool_size[0])))
    code = r.api.CreateDescriptorPool(r.device, addr(&pool_info), ptr(0), addr(&mut r.uiPool))
    if code != 0 { return device.fail(&mut r, code, .Ui) }

    mut allocate_info: vk2.DescriptorSetAllocateInfo = zeroed()
    allocate_info.sType = 34
    allocate_info.descriptorPool = r.uiPool
    allocate_info.descriptorSetCount = 1
    allocate_info.pSetLayouts = addr(&mut r.uiSetLayout)
    code = r.api.AllocateDescriptorSets(r.device, addr(&allocate_info), addr(&mut r.uiSet))
    if code != 0 { return device.fail(&mut r, code, .Ui) }

    mut image_info: vk2.DescriptorImageInfo = zeroed()
    image_info.sampler = sampler
    image_info.imageView = view
    image_info.imageLayout = enums.image_layout(.ShaderReadOnlyOptimal)
    mut write: vk2.WriteDescriptorSet = zeroed()
    write.sType = 35
    write.dstSet = r.uiSet
    write.dstBinding = 0
    write.descriptorCount = 1
    write.descriptorType = enums.descriptor_type(.CombinedImageSampler)
    write.pImageInfo = addr(&mut image_info)
    r.api.UpdateDescriptorSets(r.device, 1, addr(&mut write), 0, ptr(0))

    r.uiAtlasImage = image
    r.uiAtlasMemory = memory
    r.uiAtlasView = view
    r.uiSampler = sampler
    .Ready
}

unsafe fn create_pipeline(r: &mut state.Renderer) -> state.SetupStep {
    vert := shader.ui_vertex()
    frag := shader.ui_fragment()
    mut vert_module := ptr(0)
    mut code := device.shader_module(&r, addr(&vert[0]), usize(vert.len * 4), addr(&mut vert_module))
    if code != 0 { return device.fail(&mut r, code, .Ui) }
    mut frag_module := ptr(0)
    code = device.shader_module(&r, addr(&frag[0]), usize(frag.len * 4), addr(&mut frag_module))
    if code != 0 { return device.fail(&mut r, code, .Ui) }
    r.uiVertShader = vert_module
    r.uiFragShader = frag_module

    stages := vk2.ShaderStages {
        vertex: vk2.PipelineShaderStageCreateInfo { sType: 18, pNext: ptr(0), flags: 0, stage: enums.shader_stage(.Vertex), module: r.uiVertShader, pName: cstr("main"), pSpecializationInfo: ptr(0) },
        fragment: vk2.PipelineShaderStageCreateInfo { sType: 18, pNext: ptr(0), flags: 0, stage: enums.shader_stage(.Fragment), module: r.uiFragShader, pName: cstr("main"), pSpecializationInfo: ptr(0) },
    }

    mut binding_desc: vk2.VertexInputBindingDescription = zeroed()
    binding_desc.binding = 0
    binding_desc.stride = FLOATS_PER_VERTEX * 4
    binding_desc.inputRate = enums.vertex_input_rate(.Vertex)

    // One vertex is 8 floats: xy = position, zw = uv, then rgba.
    attributes := vk2.Attributes {
        first: vk2.VertexInputAttributeDescription { location: 0, binding: 0, format: enums.format(.R32G32B32A32_SFLOAT), offset: 0 },
        second: vk2.VertexInputAttributeDescription { location: 1, binding: 0, format: enums.format(.R32G32B32A32_SFLOAT), offset: 16 },
    }

    mut vertex_input: vk2.PipelineVertexInputStateCreateInfo = zeroed()
    vertex_input.sType = 19
    vertex_input.vertexBindingDescriptionCount = 1
    vertex_input.pVertexBindingDescriptions = addr(&mut binding_desc)
    vertex_input.vertexAttributeDescriptionCount = 2
    vertex_input.pVertexAttributeDescriptions = addr(&attributes)

    mut assembly: vk2.PipelineInputAssemblyStateCreateInfo = zeroed()
    assembly.sType = 20
    assembly.topology = enums.primitive_topology(.TriangleList)

    // A fixed viewport must be supplied: without pViewports the pipeline draws
    // nothing at all on this driver.
    mut viewport: vk2.Viewport = zeroed()
    viewport.width = f32(r.width)
    viewport.height = f32(r.height)
    viewport.maxDepth = 1.0
    mut scissor: vk2.Rect2D = zeroed()
    scissor.extent.width = r.width
    scissor.extent.height = r.height
    mut viewport_state: vk2.PipelineViewportStateCreateInfo = zeroed()
    viewport_state.sType = 22
    viewport_state.viewportCount = 1
    viewport_state.pViewports = addr(&mut viewport)
    viewport_state.scissorCount = 1
    viewport_state.pScissors = addr(&mut scissor)

    mut raster: vk2.PipelineRasterizationStateCreateInfo = zeroed()
    raster.sType = 23
    raster.polygonMode = enums.polygon_mode(.Fill)
    raster.cullMode = enums.cull_mode(.None)
    raster.frontFace = enums.front_face(.Clockwise)
    raster.lineWidth = 1.0

    mut multisample: vk2.PipelineMultisampleStateCreateInfo = zeroed()
    multisample.sType = 24
    multisample.rasterizationSamples = 1

    mut depth: vk2.PipelineDepthStencilStateCreateInfo = zeroed()
    depth.sType = 25

    mut blend_attachment: vk2.PipelineColorBlendAttachmentState = zeroed()
    enums.apply_blend(&mut blend_attachment, &enums.alpha_over())

    mut blend: vk2.PipelineColorBlendStateCreateInfo = zeroed()
    blend.sType = 26
    blend.attachmentCount = 1
    blend.pAttachments = addr(&mut blend_attachment)

    mut push_range: vk2.PushConstantRange = zeroed()
    push_range.stageFlags = enums.shader_stage(.Vertex)
    push_range.size = 16

    mut layout_info: vk2.PipelineLayoutCreateInfo = zeroed()
    layout_info.sType = 30
    layout_info.setLayoutCount = 1
    layout_info.pSetLayouts = addr(&mut r.uiSetLayout)
    layout_info.pushConstantRangeCount = 1
    layout_info.pPushConstantRanges = addr(&mut push_range)
    code = r.api.CreatePipelineLayout(r.device, addr(&layout_info), ptr(0), addr(&mut r.uiPipelineLayout))
    if code != 0 { return device.fail(&mut r, code, .Ui) }

    mut info: vk2.GraphicsPipelineCreateInfo = zeroed()
    info.sType = 28
    info.stageCount = 2
    info.pStages = addr(&stages)
    info.pVertexInputState = addr(&mut vertex_input)
    info.pInputAssemblyState = addr(&mut assembly)
    info.pViewportState = addr(&mut viewport_state)
    info.pRasterizationState = addr(&mut raster)
    info.pMultisampleState = addr(&mut multisample)
    info.pDepthStencilState = addr(&mut depth)
    info.pColorBlendState = addr(&mut blend)
    info.layout = r.uiPipelineLayout
    info.renderPass = r.renderPass
    info.subpass = 0
    info.basePipelineIndex = -1
    code = r.api.CreateGraphicsPipelines(r.device, ptr(0), 1, addr(&mut info), ptr(0), addr(&mut r.uiPipeline))
    if code != 0 { return device.fail(&mut r, code, .Ui) }

    .Ready
}

unsafe fn create_buffer(r: &mut state.Renderer, bytes: u64) -> state.SetupStep {
    mut info: vk2.BufferCreateInfo = zeroed()
    info.sType = 12
    info.size = bytes
    info.usage = enums.buffer_usage(.VertexBuffer)
    info.sharingMode = enums.sharing_mode(.Exclusive)
    mut handle := ptr(0)
    mut code := r.api.CreateBuffer(r.device, addr(&info), ptr(0), addr(&mut handle))
    if code != 0 { return device.fail(&mut r, code, .Ui) }
    mut requirements: vk2.MemoryRequirements = zeroed()
    r.api.GetBufferMemoryRequirements(r.device, handle, addr(&mut requirements))
    mut memory := ptr(0)
    code = device.allocate(&r, &requirements, 6, addr(&mut memory))
    if code != 0 { return device.fail(&mut r, code, .Ui) }
    if memory == ptr(0) { return .Ui }
    code = r.api.BindBufferMemory(r.device, handle, memory, 0)
    if code != 0 { return device.fail(&mut r, code, .Ui) }
    mut mapped := ptr(0)
    code = r.api.MapMemory(r.device, memory, 0, bytes, 0, addr(&mut mapped))
    if code != 0 { return device.fail(&mut r, code, .Ui) }
    r.uiVertex.handle = handle
    r.uiVertex.memory = memory
    r.uiVertex.mapped = mapped
    r.uiVertex.capacity = bytes
    .Ready
}

pub unsafe fn setup(r: &mut state.Renderer) -> state.SetupStep {
    if create_atlas(&mut r) != .Ready {
        _ := sys.eprint("ui: no atlas")
        return .Ui
    }
    if create_pipeline(&mut r) != .Ready { return .Ui }
    if create_buffer(&mut r, 1048576) != .Ready { return .Ui }
    .Ready
}

// Upload the coverage atlas once the glyphs have been packed. The pixels go
// through a host-visible staging buffer because the atlas itself has to be
// OPTIMAL tiled to be sampleable on this driver.
pub unsafe fn upload_atlas(r: &mut state.Renderer, pixels: []u8, width: i32, height: i32) -> state.SetupStep {
    if width <= 0 || height <= 0 || width > i32(ATLAS_SIZE) || height > i32(ATLAS_SIZE) { return .Ui }
    pixels_count := u64(width) * u64(height)
    if pixels_count == 0 { return .Ui }
    // The copy below widens exactly one coverage byte per atlas pixel; a slice
    // of another length would read past it or leave the tail of the image stale.
    if u64(pixels.len) != pixels_count { return .Ui }
    bytes := pixels_count * 4

    mut stage_info: vk2.BufferCreateInfo = zeroed()
    stage_info.sType = 12
    stage_info.size = bytes
    stage_info.usage = enums.buffer_usage(.TransferSrc)
    stage_info.sharingMode = enums.sharing_mode(.Exclusive)
    mut staging := ptr(0)
    mut code := r.api.CreateBuffer(r.device, addr(&stage_info), ptr(0), addr(&mut staging))
    if code != 0 { return device.fail(&mut r, code, .Ui) }
    mut requirements: vk2.MemoryRequirements = zeroed()
    r.api.GetBufferMemoryRequirements(r.device, staging, addr(&mut requirements))
    mut staging_memory := ptr(0)
    code = device.allocate(&r, &requirements, 6, addr(&mut staging_memory))
    if code != 0 { return device.fail(&mut r, code, .Ui) }
    code = r.api.BindBufferMemory(r.device, staging, staging_memory, 0)
    if code != 0 { return device.fail(&mut r, code, .Ui) }
    mut mapped := ptr(0)
    code = r.api.MapMemory(r.device, staging_memory, 0, bytes, 0, addr(&mut mapped))
    if code != 0 { return device.fail(&mut r, code, .Ui) }
    // Widen the coverage bytes to floats so the atlas matches the shadow map's
    // format, which this driver samples without trouble. The widening happens in
    // a local array and is memcpy'd in: store_f32 on a computed pointer does not
    // reach memory here (same Dunder quirk as the light buffer).
    mut widened: []f32 = []
    widened.reserve(pixels.len)
    for i in 0..pixels.len { widened.push(f32(pixels[i]) / 255.0) }
    _ := copy_bytes(mapped, ptr(usize(addr(&widened[0]))), usize(bytes))

    mut alloc: vk2.CommandBufferAllocateInfo = zeroed()
    alloc.sType = 40
    alloc.commandPool = r.pool
    alloc.level = 0
    alloc.commandBufferCount = 1
    mut cmd := ptr(0)
    code = r.api.AllocateCommandBuffers(r.device, addr(&alloc), addr(&mut cmd))
    if code != 0 { return device.fail(&mut r, code, .Ui) }
    mut begin: vk2.CommandBufferBeginInfo = zeroed()
    begin.sType = 42
    begin.flags = enums.command_buffer_usage(.OneTimeSubmit)
    code = r.api.BeginCommandBuffer(cmd, addr(&begin))
    if code != 0 { return device.fail(&mut r, code, .Ui) }

    mut to_transfer: vk2.ImageMemoryBarrier = zeroed()
    to_transfer.sType = 45
    to_transfer.dstAccessMask = enums.access(.TransferWrite)
    to_transfer.oldLayout = enums.image_layout(.Undefined)
    to_transfer.newLayout = enums.image_layout(.TransferDstOptimal)
    to_transfer.srcQueueFamilyIndex = 4294967295
    to_transfer.dstQueueFamilyIndex = 4294967295
    to_transfer.image = r.uiAtlasImage
    to_transfer.subresourceRange.aspectMask = enums.image_aspect(.Color)
    to_transfer.subresourceRange.levelCount = 1
    to_transfer.subresourceRange.layerCount = 1
    r.api.CmdPipelineBarrier(cmd, 1, 4096, 0, 0, ptr(0), 0, ptr(0), 1, addr(&mut to_transfer))

    mut copy: vk2.BufferImageCopy = zeroed()
    copy.imageSubresource.aspectMask = enums.image_aspect(.Color)
    copy.imageSubresource.mipLevel = 0
    copy.imageSubresource.baseArrayLayer = 0
    copy.imageSubresource.layerCount = 1
    copy.imageExtent.width = u32(width)
    copy.imageExtent.height = u32(height)
    copy.imageExtent.depth = 1
    r.api.CmdCopyBufferToImage(cmd, staging, r.uiAtlasImage, 3, 1, addr(&mut copy))

    mut to_sample: vk2.ImageMemoryBarrier = zeroed()
    to_sample.sType = 45
    to_sample.srcAccessMask = enums.access(.TransferWrite)
    to_sample.dstAccessMask = enums.access(.ShaderRead)
    to_sample.oldLayout = enums.image_layout(.TransferDstOptimal)
    to_sample.newLayout = enums.image_layout(.ShaderReadOnlyOptimal)
    to_sample.srcQueueFamilyIndex = 4294967295
    to_sample.dstQueueFamilyIndex = 4294967295
    to_sample.image = r.uiAtlasImage
    to_sample.subresourceRange.aspectMask = enums.image_aspect(.Color)
    to_sample.subresourceRange.levelCount = 1
    to_sample.subresourceRange.layerCount = 1
    r.api.CmdPipelineBarrier(cmd, 4096, 128, 0, 0, ptr(0), 0, ptr(0), 1, addr(&mut to_sample))

    code = r.api.EndCommandBuffer(cmd)
    if code != 0 { return device.fail(&mut r, code, .Ui) }
    mut submit: vk2.SubmitInfo = zeroed()
    submit.sType = 4
    submit.commandBufferCount = 1
    submit.pCommandBuffers = addr(&mut cmd)
    code = r.api.QueueSubmit(r.queue, 1, addr(&submit), ptr(0))
    if code != 0 { return device.fail(&mut r, code, .Ui) }
    _ := r.api.QueueWaitIdle(r.queue)
    _ := r.api.FreeCommandBuffers(r.device, r.pool, 1, addr(&mut cmd))
    _ := r.api.UnmapMemory(r.device, staging_memory)
    r.api.DestroyBuffer(r.device, staging, ptr(0))
    r.api.FreeMemory(r.device, staging_memory, ptr(0))
    .Ready
}

// Push vertices and draw them. Rectangles set uv.x to -1.
pub unsafe fn draw(r: &mut state.Renderer, vertices: []f32, screen: [f32; 2]) -> bool {
    if r.recording == 0 || vertices.len == 0 { return false }
    bytes := u64(vertices.len) * 4
    if r.uiCursor + bytes > r.uiVertex.capacity { return false }
    _ := copy_bytes(ptr(usize(r.uiVertex.mapped) + usize(r.uiCursor)), ptr(usize(addr(&vertices[0]))), usize(bytes))
    slot := r.current
    r.api.CmdBindPipeline(r.commands[slot], 0, r.uiPipeline)
    r.api.CmdBindDescriptorSets(r.commands[slot], 0, r.uiPipelineLayout, 0, 1, addr(&r.uiSet), 0, ptr(0))
    mut push := [screen[0], screen[1], 0.0, 0.0]
    r.api.CmdPushConstants(r.commands[slot], r.uiPipelineLayout, enums.shader_stage(.Vertex), 0, 16, addr(&mut push[0]))
    mut offset: u64 = r.uiCursor
    r.api.CmdBindVertexBuffers(r.commands[slot], 0, 1, addr(&r.uiVertex.handle), addr(&mut offset))
    count := i32(vertices.len) / i32(FLOATS_PER_VERTEX)
    r.api.CmdDraw(r.commands[slot], u32(count), 1, 0, 0)
    r.uiCursor = r.uiCursor + bytes
    true
}

pub unsafe fn reset(r: &mut state.Renderer) {
    r.uiCursor = 0
}

pub unsafe fn destroy(r: &mut state.Renderer) {
    if r.uiPipeline != ptr(0) { r.api.DestroyPipeline(r.device, r.uiPipeline, ptr(0)) }
    if r.uiPipelineLayout != ptr(0) { r.api.DestroyPipelineLayout(r.device, r.uiPipelineLayout, ptr(0)) }
    if r.uiSampler != ptr(0) { r.api.DestroySampler(r.device, r.uiSampler, ptr(0)) }
    if r.uiSetLayout != ptr(0) { r.api.DestroyDescriptorSetLayout(r.device, r.uiSetLayout, ptr(0)) }
    if r.uiPool != ptr(0) { r.api.DestroyDescriptorPool(r.device, r.uiPool, ptr(0)) }
    if r.uiAtlasView != ptr(0) { r.api.DestroyImageView(r.device, r.uiAtlasView, ptr(0)) }
    if r.uiAtlasImage != ptr(0) { r.api.DestroyImage(r.device, r.uiAtlasImage, ptr(0)) }
}
