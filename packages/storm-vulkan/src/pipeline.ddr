capability unsafe

import .device as device
import .enums as enums
import .layout as vk
import .shader as shader
import .state as state

unsafe fn targets(r: &mut state.Renderer) -> state.SetupStep {
    mut color: vk.AttachmentDescription = zeroed()
    color.format = r.format
    color.samples = enums.samples(.Type1)
    color.loadOp = enums.attachment_load_op(.Clear)
    // STORE matters now: the post pass samples this image afterwards.
    color.storeOp = enums.attachment_store_op(.Store)
    color.stencilLoadOp = enums.attachment_load_op(.DontCare)
    color.stencilStoreOp = enums.attachment_store_op(.DontCare)
    color.initialLayout = enums.image_layout(.Undefined)
    // The target is left ready for presentation: end_frame transitions it.
    color.finalLayout = enums.image_layout(.ColorAttachmentOptimal)
    mut depth: vk.AttachmentDescription = zeroed()
    depth.format = enums.format(.D32_SFLOAT)
    depth.samples = enums.samples(.Type1)
    depth.loadOp = enums.attachment_load_op(.Clear)
    depth.storeOp = enums.attachment_store_op(.DontCare)
    depth.stencilLoadOp = enums.attachment_load_op(.DontCare)
    depth.stencilStoreOp = enums.attachment_store_op(.DontCare)
    depth.initialLayout = enums.image_layout(.Undefined) // cleared anyway
    depth.finalLayout = enums.image_layout(.DepthStencilAttachmentOptimal)
    mut attachments := vk.Attachments { color: color, depth: depth }
    mut color_ref: vk.AttachmentReference = zeroed()
    color_ref.attachment = 0
    color_ref.layout = enums.image_layout(.ColorAttachmentOptimal)
    mut depth_ref: vk.AttachmentReference = zeroed()
    depth_ref.attachment = 1
    depth_ref.layout = enums.image_layout(.DepthStencilAttachmentOptimal)
    refs := vk.References { color: color_ref, depth: depth_ref }

    mut subpass: vk.SubpassDescription = zeroed()
    subpass.pipelineBindPoint = enums.pipeline_bind_point(.Graphics)
    subpass.colorAttachmentCount = 1
    subpass.pColorAttachments = addr(&refs.color)
    subpass.pDepthStencilAttachment = addr(&refs.depth)

    mut before: vk.SubpassDependency = zeroed()
    before.srcSubpass = enums.SUBPASS_EXTERNAL
    before.dstSubpass = 0
    before.srcStageMask = enums.pipeline_stage(.ColorAndDepthStages)
    before.dstStageMask = enums.pipeline_stage(.ColorAndDepthStages)
    before.srcAccessMask = enums.access(.ColorDepthWrite)
    before.dstAccessMask = enums.access(.ColorDepthWrite) + enums.access(.DepthStencilAttachmentRead)
    mut after: vk.SubpassDependency = zeroed()
    after.srcSubpass = 0
    after.dstSubpass = enums.SUBPASS_EXTERNAL
    after.srcStageMask = enums.pipeline_stage(.ColorAttachmentOutput)
    after.dstStageMask = enums.pipeline_stage(.Transfer)
    after.srcAccessMask = enums.access(.ColorAttachmentWrite)
    after.dstAccessMask = enums.access(.None)
    dependencies := vk.Dependencies { before: before, after: after }

    mut pass: vk.RenderPassCreateInfo = vk.RenderPassCreateInfo::new()
    pass.attachmentCount = 2
    pass.pAttachments = addr(&attachments)
    pass.subpassCount = 1
    pass.pSubpasses = addr(&subpass)
    pass.dependencyCount = 2
    pass.pDependencies = addr(&dependencies)
    mut code := r.api.CreateRenderPass(r.device, addr(&pass), ptr(0), addr(&mut r.renderPass))
    if code != 0 { return device.fail(&mut r, code, .Pipeline) }
    // The filtered scene keeps depth for its compatible composite/HUD pass.
    attachments.depth.storeOp = enums.attachment_store_op(.Store)
    code = r.api.CreateRenderPass(r.device, addr(&pass), ptr(0), addr(&mut r.scenePass))
    if code != 0 { return device.fail(&mut r, code, .PostProcess) }
    attachments.depth.loadOp = enums.attachment_load_op(.Load)
    attachments.depth.initialLayout = enums.image_layout(.DepthStencilAttachmentOptimal)
    attachments.depth.storeOp = enums.attachment_store_op(.DontCare)
    attachments.color.loadOp = enums.attachment_load_op(.DontCare)
    code = r.api.CreateRenderPass(r.device, addr(&pass), ptr(0), addr(&mut r.compositePass))
    if code != 0 { return device.fail(&mut r, code, .PostProcess) }
    .Ready
}

unsafe fn framebuffers(r: &mut state.Renderer) -> state.SetupStep {
    for i in 0..r.imageCount {
        mut framebuffer := ptr(0)
        code := device.color_framebuffer(&r, r.views[i], addr(&mut framebuffer))
        r.framebuffers[i] = framebuffer
        if code != 0 { return device.fail(&mut r, code, .Pipeline) }
    }
    .Ready
}

unsafe fn mesh_pipeline(r: &mut state.Renderer) -> state.SetupStep {
    vertex := shader.mesh_vertex()
    mut vertex_shader := r.vertexShader
    mut code := device.shader_module(&r, addr(&vertex[0]), usize(vertex.len * 4), addr(&mut vertex_shader))
    if code != 0 { return device.fail(&mut r, code, .Pipeline) }
    r.vertexShader = vertex_shader
    fragment := shader.mesh_fragment()
    mut fragment_shader := r.fragmentShader
    code = device.shader_module(&r, addr(&fragment[0]), usize(fragment.len * 4), addr(&mut fragment_shader))
    if code != 0 { return device.fail(&mut r, code, .Pipeline) }
    r.fragmentShader = fragment_shader

    // mvp(64) model(64) base_color(16) params(16) camera(16) sun(16)
    // sun_color(16) zenith(16) horizon(16) = 240 bytes. The light matrix lives
    // in a uniform buffer because 320 exceeds what this pipeline layout accepts.
    mut push_range: vk.PushConstantRange = zeroed()
    push_range.stageFlags = enums.shader_stage(.VertexFragment)
    push_range.offset = 0
    push_range.size = state.MESH_PUSH_BYTES
    mut layout: vk.PipelineLayoutCreateInfo = vk.PipelineLayoutCreateInfo::new()
    layout.pushConstantRangeCount = 1
    layout.pPushConstantRanges = addr(&push_range)
    // Set 0: shadow map sampler + light uniform buffer + environment.
    // Set 1: the material's base texture (texture.ddr). Both layouts exist
    // before this step (shadow.setup, texture.setup).
    r.meshSetLayouts = [r.shadowSetLayout, r.material.setLayout]
    layout.setLayoutCount = 2
    layout.pSetLayouts = addr(&r.meshSetLayouts[0])
    code = r.api.CreatePipelineLayout(r.device, addr(&layout), ptr(0), addr(&mut r.pipelineLayout))
    if code != 0 { return device.fail(&mut r, code, .Pipeline) }

    mut stage: vk.PipelineShaderStageCreateInfo = vk.PipelineShaderStageCreateInfo::new()
    stage.stage = enums.shader_stage(.Vertex)
    stage.module = r.vertexShader
    stage.pName = cstr("main")
    mut stages := vk.ShaderStages { vertex: stage, fragment: stage }
    stages.fragment.stage = enums.shader_stage(.Fragment)
    stages.fragment.module = r.fragmentShader
    mut encoding: vk.DisplayEncoding = zeroed()
    stages.fragment.pSpecializationInfo = device.display_encoding(r.format, &mut encoding)

    // The one mesh vertex layout (position, normal, uv), declared here and
    // in the shadow pipeline from the same record.
    mut vertex_input := vk.vertex_input()
    enums.apply_vertex_input(&mut vertex_input)
    mut input: vk.PipelineVertexInputStateCreateInfo = vk.PipelineVertexInputStateCreateInfo::new()
    input.vertexBindingDescriptionCount = 1
    input.pVertexBindingDescriptions = addr(&vertex_input.binding)
    input.vertexAttributeDescriptionCount = 3
    input.pVertexAttributeDescriptions = addr(&vertex_input.attributes)

    mut assembly: vk.PipelineInputAssemblyStateCreateInfo = vk.PipelineInputAssemblyStateCreateInfo::new()
    assembly.topology = enums.primitive_topology(.TriangleList)

    mut view: vk.FrameViewport = zeroed()
    device.frame_viewport(&mut view)

    mut raster: vk.PipelineRasterizationStateCreateInfo = vk.PipelineRasterizationStateCreateInfo::new()
    raster.polygonMode = enums.polygon_mode(.Fill)
    raster.cullMode = enums.cull_mode(.Back)
    // The projection negates Y for Vulkan's clip space, which mirrors the
    // winding, so counter-clockwise is the front face.
    raster.frontFace = enums.front_face(.CounterClockwise)
    raster.lineWidth = 1.0

    mut samples: vk.PipelineMultisampleStateCreateInfo = vk.PipelineMultisampleStateCreateInfo::new()
    samples.rasterizationSamples = 1

    mut depth_state: vk.PipelineDepthStencilStateCreateInfo = vk.PipelineDepthStencilStateCreateInfo::new()
    // Opaque geometry: closer fragments win and write their depth.
    depth_state.depthTestEnable = 1
    depth_state.depthWriteEnable = 1
    depth_state.depthCompareOp = enums.compare_op(.Less)

    mut blend_attachment: vk.PipelineColorBlendAttachmentState = zeroed()
    blend_attachment.colorWriteMask = enums.color_component(.RGBA)
    mut blend: vk.PipelineColorBlendStateCreateInfo = vk.PipelineColorBlendStateCreateInfo::new()
    blend.attachmentCount = 1
    blend.pAttachments = addr(&blend_attachment)

    mut info: vk.GraphicsPipelineCreateInfo = vk.GraphicsPipelineCreateInfo::new()
    info.stageCount = 2
    info.pStages = addr(&stages)
    info.pVertexInputState = addr(&input)
    info.pInputAssemblyState = addr(&assembly)
    info.pViewportState = addr(&view.viewport)
    info.pDynamicState = addr(&view.dynamic)
    info.pRasterizationState = addr(&raster)
    info.pMultisampleState = addr(&samples)
    info.pDepthStencilState = addr(&depth_state)
    info.pColorBlendState = addr(&blend)
    info.layout = r.pipelineLayout
    info.renderPass = r.renderPass
    info.basePipelineIndex = -1
    code = r.api.CreateGraphicsPipelines(r.device, ptr(0), 1, addr(&info), ptr(0), addr(&mut r.pipeline))
    if code != 0 { return device.fail(&mut r, code, .Pipeline) }
    // Same pipeline with alpha blending for the transparent pass.
    enums.apply_blend(&mut blend_attachment, &enums.alpha_over())
    // Glass is sorted back to front and must not hide geometry behind it:
    // test against the depth buffer, but never write to it.
    depth_state.depthWriteEnable = 0
    code = r.api.CreateGraphicsPipelines(r.device, ptr(0), 1, addr(&info), ptr(0), addr(&mut r.transparentPipeline))
    if code != 0 { return device.fail(&mut r, code, .Pipeline) }
    .Ready
}

// Sky: fullscreen triangle, no vertex buffer, depth test but no depth write.
unsafe fn sky_pipeline(r: &mut state.Renderer) -> state.SetupStep {
    vertex := shader.sky_vertex()
    mut vertex_shader := r.skyVertexShader
    mut code := device.shader_module(&r, addr(&vertex[0]), usize(vertex.len * 4), addr(&mut vertex_shader))
    if code != 0 { return device.fail(&mut r, code, .Pipeline) }
    r.skyVertexShader = vertex_shader
    fragment := shader.sky_fragment()
    mut fragment_shader := r.skyFragmentShader
    code = device.shader_module(&r, addr(&fragment[0]), usize(fragment.len * 4), addr(&mut fragment_shader))
    if code != 0 { return device.fail(&mut r, code, .Pipeline) }
    r.skyFragmentShader = fragment_shader

    // inv_view_proj(64) + sun(16) + zenith(16) + horizon(16) = 112 bytes.
    mut push_range: vk.PushConstantRange = zeroed()
    push_range.stageFlags = enums.shader_stage(.VertexFragment)
    push_range.offset = 0
    push_range.size = 112
    mut layout: vk.PipelineLayoutCreateInfo = vk.PipelineLayoutCreateInfo::new()
    layout.pushConstantRangeCount = 1
    layout.pPushConstantRanges = addr(&push_range)
    // Set 0: shadow map sampler + light uniform buffer.
    layout.setLayoutCount = 1
    layout.pSetLayouts = addr(&r.shadowSetLayout)
    code = r.api.CreatePipelineLayout(r.device, addr(&layout), ptr(0), addr(&mut r.skyPipelineLayout))
    if code != 0 { return device.fail(&mut r, code, .Pipeline) }

    mut stage: vk.PipelineShaderStageCreateInfo = vk.PipelineShaderStageCreateInfo::new()
    stage.stage = enums.shader_stage(.Vertex)
    stage.module = r.skyVertexShader
    stage.pName = cstr("main")
    mut stages := vk.ShaderStages { vertex: stage, fragment: stage }
    stages.fragment.stage = enums.shader_stage(.Fragment)
    stages.fragment.module = r.skyFragmentShader
    mut encoding: vk.DisplayEncoding = zeroed()
    stages.fragment.pSpecializationInfo = device.display_encoding(r.format, &mut encoding)

    mut input: vk.PipelineVertexInputStateCreateInfo = vk.PipelineVertexInputStateCreateInfo::new()
    mut assembly: vk.PipelineInputAssemblyStateCreateInfo = vk.PipelineInputAssemblyStateCreateInfo::new()
    assembly.topology = enums.primitive_topology(.TriangleList)

    mut view: vk.FrameViewport = zeroed()
    device.frame_viewport(&mut view)

    mut raster: vk.PipelineRasterizationStateCreateInfo = vk.PipelineRasterizationStateCreateInfo::new()
    raster.polygonMode = enums.polygon_mode(.Fill)
    raster.cullMode = enums.cull_mode(.None)
    raster.frontFace = enums.front_face(.Clockwise)
    raster.lineWidth = 1.0

    mut samples: vk.PipelineMultisampleStateCreateInfo = vk.PipelineMultisampleStateCreateInfo::new()
    samples.rasterizationSamples = 1

    mut depth_state: vk.PipelineDepthStencilStateCreateInfo = vk.PipelineDepthStencilStateCreateInfo::new()
    depth_state.depthTestEnable = 0
    depth_state.depthWriteEnable = 0
    depth_state.depthCompareOp = enums.compare_op(.LessOrEqual)

    mut blend_attachment: vk.PipelineColorBlendAttachmentState = zeroed()
    blend_attachment.colorWriteMask = enums.color_component(.RGBA)
    mut blend: vk.PipelineColorBlendStateCreateInfo = vk.PipelineColorBlendStateCreateInfo::new()
    blend.attachmentCount = 1
    blend.pAttachments = addr(&blend_attachment)

    mut info: vk.GraphicsPipelineCreateInfo = vk.GraphicsPipelineCreateInfo::new()
    info.stageCount = 2
    info.pStages = addr(&stages)
    info.pVertexInputState = addr(&input)
    info.pInputAssemblyState = addr(&assembly)
    info.pViewportState = addr(&view.viewport)
    info.pDynamicState = addr(&view.dynamic)
    info.pRasterizationState = addr(&raster)
    info.pMultisampleState = addr(&samples)
    info.pDepthStencilState = addr(&depth_state)
    info.pColorBlendState = addr(&blend)
    info.layout = r.skyPipelineLayout
    info.renderPass = r.renderPass
    info.basePipelineIndex = -1
    code = r.api.CreateGraphicsPipelines(r.device, ptr(0), 1, addr(&info), ptr(0), addr(&mut r.skyPipeline))
    if code != 0 { return device.fail(&mut r, code, .Pipeline) }
    .Ready
}

pub unsafe fn setup(r: &mut state.Renderer) -> state.SetupStep {
    mut step := targets(&mut r)
    if step != .Ready { return step }
    step = mesh_pipeline(&mut r)
    if step != .Ready { return step }
    step = sky_pipeline(&mut r)
    if step != .Ready { return step }
    framebuffers(&mut r)
}

// After a swapchain recreation only the framebuffers are size-dependent.
pub unsafe fn setup_frames_only(r: &mut state.Renderer) -> state.SetupStep {
    framebuffers(&mut r)
}

pub unsafe fn destroy_framebuffers(r: &mut state.Renderer) {
    for i in 0..r.imageCount {
        r.api.DestroyFramebuffer(r.device, r.framebuffers[i], ptr(0))
        r.framebuffers[i] = ptr(0)
    }
}
