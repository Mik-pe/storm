capability unsafe

import .layout as vk
import .shader as shader
import .state as state

// Render pass with a color attachment and a D32 depth attachment.
// Passes: sky (no depth write) then opaque PBR meshes (depth test + write).

@c_layout
struct Dependencies { before: vk.SubpassDependency, after: vk.SubpassDependency }

@c_layout
struct Attachments { color: vk.AttachmentDescription }

@c_layout
struct Stages { vertex: vk.PipelineShaderStageCreateInfo, fragment: vk.PipelineShaderStageCreateInfo }

@c_layout
struct Attributes { position: vk.VertexInputAttributeDescription, normal: vk.VertexInputAttributeDescription }

unsafe fn targets(r: &mut state.Renderer) -> bool {
    // One colour attachment. Depth is not wired yet: see docs/dogfood.md for the
    // vkCreateImage result this driver returned for depth formats.
    mut color: vk.AttachmentDescription = zeroed()
    color.format = r.format
    color.samples = 1
    color.loadOp = 1
    color.storeOp = 1
    color.stencilLoadOp = 2
    color.stencilStoreOp = 1
    color.initialLayout = 0
    color.finalLayout = 1000001002
    attachments := Attachments { color: color }
    mut color_ref: vk.AttachmentReference = zeroed()
    color_ref.attachment = 0
    color_ref.layout = 1

    mut subpass: vk.SubpassDescription = zeroed()
    subpass.pipelineBindPoint = 0
    subpass.colorAttachmentCount = 1
    subpass.pColorAttachments = addr(&color_ref)

    mut before: vk.SubpassDependency = zeroed()
    before.srcSubpass = 4294967295
    before.dstSubpass = 0
    before.srcStageMask = 1024
    before.dstStageMask = 1024
    before.srcAccessMask = 0
    before.dstAccessMask = 256
    mut after: vk.SubpassDependency = zeroed()
    after.srcSubpass = 0
    after.dstSubpass = 4294967295
    after.srcStageMask = 1024
    after.dstStageMask = 4096
    after.srcAccessMask = 256
    after.dstAccessMask = 0
    dependencies := Dependencies { before: before, after: after }

    mut pass: vk.RenderPassCreateInfo = zeroed()
    pass.sType = 38
    pass.attachmentCount = 1
    pass.pAttachments = addr(&attachments.color)
    pass.subpassCount = 1
    pass.pSubpasses = addr(&subpass)
    pass.dependencyCount = 2
    pass.pDependencies = addr(&dependencies)
    if r.api.CreateRenderPass(r.device, addr(&pass), ptr(0), addr(&mut r.renderPass)) != 0 { return false }
    true
}

unsafe fn framebuffers(r: &mut state.Renderer) -> bool {
    for i in 0..r.imageCount {
        mut views: [ptr; 1] = [r.views[i]]
        mut info: vk.FramebufferCreateInfo = zeroed()
        info.sType = 37
        info.renderPass = r.renderPass
        info.attachmentCount = 1
        info.pAttachments = addr(&views[0])
        info.width = r.width
        info.height = r.height
        info.layers = 1
        if r.api.CreateFramebuffer(r.device, addr(&info), ptr(0), addr(&mut r.framebuffers[i])) != 0 { return false }
    }
    true
}

unsafe fn module(r: &state.Renderer, words: ptr, size: usize, output: ptr) -> bool {
    mut info: vk.ShaderModuleCreateInfo = zeroed()
    info.sType = 16
    info.codeSize = size
    info.pCode = words
    r.api.CreateShaderModule(r.device, addr(&info), ptr(0), output) == 0
}

unsafe fn mesh_pipeline(r: &mut state.Renderer) -> bool {
    vertex := shader.mesh_vertex()
    mut vertex_shader := r.vertexShader
    if !module(&r, addr(&vertex[0]), usize(vertex.len * 4), addr(&mut vertex_shader)) { return false }
    r.vertexShader = vertex_shader
    fragment := shader.mesh_fragment()
    mut fragment_shader := r.fragmentShader
    if !module(&r, addr(&fragment[0]), usize(fragment.len * 4), addr(&mut fragment_shader)) { return false }
    r.fragmentShader = fragment_shader

    // mvp(64) model(64) base_color(16) params(16) camera(16) sun(16)
    // sun_color(16) zenith(16) horizon(16) = 240 bytes. The light matrix lives
    // in a uniform buffer because 320 exceeds what this pipeline layout accepts.
    mut push_range: vk.PushConstantRange = zeroed()
    push_range.stageFlags = 17
    push_range.offset = 0
    push_range.size = 240
    mut layout: vk.PipelineLayoutCreateInfo = zeroed()
    layout.sType = 30
    layout.pushConstantRangeCount = 1
    layout.pPushConstantRanges = addr(&push_range)
    // Set 0: shadow map sampler + light uniform buffer.
    layout.setLayoutCount = 1
    layout.pSetLayouts = addr(&r.shadowSetLayout)
    if r.api.CreatePipelineLayout(r.device, addr(&layout), ptr(0), addr(&mut r.pipelineLayout)) != 0 { return false }

    mut stage: vk.PipelineShaderStageCreateInfo = zeroed()
    stage.sType = 18
    stage.stage = 1
    stage.module = r.vertexShader
    stage.pName = cstr("main")
    mut stages := Stages { vertex: stage, fragment: stage }
    stages.fragment.stage = 16
    stages.fragment.module = r.fragmentShader

    // position vec3 at 0, normal vec3 at 12: 24-byte stride.
    mut binding := vk.VertexInputBindingDescription { binding: 0, stride: 24, inputRate: 0 }
    mut attributes := Attributes {
        position: vk.VertexInputAttributeDescription { location: 0, binding: 0, format: 106, offset: 0 },
        normal: vk.VertexInputAttributeDescription { location: 1, binding: 0, format: 106, offset: 12 },
    }
    mut input: vk.PipelineVertexInputStateCreateInfo = zeroed()
    input.sType = 19
    input.vertexBindingDescriptionCount = 1
    input.pVertexBindingDescriptions = addr(&binding)
    input.vertexAttributeDescriptionCount = 2
    input.pVertexAttributeDescriptions = addr(&attributes)

    mut assembly: vk.PipelineInputAssemblyStateCreateInfo = zeroed()
    assembly.sType = 20
    assembly.topology = 3

    mut viewport: vk.Viewport = zeroed()
    viewport.width = f32(r.width)
    viewport.height = f32(r.height)
    viewport.minDepth = 0.0
    viewport.maxDepth = 1.0
    mut scissor: vk.Rect2D = zeroed()
    scissor.extent.width = r.width
    scissor.extent.height = r.height
    mut view: vk.PipelineViewportStateCreateInfo = zeroed()
    view.sType = 22
    view.viewportCount = 1
    view.pViewports = addr(&viewport)
    view.scissorCount = 1
    view.pScissors = addr(&scissor)

    mut raster: vk.PipelineRasterizationStateCreateInfo = zeroed()
    raster.sType = 23
    raster.polygonMode = 0
    raster.cullMode = 2
    // The projection negates Y for Vulkan's clip space, which mirrors the
    // winding, so counter-clockwise is the front face.
    raster.frontFace = 0
    raster.lineWidth = 1.0

    mut samples: vk.PipelineMultisampleStateCreateInfo = zeroed()
    samples.sType = 24
    samples.rasterizationSamples = 1

    mut depth_state: vk.PipelineDepthStencilStateCreateInfo = zeroed()
    depth_state.sType = 25
    depth_state.depthTestEnable = 0
    depth_state.depthWriteEnable = 0
    depth_state.depthCompareOp = 1

    mut blend_attachment: vk.PipelineColorBlendAttachmentState = zeroed()
    blend_attachment.colorWriteMask = 15
    mut blend: vk.PipelineColorBlendStateCreateInfo = zeroed()
    blend.sType = 26
    blend.attachmentCount = 1
    blend.pAttachments = addr(&blend_attachment)

    mut info: vk.GraphicsPipelineCreateInfo = zeroed()
    info.sType = 28
    info.stageCount = 2
    info.pStages = addr(&stages)
    info.pVertexInputState = addr(&input)
    info.pInputAssemblyState = addr(&assembly)
    info.pViewportState = addr(&view)
    info.pRasterizationState = addr(&raster)
    info.pMultisampleState = addr(&samples)
    info.pDepthStencilState = addr(&depth_state)
    info.pColorBlendState = addr(&blend)
    info.layout = r.pipelineLayout
    info.renderPass = r.renderPass
    info.basePipelineIndex = -1
    if r.api.CreateGraphicsPipelines(r.device, ptr(0), 1, addr(&info), ptr(0), addr(&mut r.pipeline)) != 0 { return false }
    // Same pipeline with alpha blending for the transparent pass.
    blend_attachment.blendEnable = 1
    blend_attachment.srcColorBlendFactor = 6    // SRC_ALPHA
    blend_attachment.dstColorBlendFactor = 7    // ONE_MINUS_SRC_ALPHA
    blend_attachment.colorBlendOp = 0
    blend_attachment.srcAlphaBlendFactor = 1    // ONE
    blend_attachment.dstAlphaBlendFactor = 7
    blend_attachment.alphaBlendOp = 0
    if r.api.CreateGraphicsPipelines(r.device, ptr(0), 1, addr(&info), ptr(0), addr(&mut r.transparentPipeline)) != 0 { return false }
    true
}

// Sky: fullscreen triangle, no vertex buffer, depth test but no depth write.
unsafe fn sky_pipeline(r: &mut state.Renderer) -> bool {
    vertex := shader.sky_vertex()
    mut vertex_shader := r.skyVertexShader
    if !module(&r, addr(&vertex[0]), usize(vertex.len * 4), addr(&mut vertex_shader)) { return false }
    r.skyVertexShader = vertex_shader
    fragment := shader.sky_fragment()
    mut fragment_shader := r.skyFragmentShader
    if !module(&r, addr(&fragment[0]), usize(fragment.len * 4), addr(&mut fragment_shader)) { return false }
    r.skyFragmentShader = fragment_shader

    // inv_view_proj(64) + sun(16) + zenith(16) + horizon(16) = 112 bytes.
    mut push_range: vk.PushConstantRange = zeroed()
    push_range.stageFlags = 17
    push_range.offset = 0
    push_range.size = 112
    mut layout: vk.PipelineLayoutCreateInfo = zeroed()
    layout.sType = 30
    layout.pushConstantRangeCount = 1
    layout.pPushConstantRanges = addr(&push_range)
    // Set 0: shadow map sampler + light uniform buffer.
    layout.setLayoutCount = 1
    layout.pSetLayouts = addr(&r.shadowSetLayout)
    if r.api.CreatePipelineLayout(r.device, addr(&layout), ptr(0), addr(&mut r.skyPipelineLayout)) != 0 { return false }

    mut stage: vk.PipelineShaderStageCreateInfo = zeroed()
    stage.sType = 18
    stage.stage = 1
    stage.module = r.skyVertexShader
    stage.pName = cstr("main")
    mut stages := Stages { vertex: stage, fragment: stage }
    stages.fragment.stage = 16
    stages.fragment.module = r.skyFragmentShader

    mut input: vk.PipelineVertexInputStateCreateInfo = zeroed()
    input.sType = 19
    mut assembly: vk.PipelineInputAssemblyStateCreateInfo = zeroed()
    assembly.sType = 20
    assembly.topology = 3

    mut viewport: vk.Viewport = zeroed()
    viewport.width = f32(r.width)
    viewport.height = f32(r.height)
    viewport.minDepth = 0.0
    viewport.maxDepth = 1.0
    mut scissor: vk.Rect2D = zeroed()
    scissor.extent.width = r.width
    scissor.extent.height = r.height
    mut view: vk.PipelineViewportStateCreateInfo = zeroed()
    view.sType = 22
    view.viewportCount = 1
    view.pViewports = addr(&viewport)
    view.scissorCount = 1
    view.pScissors = addr(&scissor)

    mut raster: vk.PipelineRasterizationStateCreateInfo = zeroed()
    raster.sType = 23
    raster.polygonMode = 0
    raster.cullMode = 0
    raster.frontFace = 1
    raster.lineWidth = 1.0

    mut samples: vk.PipelineMultisampleStateCreateInfo = zeroed()
    samples.sType = 24
    samples.rasterizationSamples = 1

    mut depth_state: vk.PipelineDepthStencilStateCreateInfo = zeroed()
    depth_state.sType = 25
    depth_state.depthTestEnable = 0
    depth_state.depthWriteEnable = 0
    depth_state.depthCompareOp = 3

    mut blend_attachment: vk.PipelineColorBlendAttachmentState = zeroed()
    blend_attachment.colorWriteMask = 15
    mut blend: vk.PipelineColorBlendStateCreateInfo = zeroed()
    blend.sType = 26
    blend.attachmentCount = 1
    blend.pAttachments = addr(&blend_attachment)

    mut info: vk.GraphicsPipelineCreateInfo = zeroed()
    info.sType = 28
    info.stageCount = 2
    info.pStages = addr(&stages)
    info.pVertexInputState = addr(&input)
    info.pInputAssemblyState = addr(&assembly)
    info.pViewportState = addr(&view)
    info.pRasterizationState = addr(&raster)
    info.pMultisampleState = addr(&samples)
    info.pDepthStencilState = addr(&depth_state)
    info.pColorBlendState = addr(&blend)
    info.layout = r.skyPipelineLayout
    info.renderPass = r.renderPass
    info.basePipelineIndex = -1
    r.api.CreateGraphicsPipelines(r.device, ptr(0), 1, addr(&info), ptr(0), addr(&mut r.skyPipeline)) == 0
}

pub unsafe fn setup(r: &mut state.Renderer) -> bool {
    r.stage = 21
    if !targets(&mut r) { return false }
    r.stage = 22
    if !mesh_pipeline(&mut r) { return false }
    r.stage = 23
    if !sky_pipeline(&mut r) { return false }
    r.stage = 24
    framebuffers(&mut r)
}

// After a swapchain recreation only the framebuffers are size-dependent.
pub unsafe fn setup_frames_only(r: &mut state.Renderer) -> bool {
    framebuffers(&mut r)
}

pub unsafe fn destroy_framebuffers(r: &mut state.Renderer) {
    for i in 0..r.imageCount { r.api.DestroyFramebuffer(r.device, r.framebuffers[i], ptr(0)) }
}
