capability unsafe

import .device as device
import vk.enums as enums
import vk.layout as vk
import .shader as shader
import .state as state
import .records as records

unsafe fn targets(r: &mut state.Renderer) -> state.SetupStep {
    mut color: vk.AttachmentDescription = zeroed()
    color.format = r.format
    color.samples = enums.samples(.Type1)
    color.loadOp = enums.attachment_load_op(.Clear)
    // STORE matters now: the post pass samples this image afterwards.
    color.storeOp = enums.attachment_store_op(.Store)
    color.stencilLoadOp = enums.attachment_load_op(.DontCare)
    color.stencilStoreOp = enums.attachment_store_op(.DontCare)
    color.initialLayout = enums.image_layout(.Undefined)
    // The target is left ready for presentation: end_frame transitions it.
    color.finalLayout = enums.image_layout(.ColorAttachmentOptimal)
    mut depth: vk.AttachmentDescription = zeroed()
    depth.format = enums.format(.D32_SFLOAT)
    depth.samples = enums.samples(.Type1)
    depth.loadOp = enums.attachment_load_op(.Clear)
    depth.storeOp = enums.attachment_store_op(.DontCare)
    depth.stencilLoadOp = enums.attachment_load_op(.DontCare)
    depth.stencilStoreOp = enums.attachment_store_op(.DontCare)
    depth.initialLayout = enums.image_layout(.Undefined) // cleared anyway
    depth.finalLayout = enums.image_layout(.DepthStencilAttachmentOptimal)
    mut attachments := vk.Attachments { color: color, depth: depth }
    mut color_ref: vk.AttachmentReference = zeroed()
    color_ref.attachment = 0
    color_ref.layout = enums.image_layout(.ColorAttachmentOptimal)
    mut depth_ref: vk.AttachmentReference = zeroed()
    depth_ref.attachment = 1
    depth_ref.layout = enums.image_layout(.DepthStencilAttachmentOptimal)
    refs := vk.References { color: color_ref, depth: depth_ref }

    mut subpass: vk.SubpassDescription = zeroed()
    subpass.pipelineBindPoint = enums.pipeline_bind_point(.Graphics)
    subpass.colorAttachmentCount = 1
    subpass.pColorAttachments = addr(&refs.color)
    subpass.pDepthStencilAttachment = addr(&refs.depth)

    mut before: vk.SubpassDependency = zeroed()
    before.srcSubpass = enums.SUBPASS_EXTERNAL
    before.dstSubpass = 0
    before.srcStageMask = enums.pipeline_stage(.ColorAndDepthStages)
    before.dstStageMask = enums.pipeline_stage(.ColorAndDepthStages)
    before.srcAccessMask = enums.access(.ColorDepthWrite)
    before.dstAccessMask = enums.access(.ColorDepthWrite) + enums.access(.DepthStencilAttachmentRead)
    mut after: vk.SubpassDependency = zeroed()
    after.srcSubpass = 0
    after.dstSubpass = enums.SUBPASS_EXTERNAL
    after.srcStageMask = enums.pipeline_stage(.ColorAttachmentOutput)
    after.dstStageMask = enums.pipeline_stage(.Transfer)
    after.srcAccessMask = enums.access(.ColorAttachmentWrite)
    after.dstAccessMask = enums.access(.None)
    dependencies := vk.Dependencies { before: before, after: after }

    mut pass: vk.RenderPassCreateInfo = vk.RenderPassCreateInfo::new()
    pass.attachmentCount = 2
    pass.pAttachments = addr(&attachments)
    pass.subpassCount = 1
    pass.pSubpasses = addr(&subpass)
    pass.dependencyCount = 2
    pass.pDependencies = addr(&dependencies)
    mut code := r.api.CreateRenderPass(r.device, addr(&pass), ptr(0), addr(&mut r.renderPass))
    if code != 0 { return device.fail(&mut r, code, .Pipeline) }
    // The filtered scene keeps depth for its compatible composite/HUD pass.
    attachments.depth.storeOp = enums.attachment_store_op(.Store)
    code = r.api.CreateRenderPass(r.device, addr(&pass), ptr(0), addr(&mut r.scenePass))
    if code != 0 { return device.fail(&mut r, code, .PostProcess) }
    attachments.depth.loadOp = enums.attachment_load_op(.Load)
    attachments.depth.initialLayout = enums.image_layout(.DepthStencilAttachmentOptimal)
    attachments.depth.storeOp = enums.attachment_store_op(.DontCare)
    attachments.color.loadOp = enums.attachment_load_op(.DontCare)
    code = r.api.CreateRenderPass(r.device, addr(&pass), ptr(0), addr(&mut r.compositePass))
    if code != 0 { return device.fail(&mut r, code, .PostProcess) }
    .Ready
}

unsafe fn framebuffers(r: &mut state.Renderer) -> state.SetupStep {
    for i in 0..r.imageCount {
        mut framebuffer := ptr(0)
        code := device.color_framebuffer(&r, r.views[i], addr(&mut framebuffer))
        r.framebuffers[i] = framebuffer
        if code != 0 { return device.fail(&mut r, code, .Pipeline) }
    }
    .Ready
}

unsafe fn mesh_pipeline(r: &mut state.Renderer) -> state.SetupStep {
    vertex := shader.mesh_vertex()
    mut vertex_shader := r.vertexShader
    mut code := device.shader_module(&r, addr(&vertex[0]), usize(vertex.len * 4), addr(&mut vertex_shader))
    if code != 0 { return device.fail(&mut r, code, .Pipeline) }
    r.vertexShader = vertex_shader
    fragment := shader.mesh_fragment()
    mut fragment_shader := r.fragmentShader
    code = device.shader_module(&r, addr(&fragment[0]), usize(fragment.len * 4), addr(&mut fragment_shader))
    if code != 0 { return device.fail(&mut r, code, .Pipeline) }
    r.fragmentShader = fragment_shader

    // mvp(64) model(64) base_color(16) params(16) camera(16) emissive(16) occlusion(16)
    // sun_color(16) zenith(16) horizon(16) = 240 bytes. The light matrix lives
    // in a uniform buffer because 320 exceeds what this pipeline layout accepts.
    mut push_range: vk.PushConstantRange = zeroed()
    push_range.stageFlags = enums.shader_stage(.VertexFragment)
    push_range.offset = 0
    push_range.size = state.MESH_PUSH_BYTES
    mut layout: vk.PipelineLayoutCreateInfo = vk.PipelineLayoutCreateInfo::new()
    layout.pushConstantRangeCount = 1
    layout.pPushConstantRanges = addr(&push_range)
    // Set 0: shadow map sampler + light uniform buffer + environment.
    // Set 1: the material's five maps (texture.ddr), one set per draw. Both
    // layouts exist before this step (shadow.setup, texture.setup).
    r.meshSetLayouts = [r.shadowSetLayout, r.material.setLayout]
    layout.setLayoutCount = 2
    layout.pSetLayouts = addr(&r.meshSetLayouts[0])
    code = r.api.CreatePipelineLayout(r.device, addr(&layout), ptr(0), addr(&mut r.pipelineLayout))
    if code != 0 { return device.fail(&mut r, code, .Pipeline) }

    // Opaque geometry: closer fragments win and write their depth. The
    // transparent pipeline is the same pipeline with alpha blending and no
    // depth write: glass is sorted back to front and must not hide geometry.
    mut opaque := Plan {
        vertex: r.vertexShader, fragment: r.fragmentShader,
        layout: r.pipelineLayout, pass: r.renderPass,
        cull: .Back, depth: depth_write(), blend: .None,
        vertices: .Mesh, viewport: .Frame, encoded: true,
    }
    mut opaque_pipeline := ptr(0)
    code = build(&r, &opaque, addr(&mut opaque_pipeline))
    if code != 0 { return device.fail(&mut r, code, .Pipeline) }
    r.pipeline = opaque_pipeline
    mut glass := Plan {
        vertex: r.vertexShader, fragment: r.fragmentShader,
        layout: r.pipelineLayout, pass: r.renderPass,
        cull: .Back, depth: depth_test_only(), blend: .Some(records.alpha_over()),
        vertices: .Mesh, viewport: .Frame, encoded: true,
    }
    mut glass_pipeline := ptr(0)
    code = build(&r, &glass, addr(&mut glass_pipeline))
    if code != 0 { return device.fail(&mut r, code, .Pipeline) }
    r.transparentPipeline = glass_pipeline
    .Ready
}

// Sky: fullscreen triangle, no vertex buffer, depth test but no depth write.
unsafe fn sky_pipeline(r: &mut state.Renderer) -> state.SetupStep {
    vertex := shader.sky_vertex()
    mut vertex_shader := r.skyVertexShader
    mut code := device.shader_module(&r, addr(&vertex[0]), usize(vertex.len * 4), addr(&mut vertex_shader))
    if code != 0 { return device.fail(&mut r, code, .Pipeline) }
    r.skyVertexShader = vertex_shader
    fragment := shader.sky_fragment()
    mut fragment_shader := r.skyFragmentShader
    code = device.shader_module(&r, addr(&fragment[0]), usize(fragment.len * 4), addr(&mut fragment_shader))
    if code != 0 { return device.fail(&mut r, code, .Pipeline) }
    r.skyFragmentShader = fragment_shader

    // inv_view_proj(64) + sun(16) + zenith(16) + horizon(16) = 112 bytes.
    mut push_range: vk.PushConstantRange = zeroed()
    push_range.stageFlags = enums.shader_stage(.VertexFragment)
    push_range.offset = 0
    push_range.size = 112
    mut layout: vk.PipelineLayoutCreateInfo = vk.PipelineLayoutCreateInfo::new()
    layout.pushConstantRangeCount = 1
    layout.pPushConstantRanges = addr(&push_range)
    // Set 0: shadow map sampler + light uniform buffer.
    layout.setLayoutCount = 1
    layout.pSetLayouts = addr(&r.shadowSetLayout)
    code = r.api.CreatePipelineLayout(r.device, addr(&layout), ptr(0), addr(&mut r.skyPipelineLayout))
    if code != 0 { return device.fail(&mut r, code, .Pipeline) }

    // The sky is a fullscreen triangle drawn over everything: no depth test,
    // no depth write, nothing culled.
    plan := Plan {
        vertex: r.skyVertexShader, fragment: r.skyFragmentShader,
        layout: r.skyPipelineLayout, pass: r.renderPass,
        cull: .None, depth: depth_off(), blend: .None,
        vertices: .None, viewport: .Frame, encoded: true,
    }
    mut sky_pipeline := ptr(0)
    code = build(&r, &plan, addr(&mut sky_pipeline))
    if code != 0 { return device.fail(&mut r, code, .Pipeline) }
    r.skyPipeline = sky_pipeline
    .Ready
}

pub unsafe fn setup(r: &mut state.Renderer) -> state.SetupStep {
    mut step := targets(&mut r)
    if step != .Ready { return step }
    step = mesh_pipeline(&mut r)
    if step != .Ready { return step }
    step = sky_pipeline(&mut r)
    if step != .Ready { return step }
    framebuffers(&mut r)
}

// After a swapchain recreation only the framebuffers are size-dependent.
pub unsafe fn setup_frames_only(r: &mut state.Renderer) -> state.SetupStep {
    framebuffers(&mut r)
}

pub unsafe fn destroy_framebuffers(r: &mut state.Renderer) {
    for i in 0..r.imageCount {
        r.api.DestroyFramebuffer(r.device, r.framebuffers[i], ptr(0))
        r.framebuffers[i] = ptr(0)
    }
}

// --- one description of a graphics pipeline ---
//
// Seven pipelines were built from seven copies of the same ~45 lines: two
// shader stages, the nine state records, GraphicsPipelineCreateInfo,
// CreateGraphicsPipelines. The copies agreed on most fields (triangle list,
// fill, one sample, one attachment) and disagreed on the few that are
// decisions: which faces are culled, whether depth is tested or written,
// how colour blends, which vertex layout, which viewport. A copy that
// drifted was invisible — the front face was Clockwise in three and
// CounterClockwise in one with the same cull mode, which is correct only
// because cull None ignores it. A Plan names the decisions and nothing else;
// `build` writes everything the decisions imply, once.

// Depth testing and writing. `compare` is written even when nothing is
// tested, so the record never carries a stale operation.
pub struct Depth { test: bool, write: bool, compare: enums.CompareOp }

pub fn depth_off() -> Depth { Depth { test: false, write: false, compare: .LessOrEqual } }
// Opaque geometry: closer fragments win and keep their depth.
pub fn depth_write() -> Depth { Depth { test: true, write: true, compare: .Less } }
// Glass is sorted back to front and must not hide geometry behind it.
pub fn depth_test_only() -> Depth { Depth { test: true, write: false, compare: .Less } }

// Which vertex layout the pipeline declares: none (a fullscreen triangle),
// the mesh stream (position, normal, uv — `layout.vertex_input`), or a UI
// vertex (position/uv and colour — `layout.UiVertices`, byte size given by
// the UI, which pushes the vertices). Each layout is its own record with its
// own writer; a pipeline never declares part of another layout.
pub enum Vertices { None, Mesh, Ui(u32) }

// The viewport: the frame's extent, set dynamically per pass, or a fixed
// square baked into the pipeline (the environment faces).
pub enum Viewport { Frame, Square(u32) }

pub struct Plan {
    vertex: ptr,
    fragment: ptr,
    layout: ptr,
    pass: ptr,
    cull: enums.CullMode,
    depth: Depth,
    blend: Option<records.Blend>,
    vertices: Vertices,
    viewport: Viewport,
    // Display shaders specialise on whether the target is sRGB.
    encoded: bool,
}

// The face that counts as front. Storm's projection negates Y for Vulkan's
// clip space, which mirrors the winding, so counter-clockwise is the front
// face — but it only matters when something is culled, and a pass that culls
// nothing takes the other one: it is not a decision, so it is not in the Plan.
unsafe fn front_face(cull: enums.CullMode) -> u32 {
    if cull == enums.CullMode.None { enums.front_face(.Clockwise) } else { enums.front_face(.CounterClockwise) }
}

// The two vertex layouts a Plan names, as records with their enum fields
// written by the one writer each: the mesh stream (three attributes) and a
// UI vertex of `stride` bytes (two). The records travel by value so they
// live in `build`'s frame, where the pointers into them are made.
unsafe fn mesh_vertices() -> records.VertexInput {
    mut vertices: records.VertexInput = records.vertex_input()
    records.apply_vertex_input(&mut vertices)
    vertices
}

unsafe fn ui_vertices(stride: u32) -> records.UiVertices {
    mut vertices: records.UiVertices = records.ui_vertices(stride)
    records.apply_ui_vertices(&mut vertices)
    vertices
}

// Everything a pipeline's creation reads, in one record so that the pointers
// between the state records stay inside it: the caller owns the record,
// `describe` fills it from a Plan, and `create` hands it to Vulkan. Tests
// read a described record without a device.
@c_layout
pub struct Description {
    stages: vk.ShaderStages,
    encoding: records.DisplayEncoding,
    mesh: records.VertexInput,
    ui: records.UiVertices,
    input: vk.PipelineVertexInputStateCreateInfo,
    assembly: vk.PipelineInputAssemblyStateCreateInfo,
    frame_view: records.FrameViewport,
    viewport: vk.Viewport,
    scissor: vk.Rect2D,
    square_view: vk.PipelineViewportStateCreateInfo,
    raster: vk.PipelineRasterizationStateCreateInfo,
    samples: vk.PipelineMultisampleStateCreateInfo,
    depth_state: vk.PipelineDepthStencilStateCreateInfo,
    blend_attachment: vk.PipelineColorBlendAttachmentState,
    blend: vk.PipelineColorBlendStateCreateInfo,
    info: vk.GraphicsPipelineCreateInfo,
}

// Writes every record a Plan implies. What the Plan does not name is a fact
// of Storm's pipelines and is written here: triangle list, fill, width 1,
// one sample, one colour attachment, subpass 0, no base pipeline.
pub unsafe fn describe(r: &state.Renderer, plan: &Plan, description: &mut Description) {
    mut stage: vk.PipelineShaderStageCreateInfo = vk.PipelineShaderStageCreateInfo::new()
    stage.stage = enums.shader_stage(.Vertex)
    stage.module = plan.vertex
    stage.pName = cstr("main")
    description.stages = vk.ShaderStages { vertex: stage, fragment: stage }
    description.stages.fragment.stage = enums.shader_stage(.Fragment)
    description.stages.fragment.module = plan.fragment
    description.encoding = zeroed()
    description.stages.fragment.pSpecializationInfo = ptr(0)
    if plan.encoded { description.stages.fragment.pSpecializationInfo = device.display_encoding(r.format, &mut description.encoding) }

    description.input = vk.PipelineVertexInputStateCreateInfo::new()
    description.mesh = zeroed()
    description.ui = zeroed()
    match plan.vertices {
        .Mesh => {
            description.mesh = mesh_vertices()
            description.input.vertexBindingDescriptionCount = 1
            description.input.pVertexBindingDescriptions = addr(&description.mesh.binding)
            description.input.vertexAttributeDescriptionCount = 3
            description.input.pVertexAttributeDescriptions = addr(&description.mesh.attributes)
        },
        .Ui(stride) => {
            description.ui = ui_vertices(stride)
            description.input.vertexBindingDescriptionCount = 1
            description.input.pVertexBindingDescriptions = addr(&description.ui.binding)
            description.input.vertexAttributeDescriptionCount = 2
            description.input.pVertexAttributeDescriptions = addr(&description.ui.position)
        },
        .None => {},
    }

    description.assembly = vk.PipelineInputAssemblyStateCreateInfo::new()
    description.assembly.topology = enums.primitive_topology(.TriangleList)

    // The viewport state and the dynamic state that goes with it: the
    // frame's extent is set per pass, a square is baked in.
    description.frame_view = zeroed()
    device.frame_viewport(&mut description.frame_view)
    description.viewport = zeroed()
    description.scissor = zeroed()
    description.square_view = vk.PipelineViewportStateCreateInfo::new()
    mut view := addr(&description.frame_view.viewport)
    mut dynamic := addr(&description.frame_view.dynamic)
    match plan.viewport {
        .Square(size) => {
            description.viewport.width = f32(size)
            description.viewport.height = f32(size)
            description.viewport.maxDepth = 1.0
            description.scissor.extent.width = size
            description.scissor.extent.height = size
            description.square_view.viewportCount = 1
            description.square_view.pViewports = addr(&description.viewport)
            description.square_view.scissorCount = 1
            description.square_view.pScissors = addr(&description.scissor)
            view = addr(&description.square_view)
            dynamic = ptr(0)
        },
        .Frame => {},
    }

    description.raster = vk.PipelineRasterizationStateCreateInfo::new()
    description.raster.polygonMode = enums.polygon_mode(.Fill)
    description.raster.cullMode = enums.cull_mode(plan.cull)
    description.raster.frontFace = front_face(plan.cull)
    description.raster.lineWidth = 1.0

    description.samples = vk.PipelineMultisampleStateCreateInfo::new()
    description.samples.rasterizationSamples = enums.samples(.Type1)

    description.depth_state = vk.PipelineDepthStencilStateCreateInfo::new()
    description.depth_state.depthTestEnable = if plan.depth.test { 1 } else { 0 }
    description.depth_state.depthWriteEnable = if plan.depth.write { 1 } else { 0 }
    description.depth_state.depthCompareOp = enums.compare_op(plan.depth.compare)

    description.blend_attachment = zeroed()
    description.blend_attachment.colorWriteMask = enums.color_component(.RGBA)
    match plan.blend {
        .Some(blend) => { records.apply_blend(&mut description.blend_attachment, &blend) },
        .None => { description.blend_attachment.blendEnable = 0 },
    }
    description.blend = vk.PipelineColorBlendStateCreateInfo::new()
    description.blend.attachmentCount = 1
    description.blend.pAttachments = addr(&description.blend_attachment)

    description.info = vk.GraphicsPipelineCreateInfo::new()
    description.info.stageCount = 2
    description.info.pStages = addr(&description.stages)
    description.info.pVertexInputState = addr(&description.input)
    description.info.pInputAssemblyState = addr(&description.assembly)
    description.info.pViewportState = view
    description.info.pDynamicState = dynamic
    description.info.pRasterizationState = addr(&description.raster)
    description.info.pMultisampleState = addr(&description.samples)
    description.info.pDepthStencilState = addr(&description.depth_state)
    description.info.pColorBlendState = addr(&description.blend)
    description.info.layout = plan.layout
    description.info.renderPass = plan.pass
    description.info.subpass = 0
    description.info.basePipelineIndex = -1
}

// Creates the pipeline a Plan describes. `output` receives the handle; the
// caller owns the description record so the pointers in it stay valid.
pub unsafe fn create(r: &state.Renderer, description: &Description, output: ptr) -> i32 {
    r.api.CreateGraphicsPipelines(r.device, ptr(0), 1, addr(&description.info), ptr(0), output)
}

// Describe and create in one step, for the setups that have nothing to check.
pub unsafe fn build(r: &state.Renderer, plan: &Plan, output: ptr) -> i32 {
    mut description: Description = zeroed()
    describe(r, plan, &mut description)
    create(r, &description, output)
}
