// Storm's values over the registry: the vertex formats a pipeline declares,
// the blend states it picks, the descriptor words it packs, and what a swapchain
// code or a display format means to Storm. Every Vulkan number comes from
// `enums` (generated from vk.xml); this module only decides which of them
// Storm's mesh and UI streams use, and reads the vertex contract from `gfx`.
capability unsafe

import gfx
import vk.enums as enums
import vk.layout as layout

// Three attribute descriptions in C order (location 0, 1, 2) for
// pVertexAttributeDescriptions. A record of records is contiguous (a Dunder
// array of C records is not (finding 54).
@c_layout
pub struct VertexAttributes { position: layout.VertexInputAttributeDescription, normal: layout.VertexInputAttributeDescription, uv: layout.VertexInputAttributeDescription }

@c_layout
pub struct VertexInput {
    binding: layout.VertexInputBindingDescription,
    attributes: VertexAttributes,
}

// The binding and the three attributes every mesh pipeline declares, with
// zeroed format fields: `apply_vertex_input` fills them. The shadow
// shader reads only location 0, but a pipeline must declare all the buffer
// contains: with a 24-byte stride against a 32-byte stream the whole shadow
// map would be wrong without a single error.
pub fn vertex_input() -> VertexInput {
    VertexInput {
        binding: layout.VertexInputBindingDescription { binding: 0, stride: gfx.VERTEX_BYTES, inputRate: 0 },
        attributes: VertexAttributes {
            position: layout.VertexInputAttributeDescription { location: 0, binding: 0, format: 0, offset: 0 },
            normal: layout.VertexInputAttributeDescription { location: 1, binding: 0, format: 0, offset: gfx.NORMAL_OFFSET },
            uv: layout.VertexInputAttributeDescription { location: 2, binding: 0, format: 0, offset: gfx.UV_OFFSET },
        },
    }
}

// The binding and the two attributes the UI pipeline declares: one vertex is
// eight floats, xy = position and zw = uv at location 0, rgba at location 1.
// Its own record, not two of the mesh's three: a layout that is described by
// how much of another layout it uses is a layout nobody can read.
@c_layout
pub struct UiVertices {
    binding: layout.VertexInputBindingDescription,
    position: layout.VertexInputAttributeDescription,
    color: layout.VertexInputAttributeDescription,
}

// The UI layout, with zeroed format fields: `apply_ui_vertices` fills
// them. `stride` is the vertex's byte size, which the caller owns since it is
// the vertex it pushes.
pub fn ui_vertices(stride: u32) -> UiVertices {
    UiVertices {
        binding: layout.VertexInputBindingDescription { binding: 0, stride: stride, inputRate: 0 },
        position: layout.VertexInputAttributeDescription { location: 0, binding: 0, format: 0, offset: 0 },
        color: layout.VertexInputAttributeDescription { location: 1, binding: 0, format: 0, offset: 16 },
    }
}

// One VkDescriptorSetLayoutBinding is 24 bytes = three u64 words on x86-64:
// [binding | descriptorType<<32], [descriptorCount | stageFlags<<32], [samplers].
// Pack through these so neither the type nor the stage is an integer at the call site.
pub fn binding_word(binding: u32, kind: enums.DescriptorType) -> u64 {
    u64(binding) + (u64(enums.descriptor_type(kind)).shl(32))
}

pub fn stages_word(count: u32, stages: enums.ShaderStage) -> u64 {
    u64(count) + (u64(enums.shader_stage(stages)).shl(32))
}
// The frame was presented; SUBOPTIMAL still asks for a rebuild, later.
pub fn is_success(code: i32) -> bool { code == i32(enums.VkResult.Success) || code == i32(enums.VkResult.SuboptimalKHR) }

pub fn is_out_of_date(code: i32) -> bool { code == i32(enums.VkResult.ErrorOutOfDateKHR) }

// Formats the headless reader can unpack into PPM (8-bit RGBA/BGRA, UNORM or
// SRGB). Anything else is refused before a byte is read.
pub fn format_has_bytes(value: u32) -> bool {
    value == enums.format(.R8G8B8A8_UNORM) || value == enums.format(.R8G8B8A8_SRGB) ||
    value == enums.format(.B8G8R8A8_UNORM) || value == enums.format(.B8G8R8A8_SRGB)
}

// True for the BGRA swapchain formats, where red and blue sit swapped.
pub fn format_is_bgra(value: u32) -> bool {
    value == enums.format(.B8G8R8A8_UNORM) || value == enums.format(.B8G8R8A8_SRGB)
}

// How much Storm prefers a device of the type the driver reported in
// VkPhysicalDeviceProperties.deviceType: a discrete GPU, then an integrated
// one, then anything else (virtual, CPU, other). A type the registry does not
// know ranks with the rest rather than ending the process.
pub fn device_rank(device_type: u32) -> i32 {
    if device_type == enums.physical_device_type(.DiscreteGpu) { return 3 }
    if device_type == enums.physical_device_type(.IntegratedGpu) { return 2 }
    1
}

// A blend state as a value. Pipelines pick one of the named blends below
// instead of assigning five integers; apply_blend is the only writer of the
// C record's blend fields.
pub struct Blend {
    color_op: enums.BlendOp,
    src_color: enums.BlendFactor,
    dst_color: enums.BlendFactor,
    src_alpha: enums.BlendFactor,
    dst_alpha: enums.BlendFactor,
}

// Dunder `const` cannot hold a struct (E3007, even one of plain u32), so the
// named blends are functions returning the value.
pub fn alpha_over() -> Blend {
    Blend {
        color_op: .Add, src_color: .SrcAlpha, dst_color: .OneMinusSrcAlpha,
        src_alpha: .One, dst_alpha: .OneMinusSrcAlpha,
    }
}

// Shadow map: keep whichever fragment is closest to the light.
pub fn shadow_max() -> Blend {
    Blend {
        color_op: .Max, src_color: .One, dst_color: .One,
        src_alpha: .One, dst_alpha: .One,
    }
}

pub unsafe fn apply_blend(attachment: &mut layout.PipelineColorBlendAttachmentState, blend: &Blend) {
    attachment.blendEnable = 1
    attachment.srcColorBlendFactor = enums.blend_factor(blend.src_color)
    attachment.dstColorBlendFactor = enums.blend_factor(blend.dst_color)
    attachment.colorBlendOp = enums.blend_op(blend.color_op)
    attachment.srcAlphaBlendFactor = enums.blend_factor(blend.src_alpha)
    attachment.dstAlphaBlendFactor = enums.blend_factor(blend.dst_alpha)
    attachment.alphaBlendOp = enums.blend_op(blend.color_op)
    attachment.colorWriteMask = enums.color_component(.RGBA)
}

// The only writer of the mesh vertex layout's enum fields: one binding in
// vertex rate, position and normal as vec3, uv as vec2. Stride and offsets
// come from the record itself (gfx.VERTEX_BYTES), never from here.
pub unsafe fn apply_vertex_input(input: &mut VertexInput) {
    input.binding.inputRate = enums.vertex_input_rate(.Vertex)
    input.attributes.position.format = enums.format(.R32G32B32_SFLOAT)
    input.attributes.normal.format = enums.format(.R32G32B32_SFLOAT)
    input.attributes.uv.format = enums.format(.R32G32_SFLOAT)
}

// The only writer of the UI vertex layout's enum fields: one binding in
// vertex rate, position/uv and colour both as vec4.
pub unsafe fn apply_ui_vertices(input: &mut UiVertices) {
    input.binding.inputRate = enums.vertex_input_rate(.Vertex)
    input.position.format = enums.format(.R32G32B32A32_SFLOAT)
    input.color.format = enums.format(.R32G32B32A32_SFLOAT)
}

// A fragment specialisation that tells the display shader whether the target
// is sRGB: one map entry, one u32.
@c_layout
pub struct DisplayEncoding { entry: layout.SpecializationMapEntry, info: layout.SpecializationInfo, srgb: u32 }

// A pipeline's viewport and scissor come from the current extent, so both
// are dynamic; the two state numbers are the registry's (VIEWPORT, SCISSOR).
@c_layout
pub struct FrameViewport {
    viewport: layout.PipelineViewportStateCreateInfo,
    dynamic: layout.PipelineDynamicStateCreateInfo,
    states: [u32; 2],
}
