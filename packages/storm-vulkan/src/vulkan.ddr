capability unsafe, stdio

import std.bytes as b
import std.dl as dl
import .api as api
import .depth as depth
import .device as device
import .enums as enums
import .headless as headless
import .ibl as ibl
import .layout as vk
import .pipeline as pipeline
import .post as post
import .shadow as shadow
import .ui as ui
import .sdl as sdl
import .state as state

// Storm's Vulkan window: a real VK_KHR_swapchain presentation path (no readback).
//
// A frame is recorded in five calls, which is what the render graph drives:
//
//   result := vulkan.begin(opened.window)
//   if result.ok {
//       _ := vulkan.begin_pass(opened.window)
//       _ := vulkan.sky(opened.window, &inv_view_proj, &sun, &zenith, &horizon)
//       _ := vulkan.mesh(opened.window, &vertices, &mvp, &model, &base, &params, &camera, &sky)
//       _ := vulkan.end(opened.window)
//   }
//
// The shadow pass has its own render pass before begin_pass:
// shadow_begin / shadow_mesh per object / shadow_end.
// Mesh vertices are interleaved [x, y, z, nx, ny, nz] f32 (24 bytes).

pub struct Window { id: i64 }
pub struct OpenResult { ok: bool, window: Window, error: string }
pub struct Frame {
    closed: bool,
    width: i32,
    height: i32,
    scale: f64,
    time: f64,
    pointer_x: f64,
    pointer_y: f64,
    pointer_down: bool,
    key: i32,
    resized: bool,
}
pub struct BeginResult { ok: bool, error: string, width: i32, height: i32 }
pub struct DrawResult { ok: bool, error: string, frames: i64 }
pub struct MouseState {
    x: i32,
    y: i32,
    dx: i32,
    dy: i32,
    buttons: u32,
    pressed: u32,
    scroll: f32,
}

@c_layout
struct Registry { active: ptr, generation: i64 }

unsafe fn registry_address() -> ptr { static_bytes("linux", 16) }

@extern("c", "calloc")
unsafe fn allocate(count: usize, bytes: usize) -> ptr
@extern("c", "free")
unsafe fn release(address: ptr)
@extern("c", "memcpy")
unsafe fn copy_bytes(destination: ptr, source: ptr, bytes: usize) -> ptr
@extern("c", "clock_gettime")
unsafe fn clock_gettime(clock: i32, output: ptr) -> i32

unsafe fn millis() -> i64 {
    mut t: [i64; 2] = [0, 0]
    if clock_gettime(1, addr(&mut t[0])) != 0 { return 0 }
    t[0] * 1000 + t[1] / 1000000
}

fn open_error(move message: string) -> OpenResult {
    OpenResult { ok: false, window: Window { id: 0 }, error: message.clone() }
}

unsafe fn initialize(r: &mut state.Renderer, title: string, width: i32, height: i32) -> bool {
    r.width = u32(width)
    r.height = u32(height)
    r.frameIndex = 0
    r.current = 0
    r.stage = 1
    if !sdl.open(&mut r.window, title, width, height) { return false }
    r.stage = 2
    if !device.setup(&mut r) { return false }
    r.stage = 6
    if !shadow.setup(&mut r) { return false }
    r.stage = 3
    if !pipeline.setup(&mut r) { return false }
    if !post.setup(&mut r) { return false }
    if !ui.setup(&mut r) { return false }
    r.stage = 17
    if !depth.create(&mut r, r.width, r.height) { return false }
    r.stage = 4
    if !device.setup_frames(&mut r) { return false }
    r.stage = 5
    // 4 MiB of mapped vertex space, enough for a few hundred thousand vertices.
    if !device.create_vertex_buffer(&mut r, 4194304) { return false }
    r.stage = 0
    true
}

// Render and convolve the environment maps from the sky colours. Call once
// after open(), before the first frame; the maps are static, so the sun and
// sky must be the same values the scene passes to sky() every frame.
pub fn build_environment(window: Window, sun: &[f32; 4], zenith: &[f32; 4], horizon: &[f32; 4]) -> DrawResult {
    unsafe {
        address := active(ref_at(registry_address()), window)
        if address == ptr(0) { return draw_error(0, "invalid or expired window handle") }
        if !ibl.setup(ref_at(address), sun, zenith, horizon) { return draw_error(0, "could not build the environment maps") }
        DrawResult { ok: true, error: "", frames: 0 }
    }
}

// Attach the loader to a freshly allocated renderer. Kept separate so the
// allocation can be passed as a &mut through ref_at at the call site.
unsafe fn bootstrap(r: &mut state.Renderer, loader: ptr) -> bool {
    r.loader = loader
    api.load(&mut r.api, loader)
}

unsafe fn open_renderer(registry: &mut Registry, title: string, width: i32, height: i32) -> OpenResult {
    if width < 1 || width > 8192 || height < 1 || height > 8192 {
        return open_error("window dimensions must be between 1 and 8192")
    }
    if registry.active != ptr(0) { return open_error("a Storm window is already open") }
    address := allocate(1, size_of(state.Renderer) + 8192)
    if address == ptr(0) { return open_error("could not allocate Vulkan state") }
    loader := dl.open(cstr("libvulkan.so.1"), 2)
    if loader == ptr(0) {
        release(address)
        return open_error("Vulkan loader is unavailable")
    }
    if !bootstrap(ref_at(address), loader) {
        _ := dl.close(loader)
        release(address)
        return open_error("Vulkan loader is missing required entry points")
    }
    if !initialize(ref_at(address), title, width, height) {
        failure := stage_name(ref_at(address))
        device.destroy(ref_at(address))
        _ := dl.close(loader)
        release(address)
        return open_error("Vulkan initialization failed at " + failure)
    }
    registry.generation = registry.generation + 1
    registry.active = address
    OpenResult { ok: true, window: Window { id: registry.generation }, error: "" }
}

pub fn open(title: string, width: i32, height: i32) -> OpenResult {
    unsafe { open_renderer(ref_at(registry_address()), title, width, height) }
}

unsafe fn active(registry: &Registry, window: Window) -> ptr {
    if registry.generation != window.id { return ptr(0) }
    registry.active
}

unsafe fn name(r: &state.Renderer) -> string {
    mut bytes: []u8 = []
    for i in 0..256 {
        byte := r.properties.deviceName[i]
        if byte == 0 { break }
        bytes.push(byte)
    }
    match b.decode(&bytes) {
        .Ok(text) => text,
        .Err(_) => "",
    }
}

pub fn device_name(window: Window) -> string {
    unsafe {
        address := active(ref_at(registry_address()), window)
        if address == ptr(0) { return "" }
        return name(ref_at(address))
    }
}

// Print each submission step to stdout. Useful when a frame hangs.
// Ask for one offscreen frame; the pixels stay readable until save_capture.
pub fn capture_next(window: Window) -> bool {
    unsafe {
        address := active(ref_at(registry_address()), window)
        if address == ptr(0) { return false }
        capture_next_at(ref_at(address))
    }
}

unsafe fn capture_next_at(r: &mut state.Renderer) -> bool {
    if !headless.setup(&mut r) { return false }
    r.captureOn = 1
    true
}

pub fn save_capture(window: Window, path: string) -> bool {
    unsafe {
        address := active(ref_at(registry_address()), window)
        if address == ptr(0) { return false }
        headless.save(ref_at(address), path)
    }
}

pub fn set_trace(window: Window, enabled: bool) {
    unsafe {
        address := active(ref_at(registry_address()), window)
        if address != ptr(0) { set_trace_at(ref_at(address), enabled) }
    }
}

unsafe fn set_trace_at(r: &mut state.Renderer, enabled: bool) {
    r.trace = if enabled { 1 } else { 0 }
}

fn trace_step(r: &state.Renderer, message: string) {
    if r.trace != 0 { print("storm/vk: " + message) }
}

unsafe fn next_frame(r: &mut state.Renderer) -> Frame {
    sdl.poll(&mut r.window)
    Frame {
        closed: r.window.closed != 0,
        width: r.window.width,
        height: r.window.height,
        scale: 1.0,
        time: f64(millis()) / 1000.0,
        pointer_x: f64(r.window.x),
        pointer_y: f64(r.window.y),
        pointer_down: r.window.down != 0,
        key: r.window.key,
        resized: r.window.resized != 0,
    }
}

pub fn poll(window: Window) -> Frame {
    unsafe {
        address := active(ref_at(registry_address()), window)
        if address == ptr(0) {
            return Frame {
                closed: true, width: 0, height: 0, scale: 0.0, time: 0.0,
                pointer_x: 0.0, pointer_y: 0.0, pointer_down: false, key: -1, resized: false
            }
        }
        return next_frame(ref_at(address))
    }
}

pub fn key_down(window: Window, scancode: i32) -> bool {
    unsafe {
        address := active(ref_at(registry_address()), window)
        if address == ptr(0) { return false }
        return key_down_at(ref_at(address), scancode)
    }
}

pub fn key_pressed(window: Window, scancode: i32) -> bool {
    unsafe {
        address := active(ref_at(registry_address()), window)
        if address == ptr(0) { return false }
        return key_pressed_at(ref_at(address), scancode)
    }
}

pub fn mouse(window: Window) -> MouseState {
    unsafe {
        address := active(ref_at(registry_address()), window)
        if address == ptr(0) {
            return MouseState { x: 0, y: 0, dx: 0, dy: 0, buttons: 0, pressed: 0, scroll: 0.0 }
        }
        return mouse_at(ref_at(address))
    }
}

fn key_down_at(r: &state.Renderer, scancode: i32) -> bool {
    if scancode < 0 || scancode >= 512 { return false }
    r.window.keys[scancode] != 0
}

fn key_pressed_at(r: &state.Renderer, scancode: i32) -> bool {
    if scancode < 0 || scancode >= 512 { return false }
    r.window.pressed[scancode] != 0
}

fn mouse_at(r: &state.Renderer) -> MouseState {
    MouseState {
        x: r.window.x,
        y: r.window.y,
        dx: r.window.mouse_dx,
        dy: r.window.mouse_dy,
        buttons: r.window.buttons,
        pressed: r.window.buttons_pressed,
        scroll: r.window.wheel,
    }
}

// ---- Frame recording ----

fn stage_name(r: &state.Renderer) -> string {
    stage := r.stage
    mut name := ""
    if stage == 1 { name = "SDL window" }
    if stage == 2 { name = "Vulkan device" }
    if stage == 11 { name = "instance/surface" }
    if stage == 12 { name = "physical device (mesh requires " + state.MESH_PUSH_BYTES.str() + " bytes of push constants)" }
    if stage == 13 { name = "queue family" }
    if stage == 14 { name = "logical device" }
    if stage == 15 { name = "surface format" }
    if stage == 16 { name = "swapchain" }
    if stage == 17 { name = "depth buffer" }
    if stage == 3 { name = "pipeline" }
    if stage == 21 { name = "render pass" }
    if stage == 22 { name = "mesh pipeline" }
    if stage == 23 { name = "sky pipeline" }
    if stage == 24 { name = "framebuffers" }
    if stage == 4 { name = "frame sync" }
    if stage == 5 { name = "vertex buffer" }
    if name.len == 0 { name = "stage " + stage.str() }
    // What Vulkan said, when Vulkan said no.
    if r.lastResult != 0 { name = name + " (" + enums.result_name(r.lastResult) + ")" }
    name
}

fn draw_error(frames: i64, move message: string) -> DrawResult {
    DrawResult { ok: false, error: message.clone(), frames: frames }
}

unsafe fn begin_frame(r: &mut state.Renderer) -> BeginResult {
    if r.window.closed != 0 { return BeginResult { ok: false, error: "window is closed", width: 0, height: 0 } }
    if r.recording != 0 { return BeginResult { ok: false, error: "a frame is already being recorded", width: 0, height: 0 } }
    slot := r.current
    trace_step(&r, "frame " + r.frameIndex.str() + " slot " + slot.str() + " wait fence")
    waited := r.api.WaitForFences(r.device, 1, addr(&mut r.fences[slot]), 1, 18446744073709551615)
    if waited != 0 { return BeginResult { ok: false, error: "waiting for the frame fence failed", width: 0, height: 0 } }
    mut image_index: u32 = 0
    acquired := r.api.AcquireNextImageKHR(r.device, r.swapchain, 18446744073709551615,
        r.image_available[slot], ptr(0), addr(&mut image_index))
    if enums.is_out_of_date(acquired) {
        if !recreate(&mut r) { return BeginResult { ok: false, error: "swapchain is out of date and could not be recreated (" + enums.result_name(r.lastResult) + ")", width: 0, height: 0 } }
        return BeginResult { ok: false, error: "swapchain recreated; retry the frame", width: 0, height: 0 }
    }
    if acquired != 0 { return BeginResult { ok: false, error: "acquiring a swapchain image failed (" + enums.result_name(acquired) + ")", width: 0, height: 0 } }
    trace_step(&r, "acquired image " + i32(image_index).str())
    _ := r.api.ResetFences(r.device, 1, addr(&mut r.fences[slot]))
    _ := r.api.ResetCommandBuffer(r.commands[slot], 0)
    r.vertexCursor = 0
    mut begin: vk.CommandBufferBeginInfo = zeroed()
    begin.sType = 42
    begin.flags = enums.command_buffer_usage(.OneTimeSubmit)
    if r.api.BeginCommandBuffer(r.commands[slot], addr(&begin)) != 0 {
        return BeginResult { ok: false, error: "beginning the command buffer failed", width: 0, height: 0 }
    }
    mut clear_color: [f32; 4] = [1.0, 0.0, 0.0, 1.0]
    mut pass: vk.RenderPassBeginInfo = zeroed()
    pass.sType = 43
    pass.renderPass = r.renderPass
    pass.framebuffer = if r.captureOn == 1 { r.captureFramebuffer } else { r.framebuffers[i32(image_index)] }
    pass.renderArea.extent.width = r.width
    pass.renderArea.extent.height = r.height
    pass.clearValueCount = 2
    // ClearValue is a union: colour attachment first (four float words), then
    // the depth/stencil pair (depth f32 bits, stencil u32).
    mut clears: [u64; 4] = [0; 4]
    store_u32(addr(&mut clears[0]), u32(clear_color[0].to_bits()))
    store_u32(ptr(usize(addr(&mut clears[0])) + 4), u32(clear_color[1].to_bits()))
    store_u32(ptr(usize(addr(&mut clears[0])) + 8), u32(clear_color[2].to_bits()))
    store_u32(ptr(usize(addr(&mut clears[0])) + 12), u32(clear_color[3].to_bits()))
    clears[2] = depth.depth_clear(1.0)
    pass.pClearValues = addr(&mut clears[0])
    r.imageIndex = i32(image_index)
    r.pendingPass = pass
    r.pendingClear = clears
    r.pendingPass.pClearValues = addr(&mut r.pendingClear[0])
    r.recording = 1
    BeginResult { ok: true, error: "", width: i32(r.width), height: i32(r.height) }
}

// Open the main render pass. Called after prepare_frame and after the optional
// shadow pass has been recorded into the same command buffer.
unsafe fn open_main_pass(r: &mut state.Renderer) -> BeginResult {
    if r.recording == 0 { return BeginResult { ok: false, error: "no frame in flight", width: 0, height: 0 } }
    pass := r.pendingPass.clone()
    r.api.CmdBeginRenderPass(r.commands[r.current], addr(&pass), 0)
    r.api.CmdBindDescriptorSets(r.commands[r.current], 0, r.pipelineLayout, 0, 1, addr(&r.shadowSet), 0, ptr(0))
    trace_step(&r, "render pass begun")
    BeginResult { ok: true, error: "", width: i32(r.width), height: i32(r.height) }
}

unsafe fn sky_pass(r: &mut state.Renderer, inv_view_proj: &[f32; 16],
    sun: &[f32; 4], zenith: &[f32; 4], horizon: &[f32; 4]) -> DrawResult {
    if r.recording == 0 { return draw_error(r.frameIndex, "sky drawn outside begin/end") }
    slot := r.current
    // Push constants: inv_view_proj(64) + sun(16) + zenith(16) + horizon(16).
    mut push: [f32; 28] = [0.0; 28]
    for i in 0..16 { push[i] = inv_view_proj[i] }
    for i in 0..4 { push[16 + i] = sun[i] }
    for i in 0..4 { push[20 + i] = zenith[i] }
    for i in 0..4 { push[24 + i] = horizon[i] }
    r.api.CmdBindPipeline(r.commands[slot], 0, r.skyPipeline)
    r.api.CmdPushConstants(r.commands[slot], r.skyPipelineLayout, enums.shader_stage(.VertexFragment), 0, 112, addr(&push[0]))
    r.api.CmdDraw(r.commands[slot], 3, 1, 0, 0)
    DrawResult { ok: true, error: "", frames: r.frameIndex }
}

unsafe fn mesh_pass(r: &mut state.Renderer, vertices: &[]f32, mvp: &[f32; 16], model: &[f32; 16],
    base_color: &[f32; 4], params: &[f32; 4], camera: &[f32; 3], sky: &Sky, blended: bool) -> DrawResult {
    if r.recording == 0 { return draw_error(r.frameIndex, "mesh drawn outside begin/end") }
    if vertices.len % 6 != 0 { return draw_error(r.frameIndex, "vertices must be [x,y,z,nx,ny,nz] triples") }
    for i in 0..vertices.len {
        if !vertices[i].is_finite() { return draw_error(r.frameIndex, "non-finite vertex value") }
    }
    bytes := u64(vertices.len * 4)
    offset := r.vertexCursor
    if offset + bytes > r.vertex.capacity {
        return draw_error(r.frameIndex, "vertex list exceeds the mapped vertex buffer")
    }
    if vertices.len > 0 {
        _ := copy_bytes(ptr(usize(r.vertex.mapped) + usize(offset)), addr(&vertices[0]), usize(bytes))
    }
    r.vertexCursor = offset + bytes
    slot := r.current
    // mvp(64) model(64) base_color(16) params(16) camera(16)
    // sun(16) sun_color(16) zenith(16) horizon(16) = 240 bytes.
    mut push: [f32; 60] = [0.0; 60]
    for i in 0..16 { push[i] = mvp[i] }
    for i in 0..16 { push[16 + i] = model[i] }
    for i in 0..4 { push[32 + i] = base_color[i] }
    for i in 0..4 { push[36 + i] = params[i] }
    for i in 0..3 { push[40 + i] = camera[i] }
    for i in 0..4 { push[44 + i] = sky.sun[i] }
    for i in 0..4 { push[48 + i] = sky.sun_color[i] }
    for i in 0..4 { push[52 + i] = sky.zenith[i] }
    for i in 0..4 { push[56 + i] = sky.horizon[i] }
    if blended {
        r.api.CmdBindPipeline(r.commands[slot], 0, r.transparentPipeline)
    } else {
        r.api.CmdBindPipeline(r.commands[slot], 0, r.pipeline)
    }
    r.api.CmdBindVertexBuffers(r.commands[slot], 0, 1, addr(&r.vertex.handle), addr(&offset))
    r.api.CmdPushConstants(r.commands[slot], r.pipelineLayout, enums.shader_stage(.VertexFragment), 0, state.MESH_PUSH_BYTES, addr(&push[0]))
    r.api.CmdDraw(r.commands[slot], u32(vertices.len / 6), 1, 0, 0)
    DrawResult { ok: true, error: "", frames: r.frameIndex }
}

unsafe fn end_frame(r: &mut state.Renderer) -> DrawResult {
    if r.recording == 0 { return draw_error(r.frameIndex, "end without begin") }
    slot := r.current
    r.api.CmdEndRenderPass(r.commands[slot])
    if r.captureOn != 1 {
        // The scene pass leaves the image in COLOR_ATTACHMENT_OPTIMAL because
        // the capture path reads it straight back. Presentation needs its own
        // layout, so transition explicitly before submitting.
        mut barrier: vk.ImageMemoryBarrier = zeroed()
        barrier.sType = 45
        barrier.srcAccessMask = enums.access(.ColorAttachmentWrite)
        barrier.dstAccessMask = enums.access(.None)
        barrier.oldLayout = enums.image_layout(.ColorAttachmentOptimal)
        barrier.newLayout = enums.IMAGE_LAYOUT_PRESENT_SRC_KHR
        barrier.srcQueueFamilyIndex = 4294967295
        barrier.dstQueueFamilyIndex = 4294967295
        barrier.image = r.images[r.imageIndex]
        barrier.subresourceRange.aspectMask = enums.image_aspect(.Color)
        barrier.subresourceRange.levelCount = 1
        barrier.subresourceRange.layerCount = 1
        r.api.CmdPipelineBarrier(r.commands[slot], 1024, 4096, 0, 0, ptr(0), 0, ptr(0), 1, addr(&mut barrier))
    }
    if r.api.EndCommandBuffer(r.commands[slot]) != 0 {
        r.recording = 0
        return draw_error(r.frameIndex, "ending the command buffer failed")
    }
    mut submit_info: vk.SubmitInfo = zeroed()
    submit_info.sType = 4
    wait_stage: u32 = 1024
    submit_info.waitSemaphoreCount = 1
    submit_info.pWaitSemaphores = addr(&r.image_available[slot])
    submit_info.pWaitDstStageMask = addr(&wait_stage)
    submit_info.commandBufferCount = 1
    submit_info.pCommandBuffers = addr(&r.commands[slot])
    submit_info.signalSemaphoreCount = 1
    submit_info.pSignalSemaphores = addr(&r.render_finished[slot])
    trace_step(&r, "submit")
    if r.api.QueueSubmit(r.queue, 1, addr(&submit_info), r.fences[slot]) != 0 {
        r.recording = 0
        return draw_error(r.frameIndex, "queue submission failed")
    }
    if r.captureOn == 1 {
        // Offscreen frames are read back from mapped memory; nothing to present.
        _ := r.api.WaitForFences(r.device, 1, addr(&mut r.fences[slot]), 1, 18446744073709551615)
        r.captureOn = 2
        r.recording = 0
        r.current = (r.current + 1) % 2
        r.frameIndex = r.frameIndex + 1
        return DrawResult { ok: true, error: "", frames: r.frameIndex }
    }
    mut image_index := u32(r.imageIndex)
    mut present: vk.PresentInfoKHR = zeroed()
    present.sType = 1000001002
    present.waitSemaphoreCount = 1
    present.pWaitSemaphores = addr(&r.render_finished[slot])
    present.swapchainCount = 1
    present.pSwapchains = addr(&r.swapchain)
    present.pImageIndices = addr(&mut image_index)
    trace_step(&r, "present")
    presented := r.api.QueuePresentKHR(r.queue, addr(&present))
    trace_step(&r, "presented " + presented.str())
    r.recording = 0
    if enums.is_out_of_date(presented) {
        // The frame was not shown; build a new swapchain before the next one.
        if !recreate(&mut r) { return draw_error(r.frameIndex, "swapchain is out of date and could not be recreated (" + enums.result_name(r.lastResult) + ")") }
    } else if presented == i32(enums.VkResult.SuboptimalKHR) {
        // Shown, but the swapchain no longer matches the window: rebuild it
        // now that presenting is done, and let the frame count as delivered.
        if !recreate(&mut r) { return draw_error(r.frameIndex, "swapchain is suboptimal and could not be recreated (" + enums.result_name(r.lastResult) + ")") }
    } else if presented != 0 {
        return draw_error(r.frameIndex, "presenting failed (" + enums.result_name(presented) + ")")
    }
    r.current = (r.current + 1) % 2
    r.frameIndex = r.frameIndex + 1
    DrawResult { ok: true, error: "", frames: r.frameIndex }
}

// Rebuild everything that depends on the swapchain size.
unsafe fn recreate(r: &mut state.Renderer) -> bool {
    _ := r.api.DeviceWaitIdle(r.device)
    pipeline.destroy_framebuffers(&mut r)
    depth.destroy(&mut r)
    device.destroy_swapchain(&mut r)
    if !device.setup_swapchain_only(&mut r) { return false }
    if !depth.create(&mut r, r.width, r.height) { return false }
    pipeline.setup_frames_only(&mut r)
}

pub fn begin(window: Window) -> BeginResult {
    unsafe {
        address := active(ref_at(registry_address()), window)
        if address == ptr(0) { return BeginResult { ok: false, error: "invalid or expired window handle", width: 0, height: 0 } }
        return begin_frame(ref_at(address))
    }
}

pub fn sky(window: Window, inv_view_proj: &[f32; 16], sun: &[f32; 4], zenith: &[f32; 4], horizon: &[f32; 4]) -> DrawResult {
    unsafe {
        address := active(ref_at(registry_address()), window)
        if address == ptr(0) { return draw_error(0, "invalid or expired window handle") }
        return sky_pass(ref_at(address), &inv_view_proj, &sun, &zenith, &horizon)
    }
}

pub fn mesh(window: Window, vertices: &[]f32, mvp: &[f32; 16], model: &[f32; 16],
    base_color: &[f32; 4], params: &[f32; 4], camera: &[f32; 3], sky: &Sky) -> DrawResult {
    unsafe {
        address := active(ref_at(registry_address()), window)
        if address == ptr(0) { return draw_error(0, "invalid or expired window handle") }
        return mesh_pass(ref_at(address), &vertices, &mvp, &model, &base_color, &params, &camera, sky, false)
    }
}

// Open the main render pass. Call after begin() and after any shadow pass.
pub fn begin_pass(window: Window) -> BeginResult {
    unsafe {
        address := active(ref_at(registry_address()), window)
        if address == ptr(0) { return BeginResult { ok: false, error: "invalid or expired window handle", width: 0, height: 0 } }
        return open_main_pass(ref_at(address))
    }
}

// --- shadow pass (recorded before the main pass, same command buffer) ---

pub fn shadow_begin(window: Window, light_vp: &[f32; 16], light_dir_c: &[f32; 4]) -> DrawResult {
    unsafe {
        address := active(ref_at(registry_address()), window)
        if address == ptr(0) { return draw_error(0, "invalid or expired window handle") }
        _ := shadow.set_light(ref_at(address), &light_vp, &light_dir_c)
        if !shadow.begin(ref_at(address), &light_vp, &light_dir_c) {
            return draw_error(0, "shadow pass could not start")
        }
        DrawResult { ok: true, error: "", frames: 0 }
    }
}

pub fn shadow_mesh(window: Window, vertices: &[]f32, model: &[f32; 16]) -> DrawResult {
    unsafe {
        address := active(ref_at(registry_address()), window)
        if address == ptr(0) { return draw_error(0, "invalid or expired window handle") }
        if !shadow.mesh(ref_at(address), &vertices, &model) {
            return draw_error(0, "shadow mesh rejected")
        }
        DrawResult { ok: true, error: "", frames: 0 }
    }
}

pub fn shadow_end(window: Window) -> DrawResult {
    unsafe {
        address := active(ref_at(registry_address()), window)
        if address == ptr(0) { return draw_error(0, "invalid or expired window handle") }
        _ := shadow.end(ref_at(address))
        DrawResult { ok: true, error: "", frames: 0 }
    }
}

// Same geometry path with alpha blending, for the transparent pass.
pub fn mesh_blended(window: Window, vertices: &[]f32, mvp: &[f32; 16], model: &[f32; 16],
    base_color: &[f32; 4], params: &[f32; 4], camera: &[f32; 3], sky: &Sky) -> DrawResult {
    unsafe {
        address := active(ref_at(registry_address()), window)
        if address == ptr(0) { return draw_error(0, "invalid or expired window handle") }
        return mesh_pass(ref_at(address), &vertices, &mvp, &model, &base_color, &params, &camera, sky, true)
    }
}

// Paint the cinematic overlay over the finished scene.
pub fn overlay(window: Window, time: f32, amount: f32) -> DrawResult {
    unsafe {
        address := active(ref_at(registry_address()), window)
        if address == ptr(0) { return draw_error(0, "invalid or expired window handle") }
        if !post.draw(ref_at(address), time, amount) { return draw_error(0, "overlay draw failed") }
        DrawResult { ok: true, error: "", frames: 0 }
    }
}

// Draw UI quads in screen pixels. Rectangles set uv.x to -1.
pub fn ui_draw(window: Window, vertices: []f32, screen: [f32; 2]) -> DrawResult {
    unsafe {
        address := active(ref_at(registry_address()), window)
        if address == ptr(0) { return draw_error(0, "invalid or expired window handle") }
        if !ui.draw(ref_at(address), vertices, screen) { return draw_error(0, "UI draw failed") }
        DrawResult { ok: true, error: "", frames: 0 }
    }
}

// Reset the UI vertex cursor; called once per frame before building quads.
pub fn ui_reset(window: Window) {
    unsafe {
        address := active(ref_at(registry_address()), window)
        if address == ptr(0) { return }
        ui.reset(ref_at(address))
    }
}

// Upload the packed glyph coverage atlas.
pub fn ui_atlas(window: Window, pixels: []u8, width: i32, height: i32) -> bool {
    unsafe {
        address := active(ref_at(registry_address()), window)
        if address == ptr(0) { return false }
        return ui.upload_atlas(ref_at(address), pixels, width, height)
    }
}

pub fn end(window: Window) -> DrawResult {
    unsafe {
        address := active(ref_at(registry_address()), window)
        if address == ptr(0) { return draw_error(0, "invalid or expired window handle") }
        return end_frame(ref_at(address))
    }
}

// Lighting parameters shared by the sky pass and the mesh pass. Keeping one
// struct means the dome you see and the light the surfaces receive cannot drift
// apart.
pub struct Sky {
    sun: [f32; 4], // xyz towards the sun, w = intensity
    sun_color: [f32; 4],
    zenith: [f32; 4],
    horizon: [f32; 4],
    light_vp: [f32; 16], // sun view-projection for the shadow lookup
    light_dir_c: [f32; 4], // xyz towards the sun, w = dot(light_origin, dir)
}

pub fn sky_params(sun: [f32; 4], sun_color: [f32; 4], zenith: [f32; 4], horizon: [f32; 4],
    light_vp: [f32; 16], light_dir_c: [f32; 4]) -> Sky {
    Sky {
        sun: sun.clone(), sun_color: sun_color.clone(), zenith: zenith.clone(), horizon: horizon.clone(),
        light_vp: light_vp.clone(), light_dir_c: light_dir_c.clone()
    }
}

// ---- Teardown ----

unsafe fn teardown(r: &mut state.Renderer) -> ptr {
    post.destroy(&mut r)
    ui.destroy(&mut r)
    ibl.destroy(&mut r)
    depth.destroy(&mut r)
    loader := r.loader
    device.destroy(&mut r)
    sdl.close(&mut r.window)
    loader
}

unsafe fn close_window(registry: &mut Registry, window: Window) {
    address := active(&registry, window)
    if address != ptr(0) {
        registry.active = ptr(0)
        loader := teardown(ref_at(address))
        if loader != ptr(0) { _ := dl.close(loader) }
        release(address)
    }
}

pub fn close(window: Window) {
    unsafe { close_window(ref_at(registry_address()), window) }
}

// ---- Geometry helpers: interleaved [x, y, z, nx, ny, nz] ----

pub fn vertex(vertices: &mut []f32, x: f32, y: f32, z: f32, nx: f32, ny: f32, nz: f32) {
    vertices.push(x)
    vertices.push(y)
    vertices.push(z)
    vertices.push(nx)
    vertices.push(ny)
    vertices.push(nz)
}

pub fn triangle(vertices: &mut []f32, ax: f32, ay: f32, az: f32, bx: f32, by: f32, bz: f32,
    cx: f32, cy: f32, cz: f32, nx: f32, ny: f32, nz: f32) {
    vertex(&mut vertices, ax, ay, az, nx, ny, nz)
    vertex(&mut vertices, bx, by, bz, nx, ny, nz)
    vertex(&mut vertices, cx, cy, cz, nx, ny, nz)
}

// Axis-aligned box centred at the origin. 36 vertices, flat normals per face.
pub fn cube(vertices: &mut []f32, half: f32) {
    // +Z
    triangle(&mut vertices, -half, -half, half, half, -half, half, half, half, half, 0.0, 0.0, 1.0)
    triangle(&mut vertices, -half, -half, half, half, half, half, -half, half, half, 0.0, 0.0, 1.0)
    // -Z
    triangle(&mut vertices, half, -half, -half, -half, -half, -half, -half, half, -half, 0.0, 0.0, -1.0)
    triangle(&mut vertices, half, -half, -half, -half, half, -half, half, half, -half, 0.0, 0.0, -1.0)
    // -X
    triangle(&mut vertices, -half, -half, -half, -half, -half, half, -half, half, half, -1.0, 0.0, 0.0)
    triangle(&mut vertices, -half, -half, -half, -half, half, half, -half, half, -half, -1.0, 0.0, 0.0)
    // +X
    triangle(&mut vertices, half, -half, half, half, -half, -half, half, half, -half, 1.0, 0.0, 0.0)
    triangle(&mut vertices, half, -half, half, half, half, -half, half, half, half, 1.0, 0.0, 0.0)
    // +Y
    triangle(&mut vertices, -half, half, half, half, half, half, half, half, -half, 0.0, 1.0, 0.0)
    triangle(&mut vertices, -half, half, half, half, half, -half, -half, half, -half, 0.0, 1.0, 0.0)
    // -Y
    triangle(&mut vertices, -half, -half, -half, half, -half, -half, half, -half, half, 0.0, -1.0, 0.0)
    triangle(&mut vertices, -half, -half, -half, half, -half, half, -half, -half, half, 0.0, -1.0, 0.0)
}

// Ground plane in XZ at y = 0, normal +Y.
pub fn plane(vertices: &mut []f32, extent: f32) {
    // Wound so the upward face survives back-face culling under the mesh
    // pipeline's clockwise front face.
    triangle(&mut vertices, -extent, 0.0, -extent, extent, 0.0, extent, extent, 0.0, -extent, 0.0, 1.0, 0.0)
    triangle(&mut vertices, -extent, 0.0, -extent, -extent, 0.0, extent, extent, 0.0, extent, 0.0, 1.0, 0.0)
}
