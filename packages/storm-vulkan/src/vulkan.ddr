// Storm's Vulkan backend: a real VK_KHR_swapchain presentation path (no
// readback) in an SDL window, for Linux. It implements gfx.Backend; what
// it promises is written there, and nothing outside this package needs to
// know that Vulkan or SDL exist.
//
//   match vulkan.open("Storm", 1280, 800) {
//       .Ok(window) => { ... }
//       .Err(message) => { ... }
//   }
//
// The shadow pass has its own render pass before begin_pass. Mesh vertices
// are interleaved [x, y, z, nx, ny, nz] f32 (24 bytes).

capability unsafe, stdio

import gfx
import std.bytes as b
import std.dl as dl
import std.sys as sys
import .api as api
import .depth as depth
import .device as device
import .enums as enums
import .headless as headless
import .ibl as ibl
import .layout as vk
import .pipeline as pipeline
import .post as post
import .shadow as shadow
import .ui as ui
import .sdl as sdl
import .state as state
import .texture as texture

// A live renderer, by generation: the handle is a plain value the
// application can copy, and an expired one is refused, never followed.
pub struct Window { id: i64 }

// What one recorded step came to. Private: the trait methods turn these
// into Result values.
struct BeginResult { ok: bool, error: string }
struct DrawResult { ok: bool, error: string, frames: i64 }

@c_layout
struct Registry { active: ptr, generation: i64 }

unsafe fn registry_address() -> ptr { static_bytes("native", 16) }

@extern("c", "calloc")
unsafe fn allocate(count: usize, bytes: usize) -> ptr
@extern("c", "free")
unsafe fn release(address: ptr)
@extern("c", "memcpy")
unsafe fn copy_bytes(destination: ptr, source: ptr, bytes: usize) -> ptr

unsafe fn initialize(r: &mut state.Renderer, title: string, width: i32, height: i32, windowed: bool) -> state.SetupStep {
    r.width = u32(width)
    r.height = u32(height)
    r.frameIndex = 0
    r.current = 0
    if windowed && !sdl.open(&mut r.window, title, width, height) { return .Window }
    mut step := device.setup(&mut r)
    if step != .Ready { return step }
    step = depth.create(&mut r, r.width, r.height)
    if step != .Ready { return step }
    step = shadow.setup(&mut r)
    if step != .Ready { return step }
    step = texture.setup(&mut r)
    if step != .Ready { return step }
    step = pipeline.setup(&mut r)
    if step != .Ready { return step }
    step = post.setup(&mut r)
    if step != .Ready { return step }
    step = ui.setup(&mut r)
    if step != .Ready { return step }
    device.setup_frames(&mut r)
}

// The live renderer behind a handle, or null for one that has expired.
unsafe fn renderer(window: Window) -> ptr { active(ref_at(registry_address()), window) }

unsafe fn bootstrap(r: &mut state.Renderer, loader: ptr, windowed: bool) -> bool {
    r.loader = loader
    api.load(&mut r.api, loader, windowed)
}

unsafe fn open_renderer(registry: &mut Registry, title: string, width: i32, height: i32, windowed: bool) -> Result<Window, string> {
    if width < 1 || width > 8192 || height < 1 || height > 8192 {
        return .Err("window dimensions must be between 1 and 8192")
    }
    if registry.active != ptr(0) { return .Err("a Storm window is already open") }
    address := allocate(1, size_of(state.Renderer) + 8192)
    if address == ptr(0) { return .Err("could not allocate Vulkan state") }
    loader := dl.open(cstr("libvulkan.so.1"), 2)
    if loader == ptr(0) {
        release(address)
        return .Err("Vulkan loader is unavailable")
    }
    if !bootstrap(ref_at(address), loader, windowed) {
        _ := dl.close(loader)
        release(address)
        return .Err("Vulkan loader is missing required entry points")
    }
    mut failed := initialize(ref_at(address), title, width, height, windowed)
    if failed != .Ready {
        failure := describe(ref_at(address), failed)
        _ := teardown(ref_at(address))
        _ := dl.close(loader)
        release(address)
        return .Err("Vulkan initialization failed at " + failure)
    }
    registry.generation = registry.generation + 1
    registry.active = address
    .Ok(Window { id: registry.generation })
}

pub fn open(title: string, width: i32, height: i32) -> Result<Window, string> {
    unsafe { open_renderer(ref_at(registry_address()), title, width, height, true) }
}

pub fn open_preview(title: string, width: i32, height: i32) -> Result<Window, string> {
    unsafe { open_renderer(ref_at(registry_address()), title, width, height, false) }
}

unsafe fn active(registry: &Registry, window: Window) -> ptr {
    if registry.generation != window.id { return ptr(0) }
    registry.active
}

unsafe fn name(r: &state.Renderer) -> string {
    mut bytes: []u8 = []
    for i in 0..256 {
        byte := r.properties.deviceName[i]
        if byte == 0 { break }
        bytes.push(byte)
    }
    match b.decode(&bytes) {
        .Ok(text) => text,
        .Err(_) => "",
    }
}

unsafe fn capture_next_at(r: &mut state.Renderer) -> bool {
    if r.pass != state.PASS_IDLE { return false }
    if r.captureFramebuffer == ptr(0) && headless.setup(&mut r) != .Ready { return false }
    r.captureOn = 1
    true
}

unsafe fn set_trace_at(r: &mut state.Renderer, enabled: bool) {
    r.trace = if enabled { 1 } else { 0 }
}

fn trace_step(r: &state.Renderer, message: string) {
    if r.trace != 0 { print("storm/vk: " + message) }
}

unsafe fn next_frame(r: &mut state.Renderer) -> gfx.Frame {
    if r.window.handle == ptr(0) {
        return gfx.Frame { closed: false, width: i32(r.width), height: i32(r.height), scale: 1.0,
            time: f64(sys.now_ms()) / 1000.0, resized: false, input: gfx.Input::empty() }
    }
    sdl.poll(&mut r.window)
    if r.window.resized != 0 { r.resizePending = 1 }
    gfx.Frame {
        closed: r.window.closed != 0,
        width: r.window.width,
        height: r.window.height,
        scale: 1.0,
        time: f64(sys.now_ms()) / 1000.0,
        resized: r.window.resized != 0,
        input: sdl.input(&r.window),
    }
}

// An expired handle describes a closed window with no input.
fn closed_frame() -> gfx.Frame {
    gfx.Frame { closed: true, width: 0, height: 0, scale: 1.0, time: 0.0, resized: false, input: gfx.Input::empty() }
}

// The step that failed, and what Vulkan said when it did.
fn describe(r: &state.Renderer, failed: state.SetupStep) -> string {
    mut text := failed.name()
    if r.lastResult != 0 { text = text + " (" + enums.result_name(r.lastResult) + ")" }
    text
}

fn draw_error(frames: i64, move message: string) -> DrawResult {
    DrawResult { ok: false, error: message.clone(), frames: frames }
}

unsafe fn begin_frame(r: &mut state.Renderer, vertex_bytes: u64) -> BeginResult {
    if r.window.closed != 0 { return BeginResult { ok: false, error: "window is closed" } }
    if r.pass != state.PASS_IDLE { return BeginResult { ok: false, error: "a frame is already being recorded" } }
    slot := r.current
    trace_step(&r, "frame " + r.frameIndex.str() + " slot " + slot.str() + " wait fence")
    // The CPU is about to reuse the mapped mesh, UI and light buffers shared by both slots.
    waited := r.api.WaitForFences(r.device, u32(r.fences.len), addr(&mut r.fences[0]), 1, 18446744073709551615)
    if waited != 0 { return BeginResult { ok: false, error: "waiting for the frame fence failed" } }
    if r.resizePending != 0 {
        mut width: i32 = 0
        mut height: i32 = 0
        r.window.GetDrawableSize(r.window.handle, addr(&mut width), addr(&mut height))
        if width > 0 && height > 0 && (u32(width) != r.width || u32(height) != r.height) {
            capture := r.captureOn == 1
            failed := recreate(&mut r)
            if failed != .Ready { return BeginResult { ok: false, error: "could not resize at " + describe(&r, failed) } }
            if capture && !capture_next_at(&mut r) { return BeginResult { ok: false, error: "could not resize the capture target" } }
        }
        r.resizePending = 0
    }
    capacity := gfx.frame_vertex_capacity(r.vertex.capacity, vertex_bytes)
    if capacity > r.vertex.capacity {
        mut step := device.replace_vertex_buffer(&mut r, capacity)
        if step != .Ready && capacity > vertex_bytes && vertex_bytes > 0 {
            step = device.replace_vertex_buffer(&mut r, vertex_bytes)
        }
        if step != .Ready { return BeginResult { ok: false, error: "could not reserve vertex stream: " + describe(&r, step) } }
        trace_step(&r, "reserved " + r.vertex.capacity.str() + " vertex bytes for " + vertex_bytes.str())
    }
    mut image_index: u32 = 0
    if r.surface == ptr(0) && r.captureOn != 1 {
        return BeginResult { ok: false, error: "offscreen rendering requires capture_next" }
    }
    if r.captureOn != 1 {
        mut acquired := r.api.AcquireNextImageKHR(r.device, r.swapchain, 18446744073709551615,
            r.image_available[slot], ptr(0), addr(&mut image_index))
        if enums.is_out_of_date(acquired) {
            failed := recreate(&mut r)
            if failed != .Ready { return BeginResult { ok: false, error: "swapchain is out of date and could not be recreated at " + describe(&r, failed) } }
            acquired = r.api.AcquireNextImageKHR(r.device, r.swapchain, 18446744073709551615,
                r.image_available[slot], ptr(0), addr(&mut image_index))
        }
        if !enums.is_success(acquired) { return BeginResult { ok: false, error: "acquiring a swapchain image failed (" + enums.result_name(acquired) + ")" } }
        trace_step(&r, "acquired image " + i32(image_index).str())
    }
    _ := r.api.ResetFences(r.device, 1, addr(&mut r.fences[slot]))
    _ := r.api.ResetCommandBuffer(r.commands[slot], 0)
    // Per-frame cursors: every stream is appended anew, by the frame itself.
    r.vertexCursor = 0
    ui.reset(&mut r)
    mut begin: vk.CommandBufferBeginInfo = vk.CommandBufferBeginInfo::new()
    begin.flags = enums.command_buffer_usage(.OneTimeSubmit)
    if r.api.BeginCommandBuffer(r.commands[slot], addr(&begin)) != 0 {
        return BeginResult { ok: false, error: "beginning the command buffer failed" }
    }
    mut clear_color: [f32; 4] = [1.0, 0.0, 0.0, 1.0]
    mut pass: vk.RenderPassBeginInfo = vk.RenderPassBeginInfo::new()
    pass.renderPass = r.renderPass
    pass.framebuffer = if r.captureOn == 1 { r.captureFramebuffer } else { r.framebuffers[i32(image_index)] }
    pass.renderArea.extent.width = r.width
    pass.renderArea.extent.height = r.height
    pass.clearValueCount = 2
    // ClearValue is a union: colour attachment first (four float words), then
    // the depth/stencil pair (depth f32 bits, stencil u32).
    mut clears: [u64; 4] = [0; 4]
    store_u32(addr(&mut clears[0]), u32(clear_color[0].to_bits()))
    store_u32(ptr(usize(addr(&mut clears[0])) + 4), u32(clear_color[1].to_bits()))
    store_u32(ptr(usize(addr(&mut clears[0])) + 8), u32(clear_color[2].to_bits()))
    store_u32(ptr(usize(addr(&mut clears[0])) + 12), u32(clear_color[3].to_bits()))
    clears[2] = depth.depth_clear(1.0)
    pass.pClearValues = addr(&mut clears[0])
    r.imageIndex = i32(image_index)
    r.pendingPass = pass
    r.pendingClear = clears
    r.pendingPass.pClearValues = addr(&mut r.pendingClear[0])
    r.pass = state.PASS_WAITING
    BeginResult { ok: true, error: "" }
}

// Open the main render pass. Called after prepare_frame and after the optional
// shadow pass has been recorded into the same command buffer.
unsafe fn open_main_pass(r: &mut state.Renderer, filtered: bool) -> BeginResult {
    if r.pass == state.PASS_IDLE { return BeginResult { ok: false, error: "no frame in flight" } }
    if r.pass != state.PASS_WAITING { return BeginResult { ok: false, error: "a render pass has already started" } }
    if !shadow.ensure_readable(&mut r) { return BeginResult { ok: false, error: "could not initialize the shadow map" } }
    mut pass := r.pendingPass.clone()
    if filtered {
        failed := post.ensure_target(&mut r)
        if failed != .Ready { return BeginResult { ok: false, error: "could not set up the scene texture: " + describe(&r, failed) } }
        pass.framebuffer = r.sceneFramebuffer
        pass.renderPass = r.scenePass
        r.pass = state.PASS_FILTERED
    } else {
        r.pass = state.PASS_DIRECT
    }
    device.set_frame_viewport(&r)
    r.api.CmdBeginRenderPass(r.commands[r.current], addr(&pass), 0)
    r.api.CmdBindDescriptorSets(r.commands[r.current], 0, r.pipelineLayout, 0, 1, addr(&r.shadowSet), 0, ptr(0))
    trace_step(&r, "render pass begun")
    BeginResult { ok: true, error: "" }
}

unsafe fn sky_pass(r: &mut state.Renderer, inv_view_proj: &[f32; 16],
    sun: &[f32; 4], zenith: &[f32; 4], horizon: &[f32; 4]) -> DrawResult {
    if r.pass != state.PASS_DIRECT && r.pass != state.PASS_FILTERED { return draw_error(r.frameIndex, "sky requires an open scene") }
    slot := r.current
    // Push constants: inv_view_proj(64) + sun(16) + zenith(16) + horizon(16).
    mut push: [f32; 28] = [0.0; 28]
    for i in 0..16 { push[i] = inv_view_proj[i] }
    for i in 0..4 { push[16 + i] = sun[i] }
    for i in 0..4 { push[20 + i] = zenith[i] }
    for i in 0..4 { push[24 + i] = horizon[i] }
    r.api.CmdBindPipeline(r.commands[slot], 0, r.skyPipeline)
    r.api.CmdPushConstants(r.commands[slot], r.skyPipelineLayout, enums.shader_stage(.VertexFragment), 0, 112, addr(&push[0]))
    r.api.CmdDraw(r.commands[slot], 3, 1, 0, 0)
    DrawResult { ok: true, error: "", frames: r.frameIndex }
}

unsafe fn mesh_pass(r: &mut state.Renderer, vertices: &[]f32, mvp: &[f32; 16], model: &[f32; 16],
    base_color: &[f32; 4], params: &[f32; 4], camera: &[f32; 3], sky: &gfx.Sky, texture_id: i64, blended: bool) -> DrawResult {
    if r.pass != state.PASS_DIRECT && r.pass != state.PASS_FILTERED { return draw_error(r.frameIndex, "mesh requires an open scene") }
    if vertices.len % gfx.VERTEX_FLOATS != 0 { return draw_error(r.frameIndex, "vertices must be [x,y,z,nx,ny,nz,u,v]") }
    for i in 0..vertices.len {
        if !vertices[i].is_finite() { return draw_error(r.frameIndex, "non-finite vertex value") }
    }
    bytes := u64(vertices.len) * 4
    offset := r.vertexCursor
    if offset > r.vertex.capacity || bytes > r.vertex.capacity - offset {
        return draw_error(r.frameIndex, "vertex list exceeds the mapped vertex buffer")
    }
    if vertices.len > 0 {
        _ := copy_bytes(ptr(usize(r.vertex.mapped) + usize(offset)), addr(&vertices[0]), usize(bytes))
    }
    r.vertexCursor = offset + bytes
    slot := r.current
    // mvp(64) model(64) base_color(16) params(16) camera(16)
    // sun(16) sun_color(16) zenith(16) horizon(16) = 240 bytes.
    mut push: [f32; 60] = [0.0; 60]
    for i in 0..16 { push[i] = mvp[i] }
    for i in 0..16 { push[16 + i] = model[i] }
    for i in 0..4 { push[32 + i] = base_color[i] }
    for i in 0..4 { push[36 + i] = params[i] }
    for i in 0..3 { push[40 + i] = camera[i] }
    for i in 0..4 { push[44 + i] = sky.sun[i] }
    for i in 0..3 { push[48 + i] = sky.sun_color[i] }
    push[51] = sky.diffuse_fill
    for i in 0..4 { push[52 + i] = sky.zenith[i] }
    for i in 0..4 { push[56 + i] = sky.horizon[i] }
    if blended {
        r.api.CmdBindPipeline(r.commands[slot], 0, r.transparentPipeline)
    } else {
        r.api.CmdBindPipeline(r.commands[slot], 0, r.pipeline)
    }
    material_set := texture.set_of(ref_at(r.material.table), texture_id)
    r.api.CmdBindDescriptorSets(r.commands[slot], 0, r.pipelineLayout, 1, 1, addr(&material_set), 0, ptr(0))
    r.api.CmdBindVertexBuffers(r.commands[slot], 0, 1, addr(&r.vertex.handle), addr(&offset))
    r.api.CmdPushConstants(r.commands[slot], r.pipelineLayout, enums.shader_stage(.VertexFragment), 0, state.MESH_PUSH_BYTES, addr(&push[0]))
    r.api.CmdDraw(r.commands[slot], u32(vertices.len / gfx.VERTEX_FLOATS), 1, 0, 0)
    DrawResult { ok: true, error: "", frames: r.frameIndex }
}

unsafe fn end_frame(r: &mut state.Renderer) -> DrawResult {
    if r.pass == state.PASS_IDLE { return draw_error(r.frameIndex, "end without begin") }
    if r.pass != state.PASS_DIRECT && r.pass != state.PASS_COMPOSITE { return draw_error(r.frameIndex, "end requires a finished scene") }
    slot := r.current
    r.api.CmdEndRenderPass(r.commands[slot])
    if r.captureOn == 1 {
        headless.copy_to_host(&r)
    } else {
        // The same scene pass writes every target. A swapchain image must be
        // transitioned for the presentation engine.
        mut barrier: vk.ImageMemoryBarrier = vk.ImageMemoryBarrier::new()
        barrier.srcAccessMask = enums.access(.ColorAttachmentWrite)
        barrier.dstAccessMask = enums.access(.None)
        barrier.oldLayout = enums.image_layout(.ColorAttachmentOptimal)
        barrier.newLayout = enums.IMAGE_LAYOUT_PRESENT_SRC_KHR
        barrier.srcQueueFamilyIndex = enums.QUEUE_FAMILY_IGNORED
        barrier.dstQueueFamilyIndex = enums.QUEUE_FAMILY_IGNORED
        barrier.image = r.images[r.imageIndex]
        barrier.subresourceRange.aspectMask = enums.image_aspect(.Color)
        barrier.subresourceRange.levelCount = 1
        barrier.subresourceRange.layerCount = 1
        r.api.CmdPipelineBarrier(r.commands[slot], enums.pipeline_stage(.ColorAttachmentOutput), enums.pipeline_stage(.BottomOfPipe),
            0, 0, ptr(0), 0, ptr(0), 1, addr(&mut barrier))
    }
    if r.api.EndCommandBuffer(r.commands[slot]) != 0 {
        r.pass = state.PASS_IDLE
        return draw_error(r.frameIndex, "ending the command buffer failed")
    }
    mut submit_info: vk.SubmitInfo = vk.SubmitInfo::new()
    wait_stage := enums.pipeline_stage(.ColorAttachmentOutput)
    if r.captureOn != 1 {
        submit_info.waitSemaphoreCount = 1
        submit_info.pWaitSemaphores = addr(&r.image_available[slot])
        submit_info.pWaitDstStageMask = addr(&wait_stage)
        submit_info.signalSemaphoreCount = 1
        submit_info.pSignalSemaphores = addr(&r.render_finished[r.imageIndex])
    }
    submit_info.commandBufferCount = 1
    submit_info.pCommandBuffers = addr(&r.commands[slot])
    trace_step(&r, "submit")
    if r.api.QueueSubmit(r.queue, 1, addr(&submit_info), r.fences[slot]) != 0 {
        r.pass = state.PASS_IDLE
        return draw_error(r.frameIndex, "queue submission failed")
    }
    if r.captureOn == 1 {
        // Offscreen frames are read back from mapped memory; nothing to present.
        if r.api.WaitForFences(r.device, 1, addr(&mut r.fences[slot]), 1, 18446744073709551615) != 0 {
            r.pass = state.PASS_IDLE
            return draw_error(r.frameIndex, "waiting for capture readback failed")
        }
        r.captureOn = 2
        r.pass = state.PASS_IDLE
        r.current = (r.current + 1) % 2
        r.frameIndex = r.frameIndex + 1
        return DrawResult { ok: true, error: "", frames: r.frameIndex }
    }
    mut image_index := u32(r.imageIndex)
    mut present: vk.PresentInfoKHR = vk.PresentInfoKHR::new()
    present.waitSemaphoreCount = 1
    present.pWaitSemaphores = addr(&r.render_finished[r.imageIndex])
    present.swapchainCount = 1
    present.pSwapchains = addr(&r.swapchain)
    present.pImageIndices = addr(&mut image_index)
    trace_step(&r, "present")
    presented := r.api.QueuePresentKHR(r.queue, addr(&present))
    trace_step(&r, "presented " + presented.str())
    r.pass = state.PASS_IDLE
    if enums.is_out_of_date(presented) {
        // The frame was not shown; build a new swapchain before the next one.
        failed := recreate(&mut r)
        if failed != .Ready { return draw_error(r.frameIndex, "swapchain is out of date and could not be recreated at " + describe(&r, failed)) }
    } else if presented == i32(enums.VkResult.SuboptimalKHR) {
        // Shown, but the swapchain no longer matches the window: rebuild it
        // now that presenting is done, and let the frame count as delivered.
        failed := recreate(&mut r)
        if failed != .Ready { return draw_error(r.frameIndex, "swapchain is suboptimal and could not be recreated at " + describe(&r, failed)) }
    } else if presented != 0 {
        return draw_error(r.frameIndex, "presenting failed (" + enums.result_name(presented) + ")")
    }
    r.current = (r.current + 1) % 2
    r.frameIndex = r.frameIndex + 1
    DrawResult { ok: true, error: "", frames: r.frameIndex }
}

// Rebuild everything that depends on the swapchain size.
unsafe fn recreate(r: &mut state.Renderer) -> state.SetupStep {
    _ := r.api.DeviceWaitIdle(r.device)
    pipeline.destroy_framebuffers(&mut r)
    headless.destroy(&mut r)
    post.destroy_target(&mut r)
    depth.destroy(&mut r)
    device.destroy_swapchain(&mut r)
    mut step := device.setup_swapchain_only(&mut r)
    if step != .Ready { return step }
    step = depth.create(&mut r, r.width, r.height)
    if step != .Ready { return step }
    pipeline.setup_frames_only(&mut r)
}

// ---- the contract: every promise in gfx.Backend, kept with Vulkan ----

fn begun(move result: BeginResult) -> Result<(), string> {
    if result.ok { return .Ok }
    .Err(result.error)
}

fn drawn(move result: DrawResult) -> Result<(), string> {
    if result.ok { return .Ok }
    .Err(result.error)
}

impl gfx.Backend for Window {
    fn poll(&mut self) -> gfx.Frame {
        unsafe {
            address := renderer(self.clone())
            if address == ptr(0) { return closed_frame() }
            return next_frame(ref_at(address))
        }
    }

    fn device_name(&self) -> string {
        unsafe {
            address := renderer(self.clone())
            if address == ptr(0) { return "" }
            return name(ref_at(address))
        }
    }

    fn set_trace(&mut self, enabled: bool) {
        unsafe {
            address := renderer(self.clone())
            if address != ptr(0) { set_trace_at(ref_at(address), enabled) }
        }
    }

    fn capture_next(&mut self) -> Result<(), string> {
        unsafe {
            address := renderer(self.clone())
            if address == ptr(0) { return .Err("invalid or expired window handle") }
            if !capture_next_at(ref_at(address)) { return .Err("could not set up the capture target") }
            .Ok
        }
    }

    fn save_capture(&mut self, path: string) -> Result<(), string> {
        unsafe {
            address := renderer(self.clone())
            if address == ptr(0) { return .Err("invalid or expired window handle") }
            if !headless.save(ref_at(address), path) { return .Err("could not write the capture") }
            .Ok
        }
    }

    fn build_environment(&mut self, sky: &gfx.Sky) -> Result<(), string> {
        unsafe {
            address := renderer(self.clone())
            if address == ptr(0) { return .Err("invalid or expired window handle") }
            failed := ibl.setup(ref_at(address), &sky.sun, &sky.zenith, &sky.horizon)
            if failed != .Ready {
                return .Err("could not build the environment maps at " + describe(ref_at(address), failed))
            }
            .Ok
        }
    }

    fn begin_with_vertices(&mut self, vertex_bytes: u64) -> Result<(), string> {
        unsafe {
            address := renderer(self.clone())
            if address == ptr(0) { return .Err("invalid or expired window handle") }
            return begun(begin_frame(ref_at(address), vertex_bytes))
        }
    }

    // The sun's shadow map, in its own render pass, before begin_pass.
    fn shadow_begin(&mut self, sky: &gfx.Sky) -> Result<(), string> {
        unsafe {
            address := renderer(self.clone())
            if address == ptr(0) { return .Err("invalid or expired window handle") }
            if !shadow.begin(ref_at(address), &sky.light_vp, &sky.light_dir_c) {
                return .Err("shadow pass could not start")
            }
            .Ok
        }
    }

    fn shadow_mesh(&mut self, vertices: &[]f32, model: &[f32; 16]) -> Result<(), string> {
        unsafe {
            address := renderer(self.clone())
            if address == ptr(0) { return .Err("invalid or expired window handle") }
            if !shadow.mesh(ref_at(address), &vertices, &model) { return .Err("shadow mesh rejected") }
            .Ok
        }
    }

    fn shadow_end(&mut self) -> Result<(), string> {
        unsafe {
            address := renderer(self.clone())
            if address == ptr(0) { return .Err("invalid or expired window handle") }
            if !shadow.end(ref_at(address)) { return .Err("shadow pass is not open") }
            .Ok
        }
    }

    // Open the main render pass. Call after begin() and after any shadow pass.
    fn begin_scene(&mut self, filtered: bool) -> Result<(), string> {
        unsafe {
            address := renderer(self.clone())
            if address == ptr(0) { return .Err("invalid or expired window handle") }
            return begun(open_main_pass(ref_at(address), filtered))
        }
    }

    fn sky(&mut self, inv_view_projection: &[f32; 16], sun: &[f32; 4], zenith: &[f32; 4], horizon: &[f32; 4]) -> Result<(), string> {
        unsafe {
            address := renderer(self.clone())
            if address == ptr(0) { return .Err("invalid or expired window handle") }
            return drawn(sky_pass(ref_at(address), &inv_view_projection, &sun, &zenith, &horizon))
        }
    }

    fn mesh(&mut self, vertices: &[]f32, mvp: &[f32; 16], model: &[f32; 16], base_color: &[f32; 4],
        params: &[f32; 4], camera: &[f32; 3], sky: &gfx.Sky, texture: gfx.Texture, surface: gfx.Surface) -> Result<(), string> {
        unsafe {
            address := renderer(self.clone())
            if address == ptr(0) { return .Err("invalid or expired window handle") }
            return drawn(mesh_pass(ref_at(address), &vertices, &mvp, &model, &base_color, &params, &camera, sky, texture.id, surface == gfx.Surface.Blended))
        }
    }

    fn upload_texture(&mut self, pixels: []u8, width: i32, height: i32, sampler: &gfx.Sampler) -> Result<gfx.Texture, string> {
        unsafe {
            address := renderer(self.clone())
            if address == ptr(0) { return .Err("invalid or expired window handle") }
            match texture.upload(ref_at(address), pixels, width, height, sampler) {
                .Ok(id) => .Ok(gfx.Texture { id: id }),
                .Err(message) => .Err(message),
            }
        }
    }

    fn free_texture(&mut self, handle: gfx.Texture) {
        unsafe {
            address := renderer(self.clone())
            if address != ptr(0) { texture.free(ref_at(address), handle.id) }
        }
    }

    fn post_process(&mut self, settings: &gfx.PostProcess) -> Result<(), string> {
        unsafe {
            address := renderer(self.clone())
            if address == ptr(0) { return .Err("invalid or expired window handle") }
            return post.composite(ref_at(address), settings)
        }
    }

    // Upload the packed glyph coverage atlas.
    fn ui_atlas(&mut self, pixels: []u8, width: i32, height: i32) -> Result<(), string> {
        unsafe {
            address := renderer(self.clone())
            if address == ptr(0) { return .Err("invalid or expired window handle") }
            failed := ui.upload_atlas(ref_at(address), pixels, width, height)
            if failed != .Ready { return .Err("atlas upload failed at " + describe(ref_at(address), failed)) }
            .Ok
        }
    }

    // Draw UI quads in points. Rectangles set uv.x to -1.
    fn ui_draw(&mut self, vertices: []f32, screen: [f32; 2]) -> Result<(), string> {
        unsafe {
            address := renderer(self.clone())
            if address == ptr(0) { return .Err("invalid or expired window handle") }
            if !ui.draw(ref_at(address), vertices, screen) { return .Err("UI draw failed") }
            .Ok
        }
    }

    fn end(&mut self) -> Result<i64, string> {
        unsafe {
            address := renderer(self.clone())
            if address == ptr(0) { return .Err("invalid or expired window handle") }
            finished := end_frame(ref_at(address))
            if finished.ok { return .Ok(finished.frames) }
            .Err(finished.error)
        }
    }

    fn close(move self) {
        unsafe { close_window(ref_at(registry_address()), self) }
    }
}

// ---- Teardown ----

unsafe fn teardown(r: &mut state.Renderer) -> ptr {
    if r.device != ptr(0) {
        _ := r.api.DeviceWaitIdle(r.device)
        pipeline.destroy_framebuffers(&mut r)
        headless.destroy(&mut r)
        shadow.destroy(&mut r)
    }
    post.destroy(&mut r)
    ui.destroy(&mut r)
    ibl.destroy(&mut r)
    texture.destroy(&mut r)
    depth.destroy(&mut r)
    loader := r.loader
    device.destroy(&mut r)
    sdl.close(&mut r.window)
    loader
}

unsafe fn close_window(registry: &mut Registry, window: Window) {
    address := active(&registry, window)
    if address != ptr(0) {
        registry.active = ptr(0)
        loader := teardown(ref_at(address))
        if loader != ptr(0) { _ := dl.close(loader) }
        release(address)
    }
}
