capability unsafe

import gfx
import .device as device
import vk.enums as enums
import vk.layout as vk2
import .pipeline as pipelines
import .shader as shader
import .state as state
import .records as records

// What this module owns: the offscreen scene target (image, memory, two
// views), the composite pass, its pipeline, layout and shaders, and the
// sampled scene texture. Zeroed with the renderer; `setup` and
// `ensure_target` fill it, `destroy` empties it, and nobody outside this
// module reads it. The names other modules bind — `scenePass`,
// `compositePass` and `sceneFramebuffer` — stay on `Renderer`.
@c_layout
pub struct Stage {
    image: ptr,
    memory: ptr,
    view: ptr,
    sampleView: ptr,
    pipeline: ptr,
    pipelineLayout: ptr,
    texture: state.SampledTexture,
    vertShader: ptr,
    fragShader: ptr,
}

unsafe fn create_pipeline(r: &mut state.Renderer) -> state.SetupStep {
    vert := shader.post_vertex()
    frag := shader.post_fragment()
    mut vert_module := ptr(0)
    mut code := device.shader_module(&r, addr(&vert[0]), usize(vert.len * 4), addr(&mut vert_module))
    if code != 0 { return device.fail(&mut r, code, .PostProcess) }
    r.post.vertShader = vert_module
    mut frag_module := ptr(0)
    code = device.shader_module(&r, addr(&frag[0]), usize(frag.len * 4), addr(&mut frag_module))
    if code != 0 { return device.fail(&mut r, code, .PostProcess) }
    r.post.fragShader = frag_module

    // The post pass reads the scene colour as a fullscreen triangle and
    // writes the final image: nothing is culled, depth is not touched.
    mut push_range: vk2.PushConstantRange = zeroed()
    push_range.stageFlags = enums.shader_stage(.Fragment)
    push_range.size = 16
    mut layout_info: vk2.PipelineLayoutCreateInfo = vk2.PipelineLayoutCreateInfo::new()
    layout_info.setLayoutCount = 1
    layout_info.pSetLayouts = addr(&r.post.texture.layout)
    layout_info.pushConstantRangeCount = 1
    layout_info.pPushConstantRanges = addr(&mut push_range)
    code = r.api.CreatePipelineLayout(r.device, addr(&layout_info), ptr(0), addr(&mut r.post.pipelineLayout))
    if code != 0 { return device.fail(&mut r, code, .PostProcess) }

    plan := pipelines.Plan {
        vertex: r.post.vertShader, fragment: r.post.fragShader,
        layout: r.post.pipelineLayout, pass: r.renderPass,
        cull: .None, depth: pipelines.depth_off(), blend: .None,
        vertices: .None, viewport: .Frame, encoded: true,
    }
    mut pipeline := ptr(0)
    code = pipelines.build(&r, &plan, addr(&mut pipeline))
    if code != 0 { return device.fail(&mut r, code, .PostProcess) }
    r.post.pipeline = pipeline
    .Ready
}

pub unsafe fn setup(r: &mut state.Renderer) -> state.SetupStep {
    result := device.sampled_texture(&r.api, r.device, &mut r.post.texture)
    if result != 0 { return device.fail(&mut r, result, .PostProcess) }
    create_pipeline(&mut r)
}

pub unsafe fn destroy_target(r: &mut state.Renderer) {
    r.api.DestroyFramebuffer(r.device, r.sceneFramebuffer, ptr(0))
    r.api.DestroyImageView(r.device, r.post.sampleView, ptr(0))
    r.api.DestroyImageView(r.device, r.post.view, ptr(0))
    r.api.DestroyImage(r.device, r.post.image, ptr(0))
    r.api.FreeMemory(r.device, r.post.memory, ptr(0))
    r.sceneFramebuffer = ptr(0)
    r.post.sampleView = ptr(0)
    r.post.view = ptr(0)
    r.post.image = ptr(0)
    r.post.memory = ptr(0)
}

unsafe fn create_target(r: &mut state.Renderer) -> i32 {
    // Match the scene attachment's transfer function to the display target.
    // The sampling view always reads the resulting display-encoded bytes.
    sampled := if records.format_is_bgra(r.format) { enums.format(.B8G8R8A8_UNORM) } else { enums.format(.R8G8B8A8_UNORM) }
    mut info := device.image_2d_info(r.format, r.width, r.height, enums.ImageTiling.Optimal, enums.ImageUsage.ColorAttachmentSampled)
    if sampled != r.format { info.flags = enums.image_create(.MutableFormat) }
    mut code := r.api.CreateImage(r.device, addr(&info), ptr(0), addr(&mut r.post.image))
    if code != 0 { return code }
    mut req: vk2.MemoryRequirements = zeroed()
    r.api.GetImageMemoryRequirements(r.device, r.post.image, addr(&mut req))
    mut memory := ptr(0)
    code = device.allocate(&r, &req, .Some(enums.Memory.DeviceLocal), addr(&mut memory))
    r.post.memory = memory
    if code != 0 { return code }
    code = r.api.BindImageMemory(r.device, r.post.image, memory, 0)
    if code != 0 { return code }
    mut view: vk2.ImageViewCreateInfo = vk2.ImageViewCreateInfo::new()
    view.image = r.post.image
    view.viewType = enums.image_view_type(.Type2D)
    view.format = r.format
    view.subresourceRange.aspectMask = enums.image_aspect(.Color)
    view.subresourceRange.levelCount = 1
    view.subresourceRange.layerCount = 1
    code = r.api.CreateImageView(r.device, addr(&view), ptr(0), addr(&mut r.post.view))
    if code != 0 { return code }
    mut sample_view := r.post.view
    if sampled != r.format {
        view.format = sampled
        code = r.api.CreateImageView(r.device, addr(&view), ptr(0), addr(&mut r.post.sampleView))
        if code != 0 { return code }
        sample_view = r.post.sampleView
    }
    mut framebuffer := ptr(0)
    code = device.color_framebuffer(&r, r.post.view, addr(&mut framebuffer))
    r.sceneFramebuffer = framebuffer
    if code == 0 { device.sample_view(&r, &r.post.texture, sample_view) }
    code
}

pub unsafe fn ensure_target(r: &mut state.Renderer) -> state.SetupStep {
    if r.sceneFramebuffer != ptr(0) { return .Ready }
    if !records.format_has_bytes(r.format) { return .Format }
    code := create_target(&mut r)
    if code == 0 { return .Ready }
    destroy_target(&mut r)
    device.fail(&mut r, code, .PostProcess)
}

pub unsafe fn composite(r: &mut state.Renderer, settings: &gfx.PostProcess) -> Result<(), string> {
    if state.pass(&r) != .Filtered { return .Err("post-processing requires an open filtered scene") }
    if !settings.valid() { return .Err("post-process strength must be between 0 and 1") }
    cmd := r.commands[r.current]
    r.api.CmdEndRenderPass(cmd)
    mut barrier: vk2.ImageMemoryBarrier = vk2.ImageMemoryBarrier::new()
    barrier.srcAccessMask = enums.access(.ColorAttachmentWrite)
    barrier.dstAccessMask = enums.access(.ShaderRead)
    barrier.oldLayout = enums.image_layout(.ColorAttachmentOptimal)
    barrier.newLayout = enums.image_layout(.ShaderReadOnlyOptimal)
    barrier.srcQueueFamilyIndex = enums.QUEUE_FAMILY_IGNORED
    barrier.dstQueueFamilyIndex = enums.QUEUE_FAMILY_IGNORED
    barrier.image = r.post.image
    barrier.subresourceRange.aspectMask = enums.image_aspect(.Color)
    barrier.subresourceRange.levelCount = 1
    barrier.subresourceRange.layerCount = 1
    r.api.CmdPipelineBarrier(cmd, enums.pipeline_stage(.ColorAttachmentOutput), enums.pipeline_stage(.FragmentShader),
        0, 0, ptr(0), 0, ptr(0), 1, addr(&barrier))
    mut pass := r.pendingPass.clone()
    pass.renderPass = r.compositePass
    pass.clearValueCount = 0
    r.api.CmdBeginRenderPass(cmd, addr(&pass), 0)
    r.api.CmdBindPipeline(cmd, 0, r.post.pipeline)
    r.api.CmdBindDescriptorSets(cmd, 0, r.post.pipelineLayout, 0, 1, addr(&r.post.texture.set), 0, ptr(0))
    aa := if settings.antialias { 1.0 } else { 0.0 }
    push := [f32(1.0) / f32(r.width), f32(1.0) / f32(r.height), f32(aa), settings.strength]
    r.api.CmdPushConstants(cmd, r.post.pipelineLayout, enums.shader_stage(.Fragment), 0, 16, addr(&push[0]))
    r.api.CmdDraw(cmd, 3, 1, 0, 0)
    state.set_pass(&mut r, .Composite)
    .Ok
}

pub unsafe fn destroy(r: &mut state.Renderer) {
    if r.device == ptr(0) { return }
    destroy_target(&mut r)
    r.api.DestroyShaderModule(r.device, r.post.vertShader, ptr(0))
    r.api.DestroyShaderModule(r.device, r.post.fragShader, ptr(0))
    r.api.DestroyPipeline(r.device, r.post.pipeline, ptr(0))
    r.api.DestroyPipelineLayout(r.device, r.post.pipelineLayout, ptr(0))
    device.destroy_texture(&r, &r.post.texture)
}
