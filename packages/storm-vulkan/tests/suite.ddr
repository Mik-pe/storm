capability unsafe

import ..src.layout as vk
import ..src.depth as depth
import ..src.device as device
import ..src.enums as enums
import gfx
import ..src.headless as headless
import ..src.sdl as sdl
import ..src.state as state

// The raw SDL state of a window, as the engine's keys and pointer. Either
// shift key is Shift; a key held since an earlier frame is down but not
// newly pressed.
@test fn sdl_key_state_becomes_engine_input() {
    unsafe {
        mut window: sdl.Window = zeroed()
        assert(!sdl.input(&window).down(gfx.Key.W))
        window.keys[4] = 1 // SDL_SCANCODE_A
        window.pressed[4] = 1
        window.keys[26] = 1 // SDL_SCANCODE_W, held since an earlier frame
        window.keys[229] = 1 // right shift
        window.x = 12
        window.y = 34
        window.mouse_dx = 3
        window.mouse_dy = -2
        window.buttons = 2
        window.buttons_pressed = 2
        window.wheel = 1.0
        input := sdl.input(&window)
        assert(input.down(gfx.Key.A) && input.hit(gfx.Key.A))
        assert(input.down(gfx.Key.W) && !input.hit(gfx.Key.W))
        assert(input.down(gfx.Key.Shift) && !input.down(gfx.Key.Ctrl) && !input.down(gfx.Key.S))
        assert(input.mouse.x == 12.0 && input.mouse.y == 34.0 && input.mouse.dx == 3.0 && input.mouse.dy == -2.0)
        assert(input.button_down(gfx.MOUSE_RIGHT) && !input.button_down(gfx.MOUSE_LEFT) && input.button_hit(gfx.MOUSE_RIGHT))
        assert(input.mouse.scroll == 1.0)
    }
}

@test fn vertex_input_declares_the_whole_stream() {
    // The one layout both mesh pipelines declare: one binding, three
    // attributes, and the binding's stride covers all of them.
    unsafe {
        mut input := vk.vertex_input()
        enums.apply_vertex_input(&mut input)
        assert(input.binding.stride == gfx.VERTEX_BYTES)
        assert(input.binding.inputRate == 0)
        assert(size_of(vk.VertexAttributes) == 48)
        assert(size_of(vk.VertexInput) == 60)
        a := input.attributes.position
        b := input.attributes.normal
        c := input.attributes.uv
        assert(a.location == 0 && a.offset == 0 && a.format == 106)
        assert(b.location == 1 && b.offset == 12 && b.format == 106)
        assert(c.location == 2 && c.offset == 24 && c.format == 103)
        assert(a.binding == 0 && b.binding == 0 && c.binding == 0)
        // Inside the record the three descriptions sit back to back, 16 bytes
        // apart, and the words are C's: [location, binding, format, offset].
        base := usize(addr(&input.attributes))
        assert(usize(addr(&input.attributes.normal)) - base == 16)
        assert(usize(addr(&input.attributes.uv)) - base == 32)
        assert(usize(addr(&input.attributes)) - usize(addr(&input.binding)) == 12)
        assert(load_u32(ptr(base + 4 * 4)) == 1)
        assert(load_u32(ptr(base + 8 * 4)) == 2)
        assert(load_u32(ptr(base + 8 * 4 + 8)) == 103)
        assert(load_u32(ptr(base + 8 * 4 + 12)) == 24)
    }
}

@test fn barrier_struct_matches_the_c_abi() {
    assert(size_of(vk.ImageMemoryBarrier) == 72)
}

@test fn image_creation_and_device_limits_match_the_vulkan_abi() {
    unsafe {
        mut properties: state.Properties = zeroed()
        assert(usize(addr(&properties.limits.maxPushConstantsSize)) - usize(addr(&properties)) == 328)
        assert(size_of(state.Properties) >= 824)
        image := device.image_2d_info(126, 512, 128, vk.IMAGE_TILING_OPTIMAL, 32)
        assert(image.sType == 14 && image.imageType == 1 && image.format == 126)
        assert(image.extent.width == 512 && image.extent.height == 128 && image.extent.depth == 1)
        assert(image.mipLevels == 1 && image.arrayLayers == 1 && image.samples == 1)
        assert(image.tiling == 0 && vk.IMAGE_TILING_LINEAR == 1 && image.usage == 32)
        assert(image.sharingMode == 0 && image.pNext == ptr(0))
    }
}

@test fn capture_buffer_has_four_bytes_per_pixel_including_odd_widths() {
    assert(headless.readback_size(719, 451) == 1297076)
    assert(headless.readback_size(8192, 8192) == 268435456)
}

@test fn depth_clear_packs_the_depth_stencil_union() {
    // 1.0f32 = 0x3F800000, stencil 0 in the high word.
    assert(depth.depth_clear(1.0) == u64(0x3F800000))
    assert(depth.depth_clear(0.5) == u64(0x3F000000))
    // Stencil is always zero in the high 32 bits.
    assert(depth.depth_clear(1.0).shr(32) == 0)
}

@test fn render_pass_structs_match_the_c_abi() {
    // Two attachments side by side must read as one contiguous array.
    assert(size_of(vk.AttachmentDescription) == 36)
    assert(size_of(vk.AttachmentReference) == 8)
    assert(size_of(vk.SubpassDescription) == 72)
    // pDepthStencilAttachment sits after two u32+padding pairs and the two
    // colour pointers: 48 bytes in. C puts it there too.
    unsafe {
        mut subpass: vk.SubpassDescription = zeroed()
        assert(usize(addr(&subpass.pDepthStencilAttachment)) - usize(addr(&subpass)) == 48)
        assert(usize(addr(&subpass.pColorAttachments)) - usize(addr(&subpass)) == 32)
    }
}

@test fn float_bits_covers_both_signs() {
    assert(depth.float_bits(1.0) == 0x3F800000)
    assert(depth.float_bits(-1.0) == 0xBF800000)
    assert(depth.float_bits(-1000.0) == 0xC47A0000)
    assert(depth.float_bits(0.0) == 0)
    assert(depth.float_bits(f32.from_bits(-2147483648)) == 0x80000000)
    assert(depth.float_bits(f32.from_bits(-4194303)) == 0xffc00001)
    assert(depth.depth_clear(1.0) == 0x3F800000)
}

@test fn c_record_pairs_and_arrays_are_contiguous() {
    // The pairs handed to Vulkan (vk.Dependencies, Attachments, ShaderStages,
    // References, Attributes) are records of records; this pins that the
    // second element starts right after the first and that a named stage /
    // external subpass value lands where C puts it. A plain [T; N] of the
    // same record is contiguous too (measured: size 56, stride 28); the
    // pairs exist so every module shares one declaration.
    assert(size_of(vk.SubpassDependency) == 28)
    assert(size_of(vk.PipelineShaderStageCreateInfo) == 48)
    assert(size_of(vk.VertexInputAttributeDescription) == 16)
    assert(size_of(vk.Dependencies) == 56)
    assert(size_of(vk.Attachments) == 72)
    assert(size_of(vk.ShaderStages) == 96)
    assert(size_of(vk.References) == 16)
    assert(size_of(vk.Attributes) == 32)
    assert(size_of([vk.SubpassDependency; 2]) == 56)
    unsafe {
        mut before: vk.SubpassDependency = zeroed()
        before.srcSubpass = enums.SUBPASS_EXTERNAL
        before.srcStageMask = enums.pipeline_stage(.ColorAttachmentOutput)
        mut after: vk.SubpassDependency = zeroed()
        after.dstSubpass = enums.SUBPASS_EXTERNAL
        after.dstStageMask = enums.pipeline_stage(.FragmentShader)
        after.dstAccessMask = enums.access(.ShaderRead)
        deps := vk.Dependencies { before: before, after: after }
        base := usize(addr(&deps))
        assert(usize(addr(&deps.after)) - base == 28)
        // after = { srcSubpass@28, dstSubpass@32, srcStageMask@36, dstStageMask@40,
        //            srcAccessMask@44, dstAccessMask@48, flags@52 } exactly as C.
        assert(load_u32(ptr(base)) == 4294967295)
        assert(load_u32(ptr(base + 8)) == 1024)
        assert(load_u32(ptr(base + 28)) == 0)
        assert(load_u32(ptr(base + 32)) == 4294967295)
        assert(load_u32(ptr(base + 40)) == 128)
        assert(load_u32(ptr(base + 48)) == 32)
        array := [before, after]
        assert(usize(addr(&array[1])) - usize(addr(&array[0])) == 28)
        assert(load_u32(ptr(usize(addr(&array[0])) + 40)) == 128)
    }
}

@test fn vk_enum_values_match_the_khronos_tables() {
    // The tables as Khronos prints them. A recited table once came out in the
    // wrong order and shipped two pipelines blending with the inverse factors;
    // this pins every value Storm converts to a C integer.
    assert(enums.blend_factor(.SrcAlpha) == 6)
    assert(enums.blend_factor(.OneMinusSrcAlpha) == 7)
    assert(enums.blend_factor(.OneMinusDstColor) == 5)
    assert(enums.blend_factor(.One) == 1)
    assert(enums.blend_op(.Add) == 0 && enums.blend_op(.Max) == 4)
    assert(enums.filter(.Nearest) == 0 && enums.filter(.Linear) == 1)
    assert(enums.sampler_mipmap_mode(.Nearest) == 0 && enums.sampler_mipmap_mode(.Linear) == 1)
    assert(enums.sampler_address_mode(.ClampToEdge) == 2)
    assert(enums.primitive_topology(.TriangleList) == 3)
    assert(enums.polygon_mode(.Fill) == 0)
    assert(enums.cull_mode(.None) == 0 && enums.cull_mode(.Back) == 2)
    assert(enums.front_face(.CounterClockwise) == 0 && enums.front_face(.Clockwise) == 1)
    assert(enums.compare_op(.Less) == 1 && enums.compare_op(.LessOrEqual) == 3)
    assert(enums.image_view_type(.Type2D) == 1 && enums.image_view_type(.Cube) == 3)
    assert(enums.image_aspect(.Color) == 1 && enums.image_aspect(.Depth) == 2)
    assert(enums.image_layout(.Undefined) == 0)
    assert(enums.image_layout(.ColorAttachmentOptimal) == 2)
    assert(enums.image_layout(.DepthStencilAttachmentOptimal) == 3)
    assert(enums.image_layout(.ShaderReadOnlyOptimal) == 5)
    assert(enums.attachment_load_op(.Load) == 0 && enums.attachment_load_op(.Clear) == 1)
    assert(enums.attachment_store_op(.Store) == 0 && enums.attachment_store_op(.DontCare) == 1)
    assert(enums.pipeline_bind_point(.Graphics) == 0)
    assert(enums.descriptor_type(.CombinedImageSampler) == 1 && enums.descriptor_type(.UniformBuffer) == 6)
    assert(enums.sharing_mode(.Exclusive) == 0)
    assert(enums.image_tiling(.Optimal) == 0 && enums.image_tiling(.Linear) == 1)
    assert(enums.command_buffer_usage(.OneTimeSubmit) == 1)
    assert(enums.shader_stage(.Vertex) == 1 && enums.shader_stage(.Fragment) == 16)
    assert(enums.shader_stage(.VertexFragment) == 17)
    assert(enums.image_usage(.TransferSrc) == 1 && enums.image_usage(.Sampled) == 4)
    assert(enums.image_usage(.ColorAttachment) == 16 && enums.image_usage(.DepthStencilAttachment) == 32)
    assert(enums.buffer_usage(.TransferSrc) == 1 && enums.buffer_usage(.UniformBuffer) == 16)
    assert(enums.buffer_usage(.VertexBuffer) == 128)
    assert(enums.image_create(.CubeCompatible) == 16)
    assert(enums.command_pool_flag(.ResetCommandBuffer) == 2)
    assert(enums.pipeline_stage(.Host) == 16384)
    assert(enums.descriptor_pool(.FreeDescriptorSet) == 2)
    assert(enums.fence(.Signaled) == 1)
    assert(enums.color_component(.RGBA) == 15)
    assert(enums.samples(.Type1) == 1)
    // The blend attachment is a value, not five integers: ALPHA_OVER is the
    // one every alpha-over pipeline (UI, overlay, glass) writes.
    unsafe {
        mut attachment: vk.PipelineColorBlendAttachmentState = zeroed()
        enums.apply_blend(&mut attachment, &enums.alpha_over())
        assert(attachment.blendEnable == 1)
        assert(attachment.srcColorBlendFactor == 6)
        assert(attachment.dstColorBlendFactor == 7)
        assert(attachment.srcAlphaBlendFactor == 1)
        assert(attachment.dstAlphaBlendFactor == 7)
        assert(attachment.colorBlendOp == 0 && attachment.alphaBlendOp == 0)
        assert(attachment.colorWriteMask == 15)
        enums.apply_blend(&mut attachment, &enums.shadow_max())
        assert(attachment.srcColorBlendFactor == 1 && attachment.dstColorBlendFactor == 1)
        assert(attachment.colorBlendOp == 4)
    }
}

// The codes Storm acts on, against the Khronos VkResult reference page. The
// old constant ERROR_OUT_OF_DATE_KHR was -1000001003, which is no VkResult at
// all, so the out-of-date branch could never fire.
@test fn vk_result_codes_match_the_khronos_table() {
    assert(i32(enums.VkResult.Success) == 0)
    assert(i32(enums.VkResult.ErrorOutOfHostMemory) == -1)
    assert(i32(enums.VkResult.ErrorOutOfDeviceMemory) == -2)
    assert(i32(enums.VkResult.ErrorDeviceLost) == -4)
    assert(i32(enums.VkResult.ErrorExtensionNotPresent) == -7)
    assert(i32(enums.VkResult.ErrorFeatureNotPresent) == -8)
    assert(i32(enums.VkResult.ErrorIncompatibleDriver) == -9)
    assert(i32(enums.VkResult.SuboptimalKHR) == 1000001003)
    assert(i32(enums.VkResult.ErrorOutOfDateKHR) == -1000001004)
    assert(i32(enums.VkResult.ErrorSurfaceLostKHR) == -1000000000)
    assert(i32(enums.VkResult.ErrorNativeWindowInUseKHR) == -1000000001)
    assert(enums.result_name(-1000001004) == "VK_ERROR_OUT_OF_DATE_KHR")
    assert(enums.result_name(1000001003) == "VK_SUBOPTIMAL_KHR")
    assert(enums.result_name(0) == "VK_SUCCESS")
    assert(enums.result_name(12345) == "VK_ERROR_?")
    assert(enums.is_success(0))
    assert(enums.is_success(1000001003))
    assert(!enums.is_success(-1000001004))
    assert(enums.is_out_of_date(-1000001004))
    assert(!enums.is_out_of_date(-1000001003))
}

// fail() is the one place a Vulkan code becomes a setup failure: it must hand
// back the step it was given (the step is the return value, not a field) and
// record the code for describe(). Every step takes the same path, so check all.
@test fn fail_hands_back_its_step_and_records_the_code() {
    unsafe {
        mut r: state.Renderer = zeroed()
        steps := [state.SetupStep.Window, .Instance, .PhysicalDevice, .QueueFamily, .Device, .Format, .Swapchain,
            .Shadow, .Pipeline, .Overlay, .Ui, .DepthBuffer, .FrameSync, .VertexBuffer, .Environment, .CaptureTarget]
        mut i := 0
        while i < steps.len {
            r.lastResult = 0
            code := -1000001000 - i
            failed := device.fail(&mut r, code, steps[i])
            assert(failed == steps[i])
            assert(r.lastResult == code)
            i = i + 1
        }
    }
}

// A failure message is "<step name> (<VK name>)": a step without a name would
// print as an empty string and the message would start with a space.
@test fn every_setup_step_is_named_and_ready_is_the_sentinel() {
    assert(state.SetupStep.Ready.name() == "ready")
    steps := [state.SetupStep.Window, .Instance, .PhysicalDevice, .QueueFamily, .Device, .Format, .Swapchain,
        .Shadow, .Pipeline, .Overlay, .Ui, .DepthBuffer, .FrameSync, .VertexBuffer, .Environment, .CaptureTarget]
    mut i := 0
    while i < steps.len {
        text := steps[i].name()
        assert(text.len > 0)
        assert(text != "ready")
        i = i + 1
    }
    assert(enums.result_name(-13) == "VK_ERROR_UNKNOWN")
}
