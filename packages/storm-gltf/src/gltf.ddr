// Storm glTF 2.0 loader.
//
// Embedded GLB buffers, interleaved triangle streams and per-primitive PBR factors.
// asset() preserves every mesh name and material split; load_mesh() exposes
// the first primitive for callers that consume separate attribute arrays.
capability filesystem

import core
import std.bytes as bytes
import std.json as json
import std.wire as wire
import sys
import gfx
import .nodes
import .textures as textures

pub struct Mesh {
    ok: bool,
    error: string,
    positions: []f32,
    normals: []f32,
    uvs: []f32,
    indices: []i32,
    index_count: i32,
    vertex_count: i32,
}

pub struct Document {
    ok: bool,
    error: string,
    json_text: string,
    bin: []u8,
    has_bin: bool,
    mesh: Mesh,
}

fn fail(move message: string) -> Document {
    Document { ok: false, error: message, json_text: "", bin: [], has_bin: false, mesh: empty_mesh() }
}

pub fn empty_mesh() -> Mesh {
    Mesh { ok: false, error: "", positions: [], normals: [], uvs: [], indices: [], index_count: 0, vertex_count: 0 }
}

// ---- GLB container ----

struct Chunk { start: i32, length: i32 }
struct Glb { json: Chunk, bin: Option<Chunk> }

// The four literal bytes JSON and BIN followed by NUL, in little-endian order.
pub const JSON_CHUNK: u32 = 1313821514
pub const BIN_CHUNK: u32 = 5130562

fn glb_chunks(data: &[]u8) -> Option<Glb> {
    if data.len < 20 || bytes.u32_le(data, 4) != 2 || bytes.u32_le(data, 8) != i64(data.len) { return .None }
    mut chunks := Glb { json: Chunk { start: 0, length: 0 }, bin: .None }
    mut offset := 12
    while offset < data.len {
        if data.len - offset < 8 { return .None }
        count := bytes.u32_le(data, offset)
        kind := u32(bytes.u32_le(data, offset + 4))
        start := offset + 8
        if count > i64(data.len - start) || count % 4 != 0 { return .None }
        chunk := Chunk { start: start, length: i32(count) }
        if offset == 12 {
            if kind != JSON_CHUNK || count == 0 { return .None }
            chunks.json = chunk
        } else if kind == BIN_CHUNK {
            if chunks.bin.is_some() { return .None }
            chunks.bin = .Some(chunk)
        } else if kind == JSON_CHUNK { return .None }
        offset = start + i32(count)
    }
    .Some(chunks)
}

// ---- Document loading ----

pub fn load(path: string) -> Document {
    res := sys.read_u8(path)
    if !res.ok {
        return fail("cannot read '" + path + "': " + sys.error_message(res.error))
    }
    return load_bytes(&res.value)
}

pub fn load_bytes(data: &[]u8) -> Document {
    if data.len == 0 { return fail("empty glTF file") }
    mut json_text := ""
    mut bin: []u8 = []
    mut has_bin := false
    if bytes.equals_text(data, 0, 4, "glTF") {
        chunks := match glb_chunks(data) { .Some(v) => v, .None => { return fail("invalid GLB container") } }
        chunk := chunks.json
        match bytes.decode_range(data, chunk.start, chunk.start + chunk.length) {
            .Ok(text) => { json_text = text },
            .Err(_) => { return fail("glTF JSON chunk is not valid UTF-8") },
        }
        match chunks.bin {
            .Some(b) => {
                bin = (&data[b.start..b.start + b.length]).clone()
                has_bin = true
            },
            .None => {},
        }
    } else {
        match bytes.decode(data) {
            .Ok(text) => { json_text = text },
            .Err(_) => { return fail("glTF file is neither GLB nor UTF-8 JSON") },
        }
    }
    doc := json.Doc::parse_text(json_text.clone())
    if !doc.ok { return fail("glTF JSON: " + doc.error) }
    Document { ok: true, error: "", json_text: json_text, bin: bin, has_bin: has_bin, mesh: empty_mesh() }
}

// ---- Accessors ----

fn component_size(component_type: i32) -> i32 {
    if component_type == 5120 { return 1 } // BYTE
    if component_type == 5121 { return 1 } // UNSIGNED_BYTE
    if component_type == 5122 { return 2 } // SHORT
    if component_type == 5123 { return 2 } // UNSIGNED_SHORT
    if component_type == 5125 { return 4 } // UNSIGNED_INT
    if component_type == 5126 { return 4 } // FLOAT
    0
}

fn component_count(kind: string) -> i32 {
    if kind == "SCALAR" { return 1 }
    if kind == "VEC2" { return 2 }
    if kind == "VEC3" { return 3 }
    if kind == "VEC4" { return 4 }
    if kind == "MAT4" { return 16 }
    0
}

// Read one component as f32, normalizing integer types like glTF specifies.
fn read_component(data: &[]u8, offset: i32, component_type: i32, normalized: bool) -> f32 {
    if component_type == 5126 {
        mut reader := wire.Reader::new()
        reader.pos = offset
        return reader.read_f32(data)
    }
    if component_type == 5120 {
        mut raw := i32(data[offset])
        if raw > 127 { raw = raw - 256 }
        if normalized { return if raw == -128 { -1.0 } else { f32(raw) / 127.0 } }
        return f32(raw)
    }
    if component_type == 5121 {
        mut raw := i32(data[offset])
        if normalized { return f32(raw) / 255.0 }
        return f32(raw)
    }
    if component_type == 5122 {
        mut raw := i32(bytes.u16_le(data, offset))
        if raw > 32767 { raw = raw - 65536 }
        if normalized { return if raw == -32768 { -1.0 } else { f32(raw) / 32767.0 } }
        return f32(raw)
    }
    if component_type == 5123 {
        mut raw := i32(bytes.u16_le(data, offset))
        if normalized { return f32(raw) / 65535.0 }
        return f32(raw)
    }
    if component_type == 5125 {
        value := bytes.u32_le(data, offset)
        if normalized { return f32(value) / 4294967295.0 }
        return f32(value)
    }
    0.0
}

fn read_index(data: &[]u8, offset: i32, component_type: i32) -> i32 {
    if component_type == 5121 { return i32(data[offset]) }
    if component_type == 5123 { return i32(bytes.u16_le(data, offset)) }
    if component_type == 5125 { return i32(bytes.u32_le(data, offset)) }
    0
}

struct Accessor { base: i32, stride: i32, count: i32, components: i32, component: i32, normalized: bool }

fn accessor(doc: &Document, j: &json.Doc, index: i32, kind: string) -> Option<Accessor> {
    node := j.at(j.field(j.root, "accessors"), index)
    if j.kind(node) != .Object || j.field(node, "sparse") >= 0 || j.get_str(node, "type").unwrap_or_default() != kind { return .None }
    view_id := j.get_i64(node, "bufferView").unwrap_or(-1)
    views := j.field(j.root, "bufferViews")
    if view_id < 0 || view_id >= i64(j.count(views)) { return .None }
    view := j.at(views, i32(view_id))
    if j.get_i64(view, "buffer").unwrap_or(-1) != 0 { return .None }
    count := j.get_i64(node, "count").unwrap_or(0)
    component := i32(j.get_i64(node, "componentType").unwrap_or(0))
    width := component_size(component) * component_count(kind)
    stride := j.get_i64(view, "byteStride").unwrap_or(i64(width))
    start := j.get_i64(view, "byteOffset").unwrap_or(0)
    length := j.get_i64(view, "byteLength").unwrap_or(0)
    offset := j.get_i64(node, "byteOffset").unwrap_or(0)
    if width == 0 || count < 1 || stride < i64(width) || stride > 252 || start < 0 || start > i64(doc.bin.len) ||
        length < i64(width) || length > i64(doc.bin.len) - start || offset < 0 || offset > length - i64(width) ||
        count - 1 > (length - offset - i64(width)) / stride { return .None }
    .Some(Accessor { base: i32(start + offset), stride: i32(stride), count: i32(count), component: component,
        components: component_count(kind), normalized: j.get_bool(node, "normalized").unwrap_or(false) })
}

fn read_accessor_f32(doc: &Document, j: &json.Doc, index: i32, kind: string) -> []f32 {
    data := match accessor(doc, j, index, kind) { .Some(a) => a, .None => { return [] } }
    mut out: []f32 = []
    out.reserve(data.count * data.components)
    for i in 0..data.count {
        offset := data.base + i * data.stride
        for c in 0..data.components {
            out.push(read_component(&doc.bin, offset + c * component_size(data.component), data.component, data.normalized))
        }
    }
    out
}

fn read_accessor_i32(doc: &Document, j: &json.Doc, index: i32) -> []i32 {
    data := match accessor(doc, j, index, "SCALAR") { .Some(a) => a, .None => { return [] } }
    if data.normalized || (data.component != 5121 && data.component != 5123 && data.component != 5125) { return [] }
    mut out: []i32 = []
    out.reserve(data.count)
    for i in 0..data.count { out.push(read_index(&doc.bin, data.base + i * data.stride, data.component)) }
    out
}

// ---- Mesh extraction ----

fn rejected(move message: string) -> Mesh {
    mut mesh := empty_mesh()
    mesh.error = message
    mesh
}

fn primitive_mesh(doc: &Document, j: &json.Doc, primitive: i32) -> Mesh {
    if j.get_i64(primitive, "mode").unwrap_or(4) != 4 { return rejected("expected a TRIANGLES primitive") }
    attrs := j.field(primitive, "attributes")
    pos := i32(j.get_i64(attrs, "POSITION").unwrap_or(-1))
    positions := read_accessor_f32(doc, j, pos, "VEC3")
    if positions.len == 0 { return rejected("missing or invalid POSITION accessor") }
    vertex_count := positions.len / 3
    n := i32(j.get_i64(attrs, "NORMAL").unwrap_or(-1))
    normals := if n >= 0 { read_accessor_f32(doc, j, n, "VEC3") } else { [] }
    if j.field(attrs, "NORMAL") >= 0 && normals.len != positions.len { return rejected("invalid NORMAL accessor") }
    uv := i32(j.get_i64(attrs, "TEXCOORD_0").unwrap_or(-1))
    uvs := if uv >= 0 { read_accessor_f32(doc, j, uv, "VEC2") } else { [] }
    if j.field(attrs, "TEXCOORD_0") >= 0 && uvs.len != vertex_count * 2 { return rejected("invalid TEXCOORD_0 accessor") }
    mut indices: []i32 = []
    if j.field(primitive, "indices") >= 0 {
        indices = read_accessor_i32(doc, j, i32(j.get_i64(primitive, "indices").unwrap_or(-1)))
        if indices.len == 0 { return rejected("invalid index accessor") }
        for i in indices { if i < 0 || i >= vertex_count { return rejected("index outside POSITION accessor") } }
    } else {
        indices.reserve(vertex_count)
        for i in 0..vertex_count { indices.push(i) }
    }
    if indices.len % 3 != 0 { return rejected("triangle index count must be divisible by three") }
    index_count := indices.len
    Mesh {
        ok: true, error: "", positions: positions, normals: normals, uvs: uvs, indices: indices,
        index_count: index_count, vertex_count: vertex_count,
    }
}

pub fn load_mesh(doc: &Document) -> Mesh {
    if !doc.ok { return rejected(doc.error.clone()) }
    j := json.Doc::parse_text(doc.json_text.clone())
    mesh := j.at(j.field(j.root, "meshes"), 0)
    first := j.at(j.field(mesh, "primitives"), 0)
    if first < 0 { return rejected("glTF has no mesh primitive") }
    primitive_mesh(doc, &j, first)
}

// One primitive, placed: its interleaved vertices and its surface. `texture`
// is an index into `Asset.images` or -1 for a surface that is only a colour;
// `metallic_roughness` is the same for the metallic-roughness map, which
// scales `metallic` and `roughness` (G = roughness, B = metallic).
// `emissive` is the emissive map, the colour the surface gives off, and
// `emissive_factor` scales it: rgb is the material's emissiveFactor
// (default [0,0,0], so a map without one is off -- the spec leaves that
// to the exporter), w is KHR_materials_emissive_strength (default 1).
// `occlusion` is the occlusion map (R channel darkens the indirect light)
// and `occlusion_strength` is occlusionTexture.strength (default 1).
pub struct Part {
    name: string, material_name: string, color: [f32; 4], metallic: f32, roughness: f32, vertices: []f32,
    texture: i32, sampler: gfx.Sampler,
    metallic_roughness: i32, metallic_roughness_sampler: gfx.Sampler,
    emissive: i32, emissive_sampler: gfx.Sampler, emissive_factor: [f32; 4],
    occlusion: i32, occlusion_sampler: gfx.Sampler, occlusion_strength: f32,
}

pub struct Asset { parts: []Part, images: []textures.Image }

// An asset with nothing in it: what a caller holds before a model loads.
pub fn empty_asset() -> Asset { Asset { parts: [], images: [] } }

// A factor in [0,1]: base colour, metallic, roughness, emissive rgb.
fn factor(j: &json.Doc, node: i32, fallback: f32) -> Result<f32,string> {
    if node < 0 { return .Ok(fallback) }
    n := match j.as_f64(node) { .Some(v) => v, .None => { return .Err("expected a numeric material factor") } }
    if !(n >= 0.0 && n <= 1.0) { return .Err("material factor outside [0,1]") }
    .Ok(f32(n))
}

// A non-negative scalar: KHR_materials_emissive_strength has no upper bound.
fn strength(j: &json.Doc, node: i32, fallback: f32) -> Result<f32,string> {
    if node < 0 { return .Ok(fallback) }
    n := match j.as_f64(node) { .Some(v) => v, .None => { return .Err("expected a numeric emissive strength") } }
    if !(n >= 0.0) { return .Err("emissive strength is negative") }
    .Ok(f32(n))
}

// A scalar in [0,1]: occlusionTexture.strength and normalTexture.scale,
// both optional with the spec's default 1 (glTF 2.0 3.9.3). Named by
// `what` so a refusal says which of the two it read.
fn unit_scalar(j: &json.Doc, node: i32, what: string, fallback: f32) -> Result<f32,string> {
    if node < 0 { return .Ok(fallback) }
    n := match j.as_f64(node) { .Some(v) => v, .None => { return .Err("expected a numeric " + what) } }
    if !(n >= 0.0 && n <= 1.0) { return .Err(what + " outside [0,1]") }
    .Ok(f32(n))
}

// What a material's `xxxTexture` object names: the image it is and the
// sampler it is taken with. An absent object is no image (-1) and the
// spec's default sampler.
pub struct TextureInfo { image: i32, sampler: gfx.Sampler }

fn texture_info(j: &json.Doc, material: i32, field: string) -> Result<TextureInfo,string> {
    node := j.field(material, field)
    if node < 0 { return .Ok(TextureInfo { image: -1, sampler: gfx.sampler() }) }
    index := j.get_i64(node, "index").unwrap_or(-1)
    textures_list := j.field(j.root, "textures")
    if index < 0 || index >= i64(j.count(textures_list)) { return .Err("invalid " + field + " index") }
    texture := j.at(textures_list, i32(index))
    image := i32(j.get_i64(texture, "source").unwrap_or(-1))
    if image < 0 { return .Err(field + " without source") }
    sampler := match textures.sampler(j, i32(j.get_i64(texture, "sampler").unwrap_or(-1))) { .Ok(s) => s, .Err(e) => return .Err(e) }
    .Ok(TextureInfo { image: image, sampler: sampler })
}

fn part(doc: &Document, j: &json.Doc, primitive: i32, move name: string) -> Result<Part,string> {
    mesh := primitive_mesh(doc, j, primitive)
    if !mesh.ok { return .Err(mesh.error) }
    mut material := -1
    if j.field(primitive, "material") >= 0 {
        materials := j.field(j.root, "materials")
        index := j.get_i64(primitive, "material").unwrap_or(-1)
        if index < 0 || index >= i64(j.count(materials)) { return .Err("invalid material index") }
        material = j.at(materials, i32(index))
    }
    pbr := j.field(material, "pbrMetallicRoughness")
    base := j.field(pbr, "baseColorFactor")
    mut color: [f32; 4] = [1.0; 4]
    if base >= 0 {
        if j.kind(base) != .Array || j.count(base) != 4 { return .Err("baseColorFactor must have four components") }
        for c in 0..4 { color[c] = factor(j, j.at(base, c), 1.0)? }
    }
    metallic := factor(j, j.field(pbr, "metallicFactor"), 1.0)?
    roughness := factor(j, j.field(pbr, "roughnessFactor"), 1.0)?
    // A texture reference (baseColorTexture, metallicRoughnessTexture, ...)
    // is textures[index].source -> images[source]; the sampler is looked up
    // the same way, and a texture without one is the spec's default.
    base_texture := texture_info(j, pbr, "baseColorTexture")?
    mr_texture := texture_info(j, pbr, "metallicRoughnessTexture")?
    // The emissive term lives on the material, not under pbrMetallicRoughness.
    emissive_texture := texture_info(j, material, "emissiveTexture")?
    // Occlusion is the material's too. The strength is an object member of
    // the texture info itself (material.occlusionTexture.strength), not of
    // the material, and no file of the eleven sets it.
    occlusion_texture := texture_info(j, material, "occlusionTexture")?
    occlusion_strength := unit_scalar(j, j.field(j.field(material, "occlusionTexture"), "strength"), "occlusion strength", 1.0)?
    emissive_node := j.field(material, "emissiveFactor")
    mut emissive_factor: [f32; 4] = [0.0, 0.0, 0.0, 1.0]
    if emissive_node >= 0 {
        if j.kind(emissive_node) != .Array || j.count(emissive_node) != 3 { return .Err("emissiveFactor must have three components") }
        for c in 0..3 { emissive_factor[c] = factor(j, j.at(emissive_node, c), 0.0)? }
    }
    // KHR_materials_emissive_strength: material.extensions.<name>.emissiveStrength.
    // Read when present; never required, so a file without it is unchanged.
    strength_node := j.field(j.field(j.field(material, "extensions"), "KHR_materials_emissive_strength"), "emissiveStrength")
    emissive_factor[3] = strength(j, strength_node, 1.0)?
    .Ok(Part { name: name, material_name: j.get_str(material, "name").unwrap_or_default(),
        color: color, metallic: metallic, roughness: roughness, vertices: interleave(&mesh),
        texture: base_texture.image, sampler: base_texture.sampler,
        metallic_roughness: mr_texture.image, metallic_roughness_sampler: mr_texture.sampler,
        emissive: emissive_texture.image, emissive_sampler: emissive_texture.sampler, emissive_factor: emissive_factor,
        occlusion: occlusion_texture.image, occlusion_sampler: occlusion_texture.sampler, occlusion_strength: occlusion_strength })
}

pub fn asset(doc: &Document) -> Result<Asset,string> {
    if !doc.ok { return .Err(doc.error.clone()) }
    j := json.Doc::parse_text(doc.json_text.clone())
    asset_from_json(doc, &j)
}

// glTF 2.0 §4: an extension named in extensionsRequired must be supported
// or the whole asset refused; one only in extensionsUsed may be ignored.
// Storm reads no extension, so the first required name is the answer. An
// unparsable list is not a list of requirements: the meshes decide.
fn unsupported_extensions(j: &json.Doc) -> string {
    required := j.field(j.root, "extensionsRequired")
    if j.kind(required) != .Array { return "" }
    for i in 0..j.count(required) {
        match j.as_str(j.at(required, i)) {
            .Some(name) => { return name },
            .None => {},
        }
    }
    ""
}

// Callers reading application-specific extras can share the parsed document.
pub fn asset_from_json(doc: &Document, j: &json.Doc) -> Result<Asset,string> {
    if !doc.ok { return .Err(doc.error.clone()) }
    required := unsupported_extensions(j)
    if required.len > 0 { return .Err("requires extension " + required + ", which Storm does not read") }
    meshes := j.field(j.root, "meshes")
    if j.kind(meshes) != .Array || j.count(meshes) == 0 { return .Err("glTF has no meshes") }
    mut parts: []Part = []
    placed := nodes.placements(j, j.count(meshes))?
    for instance in placed {
        m := instance.mesh
        mesh := j.at(meshes, m)
        name := j.get_str(mesh, "name").unwrap_or("Mesh " + m.str())
        primitives := j.field(mesh, "primitives")
        if j.kind(primitives) != .Array || j.count(primitives) == 0 { return .Err(name + " has no primitives") }
        for p in 0..j.count(primitives) {
            match part(doc, j, j.at(primitives, p), name.clone()) {
                .Ok(value) => {
                    mut placed_part := move value
                    nodes.bake(&mut placed_part.vertices, &instance.world)
                    parts.push(move placed_part)
                },
                .Err(error) => { return .Err(name + " primitive " + p.str() + ": " + error) },
            }
        }
    }
    images := textures.images(doc, j)?
    .Ok(Asset { parts: parts, images: images })
}

// Expand the mesh through its index buffer into Storm's unindexed
// [x,y,z,nx,ny,nz,u,v] f32 stream, one vertex per index. A glTF index buffer
// is what ties the triangles together; ignoring it draws every triangle from
// consecutive vertices, which turns any indexed model (Khronos's Damaged
// Helmet, the Fox) into a cloud of shards. A primitive without TEXCOORD_0
// (Khronos's Box) gets uv (0, 0), the same choice Filament makes: a missing
// attribute is not an error, the material decides whether it is sampled.
pub fn interleave(mesh: &Mesh) -> []f32 {
    mut out: []f32 = []
    out.reserve(mesh.index_count * 8)
    for k in 0..mesh.index_count {
        i := mesh.indices[k]
        if i < 0 || i >= mesh.vertex_count { continue }
        out.push(mesh.positions[i * 3])
        out.push(mesh.positions[i * 3 + 1])
        out.push(mesh.positions[i * 3 + 2])
        if mesh.normals.len >= (i + 1) * 3 {
            out.push(mesh.normals[i * 3])
            out.push(mesh.normals[i * 3 + 1])
            out.push(mesh.normals[i * 3 + 2])
        } else {
            out.push(0.0)
            out.push(1.0)
            out.push(0.0)
        }
        if mesh.uvs.len >= (i + 1) * 2 {
            out.push(mesh.uvs[i * 2])
            out.push(mesh.uvs[i * 2 + 1])
        } else {
            out.push(0.0)
            out.push(0.0)
        }
    }
    out
}

// Storm's procedural rigs already supply bind-to-world joint matrices for baked mesh positions.
pub struct SkinBinding { part: i32, joints: []string, influences: []core.Influence, indices: []i32 }

pub fn skin_bindings(doc: &Document, j: &json.Doc) -> Result<[]SkinBinding, string> {
    meshes := j.field(j.root, "meshes")
    placed := nodes.placements(j, j.count(meshes))?
    mut bindings: []SkinBinding = []
    mut part_index := 0
    for instance in placed {
        primitives := j.field(j.at(meshes, instance.mesh), "primitives")
        if instance.skin < 0 { part_index += j.count(primitives); continue }
        skin := j.at(j.field(j.root, "skins"), instance.skin)
        list := j.field(skin, "joints")
        if j.count(list) == 0 { return .Err("skin has no joints") }
        mut names: []string = []
        for k in 0..j.count(list) {
            node := j.at(j.field(j.root, "nodes"), i32(j.as_i64(j.at(list, k)).unwrap_or(-1)))
            name := j.get_str(node, "name").unwrap_or_default()
            if name.len == 0 { return .Err("procedural rig needs named joints") }
            names.push(move name)
        }
        for p in 0..j.count(primitives) {
            primitive := j.at(primitives, p)
            attrs := j.field(primitive, "attributes")
            pos := match accessor(doc, j, i32(j.get_i64(attrs, "POSITION").unwrap_or(-1)), "VEC3") {
                .Some(a) => a, .None => { return .Err("missing skin positions") },
            }
            if j.field(attrs, "JOINTS_1") >= 0 { return .Err("procedural rig supports four influences per vertex") }
            ji := i32(j.get_i64(attrs, "JOINTS_0").unwrap_or(-1))
            wi := i32(j.get_i64(attrs, "WEIGHTS_0").unwrap_or(-1))
            ja := match accessor(doc, j, ji, "VEC4") { .Some(a) => a, .None => { return .Err("invalid skin joint accessor") } }
            if ja.normalized || (ja.component != 5121 && ja.component != 5123) || ja.count != pos.count { return .Err("invalid skin joints") }
            weights := read_accessor_f32(doc, j, wi, "VEC4")
            if weights.len != pos.count * 4 { return .Err("invalid skin weights") }
            mut influences: []core.Influence = []
            influences.reserve(pos.count)
            for v in 0..pos.count {
                mut inf := core.Influence { joints: [0; 4], weights: [0.0; 4] }
                mut total: f32 = 0.0
                for c in 0..4 {
                    index := read_index(&doc.bin, ja.base + ja.stride * v + c * component_size(ja.component), ja.component)
                    w := weights[v * 4 + c]
                    if index >= names.len || !(w >= 0.0 && w <= 1.0) { return .Err("invalid joint influence") }
                    inf.joints[c] = index
                    inf.weights[c] = w
                    total += w
                }
                if total <= 0.0 { return .Err("skin vertex has no weight") }
                for c in 0..4 { inf.weights[c] /= total }
                influences.push(move inf)
            }
            mut indices: []i32 = []
            if j.field(primitive, "indices") >= 0 {
                indices = read_accessor_i32(doc, j, i32(j.get_i64(primitive, "indices").unwrap_or(-1)))
            } else { for v in 0..pos.count { indices.push(v) } }
            if indices.len == 0 || indices.len % 3 != 0 { return .Err("invalid skin triangle indices") }
            for v in indices { if v < 0 || v >= pos.count { return .Err("skin index out of bounds") } }
            m := &instance.world.m
            det := core.dot(core.vec3(m[0], m[1], m[2]), core.cross(core.vec3(m[4], m[5], m[6]), core.vec3(m[8], m[9], m[10])))
            if det < 0.0 { for tri in 0..indices.len / 3 { indices.swap(tri * 3 + 1, tri * 3 + 2) } }
            bindings.push(SkinBinding { part: part_index, joints: names.clone(), influences: move influences, indices: move indices })
            part_index += 1
        }
    }
    .Ok(move bindings)
}
