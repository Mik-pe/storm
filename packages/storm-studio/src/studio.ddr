// The material study is an optional workspace hosted by storm-runtime.
import editor
import .gallery
import .game
import assets
import core
import ecs
import gfx
import gltf
import image
import input
import runtime
import runtime.args as args
import scene as scenegraph
import text
import ui
import ui.view as view_ui
import ui.widgets as widgets

// The extent of a model's vertices, in its own units, before any scale.
pub struct Bounds { lo: core.Vec3, hi: core.Vec3 }

pub fn bounds(model: &gltf.Asset) -> Bounds {
    mut lo := core.vec3(0.0, 0.0, 0.0)
    mut hi := lo
    mut first := true
    for part in &model.parts {
        for v in 0..part.vertices.len / gfx.VERTEX_FLOATS {
            i := v * gfx.VERTEX_FLOATS
            p := core.vec3(part.vertices[i], part.vertices[i + 1], part.vertices[i + 2])
            if first || p.x < lo.x { lo.x = p.x }
            if first || p.y < lo.y { lo.y = p.y }
            if first || p.z < lo.z { lo.z = p.z }
            if first || p.x > hi.x { hi.x = p.x }
            if first || p.y > hi.y { hi.y = p.y }
            if first || p.z > hi.z { hi.z = p.z }
            first = false
        }
    }
    Bounds { lo: lo, hi: hi }
}

// The part of the window a loaded model may fill: the 3D view is the whole
// window under the top bar (editor.BAR) and above the status bar
// (editor.FOOT), with the side panels drawn over it, so the picture's
// edges are what clip -- a model keeps a margin inside them.
pub struct View { left: f32, top: f32, right: f32, bottom: f32 }

// The studio's view of a window `width` x `height`.
pub fn view(width: f32, height: f32) -> View {
    View { left: 16.0, top: editor.BAR + 8.0, right: width - 16.0, bottom: height - editor.FOOT - 8.0 }
}

// Where the pixel of a world point lands under `vp` on that window: NDC
// mapped onto the width and height, Vulkan's y-down clip space (rows grow
// downwards, as the capture does).
pub fn pixel(vp: &core.Mat4, p: core.Vec3, width: f32, height: f32) -> core.Vec2 {
    cx := vp.m[0] * p.x + vp.m[4] * p.y + vp.m[8] * p.z + vp.m[12]
    cy := vp.m[1] * p.x + vp.m[5] * p.y + vp.m[9] * p.z + vp.m[13]
    cw := vp.m[3] * p.x + vp.m[7] * p.y + vp.m[11] * p.z + vp.m[15]
    core.vec2(width * 0.5 + (cx / cw) * width * 0.5, height * 0.5 + (cy / cw) * height * 0.5)
}

// Whether the model, placed at `at` with `scale`, keeps all eight corners
// of its bounding box inside `view` under `vp` -- the question fit_scale
// asks of every candidate.
pub fn fits(model: &Bounds, at: core.Vec3, scale: f32, vp: &core.Mat4, view: &View, width: f32, height: f32) -> bool {
    root := core.vec3(at.x - (model.lo.x + model.hi.x) * 0.5 * scale, at.y - model.lo.y * scale, at.z - (model.lo.z + model.hi.z) * 0.5 * scale)
    for c in 0..8 {
        x := if c.bit_and(1) == 0 { model.lo.x } else { model.hi.x }
        y := if c.bit_and(2) == 0 { model.lo.y } else { model.hi.y }
        z := if c.bit_and(4) == 0 { model.lo.z } else { model.hi.z }
        q := pixel(vp, core.vec3(x * scale + root.x, y * scale + root.y, z * scale + root.z), width, height)
        if q.x < view.left || q.x > view.right || q.y < view.top || q.y > view.bottom { return false }
    }
    true
}

// The largest scale at which the model, placed at `at`, is whole in the
// picture: a binary search over the bounding box's corners through the
// camera's own projection. The scale follows from the model and the
// camera, so no model is too small to see or too large to fit, and a
// change of camera moves every model with it. A model with no extent
// (a single point) has the scale 1.0; the search starts at 1/1024 and
// ends at 1024, which is 10 halvings per decade either way.
pub fn fit_scale(model: &Bounds, at: core.Vec3, vp: &core.Mat4, view: &View, width: f32, height: f32) -> f32 {
    span := core.sub(model.hi, model.lo)
    if span.x < 1.0e-9 && span.y < 1.0e-9 && span.z < 1.0e-9 { return 1.0 }
    mut lo: f32 = 0.0
    mut hi: f32 = 1024.0
    // A model that does not fit at 1/1024 is not made smaller: it fits at
    // 0 by definition (a point), so the search runs from 0.
    for _ in 0..40 {
        mid := (lo + hi) * 0.5
        if fits(model, at, mid, vp, view, width, height) { lo = mid } else { hi = mid }
    }
    lo
}

// Place a GLB in the graph at `scale` as a child of `parent` (a dead
// entity makes it a root), centred on `at.x`, resting on `at.y`, and
// centred on `at.z`: the model is the thing on show, so it stands where
// it is put and spreads equally around that point -- under the studio's
// camera the fit above is what keeps it whole, whatever its depth.
// `textures[i]` is the uploaded base colour image of part i, or
// `gfx.no_texture()` for a part that is only a colour.
pub fn load_model(graph: &mut scenegraph.Graph, path: string, parent: ecs.Entity, at: core.Vec3, scale: f32, textures: &[]gfx.Textures) -> Result<ecs.Entity, string> {
    doc := gltf.load(path)
    model := gltf.asset(&doc)?
    place_model(&mut graph, &model, path, parent, at, scale, textures)
}

pub fn place_model(graph: &mut scenegraph.Graph, model: &gltf.Asset, path: string, parent: ecs.Entity, at: core.Vec3, scale: f32, textures: &[]gfx.Textures) -> Result<ecs.Entity, string> {
    b := bounds(model)
    origin := core.vec3(at.x - (b.lo.x + b.hi.x) * 0.5 * scale, at.y - b.lo.y * scale, at.z - (b.lo.z + b.hi.z) * 0.5 * scale)
    .Ok(assets.place_model(&mut graph, model, path, parent, origin, scale, textures))
}

// load_model for the running app: reads, decodes, uploads, and places the
// model as a child of `parent` at the scale `fit_scale` finds for it.
pub fn load_model_into<B: gfx.Backend>(window: &mut B, graph: &mut scenegraph.Graph, path: string, parent: ecs.Entity,
    at: core.Vec3, vp: &core.Mat4, view: &View, width: f32, height: f32) -> Result<ecs.Entity, string> {
    doc := gltf.load(path)
    asset := gltf.asset(&doc)?
    textures := assets.upload_model_textures(&mut window, &asset)?
    scale := fit_scale(&bounds(&asset), at, vp, view, width, height)
    place_model(&mut graph, &asset, path, parent, at, scale, &textures.parts)
}

// A P6 capture as the ground texture, uploaded once; the backend owns the
// pixels from here on. A ground is a colour, so it is sRGB.
fn load_ground<B: gfx.Backend>(window: &mut B, path: string) -> Result<gfx.Texture, string> {
    decoded := image.read_rgba(path)?
    sampler := gfx.sampler()
    window.upload_texture(decoded.pixels, decoded.width, decoded.height, .Srgb, &sampler)
}

pub fn flags() -> []args.Flag {
    mut list := args.flags()
    list.push(args.Flag { name: "--studio", args: "", text: "open the material studio" })
    list.push(args.Flag { name: "--glb", args: "MODEL.glb", text: "load a model on the studio plinth" })
    list.push(args.Flag { name: "--texture", args: "FLOOR.ppm", text: "use a Storm capture as the studio floor texture" })
    list.push(args.Flag { name: "--no-glass", args: "", text: "start the studio without glass" })
    list
}

pub fn launch_mode(argv: &[]string, fallback: runtime.Launch) -> runtime.Launch {
    if args.flag(argv, "--scene") || args.flag(argv, "--play") { return .Game }
    if args.flag(argv, "--studio") || args.flag(argv, "--glb") { return .Workspace }
    fallback
}

struct Workspace {
    graph: scenegraph.Graph, study: gallery.Study, editor: editor.State, baseline: input.Camera, glass_visible: bool, collectibles: ecs.Entity,
}

impl Workspace {
    fn empty() -> Self {
        missing := ecs.Entity { index: -1, generation: 0 }
        Self { graph: scenegraph.Graph::new(),
            study: gallery.Study { hub: missing, floor: missing, ring: missing, left: missing, right: missing, pieces: [missing, missing, missing] },
            editor: editor.new(missing, true, true, false),
            baseline: input.Camera::new(core.vec3(0.0, 0.0, 0.0)), glass_visible: true, collectibles: missing }
    }
}

fn reset_collectibles(workspace: &mut Workspace) {
    game.clear_orbs(&mut workspace.graph)
    if !workspace.graph.is_alive(workspace.collectibles) {
        workspace.collectibles = workspace.graph.create_root(core.vec3(0.0, 0.0, 0.0))
        _ := workspace.graph.set_name(workspace.collectibles, "Collectibles")
    }
    game.spawn_under(&mut workspace.graph, workspace.collectibles)
}

fn setup<B: gfx.Backend>(workspace: &mut Workspace, window: &mut B, argv: &[]string, init: &runtime.WorkspaceInit) -> Result<(), string> {
    workspace.baseline = init.camera.clone()
    workspace.study = gallery.build(&mut workspace.graph)
    reset_collectibles(&mut workspace)
    workspace.graph.propagate()
    texture_path := args.value(argv, "--texture")
    if texture_path.len > 0 {
        ground := load_ground(&mut window, texture_path)?
        floor_material := workspace.graph.material_at(workspace.study.floor).clone()
        _ := workspace.graph.set_material(workspace.study.floor, scenegraph.textured(move floor_material, ground))
    }
    glb := args.value(argv, "--glb")
    mut selected := workspace.study.ring
    if glb.len > 0 {
        vp := init.camera.view_projection(init.width / init.height)
        selected = load_model_into(&mut window, &mut workspace.graph, glb, workspace.study.hub,
            core.vec3(0.0, gallery.PLINTH_TOP, 0.0), &vp, &view(init.width, init.height), init.width, init.height)?
        gallery.clear_pieces(&mut workspace.graph, &workspace.study)
    }
    workspace.graph.propagate()
    workspace.editor = editor.new(selected, !args.flag(argv, "--no-glass"), !args.flag(argv, "--no-shadows"),
        args.flag(argv, "--effects") && !args.flag(argv, "--no-post"))
    editor.collapse(&mut workspace.editor, workspace.collectibles)
    workspace.editor.antialias = !args.flag(argv, "--no-aa")
    .Ok
}

impl runtime.Workspace for Workspace {
    fn available(&self) -> bool { true }

    fn graph(&self) -> &scenegraph.Graph from self { &self.graph }
    fn update(&mut self, frame: &gfx.Frame, dt: f64, previous: input.Camera) -> input.Camera {
        mut camera := previous
        elapsed := if dt > 0.1 { 0.1 } else { dt }
        keys := &frame.input
        over_view := editor.in_viewport(&self.editor, keys.mouse.x, keys.mouse.y, f32(frame.width), f32(frame.height))
        camera.update(keys, f32(elapsed), over_view && keys.button_down(.Right))
        if keys.hit(.R) {
            camera = self.baseline.clone()
            reset_collectibles(&mut self)
        }
        if keys.hit(.F) { self.editor.focus = !self.editor.focus }
        if keys.hit(.T) { self.editor.glass = !self.editor.glass }
        if keys.hit(.G) { self.editor.shadows = !self.editor.shadows }
        if keys.hit(.E) { self.editor.effects = !self.editor.effects }
        if self.glass_visible != self.editor.glass {
            for pane in [self.study.left, self.study.right] {
                if self.editor.glass { _ := self.graph.set_shape(pane, .Cube) } else { _ := self.graph.remove_shape(pane) }
            }
            self.glass_visible = self.editor.glass
        }
        if self.graph.is_alive(self.study.hub) {
            self.graph.set_rotation(self.study.hub, self.graph.local(self.study.hub).rotation_y + f32(elapsed) * 0.10)
        }
        self.graph.propagate()
        _ := game.collect_orbs(&mut self.graph, camera.position)
        camera
    }
    fn shadows(&self) -> bool { self.editor.shadows }
    fn finish(&self) -> gfx.PostProcess {
        gfx.PostProcess { antialias: self.editor.antialias, strength: if self.editor.effects { 1.0 } else { 0.0 } }
    }
    fn wants_play(&mut self) -> bool { replace(&mut self.editor.play_requested, false) }
    fn overlay(&mut self, canvas: &mut ui.Canvas, atlas: &text.Atlas, pointer: &widgets.Pointer, details: &runtime.Overlay) {
        nav := if details.keys.hit(.Tab) {
            if details.keys.down(.Shift) { view_ui.Navigation.Previous } else { view_ui.Navigation.Next }
        } else if details.keys.hit(.Enter) { view_ui.Navigation.Activate }
        else if details.keys.hit(.Left) { view_ui.Navigation.Decrease }
        else if details.keys.hit(.Right) { view_ui.Navigation.Increase }
        else { view_ui.Navigation.None }
        editor.draw(&mut self.editor, &mut canvas, atlas, &mut self.graph, pointer, &editor.Frame {
            w: details.width, h: details.height, wheel: details.wheel, navigation: nav, title: "Material study",
            fps: details.fps, passes: details.passes, device: details.device.clone(), can_play: true,
        })
    }
}

pub fn run<B: gfx.Backend, P: runtime.Project>(open: fn(string, i32, i32) -> Result<B, string>, title: string,
    argv: &[]string, move initial: P, launch: runtime.Launch, shot: string) -> Result<(), string> {
    if launch != .Workspace && args.value(argv, "--texture").len > 0 { return .Err("--texture needs the studio") }
    runtime.drive<B, P, Workspace>(open, title, argv, move initial, Workspace::empty(), setup<B>, launch, shot)
}
