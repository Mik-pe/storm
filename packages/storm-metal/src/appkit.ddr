// The window: an AppKit NSWindow whose one view hosts a CAMetalLayer, built
// through the Objective-C runtime, with event methods that are Dunder
// functions. No SDL, no library Storm has to find: the system's own.
//
// AppKit runs on the main thread and only while asked. Storm never starts
// the run loop: each poll drains the event queue with nextEventMatchingMask
// and hands every event to sendEvent, which is the path real input takes.
// The view's methods then record into one static record that the next poll
// reads, so there is one window per process, as with the Vulkan backend.
//
// AppKit's coordinates have their origin at the bottom left; the pointer
// Storm reports has it at the top left, like the UI.

capability unsafe

import gfx
import std.dl as dl
import std.sys as sys
import .enums as enums
import .objc as objc
import .records as records

// The application, the window, its view and the layer: owned objects, in the
// order they were made.
pub struct Window {
    application: ptr,
    window: ptr,
    view: ptr,
    layer: ptr,
    // The view's size at the last poll, in points, to see a resize.
    width: i32,
    height: i32,
}

// A window that holds nothing yet: what a renderer starts from.
pub unsafe fn empty() -> Window {
    Window { application: ptr(0), window: ptr(0), view: ptr(0), layer: ptr(0), width: 0, height: 0 }
}

// NSEventMaskAny: every event, in every bit of the mask.
pub const ANY_EVENT: u64 = 18446744073709551615

// ---- what the event methods learn ----

// Everything the view's methods record between two polls.
@c_layout
struct Sink {
    held: u32,
    pressed: u32,
    x: f64,
    y: f64,
    dx: f64,
    dy: f64,
    buttons: u32,
    buttons_pressed: u32,
    scroll: f64,
    text_len: i32,
    text: [u8; 256],
}

unsafe fn sink_address() -> ptr { static_bytes("native", 512) }

// A key went down or came up; going down counts as pressed this frame.
unsafe fn key_event(into: &mut Sink, key: gfx.Key, down: bool) {
    bit := u32(1).shl(i32(key))
    if down {
        into.held = into.held.bit_or(bit)
        into.pressed = into.pressed.bit_or(bit)
    } else {
        into.held = into.held.bit_and(bit.bit_xor(4294967295))
    }
}

// The pointer is at (x, y) from the top left, in points, and moved by
// (dx, dy): positive to the right and down, as on every platform.
unsafe fn pointer_event(into: &mut Sink, x: f64, y: f64, dx: f64, dy: f64) {
    into.x = x
    into.y = y
    into.dx = into.dx + dx
    into.dy = into.dy + dy
}

unsafe fn button_event(into: &mut Sink, button: u32, down: bool) {
    if down {
        into.buttons = into.buttons.bit_or(button)
        into.buttons_pressed = into.buttons_pressed.bit_or(button)
    } else {
        into.buttons = into.buttons.bit_and(button.bit_xor(4294967295))
    }
}

unsafe fn scroll_event(into: &mut Sink, delta: f64) { into.scroll = into.scroll + delta }

// The input of the frame that ends here. What was pressed, and how far the
// pointer moved, belongs to that frame and to no later one.
pub unsafe fn take(into: &mut Sink) -> gfx.Input {
    input := gfx.Input {
        held: into.held,
        pressed: into.pressed,
        mouse: gfx.Mouse {
            x: f32(into.x), y: f32(into.y), dx: f32(into.dx), dy: f32(into.dy),
            buttons: into.buttons, pressed: into.buttons_pressed, scroll: f32(into.scroll),
        },
    }
    into.pressed = 0
    into.dx = 0.0
    into.dy = 0.0
    into.buttons_pressed = 0
    into.scroll = 0.0
    input
}

// ---- macOS keys ----

// The engine's keys by macOS virtual key code (kVK_* in Carbon's Events.h).
// A code that is no engine key is -1.
pub fn key_bit(code: u64) -> i32 {
    match code {
        0 => i32(gfx.Key.A),
        1 => i32(gfx.Key.S),
        2 => i32(gfx.Key.D),
        3 => i32(gfx.Key.F),
        5 => i32(gfx.Key.G),
        8 => i32(gfx.Key.C),
        12 => i32(gfx.Key.Q),
        13 => i32(gfx.Key.W),
        14 => i32(gfx.Key.E),
        15 => i32(gfx.Key.R),
        17 => i32(gfx.Key.T),
        36 => i32(gfx.Key.Enter),
        48 => i32(gfx.Key.Tab),
        49 => i32(gfx.Key.Space),
        51 => i32(gfx.Key.Backspace),
        76 => i32(gfx.Key.Enter),
        53 => i32(gfx.Key.Escape),
        123 => i32(gfx.Key.Left),
        124 => i32(gfx.Key.Right),
        125 => i32(gfx.Key.Down),
        126 => i32(gfx.Key.Up),
        _ => -1,
    }
}

// The engine key a modifier's key code means. The modifiers arrive as
// flagsChanged, not keyDown, so they are not in the table above; either
// shift key is Shift and either control key is Ctrl. -1 for any other code.
pub fn modifier_bit(code: u64) -> i32 {
    if code == 56 || code == 60 { return i32(gfx.Key.Shift) }
    if code == 59 || code == 62 { return i32(gfx.Key.Ctrl) }
    -1
}

// The event flag that says whether that modifier is down.
pub fn modifier_flag(key: gfx.Key) -> u64 {
    if key == gfx.Key.Shift { return enums.modifier_flag(.Shift) }
    enums.modifier_flag(.Control)
}

// The mouse button an event type and button number mean: 0 for one Storm
// does not report. Left, right and the middle button (the second "other").
pub fn button_of(kind: u64, number: u64) -> u32 {
    if kind == enums.event_type(.LeftMouseDown) || kind == enums.event_type(.LeftMouseUp) { return gfx.button_bit(gfx.Button.Left) }
    if kind == enums.event_type(.RightMouseDown) || kind == enums.event_type(.RightMouseUp) { return gfx.button_bit(gfx.Button.Right) }
    if number == 2 { return gfx.button_bit(gfx.Button.Middle) }
    0
}

pub fn button_went_down(kind: u64) -> bool {
    kind == enums.event_type(.LeftMouseDown) || kind == enums.event_type(.RightMouseDown) || kind == enums.event_type(.OtherMouseDown)
}

// ---- the event methods: C calls Dunder here, nested inside poll ----

fn view_key_down(view: ptr, method: ptr, event: ptr) {
    unsafe { on_key(ref_at(objc.runtime_address()), event, true) }
}

fn view_key_up(view: ptr, method: ptr, event: ptr) {
    unsafe { on_key(ref_at(objc.runtime_address()), event, false) }
}

fn view_flags(view: ptr, method: ptr, event: ptr) {
    unsafe { on_flags(ref_at(objc.runtime_address()), event) }
}

// The six button messages differ only in their event's type.
fn view_button(view: ptr, method: ptr, event: ptr) {
    unsafe { on_button(ref_at(objc.runtime_address()), view, event) }
}

// Moved and the three drags: the same pointer, with or without a button.
fn view_pointer(view: ptr, method: ptr, event: ptr) {
    unsafe { on_pointer(ref_at(objc.runtime_address()), view, event) }
}

fn view_scroll(view: ptr, method: ptr, event: ptr) {
    unsafe { on_scroll(ref_at(objc.runtime_address()), event) }
}

// A click on a window that is not key is a click, not only an activation.
fn view_accepts_first_mouse(view: ptr, method: ptr, event: ptr) -> u8 { 1 }

pub unsafe fn take_text() -> string {
    read_text(ref_at(sink_address()))
}

fn read_text(sink: &mut Sink) -> string {
    mut bytes: []u8 = []
    for i in 0..sink.text_len { bytes.push(sink.text[i]) }
    sink.text_len = 0
    decoded := sys.decode_u8(&bytes)
    if decoded.ok { decoded.value } else { "" }
}

unsafe fn on_key(rt: &objc.Runtime, event: ptr, down: bool) {
    code := u64(objc.code(rt, event, rt.sel.key_code))
    bit := key_bit(code)
    if bit >= 0 { key_event(ref_at(sink_address()), gfx.Key(bit), down) }
    if !down || code == 36 || code == 48 || code == 51 || code == 53 || code == 76 || code >= 123 { return }
    flags := objc.number(rt, event, rt.sel.modifier_flags)
    shortcuts := enums.modifier_flag(.Control).bit_or(enums.modifier_flag(.Command))
    if flags.bit_and(shortcuts) != 0 { return }
    value := objc.text(rt, objc.send(rt, event, rt.sel.characters))
    append_text(ref_at(sink_address()), value)
}

fn append_text(sink: &mut Sink, value: string) {
    if sink.text_len + value.len > sink.text.len { return }
    for byte in value.bytes() { sink.text[sink.text_len] = byte; sink.text_len += 1 }
}

fn clear_text(sink: &mut Sink) { sink.text_len = 0 }

unsafe fn on_flags(rt: &objc.Runtime, event: ptr) {
    code := u64(objc.code(rt, event, rt.sel.key_code))
    bit := modifier_bit(code)
    if bit < 0 { return }
    key := gfx.Key(bit)
    flags := objc.number(rt, event, rt.sel.modifier_flags)
    key_event(ref_at(sink_address()), key, flags.bit_and(modifier_flag(key)) != 0)
}

// A window point to a point from the view's top-left corner.
unsafe fn pointer_in(rt: &objc.Runtime, view: ptr, event: ptr) -> records.Point {
    where := rt.read_point
    convert: extern fn(ptr, ptr, records.Point, ptr) -> records.Point = ffi_fn(rt.msgSend)
    at := where(event, rt.sel.location_in_window)
    in_view := convert(view, rt.sel.convert_point_from_view, at, ptr(0))
    area := objc.bounds(rt, view, rt.sel.bounds)
    records.Point { x: in_view.x, y: area.size.height - in_view.y }
}

unsafe fn on_button(rt: &objc.Runtime, view: ptr, event: ptr) {
    kind := objc.number(rt, event, rt.sel.event_type)
    button := button_of(kind, objc.number(rt, event, rt.sel.button_number))
    at := pointer_in(rt, view, event)
    pointer_event(ref_at(sink_address()), at.x, at.y, 0.0, 0.0)
    if button != 0 { button_event(ref_at(sink_address()), button, button_went_down(kind)) }
}

unsafe fn on_pointer(rt: &objc.Runtime, view: ptr, event: ptr) {
    at := pointer_in(rt, view, event)
    // AppKit counts y upwards; Storm's deltas are positive downwards.
    dy := objc.decimal(rt, event, rt.sel.delta_y)
    pointer_event(ref_at(sink_address()), at.x, at.y, objc.decimal(rt, event, rt.sel.delta_x), 0.0 - dy)
}

unsafe fn on_scroll(rt: &objc.Runtime, event: ptr) {
    scroll_event(ref_at(sink_address()), objc.decimal(rt, event, rt.sel.scrolling_delta_y))
}

// ---- the window ----

// The view's event methods, one line each: a Dunder function under the
// selector AppKit sends to. Every one of them must be there, or the view
// would silently ignore that event.
unsafe fn add_view_methods(rt: &objc.Runtime, view_class: ptr) -> Result<(), string> {
    require(objc.add_method(rt, view_class, rt.sel.key_down, callback(view_key_down)))?
    require(objc.add_method(rt, view_class, rt.sel.key_up, callback(view_key_up)))?
    require(objc.add_method(rt, view_class, rt.sel.flags_changed, callback(view_flags)))?
    require(objc.add_method(rt, view_class, rt.sel.mouse_down, callback(view_button)))?
    require(objc.add_method(rt, view_class, rt.sel.mouse_up, callback(view_button)))?
    require(objc.add_method(rt, view_class, rt.sel.right_mouse_down, callback(view_button)))?
    require(objc.add_method(rt, view_class, rt.sel.right_mouse_up, callback(view_button)))?
    require(objc.add_method(rt, view_class, rt.sel.other_mouse_down, callback(view_button)))?
    require(objc.add_method(rt, view_class, rt.sel.other_mouse_up, callback(view_button)))?
    require(objc.add_method(rt, view_class, rt.sel.mouse_moved, callback(view_pointer)))?
    require(objc.add_method(rt, view_class, rt.sel.mouse_dragged, callback(view_pointer)))?
    require(objc.add_method(rt, view_class, rt.sel.right_mouse_dragged, callback(view_pointer)))?
    require(objc.add_method(rt, view_class, rt.sel.other_mouse_dragged, callback(view_pointer)))?
    require(objc.add_method(rt, view_class, rt.sel.scroll_wheel, callback(view_scroll)))?
    // "B@:@": a BOOL returned, for acceptsFirstMouse:.
    add: extern fn(ptr, ptr, extern fn(ptr, ptr, ptr) -> u8, ptr) -> u8 = ffi_fn(rt.addMethod)
    first_mouse := add(view_class, rt.sel.accepts_first_mouse, callback(view_accepts_first_mouse), cstr("B@:@")) != 0
    require(first_mouse)
}

unsafe fn require(added: bool) -> Result<(), string> {
    if added { return .Ok }
    .Err("the view's event methods could not be added")
}

// A menu bar with the application menu: without it a regular application
// cannot become active, and an application that is not active gets no keys.
// The application retains the menu once it is set, so the objects made here
// are released on the spot; the item the menu maker returns is autoreleased.
unsafe fn menu_bar(rt: &objc.Runtime, application: ptr) {
    bar := objc.make(rt, rt.cls.ns_menu)
    objc.tell_number(rt, bar, rt.sel.set_autoenables_items, 0)
    application_item := objc.make(rt, rt.cls.ns_menu_item)
    objc.tell_to(rt, bar, rt.sel.add_item, application_item)
    application_menu := objc.make(rt, rt.cls.ns_menu)
    // addItemWithTitle:action:keyEquivalent:, with terminate: as the action.
    add_item: extern fn(ptr, ptr, ptr, ptr, ptr) -> ptr = ffi_fn(rt.msgSend)
    _ := add_item(application_menu, rt.sel.add_item_with_title,
        objc.nsstring(rt, "Quit Storm"), rt.sel.terminate, objc.nsstring(rt, "q"))
    // setSubmenu:forItem:
    set_submenu: extern fn(ptr, ptr, ptr, ptr) = ffi_fn(rt.msgSend)
    set_submenu(bar, rt.sel.set_submenu, application_menu, application_item)
    objc.tell_to(rt, application, rt.sel.set_main_menu, bar)
    for owned in [application_menu, application_item, bar] { rt.release(owned) }
}

// Storm's shaders write sRGB-encoded colour. Apply the sRGB colour space to the
// layer, then release the temporary CGColorSpace reference.
unsafe fn set_srgb_colorspace(rt: &objc.Runtime, layer: ptr) {
    core_graphics := dl.open(cstr("/System/Library/Frameworks/CoreGraphics.framework/CoreGraphics"), 2)
    if core_graphics == ptr(0) { return }
    create := dl.symbol(core_graphics, cstr("CGColorSpaceCreateWithName"))
    name := dl.symbol(core_graphics, cstr("kCGColorSpaceSRGB"))
    release_space := dl.symbol(core_graphics, cstr("CGColorSpaceRelease"))
    if create == ptr(0) || name == ptr(0) || release_space == ptr(0) { return }
    make_space: extern fn(ptr) -> ptr = ffi_fn(create)
    space := make_space(load_ptr(name))
    if space == ptr(0) { return }
    objc.tell_to(rt, layer, rt.sel.set_colorspace, space)
    drop_space: extern fn(ptr) = ffi_fn(release_space)
    drop_space(space)
}

unsafe fn create(rt: &objc.Runtime, title: string, width: i32, height: i32, device: ptr) -> Result<Window, string> {
    // --- the application: a regular one, which can become active ---
    application := objc.send(rt, rt.cls.ns_application, rt.sel.shared_application)
    objc.tell_number(rt, application, rt.sel.set_activation_policy, enums.activation_policy(.Regular))
    menu_bar(rt, application)
    objc.tell(rt, application, rt.sel.finish_launching)

    // --- the view: a class born here, whose event methods are Dunder functions ---
    // It is born once a process: a window opened after another was closed
    // uses the same class, since Objective-C refuses a second of one name.
    mut view_class := objc.class(rt, cstr("StormView"))
    if view_class == ptr(0) {
        view_class = objc.subclass(rt, rt.cls.ns_view, cstr("StormView"))?
        add_view_methods(rt, view_class)?
        objc.register_class(rt, view_class)
    }

    // --- what can fail is behind us; from here on every object is made, none is refused ---
    view := objc.make(rt, view_class)
    objc.tell_number(rt, view, rt.sel.set_autoresizing_mask, enums.autoresizing_mask(.WidthAndHeight))
    objc.tell_number(rt, view, rt.sel.set_wants_layer, 1)
    layer := objc.make(rt, rt.cls.ca_metal_layer)
    objc.tell_to(rt, layer, rt.sel.set_device, device)
    // On a wide-gamut display the layer then shows the colours that were
    // meant, not the same numbers read as the display's own primaries.
    set_srgb_colorspace(rt, layer)
    objc.tell_to(rt, view, rt.sel.set_layer, layer)

    // --- the window ---
    // initWithContentRect:styleMask:backing:defer:
    open_window: extern fn(ptr, ptr, records.Rect, u64, u64, u8) -> ptr = ffi_fn(rt.msgSend)
    content := records.Rect { origin: records.Point { x: 0.0, y: 0.0 }, size: records.size(f64(width), f64(height)) }
    window := open_window(objc.send(rt, rt.cls.ns_window, rt.sel.alloc),
        rt.sel.init_window, content, enums.window_style(.TitledClosableMiniaturizableResizable), enums.backing_store(.Buffered), 0)
    // Ours to release: a closed window must outlive its closing.
    objc.tell_number(rt, window, rt.sel.set_released_when_closed, 0)
    objc.tell_to(rt, window, rt.sel.set_content_view, view)
    objc.tell_to(rt, window, rt.sel.set_title, objc.nsstring(rt, title))
    objc.tell_number(rt, window, rt.sel.set_accepts_mouse_moved, 1)
    objc.tell(rt, window, rt.sel.center)
    objc.tell_to(rt, window, rt.sel.make_key_and_order_front, ptr(0))
    // The view is the first responder, which is where key events go.
    make_first: extern fn(ptr, ptr, ptr) -> u8 = ffi_fn(rt.msgSend)
    _ := make_first(window, rt.sel.make_first_responder, view)
    // Ask to come to the front. `activate` is macOS 14; before it, the older
    // message. The system decides whether to grant it.
    responds: extern fn(ptr, ptr, ptr) -> u8 = ffi_fn(rt.msgSend)
    if responds(application, rt.sel.responds_to_selector, rt.sel.activate) != 0 {
        objc.tell(rt, application, rt.sel.activate)
    } else {
        objc.tell_number(rt, application, rt.sel.activate_ignoring_other_apps, 1)
    }
    objc.tell_decimal(rt, layer, rt.sel.set_contents_scale, objc.decimal(rt, window, rt.sel.backing_scale_factor))
    area := objc.bounds(rt, view, rt.sel.bounds)
    .Ok(Window {
        application: application, window: window, view: view, layer: layer,
        width: i32(area.size.width), height: i32(area.size.height),
    })
}

// A window of the given size in points, showing the GPU's layer.
pub unsafe fn open(rt: &objc.Runtime, title: string, width: i32, height: i32, device: ptr) -> Result<Window, string> {
    if width < 1 || width > 8192 || height < 1 || height > 8192 {
        return .Err("window dimensions must be between 1 and 8192")
    }
    pool := rt.poolPush()
    made := create(rt, title, width, height, device)
    rt.poolPop(pool)
    made
}

// Close the window and release what was made for it, in reverse order.
pub unsafe fn close(rt: &objc.Runtime, window: &mut Window) {
    if window.window != ptr(0) { objc.tell(rt, window.window, rt.sel.close) }
    if window.view != ptr(0) { rt.release(window.view) }
    if window.layer != ptr(0) { rt.release(window.layer) }
    if window.window != ptr(0) { rt.release(window.window) }
    window.view = ptr(0)
    window.layer = ptr(0)
    window.window = ptr(0)
}

// Hand every queued event to the application, so the view's methods run.
unsafe fn drain(rt: &objc.Runtime, application: ptr) {
    // nextEventMatchingMask:untilDate:inMode:dequeue:, with the distant past
    // as the deadline: it returns at once with whatever is queued.
    next := rt.next_event
    for _ in 0..1024 {
        event := next(application, rt.sel.next_event, ANY_EVENT, rt.distant_past, rt.default_run_loop_mode, 1)
        if event == ptr(0) { return }
        objc.tell_to(rt, application, rt.sel.send_event, event)
    }
}

// The window as it is now: drained of its events, with the input they
// produced. A window the user closed is reported closed.
pub unsafe fn poll(rt: &objc.Runtime, window: &mut Window) -> gfx.Frame {
    pool := rt.poolPush()
    clear_text(ref_at(sink_address()))
    drain(rt, window.application)
    area := objc.bounds(rt, window.view, rt.sel.bounds)
    resized := i32(area.size.width) != window.width || i32(area.size.height) != window.height
    window.width = i32(area.size.width)
    window.height = i32(area.size.height)
    visible := objc.flag(rt, window.window, rt.sel.is_visible)
    scale := objc.decimal(rt, window.window, rt.sel.backing_scale_factor)
    input := take(ref_at(sink_address()))
    rt.poolPop(pool)
    gfx.Frame {
        closed: !visible,
        width: window.width,
        height: window.height,
        scale: f32(scale),
        time: f64(sys.now_ms()) / 1000.0,
        resized: resized,
        input: input,
    }
}

// Keep the layer's drawable size in step with the view: its points times the
// backing scale, which is 2 on a Retina display.
pub unsafe fn sync(rt: &objc.Runtime, window: &Window) {
    area := objc.bounds(rt, window.view, rt.sel.bounds)
    scale := objc.decimal(rt, window.window, rt.sel.backing_scale_factor)
    wanted := records.size((area.size.width * scale).round(), (area.size.height * scale).round())
    current := objc.measure(rt, window.layer, rt.sel.drawable_size)
    if current.width != wanted.width || current.height != wanted.height {
        objc.tell_size(rt, window.layer, rt.sel.set_drawable_size, wanted)
    }
}

// ---- the self-test's hands (tools/selftest.ddr) ----
//
// Events made to order and handed to the window, the way the system's would
// be, and sizing and closing without a mouse on the title bar. They exist so
// that the input path can be exercised unattended; the application never
// sends one. They go to the window (sendEvent:), not the application, which
// drops key events for a window that is not key.

// A key event for the view: `kind` is an NSEventType (KeyDown, KeyUp or
// FlagsChanged), `code` a macOS virtual key code, `flags` the modifier flags.
pub unsafe fn synthesize_key(rt: &objc.Runtime, window: &Window, kind: u64, code: u16, flags: u64) {
    // keyEventWithType:location:modifierFlags:timestamp:windowNumber:context:characters:charactersIgnoringModifiers:isARepeat:keyCode:
    // The last two words spill to the stack, where Apple's ABI packs a BOOL
    // and an unsigned short at +0 and +2: exact widths, or the code is read
    // from the wrong bytes (it was, before this was written down).
    make: extern fn(ptr, ptr, u64, records.Point, u64, f64, i64, ptr, ptr, ptr, u8, u16) -> ptr = ffi_fn(rt.msgSend)
    event := make(rt.cls.ns_event, rt.sel.key_event,
        kind, records.Point { x: 0.0, y: 0.0 }, flags, 0.0, i64(objc.number(rt, window.window, rt.sel.window_number)),
        ptr(0), objc.nsstring(rt, "x"), objc.nsstring(rt, "x"), 0, code)
    objc.tell_to(rt, window.window, rt.sel.send_event, event)
}

// A left or right mouse event (`kind`: a mouseDown or mouseUp type) at
// `x`, `y` from the view's top-left corner, in points.
pub unsafe fn synthesize_click(rt: &objc.Runtime, window: &Window, kind: u64, x: f64, y: f64) {
    // mouseEventWithType:location:modifierFlags:timestamp:windowNumber:context:eventNumber:clickCount:pressure:
    make: extern fn(ptr, ptr, u64, records.Point, u64, f64, i64, ptr, i64, i64, f32) -> ptr = ffi_fn(rt.msgSend)
    area := objc.bounds(rt, window.view, rt.sel.bounds)
    event := make(rt.cls.ns_event, rt.sel.mouse_event,
        kind, records.Point { x: x, y: area.size.height - y }, 0, 0.0, i64(objc.number(rt, window.window, rt.sel.window_number)), ptr(0), 1, 1, 1.0)
    objc.tell_to(rt, window.window, rt.sel.send_event, event)
}

// Whether the application is active, and the name of the application that
// is frontmost: what a self-test needs to say why a window is, or is not, key.
pub unsafe fn activation(rt: &objc.Runtime, window: &Window) -> (bool, string) {
    workspace := objc.send(rt, rt.cls.ns_workspace, rt.sel.shared_workspace)
    frontmost := objc.send(rt, workspace, rt.sel.frontmost_application)
    (objc.flag(rt, window.application, rt.sel.is_active), objc.text(rt, objc.send(rt, frontmost, rt.sel.localized_name)))
}

// Whether the window is the key window: the one keyboard events go to.
pub unsafe fn is_key(rt: &objc.Runtime, window: &Window) -> bool { objc.flag(rt, window.window, rt.sel.is_key_window) }

// Size the window's content, in points, as a drag of its corner would.
pub unsafe fn resize(rt: &objc.Runtime, window: &Window, width: i32, height: i32) {
    // setContentSize:
    objc.tell_size(rt, window.window, rt.sel.set_content_size, records.size(f64(width), f64(height)))
}

// Close the window as its close button would.
pub unsafe fn request_close(rt: &objc.Runtime, window: &Window) { objc.tell(rt, window.window, rt.sel.close) }
