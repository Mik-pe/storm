// The text atlas and the quads the editor draws: a one-byte coverage atlas
// uploaded once, a pipeline for quads in points, and a double-buffered pair
// of shared vertex buffers so the CPU records frame N into one slot while the
// GPU finishes frame N - 1 in the other.

capability unsafe

import .device as device
import gfx
import .objc as objc
import .pass as pass

pub const ATLAS_SIZE: i32 = 1024
unsafe fn no_buffer() -> device.Buffer { device.Buffer { handle: ptr(0), contents: ptr(0), capacity: 0 } }

struct Stream {
    buffer: device.Buffer,
    retired: []device.Buffer,
}

unsafe fn empty_stream() -> Stream { Stream { buffer: no_buffer(), retired: [] } }

// Each frame slot owns its buffers until the command buffer completes.
pub struct Atlas {
    texture: ptr,
    sampler: ptr,
    pipeline: device.Pipeline,
    streams: [Stream; 2],
    // Active slot and where the frame's UI vertices end; reset by begin_frame.
    slot: i32,
    cursor: u64,
}

pub unsafe fn empty() -> Atlas {
    Atlas {
        texture: ptr(0), sampler: ptr(0), pipeline: device.no_pipeline(),
        streams: [empty_stream(), empty_stream()], slot: 0, cursor: 0,
    }
}

pub unsafe fn create(rt: &objc.Runtime, gpu: ptr, library: ptr) -> Result<Atlas, string> {
    mut made := empty()
    outcome := fill(rt, gpu, library, &mut made)
    if outcome.is_err() {
        destroy(rt, &mut made)
        return .Err(outcome.unwrap_err())
    }
    .Ok(made)
}

unsafe fn fill(rt: &objc.Runtime, gpu: ptr, library: ptr, made: &mut Atlas) -> Result<(), string> {
    made.texture = device.texture(rt, gpu, .Type2D, .R8Unorm, u64(ATLAS_SIZE), u64(ATLAS_SIZE), 1, .ShaderRead, .Shared)?
    // Glyph quads are drawn close to the size they were rasterized at, so the
    // lookup lands between texels: linear filtering keeps the strokes smooth.
    smooth := device.smooth()
    made.sampler = device.sampler(rt, gpu, &smooth)?
    quads := device.Style { vertices: .Ui, blend: true }
    made.pipeline = device.pipeline(rt, gpu, library, "ui_vertex", "ui_fragment", .BGRA8Unorm, .Depth32Float, &quads)?
    .Ok
}

// Upload the packed glyph coverage: one byte a pixel, `width` x `height`,
// exactly width * height of them.
pub unsafe fn upload(rt: &objc.Runtime, atlas: &Atlas, pixels: &[]u8, width: i32, height: i32) -> Result<(), string> {
    if width < 1 || height < 1 || width > ATLAS_SIZE || height > ATLAS_SIZE || pixels.len != width * height {
        return .Err("the atlas is not " + width.str() + " x " + height.str() + " bytes of coverage")
    }
    device.upload(rt, atlas.texture, u64(width), u64(height), u64(width), addr(&pixels[0]))
    .Ok
}

// Append the frame's quads and draw them. `screen` is the window in points.
pub unsafe fn draw(rt: &objc.Runtime, atlas: &mut Atlas, gpu: ptr, encoder: ptr, depth_state: ptr, vertices: &[]f32, screen: [f32; 2]) -> Result<(), string> {
    if vertices.len == 0 { return .Ok }
    if vertices.len % gfx.UI_FLOATS != 0 { return .Err("UI vertices must be [x, y, u, v, r, g, b, a] tuples") }
    slot := atlas.slot
    bytes := u64(vertices.len) * 4
    needed := atlas.cursor + bytes
    if needed > atlas.streams[slot].buffer.capacity {
        capacity := gfx.stream_capacity(atlas.streams[slot].buffer.capacity, needed)
        fresh := device.vertex_buffer(rt, gpu, capacity, bytes)?
        previous := replace(&mut atlas.streams[slot].buffer, fresh)
        if atlas.cursor > 0 {
            atlas.streams[slot].retired.push(previous)
        } else {
            mut unused := previous
            device.release_buffer(rt, &mut unused)
        }
        atlas.cursor = 0
    }
    offset := atlas.cursor
    if !device.append(&atlas.streams[slot].buffer, &mut atlas.cursor, bytes, addr(&vertices[0])) {
        return .Err("the frame's UI needs more than the UI vertex buffer holds")
    }
    pass.bind(rt, encoder, &atlas.pipeline)
    objc.tell_to(rt, encoder, rt.sel.set_depth_state, depth_state)
    pass.vertex_buffer(rt, encoder, atlas.streams[slot].buffer.handle, offset, 0)
    mut push := [screen[0], screen[1], 0.0, 0.0]
    pass.vertex_bytes(rt, encoder, addr(&push[0]), u64(gfx.UI_PUSH_BYTES), 1)
    pass.fragment_texture(rt, encoder, atlas.texture, 0)
    pass.fragment_sampler(rt, encoder, atlas.sampler, 0)
    pass.triangles(rt, encoder, u64(vertices.len / gfx.UI_FLOATS))
    .Ok
}

unsafe fn release_retired(rt: &objc.Runtime, stream: &mut Stream) {
    for i in 0..stream.retired.len { device.release_buffer(rt, &mut stream.retired[i]) }
    stream.retired.clear()
}

pub unsafe fn begin_frame(rt: &objc.Runtime, atlas: &mut Atlas, slot: i32) {
    release_retired(rt, &mut atlas.streams[slot])
    atlas.slot = slot
    atlas.cursor = 0
}

pub unsafe fn destroy(rt: &objc.Runtime, atlas: &mut Atlas) {
    for owned in [atlas.pipeline.state, atlas.sampler, atlas.texture] {
        if owned != ptr(0) { rt.release(owned) }
    }
    atlas.pipeline = device.no_pipeline()
    atlas.sampler = ptr(0)
    atlas.texture = ptr(0)
    for i in 0..2 {
        release_retired(rt, &mut atlas.streams[i])
        device.release_buffer(rt, &mut atlas.streams[i].buffer)
    }
}
