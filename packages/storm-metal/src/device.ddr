// What the Metal device makes: buffers, textures, samplers, pipelines and
// depth states. Each has a creator that says why it failed and a destroyer
// that releases exactly what the creator made, and nothing else, so an
// owner can always free what it holds by calling the destroyers in reverse.
//
// Every object here is owned (+1): the device's makers are named new... and
// the descriptors are made with alloc. What a maker returns autoreleased is
// not in this module.

capability unsafe

import gfx
import .enums as enums
import .objc as objc
import .records as records

@extern("c", "memcpy")
unsafe fn copy_bytes(destination: ptr, source: ptr, bytes: usize) -> ptr

// ---- buffers ----

// Memory the CPU writes and the GPU reads: one allocation in shared storage
// (the same bytes on both sides of a unified-memory Mac), its address here,
// and how much it holds.
pub struct Buffer {
    handle: ptr,
    contents: ptr,
    capacity: u64,
}

pub unsafe fn buffer(rt: &objc.Runtime, device: ptr, capacity: u64) -> Result<Buffer, string> {
    // newBufferWithLength:options:, in shared storage.
    made := objc.send_pair(rt, device, rt.sel.new_buffer, capacity, enums.buffer_storage(.Shared))
    if made == ptr(0) { return .Err("the device could not make a buffer") }
    address := objc.send(rt, made, rt.sel.contents)
    if address == ptr(0) {
        rt.release(made)
        return .Err("the buffer the device made cannot be written from the CPU")
    }
    .Ok(Buffer { handle: made, contents: address, capacity: capacity })
}

pub unsafe fn release_buffer(rt: &objc.Runtime, buffer: &mut Buffer) {
    if buffer.handle != ptr(0) { rt.release(buffer.handle) }
    buffer.handle = ptr(0)
    buffer.contents = ptr(0)
    buffer.capacity = 0
}

// Write `bytes` from `source` at `cursor` and move the cursor on, so a later
// append can never overwrite an earlier one. False when they do not fit,
// and nothing is written then.
pub unsafe fn append(buffer: &Buffer, cursor: &mut u64, bytes: u64, source: ptr) -> bool {
    if cursor > buffer.capacity || bytes > buffer.capacity - cursor { return false }
    if bytes > 0 { _ := copy_bytes(ptr(usize(buffer.contents) + usize(cursor)), source, usize(bytes)) }
    cursor = cursor + bytes
    true
}

// ---- textures ----

// A texture `width` x `height`, with `mips` mip levels (1 for none).
pub unsafe fn texture(rt: &objc.Runtime, device: ptr, kind: enums.TextureType, format: enums.PixelFormat,
    width: u64, height: u64, mips: u64, usage: enums.TextureUsage, storage: enums.StorageMode) -> Result<ptr, string> {
    descriptor := objc.make(rt, rt.cls.mtl_texture_descriptor)
    objc.tell_number(rt, descriptor, rt.sel.set_texture_type, enums.texture_type(kind))
    objc.tell_number(rt, descriptor, rt.sel.set_pixel_format, enums.pixel_format(format))
    objc.tell_number(rt, descriptor, rt.sel.set_width, width)
    objc.tell_number(rt, descriptor, rt.sel.set_height, height)
    objc.tell_number(rt, descriptor, rt.sel.set_mipmap_level_count, mips)
    objc.tell_number(rt, descriptor, rt.sel.set_usage, enums.texture_usage(usage))
    objc.tell_number(rt, descriptor, rt.sel.set_storage_mode, enums.storage_mode(storage))
    made := objc.send_to(rt, device, rt.sel.new_texture, descriptor)
    rt.release(descriptor)
    if made == ptr(0) { return .Err("the device could not make a " + width.str() + "x" + height.str() + " texture") }
    .Ok(made)
}

// Fill a whole 2D texture from bytes, row after row with no padding between
// rows. The texture must be in shared storage.
pub unsafe fn upload(rt: &objc.Runtime, target: ptr, width: u64, height: u64, bytes_per_row: u64, source: ptr) {
    if target_is("macos") {
        replace := rt.replace_region
        replace(target, rt.sel.replace_region, records.region(0, 0, width, height), 0, source, bytes_per_row)
    }
}

// ---- samplers ----

// The Metal sampler for a gfx.Sampler, the same on every axis.
pub unsafe fn sampler(rt: &objc.Runtime, device: ptr, spec: &gfx.Sampler) -> Result<ptr, string> {
    descriptor := objc.make(rt, rt.cls.mtl_sampler_descriptor)
    objc.tell_number(rt, descriptor, rt.sel.set_min_filter, enums.sampler_filter(spec.min))
    objc.tell_number(rt, descriptor, rt.sel.set_mag_filter, enums.sampler_filter(spec.mag))
    objc.tell_number(rt, descriptor, rt.sel.set_mip_filter, enums.sampler_mip_filter(spec.mips))
    mode := enums.sampler_address_mode(spec.wrap)
    for axis in [rt.sel.set_s_address_mode, rt.sel.set_t_address_mode, rt.sel.set_r_address_mode] {
        objc.tell_number(rt, descriptor, axis, mode)
    }
    made := objc.send_to(rt, device, rt.sel.new_sampler, descriptor)
    rt.release(descriptor)
    if made == ptr(0) { return .Err("the device could not make a sampler") }
    .Ok(made)
}

// A sampler that reads one texel exactly: the shadow map, and the sky's
// environment maps (both are complete images, nothing to blend).
pub fn exact() -> gfx.Sampler {
    gfx.Sampler { mag: .Nearest, min: .Nearest, mips: .None, wrap: .ClampToEdge }
}

// A sampler that blends texels but has no mip chain: the glyph atlas.
pub fn smooth() -> gfx.Sampler {
    gfx.Sampler { mag: .Linear, min: .Linear, mips: .None, wrap: .ClampToEdge }
}

// Trilinear with clamped edges: the sky's environment cube.
pub fn trilinear() -> gfx.Sampler {
    gfx.Sampler { mag: .Linear, min: .Linear, mips: .Linear, wrap: .ClampToEdge }
}

// ---- depth ----

// Whether fragments are dropped by depth and whether they write it.
pub unsafe fn depth_state(rt: &objc.Runtime, device: ptr, compare: enums.CompareFunction, writes: bool) -> Result<ptr, string> {
    descriptor := objc.make(rt, rt.cls.mtl_depth_stencil_descriptor)
    objc.tell_number(rt, descriptor, rt.sel.set_depth_compare, enums.compare_function(compare))
    objc.tell_number(rt, descriptor, rt.sel.set_depth_write, u64(if writes { 1 } else { 0 }))
    made := objc.send_to(rt, device, rt.sel.new_depth_state, descriptor)
    rt.release(descriptor)
    if made == ptr(0) { return .Err("the device could not make a depth state") }
    .Ok(made)
}

// ---- pipelines ----

// Which vertices a pipeline reads: none (a fullscreen triangle), the mesh
// layout [x, y, z, nx, ny, nz], or the UI layout [x, y, u, v, r, g, b, a].
pub enum Vertices { None = 0, Mesh = 1, Ui = 2 }

// What a pipeline does to a fragment, as one value. The descriptor is
// written from it, in `pipeline`, the only place one is filled in.
pub struct Style {
    vertices: Vertices,
    blend: bool, // alpha-over
}

// A pipeline, and what an encoder must be told whenever it is used. Metal
// keeps culling and the front face as encoder state, where Vulkan keeps them
// in the pipeline: carrying the cull mode with the pipeline, and binding
// both in one function (pass.bind), is what keeps them from disagreeing. A
// pipeline that reads the mesh layout culls back faces; one that draws a
// fullscreen triangle or UI quads culls nothing.
pub struct Pipeline {
    state: ptr,
    cull: enums.CullMode,
}

// The absence of a pipeline, for a renderer that holds nothing yet.
pub unsafe fn no_pipeline() -> Pipeline { Pipeline { state: ptr(0), cull: .None } }

// The `index`th attachment of a descriptor's array of them.
pub unsafe fn attachment(rt: &objc.Runtime, array: ptr, index: u64) -> ptr {
    object := rt.send1_u64
    object(array, rt.sel.object_at, index)
}

// Alpha-over blending for glass and the UI.
unsafe fn alpha_over(rt: &objc.Runtime, colour: ptr) {
    objc.tell_number(rt, colour, rt.sel.set_blending_enabled, 1)
    objc.tell_number(rt, colour, rt.sel.set_src_rgb_blend, enums.blend_factor(.SourceAlpha))
    objc.tell_number(rt, colour, rt.sel.set_dst_rgb_blend, enums.blend_factor(.OneMinusSourceAlpha))
    objc.tell_number(rt, colour, rt.sel.set_rgb_blend_op, enums.blend_operation(.Add))
    objc.tell_number(rt, colour, rt.sel.set_src_alpha_blend, enums.blend_factor(.One))
    objc.tell_number(rt, colour, rt.sel.set_dst_alpha_blend, enums.blend_factor(.OneMinusSourceAlpha))
    objc.tell_number(rt, colour, rt.sel.set_alpha_blend_op, enums.blend_operation(.Add))
}

// Describe the vertex layout to the pipeline: attributes interleaved
// in buffer 0.
unsafe fn vertex_layout(rt: &objc.Runtime, descriptor: ptr, vertices: Vertices) {
    layout := objc.make(rt, rt.cls.mtl_vertex_descriptor)
    attributes := objc.send(rt, layout, rt.sel.attributes)
    first := attachment(rt, attributes, 0)
    second := attachment(rt, attributes, 1)
    mut stride := u64(gfx.VERTEX_BYTES)
    if vertices == .Ui {
        // [x, y, u, v] then [r, g, b, a]: two float4, 32 bytes a vertex.
        objc.tell_number(rt, first, rt.sel.set_format, enums.vertex_format(.Float4))
        objc.tell_number(rt, second, rt.sel.set_format, enums.vertex_format(.Float4))
        objc.tell_number(rt, second, rt.sel.set_offset, 16)
        stride = 32
    } else {
        uv := attachment(rt, attributes, 2)
        objc.tell_number(rt, uv, rt.sel.set_format, enums.vertex_format(.Float2))
        objc.tell_number(rt, uv, rt.sel.set_offset, u64(gfx.UV_OFFSET))
        objc.tell_number(rt, uv, rt.sel.set_buffer_index, 0)
        tangent := attachment(rt, attributes, 3)
        objc.tell_number(rt, tangent, rt.sel.set_format, enums.vertex_format(.Float4))
        objc.tell_number(rt, tangent, rt.sel.set_offset, u64(gfx.TANGENT_OFFSET))
        objc.tell_number(rt, tangent, rt.sel.set_buffer_index, 0)
        objc.tell_number(rt, first, rt.sel.set_format, enums.vertex_format(.Float3))
        objc.tell_number(rt, second, rt.sel.set_format, enums.vertex_format(.Float3))
        objc.tell_number(rt, second, rt.sel.set_offset, u64(gfx.NORMAL_OFFSET))
    }
    objc.tell_number(rt, first, rt.sel.set_offset, 0)
    for attribute in [first, second] { objc.tell_number(rt, attribute, rt.sel.set_buffer_index, 0) }
    rows := attachment(rt, objc.send(rt, layout, rt.sel.layouts), 0)
    objc.tell_number(rt, rows, rt.sel.set_stride, stride)
    objc.tell_number(rt, rows, rt.sel.set_step_function, enums.vertex_step_function(.PerVertex))
    objc.tell_to(rt, descriptor, rt.sel.set_vertex_descriptor, layout)
    // The pipeline descriptor keeps its own copy.
    rt.release(layout)
}

// A pipeline for a render pass with a `colour` attachment (or none, which is
// `Invalid`) and a `depth` attachment (or none), running the named vertex
// function and, when `fragment` is not empty, the named fragment function.
pub unsafe fn pipeline(rt: &objc.Runtime, device: ptr, library: ptr, vertex: string, fragment: string,
    colour: enums.PixelFormat, depth: enums.PixelFormat, style: &Style) -> Result<Pipeline, string> {
    descriptor := objc.make(rt, rt.cls.mtl_render_pipeline_descriptor)
    outcome := fill_pipeline(rt, device, library, vertex, fragment, colour, depth, style, descriptor)
    rt.release(descriptor)
    outcome
}

unsafe fn fill_pipeline(rt: &objc.Runtime, device: ptr, library: ptr, vertex: string, fragment: string,
    colour: enums.PixelFormat, depth: enums.PixelFormat, style: &Style, descriptor: ptr) -> Result<Pipeline, string> {
    vertex_function := objc.send_to(rt, library, rt.sel.new_function, objc.nsstring(rt, vertex))
    if vertex_function == ptr(0) { return .Err("the shaders have no function " + vertex) }
    objc.tell_to(rt, descriptor, rt.sel.set_vertex_function, vertex_function)
    rt.release(vertex_function)
    if fragment.len > 0 {
        fragment_function := objc.send_to(rt, library, rt.sel.new_function, objc.nsstring(rt, fragment))
        if fragment_function == ptr(0) { return .Err("the shaders have no function " + fragment) }
        objc.tell_to(rt, descriptor, rt.sel.set_fragment_function, fragment_function)
        rt.release(fragment_function)
    }
    colour_zero := attachment(rt, objc.send(rt, descriptor, rt.sel.color_attachments), 0)
    objc.tell_number(rt, colour_zero, rt.sel.set_pixel_format, enums.pixel_format(colour))
    objc.tell_number(rt, descriptor, rt.sel.set_depth_format, enums.pixel_format(depth))
    if style.blend { alpha_over(rt, colour_zero) }
    if style.vertices != .None { vertex_layout(rt, descriptor, style.vertices) }
    create: extern fn(ptr, ptr, ptr, ptr) -> ptr = ffi_fn(rt.msgSend)
    mut error: ptr = ptr(0)
    made := create(device, rt.sel.new_pipeline, descriptor, addr(&mut error))
    if made == ptr(0) { return .Err("the " + vertex + " pipeline was refused: " + reason(rt, error)) }
    cull := if style.vertices == .Mesh { enums.CullMode.Back } else { enums.CullMode.None }
    .Ok(Pipeline { state: made, cull: cull })
}

// Why Metal said no: the error's own description.
pub unsafe fn reason(rt: &objc.Runtime, error: ptr) -> string {
    if error == ptr(0) { return "no reason was given" }
    objc.text(rt, objc.send(rt, error, rt.sel.localized_description))
}
