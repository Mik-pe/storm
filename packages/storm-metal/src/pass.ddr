// How a render pass is opened and drawn into: a descriptor that names its
// attachments, an encoder for it, what every pass shares once it is open,
// and the draws. A pass that is open is ended by `end`; nothing here tracks
// which pass is open, which is the renderer's business (its Pass value).

capability unsafe

import .device as device
import .enums as enums
import .objc as objc
import .records as records

// A descriptor for a render pass with one colour attachment, or none when
// `colour` is null: a mip `level` and a `slice` (for a cube face) of
// `colour`, cleared to `clear`. And a depth attachment, or none when `depth`
// is null, cleared to the far plane and kept after the pass only when
// `keep_depth` says so (the shadow map is read by the next pass; the main
// depth buffer is read by no one).
pub unsafe fn descriptor(rt: &objc.Runtime, colour: ptr, level: u64, slice: u64, depth: ptr, keep_depth: bool, clear: records.ClearColor) -> ptr {
    pass := objc.send(rt, rt.cls.mtl_render_pass_descriptor, rt.sel.render_pass_descriptor)
    if colour != ptr(0) {
        target := device.attachment(rt, objc.send(rt, pass, rt.sel.color_attachments), 0)
        objc.tell_to(rt, target, rt.sel.set_texture, colour)
        objc.tell_number(rt, target, rt.sel.set_level, level)
        objc.tell_number(rt, target, rt.sel.set_slice, slice)
        objc.tell_number(rt, target, rt.sel.set_load_action, enums.load_action(.Clear))
        objc.tell_number(rt, target, rt.sel.set_store_action, enums.store_action(.Store))
        set_clear := rt.set_clear_color
        set_clear(target, rt.sel.set_clear_color, clear)
    }
    if depth != ptr(0) {
        target := objc.send(rt, pass, rt.sel.depth_attachment)
        objc.tell_to(rt, target, rt.sel.set_texture, depth)
        objc.tell_number(rt, target, rt.sel.set_load_action, enums.load_action(.Clear))
        after := if keep_depth { enums.store_action(.Store) } else { enums.store_action(.DontCare) }
        objc.tell_number(rt, target, rt.sel.set_store_action, after)
    }
    pass
}

// Open the pass on a command buffer and set what every pass shares: the
// mirrored viewport over all `width` x `height` pixels (records.viewport,
// the one place Storm's clip space and Metal's differ), a scissor over the
// same pixels, which are counted from the top left and never mirrored, and
// the depth state (null for a pass with no depth attachment). The encoder,
// or null if the pass could not begin.
pub unsafe fn begin(rt: &objc.Runtime, command_buffer: ptr, descriptor: ptr, width: u64, height: u64, depth_state: ptr) -> ptr {
    encoder := objc.send_to(rt, command_buffer, rt.sel.render_encoder, descriptor)
    if encoder == ptr(0) { return ptr(0) }
    if target_is("macos") {
        set_view := rt.set_viewport
        set_view(encoder, rt.sel.set_viewport, records.viewport(width, height))
        set_clip := rt.set_scissor
        set_clip(encoder, rt.sel.set_scissor_rect, records.scissor(width, height))
    }
    // A pass without a depth attachment is given none: a nil state is refused.
    if depth_state != ptr(0) { objc.tell_to(rt, encoder, rt.sel.set_depth_state, depth_state) }
    encoder
}

pub unsafe fn end(rt: &objc.Runtime, encoder: ptr) { objc.tell(rt, encoder, rt.sel.end_encoding) }

// Bind a pipeline and tell the encoder what goes with it: which faces are
// culled, and that a front face winds counter-clockwise on the screen,
// where y points down (the same front face as on the Vulkan backend).
pub unsafe fn bind(rt: &objc.Runtime, encoder: ptr, pipeline: &device.Pipeline) {
    objc.tell_to(rt, encoder, rt.sel.set_pipeline, pipeline.state)
    objc.tell_number(rt, encoder, rt.sel.set_cull_mode, enums.cull_mode(pipeline.cull))
    objc.tell_number(rt, encoder, rt.sel.set_winding, enums.winding(.CounterClockwise))
}

// The pass's constants: `bytes` copied from `words` when the call is made.
pub unsafe fn vertex_bytes(rt: &objc.Runtime, encoder: ptr, words: ptr, bytes: u64, index: u64) {
    call := rt.set_ptr_u64_u64
    call(encoder, rt.sel.set_vertex_bytes, words, bytes, index)
}

pub unsafe fn fragment_bytes(rt: &objc.Runtime, encoder: ptr, words: ptr, bytes: u64, index: u64) {
    call := rt.set_ptr_u64_u64
    call(encoder, rt.sel.set_fragment_bytes, words, bytes, index)
}

// A buffer for the vertex stage at an index, read from `offset` into it.
pub unsafe fn vertex_buffer(rt: &objc.Runtime, encoder: ptr, buffer: ptr, offset: u64, index: u64) {
    call := rt.set_ptr_u64_u64
    call(encoder, rt.sel.set_vertex_buffer, buffer, offset, index)
}

pub unsafe fn fragment_texture(rt: &objc.Runtime, encoder: ptr, texture: ptr, index: u64) {
    call := rt.set_ptr_u64
    call(encoder, rt.sel.set_fragment_texture, texture, index)
}

pub unsafe fn fragment_sampler(rt: &objc.Runtime, encoder: ptr, sampler: ptr, index: u64) {
    call := rt.set_ptr_u64
    call(encoder, rt.sel.set_fragment_sampler, sampler, index)
}

pub unsafe fn fragment_textures(rt: &objc.Runtime, encoder: ptr, textures: &[ptr; 5], first: u64) {
    if target_is("macos") {
        call := rt.set_ptr_range
        call(encoder, rt.sel.set_fragment_textures, addr(&textures[0]), records.range(first, 5))
    }
}

pub unsafe fn fragment_samplers(rt: &objc.Runtime, encoder: ptr, samplers: &[ptr; 5], first: u64) {
    if target_is("macos") {
        call := rt.set_ptr_range
        call(encoder, rt.sel.set_fragment_samplers, addr(&samplers[0]), records.range(first, 5))
    }
}

// `count` vertices as a list of triangles.
pub unsafe fn triangles(rt: &objc.Runtime, encoder: ptr, count: u64) {
    call := rt.draw_primitives
    call(encoder, rt.sel.draw_primitives, enums.primitive_type(.Triangle), 0, count)
}
