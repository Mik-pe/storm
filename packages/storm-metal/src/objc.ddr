@c_layout
pub struct Runtime {
    getClass: extern fn(ptr) -> ptr,
    registerName: extern fn(ptr) -> ptr,
    msgSend: ptr,
    release: extern fn(ptr),
    autorelease: extern fn(ptr) -> ptr,
    poolPush: extern fn() -> ptr,
    poolPop: extern fn(ptr),
    allocateClassPair: extern fn(ptr, ptr, u64) -> ptr,
    addMethod: ptr,
    registerClassPair: extern fn(ptr),
    foundation: ptr,
    // The Metal framework's handle, for MTLCreateSystemDefaultDevice.
    metal: ptr,
    // Cached process-lifetime Foundation objects used every frame in event polling.
    distant_past: ptr,
    default_run_loop_mode: ptr,
    // Pre-cast objc_msgSend shapes to avoid ffi_fn casts on hot paths.
    send0: extern fn(ptr, ptr) -> ptr,
    send1_ptr: extern fn(ptr, ptr, ptr) -> ptr,
    send1_u64: extern fn(ptr, ptr, u64) -> ptr,
    send2_u64: extern fn(ptr, ptr, u64, u64) -> ptr,
    tell0: extern fn(ptr, ptr),
    tell1_ptr: extern fn(ptr, ptr, ptr),
    tell1_u64: extern fn(ptr, ptr, u64),
    tell1_f64: extern fn(ptr, ptr, f64),
    tell1_size: extern fn(ptr, ptr, records.Size),
    read_u64: extern fn(ptr, ptr) -> u64,
    read_f64: extern fn(ptr, ptr) -> f64,
    read_u8: extern fn(ptr, ptr) -> u8,
    read_u16: extern fn(ptr, ptr) -> u16,
    read_rect: extern fn(ptr, ptr) -> records.Rect,
    read_size: extern fn(ptr, ptr) -> records.Size,
    read_point: extern fn(ptr, ptr) -> records.Point,
    set_ptr_u64_u64: extern fn(ptr, ptr, ptr, u64, u64),
    set_ptr_u64: extern fn(ptr, ptr, ptr, u64),
    set_ptr_range: extern fn(ptr, ptr, ptr, records.Range),
    set_viewport: extern fn(ptr, ptr, records.Viewport),
    set_scissor: extern fn(ptr, ptr, records.ScissorRect),
    set_clear_color: extern fn(ptr, ptr, records.ClearColor),
    draw_primitives: extern fn(ptr, ptr, u64, u64, u64),
    replace_region: extern fn(ptr, ptr, records.Region, u64, ptr, u64),
    get_bytes: extern fn(ptr, ptr, ptr, u64, records.Region, u64),
    next_event: extern fn(ptr, ptr, u64, ptr, ptr, u8) -> ptr,
    cls: Classes,
    sel: Selectors,
}

// The runtime record lives in static storage: the event methods, which C
// calls with nothing but the object, find it here.
pub unsafe fn runtime_address() -> ptr { static_bytes("native", 2048) }

unsafe fn install(into: &mut Runtime, from: &Runtime) {
    into.getClass = from.getClass
    into.registerName = from.registerName
    into.msgSend = from.msgSend
    into.release = from.release
    into.autorelease = from.autorelease
    into.poolPush = from.poolPush
    into.poolPop = from.poolPop
    into.allocateClassPair = from.allocateClassPair
    into.addMethod = from.addMethod
    into.registerClassPair = from.registerClassPair
    into.foundation = from.foundation
    into.metal = from.metal
    into.distant_past = from.distant_past
    into.default_run_loop_mode = from.default_run_loop_mode
    into.send0 = from.send0
    into.send1_ptr = from.send1_ptr
    into.send1_u64 = from.send1_u64
    into.send2_u64 = from.send2_u64
    into.tell0 = from.tell0
    into.tell1_ptr = from.tell1_ptr
    into.tell1_u64 = from.tell1_u64
    into.tell1_f64 = from.tell1_f64
    into.tell1_size = from.tell1_size
    into.read_u64 = from.read_u64
    into.read_f64 = from.read_f64
    into.read_u8 = from.read_u8
    into.read_u16 = from.read_u16
    into.read_rect = from.read_rect
    into.read_size = from.read_size
    into.read_point = from.read_point
    into.set_ptr_u64_u64 = from.set_ptr_u64_u64
    into.set_ptr_u64 = from.set_ptr_u64
    into.set_ptr_range = from.set_ptr_range
    into.set_viewport = from.set_viewport
    into.set_scissor = from.set_scissor
    into.set_clear_color = from.set_clear_color
    into.draw_primitives = from.draw_primitives
    into.replace_region = from.replace_region
    into.get_bytes = from.get_bytes
    into.next_event = from.next_event
    into.cls = from.cls
    into.sel = from.sel
}

unsafe fn symbol(library: ptr, name: ptr) -> Result<ptr, string> {
    address := dl.symbol(library, name)
    if address == ptr(0) { return .Err("libobjc is missing " + from_cstring(name)) }
    .Ok(address)
}

// A class is lookable-up only once its framework is loaded.
unsafe fn framework(path: ptr, name: string) -> Result<ptr, string> {
    handle := dl.open(path, 2)
    if handle == ptr(0) { return .Err("the " + name + " framework could not be loaded") }
    .Ok(handle)
}

unsafe fn init_senders(rt: &mut Runtime) {
    rt.send0 = ffi_fn(rt.msgSend)
    rt.send1_ptr = ffi_fn(rt.msgSend)
    rt.send1_u64 = ffi_fn(rt.msgSend)
    rt.send2_u64 = ffi_fn(rt.msgSend)
    rt.tell0 = ffi_fn(rt.msgSend)
    rt.tell1_ptr = ffi_fn(rt.msgSend)
    rt.tell1_u64 = ffi_fn(rt.msgSend)
    rt.tell1_f64 = ffi_fn(rt.msgSend)
    rt.tell1_size = ffi_fn(rt.msgSend)
    rt.read_u64 = ffi_fn(rt.msgSend)
    rt.read_f64 = ffi_fn(rt.msgSend)
    rt.read_u8 = ffi_fn(rt.msgSend)
    rt.read_u16 = ffi_fn(rt.msgSend)
    rt.read_rect = ffi_fn(rt.msgSend)
    rt.read_size = ffi_fn(rt.msgSend)
    rt.read_point = ffi_fn(rt.msgSend)
    rt.set_ptr_u64_u64 = ffi_fn(rt.msgSend)
    rt.set_ptr_u64 = ffi_fn(rt.msgSend)
    rt.set_ptr_range = ffi_fn(rt.msgSend)
    rt.set_viewport = ffi_fn(rt.msgSend)
    rt.set_scissor = ffi_fn(rt.msgSend)
    rt.set_clear_color = ffi_fn(rt.msgSend)
    rt.draw_primitives = ffi_fn(rt.msgSend)
    rt.replace_region = ffi_fn(rt.msgSend)
    rt.get_bytes = ffi_fn(rt.msgSend)
    rt.next_event = ffi_fn(rt.msgSend)
}

