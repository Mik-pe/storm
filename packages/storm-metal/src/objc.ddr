unsafe fn nsstring_retained(rt: &Runtime, value: string) -> ptr {
    init_bytes: extern fn(ptr, ptr, ptr, u64, u64) -> ptr = ffi_fn(rt.msgSend)
    view := value.as_bytes()
    first := if value.len == 0 { ptr(0) } else { addr(&view[0]) }
    init_bytes(send(rt, rt.cls.ns_string, rt.sel.alloc), rt.sel.init_with_bytes, first, u64(value.len), 4)
}

// A preview needs Foundation and Metal. Cache the process-lifetime handles
// so opening another renderer does not acquire another library reference.
pub unsafe fn load_metal() -> Result<Runtime, string> {
    mut rt: Runtime = zeroed()
    install(&mut rt, ref_at(runtime_address()))
    if rt.metal != ptr(0) { return .Ok(rt) }
    objc := dl.open(cstr("/usr/lib/libobjc.A.dylib"), 2)
    if objc == ptr(0) { return .Err("the Objective-C runtime could not be loaded") }
    rt.getClass = ffi_fn(symbol(objc, cstr("objc_getClass"))?)
    rt.registerName = ffi_fn(symbol(objc, cstr("sel_registerName"))?)
    rt.msgSend = symbol(objc, cstr("objc_msgSend"))?
    rt.release = ffi_fn(symbol(objc, cstr("objc_release"))?)
    rt.autorelease = ffi_fn(symbol(objc, cstr("objc_autorelease"))?)
    rt.poolPush = ffi_fn(symbol(objc, cstr("objc_autoreleasePoolPush"))?)
    rt.poolPop = ffi_fn(symbol(objc, cstr("objc_autoreleasePoolPop"))?)
    rt.allocateClassPair = ffi_fn(symbol(objc, cstr("objc_allocateClassPair"))?)
    rt.addMethod = symbol(objc, cstr("class_addMethod"))?
    rt.registerClassPair = ffi_fn(symbol(objc, cstr("objc_registerClassPair"))?)
    init_senders(&mut rt)
    register_selectors(&mut rt)
    rt.foundation = framework(cstr("/System/Library/Frameworks/Foundation.framework/Foundation"), "Foundation")?
    rt.metal = framework(cstr("/System/Library/Frameworks/Metal.framework/Metal"), "Metal")?
    cls := rt.getClass
    rt.cls.ns_string = cls(cstr("NSString"))
    rt.cls.ns_date = cls(cstr("NSDate"))
    rt.cls.mtl_render_pass_descriptor = cls(cstr("MTLRenderPassDescriptor"))
    rt.cls.mtl_texture_descriptor = cls(cstr("MTLTextureDescriptor"))
    rt.cls.mtl_sampler_descriptor = cls(cstr("MTLSamplerDescriptor"))
    rt.cls.mtl_depth_stencil_descriptor = cls(cstr("MTLDepthStencilDescriptor"))
    rt.cls.mtl_render_pipeline_descriptor = cls(cstr("MTLRenderPipelineDescriptor"))
    rt.cls.mtl_vertex_descriptor = cls(cstr("MTLVertexDescriptor"))
    rt.cls.mtl_compile_options = cls(cstr("MTLCompileOptions"))
    pool := rt.poolPush()
    rt.distant_past = send(&rt, send(&rt, rt.cls.ns_date, rt.sel.distant_past), rt.sel.retain)
    mode_sym := dl.symbol(rt.foundation, cstr("NSDefaultRunLoopMode"))
    if mode_sym != ptr(0) && load_ptr(mode_sym) != ptr(0) {
        rt.default_run_loop_mode = send(&rt, load_ptr(mode_sym), rt.sel.retain)
    } else {
        rt.default_run_loop_mode = nsstring_retained(&rt, "kCFRunLoopDefaultMode")
    }
    rt.poolPop(pool)
    install(ref_at(runtime_address()), &rt)
    .Ok(rt)
}

// Window and layer classes are only needed by a visible application.
pub unsafe fn load() -> Result<Runtime, string> {
    mut rt := load_metal()?
    if rt.cls.ns_application != ptr(0) { return .Ok(rt) }
    if rt.getClass(cstr("CAMetalLayer")) == ptr(0) {
        _ := framework(cstr("/System/Library/Frameworks/QuartzCore.framework/QuartzCore"), "QuartzCore")?
    }
    if rt.getClass(cstr("NSApplication")) == ptr(0) {
        _ := framework(cstr("/System/Library/Frameworks/AppKit.framework/AppKit"), "AppKit")?
    }
    cls := rt.getClass
    rt.cls.ca_metal_layer = cls(cstr("CAMetalLayer"))
    rt.cls.ns_application = cls(cstr("NSApplication"))
    rt.cls.ns_menu = cls(cstr("NSMenu"))
    rt.cls.ns_menu_item = cls(cstr("NSMenuItem"))
    rt.cls.ns_view = cls(cstr("NSView"))
    rt.cls.ns_window = cls(cstr("NSWindow"))
    rt.cls.ns_event = cls(cstr("NSEvent"))
    rt.cls.ns_workspace = cls(cstr("NSWorkspace"))
    install(ref_at(runtime_address()), &rt)
    .Ok(rt)
}

// ---- messages, by shape ----
//
// `send` returns an object, `tell` returns nothing, and the readers are named
// for what they read. A method that returns nothing must be sent as `tell`:
// its return register holds whatever the callee last left there.

pub unsafe fn send(rt: &Runtime, to: ptr, sel: ptr) -> ptr {
    call := rt.send0
    call(to, sel)
}

pub unsafe fn send_to(rt: &Runtime, to: ptr, sel: ptr, argument: ptr) -> ptr {
    call := rt.send1_ptr
    call(to, sel, argument)
}

pub unsafe fn send_pair(rt: &Runtime, to: ptr, sel: ptr, first: u64, second: u64) -> ptr {
    call := rt.send2_u64
    call(to, sel, first, second)
}

pub unsafe fn tell(rt: &Runtime, to: ptr, sel: ptr) {
    call := rt.tell0
    call(to, sel)
}

pub unsafe fn tell_to(rt: &Runtime, to: ptr, sel: ptr, argument: ptr) {
    call := rt.tell1_ptr
    call(to, sel, argument)
}

pub unsafe fn tell_number(rt: &Runtime, to: ptr, sel: ptr, value: u64) {
    call := rt.tell1_u64
    call(to, sel, value)
}

pub unsafe fn tell_decimal(rt: &Runtime, to: ptr, sel: ptr, value: f64) {
    call := rt.tell1_f64
    call(to, sel, value)
}

pub unsafe fn tell_size(rt: &Runtime, to: ptr, sel: ptr, value: records.Size) {
    call := rt.tell1_size
    call(to, sel, value)
}

pub unsafe fn number(rt: &Runtime, from: ptr, sel: ptr) -> u64 {
    call := rt.read_u64
    call(from, sel)
}

pub unsafe fn decimal(rt: &Runtime, from: ptr, sel: ptr) -> f64 {
    call := rt.read_f64
    call(from, sel)
}

// A BOOL, which is one byte in the low byte of the result register.
pub unsafe fn flag(rt: &Runtime, from: ptr, sel: ptr) -> bool {
    call := rt.read_u8
    call(from, sel) != 0
}

// An unsigned short: NSEvent's keyCode.
pub unsafe fn code(rt: &Runtime, from: ptr, sel: ptr) -> u16 {
    call := rt.read_u16
    call(from, sel)
}

pub unsafe fn bounds(rt: &Runtime, from: ptr, sel: ptr) -> records.Rect {
    call := rt.read_rect
    call(from, sel)
}

pub unsafe fn measure(rt: &Runtime, from: ptr, sel: ptr) -> records.Size {
    call := rt.read_size
    call(from, sel)
}

// ---- objects ----

// An owned instance: alloc, then init. Release it once, when it is done with.
pub unsafe fn make(rt: &Runtime, cls: ptr) -> ptr {
    send(rt, send(rt, cls, rt.sel.alloc), rt.sel.init)
}

pub unsafe fn class(rt: &Runtime, name: ptr) -> ptr { rt.getClass(name) }

// A class born at run time, `base` under a new name.
pub unsafe fn subclass(rt: &Runtime, base: ptr, name: ptr) -> Result<ptr, string> {
    created := rt.allocateClassPair(base, name, 0)
    if created == ptr(0) { return .Err("the class could not be created") }
    .Ok(created)
}

// Give a class a method whose body is a Dunder function with the shape every
// event method has: the object, the selector, one object argument, nothing
// returned. True when the method was added.
pub unsafe fn add_method(rt: &Runtime, owner: ptr, sel: ptr, implementation: extern fn(ptr, ptr, ptr)) -> bool {
    add: extern fn(ptr, ptr, extern fn(ptr, ptr, ptr), ptr) -> u8 = ffi_fn(rt.addMethod)
    // "v@:@": nothing returned, an object, a selector, an object.
    add(owner, sel, implementation, cstr("v@:@")) != 0
}

pub unsafe fn register_class(rt: &Runtime, owner: ptr) { rt.registerClassPair(owner) }

// ---- strings ----

@extern("c", "strlen")
unsafe fn strlen(text: ptr) -> usize

// A Dunder string over a C string's bytes; the bytes are read, not kept.
pub unsafe fn from_cstring(raw: ptr) -> string {
    if raw == ptr(0) { return "" }
    mut out: []u8 = []
    n := i32(strlen(raw))
    out.reserve(n)
    for i in 0..n { out.push(load_u8(ptr(usize(raw) + usize(i)))) }
    match b.decode(&out) {
        .Ok(value) => value,
        .Err(_) => "",
    }
}

// An NSString over a Dunder string's UTF-8, autoreleased: it lives until the
// surrounding pool is popped. The bytes are read during the call only. (Not
// `string`: a function of that name would shadow the type in this module.)
pub unsafe fn nsstring(rt: &Runtime, value: string) -> ptr {
    made := nsstring_retained(rt, value)
    _ := rt.autorelease(made)
    made
}

// The Dunder string an NSString holds.
pub unsafe fn text(rt: &Runtime, value: ptr) -> string {
    if value == ptr(0) { return "" }
    from_cstring(send(rt, value, rt.sel.utf8_string))
}
