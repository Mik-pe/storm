// Normalize the drawable's channel order at the graphics boundary.
import gfx
import gfx.readback

pub fn pixels(bgra: &[]u8, width: i32, height: i32) -> Result<gfx.Readback, string> {
    if width < 1 || height < 1 || bgra.len % 4 != 0 ||
        i64(width) * i64(height) != i64(bgra.len / 4) {
        return .Err("the captured frame has an invalid pixel extent")
    }
    mut rgba: []u8 = []
    rgba.reserve(bgra.len)
    for p in 0..bgra.len / 4 {
        i := p * 4
        rgba.push(bgra[i + 2])
        rgba.push(bgra[i + 1])
        rgba.push(bgra[i])
        rgba.push(bgra[i + 3])
    }
    .Ok(gfx.Readback { width: width, height: height, rgba: move rgba })
}

pub fn ppm(bgra: &[]u8, width: i32, height: i32) -> []u8 {
    match pixels(bgra, width, height) {
        .Ok(image) => readback.ppm(&image),
        .Err(_) => [],
    }
}
