// Scene authoring UI. A frame describes the views, receives a typed action
// from the GUI, then applies it to the editor and scene.
import core
import ecs
import scene
import text
import ui
import ui.layout as layout
import ui.view as view
import ui.widgets as widgets

pub const BAR: f32 = 54.0
pub const FOOT: f32 = 32.0
const LEFT: f32 = 226.0
const RIGHT: f32 = 290.0
const WIDE: f32 = 940.0
const ROW: f32 = 27.0

enum Panel { Closed, Scene, Inspector }
enum Setting { Glass, Shadows, Effects, Antialias }
enum Action {
    Select(ecs.Entity), Fold(ecs.Entity), AddCube, Delete(ecs.Entity), Visibility(ecs.Entity),
    Surface(ecs.Entity, scene.MaterialField), Transform(ecs.Entity, scene.TransformField),
    Setting(Setting), Panel(Panel), Focus, Play,
}

pub struct State {
    controls: view.State,
    selected: ecs.Entity,
    focus: bool,
    play_requested: bool,
    compact_panel: Panel,
    first_node: i32,
    folded: []ecs.Entity,
    reveal: Option<ecs.Entity>,
    inspector_scroll: f32,
    inspector_extent: f32,
    glass: bool,
    shadows: bool,
    effects: bool,
    antialias: bool,
}

pub fn new(selected: ecs.Entity, glass: bool, shadows: bool, effects: bool) -> State {
    State { controls: view.State::new(), selected: selected, focus: false, play_requested: false, compact_panel: .Closed,
        first_node: 0, folded: [], reveal: .None, inspector_scroll: 0.0, inspector_extent: 0.0, glass: glass, shadows: shadows, effects: effects, antialias: true }
}

pub struct Frame {
    w: f32, h: f32, wheel: f32, navigation: view.Navigation,
    title: string, fps: f32, passes: i32, device: string, can_play: bool,
}

struct Dock { toolbar: layout.Rect, footer: layout.Rect, tree: layout.Rect, inspector: layout.Rect, viewport: layout.Rect, compact: bool }

fn min(a: f32, b: f32) -> f32 { if a < b { a } else { b } }
fn clamp(value: f32, max: f32) -> f32 { if value < 0.0 || max < 0.0 { 0.0 } else { min(value, max) } }

fn dock(focus: bool, panel: Panel, width: f32, height: f32) -> Dock {
    compact := width < WIDE
    top := min(height, BAR)
    footer := min(height - top, FOOT)
    body := height - top - footer
    left := if !focus && (!compact || panel == .Scene) { min(LEFT, width * 0.75) } else { 0.0 }
    right := if !focus && (!compact || panel == .Inspector) { min(RIGHT, width * 0.83) } else { 0.0 }
    Dock { toolbar: layout.rect(0.0, 0.0, width, top), footer: layout.rect(0.0, height - footer, width, footer),
        tree: layout.rect(0.0, top, left, body), inspector: layout.rect(width - right, top, right, body),
        viewport: layout.rect(left, top, width - left - right, body), compact: compact }
}

pub fn in_viewport(state: &State, x: f32, y: f32, width: f32, height: f32) -> bool {
    dock(state.focus, state.compact_panel, width, height).viewport.contains(x, y)
}

pub fn initial_viewport(width: f32, height: f32) -> layout.Rect {
    dock(false, .Closed, width, height).viewport
}

fn entity_id(entity: ecs.Entity) -> i64 { i64(entity.generation) * 4294967296 + i64(entity.index) }

fn same_entity(a: ecs.Entity, b: ecs.Entity) -> bool { a.index == b.index && a.generation == b.generation }

fn fold_index(state: &State, node: ecs.Entity) -> i32 {
    for i in 0..state.folded.len {
        if same_entity(state.folded[i], node) { return i }
    }
    -1
}

pub fn collapse(state: &mut State, node: ecs.Entity) {
    if fold_index(state, node) < 0 { state.folded.push(node) }
}

struct Row { node: ecs.Entity, depth: i32, branch: bool, folded: bool }

fn tree_rows(state: &State, graph: &scene.Graph) -> []Row {
    hierarchy := graph.hierarchy()
    mut rows: []Row = []
    mut hidden_depth := -1
    for i in 0..hierarchy.len {
        row := &hierarchy[i]
        if hidden_depth >= 0 && row.depth > hidden_depth { continue }
        branch := i + 1 < hierarchy.len && hierarchy[i + 1].depth > row.depth
        folded := branch && fold_index(state, row.entity) >= 0
        hidden_depth = if folded { row.depth } else { -1 }
        rows.push(Row { node: row.entity, depth: row.depth, branch: branch, folded: folded })
    }
    rows
}

fn reveal_end(rows: &[]Row, node: ecs.Entity, visible: i32, first: i32) -> i32 {
    for start in 0..rows.len {
        if !same_entity(rows[start].node, node) { continue }
        mut end := start + 1
        while end < rows.len && rows[end].depth > rows[start].depth { end += 1 }
        if end > first + visible { return end - visible }
        return first
    }
    first
}

fn name(graph: &scene.Graph, entity: ecs.Entity) -> string {
    label := graph.name(entity)
    if label.len > 0 { label } else { "Object " + entity.index.str() }
}

fn header(out: &mut view.View<Action>, panel: &layout.Rect, title: string, style: &view.Style) {
    out.fill(panel.clone(), style.panel.clone())
    out.fill(layout.rect(panel.x, panel.y, panel.w, 39.0), style.fill.clone())
    out.label(layout.rect(panel.x + 13.0, panel.y, panel.w - 26.0, 39.0), title, .Heading, .Start)
    out.fill(layout.rect(panel.x, panel.y + 38.0, panel.w, 1.0), style.border.clone())
}

fn toolbar(out: &mut view.View<Action>, state: &State, boxes: &Dock, frame: &Frame, style: &view.Style) {
    r := &boxes.toolbar
    out.fill(r.clone(), style.chrome.clone())
    out.fill(layout.rect(r.x, r.y + r.h - 1.0, r.w, 1.0), style.border.clone())
    play_in_bar := frame.can_play && r.w >= 400.0
    play_width: f32 = if play_in_bar { 72.0 } else { 0.0 }
    focus_label := if state.focus { "Edit" } else { "Focus" }
    focus_x := r.w - 86.0 - play_width
    focus := layout.rect(focus_x, 11.0, 70.0, 32.0)
    if focus.visible_in(r) { out.button(focus, view.key(1, 1), focus_label, .Outline, .Focus) }
    if play_in_bar {
        play := layout.rect(r.w - 80.0, 11.0, 68.0, 32.0)
        if play.visible_in(r) { out.button(play, view.key(1, 2), "Play", .Primary, .Play) }
    }
    if boxes.compact && !state.focus {
        mut tabs := layout.Stack::new(layout.rect(41.0, 11.0, focus_x - 48.0, 32.0), .Row, 5.0)
        left := tabs.next(65.0)
        right := tabs.next(81.0)
        stop := layout.rect(0.0, 0.0, focus_x - 4.0, r.h)
        if left.visible_in(&stop) { out.button(left, view.key(1, 3), "Scene", if state.compact_panel == .Scene { .Selected } else { .Outline }, .Panel(.Scene)) }
        if right.visible_in(&stop) { out.button(right, view.key(1, 4), "Inspector", if state.compact_panel == .Inspector { .Selected } else { .Outline }, .Panel(.Inspector)) }
    } else {
        out.label(layout.rect(45.0, 0.0, 78.0, r.h), "STORM", .Heading, .Start)
        if focus_x > 190.0 {
            out.fill(layout.rect(130.0, 13.0, 1.0, 28.0), style.border.clone())
            out.label(layout.rect(150.0, 0.0, focus_x - 160.0, r.h), "Studio  /  " + frame.title, .Normal, .Start)
        }
    }
}

fn tree(out: &mut view.View<Action>, state: &mut State, graph: &scene.Graph, panel: &layout.Rect, pointer: &widgets.Pointer,
    wheel: f32, style: &view.Style) {
    if panel.h < 40.0 { return }
    header(&mut out, panel, "Scene", style)
    out.fill(layout.rect(panel.x + panel.w - 1.0, panel.y, 1.0, panel.h), style.border.clone())
    out.label(layout.rect(panel.x + 90.0, panel.y, panel.w - 103.0, 39.0), graph.len().str() + " objects", .Quiet, .End)
    list := layout.rect(panel.x + 8.0, panel.y + 48.0, panel.w - 16.0, panel.h - 99.0)
    rows := tree_rows(state, graph)
    visible := i32(list.h / ROW)
    if list.contains(pointer.x, pointer.y) && wheel != 0.0 {
        state.first_node += if wheel > 0.0 { -1 } else { 1 }
    }
    match replace(&mut state.reveal, .None) {
        .Some(node) => { state.first_node = reveal_end(&rows, node, visible, state.first_node) },
        .None => {},
    }
    state.first_node = i32(clamp(f32(state.first_node), f32(rows.len - visible)))
    mut items := layout.Stack::new(list.clone(), .Column, 0.0)
    for i in state.first_node..rows.len {
        bounds := items.next(ROW)
        if !bounds.visible_in(&list) { break }
        row := &rows[i]
        id := row.node
        selected := state.selected.index == id.index && state.selected.generation == id.generation
        inset := min(45.0, f32(row.depth) * 13.0)
        out.button(bounds, view.key(2, entity_id(id)), "", if selected { .Selected } else { .Row }, .Select(id))
        indent := bounds.x + 5.0 + inset
        if row.branch {
            out.button(layout.rect(indent, bounds.y + 2.0, 20.0, bounds.h - 4.0), view.key(6, entity_id(id)),
                if row.folded { ">" } else { "v" }, .Row, .Fold(id))
        } else if graph.shape(id).is_some() {
            out.label(layout.rect(indent + 3.0, bounds.y, 15.0, bounds.h), "◇", .Quiet, .Center)
        }
        out.label(layout.rect(indent + 24.0, bounds.y, bounds.w - 36.0 - inset, bounds.h),
            name(graph, id), if selected { .Normal } else { .Quiet }, .Start)
    }
    footer := layout.rect(panel.x + 9.0, panel.y + panel.h - 40.0, panel.w - 18.0, 30.0)
    mut buttons := layout.Stack::new(footer.clone(), .Row, 6.0)
    w := (footer.w - 6.0) * 0.5
    add := buttons.next(w)
    delete := buttons.next(w)
    if add.visible_in(panel) { out.button(add, view.key(3, 0), "Add cube", .Outline, .AddCube) }
    if graph.is_alive(state.selected) && delete.visible_in(panel) {
        out.button(delete, view.key(3, entity_id(state.selected) + 1), "Delete", .Outline, .Delete(state.selected))
    }
}

fn section(out: &mut view.View<Action>, bounds: &layout.Rect, visible: &layout.Rect, title: string, style: &view.Style) {
    if !bounds.visible_in(visible) { return }
    out.fill(bounds.clone(), style.fill.clone())
    out.label(bounds.inset(8.0, 0.0), title, .Normal, .Start)
}

fn slider(out: &mut view.View<Action>, bounds: layout.Rect, visible: &layout.Rect, key: view.Key,
    label: string, value: f32, lo: f32, hi: f32, move action: Action) {
    if bounds.visible_in(visible) {
        out.slider(bounds, key, label, view.Slider { value: value, lo: lo, hi: hi }, move action)
    }
}

fn inspector(out: &mut view.View<Action>, state: &mut State, graph: &scene.Graph, panel: &layout.Rect,
    pointer: &widgets.Pointer, wheel: f32, style: &view.Style) {
    if panel.h < 40.0 { return }
    header(&mut out, panel, "Inspector", style)
    out.fill(layout.rect(panel.x, panel.y, 1.0, panel.h), style.border.clone())
    visible := layout.rect(panel.x + 10.0, panel.y + 48.0, panel.w - 20.0, panel.h - 58.0)
    if visible.contains(pointer.x, pointer.y) && wheel != 0.0 {
        step: f32 = if wheel > 0.0 { -27.0 } else { 27.0 }
        state.inspector_scroll = clamp(state.inspector_scroll + step, state.inspector_extent - visible.h + 27.0)
    }
    mut stack := layout.Stack::new(layout.rect(visible.x, visible.y - state.inspector_scroll, visible.w, visible.h), .Column, 3.0)
    node := state.selected
    if graph.is_alive(node) {
        id := entity_id(node)
        section(&mut out, &stack.next(30.0), &visible, name(graph, node), style)
        if graph.has_material(node) {
            section(&mut out, &stack.next(27.0), &visible, "Surface", style)
            field := [scene.MaterialField.Metallic, .Roughness, .Emissive, .BaseR, .BaseG, .BaseB, .BaseA]
            labels := ["Metallic", "Roughness", "Emission", "Red", "Green", "Blue", "Opacity"]
            for i in 0..field.len {
                slider(&mut out, stack.next(22.0), &visible, view.key(i64(10 + i), id), labels[i],
                    graph.material_value(node, field[i]), 0.0, if field[i] == .Emissive { 4.0 } else { 1.0 }, .Surface(node, field[i]))
            }
        }
        section(&mut out, &stack.next(27.0), &visible, "Transform", style)
        axes := [scene.TransformField.X, .Y, .Z, .Rotation, .ScaleX, .ScaleY, .ScaleZ]
        names := ["Position X", "Position Y", "Position Z", "Yaw (rad)", "Scale X", "Scale Y", "Scale Z"]
        for i in 0..axes.len {
            low: f32 = if i < 3 { -20.0 } else if i == 3 { -3.14159 } else { 0.05 }
            high: f32 = if i < 3 { 20.0 } else if i == 3 { 3.14159 } else { 8.0 }
            slider(&mut out, stack.next(22.0), &visible, view.key(i64(20 + i), id), names[i], graph.transform_value(node, axes[i]),
                low, high, .Transform(node, axes[i]))
        }
        row := stack.next(22.0)
        if row.visible_in(&visible) { out.toggle(row, view.key(4, id), "Visible", graph.local(node).visible, .Visibility(node)) }
    } else {
        section(&mut out, &stack.next(30.0), &visible, "Select an object", style)
    }
    section(&mut out, &stack.next(27.0), &visible, "Rendering", style)
    settings := [Setting.Glass, .Shadows, .Effects, .Antialias]
    labels := ["Glass", "Shadows", "Color and glow", "Anti-aliasing"]
    values := [state.glass, state.shadows, state.effects, state.antialias]
    for i in 0..settings.len {
        row := stack.next(22.0)
        if row.visible_in(&visible) { out.toggle(row, view.key(5, i64(i)), labels[i], values[i], .Setting(settings[i])) }
    }
    state.inspector_extent = stack.extent()
    state.inspector_scroll = clamp(state.inspector_scroll, state.inspector_extent - visible.h + 27.0)
}

fn footer(out: &mut view.View<Action>, r: &layout.Rect, frame: &Frame, style: &view.Style) {
    out.fill(r.clone(), style.root.clone())
    out.fill(layout.rect(r.x, r.y, r.w, 1.0), style.border.clone())
    if frame.can_play && r.w < 400.0 {
        play := layout.rect(9.0, r.y + 3.0, 60.0, r.h - 6.0)
        if play.visible_in(r) { out.button(play, view.key(1, 2), "Play", .Primary, .Play) }
    } else if r.w > 420.0 {
        out.label(layout.rect(12.0, r.y, r.w - 160.0, r.h), frame.device + "   /   " + frame.passes.str() + " passes", .Quiet, .Start)
    }
    fps := if frame.fps > 0.0 { i32(frame.fps + 0.5).str() + " FPS" } else { "– FPS" }
    out.label(layout.rect(r.w - 114.0, r.y, 100.0, r.h), fps, .Quiet, .End)
}

fn select(state: &mut State, entity: ecs.Entity) {
    state.selected = entity
    state.inspector_scroll = 0.0
}

fn press(state: &mut State, graph: &mut scene.Graph, action: Action) {
    match action {
        .Select(entity) => { select(&mut state, entity) },
        .Fold(entity) => {
            at := fold_index(state, entity)
            if at < 0 { collapse(&mut state, entity) }
            else {
                state.folded[at] = state.folded[state.folded.len - 1]
                _ := state.folded.pop()
                state.reveal = .Some(entity)
            }
        },
        .AddCube => {
            fresh := graph.create_root(core.vec3(0.0, 0.72, 3.6))
            _ := graph.set_name(fresh, "Cube " + fresh.index.str())
            _ := graph.set_shape(fresh, .Cube)
            _ := graph.set_material(fresh, scene.material(0.52, 0.24, 0.16, 1.0, 0.20, 0.4))
            graph.propagate()
            select(&mut state, fresh)
        },
        .Delete(entity) => {
            if graph.destroy(entity) {
                nodes := graph.nodes()
                select(&mut state, if nodes.len > 0 { nodes[0] } else { ecs.Entity { index: -1, generation: 0 } })
                graph.propagate()
            }
        },
        .Visibility(entity) => {
            if graph.is_alive(entity) {
                graph.set_visible(entity, !graph.local(entity).visible)
                graph.propagate()
            }
        },
        .Setting(setting) => {
            match setting {
                .Glass => { state.glass = !state.glass },
                .Shadows => { state.shadows = !state.shadows },
                .Effects => { state.effects = !state.effects },
                .Antialias => { state.antialias = !state.antialias },
            }
        },
        .Panel(panel) => { state.compact_panel = if state.compact_panel == panel { Panel.Closed } else { panel } },
        .Focus => { state.focus = !state.focus },
        .Play => { state.play_requested = true },
        _ => {},
    }
}

fn slide(graph: &mut scene.Graph, action: Action, value: f32) {
    match action {
        .Surface(entity, field) => { _ := graph.set_material_value(entity, field, value) },
        .Transform(entity, field) => {
            if graph.set_transform_value(entity, field, value) { graph.propagate() }
        },
        _ => {},
    }
}

pub fn draw(state: &mut State, canvas: &mut ui.Canvas, atlas: &text.Atlas, graph: &mut scene.Graph,
    pointer: &widgets.Pointer, frame: &Frame) {
    style := view.dark()
    boxes := dock(state.focus, state.compact_panel, frame.w, frame.h)
    mut composition := view.View<Action>::new()
    toolbar(&mut composition, state, &boxes, frame, &style)
    if boxes.tree.w > 0.0 { tree(&mut composition, &mut state, &graph, &boxes.tree, pointer, frame.wheel, &style) }
    if boxes.inspector.w > 0.0 { inspector(&mut composition, &mut state, &graph, &boxes.inspector, pointer, frame.wheel, &style) }
    footer(&mut composition, &boxes.footer, frame, &style)
    event := view.frame(&composition, &mut state.controls, &mut canvas, atlas, pointer, &style, frame.navigation)
    if boxes.toolbar.h >= 38.0 && boxes.toolbar.w >= 40.0 {
        canvas.triangle(27.0, 11.0, 15.0, 29.0, 23.0, 26.0, &style.accent)
        canvas.triangle(22.0, 40.0, 35.0, 20.0, 25.0, 24.0, &style.accent)
    }
    match event {
        .Some(.Press(action)) => { press(&mut state, &mut graph, action) },
        .Some(.Slide(action, value)) => { slide(&mut graph, action, value) },
        .None => {},
    }
}
