import std.json as json
import std.text as text

const ENTITY: string = r#"""
{"type":"object","properties":{
    "name":{"type":"string","minLength":1,"maxLength":128,"description":"Unique visible name, up to 128 UTF-8 bytes."},"shape":{"type":"string","enum":["box","sphere"]},"role":{"type":"string","enum":["prop","player","goal","flower","collider"],"description":"Flowers and goals are nonblocking sensors with zero mass. The player collects flowers on contact. A collider is an invisible static solid with zero mass."},
    "position":{"type":"array","items":{"type":"number","minimum":-100000,"maximum":100000},"minItems":3,"maxItems":3},"size":{"type":"array","items":{"type":"number","minimum":0.001,"maximum":100000},"minItems":3,"maxItems":3},"velocity":{"type":"array","items":{"type":"number","minimum":-100000,"maximum":100000},"minItems":3,"maxItems":3},
    "mass":{"type":"number","minimum":0,"maximum":100000,"not":{"exclusiveMinimum":0,"exclusiveMaximum":0.001},"description":"Zero for static bodies, otherwise at least 0.001."},"friction":{"type":"number","minimum":0,"maximum":1},"restitution":{"type":"number","minimum":0,"maximum":1},"color":{"type":"array","items":{"type":"number","minimum":0,"maximum":1},"minItems":3,"maxItems":3}
  },"required":["name","shape"],"additionalProperties":false}
"""#

// This is both the advertised catalog and the validator's schema.
const CATALOG: string = r#"""
{"tools":[
  {"name":"storm_new","description":"Start a blank level or the Blomsterskogen flower-collecting game at tick zero.","inputSchema":{"type":"object","properties":{"name":{"type":"string","minLength":1},"template":{"type":"string","enum":["empty","demo"]}},"additionalProperties":false}},
  {"name":"storm_load","description":"Load an authored Storm scene JSON file. Relative paths resolve from the server's working directory.","inputSchema":{"type":"object","properties":{"path":{"type":"string","minLength":1}},"required":["path"],"additionalProperties":false}},
  {"name":"storm_save","description":"Write the authored scene as JSON to this path, replacing an existing file. Launch it with storm --scene <path>. Simulated motion is not baked into the level.","inputSchema":{"type":"object","properties":{"path":{"type":"string","minLength":1}},"required":["path"],"additionalProperties":false}},
  {"name":"storm_inspect","description":"Read the runtime state or the authored scene used for reset and save. Runtime includes tick, won, contacts, flowers, total_flowers and entities with positions, velocities and collected flags. last_flower indexes the most recent pickup and picked_tick identifies its tick.","inputSchema":{"type":"object","properties":{"view":{"type":"string","enum":["state","scene"]}},"additionalProperties":false},"annotations":{"readOnlyHint":true}},
  {"name":"storm_set_scene","description":"Replace the entire authored level in one call, including its name, theme, bounds, gravity and entities. On success play restarts at tick zero. Invalid levels preserve the current run. Use storm_inspect with view scene for a complete editable document.","inputSchema":{"type":"object","properties":{"scene":{"type":"object","properties":{
    "version":{"type":"integer","minimum":1,"maximum":1},"name":{"type":"string","minLength":1,"maxLength":128,"description":"Up to 128 UTF-8 bytes of visible text."},
    "theme":{"type":"string","enum":["plain","blossom"],"description":"Visual theme. Defaults to plain."},
    "bounds":{"type":"array","items":{"type":"number","minimum":-100000,"maximum":100000},"minItems":4,"maxItems":4,"description":"Optional player movement limits [minX,minZ,maxX,maxZ]. Each minimum must be less than its maximum. Omit for unrestricted movement."},
    "gravity":{"type":"array","items":{"type":"number","minimum":-100000,"maximum":100000},"minItems":3,"maxItems":3},
    "entities":{"type":"array","items":ENTITY_SCHEMA,"maxItems":128}
  },"required":["version","name","entities"],"additionalProperties":false}},"required":["scene"],"additionalProperties":false}},
  {"name":"storm_upsert","description":"Add or fully replace a named entity and restart the playtest. Size uses full extents in metres. Spheres use equal extents. Mass zero is static; a player needs positive mass; goals and collectible flowers are static sensors. Omitted fields use scene defaults.","inputSchema":{"type":"object","properties":{"entity":ENTITY_SCHEMA},"required":["entity"],"additionalProperties":false}},
  {"name":"storm_remove","description":"Remove a named entity from the authored scene and restart the playtest.","inputSchema":{"type":"object","properties":{"name":{"type":"string","minLength":1}},"required":["name"],"additionalProperties":false}},
  {"name":"storm_step","description":"Advance the game by exactly this many 60 Hz ticks (default 1). Hold world-space X/Z input for the interval; jump is pressed on the first tick. Return the final state.","inputSchema":{"type":"object","properties":{"ticks":{"type":"integer","minimum":1,"maximum":600},"x":{"type":"number","minimum":-1,"maximum":1},"z":{"type":"number","minimum":-1,"maximum":1},"jump":{"type":"boolean"}},"additionalProperties":false}},
  {"name":"storm_preview","description":"Render a PNG of the current simulated game state, without advancing the clock. Uses the same renderer as the playable window.","inputSchema":{"type":"object","properties":{},"additionalProperties":false},"annotations":{"readOnlyHint":true}},
  {"name":"storm_reset","description":"Restore all authored bodies and rewind the playtest to tick zero.","inputSchema":{"type":"object","properties":{},"additionalProperties":false}}
]}
"""#

pub fn catalog() -> string { text.replace(text.replace(CATALOG, "ENTITY_SCHEMA", ENTITY), "\n", " ") }

pub fn schema(catalog: &json.Doc, name: string) -> i32 {
    tools := catalog.field(catalog.root, "tools")
    for i in 0..catalog.count(tools) {
        entry := catalog.at(tools, i)
        if catalog.get_str(entry, "name").unwrap_or_default() == name { return catalog.field(entry, "inputSchema") }
    }
    -1
}

// Validate the vocabulary used by the catalog. Path-specific errors give an
// agent enough information to correct a call without changing the session.
pub fn validate(c: &json.Doc, s: i32, d: &json.Doc, n: i32, path: string) -> string {
    ty := c.get_str(s, "type").unwrap_or_default()
    kind := d.kind(n)
    if ty == "object" {
        if n >= 0 && kind != .Object { return path + " must be an object" }
        properties := c.field(s, "properties")
        required := c.field(s, "required")
        for i in 0..c.count(required) {
            key := c.as_str(c.at(required, i)).unwrap_or_default()
            if d.field(n, key) < 0 { return path + "." + key + " is required" }
        }
        if kind != .Object { return "" }
        for i in 0..d.count(n) {
            key := d.key_at(n, i).unwrap_or_default()
            field := c.field(properties, key)
            if field < 0 { return path + "." + key + " is not recognized" }
            error := validate(&c, field, &d, d.val_at(n, i), path + "." + key)
            if error.len > 0 { return error }
        }
    } else if ty == "array" {
        if kind != .Array { return path + " must be an array" }
        length := i64(d.count(n))
        if length < c.get_i64(s, "minItems").unwrap_or(0) || length > c.get_i64(s, "maxItems").unwrap_or(length) {
            return path + " has an invalid length"
        }
        for i in 0..d.count(n) {
            error := validate(&c, c.field(s, "items"), &d, d.at(n, i), path + "[" + i.str() + "]")
            if error.len > 0 { return error }
        }
    } else if ty == "string" {
        if kind != .String { return path + " must be a string" }
        value := d.as_str(n).unwrap_or_default()
        if value.len == 0 && c.field(s, "minLength") >= 0 { return path + " must not be empty" }
        options := c.field(s, "enum")
        if options >= 0 {
            for i in 0..c.count(options) { if c.as_str(c.at(options, i)).unwrap_or_default() == value { return "" } }
            return path + " must be one of " + c.raw_json(options)
        }
    } else if ty == "boolean" {
        if kind != .Bool { return path + " must be a boolean" }
    } else {
        if ty == "integer" && d.as_i64(n).is_none() { return path + " must be an integer" }
        num := match d.as_f64(n) { .Some(value) => value, .None => { return path + " must be a number" } }
        if num < c.get_f64(s, "minimum").unwrap_or(num) || num > c.get_f64(s, "maximum").unwrap_or(num) { return path + " is outside its allowed range" }
    }
    ""
}
