// Storm text: glyph atlas packing and text layout on top of dunder-skrift.
//
// Skrift rasterizes a glyph into an anti-aliased 8-bit coverage bitmap. This
// module shelves those bitmaps into one atlas texture and lays out strings into
// screen-space quads that the renderer turns into two triangles each.
//
//   mut atlas := text.Atlas::new(1024, 1024)
//   face := text.load_face("/usr/share/fonts/TTF/JetBrainsMonoNerdFont-Regular.ttf", 32.0)
//   atlas.add_text(&face, "Storm")
//   quads := atlas.layout(&face, "Storm", 40.0, 40.0)
//
// The atlas is R8: one byte of coverage per pixel. The renderer uploads it as a
// texture and multiplies by the text color in the fragment shader.
capability filesystem

import skrift.font as skrift
import sys

pub struct Glyph {
    codepoint: i32,
    // Atlas position in pixels.
    x: i32,
    y: i32,
    width: i32,
    height: i32,
    // Layout metrics in pixels at the size the glyph was rasterized at.
    advance: f32,
    bearing_x: f32,
    // Distance from the baseline up to the top of the bitmap.
    bearing_y: f32,
    size: f32,
    ok: bool,
}

pub struct Quad {
    // Screen-space position of the bitmap's top-left corner.
    x: f32,
    y: f32,
    width: f32,
    height: f32,
    // Normalized atlas coordinates.
    u0: f32,
    v0: f32,
    u1: f32,
    v1: f32,
}

pub struct Atlas {
    width: i32,
    height: i32,
    pixels: []u8,
    glyphs: []Glyph,
    indices: Map<i32, i32>,
    // Shelf packer: current row's top and height, and the cursor in that row.
    shelf_y: i32,
    shelf_height: i32,
    cursor_x: i32,
    full: bool,
}

impl Atlas {
    pub fn new(width: i32, height: i32) -> Self {
        mut pixels: []u8 = []
        if width > 0 && height > 0 {
            pixels.reserve(width * height)
            for _ in 0..width * height { pixels.push(0) }
        }
        Self { width: width, height: height, pixels: pixels, glyphs: [], indices: Map<i32, i32>::new(), shelf_y: 0, shelf_height: 0, cursor_x: 0, full: false }
    }

    pub fn is_full(&self) -> bool { self.full }
    pub fn glyph_count(&self) -> i32 { self.glyphs.len }
    pub fn size(&self) -> i32 { self.width }

    // The pixel size the glyphs were rasterized at, which is the size the
    // face was loaded at; 0 while there are no glyphs. A higher-density
    // display packs the same glyphs at a larger size, and whoever draws them
    // asks this instead of being told.
    pub fn raster_size(&self) -> f32 {
        if self.glyphs.len == 0 { return 0.0 }
        self.glyphs[0].size
    }

    pub fn find(&self, codepoint: i32) -> i32 {
        self.indices.get_or(codepoint, -1)
    }

    fn insert_glyph(&mut self, move glyph: Glyph) -> i32 {
        i := self.glyphs.len
        self.indices.put(glyph.codepoint, i)
        self.glyphs.push(glyph)
        i
    }

    pub fn glyph_at(&self, index: i32) -> &Glyph from self { &self.glyphs[index] }

    // Rasterize one codepoint and shelf-pack it. Returns the glyph index, or -1
    // when the atlas is full or the codepoint has no outline.
    pub fn add_glyph(&mut self, face: &skrift.Face, ch: rune) -> i32 {
        existing := self.find(i32(ch))
        if existing >= 0 { return existing }
        bitmap := face.render_rune(ch)
        if bitmap.width <= 0 || bitmap.height <= 0 {
            // Whitespace: record metrics but no atlas pixels.
            gid := face.glyph_index_rune(ch)
            metrics := face.glyph_metrics(gid)
            glyph := Glyph {
                codepoint: i32(ch), x: 0, y: 0, width: 0, height: 0,
                advance: f32(metrics.advance_width), bearing_x: f32(metrics.left_side_bearing),
                bearing_y: 0.0, size: f32(face.pixel_size), ok: true,
            }
            return self.insert_glyph(glyph)
        }
        if self.cursor_x + bitmap.width > self.width {
            self.shelf_y = self.shelf_y + self.shelf_height
            self.cursor_x = 0
            self.shelf_height = 0
        }
        if self.shelf_y + bitmap.height > self.height {
            self.full = true
            return -1
        }
        if bitmap.height > self.shelf_height { self.shelf_height = bitmap.height }
        x := self.cursor_x
        y := self.shelf_y
        for row in 0..bitmap.height {
            for col in 0..bitmap.width {
                self.pixels[(y + row) * self.width + (x + col)] = bitmap.pixels[row * bitmap.width + col]
            }
        }
        self.cursor_x = self.cursor_x + bitmap.width + 1
        gid := face.glyph_index_rune(ch)
        metrics := face.glyph_metrics(gid)
        glyph := Glyph {
            codepoint: i32(ch), x: x, y: y, width: bitmap.width, height: bitmap.height,
            advance: f32(metrics.advance_width), bearing_x: f32(metrics.left_side_bearing),
            // raster.Bitmap.top is the distance from the baseline to the top row.
            bearing_y: f32(bitmap.top), size: f32(face.pixel_size), ok: true,
        }
        self.insert_glyph(glyph)
    }

    pub fn add_text(&mut self, face: &skrift.Face, text: string) -> bool {
        for ch in text.runes() {
            if self.add_glyph(face, ch) < 0 { return false }
        }
        true
    }

    // Lay out `text` with its top-left corner at (origin_x, origin_y).
    // The baseline sits `size` pixels below the top of the line.
    pub fn layout(&self, text: string, size: f32, origin_x: f32, origin_y: f32) -> []Quad {
        mut quads: []Quad = []
        mut pen_x := origin_x
        baseline_y := origin_y + size
        for ch in text.runes() {
            index := self.find(i32(ch))
            if index < 0 { continue }
            glyph := &self.glyphs[index]
            if glyph.width > 0 && glyph.height > 0 {
                u0 := f32(glyph.x) / f32(self.width)
                v0 := f32(glyph.y) / f32(self.height)
                u1 := f32(glyph.x + glyph.width) / f32(self.width)
                v1 := f32(glyph.y + glyph.height) / f32(self.height)
                quads.push(Quad {
                    x: pen_x + glyph.bearing_x,
                    y: baseline_y - glyph.bearing_y,
                    width: f32(glyph.width),
                    height: f32(glyph.height),
                    u0: u0, v0: v0, u1: u1, v1: v1,
                })
            }
            pen_x = pen_x + glyph.advance
        }
        quads
    }

    // Width of a laid-out string in pixels.
    pub fn measure(&self, text: string) -> f32 {
        mut width: f32 = 0.0
        for ch in text.runes() {
            index := self.find(i32(ch))
            if index >= 0 { width = width + self.glyphs[index].advance }
        }
        width
    }

    pub fn pixels(&self) -> &[]u8 { &self.pixels }

    // Owned copy: lets callers hand the coverage data to the GPU layer without
    // passing a borrow across a module boundary.
    pub fn copy_pixels(&self) -> []u8 {
        mut out: []u8 = []
        out.reserve(self.pixels.len)
        for i in 0..self.pixels.len { out.push(self.pixels[i]) }
        out
    }

    pub fn coverage(&self, x: i32, y: i32) -> u8 {
        if x < 0 || y < 0 || x >= self.width || y >= self.height { return 0 }
        self.pixels[y * self.width + x]
    }
}

// Prefer the requested face, then an installed system sans or monospace fallback.
pub fn find_font(preferred: string) -> string {
    candidates := [preferred.clone(),
        "/System/Library/Fonts/Supplemental/Arial.ttf",
        "/usr/share/fonts/TTF/DejaVuSans.ttf",
        "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
        "/usr/share/fonts/liberation/LiberationSans-Regular.ttf",
        "/usr/share/fonts/truetype/liberation2/LiberationSans-Regular.ttf",
        "/usr/share/fonts/TTF/JetBrainsMonoNerdFont-Regular.ttf",
        "/usr/share/fonts/TTF/DejaVuSansMono.ttf",
        "/usr/share/fonts/truetype/dejavu/DejaVuSansMono.ttf",
        "/System/Library/Fonts/Menlo.ttc",
        "/System/Library/Fonts/SFNSMono.ttf"]
    for path in candidates {
        if path.len == 0 { continue }
        info := sys.metadata(path)
        if info.ok && info.is_file { return path.clone() }
    }
    ""
}

// Load a font face and select a pixel size. Returns a face with ok=false when
// the file cannot be read or parsed.
pub fn load_face(path: string, pixel_size: f32) -> skrift.Face {
    mut face := skrift.Face::from_file(path, 0)
    if face.ok { face.set_pixel_size(f64(pixel_size)) }
    face
}

// The platform's font at a pixel size.
pub fn load_font(pixel_size: f32) -> skrift.Face { load_face(find_font(""), pixel_size) }
