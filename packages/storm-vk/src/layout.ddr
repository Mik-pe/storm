// Pairs of two registry records for pDependencies / pAttachments / pReferences /
// pStages, so every caller hands Vulkan one named declaration. A [T; 2] of a C
// record is contiguous too (size 56, stride 28 for SubpassDependency); these are
// names, not a layout fix.

@c_layout
pub struct Dependencies { before: SubpassDependency, after: SubpassDependency }

@c_layout
pub struct Attachments { color: AttachmentDescription, depth: AttachmentDescription }

@c_layout
pub struct References { color: AttachmentReference, depth: AttachmentReference }

@c_layout
pub struct ShaderStages { vertex: PipelineShaderStageCreateInfo, fragment: PipelineShaderStageCreateInfo }

