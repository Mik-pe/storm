import text
import ui
import ui.layout as layout
import ui.view as view
import ui.widgets as widgets

pub enum Action { Idle, TogglePause, Step, Restart, Studio }

pub struct Hud {
    interaction: view.State,
    legacy: widgets.State,
}

impl Hud {
    pub fn new() -> Self { Self { interaction: view.State::new(), legacy: widgets.State::new() } }
}

pub struct Frame {
    width: f32, height: f32, pointer: widgets.Pointer, navigation: view.Navigation, entry: view.Entry,
    wheel: f32, paused: bool, exact: bool, can_edit: bool,
}

pub struct Playbar { title: string, tick: i64, has_player: bool, has_goal: bool, won: bool }

// The original immediate HUD API shares the keyed view and carries its
// pointer capture across frames through the caller's existing state.
pub fn draw(state: &mut widgets.State, canvas: &mut ui.Canvas, atlas: &text.Atlas, pointer: &widgets.Pointer,
    width: f32, height: f32, title: string, tick: i64, paused: bool, has_player: bool,
    has_goal: bool, won: bool, can_edit: bool) -> Action {
    entry := view.Entry { text: "", erase: false }
    frame := Frame { width: width, height: height, pointer: pointer.clone(), navigation: .None,
        entry: entry, wheel: 0.0, paused: paused, exact: paused, can_edit: can_edit }
    game := Playbar { title: title.clone(), tick: tick, has_player: has_player, has_goal: has_goal, won: won }
    mut interaction := view.State::new()
    match state.pointer.key {
        .Some(id) => { interaction.pointer.key = .Some(view.key(1, i64(id))) },
        .None => {},
    }
    action := draw_view(&mut interaction, &mut canvas, atlas, &frame, &game)
    state.pointer.key = match interaction.pointer.key {
        .Some(key) => Option<i32>.Some(i32(key.item)),
        .None => Option<i32>.None,
    }
    state.end(pointer)
    action
}

pub fn draw_view(state: &mut view.State, canvas: &mut ui.Canvas, atlas: &text.Atlas, frame: &Frame, game: &Playbar) -> Action {
    style := view.dark()
    narrow := frame.width < 560.0
    bar: f32 = if narrow { 88.0 } else { 48.0 }
    mut hud := view.View<Action>::new()
    hud.fill(layout.rect(0.0, 0.0, frame.width, bar), style.chrome.clone())
    hud.fill(layout.rect(0.0, bar - 1.0, frame.width, 1.0), style.border.clone())
    back_w: f32 = if narrow { 64.0 } else { 103.0 }
    if frame.can_edit {
        rect := layout.rect(12.0, 10.0, back_w, 27.0)
        hud.button(rect, view.key(1, 1), if narrow { "Studio" } else { "Back to studio" }, .Outline, .Studio)
    }

    title_x := if frame.can_edit { 12.0 + back_w + 17.0 } else { 12.0 }
    group_x: f32 = if narrow { 12.0 } else { frame.width - 218.0 }
    title_end := if narrow { frame.width - 12.0 } else { group_x - 16.0 }
    hud.label(layout.rect(title_x, 0.0, title_end - title_x, 46.0), game.title, .Heading, .Start)

    y: f32 = if narrow { 49.0 } else { 10.0 }
    hud.button(layout.rect(group_x, y, 72.0, 27.0), view.key(1, 2),
        if frame.paused { "Resume" } else { "Pause" }, .Outline, .TogglePause)
    step := layout.rect(group_x + 78.0, y, 55.0, 27.0)
    if frame.paused { hud.button(step, view.key(1, 3), "Step", .Outline, .Step) }
    else { hud.disabled_button(step, "Step") }
    hud.button(layout.rect(group_x + 139.0, y, 67.0, 27.0), view.key(1, 4), "Restart", .Outline, .Restart)

    bottom := frame.height - 32.0
    hud.fill(layout.rect(0.0, bottom, frame.width, 32.0), style.chrome.clone())
    hud.fill(layout.rect(0.0, bottom, frame.width, 1.0), style.border.clone())
    status := if game.won { "Goal reached" } else if game.has_goal && game.has_player { "Reach the goal" }
        else if game.has_player { "Free play" } else { "Physics preview" }
    dot := if game.won { style.accent.clone() } else { style.quiet.clone() }
    hud.rounded(layout.rect(16.0, bottom + 13.0, 7.0, 7.0), 3.5, dot)
    clock := "Tick " + game.tick.str()
    status_w := ui.Canvas::text_width(atlas, status, 13.0 / ui.RASTER_SIZE)
    clock_w := ui.Canvas::text_width(atlas, clock, 13.0 / ui.RASTER_SIZE)
    clock_x := frame.width - 16.0 - clock_w
    status_end := 31.0 + status_w
    hud.label(layout.rect(31.0, bottom, clock_x - 39.0, 32.0), status, .Quiet, .Start)
    if clock_x > status_end + 12.0 {
        hud.label(layout.rect(clock_x - 8.0, bottom, clock_w + 8.0, 32.0), clock, .Quiet, .End)
    }
    help := if game.has_player { "WASD  move     Space  jump     Q  pause     R  restart" } else { "Q  pause     R  restart" }
    help_w := ui.Canvas::text_width(atlas, help, 13.0 / ui.RASTER_SIZE)
    help_x := (frame.width - help_w) * 0.5
    if help_x > status_end + 16.0 && help_x + help_w < clock_x - 16.0 {
        hud.label(layout.rect(help_x - 2.0, bottom, help_w + 4.0, 32.0), help, .Quiet, .Center)
    }

    match view.frame(&hud, &mut state, &mut canvas, atlas, &frame.pointer, &style, frame.navigation, &frame.entry) {
        .Some(.Press(action)) => action,
        _ => .Idle,
    }
}

pub fn reload_error(c: &mut ui.Canvas, a: &text.Atlas, width: f32) {
    y: f32 = if width < 560.0 { 94.0 } else { 54.0 }
    message := "Scene reload failed"
    w := ui.Canvas::text_width(a, message, 0.62) + 24.0
    c.rounded_rect(12.0, y, w, 28.0, 5.0, &ui.rgb(0.21, 0.12, 0.08))
    c.text(a, message, 24.0, y + 5.0, 0.62, &ui.rgb(1.0, 0.78, 0.55))
}

// Open one petal for each fifth of the bouquet.
