import ..src.ecs as ecs

struct Position { x: f32, y: f32 }
struct Velocity { dx: f32, dy: f32 }
struct Tag { name: string }

@test fn pool_insert_get_remove() {
    mut pool := ecs.Pool<Position>::new()
    mut allocator := ecs.EntityAllocator::new()
    a := allocator.create()
    b := allocator.create()
    _ := pool.insert(a, Position { x: 1.0, y: 2.0 })
    _ := pool.insert(b, Position { x: 3.0, y: 4.0 })
    assert(pool.len() == 2)
    assert(pool.contains(a) && pool.contains(b))
    assert(pool.get(a).x == 1.0)
    assert(pool.get(b).y == 4.0)
    pool.get_mut(a).x = 10.0
    assert(pool.get(a).x == 10.0)
    removed := pool.remove(a)
    match removed {
        .Some(p) => { assert(p.x == 10.0) },
        .None => { assert(false) },
    }
    assert(!pool.contains(a) && pool.contains(b))
    assert(pool.len() == 1)
    assert(pool.get(b).y == 4.0)
}

@test fn stale_handles_never_match() {
    mut allocator := ecs.EntityAllocator::new()
    a := allocator.create()
    stale := a
    assert(allocator.is_alive(a))
    assert(allocator.destroy(a))
    assert(!allocator.is_alive(stale))
    b := allocator.create()
    // Recycled slot: same index, new generation.
    assert(b.index == stale.index && b.generation != stale.generation)
    assert(allocator.is_alive(b))
    assert(!allocator.is_alive(stale))
    assert(!allocator.destroy(stale))
    assert(allocator.destroy(b))
    assert(allocator.len() == 0)
}

@test fn systems_iterate_packed_storage() {
    mut allocator := ecs.EntityAllocator::new()
    mut positions := ecs.Pool<Position>::new()
    mut velocities := ecs.Pool<Velocity>::new()
    for i in 0..100 {
        e := allocator.create()
        _ := positions.insert(e, Position { x: f32(i), y: 0.0 })
        if i % 2 == 0 { _ := velocities.insert(e, Velocity { dx: 1.0, dy: 2.0 }) }
    }
    // A "system": integrate every entity that has both components.
    for i in 0..velocities.len() {
        e := velocities.entities()[i]
        if positions.contains(e) {
            v := velocities.values()[i]
            p := positions.get_mut(e)
            p.x = p.x + v.dx
            p.y = p.y + v.dy
        }
    }
    assert(positions.len() == 100 && velocities.len() == 50)
    first := positions.entities()[0]
    assert(positions.get(first).x == 1.0 && positions.get(first).y == 2.0)
    odd := positions.entities()[1]
    assert(positions.get(odd).x == 1.0 && positions.get(odd).y == 0.0)
    assert(allocator.len() == 100)
}

@test fn pool_holds_resource_owning_components() {
    mut pool := ecs.Pool<Tag>::new()
    mut allocator := ecs.EntityAllocator::new()
    e := allocator.create()
    _ := pool.insert(e, Tag { name: "player" })
    assert(pool.get(e).name == "player")
    moved := pool.remove(e)
    match moved {
        .Some(t) => { assert(t.name == "player") },
        .None => { assert(false) },
    }
    assert(pool.len() == 0)
}

@test fn removing_a_middle_component_preserves_owners_and_values() {
    mut pool := ecs.Pool<Tag>::new()
    mut allocator := ecs.EntityAllocator::new()
    mut entities: []ecs.Entity = []
    for name in ["a", "b", "c", "d"] {
        e := allocator.create()
        entities.push(e)
        _ := pool.insert(e, Tag { name: name.clone() })
    }
    assert(pool.remove(entities[1]).unwrap().name == "b")
    assert(!pool.contains(entities[1]) && pool.len() == 3)
    assert(pool.entities()[1].index == entities[3].index)
    assert(pool.get(entities[3]).name == "d" && pool.get(entities[2]).name == "c")
    assert(pool.remove(entities[3]).unwrap().name == "d")
    assert(pool.get(entities[0]).name == "a" && pool.get(entities[2]).name == "c")
}

@test fn join_keeps_entities_in_both_pools_with_dense_indexes() {
    mut pool_a := ecs.Pool<Position>::new()
    mut pool_b := ecs.Pool<Velocity>::new()
    mut pool_c := ecs.Pool<Tag>::new()
    mut allocator := ecs.EntityAllocator::new()
    a := allocator.create()
    b := allocator.create()
    c := allocator.create()
    d := allocator.create()
    _ := pool_a.insert(a, Position { x: 1.0, y: 0.0 })
    _ := pool_a.insert(b, Position { x: 2.0, y: 0.0 })
    _ := pool_a.insert(c, Position { x: 3.0, y: 0.0 })
    _ := pool_a.insert(d, Position { x: 4.0, y: 0.0 })
    _ := pool_b.insert(a, Velocity { dx: 10.0, dy: 0.0 })
    _ := pool_b.insert(c, Velocity { dx: 30.0, dy: 0.0 })
    _ := pool_b.insert(d, Velocity { dx: 40.0, dy: 0.0 })
    _ := pool_c.insert(c, Tag { name: "both" })

    rows := ecs.join2(&pool_a, &pool_b)
    assert(rows.len == 3)
    assert(rows[0].entity.index == a.index && rows[0].a == 0 && rows[0].b == 0 && rows[0].c == -1)
    assert(rows[1].entity.index == c.index && rows[1].a == 2 && rows[1].b == 1)
    assert(rows[2].entity.index == d.index && rows[2].a == 3 && rows[2].b == 2)
    assert(pool_a.at(rows[1].a).x == 3.0)
    assert(pool_b.at(rows[1].b).dx == 30.0)

    rows3 := ecs.join3(&pool_a, &pool_b, &pool_c)
    assert(rows3.len == 1)
    assert(rows3[0].entity.index == c.index && rows3[0].c == 0)
    assert(pool_c.at(rows3[0].c).name == "both")
}

@test fn dense_index_follows_swap_remove_and_rejects_stale_handles() {
    mut pool := ecs.Pool<Position>::new()
    mut allocator := ecs.EntityAllocator::new()
    a := allocator.create()
    b := allocator.create()
    _ := pool.insert(a, Position { x: 1.0, y: 0.0 })
    _ := pool.insert(b, Position { x: 2.0, y: 0.0 })
    assert(pool.dense_index(a) == 0 && pool.dense_index(b) == 1)
    _ := pool.remove(a)
    assert(pool.dense_index(a) == -1)
    assert(pool.dense_index(b) == 0)
    pool.at_mut(0).x = 20.0
    assert(pool.get(b).x == 20.0)
    assert(allocator.destroy(b))
    assert(pool.dense_index(b) == 0)
    stale := ecs.Entity { index: b.index, generation: b.generation + 1 }
    assert(pool.dense_index(stale) == -1)
}
